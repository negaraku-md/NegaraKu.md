---
import type { Locale } from '@/lib/categories';
import DataProvenance from './DataProvenance.astro';
import { RULES } from '@/lib/terminology';
import { localePath } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);
const example = 'jom kita tapau nasi lemak, lepas tu lepak kat mamak';
---

<section class="container head">
  <h1>{L('Penukar Bahasa Harian → Baku', 'Everyday → Standard Malay Converter', '日常语 → 标准马来语转换器')}</h1>
  <p class="lead">{L('Tukar bahasa harian Malaysia kepada Bahasa Malaysia baku. Ruleset permulaan — boleh diperluas.', 'Convert everyday Malaysian speech into standard Bahasa Malaysia. Starter ruleset — extendable.', '将马来西亚日常口语转换为标准马来语。入门规则集，可扩展。')}</p>
  <DataProvenance locale={locale} dataset="terminology" />
  <p><a href={localePath('/terminology', locale)}>← {L('Glosari istilah', 'Term glossary', '词汇表')}</a></p>
</section>

<section class="container conv">
  <div class="io">
    <label>{L('Teks harian', 'Everyday text', '日常文本')}
      <textarea id="in" rows="6">{example}</textarea>
    </label>
    <label>{L('Bahasa baku', 'Standard Malay', '标准马来语')}
      <textarea id="out" rows="6" readonly></textarea>
    </label>
  </div>
  <div class="btns">
    <button class="btn btn-primary" id="convert">🔄 {L('Tukar', 'Convert', '转换')}</button>
    <button class="btn btn-ghost" id="clear">✕ {L('Kosongkan', 'Clear', '清除')}</button>
    <button class="btn btn-ghost" id="copy">📋 {L('Salin', 'Copy', '复制')}</button>
  </div>
</section>

<script type="application/json" id="rules" set:html={JSON.stringify(RULES)}></script>
<script>
  const rules = JSON.parse(document.getElementById('rules')!.textContent || '{}') as Record<string, string>;
  const $in = document.getElementById('in') as HTMLTextAreaElement;
  const $out = document.getElementById('out') as HTMLTextAreaElement;
  const convert = () => {
    $out.value = $in.value.replace(/[A-Za-z']+/g, (w) => {
      const rep = rules[w.toLowerCase()];
      if (!rep) return w;
      // preserve leading capital
      return /^[A-Z]/.test(w) ? rep.charAt(0).toUpperCase() + rep.slice(1) : rep;
    });
  };
  document.getElementById('convert')?.addEventListener('click', convert);
  document.getElementById('clear')?.addEventListener('click', () => { $in.value = ''; $out.value = ''; });
  document.getElementById('copy')?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText($out.value); } catch {}
  });
  convert();
</script>

<style>
  .head { padding-block: 2.5rem 0.5rem; }
  .lead { color: var(--ink-soft); max-width: 62ch; }
  .conv { padding-bottom: 3rem; }
  .io { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .io label { display: grid; gap: 0.35rem; font-size: 0.8rem; font-weight: 600; color: var(--ink-soft); }
  textarea { width: 100%; padding: 0.8rem 1rem; border-radius: 10px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: inherit; font-weight: 400; resize: vertical; }
  #out { background: color-mix(in srgb, var(--gold) 8%, var(--surface)); }
  .btns { display: flex; gap: 0.6rem; margin-top: 1rem; flex-wrap: wrap; }
  @media (max-width: 700px) { .io { grid-template-columns: 1fr; } }
</style>
