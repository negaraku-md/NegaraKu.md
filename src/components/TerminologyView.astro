---
import type { Locale } from '@/lib/categories';
import { TERMS } from '@/lib/terminology';
import { localePath } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);
---

<section class="container head">
  <h1>{L('Istilah Malaysia', 'Malaysian Terminology', '马来西亚词汇')}</h1>
  <p class="lead">{L('Perkataan harian Malaysia dengan padanan bahasa baku dan Inggeris.', 'Everyday Malaysian words with their standard-Malay and English equivalents.', '马来西亚日常用语及其标准马来语与英语对照。')}</p>
  <div class="tools">
    <input type="search" id="term-search" placeholder={L('Cari istilah…', 'Search terms…', '搜索词汇…')} />
    <a class="btn btn-ghost" href={localePath('/terminology/converter', locale)}>{L('Penukar teks', 'Text converter', '文本转换器')} →</a>
  </div>
</section>

<section class="container">
  <div class="table-wrap">
    <table>
      <thead><tr><th>{L('Harian', 'Everyday', '日常')}</th><th>{L('Baku', 'Standard', '标准')}</th><th>English</th></tr></thead>
      <tbody id="term-body">
        {TERMS.map((t) => (
          <tr data-term={`${t.term} ${t.standard} ${t.en}`.toLowerCase()}>
            <td><b>{t.term}</b></td>
            <td>{t.standard}</td>
            <td>{t.en}{t.note ? <span class="note"> — {t.note}</span> : null}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<script>
  const input = document.getElementById('term-search') as HTMLInputElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLElement>('#term-body tr'));
  input?.addEventListener('input', () => {
    const q = input.value.toLowerCase().trim();
    rows.forEach((r) => (r.style.display = !q || (r.dataset.term || '').includes(q) ? '' : 'none'));
  });
</script>

<style>
  .head { padding-block: 2.5rem 1rem; }
  .lead { color: var(--ink-soft); max-width: 60ch; }
  .tools { display: flex; gap: 0.6rem; margin-top: 1rem; flex-wrap: wrap; }
  .tools input { flex: 1; min-width: 12rem; padding: 0.6rem 1rem; border-radius: 10px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; margin-bottom: 3rem; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 0.6rem 0.9rem; border-bottom: 1px solid var(--line); }
  th { font-family: var(--font-interface); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  td b { color: var(--gold); }
  .note { color: var(--muted); font-size: 0.85rem; }
</style>
