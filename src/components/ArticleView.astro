---
import { render } from 'astro:content';
import type { Locale } from '@/lib/categories';
import { getCategory, getPillar, getPillarDef, loc } from '@/lib/categories';
import { type Article, relatedArticles, readingTime, articlesForLocale } from '@/lib/content';
import { localePath } from '@/lib/i18n';
import { REPO } from '@/lib/site';
import { newIssueUrl, articleMetaFooter } from '@/lib/feedback';
import { subcatLabel } from '@/lib/subcategories';
import { FLOWER_D } from '@/lib/logo';
import TrustBadge from './TrustBadge.astro';
import FeedbackBar from './FeedbackBar.astro';
import BecomeContributor from './BecomeContributor.astro';
import { getAnalytics, type AnalyticsBucket } from '@/lib/apidata';

// Visitor analytics (see docs/ANALYTICS.md): three buckets — human readers,
// search-engine crawlers, AI crawlers — tracked per named bot, summarised here.
// Absent until an edge-logging layer is wired up → "not tracked yet". Parsed
// once (memoized in apidata) rather than re-read on each of ~3,000 pages.
const analytics = getAnalytics();

// THE THREE-LAYER ARTICLE.
//   Layer 1  the 30-second answer      — what AI assistants extract and cite
//   Layer 2  practical understanding   — the article body
//   Layer 3  depth: sources, history   — provenance and context
// Two writing modes share this template: `practical` (answer-first) and
// `narrative` (story-led). The difference is voice and framing, not structure —
// even a story opens with an orienting answer.

interface Props {
  locale: Locale;
  article: Article;
}
const { locale, article } = Astro.props;
const d = article.data;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string) => (locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

const cat = getCategory(d.category);
const path = `/${d.category}/${d.slug}`;
// The GitHub source file for THIS rendered entry: the master is `<slug>.md`,
// a translation is `<slug>.<lang>.md`. `d.lang` is the actual file shown (it
// reflects a fallback correctly), so a reader on a translated page edits the
// translation, not the master.
const isMasterFile = d.lang === (d.masterLanguage ?? d.lang);
const sourceFile = `knowledge/${d.category}/${d.slug}${isMasterFile ? '' : `.${d.lang}`}.md`;
const { Content, headings } = await render(article);

// Revision-history `change` notes are authored once (English) and stored on every
// language file, so they render as English on the ms/zh pages. Translate the known
// canonical phrases at render time (the corpus currently uses a single one).
const CHANGE_I18N: Record<string, [string, string, string, string, string]> = {
  'Approved and published.': ['Diluluskan dan diterbitkan.', 'Approved and published.', '已批准并发布。', '承認され公開されました。', '승인되어 공개되었습니다.'],
  'Initial publication.': ['Penerbitan awal.', 'Initial publication.', '首次发布。', '初回公開。', '최초 공개.'],
};
const changeLabel = (c: string): string => {
  const tr = CHANGE_I18N[(c ?? '').trim()];
  return tr ? L(tr[0], tr[1], tr[2], undefined, tr[3], tr[4]) : c;
};

// Reader feedback → prefilled, correctly-labelled GitHub issues (spec §10),
// shown in the sidebar Edit & Source box. The taxonomy + label contract lives in
// src/lib/feedback.ts (shared with the Contribute page and the auto-flip
// workflow). The metadata footer carries the canonical /category/slug path so
// the workflow can auto-flip THIS article to needs-update, in any language.
const fbMeta = articleMetaFooter({
  title: d.title,
  topicId: d.topicId,
  category: d.category,
  slug: d.slug,
  locale,
});
const reportUrl = newIssueUrl({
  type: 'article-issue',
  title: `Report: ${d.title}`,
  body: `**What is incorrect?**\n\n\n**What should it say instead?**\n\n\n**Source supporting the correction (link):**\n${fbMeta}`,
});
const suggestUrl = newIssueUrl({
  type: 'article-issue',
  title: `Suggestion: ${d.title}`,
  body: `**What could be clearer or more complete?**\n${fbMeta}`,
});
// A reader on a translated page can flag a bad/stale translation (routes to
// translationStatus: stale, not the article's content). Only meaningful when the
// page actually is a translation, i.e. the reader's locale isn't the master.
const masterLang = d.masterLanguage ?? 'ms';
const showTranslationReport = locale !== masterLang;
const translationUrl = newIssueUrl({
  type: 'translation-issue',
  title: `Translation (${locale}): ${d.title}`,
  body: `**What reads wrong or is out of date in the ${locale} translation?**\n\n\n**Suggested wording (optional):**\n${fbMeta}`,
});
const related = await relatedArticles(article, locale);
const mins = readingTime(article);
const pillar = getPillar(d.category);
const pillarDef = pillar ? getPillarDef(pillar) : undefined;
const sensitive = d.sensitivity !== 'none';
// A sensitive article that is already live gets a calmer, accurate notice — not
// the "requires review before publication" warning, which only fits pre-live states.
const sensitiveLive = sensitive && (d.status === 'published' || d.status === 'reviewed');

// Visitor buckets for this article, summarised (per-bot detail → hover title).
const views = analytics[`${d.category}/${d.slug}`] ?? null;
const bTotal = (x?: AnalyticsBucket) => (x == null ? null : typeof x === 'object' ? x.total : x);
const bBreak = (x?: AnalyticsBucket) =>
  x && typeof x === 'object' && x.byBot
    ? Object.entries(x.byBot).map(([k, n]) => `${k}: ${n.toLocaleString()}`).join(' · ')
    : '';
const visitorRows = [
  { label: L('Pembaca', 'Readers', '读者', 'வாசகர்கள்', '読者', '독자'), x: views?.readers as AnalyticsBucket | undefined },
  { label: L('Enjin carian', 'Search', '搜索引擎', 'தேடல் இயந்திரம்', '検索エンジン', '검색 엔진'), x: views?.search },
  { label: 'AI', x: views?.ai },
];
const SENS_LABEL: Record<string, string> = {
  race: L('Kaum', 'Race', '种族', 'இனம்', '人種', '인종'),
  religion: L('Agama', 'Religion', '宗教', 'மதம்', '宗教', '종교'),
  royalty: L('Institusi diraja', 'Royalty', '王室', 'அரச நிறுவனம்', '王室', '왕실'),
  constitution: L('Perlembagaan', 'Constitution', '宪法', 'அரசியலமைப்பு', '憲法', '헌법'),
  elections: L('Pilihan raya', 'Elections', '选举', 'தேர்தல்கள்', '選挙', '선거'),
  security: L('Keselamatan', 'Security', '安全', 'பாதுகாப்பு', '安全保障', '안보'),
  health: L('Kesihatan', 'Health', '健康', 'சுகாதாரம்', '健康', '보건'),
  'legal-proceedings': L('Perundangan', 'Legal', '法律程序', 'சட்டம்', '法律', '법률'),
};
const sensLabel = sensitive ? (SENS_LABEL[d.sensitivity] ?? L('Sensitif', 'Sensitive', '敏感', 'உணர்திறன் மிக்க', 'センシティブ', '민감')) : null;

const fmt = (dt: Date | null | undefined) =>
  dt
    ? new Date(dt).toLocaleDateString(
        locale === 'zh' ? 'zh-CN' : locale === 'ms' ? 'ms-MY' : locale === 'ja' ? 'ja-JP' : locale === 'ko' ? 'ko-KR' : 'en-GB',
        { day: 'numeric', month: 'short', year: 'numeric' },
      )
    : '—';

// Chain of custody: a Drafted → Reviewed → Published lifecycle, each stage with
// a date and an actor. New `created`/`author`/`published`/`publishedBy` fields
// take precedence; otherwise the stage is derived from the data we already keep
// so the timeline is populated on every article without a per-file backfill.
const isReviewed = d.status === 'reviewed' || d.status === 'published';
const isPublished = d.status === 'published';
// AI-drafted pages disclose "AI-assisted" (the honest provenance); only when a
// human actually wrote it do we credit the `author` name. The schema's generic
// "NegaraKu.md Editorial" default must not masquerade as a human author here.
const draftBy = d.aiAssisted
  ? L('Dibantu AI', 'AI-assisted', 'AI 辅助', 'AI உதவியுடன்', 'AI 支援', 'AI 지원')
  : (d.author ?? L('Manusia', 'Human', '人工', 'மனிதர்', '人間', '사람'));
const lifecycle = [
  {
    key: 'drafted',
    label: L('Dirangka', 'Drafted', '起草', 'வரையப்பட்டது', '起草', '초안 작성'),
    // revisions are stored newest-first, so the FIRST draft is the last entry.
    date: d.created ?? d.revisions?.at(-1)?.date ?? d.updated,
    by: draftBy,
    done: true,
  },
  {
    key: 'reviewed',
    label: L('Disemak', 'Reviewed', '审阅', 'மதிப்பாய்வு செய்யப்பட்டது', '査読済み', '검토 완료'),
    date: isReviewed ? d.reviewed : null,
    // No human reviewer on this AI-generated corpus: disclose "AI-verified"
    // (verified against primary sources), not a human name. A human review
    // later sets `reviewer` to their handle and this shows that instead.
    by: isReviewed ? (d.reviewer ?? (d.aiAssisted ? L('Disahkan AI', 'AI-verified', 'AI 核实', 'AI சரிபார்த்தது', 'AI 検証済み', 'AI 검증됨') : null)) : null,
    done: isReviewed,
  },
  {
    key: 'published',
    label: L('Diterbitkan', 'Published', '发布', 'வெளியிடப்பட்டது', '公開済み', '공개 완료'),
    date: isPublished ? (d.published ?? d.reviewed) : null,
    by: isPublished ? (d.publishedBy ?? d.reviewer) : null,
    done: isPublished,
  },
];

// Section-header icons. All monochrome (stroke: currentColor → the muted header
// colour), so they aid scanning without spending any of the semantic palette.
const svg = (inner: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
const ICON = {
  answer: svg('<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>'),
  explanation: svg('<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>'),
  faq: svg('<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>'),
  sources: svg('<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>'),
  related: svg('<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>'),
  toc: svg('<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>'),
  trust: svg('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>'),
  edit: svg('<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>'),
};

const toc = headings.filter((h) => h.depth === 2);

// Sibling navigation within the topic (subcategory). A reader who finishes an
// article should be able to move sideways to the next thing in the same topic,
// not just up the breadcrumb. Order matches the topic page listing.
const topicSlug = d.subcategory[0];
const topicLabel = topicSlug ? subcatLabel(topicSlug, locale) : null;
const topicHref = topicSlug ? localePath(`/${d.category}/topic/${topicSlug}`, locale) : null;
let siblings: Article[] = [];
// Label + link for the pager's "More in …" header. Defaults to the topic;
// falls back to the category when the article is alone in its topic.
let groupLabel = topicLabel;
let groupHref = topicHref;
{
  const all = await articlesForLocale(locale);
  if (topicSlug) {
    siblings = all.filter((a) => a.data.category === d.category && a.data.subcategory.includes(topicSlug));
  }
  // A lone article in its topic has no Prev/Next, leaving a dead-end page.
  // Fall back to the parent category so every article still points onward.
  if (siblings.length < 2) {
    siblings = all.filter((a) => a.data.category === d.category);
    groupLabel = cat ? loc(cat.name, locale) : d.category;
    groupHref = localePath(`/${d.category}`, locale);
  }
}
const sIdx = siblings.findIndex((a) => a.data.slug === d.slug);
const prev = sIdx > 0 ? siblings[sIdx - 1] : null;
const next = sIdx >= 0 && sIdx < siblings.length - 1 ? siblings[sIdx + 1] : null;
const aHref = (a: Article) => localePath(`/${a.data.category}/${a.data.slug}`, locale);
---

<header class="art-hero">
  <div class="container">
    <svg class="hero-bloom" viewBox="0 0 776 776" aria-hidden="true" data-pagefind-ignore>
      <path fill="currentColor" fill-rule="evenodd" d={FLOWER_D} />
    </svg>
    <p class="crumb" data-pagefind-ignore>
      <a href={localePath('/', locale)}>{L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム', '홈')}</a> /
      {pillarDef && (
        <>
          <a href={localePath(`/${pillar}`, locale)}>{loc(pillarDef.name, locale)}</a> {' / '}
        </>
      )}
      <a href={localePath(`/${d.category}`, locale)}>{cat ? loc(cat.name, locale) : d.category}</a>
      {d.subcategory[0] && (
        <>
          {' / '}
          <a href={localePath(`/${d.category}/topic/${d.subcategory[0]}`, locale)}>
            {subcatLabel(d.subcategory[0], locale)}
          </a>
        </>
      )}
    </p>

    <div class="badges" data-pagefind-ignore>
      <span class="pill mode">
        {
          d.mode === 'narrative'
            ? L('📜 Naratif', '📜 Narrative', '📜 叙事', '📜 கதையாடல்', '📜 物語', '📜 서사')
            : L('🧭 Praktikal', '🧭 Practical', '🧭 实用', '🧭 நடைமுறை', '🧭 実用', '🧭 실용')
        }
      </span>
      <TrustBadge
        locale={locale}
        status={d.status}
        sensitivity={d.sensitivity}
        translationStatus={d.translationStatus}
        statusDate={isPublished ? fmt(d.published ?? d.reviewed) : undefined}
      />
      <span class="pill">{mins} {L('min baca', 'min read', '分钟阅读', 'நிமிட வாசிப்பு', '分で読める', '분 읽기')}</span>
      {d.reviewDue && (
        <span class={`pill pill-date${new Date(d.reviewDue) < new Date() ? ' overdue' : ''}`}>
          {new Date(d.reviewDue) < new Date()
            ? `⚠ ${L('Semakan tertunggak', 'Review overdue', '审阅逾期', 'மதிப்பாய்வு தாமதமானது', '査読期限切れ', '검토 기한 초과')}`
            : L('Semakan seterusnya', 'Next review', '下次审阅', 'அடுத்த மதிப்பாய்வு', '次回査読', '다음 검토')} {fmt(d.reviewDue)}
        </span>
      )}
    </div>

    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
  </div>
</header>

<article class="art container">

  {
    sensitive && (
      <div class={sensitiveLive ? 'sens sens-live' : 'sens'}>
        <b>🔒 {L('Kandungan sensitif', 'Sensitive content', '敏感内容', 'உணர்திறன் மிக்க உள்ளடக்கம்', 'センシティブなコンテンツ', '민감한 콘텐츠')}{SENS_LABEL[d.sensitivity] ? ` — ${SENS_LABEL[d.sensitivity]}` : ''}</b>
        <p>
          {sensitiveLive
            ? L(
                'Topik ini tergolong dalam kategori sensitif dan dibentangkan secara deskriptif dan neutral sahaja.',
                'This topic falls under a sensitive category and is presented descriptively and neutrally.',
                '本主题属于敏感类别，内容仅作中立、描述性呈现。',
                'இந்தத் தலைப்பு உணர்திறன் மிக்க வகையைச் சேர்ந்தது; இது விவரணமாகவும் நடுநிலையாகவும் மட்டுமே வழங்கப்படுகிறது.',
                'このトピックはセンシティブなカテゴリーに属し、記述的かつ中立的にのみ提示されています。',
                '이 주제는 민감한 범주에 속하며 서술적이고 중립적으로만 제시됩니다.',
              )
            : L(
                'Topik ini tergolong dalam kategori sensitif dan memerlukan semakan manusia sebelum diterbitkan sepenuhnya. Ia dibentangkan secara deskriptif dan neutral sahaja.',
                'This topic falls under a sensitive category and requires human review before full publication. It is presented descriptively and neutrally only.',
                '本主题属于敏感类别，需经人工审阅后方可正式发布。内容仅作中立、描述性呈现。',
                'இந்தத் தலைப்பு உணர்திறன் மிக்க வகையைச் சேர்ந்தது; முழுமையாக வெளியிடப்படுவதற்கு முன் மனிதப் பரிசீலனை தேவை. இது விவரணமாகவும் நடுநிலையாகவும் மட்டுமே வழங்கப்படுகிறது.',
                'このトピックはセンシティブなカテゴリーに属し、全面公開の前に人間による査読が必要です。記述的かつ中立的にのみ提示されています。',
                '이 주제는 민감한 범주에 속하며 완전한 공개 전에 사람의 검토가 필요합니다. 서술적이고 중립적으로만 제시됩니다.',
              )}
        </p>
      </div>
    )
  }

  <div class="layout">
    <div class="main">
      {
        d.answer && (
          <section class="layer l1">
            <header>
              <span class="sec-h"><span class="ico" set:html={ICON.answer} />{L('Jawapan pantas', '30-second answer', '30秒速答', '30 வினாடி பதில்', '30秒でわかる答え', '30초 답변')}</span>
              {d.reviewed && (
                <span>
                  {L('Disemak', 'Reviewed', '审阅于', 'மதிப்பாய்வு செய்யப்பட்டது', '査読日', '검토일')} {fmt(d.reviewed)}
                </span>
              )}
            </header>
            <div class="lb">
              <p class="answer">{d.answer}</p>
              {d.keyTakeaways.length > 0 && (
                <ul class="kt">
                  {d.keyTakeaways.map((k) => (
                    <li>{k}</li>
                  ))}
                </ul>
              )}
              {d.appliesTo && (
                <p class="applies">
                  <b>{L('Untuk siapa:', 'Who this applies to:', '适用对象：', 'யாருக்குப் பொருந்தும்:', '対象となる人：', '적용 대상:')}</b> {d.appliesTo}
                </p>
              )}
            </div>
          </section>
        )
      }

      {
        toc.length > 0 && (
          <details class="toc-mobile">
            <summary>{L('Dalam halaman ini', 'On this page', '本页内容', 'இந்தப் பக்கத்தில்', 'このページの内容', '이 페이지에서')}</summary>
            <nav>
              {toc.map((h) => (
                <a href={`#${h.slug}`}>{h.text}</a>
              ))}
            </nav>
          </details>
        )
      }

      <section class="layer">
        <header>
          <span class="sec-h"><span class="ico" set:html={ICON.explanation} />{L('Penjelasan penuh', 'Full explanation', '完整说明', 'முழு விளக்கம்', '詳しい説明', '전체 설명')}</span>
          <span>≈{mins} {L('min', 'min', '分钟', 'நிமிடம்', '分', '분')}</span>
        </header>
        <div class="lb prose"><Content /></div>
      </section>

      {
        d.faq.length > 0 && (
          <section class="layer">
            <header>
              <span class="sec-h"><span class="ico" set:html={ICON.faq} />{L('Soalan lazim', 'Frequently asked', '常见问题', 'அடிக்கடி கேட்கப்படுபவை', 'よくある質問', '자주 묻는 질문')}</span>
              <span>{d.faq.length}</span>
            </header>
            <div class="lb faqs">
              {d.faq.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }


      <section class="layer">
        <header>
          <span class="sec-h"><span class="ico" set:html={ICON.sources} />{L('Sumber & sejarah', 'Sources & history', '来源与历史', 'ஆதாரங்கள் & வரலாறு', '出典と履歴', '출처 및 이력')}</span>
          <span>{d.sources.length} {L('sumber', 'sources', '来源', 'ஆதாரங்கள்', '件の出典', '출처')}</span>
        </header>
        <div class="lb">
          {
            d.verificationNeeded.length > 0 && (
              <div class="verify">
                <b>
