---
import { render } from 'astro:content';
import type { Locale } from '@/lib/categories';
import { getCategory, getPillar, getPillarDef, loc } from '@/lib/categories';
import { type Article, relatedArticles, readingTime, articlesForLocale, isTombstone } from '@/lib/content';
import { localePath } from '@/lib/i18n';
import { REPO, CONTRIBUTIONS_PAUSED } from '@/lib/site';
import { newIssueUrl, articleMetaFooter } from '@/lib/feedback';
import { subcatLabel } from '@/lib/subcategories';
import { getFramework } from '@/lib/frameworks';
import { imageLabel, needsRepresentativeBadge, reviewSourceLabel } from '@/lib/imageProvenance';
import { isolateRanges } from '@/lib/bidi';
import TrustBadge from './TrustBadge.astro';
import FeedbackBar from './FeedbackBar.astro';
import BecomeContributor from './BecomeContributor.astro';
import SponsorCTA from './SponsorCTA.astro';
import RelatedToolCard from './RelatedToolCard.astro';
import { toolForArticle } from '@/lib/tools';
import { resolveSponsor, sponsorUrl } from '@/lib/sponsors';
import { getAnalytics, type AnalyticsBucket } from '@/lib/apidata';

// Visitor analytics (see docs/ANALYTICS.md): three buckets — human readers,
// search-engine crawlers, AI crawlers — tracked per named bot, summarised here.
// Absent until an edge-logging layer is wired up → "not tracked yet". Parsed
// once (memoized in apidata) rather than re-read on each of ~3,000 pages.
const analytics = getAnalytics();

// THE THREE-LAYER ARTICLE.
//   Layer 1  the 30-second answer      — what AI assistants extract and cite
//   Layer 2  practical understanding   — the article body
//   Layer 3  depth: sources, history   — provenance and context
// Two writing modes share this template: `practical` (answer-first) and
// `narrative` (story-led). The difference is voice and framing, not structure —
// even a story opens with an orienting answer.

interface Props {
  locale: Locale;
  article: Article;
}
const { locale, article } = Astro.props;
const d = article.data;
// Arabic bidi fix: isolate reversing numeric ranges in the plain-text frontmatter
// fields (the body is handled by the rehype plugin). No-op for every other locale.
const iso = (t: string) => (locale === 'ar' ? isolateRanges(t) : t);
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string, ar?: string, hi?: string, es?: string, fr?: string) => (locale === 'fr' ? (fr ?? ms) : locale === 'es' ? (es ?? ms) : locale === 'hi' ? (hi ?? ms) : locale === 'ar' ? (ar ?? ms) : locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

const tomb = isTombstone(article); // a retired no-successor topic, served read-only

// Every FOOD article shows at least one image. When it has no honest photo
// (d.hero unset) we fall back to a branded, language-neutral graphic (bunga raya
// + a gold food motif + wordmark) — obviously a brand graphic, so it guarantees
// coverage without ever faking a photo. Subcategory picks the motif.
const FOOD_FALLBACK = { restaurants: 'restaurants', 'michelin-guide': 'restaurants', drinks: 'drinks', alcohol: 'drinks', pasar: 'markets', kopitiam: 'markets', ramadan: 'markets' } as Record<string, string>;
const heroSrc = d.hero ?? (d.category === 'food-lifestyle'
  ? `/media/fallback/food-${FOOD_FALLBACK[(Array.isArray(d.subcategory) ? d.subcategory[0] : d.subcategory) as string] ?? 'food-lifestyle'}.webp`
  : null);
const heroIsFallback = !d.hero && !!heroSrc;
// Generated provenance label (示意图/店家供图/编辑实拍) for a real hero — never for
// the branded fallback. A representative hero also shows a visible badge so the
// label travels on every surface (docs/FOOD-ARTICLE-STANDARD.md §"One image rule").
const heroLabel = d.hero ? imageLabel(d.heroKind, d.heroOrigin, locale) : null;
const heroRepBadge = d.hero && needsRepresentativeBadge(d.heroKind);
// Attributed taste commentary — PLACE food articles only; an award alone is not a
// review, so this renders only when a real food observation was authored.
const reviews = (d.foodType === 'place' && Array.isArray(d.review)) ? d.review.filter((r) => (r.flavor?.length ?? 0) > 0) : [];
const sourceById = new Map((d.sources ?? []).filter((s) => s.id).map((s) => [s.id as string, s]));
const heroAltText = d.hero
  ? (d.heroAlt ?? '')
  : L('Makanan dan gaya hidup Malaysia', 'Malaysian food & lifestyle', '马来西亚美食与生活', 'மலேசிய உணவு மற்றும் வாழ்க்கை முறை', 'マレーシアの食と暮らし', '말레이시아의 음식과 라이프스타일', 'อาหารและไลฟ์สไตล์มาเลเซีย', 'Ẩm thực và đời sống Malaysia', 'Makanan dan gaya hidup Malaysia', 'الطعام ونمط الحياة في ماليزيا', 'मलेशियाई भोजन और जीवनशैली', 'Comida y estilo de vida de Malasia', 'Cuisine et art de vivre malaisiens');
const cat = getCategory(d.category);
// "Also in" — the approved cross-placements (alsoIn category ids) shown on the
// article as alternate category links. Each opens a listing that contains this
// article (content.ts includes alsoIn guests). Primary category is excluded.
const alsoInCats = (d.alsoIn ?? []).map((c) => getCategory(c)).filter((c): c is NonNullable<typeof c> => !!c && c.id !== d.category);
const path = `/${d.category}/${d.slug}`;
// The GitHub source file for THIS rendered entry: the master is `<slug>.md`,
// a translation is `<slug>.<lang>.md`. `d.lang` is the actual file shown (it
// reflects a fallback correctly), so a reader on a translated page edits the
// translation, not the master.
const isMasterFile = d.lang === (d.masterLanguage ?? d.lang);
const sourceFile = `knowledge/${d.category}/${d.slug}${isMasterFile ? '' : `.${d.lang}`}.md`;
const { Content, headings } = await render(article);

// Revision-history `change` notes are authored once (English) and stored on every
// language file, so they render as English on the ms/zh pages. Translate the known
// canonical phrases at render time (the corpus currently uses a single one).
const CHANGE_I18N: Record<string, [string, string, string, string, string, string, string, string, string]> = {
  'Approved and published.': ['Diluluskan dan diterbitkan.', 'Approved and published.', '已批准并发布。', '承認され公開されました。', '승인되어 공개되었습니다.', 'อนุมัติและเผยแพร่แล้ว.', 'Đã phê duyệt và xuất bản.', 'Disetujui dan diterbitkan.', 'تمت الموافقة والنشر.'],
  'Initial publication.': ['Penerbitan awal.', 'Initial publication.', '首次发布。', '初回公開。', '최초 공개.', 'การเผยแพร่ครั้งแรก.', 'Xuất bản lần đầu.', 'Penerbitan awal.', 'النشر الأولي.'],
};
const changeLabel = (c: string): string => {
  const tr = CHANGE_I18N[(c ?? '').trim()];
  return tr ? L(tr[0], tr[1], tr[2], undefined, tr[3], tr[4], tr[5], tr[6], tr[7], tr[8]) : c;
};

// Reader feedback → prefilled, correctly-labelled GitHub issues (spec §10),
// shown in the sidebar Edit & Source box. The taxonomy + label contract lives in
// src/lib/feedback.ts (shared with the Contribute page and the auto-flip
// workflow). The metadata footer carries the canonical /category/slug path so
// the workflow can auto-flip THIS article to needs-update, in any language.
const fbMeta = articleMetaFooter({
  title: d.title,
  topicId: d.topicId,
  category: d.category,
  slug: d.slug,
  locale,
});
const reportUrl = newIssueUrl({
  type: 'article-issue',
  title: `Report: ${d.title}`,
  body: `**What is incorrect?**\n\n\n**What should it say instead?**\n\n\n**Source supporting the correction (link):**\n${fbMeta}`,
});
const suggestUrl = newIssueUrl({
  type: 'article-issue',
  title: `Suggestion: ${d.title}`,
  body: `**What could be clearer or more complete?**\n${fbMeta}`,
});
// A reader on a translated page can flag a bad/stale translation (routes to
// translationStatus: stale, not the article's content). Only meaningful when the
// page actually is a translation, i.e. the reader's locale isn't the master.
const masterLang = d.masterLanguage ?? 'ms';
const showTranslationReport = locale !== masterLang;
// Critical-correction safeguard (docs/CORRECTION-SAFEGUARD.md): when the master was
// corrected but this language is still `stale`, warn the reader (banner) or, for a
// harmful-if-stale correction, WITHHOLD the old content and show only the notice.
const staleTranslation = locale !== masterLang && d.translationStatus === 'stale';
const withheld = staleTranslation && (d.staleSafeguard ?? 'banner') === 'withhold';
const staleBanner = staleTranslation && !withheld;
const correctedUrl = localePath(path, masterLang);
const masterLangName = ({ ms: 'Bahasa Melayu', en: 'English', zh: '中文', ta: 'தமிழ்', ja: '日本語', ko: '한국어', th: 'ไทย', vi: 'Tiếng Việt', id: 'Bahasa Indonesia', ar: 'العربية', hi: 'हिन्दी', es: 'Español', fr: 'Français' } as Record<string, string>)[masterLang] ?? masterLang.toUpperCase();
const translationUrl = newIssueUrl({
  type: 'translation-issue',
  title: `Translation (${locale}): ${d.title}`,
  body: `**What reads wrong or is out of date in the ${locale} translation?**\n\n\n**Suggested wording (optional):**\n${fbMeta}`,
});
const related = await relatedArticles(article, locale);
const mins = readingTime(article);
const pillar = getPillar(d.category);
const pillarDef = pillar ? getPillarDef(pillar) : undefined;
// Reader-need framework (Sprint 1b v2): a localized "what kind of article" chip.
// Optional + absent-safe — an untagged article simply renders no chip.
const fwDef = getFramework(d.framework);
const sensitive = d.sensitivity !== 'none';
// Disclosed sponsor CTA (sensitive content is never sponsored — see sponsors.ts).
const sponsor = resolveSponsor(d.sponsor, pillar, sensitive, d.category, d.slug);
const sponsorHref = sponsor ? sponsorUrl(sponsor, d.category, d.slug) : '';
// Related interactive tool (Tools hub): the one live tool that turns this topic
// into an action (a personal-tax article → the income-tax calculator). Mapping in
// src/lib/tools.ts; template-rendered, so it never affects translation freshness.
// Not shown on sensitive articles — their reader focus stays on the neutral notice.
const relatedTool = sensitive ? null : toolForArticle(d.category, d.slug, locale);
// A sensitive article that is already live gets a calmer, accurate notice — not
// the "requires review before publication" warning, which only fits pre-live states.
const sensitiveLive = sensitive && (d.status === 'published' || d.status === 'reviewed');

// Visitor buckets for this article, summarised (per-bot detail → hover title).
const views = analytics[`${d.category}/${d.slug}`] ?? null;
const bTotal = (x?: AnalyticsBucket) => (x == null ? null : typeof x === 'object' ? x.total : x);
const bBreak = (x?: AnalyticsBucket) =>
  x && typeof x === 'object' && x.byBot
    ? Object.entries(x.byBot).map(([k, n]) => `${k}: ${n.toLocaleString()}`).join(' · ')
    : '';
const visitorRows = [
  { label: L('Pembaca', 'Readers', '读者', 'வாசகர்கள்', '読者', '독자', 'ผู้อ่าน', 'Độc giả', 'Pembaca', 'القرّاء', 'पाठक', 'Lectores', "Lecteurs"), x: views?.readers as AnalyticsBucket | undefined },
  { label: L('Enjin carian', 'Search', '搜索引擎', 'தேடல் இயந்திரம்', '検索エンジン', '검색 엔진', 'เครื่องมือค้นหา', 'Công cụ tìm kiếm', 'Mesin pencari', 'محرك البحث', 'खोजें', 'Motor de búsqueda', "Moteurs de recherche"), x: views?.search },
  { label: 'AI', x: views?.ai },
];
const SENS_LABEL: Record<string, string> = {
  race: L('Kaum', 'Race', '种族', 'இனம்', '人種', '인종', 'เชื้อชาติ', 'Chủng tộc', 'Ras', 'العرق', 'नस्ल', 'Raza', "Race"),
  religion: L('Agama', 'Religion', '宗教', 'மதம்', '宗教', '종교', 'ศาสนา', 'Tôn giáo', 'Agama', 'الدين', 'धर्म', 'Religión', "Religion"),
  royalty: L('Institusi diraja', 'Royalty', '王室', 'அரச நிறுவனம்', '王室', '왕실', 'สถาบันพระมหากษัตริย์', 'Hoàng gia', 'Institusi kerajaan', 'المؤسسة الملكية', 'राजसत्ता', 'Realeza', "Monarchie"),
  constitution: L('Perlembagaan', 'Constitution', '宪法', 'அரசியலமைப்பு', '憲法', '헌법', 'รัฐธรรมนูญ', 'Hiến pháp', 'Konstitusi', 'الدستور', 'संविधान', 'Constitución', "Constitution"),
  elections: L('Pilihan raya', 'Elections', '选举', 'தேர்தல்கள்', '選挙', '선거', 'การเลือกตั้ง', 'Bầu cử', 'Pemilihan umum', 'الانتخابات', 'चुनाव', 'Elecciones', "Élections"),
  security: L('Keselamatan', 'Security', '安全', 'பாதுகாப்பு', '安全保障', '안보', 'ความมั่นคง', 'An ninh', 'Keamanan', 'الأمن', 'सुरक्षा', 'Seguridad', "Sécurité"),
  health: L('Kesihatan', 'Health', '健康', 'சுகாதாரம்', '健康', '보건', 'สุขภาพ', 'Sức khỏe', 'Kesehatan', 'الصحة', 'स्वास्थ्य', 'Salud', "Santé"),
  'legal-proceedings': L('Perundangan', 'Legal', '法律程序', 'சட்டம்', '法律', '법률', 'กฎหมาย', 'Pháp lý', 'Hukum', 'الشؤون القانونية', 'कानूनी', 'Jurídico', "Juridique"),
};
const sensLabel = sensitive ? (SENS_LABEL[d.sensitivity] ?? L('Sensitif', 'Sensitive', '敏感', 'உணர்திறன் மிக்க', 'センシティブ', '민감', 'ละเอียดอ่อน', 'Nhạy cảm', 'Sensitif', 'حساس', 'संवेदनशील', 'Sensible', "Sensible")) : null;

const fmt = (dt: Date | null | undefined) =>
  dt
    ? new Date(dt).toLocaleDateString(
        locale === 'zh' ? 'zh-CN' : locale === 'ms' ? 'ms-MY' : locale,
        { day: 'numeric', month: 'short', year: 'numeric' },
      )
    : '—';

// Chain of custody: a Drafted → Reviewed → Published lifecycle, each stage with
// a date and an actor. New `created`/`author`/`published`/`publishedBy` fields
// take precedence; otherwise the stage is derived from the data we already keep
// so the timeline is populated on every article without a per-file backfill.
const isReviewed = d.status === 'reviewed' || d.status === 'published';
const isPublished = d.status === 'published';
// AI-drafted pages disclose "AI-assisted" (the honest provenance); only when a
// human actually wrote it do we credit the `author` name. The schema's generic
// "NegaraKu.md Editorial" default must not masquerade as a human author here.
const draftBy = d.aiAssisted
  ? L('Dibantu AI', 'AI-assisted', 'AI 辅助', 'AI உதவியுடன்', 'AI 支援', 'AI 지원', 'ช่วยเหลือโดย AI', 'Có hỗ trợ của AI', 'Dibantu AI', 'بمساعدة الذكاء الاصطناعي', 'AI-सहायता प्राप्त', 'Asistido por IA', "Assisté par IA")
  : (d.author ?? L('Manusia', 'Human', '人工', 'மனிதர்', '人間', '사람', 'มนุษย์', 'Con người', 'Manusia', 'بشري', 'मानव', 'Humano', "Humain"));
// Published actor: a general (non-sensitive) article is honestly "AI-published"
// (AI drafted, verified AND published it); a sensitive one must carry the NAMED
// human who signed it off — "no sensitive content publishes without a named reviewer".
const aiPublished = L('Diterbitkan AI', 'AI-published', 'AI 发布', 'AI வெளியிட்டது', 'AI が公開', 'AI 공개', 'เผยแพร่โดย AI', 'Được AI xuất bản', 'Diterbitkan AI', 'نُشر بواسطة الذكاء الاصطناعي', 'AI द्वारा प्रकाशित', 'Publicado por IA', "Publié par IA");
const publishedBy = sensitive ? (d.publishedBy ?? d.reviewer ?? aiPublished) : aiPublished;
const lifecycle = [
  {
    key: 'drafted',
    label: L('Dirangka', 'Drafted', '起草', 'வரையப்பட்டது', '起草', '초안 작성', 'ร่างแล้ว', 'Đã soạn thảo', 'Dirancang', 'تمت الصياغة', 'प्रारूपित', 'Redactado', "Rédigé"),
    // revisions are stored newest-first, so the FIRST draft is the last entry.
    date: d.created ?? d.revisions?.at(-1)?.date ?? d.updated,
    by: draftBy,
    done: true,
  },
  {
    key: 'reviewed',
    label: L('Disemak', 'Reviewed', '审阅', 'மதிப்பாய்வு செய்யப்பட்டது', '査読済み', '검토 완료', 'ตรวจทานแล้ว', 'Đã duyệt', 'Ditinjau', 'تمت المراجعة', 'समीक्षित', 'Revisado', "Relu"),
    date: isReviewed ? d.reviewed : null,
    // No human reviewer on this AI-generated corpus: disclose "AI-verified"
    // (verified against primary sources), not a human name. A human review
    // later sets `reviewer` to their handle and this shows that instead.
    by: isReviewed ? (d.reviewer ?? (d.aiAssisted ? L('Disahkan AI', 'AI-verified', 'AI 核实', 'AI சரிபார்த்தது', 'AI 検証済み', 'AI 검증됨', 'ตรวจสอบโดย AI', 'Được AI xác minh', 'Diverifikasi AI', 'تم التحقق بواسطة الذكاء الاصطناعي', 'AI द्वारा सत्यापित', 'Verificado por IA', "Vérifié par IA") : null)) : null,
    done: isReviewed,
  },
  {
    key: 'published',
    label: L('Diterbitkan', 'Published', '发布', 'வெளியிடப்பட்டது', '公開済み', '공개 완료', 'เผยแพร่แล้ว', 'Đã xuất bản', 'Diterbitkan', 'تم النشر', 'प्रकाशित', 'Publicado', "Publié"),
    date: isPublished ? (d.published ?? d.reviewed) : null,
    by: isPublished ? publishedBy : null,
    done: isPublished,
  },
];

// Section-header icons. All monochrome (stroke: currentColor → the muted header
// colour), so they aid scanning without spending any of the semantic palette.
const svg = (inner: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
const ICON = {
  answer: svg('<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>'),
  explanation: svg('<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>'),
  faq: svg('<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>'),
  myth: svg('<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>'),
  sources: svg('<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>'),
  place: svg('<path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>'),
  facts: svg('<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01"/><path d="M12 14h4"/><path d="M8 18h.01"/><path d="M12 18h4"/>'),
  related: svg('<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>'),
  toc: svg('<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>'),
  trust: svg('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>'),
  edit: svg('<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>'),
};

const toc = headings.filter((h) => h.depth === 2);

// --- Place card helpers (venue profiles) -------------------------------
// Halal status → localised label + tone (green = halal-friendly, red = not,
// neutral = informational). Sourced per venue, never guessed.
const HALAL = {
  'halal-certified': { tone: 'ok', icon: '✓', label: L('Halal (disahkan)', 'Halal-certified', '清真认证', 'ஹலால் (சான்று)', 'ハラール認証', '할랄 인증', 'ฮาลาล (รับรอง)', 'Halal (chứng nhận)', 'Halal (bersertifikat)', 'حلال (معتمد)', 'हलाल (प्रमाणित)', 'Halal (certificado)', 'Halal (certifié)') },
  'halal': { tone: 'ok', icon: '✓', label: L('Halal', 'Halal', '清真', 'ஹலால்', 'ハラール', '할랄', 'ฮาลาล', 'Halal', 'Halal', 'حلال', 'हलाल', 'Halal', 'Halal') },
  'muslim-owned': { tone: 'ok', icon: '✓', label: L('Milik Muslim', 'Muslim-owned', '穆斯林经营', 'முஸ்லிம் உரிமை', 'ムスリム経営', '무슬림 운영', 'เจ้าของมุสลิม', 'Chủ người Hồi giáo', 'Milik Muslim', 'مملوك لمسلمين', 'मुस्लिम-स्वामित्व', 'De propiedad musulmana', 'Tenu par des musulmans') },
