  .pill {
    font-size: 0.68rem; font-weight: 700; border-radius: 999px; padding: 0.1rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--ink) 28%, var(--line)); background: var(--surface-2); color: var(--ink-soft);
  }
  .pill.tier { color: var(--gold); border-color: color-mix(in srgb, var(--gold) 45%, var(--line)); background: color-mix(in srgb, var(--gold) 9%, transparent); }
  .pill.mode { color: #60a5fa; border-color: rgba(96, 165, 250, 0.35); background: rgba(96, 165, 250, 0.1); }
  /* Reader-need framework chip — violet, distinct from mode (blue) and tier (gold). */
  .pill.framework { color: #a78bfa; border-color: rgba(167, 139, 250, 0.35); background: rgba(167, 139, 250, 0.1); }
  /* Date metadata (Published / Next review): lighter weight so it reads as info, not a status. */
  .pill.pill-date { font-weight: 500; color: var(--muted); background: transparent; }
  /* Once the review date has passed the pill turns red (the sensitive colour)
     to flag it as overdue. */
  .pill.pill-date.overdue {
    font-weight: 700; color: #f87171;
    border-color: rgba(248, 113, 113, 0.5); background: rgba(248, 113, 113, 0.12);
  }
  .art-hero h1 { margin: 0 0 0.9rem; font-family: var(--font-title); font-weight: 900; letter-spacing: -0.03em; font-size: clamp(2.2rem, 4.6vw, 3.4rem); line-height: 1.05; max-width: 24ch; color: var(--ink); }
  .lede { color: var(--ink-soft); font-size: 1.1rem; line-height: 1.6; max-width: 60ch; margin: 0; }

  .sens {
    border: 1px solid rgba(248, 113, 113, 0.4); background: rgba(248, 113, 113, 0.07);
    border-radius: 12px; padding: 0.85rem 1rem; margin-bottom: 1.4rem;
  }
  .sens b { color: #f87171; font-family: var(--font-title); font-size: 0.95rem; }
  .sens p { margin: 0.35rem 0 0; color: var(--ink-soft); font-size: 0.88rem; }
  /* Live sensitive content uses the same red treatment as the sensitivity chip. */

  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 2.2rem; align-items: start; }

  /* Neutral is the default section header. Gold is reserved for the 30-second
     answer (.l1) and the sponsor block (.cta) so it means "the one thing" again. */
  .layer { border: 1px solid var(--line); border-radius: 12px; margin-bottom: 1.2rem; overflow: hidden; }
  /* Tier-1 BODY section header: an open editorial header (transparent, a touch
     larger, with a neutral left tick) — deliberately unlike the sidebar cards'
     filled chip headers, so the two title levels read apart. */
  .layer > header {
    display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.95rem; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.09em;
    text-transform: uppercase; color: var(--ink); background: transparent;
    border-bottom: 1px solid var(--line);
  }
  /* Section-header label + leading icon. Monochrome, inherits header colour. */
  .sec-h { display: inline-flex; align-items: center; gap: 0.42rem; position: relative; padding-inline-start: 0.62rem; }
  .sec-h::before {
    content: ''; position: absolute; inset-inline-start: 0; top: 50%; transform: translateY(-50%);
    width: 3px; height: 0.95em; border-radius: 2px; background: var(--muted);
  }
  .ico { display: inline-flex; flex: none; }
  .ico :global(svg) { width: 13px; height: 13px; opacity: 0.75; }
  .layer .lb { padding: 1.1rem; }
  .l1 { border-color: color-mix(in srgb, var(--gold) 42%, transparent); }
  .l1 > header { color: var(--gold); background: color-mix(in srgb, var(--gold) 9%, transparent); }
  /* Gold headers (answer, sponsor) keep the accent tick in their own colour. */
  .l1 > header .sec-h::before, .cta > header .sec-h::before { background: currentColor; opacity: 0.7; }
  .answer { font-size: 1.06rem; line-height: 1.65; margin: 0; }
  .kt { margin: 0.9rem 0 0; padding-inline-start: 1.15rem; }
  .kt li { margin: 0.3rem 0; font-size: 0.94rem; }
  .applies {
    margin: 0.9rem 0 0; background: var(--surface-2); border-radius: 9px;
    padding: 0.6rem 0.8rem; font-size: 0.88rem; color: var(--ink-soft);
  }
  .applies b { color: var(--ink); }

  /* Where to find & ratings (venue profiles) */
  .l-place { border-color: color-mix(in srgb, var(--gold) 42%, transparent); }
  .l-place > header { color: var(--gold); background: color-mix(in srgb, var(--gold) 9%, transparent); }
  .l-place > header .sec-h::before { background: currentColor; opacity: 0.7; }
  .place { display: flex; flex-direction: column; gap: 0.6rem; }
  .place-native { margin: 0; font-family: var(--font-title); font-size: 1.1rem; font-weight: 700; color: var(--ink); }
  .place-row { margin: 0; display: flex; align-items: flex-start; gap: 0.55rem; font-size: 0.95rem; color: var(--ink-soft); line-height: 1.5; }
  .place-row > span:last-child { min-width: 0; }
  .place-ico { flex: 0 0 auto; width: 1.05em; height: 1.05em; color: var(--gold); margin-top: 0.15em; }
  .place-ico :global(svg) { width: 100%; height: 100%; }
  .place-rating .stars { color: var(--gold); font-size: 1.05rem; line-height: 1; margin-top: 0.1em; }
  .place-rating b { color: var(--ink); font-size: 1.02rem; }
  .place-src { color: var(--ink-faint, var(--ink-soft)); }
  .place-actions { margin: 0.2rem 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem 0.8rem; }
  .place-btn {
    display: inline-flex; align-items: center; gap: 0.3rem;
    padding: 0.42rem 0.85rem; border-radius: 9px; font-size: 0.9rem; font-weight: 700;
    color: #000; background: var(--gold); text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--gold) 70%, #000);
  }
  .place-btn:hover { background: color-mix(in srgb, var(--gold) 86%, #fff); }
  .place-note { font-size: 0.8rem; color: var(--ink-soft); }
  .place-hint { font-size: 0.86rem; color: var(--ink-faint, var(--ink-soft)); }
  .place-hint .place-emoji { opacity: 0.85; }
  .place-checked { margin: 0.1rem 0 0; font-size: 0.78rem; color: var(--ink-faint, var(--ink-soft)); opacity: 0.85; }
  .place-links { margin: 0.2rem 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; font-size: 0.88rem; }
  .place-links a { color: var(--gold); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--gold) 35%, transparent); }
  .place-links a:hover { border-bottom-color: var(--gold); }
  .place-emoji { flex: 0 0 auto; width: 1.15em; margin-top: 0.05em; text-align: center; }
  .place-lbl { color: var(--ink); }
  .halal-badge { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.2rem 0.65rem; border-radius: 999px; font-size: 0.84rem; font-weight: 700; line-height: 1.5; }
  .halal-ok { color: #8ff0b8; background: color-mix(in srgb, #10b981 16%, transparent); border: 1px solid color-mix(in srgb, #10b981 45%, transparent); }
  .halal-no { color: #ffb4b4; background: color-mix(in srgb, #f43f5e 15%, transparent); border: 1px solid color-mix(in srgb, #f43f5e 45%, transparent); }
  .halal-info { color: #ffd98a; background: color-mix(in srgb, var(--gold) 13%, transparent); border: 1px solid color-mix(in srgb, var(--gold) 38%, transparent); }
  .place-reviews { background: var(--surface-2); border-radius: 9px; padding: 0.7rem 0.85rem; font-size: 0.92rem; color: var(--ink-soft); line-height: 1.55; }
  .place-readmore a { color: var(--gold); text-decoration: none; white-space: nowrap; }
  .place-readmore a:hover { text-decoration: underline; }

  .prose :global(h2) { margin: 1.6rem 0 0.6rem; }
  .prose :global(h3) { margin: 1.2rem 0 0.5rem; }
  .prose :global(p) { margin: 0.7rem 0; }
  /* In-body images match the in-column hero: full content-column width, rounded, bordered. */
  .prose :global(img) {
    display: block; width: 100%; height: auto;
    border-radius: 14px; border: 1px solid var(--line);
    background: var(--surface-2); margin: 1.4rem 0 0.5rem;
  }
  .prose :global(figure) { margin: 1.4rem 0; }
  .prose :global(figure img) { margin: 0; }
  .prose :global(figure figcaption) {
    margin-top: 0.45rem; font-size: 0.78rem; color: var(--ink-soft); text-align: end;
  }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin: 1rem 0; display: block; overflow-x: auto; }
  /* Long code blocks / unbroken tokens must scroll inside their box, never the page. */
  .prose :global(pre) { overflow-x: auto; max-width: 100%; }
  .prose :global(code) { overflow-wrap: anywhere; }
  .prose :global(th), .prose :global(td) { text-align: start; padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--line); }
  .prose :global(th) { color: var(--muted); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .prose :global(blockquote) {
    border-inline-start: 3px solid var(--gold); margin: 1.2rem 0; padding-block: 0.3rem; padding-inline-start: 1rem;
    font-style: italic; color: var(--ink);
  }
  .prose :global(ol), .prose :global(ul) { padding-inline-start: 1.3rem; }
  .prose :global(li) { margin: 0.3rem 0; }

  .faqs details {
    border: 1px solid var(--line); border-radius: 10px; background: var(--surface-2);
    padding: 0.55rem 0.85rem; margin-bottom: 0.5rem;
  }
  .faqs summary {
    cursor: pointer; font-family: var(--font-title); font-weight: 700;
    font-size: 0.94rem; list-style: none;
  }
  .faqs summary::-webkit-details-marker { display: none; }
  .faqs summary::before { content: '＋ '; color: var(--gold); font-weight: 800; }
  .faqs details[open] summary::before { content: '－ '; }
  .faqs p { margin: 0.5rem 0 0.2rem; color: var(--ink-soft); font-size: 0.89rem; line-height: 1.6; }

  /* Common misconceptions — myth→fact callout (the "fact card" differentiator). */
  .myths { display: flex; flex-direction: column; gap: 0.6rem; }
  .myth {
    border: 1px solid var(--line); border-radius: 10px; background: var(--surface-2);
    padding: 0.7rem 0.9rem; display: flex; flex-direction: column; gap: 0.4rem;
    border-inline-start: 3px solid color-mix(in srgb, #10b981 55%, var(--line));
  }
  .myth-row { margin: 0; display: flex; gap: 0.55rem; align-items: baseline; font-size: 0.92rem; line-height: 1.55; }
  .myth-tag {
    flex: 0 0 auto; font-size: 0.66rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase;
    padding: 0.12rem 0.45rem; border-radius: 999px; line-height: 1.5; margin-top: 0.08rem;
  }
  .myth-tag.tx { color: #ffb4b4; background: color-mix(in srgb, #f43f5e 15%, transparent); border: 1px solid color-mix(in srgb, #f43f5e 45%, transparent); }
  .myth-tag.tk { color: #8ff0b8; background: color-mix(in srgb, #10b981 16%, transparent); border: 1px solid color-mix(in srgb, #10b981 45%, transparent); }
  .myth-x span:last-child { color: var(--ink-soft); }
  .myth-ok span:last-child { color: var(--ink); }

  /* Festival "what-is" quick-facts card — scannable label/value grid (乐 move). */
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin: 0; }
  .fact {
    border: 1px solid var(--line); border-radius: 10px; background: var(--surface-2);
    padding: 0.65rem 0.85rem; border-inline-start: 3px solid color-mix(in srgb, var(--gold) 55%, var(--line));
    min-width: 0;
  }
  .fact dt {
    font-size: 0.66rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--gold); margin: 0 0 0.25rem;
  }
  .fact dd { margin: 0; font-size: 0.92rem; line-height: 1.55; color: var(--ink); }
  @media (max-width: 640px) { .facts { grid-template-columns: 1fr; } }

  .verify {
    border: 1px solid rgba(251, 191, 36, 0.4); background: rgba(251, 191, 36, 0.07);
    border-radius: 10px; padding: 0.75rem 0.9rem; margin-bottom: 1.2rem;
  }
  .verify b { color: #fbbf24; font-family: var(--font-title); font-size: 0.9rem; }
  .verify p { margin: 0.3rem 0 0.4rem; color: var(--ink-soft); font-size: 0.85rem; }
  .verify ul { margin: 0; padding-inline-start: 1.1rem; color: var(--ink-soft); font-size: 0.85rem; }
  .verify li { margin: 0.2rem 0; }

  .src { padding-inline-start: 1.2rem; margin: 0.4rem 0 1.2rem; font-size: 0.89rem; }
  .src a { color: var(--gold); }
  .pub { color: var(--muted); }
  h3, .sec-h { font-size: 1rem; margin: 0 0 0.4rem; }
  .muted { color: var(--muted); font-size: 0.88rem; }
  .tblwrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; }
  .tblwrap table { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
  .tblwrap th, .tblwrap td { text-align: start; padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--line); }
  .tblwrap th { color: var(--muted); font-size: 0.7rem; text-transform: uppercase; background: var(--surface-2); }

  .rel {
    margin-top: 1.2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px; overflow: hidden;
  }
  .rel > header {
    padding: 0.45rem 0.95rem; font-size: 0.67rem; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--ink); background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .rel-body { padding: 1.1rem 0.95rem; }
  .rgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0.7rem; }
  .rgrid a {
    display: flex; flex-direction: column; gap: 0.22rem; padding: 0.8rem 0.95rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: 11px;
    text-decoration: none; color: inherit;
  }
  .rgrid a:hover { border-color: color-mix(in srgb, var(--gold) 45%, var(--line)); }
  .rgrid b { font-family: var(--font-title); font-size: 0.94rem; }
  .rgrid span { color: var(--ink-soft); font-size: 0.84rem; }

  .cta {
    /* Symmetric margin: this used to be the last block on the page so it only needed
       a top gap. Now it sits between the FAQ and Sources & history, and a commercial
       block butting straight into the trust layer reads as part of it. Slightly wider
       than the 1.2rem section rhythm so it stays visually detached from both sides. */
    display: block; margin: 1.6rem 0; padding: 0; border-radius: 12px; overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--gold) 42%, transparent);
  }
  .cta > header {
    padding: 0.45rem 0.95rem; font-size: 0.67rem; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--gold); background: color-mix(in srgb, var(--gold) 9%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .cta-body { padding: 1.1rem 0.95rem; }
  .cta b { display: block; font-family: var(--font-title); font-size: 1.02rem; margin: 0 0 0.3rem; }
  .cta p { margin: 0 0 0.6rem; color: var(--ink-soft); font-size: 0.88rem; }
  /* The 1company.com wordmark stays gold and lowercase (.oneco brand guard). */
  .cta .brand { color: var(--gold); font-weight: 700; }
  .cta .go { color: var(--gold); font-weight: 800; font-size: 0.86rem; }

  .side { position: sticky; top: 5rem; display: flex; flex-direction: column; gap: 0.8rem; }
  .toc, .trust, .side-box {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px; overflow: hidden; padding: 0;
  }
  .trust { font-size: 0.82rem; }
  .toc b, .trust b, .side-box b {
    display: flex; align-items: center; gap: 0.42rem; margin: 0;
    padding: 0.45rem 0.95rem;
    font-size: 0.67rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink); background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .toc a { display: block; font-size: 0.85rem; color: var(--ink-soft); padding: 0.2rem 0.95rem; text-decoration: none; }
  .toc a:first-of-type { padding-top: 0.6rem; }
  .toc a:last-of-type { padding-bottom: 0.6rem; }
  .toc a:hover { color: var(--gold); }
  .trust .r { display: flex; justify-content: space-between; gap: 0.6rem; padding: 0.3rem 0.95rem; border-bottom: 1px dashed var(--line); }
  .trust .r-status { padding-top: 0.6rem; }
  .trust .r:last-child { border-bottom: 0; padding-bottom: 0.6rem; }
  .trust .r span:first-child { color: var(--muted); }
  .trust .sens-tag { color: #f87171; font-weight: 700; }
  .trust .rev-overdue { color: #f87171; font-weight: 700; }
  .trust .r-sens .muted { color: var(--muted); }
  /* Tier-3 GROUP label (Custody, Visitors): an uppercase micro-header that opens
     a sub-list, distinct from the sentence-case leaf rows (Status, Version…). */
  .trust .r-custody-head {
    border-bottom: 0; border-top: 1px solid var(--line);
    margin-top: 0.35rem; padding: 0.55rem 0.95rem 0.2rem;
  }
  .trust .r-custody-head span:first-child {
    font-size: 0.62rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink);
  }
  .trust .r-custody-head .vnote { font-size: 0.68rem; font-style: italic; text-transform: none; letter-spacing: 0; }
  .trust .r-visit span:first-child { padding-inline-start: 0.2rem; }
  .trust .r-visit .vval { color: var(--ink); font-weight: 700; font-variant-numeric: tabular-nums; }
  .trust .r-visit .vval[title] { cursor: help; text-decoration: underline dotted color-mix(in srgb, var(--muted) 60%, transparent); text-underline-offset: 3px; }

  /* Chain of custody — Drafted → Reviewed → Published timeline. */
  .chain {
    list-style: none; margin: 0; padding: 0.7rem 0.95rem 0.5rem;
    border-bottom: 1px dashed var(--line);
  }
  .chain .ch {
    position: relative; padding: 0 0 0.9rem 1.15rem;
    line-height: 1.35;
  }
  .chain .ch:last-child { padding-bottom: 0; }
  /* Connector line running through the dots. */
  .chain .ch::before {
    content: ''; position: absolute; inset-inline-start: 4px; top: 0.72rem; bottom: -0.15rem;
    width: 2px; background: var(--line);
  }
  .chain .ch:last-child::before { display: none; }
  .chain .ch-dot {
    position: absolute; inset-inline-start: 0; top: 0.32rem;
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--surface); border: 2px solid var(--line); box-sizing: border-box;
  }
  .chain .ch.done .ch-dot { background: #4ade80; border-color: #4ade80; }
  .chain .ch.done::before { background: color-mix(in srgb, #4ade80 45%, var(--line)); }
  .chain .ch-label {
    display: block; font-size: 0.7rem; font-weight: 800;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft);
  }
  .chain .ch.pending .ch-label { color: var(--muted); }
  .chain .ch-meta { display: flex; justify-content: space-between; gap: 0.5rem; margin-top: 0.1rem; }
  .chain .ch-date { color: var(--ink); font-variant-numeric: tabular-nums; }
  .chain .ch.pending .ch-date { color: var(--muted); font-style: italic; }
  .chain .ch-by { color: var(--muted); }
  .edit { display: block; font-size: 0.82rem; color: var(--ink-soft); padding: 0.35rem 0.95rem; text-decoration-color: color-mix(in srgb, var(--ink-soft) 55%, transparent); }
  .edit:first-of-type { padding-top: 0.6rem; }
  .edit:last-of-type { padding-bottom: 0.6rem; }
  .edit:hover { color: var(--gold); }
  button.edit { width: 100%; text-align: start; background: none; border: 0; font-family: inherit; cursor: pointer; }
  button.edit.is-done { color: var(--green, #4ade80); }

  /* Floating prev/next arrows — sit just left of the site back-to-top button. */
  .artnav {
    position: fixed;
    bottom: clamp(1rem, 3vw, 2rem);
    inset-inline-end: calc(clamp(1rem, 3vw, 2rem) + 44px + 0.6rem);
    z-index: 45;
    display: flex;
    gap: 0.5rem;
  }
  .artnav-btn {
    width: 44px; height: 44px; border-radius: 999px;
    display: grid; place-items: center;
    border: 1px solid color-mix(in srgb, var(--gold) 55%, var(--line)); background: var(--surface-2); color: var(--gold);
    box-shadow: var(--shadow-soft);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .artnav-btn:hover { border-color: var(--gold); background: color-mix(in srgb, var(--gold) 10%, var(--surface)); }
  .artnav-btn svg { width: 20px; height: 20px; }
  /* RTL: the prev/next chevrons point left/right, so mirror them under dir=rtl. */
  :global([dir='rtl']) .artnav-btn svg { transform: scaleX(-1); }
  @media (max-width: 560px) {
    /* Keep the row from crowding: tuck the arrows a touch tighter on phones. */
    .artnav { gap: 0.4rem; inset-inline-end: calc(clamp(1rem, 3vw, 2rem) + 44px + 0.45rem); }
    .artnav-btn { width: 40px; height: 40px; }
  }

  /* Topic pager — prev/next within the topic. */
  .more-topic { color: var(--gold); font-weight: 800; font-size: 0.67rem; letter-spacing: 0.06em; text-decoration: none; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; }
  .pg {
    display: flex; flex-direction: column; gap: 0.25rem;
    padding: 0.85rem 1rem; border: 1px solid var(--line); border-radius: 10px;
    background: var(--surface-2); text-decoration: none; color: inherit;
    transition: border-color 0.15s;
  }
  .pg:hover { border-color: color-mix(in srgb, var(--gold) 55%, var(--line)); }
  .pg.next { text-align: end; }
  .pg .dir { color: var(--gold); font-size: 0.74rem; font-weight: 700; }
  .pg b { font-family: var(--font-title); font-size: 0.94rem; color: var(--ink); }
  .pg.empty { border: 0; background: none; }

  /* Heading anchors — hover a section heading to grab a deep link. */
  .prose :global(h2), .prose :global(h3) { position: relative; }
  .prose :global(.hanchor) {
    position: absolute; inset-inline-start: -1.1rem; top: 0; width: 1.1rem;
