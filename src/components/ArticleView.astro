---
import { render } from 'astro:content';
import type { Locale } from '@/lib/categories';
import { getCategory, getPillar, getPillarDef } from '@/lib/categories';
import { type Article, relatedArticles, readingTime, articlesForLocale } from '@/lib/content';
import { localePath } from '@/lib/i18n';
import { REPO } from '@/lib/site';
import { subcatLabel } from '@/lib/subcategories';
import TrustBadge from './TrustBadge.astro';
import FeedbackBar from './FeedbackBar.astro';
import { readFileSync } from 'node:fs';

// Visitor analytics (see docs/ANALYTICS.md): three buckets — human readers,
// search-engine crawlers, AI crawlers — tracked per named bot, summarised here.
// Absent until an edge-logging layer is wired up → "not tracked yet".
type Bucket = number | { total: number; byBot?: Record<string, number> };
let analytics: Record<string, { readers?: number; search?: Bucket; ai?: Bucket }> = {};
try {
  analytics = JSON.parse(readFileSync('public/api/analytics.json', 'utf8'));
} catch {
  analytics = {};
}

// THE THREE-LAYER ARTICLE.
//   Layer 1  the 30-second answer      — what AI assistants extract and cite
//   Layer 2  practical understanding   — the article body
//   Layer 3  depth: sources, history   — provenance and context
// Two writing modes share this template: `practical` (answer-first) and
// `narrative` (story-led). The difference is voice and framing, not structure —
// even a story opens with an orienting answer.

interface Props {
  locale: Locale;
  article: Article;
}
const { locale, article } = Astro.props;
const d = article.data;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

const cat = getCategory(d.category);
const path = `/${d.category}/${d.slug}`;
const { Content, headings } = await render(article);

// Report an error / Suggest an improvement — prefilled GitHub issues, shown in
// the sidebar Edit & Source box (site-wide `report` / `suggestion` labels).
const fbMeta = `\n\n---\nArticle: ${d.title}\nTopic ID: ${d.topicId}\nVersion: ${d.version}\nLanguage: ${locale}\nPath: ${localePath(path, locale)}\n`;
const reportUrl =
  `${REPO}/issues/new?` +
  new URLSearchParams({
    labels: 'report',
    title: `Report: ${d.title}`,
    body: `**What is incorrect?**\n\n\n**What should it say instead?**\n\n\n**Source supporting the correction (link):**\n${fbMeta}`,
  }).toString();
const suggestUrl =
  `${REPO}/issues/new?` +
  new URLSearchParams({
    labels: 'suggestion',
    title: `Suggestion: ${d.title}`,
    body: `**What could be clearer or more complete?**\n${fbMeta}`,
  }).toString();
const related = await relatedArticles(article, locale);
const mins = readingTime(article);
const pillar = getPillar(d.category);
const pillarDef = pillar ? getPillarDef(pillar) : undefined;
const isBusiness = pillar === 'doing-business';
const sensitive = d.sensitivity !== 'none';
// A sensitive article that is already live gets a calmer, accurate notice — not
// the "requires review before publication" warning, which only fits pre-live states.
const sensitiveLive = sensitive && (d.status === 'published' || d.status === 'reviewed');

// Visitor buckets for this article, summarised (per-bot detail → hover title).
const views = analytics[`${d.category}/${d.slug}`] ?? null;
const bTotal = (x?: Bucket) => (x == null ? null : typeof x === 'object' ? x.total : x);
const bBreak = (x?: Bucket) =>
  x && typeof x === 'object' && x.byBot
    ? Object.entries(x.byBot).map(([k, n]) => `${k}: ${n.toLocaleString()}`).join(' · ')
    : '';
const visitorRows = [
  { label: L('Pembaca', 'Readers', '读者'), x: views?.readers as Bucket | undefined },
  { label: L('Enjin carian', 'Search', '搜索引擎'), x: views?.search },
  { label: 'AI', x: views?.ai },
];
const SENS_LABEL: Record<string, string> = {
  race: L('Kaum', 'Race', '种族'),
  religion: L('Agama', 'Religion', '宗教'),
  royalty: L('Institusi diraja', 'Royalty', '王室'),
  constitution: L('Perlembagaan', 'Constitution', '宪法'),
  elections: L('Pilihan raya', 'Elections', '选举'),
  security: L('Keselamatan', 'Security', '安全'),
  health: L('Kesihatan', 'Health', '健康'),
  'legal-proceedings': L('Perundangan', 'Legal', '法律程序'),
};
const sensLabel = sensitive ? (SENS_LABEL[d.sensitivity] ?? L('Sensitif', 'Sensitive', '敏感')) : null;

const fmt = (dt: Date | null | undefined) =>
  dt
    ? new Date(dt).toLocaleDateString(
        locale === 'zh' ? 'zh-CN' : locale === 'ms' ? 'ms-MY' : 'en-GB',
        { day: 'numeric', month: 'short', year: 'numeric' },
      )
    : '—';

// Chain of custody: a Drafted → Reviewed → Published lifecycle, each stage with
// a date and an actor. New `created`/`author`/`published`/`publishedBy` fields
// take precedence; otherwise the stage is derived from the data we already keep
// so the timeline is populated on every article without a per-file backfill.
const isReviewed = d.status === 'reviewed' || d.status === 'published';
const isPublished = d.status === 'published';
// AI-drafted pages disclose "AI-assisted" (the honest provenance); only when a
// human actually wrote it do we credit the `author` name. The schema's generic
// "NegaraKu.md Editorial" default must not masquerade as a human author here.
const draftBy = d.aiAssisted
  ? L('Dibantu AI', 'AI-assisted', 'AI 辅助')
  : (d.author ?? L('Manusia', 'Human', '人工'));
const lifecycle = [
  {
    key: 'drafted',
    label: L('Dirangka', 'Drafted', '起草'),
    date: d.created ?? d.revisions?.[0]?.date ?? d.updated,
    by: draftBy,
    done: true,
  },
  {
    key: 'reviewed',
    label: L('Disemak', 'Reviewed', '审阅'),
    date: isReviewed ? d.reviewed : null,
    by: isReviewed ? d.reviewer : null,
    done: isReviewed,
  },
  {
    key: 'published',
    label: L('Diterbitkan', 'Published', '发布'),
    date: isPublished ? (d.published ?? d.reviewed) : null,
    by: isPublished ? (d.publishedBy ?? d.reviewer) : null,
    done: isPublished,
  },
];

// Section-header icons. All monochrome (stroke: currentColor → the muted header
// colour), so they aid scanning without spending any of the semantic palette.
const svg = (inner: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
const ICON = {
  answer: svg('<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>'),
  explanation: svg('<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>'),
  faq: svg('<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>'),
  sponsored: svg('<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>'),
  sources: svg('<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>'),
  related: svg('<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>'),
  toc: svg('<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>'),
  trust: svg('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>'),
  edit: svg('<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>'),
};

const toc = headings.filter((h) => h.depth === 2);

// Sibling navigation within the topic (subcategory). A reader who finishes an
// article should be able to move sideways to the next thing in the same topic,
// not just up the breadcrumb. Order matches the topic page listing.
const topicSlug = d.subcategory[0];
const topicLabel = topicSlug ? subcatLabel(topicSlug, locale) : null;
const topicHref = topicSlug ? localePath(`/${d.category}/topic/${topicSlug}`, locale) : null;
let siblings: Article[] = [];
// Label + link for the pager's "More in …" header. Defaults to the topic;
// falls back to the category when the article is alone in its topic.
let groupLabel = topicLabel;
let groupHref = topicHref;
{
  const all = await articlesForLocale(locale);
  if (topicSlug) {
    siblings = all.filter((a) => a.data.category === d.category && a.data.subcategory.includes(topicSlug));
  }
  // A lone article in its topic has no Prev/Next, leaving a dead-end page.
  // Fall back to the parent category so every article still points onward.
  if (siblings.length < 2) {
    siblings = all.filter((a) => a.data.category === d.category);
    groupLabel = cat?.name[locale] ?? d.category;
    groupHref = localePath(`/${d.category}`, locale);
  }
}
const sIdx = siblings.findIndex((a) => a.data.slug === d.slug);
const prev = sIdx > 0 ? siblings[sIdx - 1] : null;
const next = sIdx >= 0 && sIdx < siblings.length - 1 ? siblings[sIdx + 1] : null;
const aHref = (a: Article) => localePath(`/${a.data.category}/${a.data.slug}`, locale);
---

<header class="art-hero">
  <div class="container">
    <svg class="hero-bloom" viewBox="0 0 64 64" aria-hidden="true" data-pagefind-ignore>
      <defs><mask id="hero-bloom-mask"><rect width="64" height="64" fill="#fff" /><circle cx="32" cy="28" r="5.3" fill="#000" /></mask></defs>
      <g fill="currentColor" mask="url(#hero-bloom-mask)">
        <g transform="translate(32 28)">
          <ellipse cx="0" cy="-13" rx="7.6" ry="11.5" />
          <ellipse cx="0" cy="-13" rx="7.6" ry="11.5" transform="rotate(72)" />
          <ellipse cx="0" cy="-13" rx="7.6" ry="11.5" transform="rotate(144)" />
          <ellipse cx="0" cy="-13" rx="7.6" ry="11.5" transform="rotate(216)" />
          <ellipse cx="0" cy="-13" rx="7.6" ry="11.5" transform="rotate(288)" />
        </g>
        <path d="M32 28 C 32 39, 33 47, 35.5 54" stroke="currentColor" stroke-width="2.6" fill="none" stroke-linecap="round" />
        <circle cx="35.6" cy="54.2" r="2.5" />
        <circle cx="31" cy="49.5" r="1.9" />
        <circle cx="38.4" cy="50.4" r="1.9" />
      </g>
      <circle cx="32" cy="28" r="2.4" fill="currentColor" />
    </svg>
    <p class="crumb" data-pagefind-ignore>
      <a href={localePath('/', locale)}>{L('Laman Utama', 'Home', '首页')}</a> /
      {pillarDef && (
        <>
          <a href={localePath(`/${pillar}`, locale)}>{pillarDef.name[locale]}</a> {' / '}
        </>
      )}
      <a href={localePath(`/${d.category}`, locale)}>{cat?.name[locale] ?? d.category}</a>
      {d.subcategory[0] && (
        <>
          {' / '}
          <a href={localePath(`/${d.category}/topic/${d.subcategory[0]}`, locale)}>
            {subcatLabel(d.subcategory[0], locale)}
          </a>
        </>
      )}
    </p>

    <div class="badges" data-pagefind-ignore>
      <span class="pill mode">
        {
          d.mode === 'narrative'
            ? L('📜 Naratif', '📜 Narrative', '📜 叙事')
            : L('🧭 Praktikal', '🧭 Practical', '🧭 实用')
        }
      </span>
      <TrustBadge
        locale={locale}
        status={d.status}
        sensitivity={d.sensitivity}
        translationStatus={d.translationStatus}
      />
      <span class="pill">{mins} {L('min baca', 'min read', '分钟阅读')}</span>
    </div>

    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
  </div>
</header>

<article class="art container">

  {
    sensitive && (
      <div class={sensitiveLive ? 'sens sens-live' : 'sens'}>
        <b>🔒 {L('Kandungan sensitif', 'Sensitive content', '敏感内容')}</b>
        <p>
          {sensitiveLive
            ? L(
                'Topik ini tergolong dalam kategori sensitif dan dibentangkan secara deskriptif dan neutral sahaja.',
                'This topic falls under a sensitive category and is presented descriptively and neutrally.',
                '本主题属于敏感类别，内容仅作中立、描述性呈现。',
              )
            : L(
                'Topik ini tergolong dalam kategori sensitif dan memerlukan semakan manusia sebelum diterbitkan sepenuhnya. Ia dibentangkan secara deskriptif dan neutral sahaja.',
                'This topic falls under a sensitive category and requires human review before full publication. It is presented descriptively and neutrally only.',
                '本主题属于敏感类别，需经人工审阅后方可正式发布。内容仅作中立、描述性呈现。',
              )}
        </p>
      </div>
    )
  }

  <div class="layout">
    <div class="main">
      {
        d.answer && (
          <section class="layer l1">
            <header>
              <span class="sec-h"><span class="ico" set:html={ICON.answer} />{L('Jawapan pantas', '30-second answer', '30秒速答')}</span>
              <span>
                {L('Disemak', 'Reviewed', '审阅于')} {fmt(d.reviewed)}
              </span>
            </header>
            <div class="lb">
              <p class="answer">{d.answer}</p>
              {d.keyTakeaways.length > 0 && (
                <ul class="kt">
                  {d.keyTakeaways.map((k) => (
                    <li>{k}</li>
                  ))}
                </ul>
              )}
              {d.appliesTo && (
                <p class="applies">
                  <b>{L('Untuk siapa:', 'Who this applies to:', '适用对象：')}</b> {d.appliesTo}
                </p>
              )}
            </div>
          </section>
        )
      }

      {
        toc.length > 0 && (
          <details class="toc-mobile">
            <summary>{L('Dalam halaman ini', 'On this page', '本页内容')}</summary>
            <nav>
              {toc.map((h) => (
                <a href={`#${h.slug}`}>{h.text}</a>
              ))}
            </nav>
          </details>
        )
      }

      <section class="layer">
        <header>
          <span class="sec-h"><span class="ico" set:html={ICON.explanation} />{L('Penjelasan penuh', 'Full explanation', '完整说明')}</span>
          <span>≈{mins} {L('min', 'min', '分钟')}</span>
        </header>
        <div class="lb prose"><Content /></div>
      </section>

      {
        d.faq.length > 0 && (
          <section class="layer">
            <header>
              <span class="sec-h"><span class="ico" set:html={ICON.faq} />{L('Soalan lazim', 'Frequently asked', '常见问题')}</span>
              <span>{d.faq.length}</span>
            </header>
            <div class="lb faqs">
              {d.faq.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }


      <section class="layer">
        <header>
          <span class="sec-h"><span class="ico" set:html={ICON.sources} />{L('Sumber & sejarah', 'Sources & history', '来源与历史')}</span>
          <span>{d.sources.length} {L('sumber', 'sources', '来源')}</span>
        </header>
        <div class="lb">
          {
            d.verificationNeeded.length > 0 && (
              <div class="verify">
                <b>
                  ⚑ {L('Menunggu pengesahan pakar', 'Awaiting expert verification', '待专家核实')}
                </b>
                <p>
                  {L(
                    'Perkara berikut sengaja tidak dinyatakan atau diterangkan secara umum sahaja sehingga disahkan oleh pakar bidang:',
                    'The following are deliberately unstated or described only qualitatively until confirmed by a subject-matter expert:',
                    '以下内容在专家确认前，刻意未予明示或仅作定性描述：',
                  )}
                </p>
                <ul>
                  {d.verificationNeeded.map((v) => (
                    <li>{v}</li>
                  ))}
                </ul>
              </div>
            )
          }
          <h3>{L('Sumber', 'Sources', '来源')}</h3>
          {
            d.sources.length > 0 ? (
              <ol class="src">
                {d.sources.map((s) => (
                  <li>
                    {s.url ? (
                      <a href={s.url} rel="noopener">
                        {s.title}
                      </a>
                    ) : (
                      s.title
                    )}
                    {s.publisher && <span class="pub"> — {s.publisher}</span>}
                  </li>
                ))}
              </ol>
            ) : (
              <p class="muted">{L('Tiada sumber lagi.', 'No sources yet.', '暂无来源。')}</p>
            )
          }

          {
            d.revisions.length > 0 && (
              <div>
                <h3>{L('Sejarah perubahan', 'Change history', '修订历史')}</h3>
                <div class="tblwrap">
                  <table>
                    <thead>
                      <tr>
                        <th>{L('Versi', 'Version', '版本')}</th>
                        <th>{L('Tarikh', 'Date', '日期')}</th>
                        <th>{L('Perubahan', 'Change', '变更')}</th>
                        <th>{L('Oleh', 'By', '修订者')}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {d.revisions.map((r) => (
                        <tr>
                          <td>{r.version}</td>
                          <td>{fmt(r.date)}</td>
                          <td>{r.change}</td>
                          <td>{r.contributor ?? r.reviewer ?? '—'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )
          }
        </div>
      </section>

      {
        (prev || next) && (
          <section class="layer">
            <header>
              <span>{L('Lagi dalam', 'More in', '更多内容：')} {groupLabel}</span>
              <a class="more-topic" href={groupHref}>
                {L('Lihat semua', 'View all', '查看全部')} {siblings.length} →
              </a>
            </header>
            <div class="lb pager">
              {prev ? (
                <a class="pg" href={aHref(prev)}>
                  <span class="dir">← {L('Sebelum', 'Previous', '上一篇')}</span>
                  <b>{prev.data.title}</b>
                </a>
              ) : (
                <span class="pg empty" />
              )}
              {next ? (
                <a class="pg next" href={aHref(next)}>
                  <span class="dir">{L('Seterusnya', 'Next', '下一篇')} →</span>
                  <b>{next.data.title}</b>
                </a>
              ) : (
                <span class="pg empty" />
              )}
            </div>
          </section>
        )
      }

      {
        related.length > 0 && (
          <section class="rel" data-pagefind-ignore>
            <header><span class="sec-h"><span class="ico" set:html={ICON.related} />{L('Pengetahuan berkaitan', 'Related knowledge', '相关知识')}</span></header>
            <div class="rel-body">
              <div class="rgrid">
                {related.map((r) => (
                  <a href={localePath(`/${r.data.category}/${r.data.slug}`, locale)}>
                    <b>{r.data.title}</b>
                    <span>{r.data.summary}</span>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )
      }

      <FeedbackBar locale={locale} title={d.title} />

      {(prev || next) && (
        <nav class="artnav" aria-label={L('Navigasi artikel', 'Article navigation', '文章导航')} data-pagefind-ignore>
          {prev && (
            <a class="artnav-btn" href={aHref(prev)} title={prev.data.title} aria-label={`${L('Sebelum', 'Previous', '上一篇')}: ${prev.data.title}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="m12 19-7-7 7-7" /></svg>
            </a>
          )}
          {next && (
            <a class="artnav-btn" href={aHref(next)} title={next.data.title} aria-label={`${L('Seterusnya', 'Next', '下一篇')}: ${next.data.title}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </a>
          )}
        </nav>
      )}

    </div>

    <aside class="side" data-pagefind-ignore>
      {
        toc.length > 0 && (
          <nav class="toc">
            <b><span class="ico" set:html={ICON.toc} />{L('Dalam halaman ini', 'On this page', '本页内容')}</b>
            {toc.map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
          </nav>
        )
      }

      <div class="trust">
        <b><span class="ico" set:html={ICON.trust} />{L('Kepercayaan & asal usul', 'Trust & provenance', '可信度与来源')}</b>
        <div class="r r-status">
          <span>{L('Status', 'Status', '状态')}</span>
          <TrustBadge locale={locale} status={d.status} compact />
        </div>
        <div class="r r-sens">
          <span>{L('Klasifikasi', 'Classification', '分类')}</span>
          {
            sensitive ? (
              <span class="sens-tag">🔒 {sensLabel}</span>
            ) : (
              <span class="muted">{L('Umum', 'General', '一般')}</span>
            )
          }
        </div>

        <div class="r r-custody-head">
          <span>{L('Status', 'Status', '状态')}</span>
        </div>
        <ol class="chain">
          {
            lifecycle.map((s) => (
              <li class={s.done ? 'ch done' : 'ch pending'} data-stage={s.key}>
                <span class="ch-dot" aria-hidden="true" />
                <span class="ch-label">{s.label}</span>
                <span class="ch-meta">
                  {s.done ? (
                    <>
                      <span class="ch-date">{fmt(s.date)}</span>
                      <span class="ch-by">{s.by ?? '—'}</span>
                    </>
                  ) : (
                    <span class="ch-date">{L('Belum lagi', 'Not yet', '尚未')}</span>
                  )}
                </span>
              </li>
            ))
          }
        </ol>

        {
          d.reviewDue && (
            <div class="r r-next">
              <span>{L('Semakan seterusnya', 'Next review', '下次审阅')}</span>
              {new Date(d.reviewDue).getTime() < Date.now() ? (
                <span class="rev-overdue" title={L('Semakan tertunggak', 'Review overdue', '审阅逾期')}>
                  ⚠ {fmt(d.reviewDue)}
                </span>
              ) : (
                <span>{fmt(d.reviewDue)}</span>
              )}
            </div>
          )
        }
        <div class="r"><span>{L('Versi', 'Version', '版本')}</span><span>{d.version}</span></div>
        <div class="r"><span>{L('Bahasa induk', 'Master language', '主语言')}</span><span>{d.masterLanguage.toUpperCase()}</span></div>
        <div class="r"><span>{L('Sumber', 'Sources', '来源')}</span><span>{d.sources.length}</span></div>

        <div class="r r-custody-head">
          <span>{L('Pelawat', 'Visitors', '访客')}</span>
          {!views && <span class="muted vnote">{L('belum dijejak', 'not tracked yet', '尚未追踪')}</span>}
        </div>
        {
          visitorRows.map((vr) => (
            <div class="r r-visit">
              <span>{vr.label}</span>
              <span class="vval" title={bBreak(vr.x) || undefined}>
                {bTotal(vr.x) == null ? '—' : bTotal(vr.x)!.toLocaleString()}
              </span>
            </div>
          ))
        }
      </div>

      <div class="side-box">
        <b><span class="ico" set:html={ICON.edit} />{L('Sunting & sumber', 'Edit & source', '编辑与源码')}</b>
        <a class="edit" href={`${REPO}/blob/main/knowledge/${d.category}/${d.slug}.md`} rel="noopener">
          {L('Sunting di GitHub', 'Edit on GitHub', '在 GitHub 编辑')} ↗
        </a>
        <a class="edit" href={suggestUrl} rel="noopener">
          {L('Cadangkan penambahbaikan', 'Suggest an improvement', '建议改进')} ↗
        </a>
        <a class="edit" href={reportUrl} rel="noopener">
          {L('Laporkan isu', 'Report an issue', '报告问题')} ↗
        </a>
        <a class="edit" href={localePath(path, locale) + '.md'}>
          {L('Markdown mentah', 'Raw Markdown', '原始 Markdown')} ↗
        </a>
      </div>
    </aside>
  </div>
</article>

<style>
  /* Same hero treatment as the home / section heroes (PageHero): the gold-tinted
     gradient, big 900-weight headline, matched breadcrumb + padding. */
  .art-hero {
    background:
      radial-gradient(700px 420px at 12% -10%, color-mix(in srgb, var(--gold) 12%, transparent), transparent),
      radial-gradient(1100px 500px at 60% -20%, var(--surface-2), transparent);
    border-bottom: 1px solid var(--line);
    padding-block: 3.4rem 3rem;
    margin-bottom: 0;
  }
  /* Decorative blossom watermark filling the hero's open right side. Theme-aware
     (currentColor → gold/red), faint, behind the text, hidden on small screens. */
  .art-hero > .container { position: relative; }
  .hero-bloom {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    width: clamp(190px, 22vw, 330px);
    height: auto;
    color: var(--gold);
    opacity: 0.09;
    pointer-events: none;
    z-index: 0;
  }
  /* Keep the hero text above the watermark. */
  .art-hero > .container > :not(.hero-bloom) { position: relative; z-index: 1; }
  @media (max-width: 900px) {
    .hero-bloom { display: none; }
  }
  .art { padding-block: 2rem 4rem; }
  /* Articles use a NARROWER shell than the site-wide container: the 800px
     reading column + 260px sidebar only need ~1160px, so the wider container
     left a big empty gap between the prose and the sidebar on large screens.
     The hero shares the same width so both align. */
  .art,
  .art-hero > .container { max-width: 1160px; }
  .crumb { font-size: 0.84rem; color: var(--muted); margin: 0 0 1rem; }
  .crumb a { color: var(--muted); text-decoration: none; }
  .crumb a:hover { color: var(--gold); }
  .crumb span { color: var(--ink-soft); }
  .badges { display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center; margin-bottom: 1rem; }
  .pill {
    font-size: 0.68rem; font-weight: 700; border-radius: 999px; padding: 0.1rem 0.5rem;
    border: 1px solid var(--line); background: var(--surface-2); color: var(--ink-soft);
  }
  .pill.tier { color: var(--gold); border-color: color-mix(in srgb, var(--gold) 45%, var(--line)); background: color-mix(in srgb, var(--gold) 9%, transparent); }
  .pill.mode { color: #60a5fa; border-color: rgba(96, 165, 250, 0.35); background: rgba(96, 165, 250, 0.1); }
  .art-hero h1 { margin: 0 0 0.9rem; font-family: var(--font-title); font-weight: 900; letter-spacing: -0.03em; font-size: clamp(2.2rem, 4.6vw, 3.4rem); line-height: 1.05; max-width: 24ch; color: var(--ink); }
  .lede { color: var(--ink-soft); font-size: 1.1rem; line-height: 1.6; max-width: 60ch; margin: 0; }

  .sens {
    border: 1px solid rgba(248, 113, 113, 0.4); background: rgba(248, 113, 113, 0.07);
    border-radius: 12px; padding: 0.85rem 1rem; margin-bottom: 1.4rem;
  }
  .sens b { color: #f87171; font-family: var(--font-title); font-size: 0.95rem; }
  .sens p { margin: 0.35rem 0 0; color: var(--ink-soft); font-size: 0.88rem; }
  /* Live sensitive content: neutral notice, not an alarm (no red). */
  .sens-live { border-color: var(--line); background: var(--surface-2); }
  .sens-live b { color: var(--ink); }

  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 2.2rem; align-items: start; }

  /* Neutral is the default section header. Gold is reserved for the 30-second
     answer (.l1) and the sponsor block (.cta) so it means "the one thing" again. */
  .layer { border: 1px solid var(--line); border-radius: 12px; margin-bottom: 1.2rem; overflow: hidden; }
  /* Tier-1 BODY section header: an open editorial header (transparent, a touch
     larger, with a neutral left tick) — deliberately unlike the sidebar cards'
     filled chip headers, so the two title levels read apart. */
  .layer > header {
    display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.95rem; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.09em;
    text-transform: uppercase; color: var(--ink-soft); background: transparent;
    border-bottom: 1px solid var(--line);
  }
  /* Section-header label + leading icon. Monochrome, inherits header colour. */
  .sec-h { display: inline-flex; align-items: center; gap: 0.42rem; position: relative; padding-left: 0.62rem; }
  .sec-h::before {
    content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
    width: 3px; height: 0.95em; border-radius: 2px; background: var(--muted);
  }
  .ico { display: inline-flex; flex: none; }
  .ico :global(svg) { width: 13px; height: 13px; opacity: 0.75; }
  .layer .lb { padding: 1.1rem; }
  .l1 { border-color: color-mix(in srgb, var(--gold) 42%, transparent); }
  .l1 > header { color: var(--gold); background: color-mix(in srgb, var(--gold) 9%, transparent); }
  /* Gold headers (answer, sponsor) keep the accent tick in their own colour. */
  .l1 > header .sec-h::before, .cta > header .sec-h::before { background: currentColor; opacity: 0.7; }
  .answer { font-size: 1.06rem; line-height: 1.65; margin: 0; }
  .kt { margin: 0.9rem 0 0; padding-left: 1.15rem; }
  .kt li { margin: 0.3rem 0; font-size: 0.94rem; }
  .applies {
    margin: 0.9rem 0 0; background: var(--surface-2); border-radius: 9px;
    padding: 0.6rem 0.8rem; font-size: 0.88rem; color: var(--ink-soft);
  }
  .applies b { color: var(--ink); }

  .prose :global(h2) { margin: 1.6rem 0 0.6rem; }
  .prose :global(h3) { margin: 1.2rem 0 0.5rem; }
  .prose :global(p) { margin: 0.7rem 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin: 1rem 0; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--line); }
  .prose :global(th) { color: var(--muted); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--gold); margin: 1.2rem 0; padding: 0.3rem 0 0.3rem 1rem;
    font-style: italic; color: var(--ink);
  }
  .prose :global(ol), .prose :global(ul) { padding-left: 1.3rem; }
  .prose :global(li) { margin: 0.3rem 0; }

  .faqs details {
    border: 1px solid var(--line); border-radius: 10px; background: var(--surface-2);
    padding: 0.55rem 0.85rem; margin-bottom: 0.5rem;
  }
  .faqs summary {
    cursor: pointer; font-family: var(--font-title); font-weight: 700;
    font-size: 0.94rem; list-style: none;
  }
  .faqs summary::-webkit-details-marker { display: none; }
  .faqs summary::before { content: '＋ '; color: var(--gold); font-weight: 800; }
  .faqs details[open] summary::before { content: '－ '; }
  .faqs p { margin: 0.5rem 0 0.2rem; color: var(--ink-soft); font-size: 0.89rem; line-height: 1.6; }

  .verify {
    border: 1px solid rgba(251, 191, 36, 0.4); background: rgba(251, 191, 36, 0.07);
    border-radius: 10px; padding: 0.75rem 0.9rem; margin-bottom: 1.2rem;
  }
  .verify b { color: #fbbf24; font-family: var(--font-title); font-size: 0.9rem; }
  .verify p { margin: 0.3rem 0 0.4rem; color: var(--ink-soft); font-size: 0.85rem; }
  .verify ul { margin: 0; padding-left: 1.1rem; color: var(--ink-soft); font-size: 0.85rem; }
  .verify li { margin: 0.2rem 0; }

  .src { padding-left: 1.2rem; margin: 0.4rem 0 1.2rem; font-size: 0.89rem; }
  .src a { color: var(--gold); }
  .pub { color: var(--muted); }
  h3 { font-size: 1rem; margin: 0 0 0.4rem; }
  .muted { color: var(--muted); font-size: 0.88rem; }
  .tblwrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; }
  .tblwrap table { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
  .tblwrap th, .tblwrap td { text-align: left; padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--line); }
  .tblwrap th { color: var(--muted); font-size: 0.7rem; text-transform: uppercase; background: var(--surface-2); }

  .rel {
    margin-top: 1.2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px; overflow: hidden;
  }
  .rel > header {
    padding: 0.45rem 0.95rem; font-size: 0.67rem; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--muted); background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .rel-body { padding: 1.1rem 0.95rem; }
  .rgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0.7rem; }
  .rgrid a {
    display: flex; flex-direction: column; gap: 0.22rem; padding: 0.8rem 0.95rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: 11px;
    text-decoration: none; color: inherit;
  }
  .rgrid a:hover { border-color: color-mix(in srgb, var(--gold) 45%, var(--line)); }
  .rgrid b { font-family: var(--font-title); font-size: 0.94rem; }
  .rgrid span { color: var(--ink-soft); font-size: 0.84rem; }

  .cta {
    /* Symmetric margin: this used to be the last block on the page so it only needed
       a top gap. Now it sits between the FAQ and Sources & history, and a commercial
       block butting straight into the trust layer reads as part of it. Slightly wider
       than the 1.2rem section rhythm so it stays visually detached from both sides. */
    display: block; margin: 1.6rem 0; padding: 0; border-radius: 12px; overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--gold) 42%, transparent);
  }
  .cta > header {
    padding: 0.45rem 0.95rem; font-size: 0.67rem; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--gold); background: color-mix(in srgb, var(--gold) 9%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .cta-body { padding: 1.1rem 0.95rem; }
  .cta b { display: block; font-family: var(--font-title); font-size: 1.02rem; margin: 0 0 0.3rem; }
  .cta p { margin: 0 0 0.6rem; color: var(--ink-soft); font-size: 0.88rem; }
  /* The 1company.com wordmark stays gold and lowercase (.oneco brand guard). */
  .cta .brand { color: var(--gold); font-weight: 700; }
  .cta .go { color: var(--gold); font-weight: 800; font-size: 0.86rem; }

  .side { position: sticky; top: 5rem; display: flex; flex-direction: column; gap: 0.8rem; }
  .toc, .trust, .side-box {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px; overflow: hidden; padding: 0;
  }
  .trust { font-size: 0.82rem; }
  .toc b, .trust b, .side-box b {
    display: flex; align-items: center; gap: 0.42rem; margin: 0;
    padding: 0.45rem 0.95rem;
    font-size: 0.67rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--muted); background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .toc a { display: block; font-size: 0.85rem; color: var(--ink-soft); padding: 0.2rem 0.95rem; text-decoration: none; }
  .toc a:first-of-type { padding-top: 0.6rem; }
  .toc a:last-of-type { padding-bottom: 0.6rem; }
  .toc a:hover { color: var(--gold); }
  .trust .r { display: flex; justify-content: space-between; gap: 0.6rem; padding: 0.3rem 0.95rem; border-bottom: 1px dashed var(--line); }
  .trust .r-status { padding-top: 0.6rem; }
  .trust .r:last-child { border-bottom: 0; padding-bottom: 0.6rem; }
  .trust .r span:first-child { color: var(--muted); }
  .trust .sens-tag { color: #f87171; font-weight: 700; }
  .trust .rev-overdue { color: #f87171; font-weight: 700; }
  .trust .r-sens .muted { color: var(--muted); }
  /* Tier-3 GROUP label (Custody, Visitors): an uppercase micro-header that opens
     a sub-list, distinct from the sentence-case leaf rows (Status, Version…). */
  .trust .r-custody-head {
    border-bottom: 0; border-top: 1px solid var(--line);
    margin-top: 0.35rem; padding: 0.55rem 0.95rem 0.2rem;
  }
  .trust .r-custody-head span:first-child {
    font-size: 0.62rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted);
  }
  .trust .r-custody-head .vnote { font-size: 0.68rem; font-style: italic; text-transform: none; letter-spacing: 0; }
  .trust .r-visit span:first-child { padding-left: 0.2rem; }
  .trust .r-visit .vval { color: var(--ink); font-weight: 700; font-variant-numeric: tabular-nums; }
  .trust .r-visit .vval[title] { cursor: help; text-decoration: underline dotted color-mix(in srgb, var(--muted) 60%, transparent); text-underline-offset: 3px; }

  /* Chain of custody — Drafted → Reviewed → Published timeline. */
  .chain {
    list-style: none; margin: 0; padding: 0.7rem 0.95rem 0.5rem;
    border-bottom: 1px dashed var(--line);
  }
  .chain .ch {
    position: relative; padding: 0 0 0.9rem 1.15rem;
    line-height: 1.35;
  }
  .chain .ch:last-child { padding-bottom: 0; }
  /* Connector line running through the dots. */
  .chain .ch::before {
    content: ''; position: absolute; left: 4px; top: 0.72rem; bottom: -0.15rem;
    width: 2px; background: var(--line);
  }
  .chain .ch:last-child::before { display: none; }
  .chain .ch-dot {
    position: absolute; left: 0; top: 0.32rem;
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--surface); border: 2px solid var(--line); box-sizing: border-box;
  }
  .chain .ch.done .ch-dot { background: #4ade80; border-color: #4ade80; }
  .chain .ch.done::before { background: color-mix(in srgb, #4ade80 45%, var(--line)); }
  .chain .ch-label {
    display: block; font-size: 0.7rem; font-weight: 800;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft);
  }
  .chain .ch.pending .ch-label { color: var(--muted); }
  .chain .ch-meta { display: flex; justify-content: space-between; gap: 0.5rem; margin-top: 0.1rem; }
  .chain .ch-date { color: var(--ink); font-variant-numeric: tabular-nums; }
  .chain .ch.pending .ch-date { color: var(--muted); font-style: italic; }
  .chain .ch-by { color: var(--muted); }
  .edit { display: block; font-size: 0.82rem; color: var(--ink-soft); padding: 0.35rem 0.95rem; text-decoration-color: color-mix(in srgb, var(--ink-soft) 55%, transparent); }
  .edit:first-of-type { padding-top: 0.6rem; }
  .edit:last-of-type { padding-bottom: 0.6rem; }
  .edit:hover { color: var(--gold); }

  /* Floating prev/next arrows — sit just left of the site back-to-top button. */
  .artnav {
    position: fixed;
    bottom: clamp(1rem, 3vw, 2rem);
    right: calc(clamp(1rem, 3vw, 2rem) + 44px + 0.6rem);
    z-index: 45;
    display: flex;
    gap: 0.5rem;
  }
  .artnav-btn {
    width: 44px; height: 44px; border-radius: 999px;
    display: grid; place-items: center;
    border: 1px solid var(--line); background: var(--surface-2); color: var(--gold);
    box-shadow: var(--shadow-soft);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .artnav-btn:hover { border-color: var(--gold); background: var(--surface); }
  .artnav-btn svg { width: 20px; height: 20px; }
  @media (max-width: 560px) {
    /* Keep the row from crowding: tuck the arrows a touch tighter on phones. */
    .artnav { gap: 0.4rem; right: calc(clamp(1rem, 3vw, 2rem) + 44px + 0.45rem); }
    .artnav-btn { width: 40px; height: 40px; }
  }

  /* Topic pager — prev/next within the topic. */
  .more-topic { color: var(--gold); font-weight: 800; font-size: 0.67rem; letter-spacing: 0.06em; text-decoration: none; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; }
  .pg {
    display: flex; flex-direction: column; gap: 0.25rem;
    padding: 0.85rem 1rem; border: 1px solid var(--line); border-radius: 10px;
    background: var(--surface-2); text-decoration: none; color: inherit;
    transition: border-color 0.15s;
  }
  .pg:hover { border-color: color-mix(in srgb, var(--gold) 55%, var(--line)); }
  .pg.next { text-align: right; }
  .pg .dir { color: var(--gold); font-size: 0.74rem; font-weight: 700; }
  .pg b { font-family: var(--font-title); font-size: 0.94rem; color: var(--ink); }
  .pg.empty { border: 0; background: none; }

  /* Heading anchors — hover a section heading to grab a deep link. */
  .prose :global(h2), .prose :global(h3) { position: relative; }
  .prose :global(.hanchor) {
    position: absolute; left: -1.1rem; top: 0; width: 1.1rem;
    color: var(--gold); text-decoration: none; opacity: 0;
    font-weight: 700; transition: opacity 0.12s;
  }
  .prose :global(h2:hover) .hanchor, .prose :global(h3:hover) .hanchor { opacity: 0.7; }
  .prose :global(.hanchor:hover) { opacity: 1; }

  /* Mobile-only table of contents, near the top instead of buried at the foot. */
  .toc-mobile { display: none; }

  @media (max-width: 900px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; }
    .side .toc { display: none; }
    .pager { grid-template-columns: 1fr; }
    .toc-mobile {
      display: block; margin-bottom: 1.2rem;
      border: 1px solid var(--line);
      border-radius: 12px; overflow: hidden; background: var(--surface);
    }
    .toc-mobile > summary {
      list-style: none; cursor: pointer;
      padding: 0.55rem 0.95rem; font-size: 0.72rem; font-weight: 800;
      letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
      background: var(--surface-2);
    }
    .toc-mobile > summary::after { content: ' ▾'; }
    .toc-mobile[open] > summary::after { content: ' ▴'; }
    .toc-mobile nav { padding: 0.5rem 0.95rem 0.8rem; display: flex; flex-direction: column; }
    .toc-mobile a { color: var(--ink-soft); text-decoration: none; font-size: 0.9rem; padding: 0.3rem 0; }
    .toc-mobile a:hover { color: var(--gold); }
  }
</style>
<script>
  // Give each section heading a copyable deep-link anchor.
  for (const h of document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')) {
    const a = document.createElement('a');
    a.className = 'hanchor';
    a.href = '#' + h.id;
    a.textContent = '#';
    a.setAttribute('aria-label', 'Link to this section');
    h.prepend(a);
  }
</script>
