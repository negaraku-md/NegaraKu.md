<style>
  /* Tombstone notice — a retired, no-successor topic served read-only. */
  .art-tombstone {
    background: color-mix(in srgb, var(--gold) 12%, var(--surface));
    border-bottom: 1px solid color-mix(in srgb, var(--gold) 40%, var(--line));
  }
  .art-tombstone .container { padding-block: 0.85rem; display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; align-items: baseline; }
  .art-tombstone strong { color: var(--gold); font-family: var(--font-title); text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.82rem; }
  .art-tombstone span { color: var(--ink-soft); font-size: 0.9rem; }

  /* Hero / lead photo (docs/IMAGE-STANDARD.md). CLS-safe: the 16:9 aspect-ratio
     reserves space before the image loads, so no layout shift. */
  .art-photo { margin: 1.5rem 0 0.5rem; }
  .art-photo-inline { margin: 0 0 1.2rem; }
  .art-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--surface-2);
  }
  .art-photo figcaption {
    margin-top: 0.45rem;
    font-size: 0.78rem;
    color: var(--ink-soft);
    text-align: end;
  }
  .art-photo figcaption a { color: inherit; text-decoration: underline; }
  .art-photo figcaption .lic { opacity: 0.85; }
  .art-photo figcaption .prov { color: var(--gold); font-weight: 600; }
  /* 示意图 badge — travels with a representative image on every surface. */
  .art-photo { position: relative; }
  .art-photo-badge {
    position: absolute; top: 0.6rem; inset-inline-start: 0.6rem;
    font-size: 0.72rem; font-weight: 700; line-height: 1;
    padding: 0.32em 0.6em; border-radius: 999px;
    color: #000; background: color-mix(in srgb, var(--gold) 92%, #fff);
    box-shadow: 0 1px 4px rgba(0,0,0,0.35);
  }

  /* Food review block (PLACE articles) — attributed taste commentary. */
  .l-review {
    border: 1px solid color-mix(in srgb, var(--gold) 42%, transparent);
    border-radius: 12px; padding: 1.1rem; margin-bottom: 1.2rem;
    background: color-mix(in srgb, var(--gold) 6%, transparent);
  }
  .l-review-h {
    margin: 0 0 0.7rem; font-size: 0.82rem; font-family: var(--font-title);
    text-transform: uppercase; letter-spacing: 0.06em; color: var(--gold);
  }
  .review-entry + .review-entry { margin-top: 0.9rem; padding-top: 0.9rem; border-top: 1px solid var(--line); }
  .review-attr { margin: 0 0 0.35rem; font-size: 0.86rem; color: var(--ink-soft); }
  .review-src { font-weight: 700; color: var(--ink); }
  .review-src.is-visit { color: var(--gold); }
  .review-flavor, .review-tradeoffs { margin: 0.2rem 0 0; padding-inline-start: 1.1rem; }
  .review-flavor li { margin: 0.15rem 0; }
  .review-tradeoffs li { margin: 0.15rem 0; color: var(--ink-soft); font-style: italic; }
  .review-cite { margin: 0.4rem 0 0; font-size: 0.76rem; text-align: end; color: var(--ink-soft); }
  .review-cite a { color: inherit; text-decoration: underline; }

  /* Same hero treatment as the home / section heroes (PageHero): the gold-tinted
     gradient, big 900-weight headline, matched breadcrumb + padding. */
  .art-hero {
    background:
      radial-gradient(700px 420px at 12% -10%, color-mix(in srgb, var(--gold) 12%, transparent), transparent),
      radial-gradient(1100px 500px at 60% -20%, var(--surface-2), transparent);
    border-bottom: 1px solid var(--line);
    padding-block: 3.4rem 3rem;
    margin-bottom: 0;
  }
  /* Decorative blossom watermark filling the hero's open right side. Theme-aware
     (currentColor → gold/red), faint, behind the text, hidden on small screens. */
  .art-hero > .container { position: relative; }
  .hero-bloom {
    position: absolute;
    inset-inline-end: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
