---
// SponsorCTA — a disclosed call-to-action to the article's resolved sponsor
// (src/lib/sponsors.ts). ArticleView resolves the sponsor (sensitive content is
// never sponsored) and passes it in with a UTM-tagged href. Visually distinct
// from editorial content; the link carries rel="sponsored".
import type { Locale } from '@/lib/categories';
import type { Sponsor } from '@/lib/sponsors';

interface Props { locale: Locale; sponsor: Sponsor; href: string; }
const { locale, sponsor, href } = Astro.props;
const l = locale as Locale;
---

<aside class="spon" aria-label={sponsor.name} data-pagefind-ignore>
  <div class="spon-body">
    <p class="spon-head">{sponsor.heading[l]}</p>
    <p class="spon-text"><a class="oneco spon-name" href={href} target="_blank" rel="sponsored noopener">{sponsor.name}</a>{sponsor.blurb[l]}</p>
  </div>
  <a class="spon-cta" href={href} target="_blank" rel="sponsored noopener">
    {sponsor.cta[l]} <span class="dirx">→</span>
  </a>
</aside>

<style>
  .spon {
    display: grid;
    gap: 1.1rem;
    margin: 2.5rem 0 1rem;
    padding: 1.75rem 1.75rem 1.9rem;
    border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--gold) 6%, var(--surface, transparent));
  }
  .spon-head { margin: 0; font-weight: 700; font-size: 1.1rem; color: var(--gold); }
  .spon-text { margin: 0.5rem 0 0; color: var(--text-2, inherit); font-size: 0.95rem; line-height: 1.6; }
  .spon-name { color: var(--gold); font-weight: 700; text-transform: lowercase !important; text-decoration: none; }
  .spon-name:hover { text-decoration: underline; }
  .spon-cta {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    background: var(--gold);
    color: #000;
  }
  .spon-cta:hover { filter: brightness(1.05); }
  [dir='rtl'] .dirx { display: inline-block; transform: scaleX(-1); }
</style>
