---
import type { Locale } from '@/lib/categories';

// Shared page hero for every non-home page (section, category, topic, articles).
// Follows the HOME hero language: a big left-aligned headline on the gold-tinted
// gradient, with stat figures as boxes on the right — not a bordered card — so
// the whole site's heroes read as one family.

export interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  locale: Locale;
  crumb: Crumb[];
  title: string;
  desc?: string;
  stats?: { value: string | number; label: string }[];
}
const { crumb, title, desc, stats } = Astro.props;

// Brand consistency: wherever the "NegaraKu.md" wordmark appears in a hero title
// OR description, render the ".md" in gold to match the header/footer/home wordmark.
const WM = 'NegaraKu.md';
const wmIdx = title.indexOf(WM);
const descIdx = desc ? desc.indexOf(WM) : -1;
---

<header class="page-hero">
  <div class="container hero-inner">
    <div class="hero-lead">
      <p class="crumb" data-pagefind-ignore>
        {
          crumb.map((c, i) => (
            <>
              {i > 0 && <span class="sep"> / </span>}
              {c.href ? <a href={c.href}>{c.label}</a> : <span class="cur">{c.label}</span>}
            </>
          ))
        }
      </p>
      <h1 class="headline">
        {wmIdx === -1 ? (
          title
        ) : (
          <>
            {title.slice(0, wmIdx)}
            <span class="wm">NegaraKu<span class="wm-dot">.md</span></span>
            {title.slice(wmIdx + WM.length)}
          </>
        )}
      </h1>
      {desc && (
        <p class="pitch">
          {descIdx === -1 ? (
            desc
          ) : (
            <>
              {desc.slice(0, descIdx)}
              <span class="wm">NegaraKu<span class="wm-dot">.md</span></span>
              {desc.slice(descIdx + WM.length)}
            </>
          )}
        </p>
      )}
    </div>
    {
      stats && stats.length > 0 && (
        <dl class="stats" data-pagefind-ignore>
          {stats.map((s) => (
            <div class="stat">
              <dt>{s.value}</dt>
              <dd>{s.label}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</header>

<style>
  /* Matches the home hero: same gold-tinted gradient, big left headline, and
     the same stat-box treatment on the right. Adds a breadcrumb (inner pages
     need it; the home page doesn't). */
  .page-hero {
    background:
      radial-gradient(700px 420px at 12% -10%, color-mix(in srgb, var(--gold) 12%, transparent), transparent),
      radial-gradient(1100px 500px at 60% -20%, var(--surface-2), transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--gold) 30%, var(--line));
    padding-block: 3.4rem 3rem;
  }
  .hero-inner {
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2rem 3rem; align-items: center;
  }
  .hero-lead { min-width: 0; }
  .crumb { font-size: 0.84rem; color: var(--muted); margin: 0 0 1rem; }
  .crumb a { color: var(--muted); text-decoration: none; }
  .crumb a:hover { color: var(--gold); }
  .crumb .cur { color: var(--ink-soft); }
  .crumb .sep { color: var(--muted); }
  .headline {
    font-family: var(--font-title); font-weight: 900; letter-spacing: -0.03em;
    font-size: clamp(2.4rem, 5.5vw, 3.6rem); line-height: 1.03; margin: 0 0 0.9rem; color: var(--ink);
  }
  .pitch { color: var(--ink-soft); font-size: 1.1rem; line-height: 1.6; max-width: 52ch; margin: 0; }
  /* The wordmark stays bright even inside the muted description: NegaraKu in
     bright ink, .md in gold — the brand standard. */
  .wm { white-space: nowrap; color: var(--ink); font-weight: 700; }
  .wm-dot { color: var(--gold); }

  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin: 0; }
  .stat {
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.35rem;
    border: 1px solid var(--line); border-radius: 16px;
    background: color-mix(in srgb, var(--surface) 55%, transparent);
    padding: 1.4rem 1.3rem;
  }
  .stats dt { font-family: var(--font-title); font-weight: 800; font-size: clamp(1.7rem, 3vw, 2.3rem); line-height: 1; color: var(--gold); }
  .stats dd { margin: 0; color: var(--muted); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; }

  @media (max-width: 820px) {
    .hero-inner { grid-template-columns: 1fr; }
    .stats { grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); }
  }
</style>
