---
import type { Locale } from '@/lib/categories';
import { PILLARS } from '@/lib/categories';
import { t, localePath } from '@/lib/i18n';
import { REPO } from '@/lib/site';

interface Props {
  locale: Locale;
  // Accepted for route compatibility; the trimmed home page no longer uses them.
  essentials?: unknown;
  all?: unknown;
  counts?: unknown;
  total?: unknown;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

// Distinctive facts, not factbook figures. Each is verified: Peninsular + Borneo
// split by the South China Sea; Taman Negara ~130M yrs (older than the Amazon);
// one of Conservation International's 17 megadiverse nations; and the world's only
// rotating elective monarchy — 9 hereditary rulers, a new Agong every 5 years.
const stats = [
  { icon: '🗺️', value: '2', unit: { ms: 'daratan, satu negara', en: 'lands, one nation', zh: '两地一国' } },
  { icon: '🌳', value: '130M', unit: { ms: 'tahun usia hutan hujan', en: 'yr-old rainforest', zh: '年古老雨林' } },
  { icon: '🐅', value: '1 / 17', unit: { ms: 'negara megadiversiti', en: 'megadiverse nations', zh: '超级生物多样国' } },
  { icon: '👑', value: '9 → 1', unit: { ms: 'sultan, satu raja bergilir', en: 'sultans, one rotating king', zh: '位苏丹轮任元首' } },
];
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-lead">
      <h1 class="headline">NegaraKu<span class="dot">.md</span></h1>
      <p class="pitch-lead">{t('home.hero.title', locale)}</p>
      <p class="pitch">
        {L(
          'Pangkalan pengetahuan Malaysia yang lengkap — sumber terbuka, mesra-AI, dibina dari pelbagai perspektif untuk mengetengahkan Malaysia kepada dunia.',
          'An open-source, AI-friendly, complete knowledge base of Malaysia — built from diverse perspectives to curate the nation for the world.',
          '开源、对 AI 友好的马来西亚完整知识库——从多元观点建构，为全世界呈现马来西亚。',
        )}
      </p>
      <form class="hsearch" action={localePath('/search', locale)} method="get" role="search">
        <span aria-hidden="true">🔍</span>
        <input
          type="search"
          name="q"
          placeholder={L('Tanya apa sahaja tentang Malaysia…', 'Ask anything about Malaysia…', '搜索任何关于马来西亚的内容…')}
          aria-label={L('Cari', 'Search', '搜索')}
        />
        <button type="submit">{L('Cari', 'Search', '搜索')}</button>
      </form>
      <div class="cta">
        <a class="btn btn-primary" href={localePath('/explore', locale)}>{L('Mula Terokai', 'Start exploring', '开始探索')} →</a>
        <a class="ghlink" href={REPO} rel="noopener">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
          {L('Sumber terbuka di GitHub', 'Open source on GitHub', 'GitHub 开源')}
        </a>
      </div>
    </div>

    <dl class="stats" aria-label={L('Malaysia sepintas lalu', 'Malaysia at a glance', '马来西亚概览')}>
      {stats.map((s) => (
        <div class="stat">
          <span class="sicon" aria-hidden="true">{s.icon}</span>
          <dt>{s.value}</dt>
          <dd>{s.unit[locale]}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="container block">
  <h2 class="ways-title">{L('Apa yang membawa anda ke sini?', 'What brings you here?', '您为何而来？')}</h2>
  <div class="pillars">
    {PILLARS.map((p) => (
      <a class="card pillar" href={localePath(`/${p.id}`, locale)} style={`--c:${p.id === 'business' ? 'var(--gold)' : p.id === 'living' ? '#38BDF8' : '#A78BFA'}`}>
        <span class="picon" aria-hidden="true">{p.icon}</span>
        <b>{p.name[locale]}</b>
        <span class="pdesc">{p.tagline[locale]}</span>
        <span class="pgo">{L('Terokai', 'Explore', '探索')} →</span>
      </a>
    ))}
  </div>
</section>

<style>
  /* Microsoft-style structure, 1company brand: eyebrow → headline → pitch →
     search → one CTA on the left; the unique-Malaysia stats are the right-hand
     "visual" (meaningful, not a stock image); a quick-link anchor bar below. */
  .hero {
    background:
      radial-gradient(700px 420px at 12% -10%, color-mix(in srgb, var(--gold) 12%, transparent), transparent),
      radial-gradient(1100px 500px at 60% -20%, var(--surface-2), transparent);
    padding-block: 4rem 0;
    border-bottom: 1px solid var(--line);
  }
  .hero-inner {
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: center;
    padding-bottom: 3rem;
  }
  .headline {
    font-family: var(--font-title); font-weight: 900;
    font-size: clamp(2.4rem, 6vw, 4rem); line-height: 1; letter-spacing: -0.03em;
    margin: 0 0 0.9rem; color: var(--ink);
  }
  .headline .dot { color: var(--gold); }
  .pitch-lead {
    font-family: var(--font-title); font-weight: 700; font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    line-height: 1.2; color: var(--ink); margin: 0 0 0.8rem;
  }
  .pitch { font-size: 1.05rem; line-height: 1.7; color: var(--ink-soft); max-width: 52ch; margin: 0 0 1.7rem; }
  .hsearch {
    display: flex; align-items: center; gap: 0.6rem; width: 100%; max-width: 34rem; margin: 0 0 1.2rem;
    background: var(--surface-2); border: 1px solid var(--line); border-radius: 999px;
    padding: 0.65rem 0.65rem 0.65rem 1.1rem;
  }
  .hsearch:focus-within { border-color: var(--gold); }
  .hsearch input { flex: 1; background: none; border: 0; color: var(--ink); font: inherit; font-size: 1rem; outline: none; }
  .hsearch button {
    border: 0; border-radius: 999px; background: var(--gold); color: var(--accent-contrast);
    font-weight: 800; font-size: 0.9rem; padding: 0.5rem 1.1rem; cursor: pointer;
  }
  .cta { display: flex; gap: 1.1rem; flex-wrap: wrap; align-items: center; }
  .ghlink { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.9rem; color: var(--ink-soft); text-decoration: none; }
  .ghlink:hover { color: var(--gold); }

  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin: 0; }
  .stat {
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.35rem;
    border: 1px solid var(--line); border-radius: 16px;
    background: color-mix(in srgb, var(--surface) 55%, transparent);
    padding: 1.4rem 1.3rem; transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .stat:hover { border-color: color-mix(in srgb, var(--gold) 55%, var(--line)); transform: translateY(-2px); }
  .sicon { font-size: 1.6rem; line-height: 1; }
  .stats dt { font-family: var(--font-title); font-weight: 800; font-size: clamp(1.7rem, 3vw, 2.3rem); line-height: 1; color: var(--gold); }
  .stats dd { margin: 0; color: var(--muted); font-size: 0.88rem; }

  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; gap: 2rem; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }

  .block { margin-top: 3rem; }
  .block > h2 { font-size: 1.6rem; margin-bottom: 1.1rem; }
  .sec-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.1rem; }
  .sec-head h2 { margin: 0; font-size: 1.6rem; }
  .sec-head h3 { margin: 0; font-size: 1.3rem; font-family: var(--font-title); }
  .total { color: var(--muted); font-size: 0.9rem; }

  .all-cats-title { font-size: 1.9rem; margin-bottom: 1.8rem; }
  .pillar-group { margin-bottom: 2.6rem; }
  .pillar-group .sec-head { margin-bottom: 0.35rem; }
  .pillar-tagline { color: var(--ink-soft); font-size: 0.95rem; margin: 0 0 1.1rem; }

  .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem; }
  .why-grid .card { display: flex; flex-direction: column; gap: 0.3rem; }
  .dicon { font-size: 1.6rem; }
  .why-grid b { font-family: var(--font-title); }
  .why-grid p { color: var(--ink-soft); font-size: 0.9rem; margin: 0; }

  .ways-title { text-align: center; margin-bottom: 1.4rem; font-size: 1.6rem; }
  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .pillar { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.9rem 1.6rem; border-top-width: 3px; border-top-color: var(--c); }
  .pillar .picon { font-size: 2.2rem; }
  .pillar b { font-family: var(--font-title); font-size: 1.35rem; }
  .pillar .pdesc { color: var(--ink-soft); font-size: 0.95rem; flex: 1; }
  .pillar .pgo { color: var(--c); font-weight: 700; font-size: 0.9rem; }
  @media (max-width: 800px) { .pillars { grid-template-columns: 1fr; } }
  .see-all { color: var(--gold); text-decoration: none; font-weight: 600; font-size: 0.9rem; white-space: nowrap; }

  .cover { scroll-margin-top: calc(var(--nav-height) + 1rem); }
  .cover-inner { max-width: 46rem; margin-inline: auto; text-align: center; padding-block: 1rem; }
  .cover-inner h2 { font-size: clamp(1.7rem, 4vw, 2.4rem); margin: 0 0 1rem; }
  .cover-inner p { font-size: 1.2rem; line-height: 1.7; color: var(--ink-soft); margin: 0 0 0.8rem; }
  .cover-inner .btn { margin-top: 1rem; }

  .organism { display: grid; grid-template-columns: 1fr 1.2fr; gap: 2rem; align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 2rem; }
  .kicker2 { color: var(--gold); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.78rem; margin: 0 0 0.3rem; }
  .org-copy h2 { margin: 0 0 0.5rem; }
  .org-copy p { color: var(--ink-soft); }
  .org-vitals { display: grid; grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr)); gap: 1rem; }
  .ov { text-align: center; }
  .ov-score { --v: 0; width: 68px; height: 68px; margin: 0 auto 0.4rem; border-radius: 50%; display: grid; place-items: center;
    background: radial-gradient(closest-side, var(--surface) 68%, transparent 69%), conic-gradient(var(--gold) calc(var(--v) * 1%), var(--line) 0); }
  .ov-score span { font-family: var(--font-title); font-weight: 800; }
  .ov-name { font-size: 0.78rem; color: var(--ink-soft); }

  .narrative { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.5rem; }
  .part { border-top: 2px solid var(--gold); padding-top: 0.8rem; }
  .pnum { font-family: var(--font-title); font-weight: 900; color: var(--gold); font-size: 1.4rem; margin: 0; }
  .part h3 { margin: 0.2rem 0 0.6rem; font-size: 1.05rem; }
  .part ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; }
  .part a { color: var(--ink-soft); text-decoration: none; font-size: 0.92rem; }
  .part a:hover { color: var(--gold); }

  .live { display: grid; grid-template-columns: auto 1fr; gap: 2rem; border: 1px solid var(--line); border-radius: 16px; padding: 1.5rem; }
  .live-counters { display: grid; gap: 0.75rem; align-content: start; }
  .live-counters b { font-family: var(--font-title); font-size: 1.6rem; color: var(--gold); }
  .live-counters span { color: var(--muted); font-size: 0.8rem; margin-left: 0.4rem; }
  .live-feed h3 { margin: 0 0 0.5rem; font-size: 1rem; }
  .live-feed ul { list-style: none; padding: 0; margin: 0 0 0.5rem; font-size: 0.9rem; }
  .live-feed code { color: var(--gold); }
  .muted { color: var(--muted); }

  .feedback { overflow: hidden; border-block: 1px solid var(--line); padding: 1.25rem 0; }
  .marquee { display: flex; gap: 2rem; width: max-content; animation: scroll 40s linear infinite; }
  .quote { color: var(--ink-soft); font-style: italic; white-space: nowrap; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee { animation: none; flex-wrap: wrap; width: auto; } }

  @media (max-width: 800px) {
    .organism, .live { grid-template-columns: 1fr; }
    .live { grid-template-columns: 1fr; }
  }
</style>
