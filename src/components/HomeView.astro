---
import type { Locale } from '@/lib/categories';
import { PILLARS, getPillarColor } from '@/lib/categories';
import { t, localePath } from '@/lib/i18n';
import { articlesForLocale } from '@/lib/content';
import ArticleStrip from './ArticleStrip.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

// A single "Latest" strip on the home page. The full Latest + Most-read pair
// lives on /explore, so the home page offers one taste instead of repeating both.
const items = (await articlesForLocale(locale)).filter((a) => a.data.category !== 'about');
const STRIP = 4;

// Distinctive facts, not factbook figures. Each is verified: Peninsular + Borneo
// split by the South China Sea; Taman Negara ~130M yrs (older than the Amazon);
// one of Conservation International's 17 megadiverse nations; and the world's only
// rotating elective monarchy — 9 hereditary rulers, a new Agong every 5 years.
const stats = [
  { icon: '🗺️', value: '2', unit: { ms: 'daratan, satu negara', en: 'lands, one nation', zh: '两地一国' } },
  { icon: '🌳', value: '130M', unit: { ms: 'tahun usia hutan hujan', en: 'yr-old rainforest', zh: '年古老雨林' } },
  { icon: '🐅', value: '1 / 17', unit: { ms: 'negara megadiversiti', en: 'megadiverse nations', zh: '超级生物多样国' } },
  { icon: '👑', value: '9 → 1', unit: { ms: 'sultan, satu raja bergilir', en: 'sultans, one rotating king', zh: '位苏丹轮任元首' } },
];
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-lead">
      <h1 class="headline">NegaraKu<span class="dot">.md</span></h1>
      <p class="pitch-lead">{t('home.hero.title', locale)}</p>
      <p class="pitch">
        {L(
          'Pangkalan pengetahuan sumber terbuka dan mesra-AI tentang Malaysia',
          'The open-source, AI-friendly knowledge base about Malaysia',
          '开源、AI 友好的马来西亚完整知识库',
        )}
      </p>
      <p class="pitch pitch-sub">
        {L(
          'Dibina dari pelbagai perspektif, untuk dunia mengenali Malaysia',
          'Built from diverse perspectives, for the world to discover Malaysia',
          '从多元观点建构，为全世界策展马来西亚',
        )}
      </p>
      <form class="hsearch" action={localePath('/search', locale)} method="get" role="search">
        <span aria-hidden="true">🔍</span>
        <input
          type="search"
          name="q"
          placeholder={t('search.placeholder', locale)}
          aria-label={L('Cari', 'Search', '搜索')}
        />
        <button type="submit">{L('Cari', 'Search', '搜索')}</button>
      </form>
      <div class="cta">
        <a class="btn btn-primary" href={localePath('/explore', locale)}>{L('Mula Terokai', 'Start exploring', '开始探索')} →</a>
      </div>
    </div>

    <dl class="stats" aria-label={L('Malaysia sepintas lalu', 'Malaysia at a glance', '马来西亚概览')}>
      {stats.map((s) => (
        <div class="stat">
          <span class="sicon" aria-hidden="true">{s.icon}</span>
          <dt>{s.value}</dt>
          <dd>{s.unit[locale]}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="container block">
  <h2 class="ways-title">{L('Apa yang membawa anda ke sini?', 'What brings you here?', '您为何而来？')}</h2>
  <div class="pillars">
    {PILLARS.map((p) => (
      <a class="card pillar" href={localePath(`/${p.id}`, locale)} style={`--c:${getPillarColor(p.id)}`}>
        <span class="picon" aria-hidden="true">{p.icon}</span>
        <b>{p.name[locale]}</b>
        <span class="pdesc">{p.tagline[locale]}</span>
        <span class="pgo">{L('Terokai', 'Explore', '探索')} →</span>
      </a>
    ))}
  </div>
</section>

<ArticleStrip locale={locale} articles={items} moreHref="/latest" sort="recent" limit={STRIP} />

<style>
  /* Microsoft-style structure, 1company brand: eyebrow → headline → pitch →
     search → one CTA on the left; the unique-Malaysia stats are the right-hand
     "visual" (meaningful, not a stock image); a quick-link anchor bar below. */
  .hero {
    background:
      radial-gradient(700px 420px at 12% -10%, color-mix(in srgb, var(--gold) 12%, transparent), transparent),
      radial-gradient(1100px 500px at 60% -20%, var(--surface-2), transparent);
    padding-block: 4rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--gold) 30%, var(--line));
  }
  .hero-inner {
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: center;
    padding-bottom: 3rem;
  }
  .headline {
    font-family: var(--font-title); font-weight: 900;
    font-size: clamp(2.4rem, 6vw, 4rem); line-height: 1; letter-spacing: -0.03em;
    margin: 0 0 0.9rem; color: var(--ink);
  }
  .headline .dot { color: var(--gold); }
  .pitch-lead {
    font-family: var(--font-title); font-weight: 700; font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    line-height: 1.2; color: var(--ink); margin: 0 0 0.8rem;
  }
  .pitch { font-size: 1.05rem; line-height: 1.7; color: var(--ink-soft); max-width: 52ch; margin: 0 0 1.7rem; }
  .pitch:not(.pitch-sub) { margin-bottom: 0; }
  .pitch-sub { color: var(--muted); }
  .hsearch {
    display: flex; align-items: center; gap: 0.6rem; width: 100%; max-width: 34rem; margin: 0 0 1.2rem;
    background: var(--surface-2); border: 1px solid var(--line); border-radius: 999px;
    padding: 0.65rem 0.65rem 0.65rem 1.1rem;
  }
  .hsearch:focus-within { border-color: var(--gold); }
  .hsearch input { flex: 1; background: none; border: 0; color: var(--ink); font: inherit; font-size: 1rem; outline: none; }
  .hsearch button {
    border: 1px solid color-mix(in srgb, var(--gold) 55%, var(--line)); border-radius: 999px;
    background: var(--surface); color: var(--ink);
    font-weight: 500; font-size: 0.9rem; padding: 0.5rem 1.1rem; cursor: pointer;
  }
  .hsearch button:hover { border-color: var(--gold); background: color-mix(in srgb, var(--gold) 10%, var(--surface)); }
  .cta { display: flex; gap: 1.1rem; flex-wrap: wrap; align-items: center; }

  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin: 0; }
  .stat {
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.35rem;
    border: 1px solid var(--line); border-radius: 16px;
    background: color-mix(in srgb, var(--surface) 55%, transparent);
    padding: 1.4rem 1.3rem; transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .stat:hover { border-color: color-mix(in srgb, var(--gold) 55%, var(--line)); transform: translateY(-2px); }
  .sicon { font-size: 1.6rem; line-height: 1; }
  .stats dt { font-family: var(--font-title); font-weight: 800; font-size: clamp(1.7rem, 3vw, 2.3rem); line-height: 1; color: var(--gold); }
  .stats dd { margin: 0; color: var(--muted); font-size: 0.88rem; }

  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; gap: 2rem; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }

  .block { margin-top: 3rem; }
  .block > h2 { font-size: 1.6rem; margin-bottom: 1.1rem; }

  .ways-title { text-align: center; margin-bottom: 1.4rem; font-size: 1.6rem; }
  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .pillar { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.9rem 1.6rem; border-top-width: 3px; border-top-color: var(--c); transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease; }
  /* Change B: on hover the whole border takes the section's colour. */
  .pillar:hover { border-color: var(--c); }
  .pillar .picon { font-size: 2.2rem; }
  .pillar b { font-family: var(--font-title); font-size: 1.35rem; }
  .pillar .pdesc { color: var(--ink-soft); font-size: 0.95rem; flex: 1; }
  .pillar .pgo { color: var(--c); font-weight: 700; font-size: 0.9rem; }
  @media (max-width: 800px) { .pillars { grid-template-columns: 1fr; } }

</style>
