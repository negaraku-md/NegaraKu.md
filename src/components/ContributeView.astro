---
import type { Locale } from '@/lib/categories';
import { PILLARS, categoriesInPillar, loc } from '@/lib/categories';
import { siteStats, articlesForLocale } from '@/lib/content';
import { localePath } from '@/lib/i18n';
import { REPO } from '@/lib/site';
import { FEEDBACK_LABELS, newIssueUrl } from '@/lib/feedback';
import PageHero from './PageHero.astro';
import { stat } from '@/lib/pageStats';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string) => (locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);
const stats = await siteStats(locale);
const articles = await articlesForLocale(locale);

// Live taxonomy for the Suggest cascade: Section → Category → existing Topics.
const taxonomy = PILLARS.map((p) => ({
  id: p.id,
  name: loc(p.name, locale),
  categories: categoriesInPillar(p.id, true).map((c) => ({
    id: c.id,
    name: loc(c.name, locale),
    topics: articles
      .filter((a) => a.data.category === c.id)
      .map((a) => a.data.title)
      .sort((x, y) => x.localeCompare(y)),
  })),
}));

// The three ways to take part — each links to its section below.
const paths = [
  {
    id: 'report',
    icon: '🚩',
    open: true,
    title: L('Laporkan isu', 'Report an issue', '报告问题', 'ஒரு சிக்கலைப் புகாரளியுங்கள்', '問題を報告', '문제 신고', 'รายงานปัญหา', 'Báo cáo sự cố', 'Laporkan masalah'),
    desc: L(
      'Ada yang salah pada halaman sedia ada? Fakta silap, pautan rosak, maklumat lapuk, atau kebimbangan kandungan sensitif.',
      'Something wrong on an existing page? A wrong fact, broken link, outdated info, or a sensitive-content concern.',
      '现有页面有误？事实错误、链接失效、信息过时，或涉及敏感内容的顾虑。',
      'ஏற்கனவே உள்ள பக்கத்தில் ஏதேனும் தவறா? தவறான தகவல், உடைந்த இணைப்பு, காலாவதியான தகவல், அல்லது உணர்திறன் மிக்க உள்ளடக்கம் தொடர்பான கவலை.',
      '既存のページに誤りがありますか。事実の誤り、リンク切れ、古い情報、または扱いに注意が必要な内容に関する懸念など。',
      '기존 페이지에 잘못된 점이 있나요? 잘못된 사실, 깨진 링크, 오래된 정보, 또는 민감한 콘텐츠 관련 우려 등입니다.',
      'มีบางอย่างผิดพลาดในหน้าที่มีอยู่หรือไม่? ข้อเท็จจริงที่ผิด ลิงก์เสีย ข้อมูลล้าสมัย หรือข้อกังวลเกี่ยวกับเนื้อหาที่ละเอียดอ่อน',
      'Có điều gì đó không ổn trên một trang hiện có? Một thông tin sai, liên kết hỏng, thông tin lỗi thời, hoặc một lo ngại về nội dung nhạy cảm.',
      'Ada yang salah pada halaman yang sudah ada? Fakta keliru, tautan rusak, informasi usang, atau kekhawatiran soal konten sensitif.',
    ),
  },
  {
    id: 'suggest',
    icon: '💡',
    open: true,
    title: L('Cadangkan penambahbaikan', 'Suggest an improvement', '建议改进', 'ஒரு மேம்பாட்டைப் பரிந்துரையுங்கள்', '改善を提案', '개선 제안', 'เสนอการปรับปรุง', 'Đề xuất cải tiến', 'Sarankan perbaikan'),
    desc: L(
      'Cadangkan topik yang belum ada. Pilih tempatnya dalam tonggak dan kategori kami — atau cadangkan yang baharu.',
      'Propose a topic we’re missing. Pick where it fits in our pillars and categories — or propose a new one.',
      '建议我们尚未涵盖的主题。选择它在我们支柱与分类中的位置——或提议新增。',
      'நாங்கள் இன்னும் சேர்க்காத ஒரு தலைப்பைப் பரிந்துரையுங்கள். எங்கள் தூண்கள் மற்றும் வகைகளில் அது எங்கு பொருந்துகிறது என்பதைத் தேர்ந்தெடுங்கள் — அல்லது புதிதாக ஒன்றைப் பரிந்துரையுங்கள்.',
      'まだ扱っていないトピックを提案しましょう。柱とカテゴリーのどこに当てはまるかを選ぶか、新しいものを提案してください。',
      '아직 다루지 않은 주제를 제안하세요. 저희 기둥과 카테고리 중 어디에 해당하는지 선택하거나, 새로운 것을 제안하세요.',
      'เสนอหัวข้อที่เรายังขาดอยู่ เลือกว่ามันเข้ากับเสาหลักและหมวดหมู่ของเราตรงไหน — หรือเสนอหัวข้อใหม่',
      'Đề xuất một chủ đề chúng tôi còn thiếu. Chọn nơi nó phù hợp trong các trụ cột và danh mục của chúng tôi — hoặc đề xuất một chủ đề mới.',
      'Sarankan topik yang belum ada. Pilih tempatnya dalam pilar dan kategori kami — atau usulkan yang baru.',
    ),
  },
  {
    id: 'contribute',
    icon: '✍️',
    open: true,
    title: L('Sumbang', 'Contribute', '贡献', 'பங்களியுங்கள்', '貢献する', '기여하기', 'มีส่วนร่วม', 'Đóng góp', 'Berkontribusi'),
    desc: L(
      'Menulis atau menterjemah artikel melalui fork + pull request. Tiada jemputan diperlukan untuk bermula.',
      'Author or translate articles via fork + pull request. No invitation needed to start.',
      '通过 fork + pull request 撰写或翻译文章。无需邀请即可开始。',
      'fork + pull request மூலம் கட்டுரைகளை எழுதுங்கள் அல்லது மொழிபெயருங்கள். தொடங்க எந்த அழைப்பும் தேவையில்லை.',
      'fork + pull request で記事を執筆または翻訳します。始めるのに招待は不要です。',
      'fork + pull request로 기사를 작성하거나 번역하세요. 시작하는 데 초대는 필요하지 않습니다.',
      'เขียนหรือแปลบทความผ่าน fork + pull request ไม่ต้องมีคำเชิญเพื่อเริ่มต้น',
      'Viết hoặc dịch bài viết qua fork + pull request. Không cần lời mời để bắt đầu.',
      'Menulis atau menerjemahkan artikel melalui fork + pull request. Tidak perlu undangan untuk memulai.',
    ),
  },
];

// The lifecycle every contribution travels — three entry points, one spine.
const stages = [
  {
    n: 1,
    title: L('Triaj & backlog', 'Triage & backlog', '分流与待办', 'வகைப்படுத்தல் & நிலுவைப்பட்டியல்', 'トリアージとバックログ', '분류 및 백로그', 'คัดกรองและงานค้าง', 'Phân loại & tồn đọng', 'Triase & backlog'),
    body: L('Laporan disahkan; cadangan disemak kesesuaian dan pertindihan.', 'Reports are verified; suggestions are checked for fit and de-duplicated.', '核实报告；对建议进行适配性检查与去重。', 'புகார்கள் சரிபார்க்கப்படுகின்றன; பரிந்துரைகள் பொருத்தத்திற்காகச் சரிபார்க்கப்பட்டு நகல்கள் நீக்கப்படுகின்றன.', '報告は検証され、提案は適合性を確認して重複が除かれます。', '신고는 검증되고, 제안은 적합성을 확인하여 중복이 제거됩니다.', 'รายงานได้รับการตรวจสอบ; ข้อเสนอแนะได้รับการตรวจความเหมาะสมและกำจัดรายการซ้ำ', 'Các báo cáo được xác minh; các đề xuất được kiểm tra mức phù hợp và loại bỏ trùng lặp.', 'Laporan diverifikasi; usulan diperiksa kesesuaian dan duplikasinya.'),
  },
  {
    n: 2,
    title: L('Draf', 'Draft', '起草', 'வரைவு', '起草', '초안', 'ร่าง', 'Bản nháp', 'Draf'),
    body: L('Seorang penyumbang menulisnya — dipandu AI, mengikut piawai kami.', 'A contributor writes it — AI-guided, to our standard.', '一位贡献者撰写——AI 引导，遵循我们的标准。', 'ஒரு பங்களிப்பாளர் அதை எழுதுகிறார் — AI வழிகாட்டுதலுடன், எங்கள் தரத்திற்கு ஏற்ப.', '貢献者が執筆します — AIの支援を受け、当サイトの基準に沿って。', '기여자가 작성합니다 — AI의 안내를 받아, 저희 기준에 맞게.', 'ผู้มีส่วนร่วมเป็นผู้เขียน — โดยมี AI ช่วยชี้แนะ ตามมาตรฐานของเรา', 'Một người đóng góp viết nó — có AI hỗ trợ, theo tiêu chuẩn của chúng tôi.', 'Seorang kontributor menulisnya — dipandu AI, mengikuti standar kami.'),
  },
  {
    n: 3,
    title: L('Semakan', 'Review', '审阅', 'மதிப்பாய்வு', 'レビュー', '검토', 'ตรวจทาน', 'Duyệt', 'Tinjauan'),
    body: L('Bersumber dan neutral; penyelenggara menyemak dan menggabungkan, topik sensitif mendapat tandatangan penyelenggara bernama.', 'Sourced and neutral; a maintainer reviews and merges, with sensitive topics getting a named-maintainer sign-off.', '注明来源、保持中立；维护者审阅并合并，敏感主题由具名维护者签署。', 'ஆதாரத்துடன், நடுநிலையாக; ஒரு பராமரிப்பாளர் மதிப்பாய்வு செய்து ஒன்றிணைக்கிறார், உணர்திறன் மிக்க தலைப்புகள் பெயரிடப்பட்ட பராமரிப்பாளரின் ஒப்புதலைப் பெறுகின்றன.', '出典付きで中立。メンテナーがレビューしてマージし、扱いに注意が必要なトピックは名前のある管理者が承認します。', '출처가 명시되고 중립적입니다; 관리자가 검토하고 병합하며, 민감한 주제는 이름이 공개된 관리자의 승인을 받습니다.', 'มีแหล่งอ้างอิงและเป็นกลาง; ผู้ดูแลตรวจทานและผสานรวม โดยหัวข้อที่ละเอียดอ่อนได้รับการอนุมัติจากผู้ดูแลที่ระบุชื่อ', 'Có dẫn nguồn và trung lập; một người bảo trì duyệt và hợp nhất, các chủ đề nhạy cảm cần chữ ký của người bảo trì có tên.', 'Bersumber dan netral; seorang pengelola meninjau dan menggabungkan, topik sensitif mendapat persetujuan pengelola bernama.'),
  },
  {
    n: 4,
    title: L('Terbit', 'Publish', '发布', 'வெளியீடு', '公開', '발행', 'เผยแพร่', 'Đăng', 'Terbit'),
    body: L('Diterbitkan selepas semakan; terjemahan mengikut aliran kerja bahasa projek.', 'Published after review; translations follow the project’s language workflow.', '审阅后发布；翻译按项目的语言流程进行。', 'மதிப்பாய்வுக்குப் பிறகு வெளியிடப்படுகிறது; மொழிபெயர்ப்புகள் திட்டத்தின் மொழி பணிப்பாய்வைப் பின்பற்றுகின்றன.', 'レビュー後に公開されます。翻訳はプロジェクトの言語ワークフローに従います。', '검토 후 발행됩니다; 번역은 프로젝트의 언어 워크플로를 따릅니다.', 'เผยแพร่หลังตรวจทาน; การแปลเป็นไปตามเวิร์กโฟลว์ภาษาของโครงการ', 'Được đăng sau khi duyệt; bản dịch theo quy trình ngôn ngữ của dự án.', 'Diterbitkan setelah ditinjau; terjemahan mengikuti alur kerja bahasa proyek.'),
  },
];

const aiPrompt = L(
  'Bantu saya menulis artikel untuk NegaraKu.md tentang [TOPIK]. Gunakan Markdown, nada neutral, sertakan sumber yang boleh disahkan, dan ikut skema frontmatter di CONTRIBUTING.md.',
  'Help me write an article for NegaraKu.md about [TOPIC]. Use Markdown, a neutral tone, include verifiable sources, and follow the frontmatter schema in CONTRIBUTING.md.',
  '帮我为 NegaraKu.md 撰写一篇关于[主题]的文章。使用 Markdown、中立语气、附上可核实的来源，并遵循 CONTRIBUTING.md 的 frontmatter 规范。',
  'NegaraKu.md-க்காக [TOPIK] பற்றி ஒரு கட்டுரை எழுத எனக்கு உதவுங்கள். Markdown-ஐப் பயன்படுத்துங்கள், நடுநிலையான தொனியைக் கடைப்பிடியுங்கள், சரிபார்க்கக்கூடிய ஆதாரங்களைச் சேர்க்கவும், மேலும் CONTRIBUTING.md-இல் உள்ள frontmatter திட்டத்தைப் பின்பற்றவும்.',
  'NegaraKu.md 向けに[TOPIC]についての記事を書くのを手伝ってください。Markdownを使い、中立的な語調で、検証可能な出典を含め、CONTRIBUTING.md のフロントマター・スキーマに従ってください。',
  'NegaraKu.md에 [TOPIC]에 관한 기사를 작성하는 것을 도와주세요. Markdown을 사용하고, 중립적인 어조로, 검증 가능한 출처를 포함하며, CONTRIBUTING.md의 프론트매터 스키마를 따르세요.',
  'ช่วยฉันเขียนบทความสำหรับ NegaraKu.md เกี่ยวกับ [TOPIC] ใช้ Markdown น้ำเสียงเป็นกลาง ใส่แหล่งอ้างอิงที่ตรวจสอบได้ และปฏิบัติตามสคีมา frontmatter ใน CONTRIBUTING.md',
  'Hãy giúp tôi viết một bài cho NegaraKu.md về [CHỦ ĐỀ]. Dùng Markdown, giọng văn trung lập, kèm các nguồn có thể kiểm chứng, và tuân theo lược đồ frontmatter trong CONTRIBUTING.md.',
  'Bantu saya menulis artikel untuk NegaraKu.md tentang [TOPIK]. Gunakan Markdown, nada netral, sertakan sumber yang dapat diverifikasi, dan ikuti skema frontmatter di CONTRIBUTING.md.',
);

// Requesting to contribute goes to GitHub Discussions (a friendly "introduce
// yourself"), not an issue ticket. `general` is GitHub's default category; if it
// differs, GitHub gracefully shows the category picker.
const REQUEST_INVITE =
  `${REPO}/discussions/new?category=general&title=${encodeURIComponent('Hello — I’d like to contribute')}` +
  `&body=${encodeURIComponent('Hi! I’d like to help with NegaraKu.md.\n\n**Area(s) of expertise:**\n\n**Languages (MS / EN / 中文):**\n\n**Anything else:**\n')}`;

// Feedback about the WEBSITE itself (not article content) — the last two of the
// five triage types (spec §10). Prefilled, correctly-labelled via feedback.ts.
const siteBugUrl = newIssueUrl({
  type: 'site-bug',
  title: 'Site bug: ',
  body: '**What’s broken?**\n\n\n**Where (URL) and how to reproduce:**\n\n\n**Browser / device:**\n',
});
const siteImproveUrl = newIssueUrl({
  type: 'site-improvement',
  title: 'Site improvement: ',
  body: '**What would make the site better?**\n\n\n**Why it helps readers:**\n',
});
// Labels handed to the client-side form builders so this file stays the one
// place the taxonomy is defined.
const SUGGEST_LABELS = FEEDBACK_LABELS['article-request'].join(',');
const REPORT_LABELS = FEEDBACK_LABELS['article-issue'].join(',');
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム', '홈', 'หน้าแรก', 'Trang chủ', 'Beranda'), href: localePath('/', locale) },
    { label: L('Sumbang', 'Contribute', '贡献', 'பங்களியுங்கள்', '貢献', '기여', 'มีส่วนร่วม', 'Đóng góp', 'Berkontribusi') },
  ]}
  title={L('Sumbang kepada NegaraKu.md', 'Contribute to NegaraKu.md', '为 NegaraKu.md 做贡献', 'NegaraKu.md-க்குப் பங்களியுங்கள்', 'NegaraKu.md に貢献する', 'NegaraKu.md에 기여하기', 'มีส่วนร่วมกับ NegaraKu.md', 'Đóng góp cho NegaraKu.md', 'Berkontribusi untuk NegaraKu.md')}
  desc={L(
    'Tiga cara untuk mengambil bahagian — semuanya terbuka. Lapor, cadang, atau tulis dan terjemah artikel melalui fork + pull request.',
    'Three ways to take part — all open. Report, suggest, or author and translate articles via fork + pull request.',
    '三种参与方式——全部开放。通过 fork + pull request 报告、建议，或撰写与翻译文章。',
    'பங்கேற்க மூன்று வழிகள் — அனைத்தும் திறந்திருக்கின்றன. fork + pull request மூலம் புகாரளியுங்கள், பரிந்துரையுங்கள், அல்லது கட்டுரைகளை எழுதி மொழிபெயருங்கள்.',
    '参加する方法は3つ — すべて開かれています。fork + pull request で報告、提案、または記事の執筆と翻訳を行えます。',
    '참여하는 세 가지 방법 — 모두 열려 있습니다. fork + pull request로 신고하고, 제안하고, 기사를 작성하고 번역하세요.',
    'สามวิธีในการเข้าร่วม — ทั้งหมดเปิดกว้าง รายงาน เสนอแนะ หรือเขียนและแปลบทความผ่าน fork + pull request',
    'Ba cách để tham gia — tất cả đều mở. Báo cáo, đề xuất, hoặc viết và dịch bài viết qua fork + pull request.',
    'Tiga cara untuk ikut serta — semuanya terbuka. Laporkan, sarankan, atau tulis dan terjemahkan artikel melalui fork + pull request.',
  )}
  stats={[stat.pillars(stats.sections, locale), stat.categories(stats.categories, locale), stat.subcategories(stats.topics, locale), stat.topics(stats.articles, locale)]}
/>

<!-- Three paths -->
