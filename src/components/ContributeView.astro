<!-- SUGGEST -->
<section class="container block" id="suggest">
  <div class="psec">
    <header><span>💡 {L('Cadangkan penambahbaikan', 'Suggest an improvement', '建议改进', 'ஒரு மேம்பாட்டைப் பரிந்துரையுங்கள்', '改善を提案', '개선 제안', 'เสนอการปรับปรุง', 'Đề xuất cải tiến', 'Sarankan perbaikan')}</span></header>
    <div class="psec-body">
      <p class="lead">{L('Beritahu kami topik dan sebab ia penting. Mengelaskannya pilihan sahaja — kami akan menyusunnya.', 'Tell us the topic and why it matters. Classifying it is optional — we’ll sort that out.', '告诉我们主题以及它为何重要。归类是可选的——我们会处理。', 'தலைப்பையும் அது ஏன் முக்கியம் என்பதையும் சொல்லுங்கள். வகைப்படுத்துவது விருப்பம் மட்டுமே — அதை நாங்கள் சரிசெய்வோம்.', 'トピックと、それがなぜ重要かを教えてください。分類は任意です — こちらで整理します。', '주제와 그것이 왜 중요한지 알려주세요. 분류는 선택 사항입니다 — 저희가 정리하겠습니다.', 'บอกเราถึงหัวข้อและเหตุผลที่สำคัญ การจัดหมวดหมู่เป็นทางเลือก — เราจะจัดการให้เอง', 'Hãy cho chúng tôi biết chủ đề và vì sao nó quan trọng. Phân loại là tùy chọn — chúng tôi sẽ sắp xếp.', 'Beri tahu kami topiknya dan mengapa itu penting. Mengklasifikasikannya opsional — kami yang akan menatanya.')}</p>
      <details class="fold">
      <summary>{L('Buka borang cadangan', 'Open the suggestion form', '打开建议表单', 'பரிந்துரை படிவத்தைத் திற', '提案フォームを開く', '제안 양식 열기', 'เปิดแบบฟอร์มเสนอแนะ', 'Mở biểu mẫu đề xuất', 'Buka formulir saran')}</summary>
      <div class="form-grid">
      <form class="cform sform" data-repo={REPO} data-labels={SUGGEST_LABELS}>
        <label>{L('Topik', 'Topic', '主题', 'தலைப்பு', 'トピック', '주제', 'หัวข้อ', 'Chủ đề', 'Topik')}
          <input name="topic" list="topics" required autocomplete="off" placeholder={L('cth. Cukai jualan untuk PKS', 'e.g. Sales tax for SMEs', '例如：中小企业销售税', 'எ.கா. சிறு-நடுத்தர நிறுவனங்களுக்கான விற்பனை வரி', '例：中小企業向けの売上税', '예: 중소기업 매출세', 'เช่น ภาษีขายสำหรับ SME', 'ví dụ: Thuế bán hàng cho doanh nghiệp vừa và nhỏ', 'mis. Pajak penjualan untuk UKM')} />
          <datalist id="topics"></datalist>
          <small class="dupe-hint" hidden></small>
        </label>
        <label>{L('Kenapa ia penting?', 'Why it matters', '为何重要', 'ஏன் இது முக்கியம்', 'なぜ重要か', '왜 중요한가', 'เหตุใดจึงสำคัญ', 'Vì sao điều này quan trọng', 'Mengapa ini penting?')}<textarea name="why" rows="3" placeholder={L('Siapa yang memerlukannya dan mengapa…', 'Who needs it and why…', '谁需要它、为什么……', 'யாருக்கு இது தேவை, ஏன்…', '誰が必要とし、なぜか…', '누가 필요로 하고 왜인지…', 'ใครต้องการและเพราะเหตุใด…', 'Ai cần nó và vì sao…', 'Siapa yang membutuhkannya dan mengapa…')}></textarea></label>
        <p class="field-group">{L('Di mana ia sesuai (pilihan)', 'Where it fits (optional)', '归类（可选）', 'எங்கு பொருந்துகிறது (விருப்பம்)', '分類（任意）', '분류 (선택)', 'จัดหมวดหมู่ (ไม่บังคับ)', 'Phân loại (tùy chọn)', 'Di mana cocoknya (opsional)')}</p>
        <label>{L('Tonggak', 'Pillar', '支柱', 'தூண்', '柱', '기둥', 'เสาหลัก', 'Trụ cột', 'Pilar')}
          <select name="section">
            <option value="" selected>{L('Belum pasti (pilihan)', 'Not sure yet (optional)', '尚不确定（可选）', 'இன்னும் உறுதியில்லை (விருப்பம்)', 'まだ不明（任意）', '아직 모름 (선택)', 'ยังไม่แน่ใจ (ไม่บังคับ)', 'Chưa chắc (tùy chọn)', 'Belum yakin (opsional)')}</option>
            {taxonomy.map((s) => <option value={s.id}>{s.name}</option>)}
          </select>
        </label>
        <label>{L('Kategori', 'Category', '分类', 'வகை', 'カテゴリー', '카테고리', 'หมวดหมู่', 'Danh mục', 'Kategori')}
          <select name="category" disabled>
            <option value="" disabled selected>{L('Pilih tonggak dahulu…', 'Choose a pillar first…', '请先选择支柱……', 'முதலில் ஒரு தூணைத் தேர்ந்தெடுக்கவும்…', '先に柱を選択…', '먼저 기둥을 선택하세요…', 'เลือกเสาหลักก่อน…', 'Hãy chọn một trụ cột trước…', 'Pilih pilar terlebih dahulu…')}</option>
