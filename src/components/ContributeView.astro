---
import type { Locale } from '@/lib/categories';
import { CATEGORIES } from '@/lib/categories';
import { siteStats } from '@/lib/content';
import { localePath } from '@/lib/i18n';
import { REPO, CONTACT_FORM_ENDPOINT } from '@/lib/site';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);
const stats = await siteStats(locale);

// Phase 1 is invitation-only for authoring, but reporting and requesting an
// invitation are open to everyone. Three cards, lowest to highest commitment.
const methods = [
  {
    icon: '📝',
    title: L('Lapor atau cadang', 'Report or suggest', '报告或建议'),
    tag: L('Terbuka untuk semua', 'Open to all', '人人可参与'),
    desc: L('Terjumpa kesilapan atau mahu topik ditambah? Isi borang di bawah — ia membuka isu GitHub yang telah diisi. Tiada akaun atau jemputan diperlukan.', 'Spotted an error or want a topic added? Fill the form below — it opens a pre-filled GitHub issue. No account or invitation needed.', '发现错误或希望新增主题？填写下方表单——它会打开一个预填的 GitHub issue。无需账户或邀请。'),
  },
  {
    icon: '✉️',
    title: L('Pohon jemputan', 'Request an invitation', '申请邀请'),
    tag: L('Untuk penulis', 'For authors', '面向作者'),
    desc: L('Mahu menulis atau menterjemah? Buka isu untuk memohon akses penyumbang — kami menerima penyumbang secara jemputan pada fasa awal ini.', 'Want to author or translate? Open an issue to request contributor access — we onboard contributors by invitation during this early phase.', '想撰写或翻译？提交 issue 申请贡献者权限——在早期阶段我们以邀请方式接纳贡献者。'),
  },
  {
    icon: '🤖',
    title: L('Dipandu AI', 'AI-guided drafting', 'AI 引导起草'),
    tag: L('Penyumbang dijemput', 'Invited contributors', '受邀贡献者'),
    desc: L('Setelah dijemput: tampal gesaan di sebelah ke dalam ChatGPT / Claude untuk merangka artikel yang mematuhi piawai kami, kemudian buka pull request.', 'Once invited: paste the prompt on the right into ChatGPT / Claude to draft an article that follows our standard, then open a pull request.', '受邀后：将右侧提示词粘贴到 ChatGPT / Claude，起草符合我们标准的文章，然后发起 pull request。'),
  },
];

// The lifecycle a submission actually travels — reflects the GitHub workflow.
const flow = [
  L('Hantar', 'Submit', '提交'),
  L('Isu GitHub', 'GitHub issue', 'GitHub issue'),
  L('Semakan', 'Review', '审阅'),
  L('Terbit dalam 3 bahasa', 'Publish in 3 languages', '以三语发布'),
];

const aiPrompt = L(
  'Bantu saya menulis artikel untuk NegaraKu.md tentang [TOPIK]. Gunakan Markdown, nada neutral, sertakan sumber yang boleh disahkan, dan ikut skema frontmatter di CONTRIBUTING.md.',
  'Help me write an article for NegaraKu.md about [TOPIC]. Use Markdown, a neutral tone, include verifiable sources, and follow the frontmatter schema in CONTRIBUTING.md.',
  '帮我为 NegaraKu.md 撰写一篇关于[主题]的文章。使用 Markdown、中立语气、附上可核实的来源，并遵循 CONTRIBUTING.md 的 frontmatter 规范。',
);
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页'), href: localePath('/', locale) },
    { label: L('Sumbang', 'Contribute', '贡献') },
  ]}
  title={L('Sumbang kepada NegaraKu.md', 'Contribute to NegaraKu.md', '为 NegaraKu.md 做贡献')}
  desc={L(
    'Pada fasa awal kami, penulisan adalah secara jemputan — tetapi sesiapa boleh melaporkan kesilapan, mencadangkan topik, atau memohon jemputan. Semuanya di GitHub.',
    'In our early phase, authoring is by invitation — but anyone can report an error, suggest a topic, or request an invitation. It all runs on GitHub.',
    '在我们的早期阶段，内容撰写采用邀请制——但任何人都可报告错误、建议主题或申请邀请。一切都在 GitHub 上进行。',
  )}
  stats={[
    { value: stats.sections, label: L('seksyen', 'sections', '版块') },
    { value: stats.categories, label: L('kategori', 'categories', '分类') },
    { value: stats.topics, label: L('topik', 'topics', '主题') },
    { value: stats.articles, label: L('artikel', 'articles', '文章') },
  ]}
/>

<section class="container block">
  <div class="psec">
    <header><span>{L('Tiga cara untuk menyumbang', 'Three ways to contribute', '三种贡献方式')}</span></header>
    <div class="psec-body">
      <div class="methods">
        {methods.map((m, i) => (
          <div class="mcard">
            <span class="mnum">{i + 1}</span>
            <span class="mi" aria-hidden="true">{m.icon}</span>
            <b>{m.title}</b>
            <span class="mtag">{m.tag}</span>
            <p>{m.desc}</p>
          </div>
        ))}
      </div>
      <div class="flow" aria-label={L('Aliran sumbangan', 'Contribution flow', '贡献流程')}>
        {flow.map((step, i) => (
          <>
            {i > 0 && <span class="flow-arrow" aria-hidden="true">→</span>}
            <span class="flow-step">{step}</span>
          </>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="container block two">
  <div class="psec">
    <header><span>{L('Lapor atau cadangkan topik', 'Report or suggest a topic', '报告或建议主题')}</span></header>
    <div class="psec-body">
      <form
        class="cform"
        action={CONTACT_FORM_ENDPOINT || '#'}
        method="post"
        data-configured={CONTACT_FORM_ENDPOINT ? 'true' : 'false'}
        data-repo={REPO}
      >
        <label>{L('Topik', 'Topic', '主题')}<input name="topic" required placeholder={L('cth. Cukai jualan untuk PKS', 'e.g. Sales tax for SMEs', '例如：中小企业销售税')} /></label>
        <label>{L('Kategori', 'Category', '分类')}
          <select name="category">
            {CATEGORIES.filter((c) => c.id !== 'about').map((c) => <option value={c.id}>{c.name[locale]}</option>)}
          </select>
        </label>
        <label>{L('Pengetahuan / kandungan', 'Knowledge / content', '知识 / 内容')}<textarea name="content" rows="5" required placeholder={L('Apa yang patut diketahui pembaca…', 'What readers should know…', '读者应该知道的内容……')}></textarea></label>
        <label>{L('Sumber rujukan', 'Reference source', '参考来源')}<input name="source" placeholder="https://…" /></label>
        <label>{L('Nama (pilihan)', 'Name (optional)', '姓名（可选）')}<input name="name" placeholder={L('handle GitHub anda', 'your GitHub handle', '你的 GitHub 用户名')} /></label>
        <button type="submit" class="btn btn-primary">{L('Hantar melalui GitHub', 'Submit via GitHub', '通过 GitHub 提交')}</button>
        <p class="muted">{L('Penyerahan tanpa nama dibenarkan. Borang ini membuka isu GitHub yang telah diisi — tiada e-mel dikumpul.', 'Anonymous submissions are allowed. This opens a pre-filled GitHub issue — no email is collected.', '允许匿名提交。此表单会打开一个预填的 GitHub issue——不收集邮箱。')}</p>
      </form>
    </div>
  </div>

  <div class="side">
    <div class="psec">
      <header><span>{L('Gesaan dipandu AI', 'AI-guided prompt', 'AI 引导提示词')}</span></header>
      <div class="psec-body">
        <p class="hint">{L('Salin, tampal ke dalam AI kegemaran anda, dan tukar [TOPIK].', 'Copy, paste into your favourite AI, and swap in [TOPIC].', '复制并粘贴到你常用的 AI 中，替换 [主题]。')}</p>
        <pre class="prompt"><code>{aiPrompt}</code></pre>
        <button type="button" class="btn btn-ghost copy-prompt" data-prompt={aiPrompt}>{L('Salin gesaan', 'Copy prompt', '复制提示词')}</button>
      </div>
    </div>

    <div class="psec">
      <header><span>{L('Panduan', 'Guides', '指南')}</span></header>
      <div class="psec-body links">
        <a href={`${REPO}/issues/new?labels=invitation-request&title=${encodeURIComponent('Invitation request')}`} rel="noopener">{L('Pohon jemputan menyumbang', 'Request an invitation to contribute', '申请贡献者邀请')} ↗</a>
        <a href={`${REPO}/blob/main/CONTRIBUTING.md`} rel="noopener">{L('Panduan sumbangan penuh', 'Full contribution guide', '完整贡献指南')} ↗</a>
        <a href={REPO} rel="noopener">{L('Repositori GitHub', 'GitHub repository', 'GitHub 仓库')} ↗</a>
        <p class="muted small">{L('Topik sensitif (kaum, agama, institusi diraja, perlembagaan) mesti bersumber, neutral, dan disemak manusia sebelum terbit.', 'Sensitive topics (race, religion, royalty, the constitution) must be sourced, neutral, and human-reviewed before publishing.', '敏感话题（种族、宗教、王室、宪法）必须注明来源、保持中立，并在发布前经人工审阅。')}</p>
      </div>
    </div>
  </div>
</section>

<script>
  // No email backend: turn a submission into a pre-filled GitHub issue instead
  // of POSTing to a dead endpoint. If a real endpoint is later configured
  // (data-configured="true"), let the browser post normally.
  document.querySelectorAll('form.cform').forEach((form) => {
    form.addEventListener('submit', (e) => {
      if (form.dataset.configured === 'true') return;
      e.preventDefault();
      const v = (n) => (form.querySelector(`[name="${n}"]`)?.value || '').trim();
      const topic = v('topic');
      const title = `Contribution: ${topic || 'new article'}`;
      const body = [
        `**Topic:** ${topic}`,
        `**Category:** ${v('category')}`,
        `**Source:** ${v('source') || '—'}`,
        `**Submitted by:** ${v('name') || 'anonymous'}`,
        '',
        '---',
        '',
        v('content'),
      ].join('\n');
      const repo = form.dataset.repo;
      const url = `${repo}/issues/new?labels=contribution&title=${encodeURIComponent(title)}&body=${encodeURIComponent(body)}`;
      window.open(url, '_blank', 'noopener');
    });
  });

  // Copy-prompt button
  document.querySelectorAll('.copy-prompt').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.prompt || '');
        const prev = btn.textContent;
        btn.textContent = '✓';
        setTimeout(() => (btn.textContent = prev), 1400);
      } catch {}
    });
  });
</script>

<style>
  .block { margin-top: 1.6rem; }
  .psec { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .psec > header {
    padding: 0.45rem 0.95rem; font-size: 1.05rem; font-weight: 700; letter-spacing: 0.03em;
    text-transform: uppercase; background: var(--surface-2); border-bottom: 1px solid var(--line);
    font-family: var(--font-title);
  }
  .psec > header span { color: var(--gold); }
  .psec-body { padding: 1.2rem; }
  .hint { font-size: 0.82rem; color: var(--muted); margin: 0 0 0.8rem; }

  /* Method step cards */
  .methods { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem; }
  .mcard { position: relative; background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; padding: 1.1rem 1.15rem; }
  .mnum {
    position: absolute; top: 0.8rem; right: 0.9rem;
    font-family: var(--font-title); font-weight: 800; font-size: 0.9rem;
    color: var(--gold); opacity: 0.55;
  }
  .mi { font-size: 1.6rem; }
  .mcard b { display: block; font-family: var(--font-title); margin: 0.4rem 0 0.3rem; color: var(--ink); }
  .mtag {
    display: inline-block; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.03em;
    text-transform: uppercase; color: var(--gold); border: 1px solid var(--line);
    background: var(--surface); border-radius: 999px; padding: 0.1rem 0.55rem; margin-bottom: 0.5rem;
  }
  .mcard p { color: var(--ink-soft); font-size: 0.9rem; margin: 0; line-height: 1.6; }

  /* Contribution flow strip */
  .flow { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.6rem; margin-top: 1.2rem; padding-top: 1rem; border-top: 1px dashed var(--line); }
  .flow-step { font-size: 0.82rem; font-weight: 700; color: var(--ink-soft); background: var(--surface-2); border: 1px solid var(--line); border-radius: 999px; padding: 0.25rem 0.75rem; }
  .flow-arrow { color: var(--gold); font-weight: 800; }

  /* Two-column: form + sidebar */
  .two { display: grid; grid-template-columns: 1.3fr 1fr; gap: 1.6rem; align-items: start; padding-bottom: 3rem; }
  .side { display: grid; gap: 1.6rem; }

  .cform { display: grid; gap: 0.9rem; }
  .cform label { display: grid; gap: 0.3rem; font-size: 0.85rem; font-weight: 600; color: var(--ink-soft); }
  .cform input, .cform select, .cform textarea {
    padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid var(--line);
    background: var(--surface-2); color: var(--ink); font: inherit; font-weight: 400;
  }
  .cform input:focus, .cform select:focus, .cform textarea:focus { outline: none; border-color: var(--gold); }
  .cform button { justify-self: start; }
  .muted { color: var(--muted); font-size: 0.85rem; }
  .muted.small { font-size: 0.8rem; line-height: 1.55; margin: 0.8rem 0 0; }

  .prompt { background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; padding: 1rem; white-space: pre-wrap; font-size: 0.85rem; line-height: 1.6; margin: 0 0 0.8rem; }
  .links { display: grid; gap: 0.6rem; }
  .links a { color: var(--gold); text-decoration: none; font-weight: 600; font-size: 0.9rem; }
  .links a:hover { text-decoration: underline; }

  @media (max-width: 800px) { .two { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
