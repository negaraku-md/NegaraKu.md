---
import type { Locale, Category } from '@/lib/categories';
import type { Article } from '@/lib/content';
import { orderedSubcats, subcatLabel } from '@/lib/subcategories';
import { localePath } from '@/lib/i18n';
import TrustBadge from '../TrustBadge.astro';

// PLACE / ENTITY archetype.
// Spatial content should be browsable spatially. Regions act as the filter,
// and every place renders as a structured card so they stay comparable.

interface Props {
  locale: Locale;
  category: Category;
  articles: Article[];
}
const { locale, category, articles } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);
const href = (a: Article) => localePath(`/${a.data.category}/${a.data.slug}`, locale);

const regions = orderedSubcats(
  category.id,
  articles.flatMap((a) => a.data.subcategory),
);
const inRegion = (s: string) => articles.filter((a) => a.data.subcategory.includes(s));
---

<section class="container block">
  <div class="filters">
    <span class="f on">{L('Semua', 'All', '全部')} ({articles.length})</span>
    {
      regions.map((r) => (
        <span class="f">
          {subcatLabel(r, locale)} ({inRegion(r).length})
        </span>
      ))
    }
  </div>

  {
    regions.map((r) => (
      <div class="region">
        <h2>{subcatLabel(r, locale)}</h2>
        <div class="places">
          {inRegion(r).map((a) => (
            <a class="place" href={href(a)}>
              <div class="ph">
                <b>{a.data.entity ?? a.data.title}</b>
                <TrustBadge
                  locale={locale}
                  status={a.data.status}
                  sensitivity={a.data.sensitivity}
                  compact
                />
              </div>
              <p>{a.data.answer ?? a.data.summary}</p>
              {a.data.keyTakeaways.length > 0 && (
                <ul>
                  {a.data.keyTakeaways.slice(0, 3).map((k) => (
                    <li>{k}</li>
                  ))}
                </ul>
              )}
            </a>
          ))}
        </div>
      </div>
    ))
  }
</section>

<style>
  .filters {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.6rem;
  }
  .f {
    font-size: 0.78rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 0.24rem 0.7rem;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-soft);
  }
  .f.on {
    background: var(--gold);
    color: #000;
    border-color: var(--gold);
  }
  .region {
    margin-bottom: 2rem;
  }
  .region h2 {
    font-size: 1.25rem;
    margin: 0 0 0.9rem;
  }
  .places {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 0.8rem;
  }
  .place {
    display: block;
    padding: 1rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid color-mix(in srgb, var(--gold) 55%, transparent);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.15s,
      border-color 0.15s;
  }
  .place:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--gold) 45%, var(--line));
  }
  .ph {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }
  .ph b {
    font-family: var(--font-title);
    font-size: 1.08rem;
  }
  .place p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.87rem;
    line-height: 1.55;
  }
  .place ul {
    margin: 0.6rem 0 0;
    padding-left: 1.05rem;
    color: var(--muted);
    font-size: 0.81rem;
  }
  .place li {
    margin: 0.16rem 0;
  }
</style>
