---
import type { Locale, Category } from '@/lib/categories';
import type { Article } from '@/lib/content';
import { orderedSubcats, subcatLabel } from '@/lib/subcategories';
import { localePath } from '@/lib/i18n';

// SERVICE / PROCEDURAL archetype.
// A reader arrives with a TASK, not a browsing mood — so tasks lead, then the
// sub-topics that route into dedicated topic pages, then quick answers and
// tools. Every block is a section box (gold header band) matching the article
// page, so the whole site reads as one system.

interface Props {
  locale: Locale;
  category: Category;
  articles: Article[];
}
const { locale, category, articles } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);
const href = (a: Article) => localePath(`/${a.data.category}/${a.data.slug}`, locale);
const topicHref = (s: string) => localePath(`/${category.id}/topic/${s}`, locale);

// Sub-topics route into their own pages now.
const subcats = orderedSubcats(
  category.id,
  articles.flatMap((a) => a.data.subcategory),
);
const inSub = (s: string) => articles.filter((a) => a.data.subcategory.includes(s));

---

<section class="container block">
  <div class="catsec">
    <header>
      <span>{L('Topik', 'Topics', '主题')}</span>
      <span>{articles.length} {L('artikel', 'articles', '篇')}</span>
    </header>
    <div class="catsec-body">
      <div class="topic-grid">
        {
          subcats.map((s) => (
            <a class="topic-card" href={topicHref(s)}>
              <b>{subcatLabel(s, locale)}</b>
              <span class="tc-count">
                {inSub(s).length} {L('artikel', 'articles', '篇')} →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Section box + topic cards. This block was accidentally truncated when the
     other archetype sections were removed; restored to the neutral section-box
     standard used across the site. */
  .catsec {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 12px; overflow: hidden;
  }
  .catsec > header {
    display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    padding: 0.45rem 0.95rem; font-size: 0.67rem; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--muted); background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .catsec-body { padding: 1.1rem; }
  .topic-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0.8rem; }
  .topic-card {
    display: flex; flex-direction: column; gap: 0.25rem;
    background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px;
    padding: 0.9rem 1rem; text-decoration: none; color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .topic-card:hover { border-color: color-mix(in srgb, var(--gold) 55%, var(--line)); transform: translateY(-2px); }
  .topic-card b { font-family: var(--font-title); font-size: 1rem; color: var(--ink); }
  .tc-count { color: var(--muted); font-size: 0.85rem; }
</style>
