---
import type { Locale, Category } from '@/lib/categories';
import type { Article } from '@/lib/content';
import { orderedSubcats, subcatLabel } from '@/lib/subcategories';
import { localePath } from '@/lib/i18n';

// SERVICE / PROCEDURAL archetype.
// A reader arrives with a TASK, not a browsing mood — so tasks lead, then the
// sub-topics that route into dedicated topic pages, then quick answers and
// tools. Every block is a section box (gold header band) matching the article
// page, so the whole site reads as one system.

interface Props {
  locale: Locale;
  category: Category;
  articles: Article[];
}
const { locale, category, articles } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);
const href = (a: Article) => localePath(`/${a.data.category}/${a.data.slug}`, locale);
const topicHref = (s: string) => localePath(`/${category.id}/topic/${s}`, locale);

// Tasks = the flagship guides. These are what people actually came to do.
const tasks = articles.filter((a) => a.data.tier === '1').slice(0, 4);

// Sub-topics route into their own pages now.
const subcats = orderedSubcats(
  category.id,
  articles.flatMap((a) => a.data.subcategory),
);
const inSub = (s: string) => articles.filter((a) => a.data.subcategory.includes(s));

// Quick answers — the AEO surface.
const quick = articles.filter((a) => a.data.answer).slice(0, 4);

// Practical assets
const tools = articles.filter((a) => ['checklist', 'comparison'].includes(a.data.contentType));
---

{
  tasks.length > 0 && (
    <section class="container block">
      <div class="catsec">
        <header>
          <span>{L('Apa yang anda mahu lakukan?', 'What do you want to do?', '您想做什么？')}</span>
        </header>
        <div class="catsec-body">
          <div class="tasks">
            {tasks.map((a) => (
              <a class="task" href={href(a)}>
                <b>{a.data.title}</b>
                <span>{a.data.summary}</span>
                <span class="go">{L('Mula', 'Start', '开始')} →</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

<section class="container block">
  <div class="catsec">
    <header>
      <span>{L('Topik', 'Topics', '主题')}</span>
      <span>{articles.length} {L('artikel', 'articles', '篇')}</span>
    </header>
    <div class="catsec-body">
      <div class="topic-grid">
        {
          subcats.map((s) => (
            <a class="topic-card" href={topicHref(s)}>
              <b>{subcatLabel(s, locale)}</b>
              <span class="tc-count">
                {inSub(s).length} {L('artikel', 'articles', '篇')} →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

{
  quick.length > 0 && (
    <section class="container block">
      <div class="catsec">
        <header>
          <span>{L('Jawapan pantas', 'Quick answers', '快速解答')}</span>
          <span>{L('Untuk carian & AI', 'For search & AI', '面向搜索与 AI')}</span>
        </header>
        <div class="catsec-body">
          <div class="qa">
            {quick.map((a) => (
              <a class="q" href={href(a)}>
                <b>{a.data.title}</b>
                <p>{a.data.answer}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

{
  tools.length > 0 && (
    <section class="container block">
      <div class="catsec">
        <header>
          <span>{L('Alat & senarai semak', 'Tools & checklists', '工具与清单')}</span>
        </header>
        <div class="catsec-body">
          <div class="tools">
            {tools.map((a) => (
              <a class="tool" href={href(a)}>
                <span class="kind">
                  {a.data.contentType === 'checklist'
                    ? L('Senarai semak', 'Checklist', '清单')
                    : L('Perbandingan', 'Comparison', '对比')}
                </span>
                <b>{a.data.title}</b>
                <span class="d">{a.data.summary}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  /* Section box — neutral header by default; gold is reserved for the answer,
     links and small "go" accents so it keeps its meaning. */
  .catsec {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }
  .catsec > header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem;
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .catsec-body {
    padding: 1.1rem;
  }

  .tasks,
  .qa,
  .tools,
  .topic-grid {
    display: grid;
    gap: 0.8rem;
  }
  .tasks {
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .topic-grid {
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }
  .qa {
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }
  .tools {
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .task,
  .q,
  .tool,
  .topic-card {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.15s,
      border-color 0.15s;
  }
  .task:hover,
  .q:hover,
  .tool:hover,
  .topic-card:hover {
    border-color: color-mix(in srgb, var(--gold) 55%, var(--line));
  }

  .topic-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.95rem 1rem;
  }
  .topic-card b {
    font-family: var(--font-title);
    font-size: 1rem;
    color: var(--ink);
  }
  .topic-card .tc-count {
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .task {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.05rem;
    border-left: 3px solid var(--gold);
    border-radius: 0 10px 10px 0;
  }
  .task:hover {
    transform: translateY(-2px);
  }
  .task b {
    font-family: var(--font-title);
    font-size: 1rem;
  }
  .task span {
    color: var(--ink-soft);
    font-size: 0.86rem;
  }
  .task .go {
    color: var(--gold);
    font-weight: 800;
    font-size: 0.8rem;
    margin-top: 0.2rem;
  }

  .q {
    display: block;
    padding: 0.9rem 1rem;
  }
  .q b {
    font-family: var(--font-title);
    font-size: 0.96rem;
    display: block;
  }
  .q p {
    margin: 0.35rem 0 0;
    color: var(--ink-soft);
    font-size: 0.87rem;
    line-height: 1.55;
  }

  .tool {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    padding: 0.95rem 1rem;
  }
  .tool .kind {
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .tool b {
    font-family: var(--font-title);
    font-size: 0.97rem;
  }
  .tool .d {
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
</style>
