---
import type { Locale, Category } from '@/lib/categories';
import type { Article } from '@/lib/content';
import { orderedSubcats, subcatLabel } from '@/lib/subcategories';
import { localePath } from '@/lib/i18n';
import { readingTime } from '@/lib/content';
import TrustBadge from '../TrustBadge.astro';

// NARRATIVE / TIMELINE archetype.
// The organising spine is TIME, not tasks. Sub-topics become eras; the
// category opens with a single flagship long-read rather than a card grid.

interface Props {
  locale: Locale;
  category: Category;
  articles: Article[];
}
const { locale, category, articles } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);
const href = (a: Article) => localePath(`/${a.data.category}/${a.data.slug}`, locale);

const featured = articles.find((a) => a.data.tier === '1');
const eras = orderedSubcats(
  category.id,
  articles.flatMap((a) => a.data.subcategory),
);
const inEra = (s: string) => articles.filter((a) => a.data.subcategory.includes(s));
---

{
  featured && (
    <section class="container block">
      <h2>{L('Mula di sini', 'Start here', '从这里开始')}</h2>
      <a class="feat" href={href(featured)}>
        <div class="frow">
          <span class="chip gold">{L('Bacaan utama', 'Flagship read', '重点长文')}</span>
          <TrustBadge
            locale={locale}
            status={featured.data.status}
            sensitivity={featured.data.sensitivity}
            compact
          />
          <span class="chip">
            {readingTime(featured)} {L('min', 'min read', '分钟')}
          </span>
        </div>
        <h3>{featured.data.title}</h3>
        <p>{featured.data.answer ?? featured.data.summary}</p>
      </a>
    </section>
  )
}

<section class="container block">
  <div class="sec-head">
    <h2>{L('Garis masa', 'The timeline', '时间线')}</h2>
    <span class="muted">
      {eras.length} {L('era', 'eras', '个时代')}
    </span>
  </div>

  <div class="tl">
    {
      eras.map((s) => (
        <div class="era">
          <b>{subcatLabel(s, locale)}</b>
          <div class="arts">
            {inEra(s).map((a) => (
              <a class="story" href={href(a)}>
                <span class="t">{a.data.title}</span>
                <span class="s">{a.data.summary}</span>
                <TrustBadge
                  locale={locale}
                  status={a.data.status}
                  sensitivity={a.data.sensitivity}
                  compact
                />
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  h2 {
    margin: 0 0 1rem;
    font-size: 1.45rem;
  }
  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .sec-head h2 {
    margin: 0;
  }
  .muted {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .chip {
    font-size: 0.68rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--ink-soft);
  }
  .chip.gold {
    color: var(--gold);
    border-color: color-mix(in srgb, var(--gold) 40%, transparent);
    background: color-mix(in srgb, var(--gold) 10%, transparent);
  }

  .feat {
    display: block;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--gold);
    border-radius: 14px;
    padding: 1.3rem 1.4rem;
    text-decoration: none;
    color: inherit;
  }
  .feat:hover {
    border-color: color-mix(in srgb, var(--gold) 45%, var(--line));
  }
  .frow {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 0.6rem;
  }
  .feat h3 {
    margin: 0 0 0.4rem;
    font-size: 1.35rem;
  }
  .feat p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    max-width: 70ch;
  }

  .tl {
    position: relative;
    padding-left: 1.7rem;
  }
  .tl::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: linear-gradient(var(--gold), color-mix(in srgb, var(--gold) 15%, transparent));
  }
  .era {
    position: relative;
    margin-bottom: 1.6rem;
  }
  .era::before {
    content: '';
    position: absolute;
    left: -1.45rem;
    top: 0.45rem;
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--gold) 16%, transparent);
  }
  .era > b {
    display: block;
    font-family: var(--font-title);
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }
  .arts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 0.6rem;
  }
  .story {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.8rem 0.95rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 11px;
    text-decoration: none;
    color: inherit;
  }
  .story:hover {
    border-color: color-mix(in srgb, var(--gold) 45%, var(--line));
  }
  .story .t {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .story .s {
    color: var(--ink-soft);
    font-size: 0.85rem;
    line-height: 1.5;
  }
</style>
