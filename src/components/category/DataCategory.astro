---
import type { Locale, Category } from '@/lib/categories';
import type { Article } from '@/lib/content';
import { orderedSubcats, subcatLabel } from '@/lib/subcategories';
import { localePath } from '@/lib/i18n';
import TrustBadge from '../TrustBadge.astro';

// DATA / INDICATORS archetype.
// Leads with the headline figures a reader came for, then the explanatory
// articles behind them. Key takeaways double as the indicator strip.

interface Props {
  locale: Locale;
  category: Category;
  articles: Article[];
}
const { locale, category, articles } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);
const href = (a: Article) => localePath(`/${a.data.category}/${a.data.slug}`, locale);

const groups = orderedSubcats(
  category.id,
  articles.flatMap((a) => a.data.subcategory),
);
const inGroup = (s: string) => articles.filter((a) => a.data.subcategory.includes(s));

// Headline indicators pulled from the first takeaway of each data page.
const indicators = articles
  .filter((a) => a.data.keyTakeaways.length > 0)
  .slice(0, 4)
  .map((a) => ({ label: a.data.entity ?? a.data.title, value: a.data.keyTakeaways[0], href: href(a) }));
---

{
  indicators.length > 0 && (
    <section class="container block">
      <h2>{L('Petunjuk utama', 'Headline indicators', '主要指标')}</h2>
      <div class="inds">
        {indicators.map((i) => (
          <a class="ind" href={i.href}>
            <span class="lbl">{i.label}</span>
            <span class="val">{i.value}</span>
          </a>
        ))}
      </div>
      <p class="note">
        {L(
          'Angka adalah anggaran — rujuk sumber rasmi pada setiap halaman.',
          'Figures are indicative — see the official source on each page.',
          '数字为参考值——请查看各页面的官方来源。',
        )}
      </p>
    </section>
  )
}

<section class="container block">
  {
    groups.map((g) => (
      <div class="group">
        <h2>{subcatLabel(g, locale)}</h2>
        <div class="rows">
          {inGroup(g).map((a) => (
            <a class="r" href={href(a)}>
              <div class="rh">
                <b>{a.data.title}</b>
                <TrustBadge
                  locale={locale}
                  status={a.data.status}
                  sensitivity={a.data.sensitivity}
                  compact
                />
              </div>
              <p>{a.data.answer ?? a.data.summary}</p>
            </a>
          ))}
        </div>
      </div>
    ))
  }
</section>

<style>
  h2 {
    margin: 0 0 1rem;
    font-size: 1.45rem;
  }
  .inds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.8rem;
  }
  .ind {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--gold);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
  }
  .ind:hover {
    border-color: color-mix(in srgb, var(--gold) 45%, var(--line));
  }
  .ind .lbl {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 800;
  }
  .ind .val {
    font-family: var(--font-title);
    font-size: 1rem;
    line-height: 1.4;
  }
  .note {
    color: var(--muted);
    font-size: 0.8rem;
    margin: 0.8rem 0 0;
  }
  .group {
    margin-bottom: 2rem;
  }
  .rows {
    display: grid;
    gap: 0.6rem;
  }
  .r {
    display: block;
    padding: 0.9rem 1.05rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
  }
  .r:hover {
    border-color: color-mix(in srgb, var(--gold) 45%, var(--line));
  }
  .rh {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .rh b {
    font-family: var(--font-title);
    font-size: 1rem;
  }
  .r p {
    margin: 0.35rem 0 0;
    color: var(--ink-soft);
    font-size: 0.87rem;
    line-height: 1.55;
  }
</style>
