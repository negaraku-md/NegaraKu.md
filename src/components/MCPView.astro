---
import type { Locale } from '@/lib/categories';
import { REPO, SITE } from '@/lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

const tools = [
  { name: 'search_articles', desc: L('Cari pangkalan pengetahuan mengikut kata kunci.', 'Search the knowledge base by keyword.', '按关键词搜索知识库。') },
  { name: 'read_article', desc: L('Baca Markdown penuh sesuatu artikel.', 'Read the full Markdown of an article.', '读取文章的完整 Markdown。') },
  { name: 'list_categories', desc: L('Senaraikan taksonomi kategori.', 'List the category taxonomy.', '列出分类体系。') },
];
---

<section class="container prose wrap">
  <p class="kicker">🤖 AI · MCP</p>
  <h1>{L('Masukkan Malaysia ke dalam AI anda', 'Put Malaysia in your AI', '把马来西亚接入你的 AI')}</h1>
  <p class="lead">{L('NegaraKu.md direka mesra-AI: setiap artikel tersedia sebagai Markdown mentah, diindeks dalam llms.txt, dan boleh dicapai melalui pelayan MCP.', 'NegaraKu.md is built AI-friendly: every article is available as raw Markdown, indexed in llms.txt, and reachable through an MCP server.', 'NegaraKu.md 天生对 AI 友好：每篇文章都提供原始 Markdown、收录于 llms.txt，并可通过 MCP 服务器访问。')}</p>

  <h2>{L('Pelayan MCP', 'MCP server', 'MCP 服务器')}</h2>
  <p>{L('Klon repositori, pasang kebergantungan dalam', 'Clone the repo, install deps in', '克隆仓库，在')} <code>mcp/</code>, {L('dan tambah ke klien MCP anda:', 'and add it to your MCP client:', '目录安装依赖，然后加入你的 MCP 客户端：')}</p>
  <pre><code>{`{
  "mcpServers": {
    "negaraku-md": {
      "command": "node",
      "args": ["/abs/path/to/negaraku.md/mcp/server.mjs"]
    }
  }
}`}</code></pre>

  <h2>{L('Alat tersedia', 'Available tools', '可用工具')}</h2>
  <ul class="tools">
    {tools.map((t) => <li><code>{t.name}</code><span>{t.desc}</span></li>)}
  </ul>

  <h2>{L('Sumber mesra-AI yang lain', 'Other AI-friendly resources', '其他 AI 友好资源')}</h2>
  <ul>
    <li><a href="/llms.txt">llms.txt</a> — {L('indeks mesin semua artikel.', 'machine index of all articles.', '所有文章的机器索引。')}</li>
    <li><a href="/llms-full.txt">llms-full.txt</a> — {L('keseluruhan korpus dalam satu fail.', 'the entire corpus in one file.', '整个语料库合为一个文件。')}</li>
    <li>{L('Tambah', 'Append', '在任意文章 URL 后加上')} <code>.md</code> {L('pada mana-mana URL artikel untuk Markdown mentah.', 'to any article URL for raw Markdown.', '即可获取原始 Markdown。')}</li>
    <li><a href={REPO} rel="noopener">GitHub</a> — {L('sumber kebenaran (CC BY-SA 4.0).', 'source of truth (CC BY-SA 4.0).', '事实来源（CC BY-SA 4.0）。')}</li>
  </ul>
  <p class="muted">{L('Contoh:', 'Example:', '示例：')} <a href={`${SITE}/history/kesultanan-melaka.md`}>{SITE}/history/kesultanan-melaka.md</a></p>
</section>

<style>
  .wrap { padding-block: 2.5rem 3rem; }
  .kicker { color: var(--gold); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; font-size: 0.8rem; }
  .lead { font-size: 1.15rem; color: var(--ink-soft); }
  pre { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 1rem; overflow-x: auto; }
  .tools { list-style: none; padding: 0; }
  .tools li { display: flex; gap: 0.75rem; align-items: baseline; border-bottom: 1px solid var(--line); padding: 0.6rem 0; }
  .tools code { color: var(--gold); }
  .muted { color: var(--muted); font-size: 0.9rem; }
</style>
