  .gh-body .lead { margin: 0 0 1.2rem; color: var(--ink-soft); line-height: 1.7; }
  .gh-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; }
  .gh-grid > div > b { display: block; font-family: var(--font-title); color: var(--gold); font-size: 0.95rem; margin: 0 0 0.55rem; }
  .gh-grid ul { margin: 0; padding-inline-start: 1.1rem; color: var(--ink-soft); line-height: 1.6; font-size: 0.92rem; display: grid; gap: 0.4rem; }
  .gh-note { margin: 1.4rem 0 0; padding-top: 1.1rem; border-top: 1px solid var(--line); color: var(--ink-soft); line-height: 1.65; }
  .gh-cta { margin: 1.3rem 0 0; }
  @media (max-width: 700px) { .gh-grid { grid-template-columns: 1fr; gap: 1.2rem; } }

  .pcards { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem; }
  .pcard { background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; padding: 1.1rem 1.15rem; }
  .pico { font-size: 1.4rem; }
  .pcard b { display: block; font-family: var(--font-title); font-size: 1.02rem; margin: 0.4rem 0 0.35rem; color: var(--ink); }
  .pcard p { margin: 0; color: var(--ink-soft); font-size: 0.9rem; line-height: 1.6; }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; }

  /* Explore more — link cards to the dedicated pages (FAQ, Changelog, Contributors). */
