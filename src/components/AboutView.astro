---
import type { Locale } from '@/lib/categories';
import { siteStats } from '@/lib/content';
import { localePath } from '@/lib/i18n';
import { REPO } from '@/lib/site';
import { FLOWER_D } from '@/lib/logo';
import PageHero from './PageHero.astro';
import { stat } from '@/lib/pageStats';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string, ar?: string, hi?: string, es?: string, fr?: string) => (locale === 'fr' ? (fr ?? ms) : locale === 'es' ? (es ?? ms) : locale === 'hi' ? (hi ?? ms) : locale === 'ar' ? (ar ?? ms) : locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);
const stats = await siteStats(locale);

// How the knowledge base actually works — four load-bearing ideas, each a card.
const pillars = [
  {
    icon: '📄',
    title: L('Satu sumber kebenaran', 'One source of truth', '单一事实来源', 'ஒரே உண்மை மூலம்', '唯一の信頼できる情報源', '단일 진실 공급원', 'แหล่งความจริงเดียว', 'Một nguồn chân lý duy nhất', 'Satu sumber kebenaran', 'مصدر واحد للحقيقة', 'सत्य का एकमात्र स्रोत', 'Una sola fuente de verdad', 'Une source de vérité unique'),
    body: L(
      'Setiap artikel ialah satu fail Markdown di GitHub. Tiada pangkalan data tersembunyi — apa yang anda baca ialah fail itu sendiri, boleh dibaca manusia dan mesin.',
      'Every article is a single Markdown file on GitHub. No hidden database — what you read is the file itself, legible to both people and machines.',
      '每篇文章都是 GitHub 上的一个 Markdown 文件。没有隐藏的数据库——你所读到的就是文件本身，人与机器皆可读。',
      'ஒவ்வொரு கட்டுரையும் GitHub-இல் உள்ள ஒரே ஒரு Markdown கோப்பு. மறைந்திருக்கும் தரவுத்தளம் எதுவும் இல்லை — நீங்கள் படிப்பது அந்தக் கோப்பே, மனிதர்களாலும் இயந்திரங்களாலும் படிக்கக்கூடியது.',
      '各記事は GitHub 上の一つの Markdown ファイルです。隠れたデータベースはなく、あなたが読むのはファイルそのもの — 人にも機械にも読み取れます。',
      '모든 기사는 GitHub의 단일 Markdown 파일입니다. 숨겨진 데이터베이스는 없습니다 — 여러분이 읽는 것은 파일 그 자체이며, 사람과 기계 모두가 읽을 수 있습니다.',
      'ทุกบทความคือไฟล์ Markdown เพียงไฟล์เดียวบน GitHub ไม่มีฐานข้อมูลที่ซ่อนอยู่ — สิ่งที่คุณอ่านคือตัวไฟล์นั้นเอง ซึ่งทั้งมนุษย์และเครื่องจักรอ่านได้',
      'Mỗi bài viết là một tập tin Markdown trên GitHub. Không có cơ sở dữ liệu ẩn — thứ bạn đọc chính là tập tin đó, cả con người lẫn máy móc đều đọc được.',
      'Setiap artikel adalah satu berkas Markdown di GitHub. Tidak ada basis data tersembunyi — apa yang Anda baca adalah berkas itu sendiri, dapat dibaca manusia dan mesin.',
      'كل مقالة هي ملف Markdown واحد على GitHub. لا قاعدة بيانات مخفية — ما تقرؤه هو الملف نفسه، مقروء للبشر والآلات على حد سواء.',
      'हर लेख GitHub पर एक अकेली Markdown फ़ाइल है। कोई छिपा हुआ डेटाबेस नहीं — आप जो पढ़ते हैं वह स्वयं वह फ़ाइल है, जो मनुष्यों और मशीनों दोनों के लिए पठनीय है।',
      'Cada artículo es un único archivo Markdown en GitHub. No hay base de datos oculta: lo que lees es el propio archivo, legible tanto para personas como para máquinas.', "Chaque article est un fichier Markdown unique sur GitHub. Aucune base de données cachée : ce que vous lisez, c'est le fichier lui-même, lisible aussi bien par les humains que par les machines.",
    ),
  },
  {
    icon: '🌏',
    title: L('Tiga belas bahasa, satu paras', 'Thirteen languages, one parity', '十三种语言，完全对等', 'பதின்மூன்று மொழிகள், ஒரே சமநிலை', '十三の言語、一つの対等性', '열세 개 언어, 하나의 동등성', 'สิบสามภาษา ความเท่าเทียมหนึ่งเดียว', 'Mười ba ngôn ngữ, một sự bình đẳng', 'Tiga belas bahasa, satu kesetaraan', 'ثلاث عشرة لغة، تكافؤ واحد', 'तेरह भाषाएँ, एक समानता', 'Trece idiomas, una misma paridad', 'Treize langues, une seule parité'),
    body: L(
      'Setiap topik wujud dalam Bahasa Melayu, Inggeris, Cina, Tamil, Jepun, Korea, Thai, Vietnam, Indonesia, Arab, Hindi dan Sepanyol. Setiap artikel mempunyai bahasa induknya sendiri — asal usul yang mengarang, dan sebelas terjemahan yang setia kepadanya.',
      'Every topic exists in Malay, English, Chinese, Tamil, Japanese, Korean, Thai, Vietnamese, Indonesian, Arabic, Hindi and Spanish. Each article has its own master language — the origin it was authored in — and eleven translations kept faithful to it.',
      '每个主题都以马来文、英文、中文、泰米尔文、日文、韩文、泰文、越南文、印尼文、阿拉伯文、印地文和西班牙文呈现。每篇文章都有自己的主语言（撰写的源头），以及十一个忠于它的译本。',
      'ஒவ்வொரு தலைப்பும் மலாய், ஆங்கிலம், சீனம், தமிழ், ஜப்பானியம், கொரியன், தாய், வியட்நாமியம், இந்தோனேசியம், அரபு, இந்தி மற்றும் ஸ்பானிஷ் மொழிகளில் உள்ளது. ஒவ்வொரு கட்டுரைக்கும் அதற்கே உரிய மூல மொழி உண்டு — எழுதப்பட்ட தோற்றுவாய் — மேலும் அதற்கு உண்மையாக இருக்கும் பதினொரு மொழிபெயர்ப்புகள்.',
      '各トピックはマレー語・英語・中国語・タミル語・日本語・韓国語・タイ語・ベトナム語・インドネシア語・アラビア語・ヒンディー語・スペイン語で存在します。各記事にはそれぞれの原語（執筆された起源）があり、それに忠実な十一の翻訳が付きます。',
      '모든 주제는 말레이어, 영어, 중국어, 타밀어, 일본어, 한국어, 태국어, 베트남어, 인도네시아어, 아랍어, 힌디어, 스페인어로 존재합니다. 각 기사에는 고유한 원어(작성된 기원)가 있으며, 그에 충실한 열한 개의 번역이 함께합니다.',
      'ทุกหัวข้อมีอยู่ในภาษามลายู อังกฤษ จีน ทมิฬ ญี่ปุ่น เกาหลี ไทย เวียดนาม อินโดนีเซีย ภาษาอาหรับ ฮินดี และสเปน แต่ละบทความมีภาษาต้นฉบับของตนเอง — ต้นกำเนิดที่ใช้เขียนขึ้น — และมีคำแปลอีกสิบเอ็ดภาษาที่ซื่อตรงต่อต้นฉบับนั้น',
      'Mỗi chủ đề tồn tại bằng tiếng Mã Lai, tiếng Anh, tiếng Trung, tiếng Tamil, tiếng Nhật, tiếng Hàn, tiếng Thái, tiếng Việt, tiếng Indonesia, tiếng Ả Rập, tiếng Hindi và tiếng Tây Ban Nha. Mỗi bài viết có ngôn ngữ gốc riêng của mình — cội nguồn mà nó được soạn thảo — cùng mười một bản dịch trung thành với ngôn ngữ đó.',
      'Setiap topik hadir dalam bahasa Melayu, Inggris, Mandarin, Tamil, Jepang, Korea, Thai, Vietnam, Indonesia, Arab, Hindi, dan Spanyol. Setiap artikel memiliki bahasa induknya sendiri — asal tempat ia ditulis — dan sebelas terjemahan yang setia kepadanya.',
      'كل موضوع موجود بالملايوية والإنجليزية والصينية والتاميلية واليابانية والكورية والتايلاندية والفيتنامية والإندونيسية والعربية والهندية والإسبانية. لكل مقالة لغتها الأصلية الخاصة — المنشأ الذي كُتبت به — وإحدى عشرة ترجمة تظل وفيّة له.',
      'हर विषय मलय, अंग्रेज़ी, चीनी, तमिल, जापानी, कोरियाई, थाई, वियतनामी, इंडोनेशियाई, अरबी, हिन्दी और स्पेनिश में मौजूद है। प्रत्येक लेख की अपनी एक मूल भाषा होती है — वह उद्गम जिसमें इसे लिखा गया — और ग्यारह अनुवाद जो उसके प्रति निष्ठावान रहते हैं।',
      'Cada tema existe en malayo, inglés, chino, tamil, japonés, coreano, tailandés, vietnamita, indonesio, árabe, hindi y español. Cada artículo tiene su propio idioma maestro — el origen en que fue redactado — y once traducciones fieles a él.', 'Chaque sujet existe en malais, anglais, chinois, tamoul, japonais, coréen, thaï, vietnamien, indonésien, arabe, hindi et espagnol. Chaque article a sa propre langue maîtresse — celle dans laquelle il a été rédigé — et onze traductions qui lui restent fidèles.',
    ),
  },
  {
    icon: '🔗',
    title: L('Dipetik, bukan didakwa', 'Cited, not asserted', '有据可查，而非空谈', 'மேற்கோள் காட்டப்படுகிறது, வெறுமனே கூறப்படவில்லை', '主張ではなく、出典を', '주장이 아닌, 출처 제시', 'อ้างอิง ไม่ใช่กล่าวอ้างลอย ๆ', 'Được trích dẫn, không phải khẳng định suông', 'Dikutip, bukan diklaim', 'مُستشهَد به، لا مُدَّعى', 'उद्धृत, न कि केवल दावा किया गया', 'Citado, no afirmado', 'Cité, et non simplement affirmé'),
    body: L(
      'Setiap dakwaan yang boleh disemak membawa sumbernya. Artikel bergerak melalui tangga draf → disemak → diterbitkan, dan hanya yang diterbitkan muncul di laman awam.',
      'Every checkable claim carries its source. Articles move through a draft → reviewed → published ladder, and only published ones appear on the public site.',
      '每一条可核查的陈述都附有来源。文章经过草稿→审阅→发布的流程，且只有已发布的内容才出现在公开网站上。',
      'சரிபார்க்கக்கூடிய ஒவ்வொரு கூற்றும் அதன் மூலத்தைக் கொண்டுள்ளது. கட்டுரைகள் வரைவு → மதிப்பாய்வு → வெளியீடு என்ற படிநிலை வழியே நகர்கின்றன, வெளியிடப்பட்டவை மட்டுமே பொது தளத்தில் தோன்றுகின்றன.',
      '検証可能な主張にはすべて出典があります。記事は下書き → 査読 → 公開という段階を経て、公開されたものだけが公開サイトに表示されます。',
      '확인 가능한 모든 주장은 출처를 갖습니다. 기사는 초안 → 검토 → 발행 단계를 거치며, 발행된 것만 공개 사이트에 표시됩니다.',
      'ทุกข้อกล่าวอ้างที่ตรวจสอบได้มีแหล่งที่มากำกับ บทความเคลื่อนผ่านลำดับขั้น ร่าง → ตรวจทาน → เผยแพร่ และเฉพาะที่เผยแพร่แล้วเท่านั้นจึงปรากฏบนเว็บไซต์สาธารณะ',
      'Mọi tuyên bố có thể kiểm chứng đều kèm theo nguồn của nó. Các bài viết đi qua trình tự bản thảo → được rà soát → được xuất bản, và chỉ những bài đã xuất bản mới xuất hiện trên trang công khai.',
      'Setiap klaim yang dapat diperiksa menyertakan sumbernya. Artikel bergerak melalui tahapan draf → ditinjau → diterbitkan, dan hanya yang diterbitkan yang muncul di situs publik.',
