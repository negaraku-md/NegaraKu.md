  .psec-body { padding: 1.2rem; }
  .psec-body.prose p { margin: 0 0 0.9rem; line-height: 1.75; color: var(--ink-soft); }
  .psec-body.prose p:last-child { margin-bottom: 0; }

  /* "Our story": cap the prose to a reading column and fill the open right with
     a faint, theme-aware blossom watermark (behind the text). */
  .story { position: relative; overflow: hidden; }
  .story .psec-body.prose { max-width: 62ch; position: relative; z-index: 1; }
  .story-bloom {
    position: absolute; inset-inline-end: 1.5rem; bottom: 1.1rem;
    width: clamp(140px, 15vw, 230px); height: auto;
    color: var(--gold); opacity: 0.08; pointer-events: none; z-index: 0;
  }
  @media (max-width: 800px) { .story-bloom { display: none; } .story .psec-body.prose { max-width: none; } }

  /* Tagline box — the tagline shown as a prominent centred line inside a card. */
  .tagline-line {
    margin: 0; text-align: center; font-family: var(--font-title);
    font-weight: 800; font-size: clamp(1.5rem, 3.5vw, 2.1rem); color: var(--ink);
    letter-spacing: 0.01em; padding: 0.6rem 0;
  }
  .tagline-line .wm-dot { color: var(--gold); }

  /* Vision & Mission — larger, brighter statements than body prose. */
  .vm-lead { margin: 0; font-family: var(--font-title); font-size: 1.2rem; line-height: 1.5; color: var(--ink); }

  /* Core values — compact principles, gold titles, a left gold rule per item. */
  .values { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem 1.5rem; }
  .value { border-inline-start: 2px solid var(--gold); padding-inline-start: 0.85rem; }
  .value b { display: block; font-family: var(--font-title); font-size: 1rem; color: var(--ink); margin-bottom: 0.25rem; }
  .value p { margin: 0; color: var(--ink-soft); font-size: 0.9rem; line-height: 1.55; }

