---
import type { Locale } from '@/lib/categories';
import { siteStats } from '@/lib/content';
import { localePath } from '@/lib/i18n';
import { REPO } from '@/lib/site';
import { FLOWER_D } from '@/lib/logo';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string) => (locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);
const stats = await siteStats(locale);

// How the knowledge base actually works — four load-bearing ideas, each a card.
const pillars = [
  {
    icon: '📄',
    title: L('Satu sumber kebenaran', 'One source of truth', '单一事实来源', 'ஒரே உண்மை மூலம்', '唯一の信頼できる情報源'),
    body: L(
      'Setiap artikel ialah satu fail Markdown di GitHub. Tiada pangkalan data tersembunyi — apa yang anda baca ialah fail itu sendiri, boleh dibaca manusia dan mesin.',
      'Every article is a single Markdown file on GitHub. No hidden database — what you read is the file itself, legible to both people and machines.',
      '每篇文章都是 GitHub 上的一个 Markdown 文件。没有隐藏的数据库——你所读到的就是文件本身，人与机器皆可读。',
      'ஒவ்வொரு கட்டுரையும் GitHub-இல் உள்ள ஒரே ஒரு Markdown கோப்பு. மறைந்திருக்கும் தரவுத்தளம் எதுவும் இல்லை — நீங்கள் படிப்பது அந்தக் கோப்பே, மனிதர்களாலும் இயந்திரங்களாலும் படிக்கக்கூடியது.',
      '各記事は GitHub 上の一つの Markdown ファイルです。隠れたデータベースはなく、あなたが読むのはファイルそのもの — 人にも機械にも読み取れます。',
    ),
  },
  {
    icon: '🌏',
    title: L('Empat bahasa, satu paras', 'Four languages, one parity', '四种语言，完全对等', 'நான்கு மொழிகள், ஒரே சமநிலை', '四つの言語、一つの対等性'),
    body: L(
      'Setiap topik wujud dalam Bahasa Melayu, Inggeris, Cina dan Tamil. Setiap artikel mempunyai bahasa induknya sendiri — asal usul yang mengarang, dan tiga terjemahan yang setia kepadanya.',
      'Every topic exists in Malay, English, Chinese and Tamil. Each article has its own master language — the origin it was authored in — and three translations kept faithful to it.',
      '每个主题都以马来文、英文、中文和泰米尔文呈现。每篇文章都有自己的主语言（撰写的源头），以及三个忠于它的译本。',
      'ஒவ்வொரு தலைப்பும் மலாய், ஆங்கிலம், சீனம் மற்றும் தமிழ் மொழிகளில் உள்ளது. ஒவ்வொரு கட்டுரைக்கும் அதற்கே உரிய மூல மொழி உண்டு — எழுதப்பட்ட தோற்றுவாய் — மேலும் அதற்கு உண்மையாக இருக்கும் மூன்று மொழிபெயர்ப்புகள்.',
      '各トピックはマレー語・英語・中国語・タミル語で存在します。各記事にはそれぞれの原語（執筆された起源）があり、それに忠実な三つの翻訳が付きます。',
    ),
  },
  {
    icon: '🔗',
    title: L('Dipetik, bukan didakwa', 'Cited, not asserted', '有据可查，而非空谈', 'மேற்கோள் காட்டப்படுகிறது, வெறுமனே கூறப்படவில்லை', '主張ではなく、出典を'),
    body: L(
      'Setiap dakwaan yang boleh disemak membawa sumbernya. Artikel bergerak melalui tangga draf → disemak → diterbitkan, dan hanya yang diterbitkan muncul di laman awam.',
      'Every checkable claim carries its source. Articles move through a draft → reviewed → published ladder, and only published ones appear on the public site.',
      '每一条可核查的陈述都附有来源。文章经过草稿→审阅→发布的流程，且只有已发布的内容才出现在公开网站上。',
      'சரிபார்க்கக்கூடிய ஒவ்வொரு கூற்றும் அதன் மூலத்தைக் கொண்டுள்ளது. கட்டுரைகள் வரைவு → மதிப்பாய்வு → வெளியீடு என்ற படிநிலை வழியே நகர்கின்றன, வெளியிடப்பட்டவை மட்டுமே பொது தளத்தில் தோன்றுகின்றன.',
      '検証可能な主張にはすべて出典があります。記事は下書き → 査読 → 公開という段階を経て、公開されたものだけが公開サイトに表示されます。',
    ),
  },
  {
    icon: '🤝',
    title: L('Kandungan sensitif, dikendalikan berhati-hati', 'Sensitive content, handled with care', '敏感内容，审慎处理', 'உணர்திறன் வாய்ந்த உள்ளடக்கம், கவனத்துடன் கையாளப்படுகிறது', '機微な内容は慎重に'),
    body: L(
      'Topik yang menyentuh kaum, agama, institusi diraja atau perlembagaan dilabel dan disemak seorang manusia sebelum terbit — ditulis neutral dan bersumber.',
      'Topics touching race, religion, royalty or the constitution are labelled and human-reviewed before publishing — written neutrally and sourced.',
      '涉及种族、宗教、王室或宪法的话题会被标注，并在发布前经人工审阅——保持中立、注明来源。',
      'இனம், மதம், அரச நிறுவனங்கள் அல்லது அரசியலமைப்பைத் தொடும் தலைப்புகள் குறிக்கப்பட்டு, வெளியிடுவதற்கு முன் ஒரு மனிதரால் மதிப்பாய்வு செய்யப்படுகின்றன — நடுநிலையாக எழுதப்பட்டு மூலம் காட்டப்படுகின்றன.',
      '人種、宗教、王室、憲法に関わるトピックはラベル付けされ、公開前に人手で査読されます — 中立に書かれ、出典が示されます。',
    ),
  },
];

// Core values — short principles (distinct from the mechanical "How it works").
const values = [
  {
    title: L('Terbuka secara lalai', 'Open by default', '默认开放', 'இயல்பாகவே திறந்தது', '既定で公開'),
    body: L(
      'Semuanya boleh dilihat sumbernya di GitHub; setiap halaman menyediakan Markdown mentahnya.',
      'Everything is source-visible on GitHub; every page offers its raw Markdown.',
      '一切源码公开于 GitHub；每个页面都提供其原始 Markdown。',
      'அனைத்தின் மூலமும் GitHub-இல் காணக்கூடியது; ஒவ்வொரு பக்கமும் அதன் மூல Markdown-ஐ வழங்குகிறது.',
      'すべて GitHub でソースを閲覧でき、各ページは生の Markdown を提供します。',
    ),
  },
  {
    title: L('Dipetik, bukan didakwa', 'Cited, not claimed', '有据可查，而非空谈', 'மேற்கோள் காட்டப்படுகிறது, வெறுமனே உரிமை கோரப்படவில்லை', '主張ではなく、出典を'),
    body: L(
      'Setiap fakta yang boleh disemak membawa sumbernya.',
      'Every checkable fact carries its source.',
      '每一条可核查的事实都附有来源。',
      'சரிபார்க்கக்கூடிய ஒவ்வொரு உண்மையும் அதன் மூலத்தைக் கொண்டுள்ளது.',
      '検証可能な事実にはすべて出典があります。',
    ),
  },
  {
    title: L('Berbilang bahasa setara', 'Multilingual parity', '多语对等', 'பன்மொழிச் சமநிலை', '多言語の対等性'),
    body: L(
      'Bahasa Melayu, Inggeris, Cina dan Tamil dilayan setara — tiada bahasa “utama”.',
      'Malay, English, Chinese and Tamil are treated as equals — no “main” language.',
      '马来文、英文、中文与泰米尔文一视同仁——没有“主”语言。',
      'மலாய், ஆங்கிலம், சீனம் மற்றும் தமிழ் மொழிகள் சமமாக நடத்தப்படுகின்றன — “முதன்மை” மொழி என்று எதுவும் இல்லை.',
      'マレー語・英語・中国語・タミル語は対等に扱われ、「主」言語はありません。',
    ),
  },
  {
    title: L('Neutral pada isu sensitif', 'Neutral on sensitive ground', '敏感议题保持中立', 'உணர்திறன் வாய்ந்த விடயங்களில் நடுநிலை', '機微な領域では中立'),
    body: L(
      'Kaum, agama, institusi diraja dan perlembagaan — bersumber, berhati-hati, disemak manusia.',
      'Race, religion, royalty, and the constitution — sourced, careful, human-reviewed.',
      '种族、宗教、王室与宪法——注明来源、审慎处理、人工审阅。',
      'இனம், மதம், அரச நிறுவனங்கள் மற்றும் அரசியலமைப்பு — மூலம் காட்டப்பட்டு, கவனத்துடன், மனிதரால் மதிப்பாய்வு செய்யப்பட்டவை.',
      '人種、宗教、王室、憲法 — 出典を示し、慎重に、人手で査読します。',
    ),
  },
];

// "Explore more" — point to the dedicated pages instead of duplicating them
// here (the FAQ and a real, live changelog both have their own pages now).
const more = [
  {
    icon: '❓',
    title: L('Soalan Lazim', 'FAQ', '常见问题', 'அடிக்கடி கேட்கப்படும் கேள்விகள்', 'よくある質問'),
    desc: L('Jawapan kepada soalan yang paling kerap ditanya.', 'Answers to the most common questions.', '最常见问题的解答。', 'அதிகம் கேட்கப்படும் கேள்விகளுக்கான பதில்கள்.', '最もよくある質問への回答。'),
    href: localePath('/faq', locale),
  },
  {
    icon: '📝',
    title: L('Log Perubahan', 'Changelog', '更新日志', 'மாற்றப் பதிவேடு', '変更履歴'),
    desc: L('Apa yang berubah — terus daripada sejarah GitHub.', 'What’s changed — straight from the GitHub history.', '有何变化——直接来自 GitHub 历史。', 'என்ன மாறியது — நேரடியாக GitHub வரலாற்றிலிருந்து.', '何が変わったか — GitHub の履歴から直接。'),
    href: localePath('/changelog', locale),
  },
  {
    icon: '👥',
    title: L('Penyumbang', 'Contributors', '贡献者', 'பங்களிப்பாளர்கள்', '貢献者'),
    desc: L('Orang yang menulis dan menyemak korpus ini.', 'The people who write and review this corpus.', '撰写和审阅本语料库的人。', 'இந்தத் தொகுப்பை எழுதி மதிப்பாய்வு செய்யும் மக்கள்.', 'このコーパスを書き、査読する人々。'),
    href: localePath('/contributors', locale),
  },
];
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム'), href: localePath('/', locale) },
    { label: L('Tentang', 'About', '关于', 'பற்றி', '概要') },
  ]}
  title={L('Tentang NegaraKu.md', 'About NegaraKu.md', '关于 NegaraKu.md', 'NegaraKu.md பற்றி', 'NegaraKu.md について')}
  desc={L(
    'Pangkalan pengetahuan sumber terbuka dan mesra-AI tentang Malaysia — satu sumber kebenaran yang dikurasi, dipetik, dan disemak komuniti.',
    'An open-source, AI-friendly knowledge base about Malaysia — a curated, cited, community-reviewed single source of truth.',
    '关于马来西亚的开源、AI 友好知识库——经策展、注明来源、由社区审阅的单一事实来源。',
    'மலேசியா பற்றிய திறந்த மூல, AI-நட்பு அறிவுத் தளம் — கவனமாகத் தொகுக்கப்பட்ட, மேற்கோள் காட்டப்பட்ட, சமூகத்தால் மதிப்பாய்வு செய்யப்பட்ட ஒரே உண்மை மூலம்.',
    'マレーシアに関する、オープンソースでAIフレンドリーな知識ベース — 丁寧に編纂され、出典が示され、コミュニティが査読した唯一の信頼できる情報源。',
  )}
  stats={[
    { value: stats.sections, label: L('tonggak', 'pillars', '支柱', 'தூண்கள்', '柱') },
    { value: stats.categories, label: L('kategori', 'categories', '分类', 'வகைகள்', 'カテゴリ') },
    { value: stats.topics, label: L('subkategori', 'subcategories', '子分类', 'துணை வகைகள்', 'サブカテゴリ') },
    { value: stats.articles, label: L('topik', 'topics', '主题', 'தலைப்புகள்', 'トピック') },
  ]}
/>

<section class="container block">
  <div class="psec story">
    <header><span>{L('Kisah kami', 'Our story', '我们的故事', 'எங்கள் கதை', '私たちの物語')}</span></header>
    <svg class="story-bloom" viewBox="0 0 776 776" aria-hidden="true">
      <path fill="currentColor" fill-rule="evenodd" d={FLOWER_D} />
    </svg>
    <div class="psec-body prose">
      <p>{L('NegaraKu.md dibina atas satu idea: pengetahuan tentang Malaysia patut mudah dibaca — oleh manusia dan oleh model bahasa besar. Namanya diambil daripada lagu kebangsaan Malaysia.', 'NegaraKu.md is built on one idea: knowledge about Malaysia should be easy to read — by people and by large language models alike. Its name comes from Malaysia\'s national anthem.', 'NegaraKu.md 建立在一个理念之上：关于马来西亚的知识应当便于阅读——无论是人，还是大型语言模型。它的名字取自马来西亚国歌。', 'NegaraKu.md ஒரே ஒரு எண்ணத்தின் அடிப்படையில் கட்டமைக்கப்பட்டது: மலேசியா பற்றிய அறிவு படிக்க எளிதாக இருக்க வேண்டும் — மனிதர்களாலும் பெரிய மொழி மாதிரிகளாலும் ஒருங்கே. அதன் பெயர் மலேசியாவின் தேசிய கீதத்திலிருந்து வந்தது.', 'NegaraKu.md は一つの理念に基づいています。マレーシアに関する知識は、人にも大規模言語モデルにも読みやすくあるべきだ、ということです。その名はマレーシアの国歌に由来します。')}</p>
      <p>{L('Kandungan awal dijana AI dan disemak, kemudian dikembangkan menjadi korpus empat bahasa yang lengkap. Hari ini setiap topik hidup sebagai fail di GitHub, terbuka untuk sesiapa membaca, memetik, atau memperbaiki.', 'Initial content was AI-drafted and reviewed, then grown into a complete four-language corpus. Today every topic lives as a file on GitHub, open for anyone to read, cite, or improve.', '初始内容由 AI 起草并审阅，随后发展为完整的四语语料库。如今每个主题都以 GitHub 上的文件形式存在，任何人都可阅读、引用或改进。', 'ஆரம்ப உள்ளடக்கம் AI-ஆல் வரையப்பட்டு மதிப்பாய்வு செய்யப்பட்டது, பின்னர் முழுமையான நான்கு மொழித் தொகுப்பாக வளர்க்கப்பட்டது. இன்று ஒவ்வொரு தலைப்பும் GitHub-இல் ஒரு கோப்பாக வாழ்கிறது, யாரும் படிக்க, மேற்கோள் காட்ட, அல்லது மேம்படுத்த திறந்திருக்கிறது.', '当初の内容は AI が下書きし査読され、その後、完全な四言語コーパスへと成長しました。今日、各トピックは GitHub 上のファイルとして存在し、誰でも読み、引用し、改善できるよう開かれています。')}</p>
    </div>
  </div>
</section>

<section class="container block two">
  <div class="psec">
    <header><span>{L('Visi', 'Vision', '愿景', 'நோக்கு', 'ビジョン')}</span></header>
    <div class="psec-body">
      <p class="vm-lead">{L(
        'Sebuah Malaysia yang pengetahuannya terbuka, boleh dipercayai, dan mudah dibaca — oleh manusia dan oleh AI yang mereka gunakan.',
        'A Malaysia whose knowledge is open, trustworthy, and equally readable — by people and by the AI they rely on.',
        '一个知识开放、可信、并能被人类及其所依赖的 AI 同样读懂的马来西亚。',
        'அறிவு திறந்ததாகவும், நம்பகமானதாகவும், சமமாகப் படிக்கக்கூடியதாகவும் இருக்கும் ஒரு மலேசியா — மனிதர்களாலும் அவர்கள் நம்பியிருக்கும் AI-ஆலும்.',
        '知識が開かれ、信頼でき、等しく読める — 人にも、人が頼る AI にも読める、そんなマレーシア。',
      )}</p>
    </div>
  </div>
  <div class="psec">
    <header><span>{L('Misi', 'Mission', '使命', 'பணி', 'ミッション')}</span></header>
    <div class="psec-body">
      <p class="vm-lead">{L('Biar dunia mengenali Malaysia.', 'Let the world know about Malaysia.', '让世界认识马来西亚。', 'உலகம் மலேசியாவை அறியட்டும்.', '世界にマレーシアを知ってもらう。')}</p>
      <p>{L(
        'Menyusun pengetahuan Malaysia menjadi perpustakaan terbuka, bersumber dan empat bahasa yang boleh dibaca, disahkan dan dikembangkan oleh sesiapa sahaja — dan mana-mana AI.',
        'To curate Malaysia’s knowledge into an open, cited, four-language library that anyone — and any AI — can read, verify, and build on.',
        '将马来西亚的知识整理成一个开放、有据可查、四语的知识库，让任何人——以及任何 AI——都能阅读、查证并在其之上继续建构。',
        'மலேசியாவின் அறிவை, யாரும் — மற்றும் எந்த AI-உம் — படிக்கவும், சரிபார்க்கவும், அதன் மேல் கட்டமைக்கவும் கூடிய திறந்த, மேற்கோள் காட்டப்பட்ட, நான்கு மொழி நூலகமாகத் தொகுப்பது.',
