---
import type { Locale } from '@/lib/categories';
import { siteStats } from '@/lib/content';
import { localePath } from '@/lib/i18n';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);
const stats = await siteStats(locale);

// How the knowledge base actually works — four load-bearing ideas, each a card.
const pillars = [
  {
    icon: '📄',
    title: L('Satu sumber kebenaran', 'One source of truth', '单一事实来源'),
    body: L(
      'Setiap artikel ialah satu fail Markdown di GitHub. Tiada pangkalan data tersembunyi — apa yang anda baca ialah fail itu sendiri, boleh dibaca manusia dan mesin.',
      'Every article is a single Markdown file on GitHub. No hidden database — what you read is the file itself, legible to both people and machines.',
      '每篇文章都是 GitHub 上的一个 Markdown 文件。没有隐藏的数据库——你所读到的就是文件本身，人与机器皆可读。',
    ),
  },
  {
    icon: '🌏',
    title: L('Tiga bahasa, satu paras', 'Three languages, one parity', '三种语言，完全对等'),
    body: L(
      'Setiap topik wujud dalam Bahasa Melayu, Inggeris dan Cina. Setiap artikel mempunyai bahasa induknya sendiri — asal usul yang mengarang, dan dua terjemahan yang setia kepadanya.',
      'Every topic exists in Malay, English and Chinese. Each article has its own master language — the origin it was authored in — and two translations kept faithful to it.',
      '每个主题都以马来文、英文和中文呈现。每篇文章都有自己的主语言（撰写的源头），以及两个忠于它的译本。',
    ),
  },
  {
    icon: '🔗',
    title: L('Dipetik, bukan didakwa', 'Cited, not asserted', '有据可查，而非空谈'),
    body: L(
      'Setiap dakwaan yang boleh disemak membawa sumbernya. Artikel bergerak melalui tangga draf → disemak → diterbitkan, dan hanya yang diterbitkan muncul di laman awam.',
      'Every checkable claim carries its source. Articles move through a draft → reviewed → published ladder, and only published ones appear on the public site.',
      '每一条可核查的陈述都附有来源。文章经过草稿→审阅→发布的流程，且只有已发布的内容才出现在公开网站上。',
    ),
  },
  {
    icon: '🤝',
    title: L('Kandungan sensitif, dikendalikan berhati-hati', 'Sensitive content, handled with care', '敏感内容，审慎处理'),
    body: L(
      'Topik yang menyentuh kaum, agama, institusi diraja atau perlembagaan dilabel dan disemak seorang manusia sebelum terbit — ditulis neutral dan bersumber.',
      'Topics touching race, religion, royalty or the constitution are labelled and human-reviewed before publishing — written neutrally and sourced.',
      '涉及种族、宗教、王室或宪法的话题会被标注，并在发布前经人工审阅——保持中立、注明来源。',
    ),
  },
];

// Core values — short principles (distinct from the mechanical "How it works").
const values = [
  {
    title: L('Terbuka secara lalai', 'Open by default', '默认开放'),
    body: L(
      'Semuanya boleh dilihat sumbernya di GitHub; setiap halaman menyediakan Markdown mentahnya.',
      'Everything is source-visible on GitHub; every page offers its raw Markdown.',
      '一切源码公开于 GitHub；每个页面都提供其原始 Markdown。',
    ),
  },
  {
    title: L('Dipetik, bukan didakwa', 'Cited, not claimed', '有据可查，而非空谈'),
    body: L(
      'Setiap fakta yang boleh disemak membawa sumbernya.',
      'Every checkable fact carries its source.',
      '每一条可核查的事实都附有来源。',
    ),
  },
  {
    title: L('Tiga bahasa setara', 'Trilingual parity', '三语对等'),
    body: L(
      'Bahasa Melayu, Inggeris dan Cina dilayan setara — tiada bahasa “utama”.',
      'Malay, English, and Chinese are treated as equals — no “main” language.',
      '马来文、英文与中文一视同仁——没有“主”语言。',
    ),
  },
  {
    title: L('Neutral pada isu sensitif', 'Neutral on sensitive ground', '敏感议题保持中立'),
    body: L(
      'Kaum, agama, institusi diraja dan perlembagaan — bersumber, berhati-hati, disemak manusia.',
      'Race, religion, royalty, and the constitution — sourced, careful, human-reviewed.',
      '种族、宗教、王室与宪法——注明来源、审慎处理、人工审阅。',
    ),
  },
];

const timeline = [
  { date: '2026-07-22', text: L('NegaraKu.md dilancarkan sebagai projek sumber terbuka.', 'NegaraKu.md launches as an open-source project.', 'NegaraKu.md 作为开源项目启动。') },
  { date: '2026-07-26', text: L('Korpus mencapai paras tiga bahasa penuh — 570 topik × 3.', 'Corpus reaches full trilingual parity — 570 topics × 3.', '语料库达成完整三语对等——570 个主题 × 3。') },
];

const faqs = [
  {
    q: L('Apa bezanya dengan Wikipedia?', 'How is this different from Wikipedia?', '与维基百科有何不同？'),
    a: L('NegaraKu.md ialah naratif yang dikurasi dalam Markdown, direka untuk manusia dan AI, dengan satu sumber kebenaran di GitHub — bukan ensiklopedia yang boleh disunting sesiapa secara langsung.', 'NegaraKu.md is curated narrative in Markdown, designed for humans and AI, with a single source of truth on GitHub — not an encyclopedia anyone edits live.', 'NegaraKu.md 是以 Markdown 撰写、面向人类与 AI 的策展叙事，事实来源统一存于 GitHub——并非任何人都能实时编辑的百科。'),
  },
  {
    q: L('Bagaimana kualiti dijamin?', 'How is quality ensured?', '如何保证质量？'),
    a: L('Setiap artikel dipetik sumbernya dan melalui tangga draf → disemak → diterbitkan, dengan pengimbas kesihatan automatik pada setiap binaan.', 'Every article is cited and moves through a draft → reviewed → published ladder, with an automated health scanner on every build.', '每篇文章都注明来源，并经过草稿→审阅→发布的流程，每次构建都有自动健康扫描。'),
  },
  {
    q: L('Bagaimana isu sensitif dikendalikan?', 'How are sensitive topics handled?', '如何处理敏感话题？'),
    a: L('Topik sensitif (kaum, agama, institusi diraja, perlembagaan) dilabel mengikut satu piawai klasifikasi, mesti bersumber dan neutral, dan disemak manusia sebelum diterbitkan.', 'Sensitive topics (race, religion, royalty, the constitution) are labelled by a single classification standard, must be sourced and neutral, and are human-reviewed before publishing.', '敏感话题（种族、宗教、王室、宪法）依统一的分类标准标注，必须注明来源、保持中立，并在发布前经人工审阅。'),
  },
  {
    q: L('Bolehkah AI menggunakan kandungan ini?', 'Can AI use this content?', 'AI 可以使用这些内容吗？'),
    a: L('Ya — setiap halaman menyediakan Markdown mentah, dan laman ini menerbitkan llms.txt untuk model bahasa besar.', 'Yes — every page offers its raw Markdown, and the site publishes an llms.txt for large language models.', '可以——每个页面都提供原始 Markdown，网站也发布 llms.txt 供大型语言模型使用。'),
  },
  {
    q: L('Apakah lesennya?', 'What is the license?', '采用什么许可？'),
    a: L('Kandungan di bawah CC BY-SA 4.0; kod di bawah MIT.', 'Content under CC BY-SA 4.0; code under MIT.', '内容采用 CC BY-SA 4.0，代码采用 MIT。'),
  },
];
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页'), href: localePath('/', locale) },
    { label: L('Tentang', 'About', '关于') },
  ]}
  title={L('Tentang NegaraKu.md', 'About NegaraKu.md', '关于 NegaraKu.md')}
  desc={L(
    'Pangkalan pengetahuan sumber terbuka dan mesra-AI tentang Malaysia — satu sumber kebenaran yang dikurasi, dipetik, dan boleh disunting komuniti.',
    'An open-source, AI-friendly knowledge base about Malaysia — a curated, cited, community-editable single source of truth.',
    '关于马来西亚的开源、AI 友好知识库——经策展、注明来源、可由社区编辑的单一事实来源。',
  )}
  stats={[
    { value: stats.sections, label: L('seksyen', 'sections', '版块') },
    { value: stats.categories, label: L('kategori', 'categories', '分类') },
    { value: stats.topics, label: L('topik', 'topics', '主题') },
    { value: stats.articles, label: L('artikel', 'articles', '文章') },
  ]}
/>

<section class="container block">
  <div class="psec">
    <header><span>{L('Kisah kami', 'Our story', '我们的故事')}</span></header>
    <div class="psec-body prose">
      <p>{L('NegaraKu.md dibina atas satu idea: pengetahuan tentang Malaysia patut mudah dibaca — oleh manusia dan oleh model bahasa besar. Namanya diambil daripada lagu kebangsaan Malaysia.', 'NegaraKu.md is built on one idea: knowledge about Malaysia should be easy to read — by people and by large language models alike. Its name comes from Malaysia\'s national anthem.', 'NegaraKu.md 建立在一个理念之上：关于马来西亚的知识应当便于阅读——无论是人，还是大型语言模型。它的名字取自马来西亚国歌。')}</p>
      <p>{L('Kandungan awal dijana AI dan disemak, kemudian dikembangkan menjadi korpus tiga bahasa yang lengkap. Hari ini setiap topik hidup sebagai fail di GitHub, terbuka untuk sesiapa membaca, memetik, atau memperbaiki.', 'Initial content was AI-drafted and reviewed, then grown into a complete trilingual corpus. Today every topic lives as a file on GitHub, open for anyone to read, cite, or improve.', '初始内容由 AI 起草并审阅，随后发展为完整的三语语料库。如今每个主题都以 GitHub 上的文件形式存在，任何人都可阅读、引用或改进。')}</p>
    </div>
  </div>
</section>

<p class="brand-strap container">{L('Malaysia mesra-AI', 'AI-friendly Malaysia', 'AI 友好的马来西亚')}</p>

<section class="container block two">
  <div class="psec">
    <header><span>{L('Visi', 'Vision', '愿景')}</span></header>
    <div class="psec-body">
      <p class="vm-lead">{L(
        'Sebuah Malaysia yang pengetahuannya terbuka, boleh dipercayai, dan mudah dibaca — oleh manusia dan oleh AI yang mereka gunakan.',
        'A Malaysia whose knowledge is open, trustworthy, and equally readable — by people and by the AI they rely on.',
        '一个知识开放、可信、并能被人类及其所依赖的 AI 同样读懂的马来西亚。',
      )}</p>
    </div>
  </div>
  <div class="psec">
    <header><span>{L('Misi', 'Mission', '使命')}</span></header>
    <div class="psec-body">
      <p class="vm-lead">{L(
        'Menyusun pengetahuan Malaysia menjadi perpustakaan terbuka, bersumber dan tiga bahasa yang boleh dibaca, disahkan dan dikembangkan oleh sesiapa sahaja — dan mana-mana AI.',
        'To curate Malaysia’s knowledge into an open, cited, trilingual library that anyone — and any AI — can read, verify, and build on.',
        '将马来西亚的知识整理成一个开放、有据可查、三语的知识库，让任何人——以及任何 AI——都能阅读、查证并在其之上继续建构。',
      )}</p>
    </div>
  </div>
</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Cara ia berfungsi', 'How it works', '运作方式')}</span></header>
    <div class="psec-body">
      <div class="pcards">
        {pillars.map((p) => (
          <div class="pcard">
            <span class="pico" aria-hidden="true">{p.icon}</span>
            <b>{p.title}</b>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Nilai teras', 'Core values', '核心价值')}</span></header>
    <div class="psec-body">
      <div class="values">
        {values.map((v) => (
          <div class="value">
            <b>{v.title}</b>
            <p>{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="container block two">
  <div class="psec">
    <header><span>{L('Garis masa', 'Timeline', '时间线')}</span></header>
    <div class="psec-body">
      <ul class="timeline">
        {timeline.map((m) => <li><span class="tl-date">{m.date}</span><span>{m.text}</span></li>)}
      </ul>
    </div>
  </div>
  <div class="psec">
    <header><span>{L('Soalan lazim', 'FAQ', '常见问题')}</span></header>
    <div class="psec-body">
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Sumbang', 'Contribute', '贡献')}</span></header>
    <div class="psec-body split-body">
      <div>
        <b class="cta-title">{L('Bantu bina NegaraKu.md', 'Help build NegaraKu.md', '一起建设 NegaraKu.md')}</b>
        <p class="muted">{L('Betulkan fakta, tambah topik, atau perhalusi terjemahan — semuanya melalui GitHub.', 'Fix a fact, add a topic, or refine a translation — all through GitHub.', '更正事实、新增主题，或改进翻译——全部通过 GitHub。')}</p>
      </div>
      <a class="btn btn-primary" href={localePath('/contribute', locale)}>{L('Sumbang kepada NegaraKu.md', 'Contribute to NegaraKu.md', '为 NegaraKu.md 做贡献')}</a>
    </div>
  </div>
</section>

<section class="container block sponsor-block">
  <div class="psec">
    <header><span>{L('Penaja', 'Sponsor', '赞助')}</span></header>
    <div class="psec-body">
      <p class="sbody">{L('NegaraKu.md ditaja oleh', 'NegaraKu.md is sponsored by', 'NegaraKu.md 由')}
        <a href="https://www.1company.com" rel="noopener"><span class="oneco">1company.com</span></a>{L('.', '.', ' 赞助。')}</p>
      <p class="muted">{L('Sokongan mereka memastikan projek ini kekal terbuka dan percuma.', 'Their support keeps this project open and free.', '他们的支持让本项目保持开放与免费。')}</p>
    </div>
  </div>
</section>

<style>
  /* Section box — the same gold-header band used across the site, so About reads
     as one system with the category and article pages. */
  .block { margin-top: 1.6rem; }
  .psec { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .psec > header {
    padding: 0.45rem 0.95rem; font-size: 1.05rem; font-weight: 700; letter-spacing: 0.03em;
    text-transform: uppercase; background: var(--surface-2); border-bottom: 1px solid var(--line);
    font-family: var(--font-title);
  }
  .psec > header span { color: var(--gold); }
  .psec-body { padding: 1.2rem; }
  .psec-body.prose p { margin: 0 0 0.9rem; line-height: 1.75; color: var(--ink-soft); }
  .psec-body.prose p:last-child { margin-bottom: 0; }

  /* Brand strapline — the tagline, shown as a prominent centred line. */
  .brand-strap {
    margin: 2rem auto 0.4rem; text-align: center; font-family: var(--font-title);
    font-weight: 800; font-size: clamp(1.5rem, 3.5vw, 2.1rem); color: var(--ink);
    letter-spacing: 0.01em;
  }

  /* Vision & Mission — larger, brighter statements than body prose. */
  .vm-lead { margin: 0; font-family: var(--font-title); font-size: 1.2rem; line-height: 1.5; color: var(--ink); }

  /* Core values — compact principles, gold titles, a left gold rule per item. */
  .values { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem 1.5rem; }
  .value { border-left: 2px solid var(--gold); padding-left: 0.85rem; }
  .value b { display: block; font-family: var(--font-title); font-size: 1rem; color: var(--ink); margin-bottom: 0.25rem; }
  .value p { margin: 0; color: var(--ink-soft); font-size: 0.9rem; line-height: 1.55; }

  .pcards { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem; }
  .pcard { background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; padding: 1.1rem 1.15rem; }
  .pico { font-size: 1.4rem; }
  .pcard b { display: block; font-family: var(--font-title); font-size: 1.02rem; margin: 0.4rem 0 0.35rem; color: var(--ink); }
  .pcard p { margin: 0; color: var(--ink-soft); font-size: 0.9rem; line-height: 1.6; }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; }
  .timeline { list-style: none; padding: 0; margin: 0; }
  .timeline li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 0.75rem; padding: 0.55rem 0; border-left: 2px solid var(--gold); padding-left: 1rem; }
  .timeline li + li { margin-top: 0.1rem; }
  .tl-date { color: var(--gold); font-weight: 700; font-size: 0.82rem; }

  .faq { border: 1px solid var(--line); border-radius: 10px; padding: 0.2rem 1rem; margin: 0 0 0.55rem; background: var(--surface-2); }
  .faq:last-child { margin-bottom: 0; }
  .faq summary { cursor: pointer; font-weight: 700; padding: 0.55rem 0; }
  .faq p { color: var(--ink-soft); margin: 0 0 0.6rem; line-height: 1.6; }

  .sponsor-block { padding-bottom: 3rem; }
  .split-body { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .cta-title { display: block; font-family: var(--font-title); font-size: 1.1rem; color: var(--ink); margin-bottom: 0.3rem; }
  .sbody { font-size: 1.1rem; margin: 0 0 0.4rem; }
  .sbody a { color: var(--gold); text-decoration: none; font-weight: 700; }
  .muted { color: var(--muted); margin: 0; }

  @media (max-width: 800px) { .two { grid-template-columns: 1fr; } }
</style>
