---
import type { Locale, Category } from '@/lib/categories';
import { getPillar, getPillarDef, categoriesInPillar, PILLARS, loc, hubSlug, getCategoryColor } from '@/lib/categories';
import type { Article } from '@/lib/content';
import { mostReadKeys } from '@/lib/apidata';
import { localePath } from '@/lib/i18n';
import PageHero from './PageHero.astro';
import { stat } from '@/lib/pageStats';
import HubGroups from './HubGroups.astro';
import ArticleStrip from './ArticleStrip.astro';

import ServiceCategory from './category/ServiceCategory.astro';

// Category pages share one skeleton — purpose line, scoped search, then an
// ARCHETYPE BODY that changes with the kind of knowledge the category holds.
// Readers learn the pattern once; only the middle differs.

interface Props {
  locale: Locale;
  category: Category;
  articles: Article[];
}
const { locale, category, articles } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string, ar?: string, hi?: string, es?: string, fr?: string) => (locale === 'fr' ? (fr ?? ms) : locale === 'es' ? (es ?? ms) : locale === 'hi' ? (hi ?? ms) : locale === 'ar' ? (ar ?? ms) : locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

const pillar = getPillar(category.id);
const pillarDef = pillar ? getPillarDef(pillar) : undefined;
const topicCount = new Set(articles.flatMap((a) => a.data.subcategory)).size;
// Follow the section-page hero: Sections (site total) · Categories (siblings in
// this section) · Topics · Articles.
const catCount = pillar ? categoriesInPillar(pillar).length : 0;

// Hero stats: drop the "categories" tile for a category with no parent pillar,
// rather than showing a meaningless "0 categories".
const heroStats = [
  stat.pillars(PILLARS.length, locale),
  ...(pillar ? [stat.categories(catCount, locale)] : []),
  stat.subcategories(topicCount, locale),
  stat.topics(articles.length, locale),
];

// Every category uses the service archetype now — one uniform, scalable body.
const Body = ServiceCategory;

// "Start here" band — the category's head-term HUB (pillar overview), surfaced
// above the body so it takes the page's top internal link and gives readers a
// canonical entry point. Resolve from the already-locale-filtered `articles`
// (so we get this locale's title/summary, and only show it when published &
// present). Falls back silently when a category has no hub.
const hub = (() => {
  const slug = hubSlug(category.id);
  if (!slug) return undefined;
  return articles.find((a) => a.data.slug === slug);
})();
const hubColor = getCategoryColor(category.id);

// Most-read + Latest strips, but only on substantial categories — on a short one
// the strips would just repeat the list the body shows right below. Latest
// excludes the Most-read picks so the two strips never overlap.
const STRIP = 4;
const MIN_FOR_STRIPS = 12;
const showStrips = articles.length >= MIN_FOR_STRIPS;
const mrKeys = showStrips ? mostReadKeys(articles, STRIP) : [];
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム', '홈', 'หน้าแรก', 'Trang chủ', 'Beranda', 'الصفحة الرئيسية', 'होम', 'Inicio', 'Accueil'), href: localePath('/', locale) },
    ...(pillarDef ? [{ label: loc(pillarDef.name, locale), href: localePath(`/${pillar}`, locale) }] : []),
    { label: loc(category.name, locale) },
  ]}
  title={loc(category.name, locale)}
  desc={loc(category.blurb, locale)}
  stats={heroStats}
/>

{
  hub && (
    <section class="container block">
      <a
        class="hub-band"
        href={localePath(`/${hub.data.category}/${hub.data.slug}`, locale)}
        style={`--c:${hubColor}`}
      >
        <span class="bar" aria-hidden="true" />
        <span class="hub-band__text">
          <span class="hub-band__eyebrow">
            {L('Mula di sini', 'Start here', '从这里开始', 'இங்கே தொடங்குங்கள்', 'ここから始める', '여기서 시작하기', 'เริ่มต้นที่นี่', 'Bắt đầu tại đây', 'Mulai di sini', 'ابدأ من هنا', 'यहाँ से शुरू करें', 'Empieza aquí', 'Commencez ici')}
          </span>
          <span class="hub-band__title">{hub.data.title}</span>
          {hub.data.summary && <span class="hub-band__summary">{hub.data.summary}</span>}
        </span>
        <span class="hub-band__cue dirx" aria-hidden="true">→</span>
      </a>
    </section>
  )
}

<Body locale={locale} category={category} articles={articles} />

{pillar && <HubGroups locale={locale} pillar={pillar} activeCategory={category.id} topSeparator />}

{
  showStrips && (
    <>
      <ArticleStrip locale={locale} articles={articles} moreHref={`/articles?cat=${category.id}&sort=latest`} sort="recent" limit={STRIP} exclude={mrKeys} />
      <ArticleStrip locale={locale} articles={articles} moreHref={`/articles?cat=${category.id}&sort=most-read`} limit={STRIP} />
    </>
  )
}

<style>
  /* "Start here" band — the category's head-term hub, given the prime slot above
     the topic body. A single wide card: category-coloured accent bar, an all-caps
     eyebrow, the hub title, and the summary. Reuses the site's surface/line tokens
     so it reads as part of the section-box family. */
  .hub-band {
    display: flex; align-items: stretch; gap: 0;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 12px; overflow: hidden; text-decoration: none; color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .hub-band:hover {
    border-color: var(--c, var(--gold));
    box-shadow: 0 0 0 1px var(--c, var(--gold)) inset;
  }
  .hub-band .bar {
    flex: 0 0 4px; align-self: stretch; background: var(--c, var(--gold));
  }
  .hub-band__text {
    display: flex; flex-direction: column; gap: 0.3rem;
    padding: 1rem 1.15rem; min-width: 0; flex: 1 1 auto;
  }
  .hub-band__eyebrow {
    font-size: 0.66rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--c, var(--gold));
  }
  .hub-band__title {
    font-family: var(--font-title); font-size: 1.2rem; font-weight: 700; line-height: 1.25;
    color: var(--ink);
  }
  .hub-band__summary {
    font-size: 0.92rem; line-height: 1.5; color: var(--muted);
  }
  .hub-band__cue {
    display: flex; align-items: center; padding: 0 1.15rem; flex: 0 0 auto;
    font-size: 1.3rem; color: var(--c, var(--gold));
    transition: transform 0.15s ease;
  }
  .hub-band:hover .hub-band__cue { transform: translateX(3px); }
  :global([dir='rtl']) .hub-band:hover .hub-band__cue { transform: translateX(-3px); }
</style>
