---
import type { Locale, Category } from '@/lib/categories';
import { getPillar, getPillarDef, categoriesInPillar, PILLARS } from '@/lib/categories';
import type { Article } from '@/lib/content';
import { mostReadKeys } from '@/lib/apidata';
import { localePath } from '@/lib/i18n';
import PageHero from './PageHero.astro';
import HubGroups from './HubGroups.astro';
import ArticleStrip from './ArticleStrip.astro';

import ServiceCategory from './category/ServiceCategory.astro';

// Category pages share one skeleton — purpose line, scoped search, then an
// ARCHETYPE BODY that changes with the kind of knowledge the category holds.
// Readers learn the pattern once; only the middle differs.

interface Props {
  locale: Locale;
  category: Category;
  articles: Article[];
}
const { locale, category, articles } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

const pillar = getPillar(category.id);
const pillarDef = pillar ? getPillarDef(pillar) : undefined;
const topicCount = new Set(articles.flatMap((a) => a.data.subcategory)).size;
// Follow the section-page hero: Sections (site total) · Categories (siblings in
// this section) · Topics · Articles.
const catCount = pillar ? categoriesInPillar(pillar).length : 0;

// Hero stats: drop the "categories" tile for a category with no parent pillar,
// rather than showing a meaningless "0 categories".
const heroStats = [
  { value: PILLARS.length, label: L('seksyen', 'sections', '版块') },
  ...(pillar ? [{ value: catCount, label: L('kategori', 'categories', '分类') }] : []),
  { value: topicCount, label: L('subkategori', 'subcategories', '子分类') },
  { value: articles.length, label: L('topik', 'topics', '主题') },
];

// Every category uses the service archetype now — one uniform, scalable body.
const Body = ServiceCategory;

// Most-read + Latest strips, but only on substantial categories — on a short one
// the strips would just repeat the list the body shows right below. Latest
// excludes the Most-read picks so the two strips never overlap.
const STRIP = 4;
const MIN_FOR_STRIPS = 12;
const showStrips = articles.length >= MIN_FOR_STRIPS;
const mrKeys = showStrips ? mostReadKeys(articles, STRIP) : [];
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页'), href: localePath('/', locale) },
    ...(pillarDef ? [{ label: pillarDef.name[locale], href: localePath(`/${pillar}`, locale) }] : []),
    { label: category.name[locale] },
  ]}
  title={category.name[locale]}
  desc={category.blurb[locale]}
  stats={heroStats}
/>

<Body locale={locale} category={category} articles={articles} />

{pillar && <HubGroups locale={locale} pillar={pillar} activeCategory={category.id} topSeparator />}

{
  showStrips && (
    <>
      <ArticleStrip locale={locale} articles={articles} moreHref={`/articles?cat=${category.id}&sort=latest`} sort="recent" limit={STRIP} exclude={mrKeys} />
      <ArticleStrip locale={locale} articles={articles} moreHref={`/articles?cat=${category.id}&sort=most-read`} limit={STRIP} />
    </>
  )
}
