---
import type { Locale } from '@/lib/categories';
import { getCategory, getPillarDef, loc } from '@/lib/categories';
import { localePath } from '@/lib/i18n';
import { articlesForLocale } from '@/lib/content';
import { STATES } from '@/lib/holidays/data';
import PageHero from './PageHero.astro';
import ArticleList from './ArticleList.astro';
import michelin from '@/data/collections/michelin.json';

// MICHELIN Guide Malaysia — the collection hub, built ON the shared article-list
// department template (ArticleList) with collection-specific facets (Award / State
// / Price / Edition) and a card (grid) layout. The restaurants ARE articles, so we
// pass the 70 restaurant articles to ArticleList and enrich each row with its
// MICHELIN facts from src/data/collections/michelin.json.

interface Props { locale: Locale; }
const { locale } = Astro.props;
// prettier-ignore
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string, ar?: string, hi?: string, es?: string, fr?: string) => (locale === 'fr' ? (fr ?? en) : locale === 'es' ? (es ?? en) : locale === 'hi' ? (hi ?? en) : locale === 'ar' ? (ar ?? en) : locale === 'id' ? (id ?? en) : locale === 'vi' ? (vi ?? en) : locale === 'th' ? (th ?? en) : locale === 'ko' ? (ko ?? en) : locale === 'ja' ? (ja ?? en) : locale === 'ta' ? (ta ?? en) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

type Dist = 'three-star' | 'two-star' | 'star' | 'bib-gourmand' | 'selected';
interface Row { slug: string; distinction: Dist; greenStar: boolean; price: string | null; state: string | null; city: string | null; year: number; }
const rows = michelin.restaurants as Row[];

const GROUP = (d: Dist): 'stars' | 'bib' | 'selected' => (d === 'bib-gourmand' ? 'bib' : d === 'selected' ? 'selected' : 'stars');
const lblSelected = L('Terpilih', 'Selected', '推荐', 'தேர்ந்தெடுக்கப்பட்டது', 'セレクテッド', '셀렉티드', 'คัดสรร', 'Selected', 'Terpilih', 'مختارات', 'चयनित', 'Seleccionado', 'Sélectionné');
function badgeLabel(d: Dist): string {
  if (d === 'three-star') return '★★★ MICHELIN';
  if (d === 'two-star') return '★★ MICHELIN';
  if (d === 'star') return '★ MICHELIN';
  if (d === 'bib-gourmand') return 'Bib Gourmand';
  return lblSelected;
}
const stateName = (id: string | null): string => {
  if (!id) return '';
  const s = STATES.find((x) => x.id === id);
  return s ? ((s.name as Record<string, string>)[locale] ?? s.name.en) : id;
};

// Resolve the restaurant articles (one scan) in MICHELIN rank order.
const bySlug = new Map(
  (await articlesForLocale(locale)).filter((a) => a.data.category === 'food-lifestyle').map((a) => [a.data.slug, a]),
);
const mBySlug = Object.fromEntries(rows.map((r) => [r.slug, r]));
const restaurants = rows.map((r) => bySlug.get(r.slug)).filter((a): a is NonNullable<typeof a> => Boolean(a));

const starred = rows.filter((r) => GROUP(r.distinction) === 'stars').length;
const bibs = rows.filter((r) => GROUP(r.distinction) === 'bib').length;

// Labels.
const lblAward = L('Anugerah', 'Award', '奖项', 'விருது', '受賞', '상', 'รางวัล', 'Giải thưởng', 'Penghargaan', 'الجائزة', 'पुरस्कार', 'Distinción', 'Distinction');
const lblState = L('Negeri', 'State', '州属', 'மாநிலம்', '州', '주', 'รัฐ', 'Bang', 'Negara bagian', 'الولاية', 'राज्य', 'Estado', 'État');
const lblPrice = L('Harga', 'Price', '价格', 'விலை', '価格', '가격', 'ราคา', 'Giá', 'Harga', 'السعر', 'कीमत', 'Precio', 'Prix');
const lblYear = L('Edisi', 'Edition', '版本', 'பதிப்பு', '版', '에디션', 'ฉบับ', 'Phiên bản', 'Edisi', 'الإصدار', 'संस्करण', 'Edición', 'Édition');
const lblStars = L('Bintang', 'Stars', '星级', 'நட்சத்திரம்', '星', '스타', 'ดาว', 'Sao', 'Bintang', 'النجوم', 'स्टार', 'Estrellas', 'Étoiles');

// Facet options present in the data (so no empty filters).
const groupsPresent = [...new Set(rows.map((r) => GROUP(r.distinction)))];
const statesPresent = [...new Set(rows.map((r) => r.state).filter(Boolean))] as string[];
const pricesPresent = [...new Set(rows.map((r) => r.price).filter(Boolean))].sort((a, b) => (a as string).length - (b as string).length) as string[];
const yearsPresent = [...new Set(rows.map((r) => r.year))].sort((a, b) => b - a);

const awardOpt = [
  { value: 'stars', label: `★ ${lblStars}` },
  { value: 'bib', label: 'Bib Gourmand' },
  { value: 'selected', label: lblSelected },
].filter((o) => groupsPresent.includes(o.value as 'stars' | 'bib' | 'selected'));

const facets = [
  { key: 'award', label: lblAward, options: awardOpt },
  ...(statesPresent.length > 1 ? [{ key: 'mstate', label: lblState, options: statesPresent.map((s) => ({ value: s, label: stateName(s) })) }] : []),
  ...(pricesPresent.length > 1 ? [{ key: 'mprice', label: lblPrice, options: pricesPresent.map((p) => ({ value: p, label: p })) }] : []),
  { key: 'medition', label: lblYear, options: yearsPresent.map((y) => ({ value: String(y), label: String(y) })) },
];

// Per-article enrichment: facet values + the card badge.
const enrich = (a: { data: { slug: string } }): Record<string, string> => {
  const m = mBySlug[a.data.slug];
  if (!m) return {};
  return { award: GROUP(m.distinction), mstate: m.state ?? '', mprice: m.price ?? '', medition: String(m.year), badge: badgeLabel(m.distinction) };
};

const home = L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム', '홈', 'หน้าแรก', 'Trang chủ', 'Beranda', 'الصفحة الرئيسية', 'होम', 'Inicio', 'Accueil');
const livingPillar = getPillarDef('living');
const flCat = getCategory('food-lifestyle');
const title = L('Panduan MICHELIN', 'MICHELIN Guide', '米其林指南', 'MICHELIN வழிகாட்டி', 'ミシュランガイド', '미쉐린 가이드', 'มิชลินไกด์', 'Cẩm nang MICHELIN', 'Panduan MICHELIN', 'دليل ميشلان', 'मिशेलिन गाइड', 'Guía MICHELIN', 'Guide MICHELIN');
const lede = L(
  'Setiap restoran Malaysia yang kami liputi dalam pilihan Panduan MICHELIN — bintang, Bib Gourmand dan terpilih — di Kuala Lumpur, Pulau Pinang dan seterusnya. Tapis mengikut anugerah, negeri, harga dan edisi.',
  'Every Malaysian restaurant we cover in the MICHELIN Guide selection — Stars, Bib Gourmand and Selected — across Kuala Lumpur, Penang and beyond. Filter by award, state, price and edition.',
  '我们收录的所有马来西亚米其林指南餐厅——星级、必比登和入选——涵盖吉隆坡、槟城及其他地区。可按奖项、州属、价格与版本筛选。',
  'MICHELIN வழிகாட்டித் தேர்வில் நாங்கள் உள்ளடக்கிய ஒவ்வொரு மலேசிய உணவகமும் — நட்சத்திரம், Bib Gourmand, தேர்ந்தெடுக்கப்பட்டவை. விருது, மாநிலம், விலை, பதிப்பு வாரியாக வடிகட்டவும்.',
  'クアラルンプール、ペナンなど、ミシュランガイドの選定に入る当サイト掲載のマレーシア料理店すべて。受賞・州・価格・版で絞り込めます。',
  '쿠알라룸푸르, 페낭 등 미쉐린 가이드에 선정된, 우리가 다루는 모든 말레이시아 레스토랑. 상·주·가격·에디션으로 필터링하세요.',
  'ร้านอาหารมาเลเซียทุกแห่งที่เรารวบรวมไว้ในการคัดเลือกของมิชลินไกด์ ทั่วกัวลาลัมเปอร์ ปีนัง และอื่น ๆ กรองตามรางวัล รัฐ ราคา และฉบับ',
  'Mọi nhà hàng Malaysia chúng tôi giới thiệu trong tuyển chọn Cẩm nang MICHELIN khắp Kuala Lumpur, Penang và hơn thế. Lọc theo giải thưởng, bang, giá và phiên bản.',
  'Setiap restoran Malaysia yang kami bahas dalam pilihan Panduan MICHELIN di Kuala Lumpur, Penang, dan sekitarnya. Saring menurut penghargaan, wilayah, harga, dan edisi.',
  'كل مطعم ماليزي نغطيه ضمن اختيار دليل ميشلان في كوالالمبور وبينانغ وغيرها. صفِّ حسب الجائزة والولاية والسعر والإصدار.',
  'मिशेलिन गाइड चयन में हमारे द्वारा कवर किया गया हर मलेशियाई रेस्तरां — कुआलालंपुर, पेनांग व अन्य। पुरस्कार, राज्य, कीमत व संस्करण अनुसार छाँटें।',
  'Cada restaurante malayo que cubrimos en la selección de la Guía MICHELIN en Kuala Lumpur, Penang y más. Filtra por distinción, estado, precio y edición.',
  'Chaque restaurant malaisien que nous couvrons dans la sélection du Guide MICHELIN à Kuala Lumpur, Penang et au-delà. Filtrez par distinction, état, prix et édition.',
);

const statRestaurants = L('Restoran', 'Restaurants', '餐厅', 'உணவகங்கள்', 'レストラン', '레스토랑', 'ร้านอาหาร', 'Nhà hàng', 'Restoran', 'مطاعم', 'रेस्तरां', 'Restaurantes', 'Restaurants');
const lblExplainer = L('Apa itu Panduan MICHELIN?', 'What is the MICHELIN Guide?', '什么是米其林指南？', 'MICHELIN வழிகாட்டி என்றால் என்ன?', 'ミシュランガイドとは？', '미쉐린 가이드란?', 'มิชลินไกด์คืออะไร?', 'Cẩm nang MICHELIN là gì?', 'Apa itu Panduan MICHELIN?', 'ما هو دليل ميشلان؟', 'मिशेलिन गाइड क्या है?', '¿Qué es la Guía MICHELIN?', 'Qu’est-ce que le Guide MICHELIN ?');
const revisionNote = L(
  'Pilihan MICHELIN disemak setiap tahun. Sahkan status semasa sesebuah restoran di Panduan MICHELIN rasmi sebelum melawat.',
  'The MICHELIN selection is revised each year. Confirm a restaurant’s current status on the official MICHELIN Guide before visiting.',
  '米其林榜单每年更新。前往前请在米其林官方指南确认餐厅的最新状态。',
  'MICHELIN தேர்வு ஒவ்வொரு ஆண்டும் திருத்தப்படும். பார்வையிடும் முன் அதிகாரப்பூர்வ MICHELIN வழிகாட்டியில் தற்போதைய நிலையை உறுதிப்படுத்தவும்.',
  'ミシュランの選定は毎年改訂されます。訪問前に公式ミシュランガイドで最新の状態をご確認ください。',
  '미쉐린 선정은 매년 개정됩니다. 방문 전 공식 미쉐린 가이드에서 최신 상태를 확인하세요.',
  'การคัดเลือกของมิชลินมีการปรับปรุงทุกปี โปรดยืนยันสถานะล่าสุดในมิชลินไกด์ทางการก่อนไป',
  'Tuyển chọn MICHELIN được sửa đổi hằng năm. Hãy xác nhận trạng thái hiện tại trên Cẩm nang MICHELIN chính thức trước khi đến.',
  'Pilihan MICHELIN direvisi setiap tahun. Konfirmasikan status terkini sebuah restoran di Panduan MICHELIN resmi sebelum berkunjung.',
  'يُراجَع اختيار ميشلان كل عام. تأكد من الحالة الحالية للمطعم في دليل ميشلان الرسمي قبل الزيارة.',
  'मिशेलिन चयन हर साल संशोधित होता है। जाने से पहले आधिकारिक मिशेलिन गाइड पर रेस्तरां की मौजूदा स्थिति की पुष्टि करें।',
  'La selección MICHELIN se revisa cada año. Confirma el estado actual de un restaurante en la Guía MICHELIN oficial antes de visitarlo.',
  'La sélection MICHELIN est révisée chaque année. Vérifiez le statut actuel d’un restaurant sur le Guide MICHELIN officiel avant de vous y rendre.',
);
const explainerHref = localePath('/food-lifestyle/michelin-guide-malaysia', locale);
---

<PageHero
  locale={locale}
  crumb={[
    { label: home, href: localePath('/', locale) },
    ...(livingPillar ? [{ label: loc(livingPillar.name, locale), href: localePath('/living', locale) }] : []),
    ...(flCat ? [{ label: loc(flCat.name, locale), href: localePath('/food-lifestyle', locale) }] : []),
    { label: title },
  ]}
  title={title}
  desc={lede}
  stats={[
    { value: restaurants.length, label: statRestaurants, icon: '🍜' },
    { value: starred, label: lblStars, icon: '★' },
    { value: bibs, label: 'Bib Gourmand', icon: '🏅' },
  ]}
/>

<section class="container block mich-intro">
  <a class="mich-explainer" href={explainerHref}>{lblExplainer} →</a>
  <p class="mich-note">{revisionNote}</p>
</section>

<ArticleList locale={locale} articles={restaurants} filters={[]} facets={facets} enrich={enrich} layout="grid" />

<style>
  .mich-intro { padding-top: 0; }
  .mich-explainer { font-weight: 700; color: var(--gold); text-decoration: none; font-size: 0.95rem; }
  .mich-explainer:hover { text-decoration: underline; }
  .mich-note { margin: 0.4rem 0 0; color: var(--muted); font-size: 0.82rem; max-width: 70ch; line-height: 1.5; }
</style>
