---
import type { Locale } from '@/lib/categories';
import { getDashboard } from '@/lib/apidata';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = getDashboard();
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

// The organism has four loops. Two run today; two cannot run until the site is
// live and a human reviewer exists. We draw all four and mark the dormant ones
// dormant — a diagram that claims a loop we do not have is the same defect as a
// dashboard reporting a metric nobody computes.
const loops = [
  {
    id: 'verify',
    state: 'live',
    name: L('Gelung pengesahan', 'The verification loop', '验证回路'),
    body: L(
      'Sumber rasmi disahkan sekali, direkod dalam VERIFIED-SOURCES.md, dan setiap penulis seterusnya membacanya dahulu. Apa yang ditemui semasa menulis kembali ke fail itu.',
      'An official source is verified once, recorded in VERIFIED-SOURCES.md, and every later writer reads it first. What writing uncovers goes back into that file.',
      '官方来源经一次核实后记入 VERIFIED-SOURCES.md，之后每位撰稿者先读它。写作中的新发现再回流该文件。',
    ),
  },
  {
    id: 'gate',
    state: 'live',
    name: L('Gelung gerbang mutu', 'The quality-gate loop', '质量闸回路'),
    body: L(
      'scan.py menguji setiap artikel terhadap piawai yang boleh diperiksa mesin. Setiap kegagalan baharu menjadi pemeriksaan baharu, jadi kesilapan yang sama tidak berulang.',
      'scan.py tests every article against machine-checkable standards. Each new class of failure becomes a new check, so the same mistake cannot recur.',
      'scan.py 以可机检标准测试每篇文章。每类新故障都会变成新检查，同样的错误不会再发生。',
    ),
  },
  {
    id: 'review',
    state: 'dormant',
    name: L('Gelung semakan manusia', 'The human-review loop', '人工审阅回路'),
    body: L(
      'Tiada nama dalam reviewers.txt, jadi tiada artikel boleh ditanda disemak. Ini menyekat penerbitan kandungan sensitif — gerbang itu berfungsi seperti yang direka.',
      'reviewers.txt is empty, so no article can be marked reviewed. This blocks sensitive content from publishing at all — the gate working exactly as designed.',
      'reviewers.txt 为空，因此没有文章可标记为已审阅。敏感内容因此无法发布——闸门正按设计运作。',
    ),
  },
  {
    id: 'decay',
    state: 'pending',
    name: L('Gelung pereputan', 'The decay loop', '衰变回路'),
    body: L(
      'Setiap kadar dan ambang yang kami terbitkan mempunyai tarikh luput. Gelung ini bermula sendiri pada hari kami siar — sama ada kami menguruskannya atau tidak.',
      'Every rate and threshold we publish has an expiry. This loop starts by itself the day we go live — whether or not we manage it.',
      '我们发布的每个税率与门槛都有失效日。此回路会在上线当天自行启动——无论我们是否管理它。',
    ),
  },
];

const stages = [
  {
    when: L('Sebelum siar', 'Before launch', '上线前'),
    now: true,
    items: [
      L('Namakan sekurang-kurangnya seorang penyemak', 'Name at least one reviewer', '指定至少一位审阅者'),
      L('Terjemah ms + zh (kini bahasa Inggeris sahaja)', 'Translate ms + zh (English-only today)', '翻译 ms + zh（目前仅英文）'),
      L('Tandai tarikh luput pada angka bertarikh', 'Stamp expiry dates on dated figures', '为带日期的数字标注失效日'),
    ],
  },
  {
    when: L('Pada hari siar', 'At launch', '上线当天'),
    now: false,
    items: [
      L('Gelung pereputan bermula secara automatik', 'The decay loop starts automatically', '衰变回路自动启动'),
      L('Trafik dan analitik mula terkumpul', 'Traffic and analytics begin accruing', '流量与分析开始累积'),
      L('Kandungan mula disalin oleh model AI', 'Content starts being ingested by AI models', '内容开始被 AI 模型采集'),
    ],
  },
  {
    when: L('Selepas siar', 'After launch', '上线后'),
    now: false,
    items: [
      L('Buka sumbangan luar — selepas tadbir urus ditetapkan', 'Open outside contribution — after governance exists', '开放外部贡献——须先有治理机制'),
      L('Pembetulan pembaca kembali ke VERIFIED-SOURCES', 'Reader corrections feed back to VERIFIED-SOURCES', '读者更正回流 VERIFIED-SOURCES'),
      L('Kitaran semakan berjadual mengikut tarikh luput', 'Scheduled re-verification driven by expiry dates', '按失效日驱动的定期复核'),
    ],
  },
];
---

<section class="container head">
  <p class="kicker">🧬 {L('Semiont', 'Semiont', 'Semiont')}</p>
  <h1>{L('Organisma ini belum bernafas', 'This organism is not breathing yet', '这个有机体尚未呼吸')}</h1>
  <p class="lead">
    {L(
      'NegaraKu.md dibina sebagai sistem hidup: sumber disahkan, digerbang, disiar, lalu mereput dan disahkan semula. Dua daripada empat gelung itu sudah berjalan. Dua lagi menunggu kami siar.',
      'NegaraKu.md is built as a living system: sources verified, gated, published, then decaying and re-verified. Two of its four loops already run. The other two are waiting on launch.',
      'NegaraKu.md 被构建为一个活系统：来源经核实、过闸、发布，然后衰变并重新核实。四个回路中已有两个在运行，另两个正等待上线。',
    )}
  </p>
</section>

<section class="container">
  <h2>{L('Keseluruhan organisma bergerak', 'The whole organism in motion', '整个有机体的运转')}</h2>
  <p class="note">
    {L(
      'Garisan pejal berjalan hari ini. Garisan putus belum wujud — ia dilukis supaya ketiadaannya kelihatan.',
      'Solid arcs run today. Dashed arcs do not exist yet — they are drawn so that their absence is visible.',
      '实线今日运行。虚线尚不存在——画出来是为了让缺失可见。',
    )}
  </p>

  <div class="figure">
    <svg viewBox="0 0 760 380" role="img" aria-label={L('Rajah gelung organisma', 'Organism loop diagram', '有机体回路图')}>
      <defs>
        <marker id="ah" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto">
          <path d="M0,0 L7,3 L0,6 Z" fill="var(--gold)" />
        </marker>
        <marker id="ah-off" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto">
          <path d="M0,0 L7,3 L0,6 Z" fill="var(--muted)" />
        </marker>
      </defs>

      <!-- live spine: sources -> writers -> gate -> corpus -->
      <g class="node live">
        <rect x="24" y="150" width="148" height="62" rx="10" />
        <text x="98" y="175">{L('Sumber rasmi', 'Official sources', '官方来源')}</text>
        <text x="98" y="194" class="sub">VERIFIED-SOURCES.md</text>
      </g>
      <g class="node live">
        <rect x="216" y="150" width="140" height="62" rx="10" />
        <text x="286" y="175">{L('Penulis selari', 'Parallel writers', '并行撰稿')}</text>
        <text x="286" y="194" class="sub">{L('agen', 'agents', '代理')}</text>
      </g>
      <g class="node live">
        <rect x="400" y="150" width="140" height="62" rx="10" />
        <text x="470" y="175">{L('Gerbang mutu', 'Quality gate', '质量闸')}</text>
        <text x="470" y="194" class="sub">scan.py</text>
      </g>
      <g class="node live">
        <rect x="584" y="150" width="152" height="62" rx="10" />
        <text x="660" y="175">{L('Korpus', 'The corpus', '语料库')}</text>
        <text x="660" y="194" class="sub">{d.totals.articles} {L('artikel', 'articles', '篇')}</text>
      </g>

      <path class="edge live" d="M172,181 H210" marker-end="url(#ah)" />
      <path class="edge live" d="M356,181 H394" marker-end="url(#ah)" />
      <path class="edge live" d="M540,181 H578" marker-end="url(#ah)" />

      <!-- live return: corpus discoveries back into sources -->
      <path class="edge live" d="M660,150 V96 Q660,80 640,80 H118 Q98,80 98,96 V144" marker-end="url(#ah)" />
      <text class="lbl live" x="379" y="70">
        {L('penemuan semasa menulis', 'discoveries made while writing', '写作中的发现')}
      </text>

      <!-- gate rejection back to writers -->
      <path class="edge live" d="M470,212 V244 Q470,258 452,258 H304 Q286,258 286,244 V216" marker-end="url(#ah)" />
      <text class="lbl live" x="378" y="276">{L('kegagalan jadi pemeriksaan baharu', 'failures become new checks', '故障化为新检查')}</text>

      <!-- dormant: human review -->
      <g class="node off">
        <rect x="400" y="304" width="140" height="52" rx="10" />
        <text x="470" y="326">{L('Semakan manusia', 'Human review', '人工审阅')}</text>
        <text x="470" y="344" class="sub">{L('tiada penyemak', 'no reviewer', '暂无审阅者')}</text>
      </g>
      <path class="edge off" d="M584,190 Q560,330 546,330" marker-end="url(#ah-off)" />

      <!-- dormant: readers -->
      <g class="node off">
        <rect x="24" y="304" width="148" height="52" rx="10" />
        <text x="98" y="326">{L('Pembaca', 'Readers', '读者')}</text>
        <text x="98" y="344" class="sub">{L('belum siar', 'not live yet', '尚未上线')}</text>
      </g>
      <path class="edge off" d="M98,304 V216" marker-end="url(#ah-off)" />
      <path class="edge off" d="M584,200 Q340,240 180,326" marker-end="url(#ah-off)" />
    </svg>
  </div>
</section>

<section class="container">
  <h2>{L('Empat gelung', 'The four loops', '四个回路')}</h2>
  <div class="loops">
    {
      loops.map((l) => (
        <div class={`loop card ${l.state}`}>
          <p class="state">
            {l.state === 'live'
              ? L('berjalan', 'running', '运行中')
              : l.state === 'dormant'
                ? L('tersekat', 'blocked', '受阻')
                : L('bermula pada siaran', 'starts at launch', '上线时启动')}
          </p>
          <h3>{l.name}</h3>
          <p>{l.body}</p>
        </div>
      ))
    }
  </div>
</section>

<section class="container">
  <h2>{L('Pengurusan kitaran hayat', 'Lifecycle management', '生命周期管理')}</h2>
  <p class="note">
    {L(
      'Gelung tidak dihidupkan serentak. Dua daripadanya mesti dibina sebelum siaran, atau ia tidak akan dibina langsung.',
      'The loops do not switch on together. Two of them must be built before launch, or they never get built at all.',
      '这些回路不会同时开启。其中两个必须在上线前建成，否则将永远不会建成。',
    )}
  </p>
  <div class="stages">
    {
      stages.map((s) => (
        <div class={`stage card ${s.now ? 'now' : ''}`}>
          <p class="when">
            {s.when}
            {s.now && <span class="pin">{L('kita di sini', 'we are here', '当前阶段')}</span>}
          </p>
          <ul>
            {s.items.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .head {
    padding-block: 2.5rem 1rem;
  }
  .kicker {
    color: var(--gold);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin: 0 0 0.4rem;
  }
  .lead {
    color: var(--ink-soft);
    max-width: 62ch;
  }
  .note {
    color: var(--muted);
    max-width: 68ch;
    margin-top: -0.4rem;
  }
  .figure {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1rem;
    margin: 1rem 0 2rem;
  }
  svg {
    display: block;
    min-width: 700px;
    width: 100%;
    height: auto;
  }
  .node rect {
    fill: var(--surface, #12121a);
    stroke: var(--gold);
  }
  .node.off rect {
    stroke: var(--muted);
    stroke-dasharray: 5 4;
  }
  .node text {
    fill: var(--ink);
    font-size: 13px;
    font-weight: 600;
    text-anchor: middle;
  }
  .node.off text {
    fill: var(--muted);
    font-weight: 500;
  }
  .node .sub {
    font-size: 11px;
    font-weight: 400;
    fill: var(--muted);
  }
  .edge {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1.6;
  }
  .edge.off {
    stroke: var(--muted);
    stroke-dasharray: 6 5;
    stroke-width: 1.3;
  }
  .lbl {
    font-size: 11px;
    fill: var(--muted);
    text-anchor: middle;
  }
  .loops,
  .stages {
    display: grid;
    gap: 1rem;
    margin-block: 1rem 2.5rem;
  }
  .loops {
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .stages {
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .card {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1rem 1.1rem;
  }
  .loop h3 {
    margin: 0.2rem 0 0.5rem;
    font-size: 1.02rem;
  }
  .loop p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.94rem;
  }
  .state {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin: 0;
    color: var(--muted);
  }
  .loop.live {
    border-color: color-mix(in srgb, var(--green) 45%, var(--line));
  }
  .loop.live .state {
    color: var(--green);
  }
  .loop.dormant {
    border-color: color-mix(in srgb, var(--red) 40%, var(--line));
  }
  .loop.dormant .state {
    color: var(--red);
  }
  .loop.pending .state {
    color: var(--amber);
  }
  .stage.now {
    border-color: var(--gold);
  }
  .when {
    font-weight: 700;
    margin: 0 0 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .pin {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--bg);
    background: var(--gold);
    border-radius: 99px;
    padding: 0.12rem 0.5rem;
  }
  .stage ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-soft);
  }
  .stage li {
    margin-bottom: 0.35rem;
    font-size: 0.94rem;
  }
</style>
