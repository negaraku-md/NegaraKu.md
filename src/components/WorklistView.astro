  .wl-sec > header b { color: var(--gold); margin-inline-start: 0.35rem; font-variant-numeric: tabular-nums; }
  .wl-hint { font-size: 0.8rem; color: var(--muted); }
  .wl-empty { margin: 0; padding: 0.9rem 1.05rem; color: var(--ink-soft); font-size: 0.9rem; }
  .wl-sec ul { list-style: none; margin: 0; padding: 0.4rem; display: flex; flex-direction: column; }
  .wl-sec li {
