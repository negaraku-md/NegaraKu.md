---
import type { Locale } from '@/lib/categories';
import { getCategory, loc } from '@/lib/categories';
import { corpusTopics, effectiveStatus, articleKey, type Article } from '@/lib/content';
import { getAnalytics } from '@/lib/apidata';
import { REPO } from '@/lib/site';
import { localePath } from '@/lib/i18n';
import PageHero from './PageHero.astro';

// EDITORIAL WORKLIST (lifecycle spec §11). A contributor surface: the three
// queues (needs-update / redraft-requested / archive-requested), work in
// progress with its assignee, items awaiting approval (four-eyes), and drafts.
// Reads the OPS census (corpusTopics — every status, past the publish gate), so
// it lists titles that are NOT public. It therefore renders ONLY in the dev /
// preview environment; on the public build it shows a short notice instead.

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string, ar?: string, hi?: string, es?: string, fr?: string) => (locale === 'fr' ? (fr ?? ms) : locale === 'es' ? (es ?? ms) : locale === 'hi' ? (hi ?? ms) : locale === 'ar' ? (ar ?? ms) : locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

const CONTRIB_ONLY = import.meta.env.DEV || process.env.PREVIEW_ALL === '1';

const topics: Article[] = CONTRIB_ONLY ? await corpusTopics() : [];
const now = new Date();
const DAY = 86_400_000;
const SOON_DAYS = 45; // "due soon" lead time — matches scripts/build-review-queue.mjs
const st = (a: Article) => effectiveStatus(a, now);
const editUrl = (a: Article) => `${REPO}/edit/main/knowledge/${a.data.category}/${a.data.slug}.md`;
const ageDays = (d: unknown) => (d ? Math.max(0, Math.round((now.getTime() - new Date(d as string).getTime()) / DAY)) : null);
const worker = (a: Article) => a.data.assignee || a.data.revisions?.at(-1)?.contributor || a.data.author || '—';
const catName = (a: Article) => { const c = getCategory(a.data.category); return c ? loc(c.name, locale) : a.data.category; };

// Traffic signal for prioritization — refresh the most-read, most-overdue first.
const analytics = CONTRIB_ONLY ? getAnalytics() : {};
const readersOf = (a: Article) => { const r = analytics[articleKey(a)]?.readers; return typeof r === 'number' ? r : (r?.total ?? 0); };
const daysTo = (d: unknown) => (d ? Math.round((new Date(d as string).getTime() - now.getTime()) / DAY) : null); // <0 overdue
const overdueDays = (a: Article) => { const n = daysTo(a.data.reviewDue); return n != null && n < 0 ? -n : 0; };
const untilDue = (a: Article) => { const n = daysTo(a.data.reviewDue); return n != null && n > 0 ? n : 0; };
const priority = (a: Article) => Math.round((readersOf(a) + 1) * (1 + overdueDays(a) / 30));

const needsUpdate = topics
  .filter((a) => st(a) === 'needs-update')
  .sort((x, y) => priority(y) - priority(x)); // value-ranked: readership × how overdue
// Forward-looking: published, review not yet due but within the horizon.
const dueSoon = topics
  .filter((a) => a.data.status === 'published' && st(a) === 'published' && a.data.reviewDue)
  .filter((a) => { const n = daysTo(a.data.reviewDue); return n != null && n > 0 && n <= SOON_DAYS; })
  .sort((x, y) => untilDue(x) - untilDue(y) || readersOf(y) - readersOf(x));
const reqRedraft = topics.filter((a) => a.data.status === 'request-redraft');
const reqArchive = topics.filter((a) => a.data.status === 'request-archive');
const inProgress = topics.filter((a) => ['in-update', 'in-redraft', 'in-archive', 'in-review'].includes(a.data.status));
const awaiting = topics.filter((a) => a.data.status === 'reviewed');
const drafts = topics.filter((a) => a.data.status === 'draft');
const archived = topics.filter((a) => a.data.status === 'archived');
// Healthy published (live, review not imminent) — the baseline the pipeline feeds.
const publishedLive = topics.filter((a) => a.data.status === 'published' && st(a) === 'published');

// Full lifecycle census — one glance across the whole pipeline.
const census = [
  { k: 'draft', n: drafts.length, label: L('Draf', 'Draft', '草稿', 'வரைவு', '下書き', '초안', 'ฉบับร่าง', 'Nháp', 'Draf', 'مسودة', 'ड्राफ्ट', 'Borrador', 'Brouillon') },
  { k: 'in-review', n: inProgress.filter((a) => a.data.status === 'in-review').length, label: L('Semakan', 'In review', '审阅中', 'மதிப்பாய்வில்', 'レビュー中', '검토 중', 'กำลังตรวจ', 'Đang duyệt', 'Ditinjau', 'قيد المراجعة', 'समीक्षाधीन', 'En revisión', 'En révision') },
  { k: 'reviewed', n: awaiting.length, label: L('Menunggu', 'Approval', '待批准', 'ஒப்புதல்', '承認待ち', '승인 대기', 'รออนุมัติ', 'Chờ duyệt', 'Persetujuan', 'موافقة', 'अनुमोदन', 'Aprobación', 'Approbation') },
  { k: 'published', n: publishedLive.length, label: L('Terbit', 'Published', '已发布', 'வெளியிட்டது', '公開', '게시됨', 'เผยแพร่', 'Đã đăng', 'Terbit', 'منشور', 'प्रकाशित', 'Publicado', 'Publié'), live: true },
  { k: 'due-soon', n: dueSoon.length, label: L('Akan tiba', 'Due soon', '即将到期', 'விரைவில்', 'まもなく', '곧 예정', 'ใกล้ครบ', 'Sắp đến hạn', 'Segera', 'قريبًا', 'जल्द देय', 'Pronto', 'Bientôt') },
  { k: 'needs-update', n: needsUpdate.length, label: L('Perlu kemas kini', 'Needs update', '需更新', 'புதுப்பிப்பு', '要更新', '업데이트', 'ต้องอัปเดต', 'Cần cập nhật', 'Perlu', 'تحديث', 'अपडेट', 'Actualizar', 'À mettre à jour') },
  { k: 'in-progress', n: topics.filter((a) => ['in-update', 'in-redraft', 'in-archive'].includes(a.data.status)).length, label: L('Dalam proses', 'In progress', '进行中', 'நடைபெறுகிறது', '作業中', '진행 중', 'ดำเนินการ', 'Đang làm', 'Proses', 'قيد العمل', 'प्रगति', 'En curso', 'En cours') },
  { k: 'archived', n: archived.length, label: L('Arkib', 'Archived', '已归档', 'காப்பகம்', 'アーカイブ', '보관됨', 'จัดเก็บ', 'Lưu trữ', 'Arsip', 'مؤرشف', 'संग्रहीत', 'Archivado', 'Archivé') },
];

// Assignee tally for the In-progress board (so no one double-claims).
const byAssignee: Record<string, number> = {};
for (const a of inProgress) {
  const k = a.data.assignee || L('belum dituntut', 'unclaimed', '未认领', 'உரிமை கொள்ளப்படவில்லை', '未割り当て', '미배정', 'ยังไม่มีผู้รับ', 'chưa nhận', 'belum diklaim', 'غير مُطالَب به', 'दावा न किया गया', 'sin reclamar', 'non pris en charge');
  byAssignee[k] = (byAssignee[k] || 0) + 1;
}
const assigneeSummary = Object.entries(byAssignee).map(([k, n]) => `${k}: ${n}`).join('  ·  ');

const stats = [
  { icon: '🔧', value: needsUpdate.length, label: L('perlu kemas kini', 'needs update', '需更新', 'புதுப்பிக்க வேண்டியவை', '要更新', '업데이트 필요', 'ต้องอัปเดต', 'cần cập nhật', 'perlu diperbarui', 'بحاجة إلى تحديث', 'अपडेट की आवश्यकता', 'requiere actualización', 'mise à jour requise') },
  { icon: '🗓️', value: dueSoon.length, label: L('akan disemak', 'due soon', '即将到期', 'விரைவில் மதிப்பாய்வு', 'まもなく要レビュー', '검토 임박', 'ใกล้ครบกำหนด', 'sắp đến hạn', 'segera ditinjau', 'مراجعة قريبة', 'जल्द समीक्षा', 'revisión próxima', 'révision proche') },
  { icon: '⏳', value: inProgress.length, label: L('dalam proses', 'in progress', '进行中', 'நடைபெறுகிறது', '進行中', '진행 중', 'กำลังดำเนินการ', 'đang tiến hành', 'dalam proses', 'قيد التنفيذ', 'प्रगति पर', 'en curso', 'en cours') },
  { icon: '⏰', value: awaiting.length, label: L('menunggu kelulusan', 'awaiting', '待批准', 'ஒப்புதலுக்குக் காத்திருக்கிறது', '承認待ち', '대기 중', 'รอดำเนินการ', 'chờ phê duyệt', 'menunggu persetujuan', 'في الانتظار', 'प्रतीक्षारत', 'en espera', 'en attente') },
];
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム', '홈', 'หน้าแรก', 'Trang chủ', 'Beranda', 'الرئيسية', 'मुख्य पृष्ठ', 'Inicio', 'Accueil'), href: localePath('/', locale) },
    { label: L('Senarai Kerja', 'Worklist', '工作清单', 'வேலைப்பட்டியல்', '作業リスト', '작업 목록', 'รายการงาน', 'Danh sách công việc', 'Daftar Kerja', 'قائمة العمل', 'कार्यसूची', 'Lista de trabajo', 'Liste de travail') },
  ]}
  title={L('Senarai Kerja Editorial', 'Editorial Worklist', '编辑工作清单', 'ஆசிரியர் வேலைப்பட்டியல்', '編集作業リスト', '편집 작업 목록', 'รายการงานบรรณาธิการ', 'Danh sách công việc biên tập', 'Daftar Kerja Editorial', 'قائمة العمل التحريرية', 'संपादकीय कार्यसूची', 'Lista de trabajo editorial', 'Liste de travail éditoriale')}
  desc={L(
    'Barisan kerja penyumbang — apa yang perlu dikemas kini, ditulis semula, diarkibkan atau diluluskan.',
    "The contributor queue — what needs updating, redrafting, archiving or approving.",
    '贡献者工作队列——需要更新、重写、归档或批准的内容。',
    'பங்களிப்பாளர் வேலை வரிசை — புதுப்பிக்க, மறுவரைவு செய்ய, காப்பகப்படுத்த அல்லது ஒப்புதலளிக்க வேண்டியவை.',
    '貢献者のキュー — 更新・書き直し・アーカイブ・承認が必要なもの。',
    '기여자 대기열 — 업데이트, 재작성, 보관 또는 승인이 필요한 항목.',
    'คิวงานของผู้มีส่วนร่วม — สิ่งที่ต้องอัปเดต เขียนใหม่ จัดเก็บถาวร หรืออนุมัติ',
    'Hàng đợi công việc của người đóng góp — những gì cần cập nhật, viết lại, lưu trữ hoặc phê duyệt.',
    'Antrean kerja kontributor — apa yang perlu diperbarui, ditulis ulang, diarsipkan, atau disetujui.',
    'قائمة عمل المساهمين — ما يحتاج إلى تحديث أو إعادة صياغة أو أرشفة أو موافقة.',
    'योगदानकर्ता कतार — जिसे अपडेट, पुनर्लेखन, संग्रह या अनुमोदन की आवश्यकता है।',
    'La cola de los colaboradores: lo que necesita actualización, reescritura, archivado o aprobación.',
    'La file des contributeurs : ce qui doit être mis à jour, réécrit, archivé ou approuvé.',
  )}
  stats={CONTRIB_ONLY ? stats : []}
/>

{
  !CONTRIB_ONLY && (
    <section class="container block">
      <div class="notice">
        <p>
          <b>{L('Alat penyumbang', 'Contributor tool', '贡献者工具', 'பங்களிப்பாளர் கருவி', '貢献者ツール', '기여자 도구', 'เครื่องมือผู้มีส่วนร่วม', 'Công cụ dành cho người đóng góp', 'Alat kontributor', 'أداة المساهم', 'योगदानकर्ता उपकरण', 'Herramienta para colaboradores', 'Outil pour les contributeurs')}.</b>{' '}
          {L(
            'Senarai kerja hanya dipaparkan dalam persekitaran pembangunan / pratonton, kerana ia menyenaraikan tajuk draf yang belum diterbitkan.',
            'The worklist only renders in the dev / preview environment, because it lists unpublished draft titles.',
            '工作清单仅在开发／预览环境中显示，因为它会列出未发布的草稿标题。',
            'வேலைப்பட்டியல் மேம்பாடு / முன்னோட்டச் சூழலில் மட்டுமே காட்டப்படுகிறது, ஏனெனில் இது வெளியிடப்படாத வரைவுத் தலைப்புகளைப் பட்டியலிடுகிறது.',
            '作業リストは未公開の下書きタイトルを一覧するため、開発／プレビュー環境でのみ表示されます。',
            '작업 목록은 미공개 초안 제목을 나열하므로 개발 / 미리보기 환경에서만 표시됩니다.',
            'รายการงานจะแสดงเฉพาะในสภาพแวดล้อมการพัฒนา / การแสดงตัวอย่างเท่านั้น เนื่องจากมีการแสดงรายชื่อฉบับร่างที่ยังไม่เผยแพร่',
            'Danh sách công việc chỉ hiển thị trong môi trường phát triển / xem trước, vì nó liệt kê các tiêu đề bản nháp chưa xuất bản.',
            'Daftar kerja hanya ditampilkan di lingkungan pengembangan / pratinjau, karena mencantumkan judul draf yang belum diterbitkan.',
            'لا تظهر قائمة العمل إلا في بيئة التطوير / المعاينة، لأنها تسرد عناوين المسودات غير المنشورة.',
            'कार्यसूची केवल dev / पूर्वावलोकन परिवेश में प्रदर्शित होती है, क्योंकि यह अप्रकाशित ड्राफ्ट शीर्षक सूचीबद्ध करती है।',
            'La lista de trabajo solo se muestra en el entorno de desarrollo / vista previa, porque enumera títulos de borradores sin publicar.',
            "La liste de travail ne s'affiche que dans l'environnement de développement / d'aperçu, car elle répertorie des titres de brouillons non publiés.",
          )}
        </p>
        <p class="muted">
          {L('Jalankan', 'Run', '运行', 'இயக்குங்கள்', '実行', '실행', 'รัน', 'Chạy', 'Jalankan', 'شغّل', 'चलाएँ', 'Ejecute', 'Exécutez')} <code>npm run dev</code>{' '}
          {L('untuk membukanya.', 'to open it.', '以打开它。', 'அதைத் திறக்க.', 'を実行して開きます。', '을 실행하여 엽니다.', 'เพื่อเปิด', 'để mở nó.', 'untuk membukanya.', 'لفتحها.', 'इसे खोलने के लिए।', 'para abrirla.', "pour l'ouvrir.")}
        </p>
      </div>
    </section>
  )
}

{
  CONTRIB_ONLY && (
    <section class="container block wl">
      <div class="wl-census" aria-label={L('Kitaran hayat artikel', 'Article lifecycle', '文章生命周期', 'கட்டுரை வாழ்க்கைச் சுழற்சி', '記事のライフサイクル', '기사 수명 주기', 'วงจรชีวิตบทความ', 'Vòng đời bài viết', 'Siklus hidup artikel', 'دورة حياة المقالة', 'लेख जीवनचक्र', 'Ciclo de vida del artículo', "Cycle de vie de l'article")}>
        {census.map((c, i) => (
          <>
            {i > 0 && <span class="wl-c-arr dirx">→</span>}
            <span class={`wl-c ${c.n > 0 ? 'on' : ''} ${c.k === 'needs-update' && c.n > 0 ? 'warn' : ''} ${c.live ? 'live' : ''}`}>
              <b>{c.n}</b>
              <span>{c.label}</span>
            </span>
          </>
        ))}
      </div>

      {[
        { key: 'nu', label: L('Perlu Kemas Kini', 'Needs update', '需更新', 'புதுப்பிக்க வேண்டும்', '要更新', '업데이트 필요', 'ต้องอัปเดต', 'Cần cập nhật', 'Perlu Diperbarui', 'بحاجة إلى تحديث', 'अपडेट की आवश्यकता', 'Requiere actualización', 'Mise à jour requise'), hint: L('auto: semakan tertunggak · atau dilaporkan pembaca', 'auto: review overdue · or reader-flagged', '自动：审阅逾期 · 或读者标记', 'தானியங்கி: மதிப்பாய்வு தாமதம் · அல்லது வாசகரால் குறிக்கப்பட்டது', '自動: レビュー期限超過 · または読者からの指摘', '자동: 검토 기한 초과 · 또는 독자 신고', 'อัตโนมัติ: การตรวจทานเกินกำหนด · หรือผู้อ่านแจ้ง', 'tự động: đánh giá quá hạn · hoặc do người đọc gắn cờ', 'otomatis: tinjauan terlambat · atau dilaporkan pembaca', 'تلقائي: المراجعة متأخرة · أو مُبلّغ عنها من قارئ', 'स्वतः: समीक्षा अतिदेय · या पाठक-चिह्नित', 'auto: revisión vencida · o señalado por lectores', 'auto : révision en retard · ou signalé par des lecteurs'), items: needsUpdate, action: L('Tuntut & sunting', 'Claim & edit', '认领并编辑', 'உரிமை கொண்டு திருத்து', '担当して編集', '담당 후 편집', 'รับงานและแก้ไข', 'Nhận & chỉnh sửa', 'Klaim & sunting', 'المطالبة والتحرير', 'दावा करें और संपादित करें', 'Reclamar y editar', 'Prendre en charge et modifier') },
        { key: 'rr', label: L('Permintaan Tulis Semula', 'Redraft requested', '重写请求', 'மறுவரைவுக் கோரிக்கை', '書き直し依頼', '재작성 요청됨', 'มีคำขอเขียนใหม่', 'Yêu cầu viết lại', 'Permintaan Tulis Ulang', 'طُلبت إعادة الصياغة', 'पुनर्लेखन अनुरोधित', 'Reescritura solicitada', 'Réécriture demandée'), hint: L('diminta manusia', 'human-requested', '人工请求', 'மனிதரால் கோரப்பட்டது', '人による依頼', '사람이 요청', 'ร้องขอโดยมนุษย์', 'do con người yêu cầu', 'diminta manusia', 'بطلب بشري', 'मानव-अनुरोधित', 'solicitado por un humano', 'demandé par un humain'), items: reqRedraft, action: L('Tuntut', 'Claim', '认领', 'உரிமை கொள்', '担当する', '담당', 'รับงาน', 'Nhận', 'Klaim', 'المطالبة', 'दावा करें', 'Reclamar', 'Prendre en charge') },
