---
import type { Locale } from '@/lib/categories';
import DataProvenance from './DataProvenance.astro';
import { COMPANIES } from '@/lib/companies';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);
const rows = [...COMPANIES].sort((a, b) => b.marketCap - a.marketCap);
const sectors = [...new Set(COMPANIES.map((c) => c.sector))];
---

<section class="container head">
  <h1>{L('Syarikat Terbesar Malaysia', 'Largest Malaysian Companies', '马来西亚最大企业')}</h1>
  <p class="lead">{L('Gelembung mengikut nilai pasaran, warna mengikut sektor. Nilai ilustrasi (RM bilion) — gantikan dengan data Bursa Malaysia.', 'Bubbles by market cap, colour by sector. Illustrative values (RM billion) — replace with Bursa Malaysia data.', '气泡大小按市值，颜色按行业。数据为示例（令吉十亿）——请替换为马交所数据。')}</p>
  <div class="controls">
    <label>{L('Saiz ikut', 'Size by', '大小依据')}:
      <select id="metric">
        <option value="marketCap">{L('Nilai pasaran', 'Market cap', '市值')}</option>
        <option value="revenue">{L('Hasil', 'Revenue', '营收')}</option>
      </select>
    </label>
  </div>
</section>

<section class="container">
  <DataProvenance locale={locale} dataset="companies" />
  <svg id="bubbles" role="img" aria-label={L('Carta gelembung syarikat', 'Company bubble chart', '企业气泡图')}></svg>
  <div class="legend">
    {sectors.map((s) => <span class="lg" data-sector={s}><i></i>{s}</span>)}
  </div>
</section>

<section class="container block">
  <h2>{L('Kedudukan', 'Ranking', '排名')}</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>#</th><th>{L('Syarikat', 'Company', '公司')}</th><th>{L('Kod', 'Ticker', '代码')}</th><th>{L('Sektor', 'Sector', '行业')}</th><th>{L('Nilai pasaran', 'Market cap', '市值')}</th><th>{L('Hasil', 'Revenue', '营收')}</th></tr></thead>
      <tbody>
        {rows.map((c, i) => (
          <tr><td>{i + 1}</td><td>{c.name}</td><td>{c.ticker}</td><td>{c.sector}</td><td>RM{c.marketCap}b</td><td>RM{c.revenue}b</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="muted">{L('Data ilustrasi sahaja.', 'Illustrative data only.', '仅为示例数据。')}</p>
</section>

<script type="application/json" id="companies-data" set:html={JSON.stringify(COMPANIES)}></script>

<script>
  import * as d3 from 'd3';
  const el = document.getElementById('bubbles');
  const raw = document.getElementById('companies-data');
  if (el && raw) {
    const data = JSON.parse(raw.textContent || '[]');
    const sectors = [...new Set(data.map((d: any) => d.sector))];
    const palette = ['#FFC000','#F5A623','#10B981','#6366F1','#A78BFA','#F43F5E','#38BDF8','#FB923C','#34D399','#E879F9','#22D3EE'];
    const color = d3.scaleOrdinal(sectors, palette);
    document.querySelectorAll<HTMLElement>('.lg').forEach((lg) => {
      const dot = lg.querySelector('i');
      if (dot) dot.style.background = String(color(lg.dataset.sector!));
    });

    const width = (el as HTMLElement).clientWidth || 900;
    const height = 460;
    const svg = d3.select(el).attr('viewBox', `0 0 ${width} ${height}`);

    function draw(metric: string) {
      svg.selectAll('*').remove();
      const r = d3.scaleSqrt().domain([0, d3.max(data, (d: any) => d[metric]) as number]).range([6, 62]);
      const nodes = data.map((d: any) => ({ ...d, r: r(d[metric]) }));
      const sim = d3.forceSimulation(nodes)
        .force('x', d3.forceX(width / 2).strength(0.05))
        .force('y', d3.forceY(height / 2).strength(0.06))
        .force('collide', d3.forceCollide((d: any) => d.r + 2))
        .stop();
      for (let i = 0; i < 160; i++) sim.tick();
      const g = svg.selectAll('g').data(nodes).join('g').attr('transform', (d: any) => `translate(${d.x},${d.y})`);
      g.append('title').text((d: any) => `${d.name} — RM${d[metric]}b`);
      g.append('circle').attr('r', (d: any) => d.r).attr('fill', (d: any) => String(color(d.sector))).attr('fill-opacity', 0.85).attr('stroke', '#07070a');
      g.append('text').text((d: any) => (d.r > 24 ? d.name : '')).attr('text-anchor', 'middle').attr('dy', '0.3em').attr('font-size', 10).attr('fill', '#07070a').attr('font-weight', 700);
    }
    draw('marketCap');
    document.getElementById('metric')?.addEventListener('change', (e) => draw((e.target as HTMLSelectElement).value));
  }
</script>

<style>
  .head { padding-block: 2.5rem 1rem; }
  .lead { color: var(--ink-soft); max-width: 64ch; }
  .controls { margin-top: 0.75rem; font-size: 0.9rem; }
  .controls select { margin-left: 0.4rem; padding: 0.3rem 0.5rem; border-radius: 7px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); }
  #bubbles { width: 100%; height: 460px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .legend { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.75rem; font-size: 0.8rem; color: var(--ink-soft); }
  .lg { display: inline-flex; align-items: center; gap: 0.35rem; }
  .lg i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .block { margin-top: 2.5rem; padding-bottom: 3rem; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { text-align: left; padding: 0.55rem 0.8rem; border-bottom: 1px solid var(--line); white-space: nowrap; }
  th { font-family: var(--font-interface); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  .muted { color: var(--muted); font-size: 0.85rem; margin-top: 0.5rem; }
</style>
