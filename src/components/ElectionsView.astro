---
import type { Locale } from '@/lib/categories';
import { articlesInCategory } from '@/lib/content';
import { localePath } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string) => (locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);
// Indicative target — GE16 must be held by early 2028. Adjust when dissolution is announced.
const target = '2027-11-19';
const politics = await articlesInCategory('politics', locale);

const facts = [
  { n: '222', t: L('kerusi Dewan Rakyat', 'Dewan Rakyat seats', '国会下议院席位', 'Dewan Rakyat இருக்கைகள்', '下院（Dewan Rakyat）議席', '하원(Dewan Rakyat) 의석', 'ที่นั่งสภาผู้แทนราษฎร (Dewan Rakyat)') },
  { n: 'FPTP', t: L('sistem undi majoriti mudah', 'first-past-the-post', '简单多数制', 'எளிய பெரும்பான்மை முறை', '小選挙区制', '단순 다수 대표제', 'ระบบเสียงข้างมากธรรมดา') },
  { n: '18', t: L('umur mengundi', 'voting age', '投票年龄', 'வாக்களிக்கும் வயது', '投票年齢', '선거 연령', 'อายุผู้มีสิทธิเลือกตั้ง') },
  { n: '5', t: L('tahun penggal maksimum', 'year max term', '年最长任期', 'ஆண்டு அதிகபட்சப் பதவிக்காலம்', '年（最長任期）', '년 최대 임기', 'ปี วาระสูงสุด') },
];
---

<section class="container head">
  <p class="kicker">🗳️ {L('Pusat Pilihan Raya', 'Elections Hub', '选举中心', 'தேர்தல் மையம்', '選挙ハブ', '선거 허브', 'ศูนย์การเลือกตั้ง')}</p>
  <h1>{L('Pilihan Raya Umum Malaysia', 'Malaysian General Election', '马来西亚大选', 'மலேசியப் பொதுத் தேர்தல்', 'マレーシア総選挙', '말레이시아 총선', 'การเลือกตั้งทั่วไปของมาเลเซีย')}</h1>
  <p class="lead">{L('Panduan tak-berpihak tentang sistem pilihan raya Malaysia. Kiraan detik adalah anggaran.', 'A non-partisan guide to Malaysia\'s electoral system. The countdown is indicative.', '关于马来西亚选举制度的中立指南。倒计时为估计值。', 'மலேசியாவின் தேர்தல் அமைப்பு குறித்த ஒரு நடுநிலையான வழிகாட்டி. கவுண்ட்டவுன் ஒரு தோராயமான மதிப்பீடே.', 'マレーシアの選挙制度に関する中立的なガイド。カウントダウンは目安です。', '말레이시아 선거 제도에 대한 초당파적 안내입니다. 카운트다운은 참고용 추정치입니다.', 'คู่มือที่เป็นกลางเกี่ยวกับระบบการเลือกตั้งของมาเลเซีย การนับถอยหลังเป็นเพียงการประมาณการ')}</p>
  <div class="countdown" data-target={target}>
    <div><b id="cd-days">–</b><span>{L('hari', 'days', '天', 'நாட்கள்', '日', '일', 'วัน')}</span></div>
    <div><b id="cd-hrs">–</b><span>{L('jam', 'hours', '小时', 'மணி', '時間', '시간', 'ชั่วโมง')}</span></div>
    <div><b id="cd-min">–</b><span>{L('minit', 'minutes', '分钟', 'நிமிடம்', '分', '분', 'นาที')}</span></div>
  </div>
  <p class="cd-expired" hidden>{L('Sasaran anggaran telah berlalu — PRU16 mungkin akan diadakan. Semak SPR untuk tarikh yang diwartakan.', 'The indicative date has passed — GE16 may be due. Check the SPR for the gazetted date.', '估计日期已过——GE16 可能即将举行。请查看 SPR 的正式日期。', 'தோராயமான தேதி கடந்துவிட்டது — GE16 நடைபெறலாம். வர்த்தமானியில் வெளியிடப்பட்ட தேதிக்கு SPR-ஐ பார்க்கவும்.', '目安の日付は過ぎました — GE16が実施される可能性があります。官報告示の日付はSPRでご確認ください。', '참고용 날짜가 지났습니다 — GE16(제16대 총선)이 실시될 수 있습니다. 관보에 고시된 날짜는 SPR에서 확인하세요.', 'วันที่ประมาณการได้ผ่านไปแล้ว — GE16 อาจจะจัดขึ้น ตรวจสอบวันที่ประกาศในราชกิจจานุเบกษาได้ที่ SPR')}</p>
  <p class="muted cd-target">{L('Sasaran anggaran', 'Indicative target', '估计目标', 'தோராயமான இலக்கு', '目安の目標', '참고용 목표일', 'เป้าหมายโดยประมาณ')}: {target}</p>
</section>

<section class="container block">
  <div class="facts">
    {facts.map((f) => <div class="card"><b>{f.n}</b><span>{f.t}</span></div>)}
  </div>
</section>

<section class="container block two">
  <div class="prose">
    <h2>{L('Bagaimana ia berfungsi', 'How it works', '如何运作', 'இது எப்படி இயங்குகிறது', '仕組み', '작동 방식', 'วิธีการทำงาน')}</h2>
    <p>{L('Malaysia mengamalkan sistem "first-past-the-post": calon dengan undi terbanyak dalam setiap kawasan menang kerusi. Parti/gabungan dengan majoriti kerusi Dewan Rakyat membentuk kerajaan, dan pemimpinnya menjadi Perdana Menteri.', 'Malaysia uses first-past-the-post: the candidate with the most votes in each constituency wins the seat. The party/coalition with a majority of Dewan Rakyat seats forms the government, and its leader becomes Prime Minister.', '马来西亚采用简单多数制：各选区得票最多者胜出。取得国会下议院多数席位的政党/联盟组建政府，其领袖出任首相。', 'மலேசியா "first-past-the-post" முறையைப் பயன்படுத்துகிறது: ஒவ்வொரு தொகுதியிலும் அதிக வாக்குகளைப் பெறும் வேட்பாளர் அந்த இருக்கையை வெல்கிறார். Dewan Rakyat இருக்கைகளில் பெரும்பான்மை பெறும் கட்சி/கூட்டணி அரசாங்கத்தை அமைக்கிறது, அதன் தலைவர் பிரதமராகிறார்.', 'マレーシアは小選挙区制を採用しています。各選挙区で最多得票の候補者が議席を獲得します。下院（Dewan Rakyat）で過半数の議席を得た政党／連合が政府を樹立し、その指導者が首相となります。', '말레이시아는 단순 다수 대표제(first-past-the-post)를 채택합니다. 각 선거구에서 가장 많은 표를 얻은 후보가 그 의석을 차지합니다. 하원(Dewan Rakyat) 의석의 과반을 차지한 정당/연합이 정부를 구성하며, 그 지도자가 총리가 됩니다.', 'มาเลเซียใช้ระบบเสียงข้างมากธรรมดา (first-past-the-post) ผู้สมัครที่ได้คะแนนเสียงมากที่สุดในแต่ละเขตเลือกตั้งเป็นผู้ชนะที่นั่งนั้น พรรค/แนวร่วมที่ได้ที่นั่งในสภาผู้แทนราษฎร (Dewan Rakyat) เกินกึ่งหนึ่งเป็นผู้จัดตั้งรัฐบาล และผู้นำของพรรคนั้นจะดำรงตำแหน่งนายกรัฐมนตรี')}</p>
    <p>{L('Suruhanjaya Pilihan Raya (SPR) mengendalikan pilihan raya.', 'The Election Commission (SPR) administers elections.', '选举委员会（SPR）负责组织选举。', 'தேர்தல் ஆணையம் (SPR) தேர்தல்களை நிர்வகிக்கிறது.', '選挙管理委員会（SPR）が選挙を運営します。', '선거관리위원회(SPR)가 선거를 관리합니다.', 'คณะกรรมการการเลือกตั้ง (SPR) เป็นผู้ดำเนินการจัดการเลือกตั้ง')}</p>
  </div>
  <div>
    <h2>{L('Bacaan asas', 'Foundational reading', '基础阅读', 'அடிப்படை வாசிப்பு', '基礎的な読み物', '기초 읽을거리', 'การอ่านพื้นฐาน')}</h2>
    <ul class="reads">
      {politics.map((a) => <li><a href={localePath(`/${a.data.category}/${a.data.slug}`, locale)}>{a.data.title}</a></li>)}
    </ul>
    <h2 style="margin-top:1.5rem">{L('Alat sivik', 'Civic tools', '公民工具', 'குடிமைக் கருவிகள்', '市民向けツール', '시민 도구', 'เครื่องมือพลเมือง')}</h2>
    <ul class="reads">
      <li><a href="https://www.spr.gov.my" target="_blank" rel="noopener">SPR — Suruhanjaya Pilihan Raya ↗</a></li>
      <li><a href="https://undi.info" target="_blank" rel="noopener">Undi.info ↗</a></li>
    </ul>
  </div>
</section>

<script>
  const el = document.querySelector<HTMLElement>('.countdown');
  if (el?.dataset.target) {
    const target = new Date(el.dataset.target + 'T00:00:00').getTime();
    const expired = document.querySelector<HTMLElement>('.cd-expired');
    const targetLine = document.querySelector<HTMLElement>('.cd-target');
    const tick = () => {
      const raw = target - Date.now();
      // Once the indicative date passes, a frozen "0 0 0" is worse than nothing —
      // swap the ticker for a message pointing at the authoritative source.
      if (raw <= 0) {
        el.hidden = true;
        if (targetLine) targetLine.hidden = true;
        if (expired) expired.hidden = false;
        return;
      }
      const d = Math.floor(raw / 86400000);
      const h = Math.floor((raw % 86400000) / 3600000);
      const m = Math.floor((raw % 3600000) / 60000);
      const set = (id: string, v: number) => { const n = document.getElementById(id); if (n) n.textContent = String(v); };
      set('cd-days', d); set('cd-hrs', h); set('cd-min', m);
    };
    tick();
    setInterval(tick, 30000);
  }
</script>

<style>
  .head { padding-block: 2.5rem 1rem; }
  .kicker { color: var(--gold); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.8rem; margin: 0 0 0.3rem; }
  .lead { color: var(--ink-soft); max-width: 62ch; }
  .countdown { display: flex; gap: 1rem; margin-top: 1.25rem; }
  .countdown div { border: 1px solid var(--line); border-top: 2px solid var(--gold); border-radius: 12px; padding: 0.8rem 1.2rem; text-align: center; background: var(--surface); min-width: 84px; }
  .countdown b { display: block; font-family: var(--font-title); font-size: 2rem; color: var(--gold); }
  .countdown span { color: var(--muted); font-size: 0.8rem; }
  .muted { color: var(--muted); font-size: 0.82rem; }
  .block { margin-top: 2.5rem; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); gap: 1rem; }
  .facts b { display: block; font-family: var(--font-title); font-size: 1.5rem; color: var(--gold); }
  .facts span { color: var(--ink-soft); font-size: 0.85rem; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; padding-bottom: 3rem; }
  .two h2 { font-size: 1.3rem; }
  .reads { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.4rem; }
  .reads a { color: var(--ink-soft); text-decoration: none; }
  .reads a:hover { color: var(--gold); }
  @media (max-width: 800px) { .two { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
