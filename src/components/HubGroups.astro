---
import type { Locale, Pillar } from '@/lib/categories';
import { categoriesInPillar, PILLARS, getPillar, getCategoryColor, getPillarColor } from '@/lib/categories';
import { articlesForLocale } from '@/lib/content';
import { orderedSubcats, subcatLabel } from '@/lib/subcategories';
import { localePath } from '@/lib/i18n';

// Shared hierarchy navigation: an optional TOPICS group (the topics of the
// current category), a CATEGORIES group (the sibling categories of the current
// section) and a SECTIONS group (all site sections). Used on the section hub,
// every category page and every topic page so they read as one system — the
// current topic / category / section is highlighted.

interface Props {
  locale: Locale;
  pillar: Pillar;
  activeCategory?: string;
  /** Pass a category id to also render its TOPICS group (topic pages). */
  categoryId?: string;
  activeTopic?: string;
  /** Draw a full-width rule above, when another content block precedes this one. */
  topSeparator?: boolean;
}
const { locale, pillar, activeCategory, categoryId, activeTopic, topSeparator } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

const cats = categoriesInPillar(pillar);
const items = await articlesForLocale(locale);
const catCounts: Record<string, number> = {};
const sectionCounts: Record<string, number> = {};
for (const a of items) {
  catCounts[a.data.category] = (catCounts[a.data.category] ?? 0) + 1;
  const p = getPillar(a.data.category);
  if (p) sectionCounts[p] = (sectionCounts[p] ?? 0) + 1;
}

// Topics of the current category (only when a categoryId is supplied).
const catArticles = categoryId ? items.filter((a) => a.data.category === categoryId) : [];
const topics = categoryId ? orderedSubcats(categoryId, catArticles.flatMap((a) => a.data.subcategory)) : [];
const topicCount = (t: string) => catArticles.filter((a) => a.data.subcategory.includes(t)).length;
---

{topSeparator && <hr class="gsep-full" />}

<div class="container block hub-groups" data-pagefind-ignore>
  {
    topics.length > 0 && (
      <section class="psec">
        <header>
          <span>
            <span class="pi" aria-hidden="true">🧭</span>
            {L('Topik', 'Topics', '主题')}
          </span>
          <span>{topics.length}</span>
        </header>
        <div class="psec-body">
          <div class="cat-grid">
            {topics.map((t) => (
              <a
                class={`cat-card topic${t === activeTopic ? ' current' : ''}`}
                href={localePath(`/${categoryId}/topic/${t}`, locale)}
                aria-current={t === activeTopic ? 'page' : undefined}
                style={`--cat:${getCategoryColor(categoryId!)}`}
              >
                <span class="bar" aria-hidden="true" />
                <b>{subcatLabel(t, locale)}</b>
                <span class="tc-count">{topicCount(t)} {L('artikel', 'articles', '篇')} →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {topics.length > 0 && <hr class="gsep" />}

  <section class="psec">
    <header>
      <span>
        <span class="pi" aria-hidden="true">🗂️</span>
        {L('Kategori', 'Categories', '分类')}
      </span>
      <span>{cats.length}</span>
    </header>
    <div class="psec-body">
      <div class="cat-grid">
        {
          cats.map((c) => (
            <a
              class={`cat-card${c.id === activeCategory ? ' current' : ''}`}
              href={localePath(`/${c.id}`, locale)}
              aria-current={c.id === activeCategory ? 'page' : undefined}
              style={`--cat:${getCategoryColor(c.id)}`}
            >
              <span class="bar" aria-hidden="true" />
              <span class="ci-row">
                <span class="ci" aria-hidden="true">{c.icon}</span>
                {catCounts[c.id] ? <span class="cc">{catCounts[c.id]}</span> : null}
              </span>
              <b>{c.name[locale]}</b>
              <span class="cd">{c.blurb[locale]}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <hr class="gsep" />

  <section class="psec">
    <header>
      <span>
        <span class="pi" aria-hidden="true">🗺️</span>
        {L('Seksyen', 'Sections', '版块')}
      </span>
      <span>{PILLARS.length}</span>
    </header>
    <div class="psec-body">
      <div class="cat-grid">
        {
          PILLARS.map((s) => (
            <a
              class={`cat-card${s.id === pillar ? ' current' : ''}`}
              href={localePath(`/${s.id}`, locale)}
              aria-current={s.id === pillar ? 'page' : undefined}
              style={`--cat:${getPillarColor(s.id)}`}
            >
              <span class="bar" aria-hidden="true" />
              <span class="ci-row">
                <span class="ci" aria-hidden="true">{s.icon}</span>
                {sectionCounts[s.id] ? <span class="cc">{sectionCounts[s.id]}</span> : null}
              </span>
              <b>{s.name[locale]}</b>
              <span class="cd">{s.tagline[locale]}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</div>

<style>
  /* Outer spacing comes from the global .block rhythm; this only sets the gap
     between the groups it contains. */
  .hub-groups { display: flex; flex-direction: column; gap: var(--space-group); }
  /* Separator between groups. A real element (not a pseudo-element) because the
     group boxes use overflow:hidden, which would clip one drawn outside them. */
  .gsep { width: 100%; margin: 0; border: 0; border-top: 1px solid var(--line); }
  /* Full-width rule marking the boundary from the preceding block. It sits
     OUTSIDE .container so it spans the screen rather than the content width. */
  .gsep-full { width: 100%; margin-block: var(--space-group); border: 0; border-top: 1px solid var(--line); }
  .gsep-full + .hub-groups { margin-block-start: 0; }
  .psec {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px; overflow: hidden;
  }
  .psec > header {
    display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    padding: 0.45rem 0.95rem; font-size: 0.67rem; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--muted); background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  /* Group header: a MUTED all-caps section label — quiet chrome that frames the
     bright-white item titles below, so the header and the content read as two
     distinct tiers (gold is reserved for links/accents, not headers). Carries a
     small leading icon, matching the /categories reference design. */
  .psec > header span:first-child {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-title); font-size: 1.05rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.03em; line-height: 1.2; color: var(--muted);
  }
  .psec > header .pi { font-size: 1.2rem; }
  .psec > header span:last-child {
    font-family: var(--font-title); font-size: 1.05rem; font-weight: 700; line-height: 1.2;
    letter-spacing: 0; color: var(--muted); font-variant-numeric: tabular-nums;
  }
  /* The page's primary group header is gold; other groups stay bright ink.
     Must match the base rules' specificity (they use :first/:last-child), so
     target the same pseudo-classes and rely on source order to win. */
  .psec-gold > header span:first-child,
  .psec-gold > header span:last-child { color: var(--gold); }
  .psec-body { padding: 1.1rem; }

  .cat-grid { display: grid; gap: 0.8rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  /* Vertical card: icon (line 1), title + count (line 2), description (line 3). */
  .cat-card {
    position: relative; overflow: hidden;
    background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px;
    text-decoration: none; color: inherit; transition: border-color 0.15s, transform 0.15s;
    display: flex; flex-direction: column; gap: 0.55rem; align-items: flex-start; padding: 1rem 1.05rem;
  }
  /* Change A: a coloured top bar per card (category colour, or the pillar colour
     for Section cards, or the parent category's colour for Topic cards). */
  .cat-card .bar {
    position: absolute; top: 0; left: 0; right: 0; height: 4px;
    background: var(--cat, var(--gold));
  }
  /* Change B: on hover the border takes the card's own top-bar colour. */
  .cat-card:hover { border-color: var(--cat, var(--gold)); transform: translateY(-2px); }
  /* Highlight (current) card: gold border + tint mark "you are here". Its top bar
     is bright ink (not gold) so it stays visible against the gold box, and the
     hover border follows that same bar colour. */
  .cat-card.current { border-color: var(--gold); background: color-mix(in srgb, var(--gold) 8%, var(--surface-2)); }
  .cat-card.current .bar { background: var(--ink); }
  .cat-card.current:hover { border-color: var(--ink); }
  .cat-card .ci-row { width: 100%; display: flex; justify-content: space-between; align-items: center; }
  /* Topic cards: name, then a labelled + clickable article count (same design as
     the category page's Topics group). No icon, tighter than a category card. */
  .cat-card.topic { gap: 0.3rem; }
  .cat-card .tc-count { color: var(--muted); font-size: 0.85rem; }
  .cat-card .ci { font-size: 1.6rem; line-height: 1; }
  .cat-card b { font-family: var(--font-title); font-size: 1rem; }
  /* Card count follows the card title — same font, size and colour. */
  .cat-card .cc { font-family: var(--font-title); font-size: 1rem; font-weight: 700; line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; }
  .cat-card .cd { color: var(--ink-soft); font-size: 0.85rem; line-height: 1.5; }
</style>
