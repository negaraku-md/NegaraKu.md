---
import type { Locale } from '@/lib/categories';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

const groups = [
  {
    title: L('Kerajaan & Data Terbuka', 'Government & Open Data', '政府与开放数据'),
    items: [
      { name: 'data.gov.my', url: 'https://data.gov.my', desc: L('Portal data terbuka rasmi.', 'Official open-data portal.', '官方开放数据门户。') },
      { name: 'DOSM', url: 'https://www.dosm.gov.my', desc: L('Jabatan Perangkaan Malaysia.', 'Dept. of Statistics Malaysia.', '马来西亚统计局。') },
      { name: 'Parlimen Malaysia', url: 'https://www.parlimen.gov.my', desc: L('Dewan Rakyat & Dewan Negara.', 'Houses of Parliament.', '国会两院。') },
      { name: 'MyGovernment', url: 'https://www.malaysia.gov.my', desc: L('Portal perkhidmatan kerajaan.', 'Government services portal.', '政府服务门户。') },
    ],
  },
  {
    title: L('Budaya & Ilmu', 'Culture & Knowledge', '文化与知识'),
    items: [
      { name: 'Perpustakaan Negara', url: 'https://www.pnm.gov.my', desc: L('Perpustakaan Negara Malaysia.', 'National Library of Malaysia.', '马来西亚国家图书馆。') },
      { name: 'Jabatan Warisan Negara', url: 'https://www.heritage.gov.my', desc: L('Warisan kebangsaan.', 'National heritage.', '国家遗产。') },
      { name: 'DBP', url: 'https://www.dbp.gov.my', desc: L('Dewan Bahasa dan Pustaka.', 'Institute of Language & Literature.', '语文出版局。') },
      { name: 'Muzium Negara', url: 'https://www.jmm.gov.my', desc: L('Jabatan Muzium Malaysia.', 'Dept. of Museums Malaysia.', '马来西亚博物馆局。') },
    ],
  },
  {
    title: L('Ekonomi', 'Economy', '经济'),
    items: [
      { name: 'Bank Negara Malaysia', url: 'https://www.bnm.gov.my', desc: L('Bank pusat.', 'Central bank.', '中央银行。') },
      { name: 'Bursa Malaysia', url: 'https://www.bursamalaysia.com', desc: L('Bursa saham.', 'Stock exchange.', '证券交易所。') },
      { name: 'MIDA', url: 'https://www.mida.gov.my', desc: L('Lembaga Pembangunan Pelaburan.', 'Investment Development Authority.', '投资发展局。') },
    ],
  },
  {
    title: L('Media & Teknologi Sivik', 'Media & Civic Tech', '媒体与公民科技'),
    items: [
      { name: 'Bernama', url: 'https://www.bernama.com', desc: L('Agensi berita nasional.', 'National news agency.', '国家通讯社。') },
      { name: 'Sinar Project', url: 'https://sinarproject.org', desc: L('Data terbuka & ketelusan.', 'Open data & transparency.', '开放数据与透明度。') },
      { name: 'Undi.info', url: 'https://undi.info', desc: L('Maklumat pilihan raya.', 'Election information.', '选举信息。') },
    ],
  },
];
---

<section class="container head">
  <h1>{L('Sumber Malaysia', 'Malaysia Resources', '马来西亚资源')}</h1>
  <p class="lead">{L('Direktori terpilih institusi, data, dan platform Malaysia yang dipercayai.', 'A curated directory of trusted Malaysian institutions, data, and platforms.', '精选可信的马来西亚机构、数据与平台目录。')}</p>
  <p class="verified">{L('Terakhir disemak', 'Last verified', '最后核实')}: 2026-07-06</p>
</section>

<section class="container groups">
  {
    groups.map((g) => (
      <div class="group">
        <h2>{g.title}</h2>
        <div class="grid">
          {g.items.map((it) => (
            <a class="card" href={it.url} rel="noopener">
              <b>{it.name} ↗</b>
              <span>{it.desc}</span>
            </a>
          ))}
        </div>
      </div>
    ))
  }
</section>

<style>
  .head { padding-block: 2.5rem 1rem; }
  .lead { color: var(--ink-soft); max-width: 60ch; }
  .verified { color: var(--muted); font-size: 0.82rem; }
  .groups { padding-bottom: 3rem; }
  .group { margin-top: 2rem; }
  .group h2 { font-size: 1.3rem; margin-bottom: 1rem; }
  .card b { display: block; margin-bottom: 0.2rem; }
  .card span { color: var(--ink-soft); font-size: 0.9rem; }
</style>
