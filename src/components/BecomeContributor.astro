---
import type { Locale } from '@/lib/categories';
import { localePath } from '@/lib/i18n';
import { REPO } from '@/lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string) => (locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);
---

<section class="become container block" data-pre-contributor data-pagefind-ignore>
  <div class="become-card">
    <div class="become-text">
      <b class="become-title">{L('Bantu bina NegaraKu.md', 'Help build NegaraKu.md', '一起建设 NegaraKu.md', 'NegaraKu.md-ஐ கட்டியெழுப்ப உதவுங்கள்', 'NegaraKu.md の構築を手伝う', 'NegaraKu.md 구축을 도와주세요')}</b>
      <p>{L(
        'Sesiapa boleh menambah baik — betulkan kesilapan, isi kekurangan, atau cadang topik baharu. Semuanya terbuka di GitHub, dan setiap perubahan disemak.',
        'Anyone can improve it — fix an error, fill a gap, or suggest a new topic. It’s all open on GitHub, and every change is reviewed.',
        '人人都能改进它——更正错误、补足缺漏，或建议新主题。一切都在 GitHub 上公开，每处改动都会经过审阅。',
        'யார் வேண்டுமானாலும் இதை மேம்படுத்தலாம் — பிழையைத் திருத்தலாம், குறையை நிரப்பலாம், அல்லது புதிய தலைப்பைப் பரிந்துரைக்கலாம். அனைத்தும் GitHub-இல் திறந்தநிலையில் உள்ளது; ஒவ்வொரு மாற்றமும் மதிப்பாய்வு செய்யப்படுகிறது.',
        'だれでも改善できます — 誤りを直し、不足を補い、新しいトピックを提案する。すべて GitHub 上で公開され、あらゆる変更がレビューされます。',
        '누구나 개선할 수 있습니다 — 오류를 고치고, 부족한 부분을 채우고, 새로운 주제를 제안할 수 있습니다. 모든 것이 GitHub에 공개되어 있으며, 모든 변경 사항은 검토됩니다.',
      )}</p>
    </div>
    <div class="become-actions">
      <a class="btn btn-primary" href={REPO} rel="noopener">★ {L('Bintangkan di GitHub', 'Star on GitHub', '在 GitHub 点星', 'GitHub-இல் நட்சத்திரமிடுங்கள்', 'GitHub でスターを付ける', 'GitHub에서 별표 주기')}</a>
      <a class="btn btn-ghost" href={localePath('/contribute', locale)}>{L('Cara menyumbang', 'How to contribute', '如何贡献', 'எப்படி பங்களிப்பது', '貢献の方法', '기여하는 방법')} →</a>
    </div>
  </div>
</section>

<style>
  .become { margin-top: 1.6rem; }
  .become-card {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem 2rem; flex-wrap: wrap;
    background: var(--surface);
    border: 1px solid color-mix(in srgb, var(--gold) 35%, var(--line));
    border-radius: 12px; padding: 1.4rem 1.6rem;
  }
  .become-title { display: block; font-family: var(--font-title); font-size: 1.2rem; color: var(--ink); margin-bottom: 0.35rem; }
  .become-text p { margin: 0; color: var(--ink-soft); line-height: 1.6; max-width: 60ch; }
  .become-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .become-actions .btn { white-space: nowrap; }
</style>
