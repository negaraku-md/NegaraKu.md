---
import type { Locale } from '@/lib/categories';
import { getCategory, getPillar, getPillarDef, PILLARS } from '@/lib/categories';
import { subcatLabel } from '@/lib/subcategories';
import { corpusTopics, isPublishable } from '@/lib/content';
import { getDashboard, getAnalytics, getFacebook, getSearchConsole } from '@/lib/apidata';
import { t, localePath } from '@/lib/i18n';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = getDashboard();
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

// Per-language coverage rows for the trilingual bars (master ms first).
const LANG_NAMES: Record<string, string> = { ms: 'Bahasa Malaysia', en: 'English', zh: '中文' };
const langBars = (['ms', 'en', 'zh'] as const).map((l) => ({
  code: l.toUpperCase(),
  name: LANG_NAMES[l],
  ...d.perLangCoverage[l],
}));

// One pass over the corpus (deduped to one row per topic) drives three views:
// the knowledge-structure tree, the classification mix, and the sourcing totals.
type TopicNode = { count: number };
type CatNode = { total: number; topics: Map<string, TopicNode> };
type SecNode = { total: number; cats: Map<string, CatNode> };
const iaTree = new Map<string, SecNode>();
const seenTopics = new Set<string>();
const sensMix = new Map<string, number>();
const catSet = new Set<string>();
const subcatSet = new Set<string>();
let sources = 0;
let sourced = 0;
// LIVE corpus (isPublishable) — the SAME population build-dashboard.mjs computes
// its JSON size figures from, and the same one Explore/About/pillars use, so this
// page's tree, classification mix and hero reconcile with every other page. The
// in-review backlog is shown separately (lifecycle ladder), never in these totals.
for (const a of (await corpusTopics()).filter(isPublishable)) {
  const uid = `${a.data.category}/${a.data.slug}`;
  if (seenTopics.has(uid)) continue;
  seenTopics.add(uid);
  catSet.add(a.data.category);
  // Key topics by category/subcat (a topic is scoped to its category), matching
  // siteStats and the pillar pages so every "topics" figure reconciles.
  for (const s of a.data.subcategory) subcatSet.add(`${a.data.category}/${s}`);
  const pillar = getPillar(a.data.category) ?? 'understand';
  const topic = a.data.subcategory[0] ?? '—';
  const sens = a.data.sensitivity && a.data.sensitivity !== 'none' ? a.data.sensitivity : 'none';
  sensMix.set(sens, (sensMix.get(sens) ?? 0) + 1);
  const n = a.data.sources?.length ?? 0;
  sources += n;
  if (n > 0) sourced++;
  const sec = iaTree.get(pillar) ?? { total: 0, cats: new Map() };
  sec.total++;
  const cat = sec.cats.get(a.data.category) ?? { total: 0, topics: new Map() };
  cat.total++;
  const tn = cat.topics.get(topic) ?? { count: 0 };
  tn.count++;
  cat.topics.set(topic, tn);
  sec.cats.set(a.data.category, cat);
  iaTree.set(pillar, sec);
}
const totalTopics = seenTopics.size;

// Coverage by section → category, with a bar scaled to the biggest category.
const maxCat = Math.max(1, ...Object.values(d.perCategory));
const sections = PILLARS.map((pd) => {
  const sec = iaTree.get(pd.id);
  if (!sec) return null;
  const cats = [...sec.cats.entries()]
    .map(([cid, c]) => ({ id: cid, name: getCategory(cid)?.name[locale] ?? cid, total: c.total }))
    .sort((x, y) => y.total - x.total);
  return { id: pd.id, name: pd.name[locale], icon: pd.icon, total: sec.total, cats };
}).filter((s): s is NonNullable<typeof s> => s !== null);

// Classification mix — the site's handling of Malaysia's sensitive domains.
const SENS_META: Record<string, { label: string; color: string }> = {
  none: { label: L('Umum', 'General', '一般'), color: 'var(--muted)' },
  royalty: { label: L('Institusi diraja', 'Royalty', '王室'), color: '#c084fc' },
  religion: { label: L('Agama', 'Religion', '宗教'), color: '#60a5fa' },
  race: { label: L('Kaum', 'Race', '种族'), color: '#f59e0b' },
  constitution: { label: L('Perlembagaan', 'Constitution', '宪法'), color: '#2dd4bf' },
  elections: { label: L('Pilihan raya', 'Elections', '选举'), color: '#818cf8' },
  security: { label: L('Keselamatan', 'Security', '安全'), color: '#fb7185' },
  health: { label: L('Kesihatan', 'Health', '健康'), color: '#4ade80' },
  'legal-proceedings': { label: L('Perundangan', 'Legal', '法律'), color: '#a3a3a3' },
};
const sensOrder = ['none', 'royalty', 'religion', 'race', 'constitution', 'elections', 'security', 'health', 'legal-proceedings'];
const sensRows = sensOrder
  .filter((k) => (sensMix.get(k) ?? 0) > 0)
  .map((k) => ({ key: k, ...SENS_META[k], count: sensMix.get(k) ?? 0, pct: Math.round(((sensMix.get(k) ?? 0) / totalTopics) * 100) }));
const sensitiveCount = totalTopics - (sensMix.get('none') ?? 0);
const avgSources = sourced ? (sources / sourced).toFixed(1) : '0';

// AI-crawler activity. The edge Worker tags every hit's bucket (readers/search/
// ai) + the crawler's canonical name; this rolls the per-page `ai` buckets up
// across the whole corpus — by crawler, by pillar, and the most-crawled
// articles — for the "AI crawlers" panel. All-time (snapshot + live tail).
const analytics = getAnalytics();
const titleByKey = new Map<string, string>();
for (const r of d.registry) titleByKey.set(`${r.category}/${r.slug}`, r.title[locale] ?? r.title.ms);
const aiTotalFor = (b: typeof analytics[string]['ai']) =>
  b == null ? 0 : typeof b === 'number' ? b : (b.total ?? 0);
let aiTotal = 0;
let aiPages = 0;
const aiByBot = new Map<string, number>();
const aiByPillar = new Map<string, number>();
const aiTopRaw: { key: string; total: number }[] = [];
for (const [key, row] of Object.entries(analytics)) {
  const total = aiTotalFor(row.ai);
  if (total <= 0) continue;
  aiTotal += total;
  aiPages++;
  aiTopRaw.push({ key, total });
  const byBot = row.ai && typeof row.ai !== 'number' ? (row.ai.byBot ?? {}) : {};
  for (const [bot, n] of Object.entries(byBot)) aiByBot.set(bot, (aiByBot.get(bot) ?? 0) + n);
  const pillar = getPillar(key.split('/')[0]) ?? 'understand';
  aiByPillar.set(pillar, (aiByPillar.get(pillar) ?? 0) + total);
}
const aiBots = [...aiByBot.entries()].sort((a, b) => b[1] - a[1]).map(([bot, n]) => ({ bot, n }));
const aiBotMax = Math.max(1, ...aiBots.map((b) => b.n));
const aiPillars = PILLARS.map((pd) => ({ id: pd.id, name: pd.name[locale], icon: pd.icon, n: aiByPillar.get(pd.id) ?? 0 }))
  .filter((p) => p.n > 0)
  .sort((a, b) => b.n - a.n);
const aiPillarMax = Math.max(1, ...aiPillars.map((p) => p.n));
const aiTop = aiTopRaw.sort((a, b) => b.total - a.total).slice(0, 8)
  .map((x) => ({ ...x, title: titleByKey.get(x.key) ?? x.key }));
const aiTopMax = Math.max(1, ...aiTop.map((x) => x.total));

// Traffic by channel — where human readers arrive from (search / AI / social /
// messaging / other / direct), classified from the referrer + UTM at the edge
// and folded per page. Same all-time snapshot machinery as the buckets above.
const CHANNEL_META: Record<string, { label: string; icon: string }> = {
  search: { label: L('Carian', 'Search', '搜索'), icon: '🔍' },
  ai: { label: L('Pembantu AI', 'AI assistants', 'AI 助手'), icon: '✨' },
  social: { label: L('Media sosial', 'Social', '社交媒体'), icon: '💬' },
  messaging: { label: L('Pemesejan', 'Messaging', '即时通讯'), icon: '📨' },
  other: { label: L('Laman lain', 'Other sites', '其他网站'), icon: '🌐' },
  direct: { label: L('Terus', 'Direct', '直接访问'), icon: '⤵' },
};
const CH_ORDER = ['search', 'ai', 'social', 'messaging', 'other', 'direct'];
const refByChannel = new Map<string, number>();
const refBySource = new Map<string, number>();
let refTotal = 0;
for (const row of Object.values(analytics)) {
  const ref = row.ref;
  if (!ref) continue;
  for (const [ch, n] of Object.entries(ref.byChannel ?? {})) { refByChannel.set(ch, (refByChannel.get(ch) ?? 0) + n); refTotal += n; }
  for (const [src, n] of Object.entries(ref.bySource ?? {})) refBySource.set(src, (refBySource.get(src) ?? 0) + n);
}
const refChannels = [...refByChannel.keys()]
  .sort((a, b) => CH_ORDER.indexOf(a) - CH_ORDER.indexOf(b))
  .map((id) => ({ id, label: CHANNEL_META[id]?.label ?? id, icon: CHANNEL_META[id]?.icon ?? '•', n: refByChannel.get(id) ?? 0 }));
const refChMax = Math.max(1, ...refChannels.map((c) => c.n));
const refSources = [...refBySource.entries()].filter(([s]) => s !== 'direct')
  .sort((a, b) => b[1] - a[1]).slice(0, 10).map(([source, n]) => ({ source, n }));
const refSourceMax = Math.max(1, ...refSources.map((s) => s.n));

// Google Search performance (archive: analytics/gsc.json) — trailing-90-day
// totals, impressions grouped to pillars from the per-category split, and top
// queries. Empty until the Search Console archive workflow has run.
const gsc = getSearchConsole();
const gscTotals = gsc.latest?.totals;
const gscHas = !!(gscTotals && (gscTotals.impressions || gscTotals.clicks));
const gscByPillar = new Map<string, { clicks: number; impressions: number }>();
for (const [cat, v] of Object.entries(gsc.latest?.byCategory ?? {})) {
  const pid = getPillar(cat) ?? 'understand';
  const e = gscByPillar.get(pid) ?? { clicks: 0, impressions: 0 };
  e.clicks += v.clicks; e.impressions += v.impressions;
  gscByPillar.set(pid, e);
}
const gscPillars = PILLARS.map((pd) => ({ id: pd.id, name: pd.name[locale], icon: pd.icon, ...(gscByPillar.get(pd.id) ?? { clicks: 0, impressions: 0 }) }))
  .filter((p) => p.impressions > 0).sort((a, b) => b.impressions - a.impressions);
const gscPillarMax = Math.max(1, ...gscPillars.map((p) => p.impressions));
const gscQueries = (gsc.latest?.topQueries ?? []).slice(0, 8);
const gscQueryMax = Math.max(1, ...gscQueries.map((q) => q.impressions));
const gscMonths = Object.keys(gsc.byMonth ?? {}).length;

// Facebook engagement (archive: analytics/facebook.json) — per-language Page numbers.
// Empty until the archive workflow has run and posts exist.
const fb = getFacebook();
const FB_LANG: Record<string, string> = { ms: 'Bahasa Malaysia', en: 'English', zh: '中文' };
const fbRows = (['ms', 'en', 'zh'] as const)
  .map((l) => {
    const p = fb.pages?.[l] ?? {};
    return { lang: l, label: p.name || `NegaraKu.md · ${FB_LANG[l]}`, pageId: p.pageId, followers: p.followers, posts: p.posts, reactions: p.reactions, comments: p.comments, shares: p.shares };
  })
  .filter((r) => r.pageId);
const fbTotals = fb.totals;
const fbHas = !!(fbTotals && (fbTotals.followers || fbTotals.posts || fbTotals.reactions || fbTotals.comments || fbTotals.shares));
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页'), href: localePath('/', locale) },
    { label: t('nav.dashboard', locale) },
  ]}
  title={t('nav.dashboard', locale)}
  desc={L(
    'Keadaan pangkalan pengetahuan NegaraKu.md — dikira semula pada setiap binaan.',
    'The state of the NegaraKu.md knowledge base — recomputed on every build.',
    'NegaraKu.md 知识库的现状——每次构建时重新计算。',
  )}
  stats={[
    { value: sections.length, label: L('tonggak', 'pillars', '支柱') },
    { value: catSet.size, label: L('kategori', 'categories', '分类') },
    { value: subcatSet.size, label: L('subkategori', 'subcategories', '子分类') },
    { value: totalTopics, label: L('topik', 'topics', '主题') },
  ]}
/>

<section class="container block">
  <div class="counters">
    <div>
      <b>{d.totals.masterArticles ?? d.totals.articles}</b>
      <span>{L('artikel induk', 'master articles', '主文章')}</span>
      <small>{L('satu setiap subjek', 'one per subject', '每个主题一篇')}</small>
    </div>
    <div>
      <b>{d.totals.files}</b>
      <span>{L('fail bahasa', 'language files', '语言文件')}</span>
      <small>MS {d.totals.filesByLang.ms} · EN {d.totals.filesByLang.en} · ZH {d.totals.filesByLang.zh}</small>
    </div>
    <div>
      <b>{d.trilingual.fullPct}%</b>
      <span>{L('tiga bahasa penuh', 'fully trilingual', '三语齐全')}</span>
      <small>{d.trilingual.full}/{d.trilingual.topics} {L('subjek', 'subjects', '主题')}</small>
    </div>
    <div>
      <b>{Math.round(((d.statusDist.published ?? 0) / (d.totals.masterArticles || 1)) * 100)}%</b>
      <span>{L('diterbitkan', 'published', '已发布')}</span>
      <small>{d.statusDist.published}/{d.totals.masterArticles} {L('subjek terbit', 'subjects live', '主题已上线')}</small>
    </div>
  </div>
</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Liputan tiga bahasa', 'Trilingual coverage', '三语覆盖')}</span></header>
    <div class="psec-body">
      {d.trilingual.one === 0 && d.trilingual.two === 0 ? (
        <p class="hint">
          {L(
            `Kesemua ${d.trilingual.topics} subjek terbit wujud dalam ketiga-tiga bahasa — liputan tiga bahasa penuh.`,
            `All ${d.trilingual.topics} published subjects exist in all three languages — full trilingual parity.`,
            `全部 ${d.trilingual.topics} 个已发布主题均具备三种语言——完整三语对等。`,
          )}
        </p>
      ) : (
        <>
          <p class="hint">
            {L(
              `Daripada ${d.trilingual.topics} subjek, ${d.trilingual.full} (${d.trilingual.fullPct}%) wujud dalam ketiga-tiga bahasa. Baki ${d.trilingual.one + d.trilingual.two} masih menunggu terjemahan penuh.`,
              `Of ${d.trilingual.topics} subjects, ${d.trilingual.full} (${d.trilingual.fullPct}%) exist in all three languages. The other ${d.trilingual.one + d.trilingual.two} still await full translation.`,
              `在 ${d.trilingual.topics} 个主题中，${d.trilingual.full} 个（${d.trilingual.fullPct}%）已具备三种语言。其余 ${d.trilingual.one + d.trilingual.two} 个仍待完整翻译。`,
            )}
          </p>
          <div class="tri-sum">
            <div class="tri-stat"><b>{d.trilingual.full}</b><span>{L('tiga bahasa', 'all three', '三语齐全')}</span></div>
            <div class="tri-stat"><b>{d.trilingual.two}</b><span>{L('dua bahasa', 'two languages', '两种语言')}</span></div>
            <div class="tri-stat"><b>{d.trilingual.one}</b><span>{L('satu bahasa', 'one language', '单一语言')}</span></div>
          </div>
        </>
      )}

      <p class="legend">
        <span class="key"><i class="sw src" /> {L('Ditulis asal (induk)', 'Authored here (master)', '原创（主语言）')}</span>
        <span class="key"><i class="sw tr" /> {L('Diterjemah', 'Translated', '翻译')}</span>
        <span class="key"><i class="sw miss" /> {L('Belum ada', 'Not yet', '尚缺')}</span>
      </p>

      <div class="langbars">
        {langBars.map((b) => (
          <div class="lb">
            <div class="lb-head">
              <span class="lb-code">{b.code}</span>
              <span class="lb-name">{b.name}</span>
              <span class="lb-fig">{b.have}<span class="of">/{b.total}</span></span>
            </div>
            <div class="lb-bar" role="img" aria-label={`${b.source} authored, ${b.translated} translated, ${b.missing} missing`}>
              {b.source > 0 && <span class="seg src" style={`width:${(b.source / b.total) * 100}%`} />}
              {b.translated > 0 && <span class="seg tr" style={`width:${(b.translated / b.total) * 100}%`} />}
              {b.missing > 0 && <span class="seg miss" style={`width:${(b.missing / b.total) * 100}%`} />}
            </div>
            <div class="lb-nums">
              <span class="src-t">{b.source} {L('asal', 'authored', '原创')}</span>
              <span class="tr-t">{b.translated} {L('terjemah', 'translated', '翻译')}</span>
              <span class="miss-t">{b.missing} {L('belum', 'missing', '尚缺')}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Klasifikasi kandungan', 'Content classification', '内容分类')}</span></header>
    <div class="psec-body">
      <p class="hint">
        {L(
          `${sensitiveCount} daripada ${totalTopics} subjek menyentuh domain sensitif Malaysia (seperti kaum, agama, institusi diraja dan perlembagaan) dan dilabel untuk semakan berhati-hati.`,
          `${sensitiveCount} of ${totalTopics} subjects touch Malaysia's sensitive domains (such as race, religion, royalty and the constitution) and are labelled for careful review.`,
          `${totalTopics} 个主题中有 ${sensitiveCount} 个涉及马来西亚的敏感领域（如种族、宗教、王室与宪法），已标注以便审慎审阅。`,
        )}
      </p>
      <div class="sens">
        {sensRows.map((s) => (
          <div class="sens-row">
            <span class="sens-label">{s.label}</span>
            <div class="track"><span class="fill" style={`width:${Math.max(2, s.pct)}%;background:${s.color}`} /></div>
            <span class="sens-val">{s.count} <span class="sp">· {s.pct}%</span></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Liputan mengikut kategori', 'Coverage by category', '各分类覆盖')}</span></header>
    <div class="psec-body cov">
      {sections.map((s) => (
        <div class="cov-sec">
          <p class="cov-head"><span class="cov-ico">{s.icon}</span> {s.name} <span class="cov-tot">{s.total}</span></p>
          <div class="cov-cats">
            {s.cats.map((c) => (
              <a class="cov-row" href={localePath(`/${c.id}`, locale)}>
                <span class="cov-name">{c.name}</span>
                <span class="track"><span class="fill" style={`width:${Math.max(3, Math.round((c.total / maxCat) * 100))}%`} /></span>
                <span class="cov-num">{c.total}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
      <p class="cov-more"><a href={localePath('/categories', locale)}>{L('Layari semua kategori', 'Browse all categories', '浏览所有分类')} →</a></p>
    </div>
  </div>
</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Perayap AI', 'AI crawlers', 'AI 爬虫')}</span></header>
    <div class="psec-body">
      {aiTotal === 0 ? (
        <p class="hint">{L('Belum ada lawatan perayap AI direkodkan lagi.', 'No AI-crawler visits recorded yet.', '尚未记录到 AI 爬虫访问。')}</p>
      ) : (
        <>
          <p class="hint">
            {L(
              `Perayap AI/LLM telah mengambil laman ini ${aiTotal.toLocaleString()} kali merentas ${aiPages.toLocaleString()} artikel, daripada ${aiBots.length} perayap berbeza — sepanjang masa.`,
              `AI/LLM crawlers have fetched this site ${aiTotal.toLocaleString()} times across ${aiPages.toLocaleString()} articles, from ${aiBots.length} distinct crawlers — all-time.`,
              `AI/LLM 爬虫已抓取本站 ${aiTotal.toLocaleString()} 次，覆盖 ${aiPages.toLocaleString()} 篇文章，来自 ${aiBots.length} 个不同的爬虫——累计。`,
            )}
          </p>
          <div class="ai-grid">
            <div>
              <p class="ai-h">{L('Mengikut perayap', 'By crawler', '按爬虫')}</p>
              <div class="cov-cats">
                {aiBots.map((b) => (
                  <div class="cov-row ai-row">
                    <span class="cov-name" title={b.bot}>{b.bot}</span>
                    <span class="track"><span class="fill" style={`width:${Math.max(3, Math.round((b.n / aiBotMax) * 100))}%`} /></span>
                    <span class="cov-num">{b.n.toLocaleString()}</span>
                  </div>
                ))}
              </div>
            </div>
            <div>
              <p class="ai-h">{L('Mengikut tunjang', 'By pillar', '按支柱')}</p>
              <div class="cov-cats">
                {aiPillars.map((p) => (
                  <div class="cov-row ai-row">
                    <span class="cov-name">{p.icon} {p.name}</span>
                    <span class="track"><span class="fill" style={`width:${Math.max(3, Math.round((p.n / aiPillarMax) * 100))}%`} /></span>
                    <span class="cov-num">{p.n.toLocaleString()}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
          <p class="ai-h ai-h-top">{L('Artikel paling banyak dirayapi', 'Most-crawled articles', '被抓取最多的文章')}</p>
          <div class="cov-cats ai-top">
            {aiTop.map((a) => (
              <a class="cov-row" href={localePath(`/${a.key}`, locale)}>
                <span class="cov-name" title={a.title}>{a.title}</span>
                <span class="track"><span class="fill" style={`width:${Math.max(3, Math.round((a.total / aiTopMax) * 100))}%`} /></span>
                <span class="cov-num">{a.total.toLocaleString()}</span>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </div>
</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Trafik mengikut saluran', 'Traffic by channel', '各渠道流量')}</span></header>
    <div class="psec-body">
      {refTotal === 0 ? (
        <p class="hint">{L(
          'Belum ada data rujukan — perekodan bermula setelah pengelas saluran digunakan di edge.',
          'No referral data yet — recording begins once the channel classifier is live at the edge.',
          '暂无来源数据——渠道分类器在边缘上线后开始记录。',
        )}</p>
      ) : (
        <>
          <p class="hint">{L(
            `${refTotal.toLocaleString()} lawatan pembaca dikelaskan mengikut asal rujukan — sepanjang masa.`,
            `${refTotal.toLocaleString()} reader visits classified by where they arrived from — all-time.`,
            `${refTotal.toLocaleString()} 次读者访问按来源渠道分类——累计。`,
          )}</p>
          <div class="ai-grid">
            <div>
              <p class="ai-h">{L('Mengikut saluran', 'By channel', '按渠道')}</p>
              <div class="cov-cats">
                {refChannels.map((c) => (
                  <div class="cov-row ai-row">
                    <span class="cov-name">{c.icon} {c.label}</span>
                    <span class="track"><span class="fill" style={`width:${Math.max(3, Math.round((c.n / refChMax) * 100))}%`} /></span>
                    <span class="cov-num">{c.n.toLocaleString()}</span>
                  </div>
                ))}
              </div>
            </div>
            <div>
              <p class="ai-h">{L('Sumber teratas', 'Top sources', '主要来源')}</p>
              {refSources.length === 0 ? (
                <p class="hint" style="margin:0">{L('Kebanyakannya trafik terus.', 'Mostly direct traffic.', '大多为直接访问。')}</p>
              ) : (
                <div class="cov-cats">
                  {refSources.map((s) => (
                    <div class="cov-row ai-row">
                      <span class="cov-name" title={s.source}>{s.source}</span>
                      <span class="track"><span class="fill" style={`width:${Math.max(3, Math.round((s.n / refSourceMax) * 100))}%`} /></span>
                      <span class="cov-num">{s.n.toLocaleString()}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </>
      )}
    </div>
  </div>
</section>

<section class="container block">
