              <p class="ai-h">{L('Tera mengikut tunjang', 'Impressions by pillar', '各支柱展示')}</p>
              {gscPillars.length === 0 ? <p class="hint" style="margin:0">—</p> : (
                <div class="cov-cats">
                  {gscPillars.map((p) => (
                    <div class="cov-row ai-row">
                      <span class="cov-name">{p.icon} {p.name}</span>
                      <span class="track"><span class="fill" style={`width:${Math.max(3, Math.round((p.impressions / gscPillarMax) * 100))}%`} /></span>
                      <span class="cov-num">{p.impressions.toLocaleString()}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
            <div>
              <p class="ai-h">{L('Carian teratas', 'Top queries', '热门搜索')}</p>
              {gscQueries.length === 0 ? <p class="hint" style="margin:0">—</p> : (
                <div class="cov-cats">
                  {gscQueries.map((q) => (
                    <div class="cov-row ai-row">
                      <span class="cov-name" title={q.query}>{q.query}</span>
                      <span class="track"><span class="fill" style={`width:${Math.max(3, Math.round((q.impressions / gscQueryMax) * 100))}%`} /></span>
                      <span class="cov-num">{q.impressions.toLocaleString()}</span>
