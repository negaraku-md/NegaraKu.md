---
import type { Locale } from '@/lib/categories';
import { getCategory, getPillar, getPillarDef, PILLARS, loc } from '@/lib/categories';
import { subcatLabel } from '@/lib/subcategories';
import { corpusTopics, isPublishable } from '@/lib/content';
import { getDashboard, getAnalytics, getFacebook, getSearchConsole, getBing } from '@/lib/apidata';
import { t, localePath } from '@/lib/i18n';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = getDashboard();
const L = (ms: string, en: string, zh: string, ta?: string) => (locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

// Per-language coverage rows for the language bars (master ms first).
const LANG_NAMES: Record<string, string> = { ms: 'Bahasa Malaysia', en: 'English', zh: '中文', ta: 'தமிழ்' };
const langBars = (['ms', 'en', 'zh', 'ta'] as const).map((l) => ({
  code: l.toUpperCase(),
  name: LANG_NAMES[l],
  ...d.perLangCoverage[l],
}));

// One pass over the corpus (deduped to one row per topic) drives three views:
// the knowledge-structure tree, the classification mix, and the sourcing totals.
type TopicNode = { count: number };
type CatNode = { total: number; topics: Map<string, TopicNode> };
type SecNode = { total: number; cats: Map<string, CatNode> };
const iaTree = new Map<string, SecNode>();
const seenTopics = new Set<string>();
const sensMix = new Map<string, number>();
const catSet = new Set<string>();
const subcatSet = new Set<string>();
let sources = 0;
let sourced = 0;
// LIVE corpus (isPublishable) — the SAME population build-dashboard.mjs computes
// its JSON size figures from, and the same one Explore/About/pillars use, so this
// page's tree, classification mix and hero reconcile with every other page. The
// in-review backlog is shown separately (lifecycle ladder), never in these totals.
for (const a of (await corpusTopics()).filter(isPublishable)) {
  const uid = `${a.data.category}/${a.data.slug}`;
  if (seenTopics.has(uid)) continue;
  seenTopics.add(uid);
  catSet.add(a.data.category);
  // Key topics by category/subcat (a topic is scoped to its category), matching
  // siteStats and the pillar pages so every "topics" figure reconciles.
  for (const s of a.data.subcategory) subcatSet.add(`${a.data.category}/${s}`);
  const pillar = getPillar(a.data.category) ?? 'understand';
  const topic = a.data.subcategory[0] ?? '—';
  const sens = a.data.sensitivity && a.data.sensitivity !== 'none' ? a.data.sensitivity : 'none';
  sensMix.set(sens, (sensMix.get(sens) ?? 0) + 1);
  const n = a.data.sources?.length ?? 0;
  sources += n;
  if (n > 0) sourced++;
  const sec = iaTree.get(pillar) ?? { total: 0, cats: new Map() };
  sec.total++;
  const cat = sec.cats.get(a.data.category) ?? { total: 0, topics: new Map() };
  cat.total++;
  const tn = cat.topics.get(topic) ?? { count: 0 };
  tn.count++;
  cat.topics.set(topic, tn);
  sec.cats.set(a.data.category, cat);
  iaTree.set(pillar, sec);
}
const totalTopics = seenTopics.size;

// Coverage by section → category, with a bar scaled to the biggest category.
const maxCat = Math.max(1, ...Object.values(d.perCategory));
const sections = PILLARS.map((pd) => {
  const sec = iaTree.get(pd.id);
  if (!sec) return null;
  const cats = [...sec.cats.entries()]
    .map(([cid, c]) => ({ id: cid, name: (() => { const _c = getCategory(cid); return _c ? loc(_c.name, locale) : cid; })(), total: c.total }))
    .sort((x, y) => y.total - x.total);
  return { id: pd.id, name: loc(pd.name, locale), icon: pd.icon, total: sec.total, cats };
}).filter((s): s is NonNullable<typeof s> => s !== null);

// Classification mix — the site's handling of Malaysia's sensitive domains.
const SENS_META: Record<string, { label: string; color: string }> = {
  none: { label: L('Umum', 'General', '一般', 'பொது'), color: 'var(--muted)' },
  royalty: { label: L('Institusi diraja', 'Royalty', '王室', 'அரச நிறுவனம்'), color: '#c084fc' },
  religion: { label: L('Agama', 'Religion', '宗教', 'மதம்'), color: '#60a5fa' },
  race: { label: L('Kaum', 'Race', '种族', 'இனம்'), color: '#f59e0b' },
  constitution: { label: L('Perlembagaan', 'Constitution', '宪法', 'அரசியலமைப்பு'), color: '#2dd4bf' },
  elections: { label: L('Pilihan raya', 'Elections', '选举', 'தேர்தல்'), color: '#818cf8' },
  security: { label: L('Keselamatan', 'Security', '安全', 'பாதுகாப்பு'), color: '#fb7185' },
  health: { label: L('Kesihatan', 'Health', '健康', 'சுகாதாரம்'), color: '#4ade80' },
  'legal-proceedings': { label: L('Perundangan', 'Legal', '法律', 'சட்டம்'), color: '#a3a3a3' },
};
const sensOrder = ['none', 'royalty', 'religion', 'race', 'constitution', 'elections', 'security', 'health', 'legal-proceedings'];
const sensRows = sensOrder
  .filter((k) => (sensMix.get(k) ?? 0) > 0)
  .map((k) => ({ key: k, ...SENS_META[k], count: sensMix.get(k) ?? 0, pct: Math.round(((sensMix.get(k) ?? 0) / totalTopics) * 100) }));
const sensitiveCount = totalTopics - (sensMix.get('none') ?? 0);
const avgSources = sourced ? (sources / sourced).toFixed(1) : '0';

// AI-crawler activity. The edge Worker tags every hit's bucket (readers/search/
// ai) + the crawler's canonical name; this rolls the per-page `ai` buckets up
// across the whole corpus — by crawler, by pillar, and the most-crawled
// articles — for the "AI crawlers" panel. All-time (snapshot + live tail).
const analytics = getAnalytics();
const titleByKey = new Map<string, string>();
for (const r of d.registry) titleByKey.set(`${r.category}/${r.slug}`, r.title[locale] ?? r.title.ms);
const aiTotalFor = (b: typeof analytics[string]['ai']) =>
  b == null ? 0 : typeof b === 'number' ? b : (b.total ?? 0);
let aiTotal = 0;
let aiPages = 0;
const aiByBot = new Map<string, number>();
const aiByPillar = new Map<string, number>();
const aiTopRaw: { key: string; total: number }[] = [];
for (const [key, row] of Object.entries(analytics)) {
  const total = aiTotalFor(row.ai);
  if (total <= 0) continue;
  aiTotal += total;
  aiPages++;
  aiTopRaw.push({ key, total });
  const byBot = row.ai && typeof row.ai !== 'number' ? (row.ai.byBot ?? {}) : {};
  for (const [bot, n] of Object.entries(byBot)) aiByBot.set(bot, (aiByBot.get(bot) ?? 0) + n);
  const pillar = getPillar(key.split('/')[0]) ?? 'understand';
  aiByPillar.set(pillar, (aiByPillar.get(pillar) ?? 0) + total);
}
const aiBots = [...aiByBot.entries()].sort((a, b) => b[1] - a[1]).map(([bot, n]) => ({ bot, n }));
const aiBotMax = Math.max(1, ...aiBots.map((b) => b.n));
const aiPillars = PILLARS.map((pd) => ({ id: pd.id, name: loc(pd.name, locale), icon: pd.icon, n: aiByPillar.get(pd.id) ?? 0 }))
  .filter((p) => p.n > 0)
  .sort((a, b) => b.n - a.n);
const aiPillarMax = Math.max(1, ...aiPillars.map((p) => p.n));
const aiTop = aiTopRaw.sort((a, b) => b.total - a.total).slice(0, 8)
  .map((x) => ({ ...x, title: titleByKey.get(x.key) ?? x.key }));
const aiTopMax = Math.max(1, ...aiTop.map((x) => x.total));

// Traffic by channel — where human readers arrive from (search / AI / social /
// messaging / other / direct), classified from the referrer + UTM at the edge
// and folded per page. Same all-time snapshot machinery as the buckets above.
const CHANNEL_META: Record<string, { label: string; icon: string }> = {
  search: { label: L('Carian', 'Search', '搜索', 'தேடல்'), icon: '🔍' },
  ai: { label: L('Pembantu AI', 'AI assistants', 'AI 助手', 'AI உதவியாளர்கள்'), icon: '✨' },
  social: { label: L('Media sosial', 'Social', '社交媒体', 'சமூக ஊடகம்'), icon: '💬' },
  messaging: { label: L('Pemesejan', 'Messaging', '即时通讯', 'செய்தியிடல்'), icon: '📨' },
  other: { label: L('Laman lain', 'Other sites', '其他网站', 'பிற தளங்கள்'), icon: '🌐' },
  direct: { label: L('Terus', 'Direct', '直接访问', 'நேரடி'), icon: '⤵' },
};
const CH_ORDER = ['search', 'ai', 'social', 'messaging', 'other', 'direct'];
const refByChannel = new Map<string, number>();
const refBySource = new Map<string, number>();
let refTotal = 0;
for (const row of Object.values(analytics)) {
  const ref = row.ref;
  if (!ref) continue;
  for (const [ch, n] of Object.entries(ref.byChannel ?? {})) { refByChannel.set(ch, (refByChannel.get(ch) ?? 0) + n); refTotal += n; }
  for (const [src, n] of Object.entries(ref.bySource ?? {})) refBySource.set(src, (refBySource.get(src) ?? 0) + n);
}
const refChannels = [...refByChannel.keys()]
  .sort((a, b) => CH_ORDER.indexOf(a) - CH_ORDER.indexOf(b))
  .map((id) => ({ id, label: CHANNEL_META[id]?.label ?? id, icon: CHANNEL_META[id]?.icon ?? '•', n: refByChannel.get(id) ?? 0 }));
const refChMax = Math.max(1, ...refChannels.map((c) => c.n));
const refSources = [...refBySource.entries()].filter(([s]) => s !== 'direct')
  .sort((a, b) => b[1] - a[1]).slice(0, 10).map(([source, n]) => ({ source, n }));
const refSourceMax = Math.max(1, ...refSources.map((s) => s.n));

// Google Search performance (archive: analytics/gsc.json) — trailing-90-day
// totals, impressions grouped to pillars from the per-category split, and top
// queries. Empty until the Search Console archive workflow has run.
const gsc = getSearchConsole();
const gscTotals = gsc.latest?.totals;
const gscHas = !!(gscTotals && (gscTotals.impressions || gscTotals.clicks));
const gscByPillar = new Map<string, { clicks: number; impressions: number }>();
for (const [cat, v] of Object.entries(gsc.latest?.byCategory ?? {})) {
  const pid = getPillar(cat) ?? 'understand';
  const e = gscByPillar.get(pid) ?? { clicks: 0, impressions: 0 };
  e.clicks += v.clicks; e.impressions += v.impressions;
  gscByPillar.set(pid, e);
}
const gscPillars = PILLARS.map((pd) => ({ id: pd.id, name: loc(pd.name, locale), icon: pd.icon, ...(gscByPillar.get(pd.id) ?? { clicks: 0, impressions: 0 }) }))
  .filter((p) => p.impressions > 0).sort((a, b) => b.impressions - a.impressions);
const gscPillarMax = Math.max(1, ...gscPillars.map((p) => p.impressions));
const gscQueries = (gsc.latest?.topQueries ?? []).slice(0, 8);
const gscQueryMax = Math.max(1, ...gscQueries.map((q) => q.impressions));
const gscMonths = Object.keys(gsc.byMonth ?? {}).length;

// Facebook engagement (archive: analytics/facebook.json) — per-language Page numbers.
// Empty until the archive workflow has run and posts exist.
const fb = getFacebook();
const FB_LANG: Record<string, string> = { ms: 'Bahasa Malaysia', en: 'English', zh: '中文', ta: 'தமிழ்' };
const fbRows = (['ms', 'en', 'zh'] as const)
  .map((l) => {
    const p = fb.pages?.[l] ?? {};
    return { lang: l, label: p.name || `NegaraKu.md · ${FB_LANG[l]}`, pageId: p.pageId, followers: p.followers, posts: p.posts, reactions: p.reactions, comments: p.comments, shares: p.shares };
  })
  .filter((r) => r.pageId);
const fbTotals = fb.totals;
const fbHas = !!(fbTotals && (fbTotals.followers || fbTotals.posts || fbTotals.reactions || fbTotals.comments || fbTotals.shares));

// On-site engagement (beacon → analytics.json.engage per article): avg dwell +
// scroll, sample-weighted overall and by pillar; most-engaging articles by dwell.
const fmtDur = (sec: number) => (sec >= 60 ? `${Math.floor(sec / 60)}m ${sec % 60}s` : `${sec}s`);
let engSecsW = 0, engScrollW = 0, engSamples = 0;
const engByPillar = new Map<string, { secsW: number; n: number }>();
const engPagesRaw: { key: string; avgSeconds: number; avgScroll: number; samples: number }[] = [];
for (const [key, row] of Object.entries(analytics)) {
  const e = row.engage;
  if (!e || !e.samples) continue;
  engSamples += e.samples;
  engSecsW += e.avgSeconds * e.samples;
  engScrollW += e.avgScroll * e.samples;
  engPagesRaw.push({ key, ...e });
  const pid = getPillar(key.split('/')[0]) ?? 'understand';
  const pp = engByPillar.get(pid) ?? { secsW: 0, n: 0 };
  pp.secsW += e.avgSeconds * e.samples; pp.n += e.samples;
  engByPillar.set(pid, pp);
}
const engHas = engSamples > 0;
const engAvgSecs = engHas ? Math.round(engSecsW / engSamples) : 0;
const engAvgScroll = engHas ? Math.round(engScrollW / engSamples) : 0;
const engPillars = PILLARS.map((pd) => {
  const p = engByPillar.get(pd.id);
  return { id: pd.id, name: loc(pd.name, locale), icon: pd.icon, avg: p && p.n ? Math.round(p.secsW / p.n) : 0 };
}).filter((p) => p.avg > 0).sort((a, b) => b.avg - a.avg);
const engPillarMax = Math.max(1, ...engPillars.map((p) => p.avg));
const engTop = engPagesRaw.sort((a, b) => b.avgSeconds - a.avgSeconds).slice(0, 8)
  .map((x) => ({ ...x, title: titleByKey.get(x.key) ?? x.key }));
const engTopMax = Math.max(1, ...engTop.map((x) => x.avgSeconds));

// Bing Webmaster (archive: analytics/bing.json) — also backs Copilot & ChatGPT-search.
const bing = getBing();
const bingT = bing.latest?.totals;
const bingHas = !!(bingT && (bingT.impressions || bingT.clicks));
const bingQueries = (bing.latest?.topQueries ?? []).slice(0, 8);
const bingQueryMax = Math.max(1, ...bingQueries.map((q) => q.impressions));
const bingMonths = Object.keys(bing.byMonth ?? {}).length;
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு'), href: localePath('/', locale) },
    { label: t('nav.dashboard', locale) },
  ]}
  title={t('nav.dashboard', locale)}
  desc={L(
    'Keadaan pangkalan pengetahuan NegaraKu.md — dikira semula pada setiap binaan.',
    'The state of the NegaraKu.md knowledge base — recomputed on every build.',
    'NegaraKu.md 知识库的现状——每次构建时重新计算。',
    'NegaraKu.md அறிவுத் தளத்தின் நிலை — ஒவ்வொரு பதிப்பிலும் மீள்கணிக்கப்படுகிறது.',
  )}
  stats={[
    { value: sections.length, label: L('tonggak', 'pillars', '支柱', 'தூண்கள்') },
    { value: catSet.size, label: L('kategori', 'categories', '分类', 'வகைகள்') },
    { value: subcatSet.size, label: L('subkategori', 'subcategories', '子分类', 'துணை வகைகள்') },
    { value: totalTopics, label: L('topik', 'topics', '主题', 'தலைப்புகள்') },
  ]}
/>

<section class="container block">
  <div class="counters">
    <div>
      <b>{d.totals.masterArticles ?? d.totals.articles}</b>
      <span>{L('artikel induk', 'master articles', '主文章', 'முதன்மைக் கட்டுரைகள்')}</span>
      <small>{L('satu setiap subjek', 'one per subject', '每个主题一篇', 'ஒவ்வொரு தலைப்புக்கும் ஒன்று')}</small>
    </div>
    <div>
      <b>{d.totals.files}</b>
      <span>{L('fail bahasa', 'language files', '语言文件', 'மொழி கோப்புகள்')}</span>
      <small>MS {d.totals.filesByLang.ms} · EN {d.totals.filesByLang.en} · ZH {d.totals.filesByLang.zh}</small>
    </div>
    <div>
      <b>{d.trilingual.fullPct}%</b>
      <span>{L('semua bahasa penuh', 'fully localized', '各语言齐全', 'அனைத்து மொழிகளும்')}</span>
      <small>{d.trilingual.full}/{d.trilingual.topics} {L('subjek', 'subjects', '主题', 'தலைப்புகள்')}</small>
    </div>
    <div>
      <b>{Math.round(((d.statusDist.published ?? 0) / (d.totals.masterArticles || 1)) * 100)}%</b>
      <span>{L('diterbitkan', 'published', '已发布', 'வெளியிடப்பட்டது')}</span>
      <small>{d.statusDist.published}/{d.totals.masterArticles} {L('subjek terbit', 'subjects live', '主题已上线', 'தலைப்புகள் நேரலையில்')}</small>
    </div>
  </div>
</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Liputan bahasa', 'Language coverage', '语言覆盖', 'மொழி பரப்பு')}</span></header>
    <div class="psec-body">
      {d.trilingual.one === 0 && d.trilingual.two === 0 ? (
        <p class="hint">
          {L(
            `Kesemua ${d.trilingual.topics} subjek terbit wujud dalam kesemua ${d.trilingual.langCount} bahasa — liputan bahasa penuh.`,
            `All ${d.trilingual.topics} published subjects exist in all ${d.trilingual.langCount} languages — full parity.`,
            `全部 ${d.trilingual.topics} 个已发布主题均具备全部 ${d.trilingual.langCount} 种语言——完整语言对等。`,
            `வெளியிடப்பட்ட ${d.trilingual.topics} தலைப்புகளும் அனைத்து ${d.trilingual.langCount} மொழிகளிலும் உள்ளன — முழு மொழி இணைநிலை.`,
          )}
        </p>
      ) : (
        <>
          <p class="hint">
            {L(
              `Daripada ${d.trilingual.topics} subjek, ${d.trilingual.full} (${d.trilingual.fullPct}%) wujud dalam kesemua ${d.trilingual.langCount} bahasa. Baki ${d.trilingual.one + d.trilingual.two} masih menunggu terjemahan penuh.`,
              `Of ${d.trilingual.topics} subjects, ${d.trilingual.full} (${d.trilingual.fullPct}%) exist in all ${d.trilingual.langCount} languages. The other ${d.trilingual.one + d.trilingual.two} still await full translation.`,
              `在 ${d.trilingual.topics} 个主题中，${d.trilingual.full} 个（${d.trilingual.fullPct}%）已具备全部 ${d.trilingual.langCount} 种语言。其余 ${d.trilingual.one + d.trilingual.two} 个仍待完整翻译。`,
              `${d.trilingual.topics} தலைப்புகளில், ${d.trilingual.full} (${d.trilingual.fullPct}%) அனைத்து ${d.trilingual.langCount} மொழிகளிலும் உள்ளன. மீதமுள்ள ${d.trilingual.one + d.trilingual.two} இன்னும் முழு மொழிபெயர்ப்புக்குக் காத்திருக்கின்றன.`,
            )}
          </p>
          <div class="tri-sum">
            <div class="tri-stat"><b>{d.trilingual.full}</b><span>{L('semua bahasa', 'all languages', '全部语言', 'எல்லா மொழியும்')}</span></div>
            <div class="tri-stat"><b>{d.trilingual.two}</b><span>{L('dua bahasa', 'two languages', '两种语言', 'இரு மொழிகள்')}</span></div>
            <div class="tri-stat"><b>{d.trilingual.one}</b><span>{L('satu bahasa', 'one language', '单一语言', 'ஒரு மொழி')}</span></div>
          </div>
        </>
      )}

      <p class="legend">
        <span class="key"><i class="sw src" /> {L('Ditulis asal (induk)', 'Authored here (master)', '原创（主语言）', 'இங்கு எழுதப்பட்டது (முதன்மை)')}</span>
        <span class="key"><i class="sw tr" /> {L('Diterjemah', 'Translated', '翻译', 'மொழிபெயர்க்கப்பட்டது')}</span>
        <span class="key"><i class="sw miss" /> {L('Belum ada', 'Not yet', '尚缺', 'இன்னும் இல்லை')}</span>
      </p>

      <div class="langbars">
        {langBars.map((b) => (
          <div class="lb">
            <div class="lb-head">
              <span class="lb-code">{b.code}</span>
              <span class="lb-name">{b.name}</span>
              <span class="lb-fig">{b.have}<span class="of">/{b.total}</span></span>
            </div>
            <div class="lb-bar" role="img" aria-label={`${b.source} authored, ${b.translated} translated, ${b.missing} missing`}>
              {b.source > 0 && <span class="seg src" style={`width:${(b.source / b.total) * 100}%`} />}
              {b.translated > 0 && <span class="seg tr" style={`width:${(b.translated / b.total) * 100}%`} />}
              {b.missing > 0 && <span class="seg miss" style={`width:${(b.missing / b.total) * 100}%`} />}
            </div>
            <div class="lb-nums">
              <span class="src-t">{b.source} {L('asal', 'authored', '原创', 'எழுதப்பட்டது')}</span>
              <span class="tr-t">{b.translated} {L('terjemah', 'translated', '翻译', 'மொழிபெயர்ப்பு')}</span>
              <span class="miss-t">{b.missing} {L('belum', 'missing', '尚缺', 'இல்லை')}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Klasifikasi kandungan', 'Content classification', '内容分类', 'உள்ளடக்க வகைப்பாடு')}</span></header>
