</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Penglibatan Facebook', 'Facebook engagement', 'Facebook 互动')}</span></header>
    <div class="psec-body">
      {!fbHas ? (
        <p class="hint">{L(
          'Belum ada data Facebook — muncul selepas kerja arkib dijalankan dan artikel diterbitkan.',
          'No Facebook data yet — appears after the archive workflow runs and articles are published.',
          '暂无 Facebook 数据——归档工作流运行且文章发布后显示。',
