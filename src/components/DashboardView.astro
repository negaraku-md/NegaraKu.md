        <div class="matrix-scroll" style="margin-top:.3rem">
          <table class="fbtable">
            <thead>
              <tr>
                <th class="chan" style="width:auto">{L('Halaman', 'Page', '页面')}</th>
                <th>{L('Pengikut', 'Followers', '粉丝')}</th>
                <th>{L('Siaran', 'Posts', '帖子')}</th>
                <th>{L('Reaksi', 'Reactions', '互动')}</th>
                <th>{L('Komen', 'Comments', '评论')}</th>
                <th>{L('Kongsi', 'Shares', '分享')}</th>
