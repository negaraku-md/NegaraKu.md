---
import type { Locale } from '@/lib/categories';
import { getCategory, getPillar, PILLARS, loc } from '@/lib/categories';
import { corpusTopics, isPublishable } from '@/lib/content';
import { getDashboard } from '@/lib/apidata';
import { t, localePath } from '@/lib/i18n';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = getDashboard();
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string) => (locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

// Per-language coverage rows for the language bars (master ms first).
const LANG_NAMES: Record<string, string> = { ms: 'Bahasa Malaysia', en: 'English', zh: '中文', ta: 'தமிழ்', ja: '日本語', ko: '한국어' };
const langBars = (['ms', 'en', 'zh', 'ta', 'ja', 'ko'] as const).map((l) => ({
  code: l.toUpperCase(),
  name: LANG_NAMES[l],
  ...d.perLangCoverage[l],
}));

// One pass over the corpus (deduped to one row per topic) drives three views:
// the knowledge-structure tree, the classification mix, and the sourcing totals.
type TopicNode = { count: number };
type CatNode = { total: number; topics: Map<string, TopicNode> };
type SecNode = { total: number; cats: Map<string, CatNode> };
const iaTree = new Map<string, SecNode>();
const seenTopics = new Set<string>();
const sensMix = new Map<string, number>();
const catSet = new Set<string>();
const subcatSet = new Set<string>();
let sources = 0;
let sourced = 0;
// LIVE corpus (isPublishable) — the SAME population build-dashboard.mjs computes
// its JSON size figures from, and the same one Explore/About/pillars use, so this
// page's tree, classification mix and hero reconcile with every other page. The
// in-review backlog is shown separately (lifecycle ladder), never in these totals.
for (const a of (await corpusTopics()).filter(isPublishable)) {
  const uid = `${a.data.category}/${a.data.slug}`;
  if (seenTopics.has(uid)) continue;
  seenTopics.add(uid);
  catSet.add(a.data.category);
  // Key topics by category/subcat (a topic is scoped to its category), matching
  // siteStats and the pillar pages so every "topics" figure reconciles.
  for (const s of a.data.subcategory) subcatSet.add(`${a.data.category}/${s}`);
  const pillar = getPillar(a.data.category) ?? 'understand';
  const topic = a.data.subcategory[0] ?? '—';
  const sens = a.data.sensitivity && a.data.sensitivity !== 'none' ? a.data.sensitivity : 'none';
  sensMix.set(sens, (sensMix.get(sens) ?? 0) + 1);
  const n = a.data.sources?.length ?? 0;
  sources += n;
  if (n > 0) sourced++;
  const sec = iaTree.get(pillar) ?? { total: 0, cats: new Map() };
  sec.total++;
  const cat = sec.cats.get(a.data.category) ?? { total: 0, topics: new Map() };
  cat.total++;
  const tn = cat.topics.get(topic) ?? { count: 0 };
  tn.count++;
  cat.topics.set(topic, tn);
  sec.cats.set(a.data.category, cat);
  iaTree.set(pillar, sec);
}
const totalTopics = seenTopics.size;

// Coverage by section → category, with a bar scaled to the biggest category.
const maxCat = Math.max(1, ...Object.values(d.perCategory));
const sections = PILLARS.map((pd) => {
  const sec = iaTree.get(pd.id);
  if (!sec) return null;
  const cats = [...sec.cats.entries()]
    .map(([cid, c]) => ({ id: cid, name: (() => { const _c = getCategory(cid); return _c ? loc(_c.name, locale) : cid; })(), total: c.total }))
    .sort((x, y) => y.total - x.total);
  return { id: pd.id, name: loc(pd.name, locale), icon: pd.icon, total: sec.total, cats };
}).filter((s): s is NonNullable<typeof s> => s !== null);

// Classification mix — the site's handling of Malaysia's sensitive domains.
const SENS_META: Record<string, { label: string; color: string }> = {
  none: { label: L('Umum', 'General', '一般', 'பொது', '一般', '일반'), color: 'var(--muted)' },
  royalty: { label: L('Institusi diraja', 'Royalty', '王室', 'அரச நிறுவனம்', '王室', '왕실'), color: '#c084fc' },
  religion: { label: L('Agama', 'Religion', '宗教', 'மதம்', '宗教', '종교'), color: '#60a5fa' },
  race: { label: L('Kaum', 'Race', '种族', 'இனம்', '人種', '인종'), color: '#f59e0b' },
  constitution: { label: L('Perlembagaan', 'Constitution', '宪法', 'அரசியலமைப்பு', '憲法', '헌법'), color: '#2dd4bf' },
  elections: { label: L('Pilihan raya', 'Elections', '选举', 'தேர்தல்', '選挙', '선거'), color: '#818cf8' },
  security: { label: L('Keselamatan', 'Security', '安全', 'பாதுகாப்பு', '安全保障', '안보'), color: '#fb7185' },
  health: { label: L('Kesihatan', 'Health', '健康', 'சுகாதாரம்', '健康', '건강'), color: '#4ade80' },
  'legal-proceedings': { label: L('Perundangan', 'Legal', '法律', 'சட்டம்', '法律', '법률'), color: '#a3a3a3' },
};
const sensOrder = ['none', 'royalty', 'religion', 'race', 'constitution', 'elections', 'security', 'health', 'legal-proceedings'];
const sensRows = sensOrder
  .filter((k) => (sensMix.get(k) ?? 0) > 0)
  .map((k) => ({ key: k, ...SENS_META[k], count: sensMix.get(k) ?? 0, pct: Math.round(((sensMix.get(k) ?? 0) / totalTopics) * 100) }));
const sensitiveCount = totalTopics - (sensMix.get('none') ?? 0);
const avgSources = sourced ? (sources / sourced).toFixed(1) : '0';


---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム', '홈'), href: localePath('/', locale) },
    { label: t('nav.dashboard', locale) },
  ]}
  title={t('nav.dashboard', locale)}
  desc={L(
    'Keadaan pangkalan pengetahuan NegaraKu.md — dikira semula pada setiap binaan.',
    'The state of the NegaraKu.md knowledge base — recomputed on every build.',
    'NegaraKu.md 知识库的现状——每次构建时重新计算。',
    'NegaraKu.md அறிவுத் தளத்தின் நிலை — ஒவ்வொரு பதிப்பிலும் மீள்கணிக்கப்படுகிறது.',
    'NegaraKu.md 知識ベースの現状 — ビルドのたびに再計算されます。',
    'NegaraKu.md 지식 베이스의 현황 — 빌드할 때마다 다시 계산됩니다.',
  )}
  stats={[
    { value: sections.length, label: L('tonggak', 'pillars', '支柱', 'தூண்கள்', '柱', '기둥') },
    { value: catSet.size, label: L('kategori', 'categories', '分类', 'வகைகள்', 'カテゴリー', '카테고리') },
    { value: subcatSet.size, label: L('subkategori', 'subcategories', '子分类', 'துணை வகைகள்', 'サブカテゴリー', '하위 카테고리') },
    { value: totalTopics, label: L('topik', 'topics', '主题', 'தலைப்புகள்', '主題', '주제') },
  ]}
/>

<section class="container block">
  <div class="counters">
    <div>
      <b>{d.totals.masterArticles ?? d.totals.articles}</b>
      <span>{L('artikel induk', 'master articles', '主文章', 'முதன்மைக் கட்டுரைகள்', 'マスター記事', '마스터 기사')}</span>
      <small>{L('satu setiap subjek', 'one per subject', '每个主题一篇', 'ஒவ்வொரு தலைப்புக்கும் ஒன்று', '主題ごとに1つ', '주제당 하나')}</small>
    </div>
    <div>
      <b>{d.totals.files}</b>
      <span>{L('fail bahasa', 'language files', '语言文件', 'மொழி கோப்புகள்', '言語ファイル', '언어 파일')}</span>
      <small>MS {d.totals.filesByLang.ms} · EN {d.totals.filesByLang.en} · ZH {d.totals.filesByLang.zh}</small>
    </div>
    <div>
      <b>{d.trilingual.fullPct}%</b>
      <span>{L('semua bahasa penuh', 'fully localized', '各语言齐全', 'அனைத்து மொழிகளும்', '全言語対応', '전체 언어 완비')}</span>
      <small>{d.trilingual.full}/{d.trilingual.topics} {L('subjek', 'subjects', '主题', 'தலைப்புகள்', '主題', '주제')}</small>
    </div>
    <div>
      <b>{Math.round(((d.statusDist.published ?? 0) / (d.totals.masterArticles || 1)) * 100)}%</b>
      <span>{L('diterbitkan', 'published', '已发布', 'வெளியிடப்பட்டது', '公開済み', '공개됨')}</span>
      <small>{d.statusDist.published}/{d.totals.masterArticles} {L('subjek terbit', 'subjects live', '主题已上线', 'தலைப்புகள் நேரலையில்', '公開中の主題', '공개된 주제')}</small>
    </div>
  </div>
  <p class="xlink"><a href={localePath('/analytics', locale)}>{L(
    'Trafik, carian, AI & jangkauan → halaman Analitik',
    'Traffic, search, AI & reach → the Analytics page',
    '流量、搜索、AI 与触达 → 分析页面',
    'போக்குவரத்து, தேடல், AI & எட்டல் → பகுப்பாய்வு பக்கம்',
    'トラフィック・検索・AI・リーチ → アナリティクス',
    '트래픽, 검색, AI & 도달 → 분석 페이지',
  )} →</a></p>
</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Liputan bahasa', 'Language coverage', '语言覆盖', 'மொழி பரப்பு', '言語カバレッジ', '언어 커버리지')}</span></header>
    <div class="psec-body">
      {d.trilingual.one === 0 && d.trilingual.two === 0 ? (
        <p class="hint">
          {L(
            `Kesemua ${d.trilingual.topics} subjek terbit wujud dalam kesemua ${d.trilingual.langCount} bahasa — liputan bahasa penuh.`,
            `All ${d.trilingual.topics} published subjects exist in all ${d.trilingual.langCount} languages — full parity.`,
            `全部 ${d.trilingual.topics} 个已发布主题均具备全部 ${d.trilingual.langCount} 种语言——完整语言对等。`,
            `வெளியிடப்பட்ட ${d.trilingual.topics} தலைப்புகளும் அனைத்து ${d.trilingual.langCount} மொழிகளிலும் உள்ளன — முழு மொழி இணைநிலை.`,
            `公開済みの ${d.trilingual.topics} 主題すべてが ${d.trilingual.langCount} 言語すべてに存在します — 完全な言語対等。`,
            `공개된 ${d.trilingual.topics}개 주제 전체가 ${d.trilingual.langCount}개 언어 모두에 존재합니다 — 완전한 언어 대등.`,
          )}
        </p>
      ) : (
        <>
          <p class="hint">
            {L(
              `Daripada ${d.trilingual.topics} subjek, ${d.trilingual.full} (${d.trilingual.fullPct}%) wujud dalam kesemua ${d.trilingual.langCount} bahasa. Baki ${d.trilingual.one + d.trilingual.two} masih menunggu terjemahan penuh.`,
              `Of ${d.trilingual.topics} subjects, ${d.trilingual.full} (${d.trilingual.fullPct}%) exist in all ${d.trilingual.langCount} languages. The other ${d.trilingual.one + d.trilingual.two} still await full translation.`,
              `在 ${d.trilingual.topics} 个主题中，${d.trilingual.full} 个（${d.trilingual.fullPct}%）已具备全部 ${d.trilingual.langCount} 种语言。其余 ${d.trilingual.one + d.trilingual.two} 个仍待完整翻译。`,
              `${d.trilingual.topics} தலைப்புகளில், ${d.trilingual.full} (${d.trilingual.fullPct}%) அனைத்து ${d.trilingual.langCount} மொழிகளிலும் உள்ளன. மீதமுள்ள ${d.trilingual.one + d.trilingual.two} இன்னும் முழு மொழிபெயர்ப்புக்குக் காத்திருக்கின்றன.`,
              `${d.trilingual.topics} 主題のうち、${d.trilingual.full} 件（${d.trilingual.fullPct}%）が ${d.trilingual.langCount} 言語すべてに存在します。残りの ${d.trilingual.one + d.trilingual.two} 件はまだ完全な翻訳待ちです。`,
              `${d.trilingual.topics}개 주제 중 ${d.trilingual.full}개(${d.trilingual.fullPct}%)가 ${d.trilingual.langCount}개 언어 모두에 존재합니다. 나머지 ${d.trilingual.one + d.trilingual.two}개는 아직 완전한 번역을 기다리고 있습니다.`,
            )}
          </p>
          <div class="tri-sum">
            <div class="tri-stat"><b>{d.trilingual.full}</b><span>{L('semua bahasa', 'all languages', '全部语言', 'எல்லா மொழியும்', '全言語', '전체 언어')}</span></div>
            <div class="tri-stat"><b>{d.trilingual.two}</b><span>{L('dua bahasa', 'two languages', '两种语言', 'இரு மொழிகள்', '2言語', '2개 언어')}</span></div>
            <div class="tri-stat"><b>{d.trilingual.one}</b><span>{L('satu bahasa', 'one language', '单一语言', 'ஒரு மொழி', '1言語', '1개 언어')}</span></div>
          </div>
        </>
      )}

      <p class="legend">
        <span class="key"><i class="sw src" /> {L('Ditulis asal (induk)', 'Authored here (master)', '原创（主语言）', 'இங்கு எழுதப்பட்டது (முதன்மை)', 'ここで執筆（マスター）', '여기서 집필(마스터)')}</span>
        <span class="key"><i class="sw tr" /> {L('Diterjemah', 'Translated', '翻译', 'மொழிபெயர்க்கப்பட்டது', '翻訳済み', '번역됨')}</span>
        <span class="key"><i class="sw miss" /> {L('Belum ada', 'Not yet', '尚缺', 'இன்னும் இல்லை', '未対応', '아직 없음')}</span>
      </p>

      <div class="langbars">
        {langBars.map((b) => (
          <div class="lb">
            <div class="lb-head">
              <span class="lb-code">{b.code}</span>
              <span class="lb-name">{b.name}</span>
              <span class="lb-fig">{b.have}<span class="of">/{b.total}</span></span>
            </div>
            <div class="lb-bar" role="img" aria-label={`${b.source} authored, ${b.translated} translated, ${b.missing} missing`}>
              {b.source > 0 && <span class="seg src" style={`width:${(b.source / b.total) * 100}%`} />}
              {b.translated > 0 && <span class="seg tr" style={`width:${(b.translated / b.total) * 100}%`} />}
              {b.missing > 0 && <span class="seg miss" style={`width:${(b.missing / b.total) * 100}%`} />}
            </div>
            <div class="lb-nums">
              <span class="src-t">{b.source} {L('asal', 'authored', '原创', 'எழுதப்பட்டது', '執筆', '집필')}</span>
              <span class="tr-t">{b.translated} {L('terjemah', 'translated', '翻译', 'மொழிபெயர்ப்பு', '翻訳', '번역')}</span>
              <span class="miss-t">{b.missing} {L('belum', 'missing', '尚缺', 'இல்லை', '未対応', '없음')}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Klasifikasi kandungan', 'Content classification', '内容分类', 'உள்ளடக்க வகைப்பாடு', 'コンテンツ分類', '콘텐츠 분류')}</span></header>
    <div class="psec-body">
      <p class="hint">
        {L(
          `${sensitiveCount} daripada ${totalTopics} subjek menyentuh domain sensitif Malaysia (seperti kaum, agama, institusi diraja dan perlembagaan) dan dilabel untuk semakan berhati-hati.`,
          `${sensitiveCount} of ${totalTopics} subjects touch Malaysia's sensitive domains (such as race, religion, royalty and the constitution) and are labelled for careful review.`,
          `${totalTopics} 个主题中有 ${sensitiveCount} 个涉及马来西亚的敏感领域（如种族、宗教、王室与宪法），已标注以便审慎审阅。`,
          `${totalTopics} தலைப்புகளில் ${sensitiveCount} மலேசியாவின் உணர்வுபூர்வமான துறைகளைத் (இனம், மதம், அரச நிறுவனம், அரசியலமைப்பு போன்றவை) தொடுகின்றன, மேலும் கவனமான மறுஆய்வுக்காக அடையாளமிடப்பட்டுள்ளன.`,
          `${totalTopics} 主題のうち ${sensitiveCount} 件がマレーシアのデリケートな領域（人種、宗教、王室、憲法など）に触れており、慎重なレビューのため区分されています。`,
          `${totalTopics}개 주제 중 ${sensitiveCount}개가 말레이시아의 민감한 영역(인종, 종교, 왕실, 헌법 등)을 다루며 신중한 검토를 위해 분류되어 있습니다.`,
        )}
      </p>
      <div class="sens">
        {sensRows.map((s) => (
          <div class="sens-row">
            <span class="sens-label">{s.label}</span>
            <div class="track"><span class="fill" style={`width:${Math.max(2, s.pct)}%;background:${s.color}`} /></div>
            <span class="sens-val">{s.count} <span class="sp">· {s.pct}%</span></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Liputan mengikut kategori', 'Coverage by category', '各分类覆盖', 'வகை வாரியான பரப்பு', 'カテゴリー別カバレッジ', '카테고리별 커버리지')}</span></header>
    <div class="psec-body cov">
      {sections.map((s) => (
        <div class="cov-sec">
          <p class="cov-head"><span class="cov-ico">{s.icon}</span> {s.name} <span class="cov-tot">{s.total}</span></p>
          <div class="cov-cats">
            {s.cats.map((c) => (
              <a class="cov-row" href={localePath(`/${c.id}`, locale)}>
                <span class="cov-name">{c.name}</span>
                <span class="track"><span class="fill" style={`width:${Math.max(3, Math.round((c.total / maxCat) * 100))}%`} /></span>
                <span class="cov-num">{c.total}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
      <p class="cov-more"><a href={localePath('/categories', locale)}>{L('Layari semua kategori', 'Browse all categories', '浏览所有分类', 'அனைத்து வகைகளையும் உலாவுக', 'すべてのカテゴリーを閲覧', '모든 카테고리 보기')} →</a></p>
    </div>
  </div>
</section>

<section class="container block two-col">
  <div class="psec">
    <header><span>{L('Kitaran hayat', 'Lifecycle', '生命周期', 'வாழ்க்கைச் சுழற்சி', 'ライフサイクル', '수명 주기')}</span></header>
    <div class="psec-body">
      <p class="hint">
        {L(
          'Setiap artikel bergerak melalui tangga ini. Hanya yang diterbitkan muncul di laman awam.',
          'Every article moves along this ladder. Only published ones appear on the public site.',
          '每篇文章都沿此阶梯推进。只有已发布的内容才会出现在公开网站上。',
          'ஒவ்வொரு கட்டுரையும் இந்த ஏணி வழியாக நகர்கிறது. வெளியிடப்பட்டவை மட்டுமே பொது தளத்தில் தோன்றும்.',
          'すべての記事はこの段階を進みます。公開されたものだけが公開サイトに表示されます。',
          '모든 기사는 이 단계를 따라 이동합니다. 공개된 기사만 공개 사이트에 표시됩니다.',
        )}
      </p>
      <ol class="ladder">
        {(['draft', 'in-review', 'reviewed', 'published', 'archived'] as const).map((st) => (
          <li class={d.statusDist[st] ? 'has' : ''} data-status={st}>
            <span class="ld-dot" />
            <span class="ld-name">{t(`status.${st}`, locale)}</span>
            <span class="ld-num">{d.statusDist[st] ?? 0}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div class="psec">
    <header><span>{L('Kemas kini terkini', 'Recently updated', '最近更新', 'சமீபத்தில் புதுப்பிக்கப்பட்டவை', '最近の更新', '최근 업데이트')}</span></header>
    <div class="psec-body">
      {d.recentlyUpdated.length === 0 ? (
        <p class="hint">{L('Tiada kemas kini terkini direkodkan.', 'No recent updates recorded.', '暂无最近更新记录。', 'சமீபத்திய புதுப்பிப்புகள் எதுவும் பதிவாகவில்லை.', '最近の更新は記録されていません。', '최근 업데이트 기록이 없습니다.')}</p>
      ) : (
        <ul class="recent">
          {d.recentlyUpdated.map((a) => (
            <li>
              <a href={localePath(`/${a.category}/${a.slug}`, locale)}>{a.title[locale]}</a>
              <span class="cmeta">{(() => { const _c = getCategory(a.category); return _c ? loc(_c.name, locale) : a.category; })()} · {a.updated}</span>
            </li>
          ))}
        </ul>
      )}
      <p class="more"><a href={localePath('/changelog', locale)}>{L('Lihat log perubahan penuh →', 'See the full changelog →', '查看完整更新日志 →', 'முழு மாற்ற பதிவைப் பார்க்க →', '完全な変更履歴を見る →', '전체 변경 이력 보기 →')}</a></p>
    </div>
  </div>
</section>

<style>
  .block { margin-top: 1.6rem; }
  .xlink { margin: 0.9rem 0 0; text-align: right; }
  .xlink a { color: var(--gold); text-decoration: none; font-weight: 600; font-size: 0.88rem; }
  .xlink a:hover { text-decoration: underline; }

  .counters { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 1rem; }
  .counters > div { border: 1px solid var(--line); border-top: 2px solid var(--gold); border-radius: 12px; padding: 1rem; background: var(--surface); }
  .counters > div > b { display: block; font-family: var(--font-title); font-size: 1.9rem; color: var(--gold); line-height: 1.1; }
  .counters > div > span { color: var(--ink-soft); font-size: 0.85rem; }
  .counters > div > small { display: block; color: var(--muted); font-size: 0.72rem; margin-top: 0.15rem; }

  .psec { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .psec > header {
    padding: 0.45rem 0.95rem; font-size: 1.05rem; font-weight: 700; letter-spacing: 0.03em;
    text-transform: uppercase; background: var(--surface-2); border-bottom: 1px solid var(--line);
    font-family: var(--font-title);
  }
  .psec > header span { color: var(--gold); }
  .psec-body { padding: 1.2rem; }
  .hint { font-size: 0.82rem; color: var(--muted); margin: 0 0 0.9rem; line-height: 1.55; }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; }

  /* Trilingual coverage */
  .tri-sum { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; margin: 0 0 1.1rem; }
  .tri-stat { text-align: center; border: 1px solid var(--line); border-radius: 10px; padding: 0.7rem 0.5rem; background: var(--surface-2); }
  .tri-stat b { display: block; font-family: var(--font-title); font-size: 1.5rem; color: var(--ink); line-height: 1.1; }
  .tri-stat span { font-size: 0.76rem; color: var(--muted); }

  .legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; margin: 0 0 0.9rem; font-size: 0.76rem; color: var(--muted); }
  .legend .key { display: inline-flex; align-items: center; gap: 0.35rem; }
  .sw { width: 0.7rem; height: 0.7rem; border-radius: 3px; display: inline-block; }
  .sw.src { background: var(--gold); }
  .sw.tr { background: #4ade80; }
  .sw.miss { background: var(--surface-2); border: 1px solid var(--line); }

  .langbars { display: grid; gap: 1rem; }
  .lb-head { display: flex; align-items: baseline; gap: 0.55rem; margin-bottom: 0.3rem; }
  .lb-code { font-family: var(--font-title); font-weight: 800; color: var(--gold); font-size: 0.9rem; letter-spacing: 0.03em; }
  .lb-name { color: var(--ink-soft); font-size: 0.85rem; }
  .lb-fig { margin-left: auto; font-variant-numeric: tabular-nums; font-weight: 800; color: var(--ink); }
  .lb-fig .of { color: var(--muted); font-weight: 500; }
  .lb-bar { display: flex; height: 12px; border-radius: 999px; overflow: hidden; background: var(--surface-2); }
  .lb-bar .seg { height: 100%; }
  .lb-bar .seg.src { background: var(--gold); }
  .lb-bar .seg.tr { background: #4ade80; }
  .lb-bar .seg.miss { background: color-mix(in srgb, var(--muted) 22%, transparent); }
  .lb-nums { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; margin-top: 0.3rem; font-size: 0.76rem; font-variant-numeric: tabular-nums; }
  .lb-nums .src-t { color: var(--gold); }
  .lb-nums .tr-t { color: #4ade80; }
  .lb-nums .miss-t { color: var(--muted); }

  /* Classification bars */
  .sens { display: grid; gap: 0.55rem; }
  .sens-row { display: grid; grid-template-columns: 8.5rem 1fr 5rem; gap: 0.7rem; align-items: center; }
  .sens-label { font-size: 0.85rem; color: var(--ink-soft); font-weight: 600; }
  .sens-val { font-size: 0.82rem; color: var(--ink); font-variant-numeric: tabular-nums; text-align: right; }
  .sens-val .sp { color: var(--muted); }
  .track { display: block; height: 9px; background: var(--surface-2); border-radius: 999px; overflow: hidden; }
  .track .fill { display: block; height: 100%; background: var(--gold); border-radius: 999px; }

  /* Coverage by category */
  .cov { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 1.4rem; }
  .cov-head { margin: 0 0 0.6rem; font-weight: 800; display: flex; align-items: center; gap: 0.5rem; }
  .cov-ico { font-size: 1.1rem; }
  .cov-tot { margin-left: auto; font-variant-numeric: tabular-nums; color: var(--gold); font-size: 0.9rem; }
  .cov-cats { display: grid; gap: 0.35rem; }
  .cov-row { display: grid; grid-template-columns: 8rem 1fr 2rem; gap: 0.6rem; align-items: center; text-decoration: none; color: inherit; }
  .cov-name { font-size: 0.82rem; color: var(--ink-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cov-row:hover .cov-name { color: var(--gold); }
  .cov-num { font-size: 0.8rem; color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }
  /* Lifecycle ladder */
  .ladder { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.15rem; }
  .ladder li { display: flex; align-items: center; gap: 0.65rem; padding: 0.5rem 0.2rem; border-bottom: 1px dashed var(--line); }
  .ladder li:last-child { border-bottom: 0; }
  /* Empty rungs (a status no article currently sits in) recede, so a 0 reads as
     "unused stage", not a broken metric. */
  .ladder li:not(.has) { opacity: 0.5; }
  .ld-dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--surface-2); border: 1px solid var(--muted); flex: none; }
  .ladder li.has .ld-dot { background: var(--gold); border-color: var(--gold); }
  .ladder li[data-status='published'].has .ld-dot { background: #4ade80; border-color: #4ade80; }
  /* Archived is terminal/retired, not active work — a muted dot, never gold. */
  .ladder li[data-status='archived'].has .ld-dot { background: var(--muted); border-color: var(--muted); }
  .ladder li[data-status='archived'] { opacity: 0.7; }
  .ld-name { flex: 1; font-size: 0.9rem; }
  .ld-num { font-variant-numeric: tabular-nums; font-weight: 800; color: var(--ink); }

  /* Recently updated */
  .recent { list-style: none; padding: 0; margin: 0; }
  .recent li { padding: 0.45rem 0; border-bottom: 1px solid var(--line); }
  .recent li:last-child { border-bottom: 0; }
  .recent a { display: block; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 0.92rem; }
  .recent a:hover { color: var(--gold); }
  .recent .cmeta { display: block; color: var(--muted); font-size: 0.78rem; margin-top: 0.1rem; }
  .more { margin: 0.9rem 0 0; }
  .more a { color: var(--gold); text-decoration: none; font-size: 0.85rem; font-weight: 600; }

  .cov-more { margin: 1.1rem 0 0; }
  .cov-more a { color: var(--gold); text-decoration: none; font-weight: 600; font-size: 0.9rem; }
  .cov-more a:hover { text-decoration: underline; }

  @media (max-width: 800px) { .two-col { grid-template-columns: 1fr; } }
</style>
