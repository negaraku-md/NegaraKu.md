<section class="container block two-col">
  <div class="psec">
    <header><span>{L('Kitaran hayat', 'Lifecycle', '生命周期')}</span></header>
    <div class="psec-body">
      <p class="hint">
        {L(
          'Setiap artikel bergerak melalui tangga ini. Hanya yang diterbitkan muncul di laman awam.',
          'Every article moves along this ladder. Only published ones appear on the public site.',
          '每篇文章都沿此阶梯推进。只有已发布的内容才会出现在公开网站上。',
        )}
      </p>
      <ol class="ladder">
        {(['draft', 'in-review', 'reviewed', 'published', 'archived'] as const).map((st) => (
          <li class={d.statusDist[st] ? 'has' : ''} data-status={st}>
            <span class="ld-dot" />
            <span class="ld-name">{t(`status.${st}`, locale)}</span>
            <span class="ld-num">{d.statusDist[st] ?? 0}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div class="psec">
    <header><span>{L('Kemas kini terkini', 'Recently updated', '最近更新')}</span></header>
    <div class="psec-body">
      {d.recentlyUpdated.length === 0 ? (
        <p class="hint">{L('Tiada kemas kini terkini direkodkan.', 'No recent updates recorded.', '暂无最近更新记录。')}</p>
      ) : (
        <ul class="recent">
          {d.recentlyUpdated.map((a) => (
            <li>
              <a href={localePath(`/${a.category}/${a.slug}`, locale)}>{a.title[locale]}</a>
              <span class="cmeta">{getCategory(a.category)?.name[locale] ?? a.category} · {a.updated}</span>
            </li>
          ))}
        </ul>
      )}
      <p class="more"><a href={localePath('/changelog', locale)}>{L('Lihat log perubahan penuh →', 'See the full changelog →', '查看完整更新日志 →')}</a></p>
    </div>
  </div>
</section>

<style>
  .block { margin-top: 1.6rem; }

  .counters { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 1rem; }
  .counters > div { border: 1px solid var(--line); border-top: 2px solid var(--gold); border-radius: 12px; padding: 1rem; background: var(--surface); }
  .counters > div > b { display: block; font-family: var(--font-title); font-size: 1.9rem; color: var(--gold); line-height: 1.1; }
  .counters > div > span { color: var(--ink-soft); font-size: 0.85rem; }
  .counters > div > small { display: block; color: var(--muted); font-size: 0.72rem; margin-top: 0.15rem; }

  .psec { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .psec > header {
    padding: 0.45rem 0.95rem; font-size: 1.05rem; font-weight: 700; letter-spacing: 0.03em;
    text-transform: uppercase; background: var(--surface-2); border-bottom: 1px solid var(--line);
    font-family: var(--font-title);
  }
  .psec > header span { color: var(--gold); }
  .psec-body { padding: 1.2rem; }
  .hint { font-size: 0.82rem; color: var(--muted); margin: 0 0 0.9rem; line-height: 1.55; }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; }

  /* Trilingual coverage */
  .tri-sum { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; margin: 0 0 1.1rem; }
  .tri-stat { text-align: center; border: 1px solid var(--line); border-radius: 10px; padding: 0.7rem 0.5rem; background: var(--surface-2); }
  .tri-stat b { display: block; font-family: var(--font-title); font-size: 1.5rem; color: var(--ink); line-height: 1.1; }
  .tri-stat span { font-size: 0.76rem; color: var(--muted); }

  .legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; margin: 0 0 0.9rem; font-size: 0.76rem; color: var(--muted); }
  .legend .key { display: inline-flex; align-items: center; gap: 0.35rem; }
  .sw { width: 0.7rem; height: 0.7rem; border-radius: 3px; display: inline-block; }
  .sw.src { background: var(--gold); }
  .sw.tr { background: #4ade80; }
  .sw.miss { background: var(--surface-2); border: 1px solid var(--line); }

  .langbars { display: grid; gap: 1rem; }
  .lb-head { display: flex; align-items: baseline; gap: 0.55rem; margin-bottom: 0.3rem; }
  .lb-code { font-family: var(--font-title); font-weight: 800; color: var(--gold); font-size: 0.9rem; letter-spacing: 0.03em; }
  .lb-name { color: var(--ink-soft); font-size: 0.85rem; }
  .lb-fig { margin-left: auto; font-variant-numeric: tabular-nums; font-weight: 800; color: var(--ink); }
  .lb-fig .of { color: var(--muted); font-weight: 500; }
  .lb-bar { display: flex; height: 12px; border-radius: 999px; overflow: hidden; background: var(--surface-2); }
  .lb-bar .seg { height: 100%; }
  .lb-bar .seg.src { background: var(--gold); }
  .lb-bar .seg.tr { background: #4ade80; }
  .lb-bar .seg.miss { background: color-mix(in srgb, var(--muted) 22%, transparent); }
  .lb-nums { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; margin-top: 0.3rem; font-size: 0.76rem; font-variant-numeric: tabular-nums; }
  .lb-nums .src-t { color: var(--gold); }
  .lb-nums .tr-t { color: #4ade80; }
  .lb-nums .miss-t { color: var(--muted); }

  /* Classification bars */
  .sens { display: grid; gap: 0.55rem; }
  .sens-row { display: grid; grid-template-columns: 8.5rem 1fr 5rem; gap: 0.7rem; align-items: center; }
  .sens-label { font-size: 0.85rem; color: var(--ink-soft); font-weight: 600; }
  .sens-val { font-size: 0.82rem; color: var(--ink); font-variant-numeric: tabular-nums; text-align: right; }
  .sens-val .sp { color: var(--muted); }
  .track { display: block; height: 9px; background: var(--surface-2); border-radius: 999px; overflow: hidden; }
  .track .fill { display: block; height: 100%; background: var(--gold); border-radius: 999px; }

  /* Coverage by category */
  .cov { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 1.4rem; }
  .cov-head { margin: 0 0 0.6rem; font-weight: 800; display: flex; align-items: center; gap: 0.5rem; }
  .cov-ico { font-size: 1.1rem; }
  .cov-tot { margin-left: auto; font-variant-numeric: tabular-nums; color: var(--gold); font-size: 0.9rem; }
  .cov-cats { display: grid; gap: 0.35rem; }
  .cov-row { display: grid; grid-template-columns: 8rem 1fr 2rem; gap: 0.6rem; align-items: center; text-decoration: none; color: inherit; }
  .cov-name { font-size: 0.82rem; color: var(--ink-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cov-row:hover .cov-name { color: var(--gold); }
  .cov-num { font-size: 0.8rem; color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }
  /* AI crawlers panel — reuses .cov-row/.track, wider name + number columns */
  .ai-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; }
  .ai-h { margin: 0 0 0.55rem; font-size: 0.78rem; font-weight: 800; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .ai-h-top { margin-top: 1.15rem; }
  .ai-grid .ai-row { grid-template-columns: 9.5rem 1fr 3.4rem; }
  .ai-top .cov-row { grid-template-columns: minmax(0, 1fr) 5rem 3.4rem; }
  @media (max-width: 800px) { .ai-grid { grid-template-columns: 1fr; } }
  .fbtable td, .fbtable th:not(.chan) { text-align: right; font-variant-numeric: tabular-nums; }

  /* Lifecycle ladder */
  .ladder { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.15rem; }
  .ladder li { display: flex; align-items: center; gap: 0.65rem; padding: 0.5rem 0.2rem; border-bottom: 1px dashed var(--line); }
  .ladder li:last-child { border-bottom: 0; }
  /* Empty rungs (a status no article currently sits in) recede, so a 0 reads as
     "unused stage", not a broken metric. */
  .ladder li:not(.has) { opacity: 0.5; }
  .ld-dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--surface-2); border: 1px solid var(--muted); flex: none; }
  .ladder li.has .ld-dot { background: var(--gold); border-color: var(--gold); }
  .ladder li[data-status='published'].has .ld-dot { background: #4ade80; border-color: #4ade80; }
  /* Archived is terminal/retired, not active work — a muted dot, never gold. */
  .ladder li[data-status='archived'].has .ld-dot { background: var(--muted); border-color: var(--muted); }
  .ladder li[data-status='archived'] { opacity: 0.7; }
  .ld-name { flex: 1; font-size: 0.9rem; }
  .ld-num { font-variant-numeric: tabular-nums; font-weight: 800; color: var(--ink); }

  /* Recently updated */
  .recent { list-style: none; padding: 0; margin: 0; }
  .recent li { padding: 0.45rem 0; border-bottom: 1px solid var(--line); }
  .recent li:last-child { border-bottom: 0; }
  .recent a { display: block; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 0.92rem; }
  .recent a:hover { color: var(--gold); }
  .recent .cmeta { display: block; color: var(--muted); font-size: 0.78rem; margin-top: 0.1rem; }
  .more { margin: 0.9rem 0 0; }
  .more a { color: var(--gold); text-decoration: none; font-size: 0.85rem; font-weight: 600; }

  .cov-more { margin: 1.1rem 0 0; }
  .cov-more a { color: var(--gold); text-decoration: none; font-weight: 600; font-size: 0.9rem; }
  .cov-more a:hover { text-decoration: underline; }

  @media (max-width: 800px) { .two-col { grid-template-columns: 1fr; } }
</style>
