---
// Builder-facing landing for the embeddable "fact about Malaysia" widget.
// English-first (like most widget docs). Rendered inside BaseLayout so it carries
// the full site chrome + hero, matching /llms. The actual iframe widget lives at
// /embed/fact-of-the-day (chrome-less — do not change that one). The snippet pairs
// the iframe with a visible credit <a> in the HOST page; that anchor is the real
// backlink, so we ask embedders to keep it.
import type { Locale } from '@/lib/categories';
import { localePath } from '@/lib/i18n';
import PageHero from './PageHero.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
---

<PageHero
  locale={locale}
  crumb={[
    { label: 'Home', href: localePath('/', locale) },
    { label: 'Embed a fact' },
  ]}
  title="Embed a fact"
  desc="A free, open-source widget that shows a different, sourced fact about Malaysia each day — in 13 languages, light and dark. One line of HTML. No tracking, no sign-up."
/>

<section class="container block">
  <div class="embed">
    <div class="eb-grid">
      <div>
        <h2 class="eb-h">1. Choose</h2>
        <div class="eb-panel">
          <div class="eb-row">
            <div>
              <label class="eb-label" for="lang">Language</label>
              <select id="lang" class="eb-select">
                <option value="ms">Bahasa Melayu</option>
                <option value="en" selected>English</option>
                <option value="zh">中文</option>
                <option value="ta">தமிழ்</option>
                <option value="ja">日本語</option>
                <option value="ko">한국어</option>
                <option value="th">ไทย</option>
                <option value="vi">Tiếng Việt</option>
                <option value="id">Bahasa Indonesia</option>
                <option value="ar">العربية</option>
                <option value="hi">हिन्दी</option>
                <option value="es">Español</option>
                <option value="fr">Français</option>
              </select>
            </div>
            <div>
              <label class="eb-label" for="theme">Theme</label>
              <select id="theme" class="eb-select">
                <option value="auto" selected>Auto (match site)</option>
                <option value="light">Light</option>
                <option value="dark">Dark</option>
              </select>
            </div>
          </div>
          <label class="eb-label">Preview</label>
          <div class="eb-preview">
            <iframe class="eb-pv" id="pv" title="A fact about Malaysia" loading="lazy"></iframe>
          </div>
        </div>
      </div>

      <div>
        <h2 class="eb-h">2. Copy</h2>
        <div class="eb-panel">
          <pre id="snippet" class="eb-code" data-pagefind-ignore></pre>
          <button class="la-btn" id="copy" type="button">Copy code</button>
          <p class="note eb-credit"><strong>Please keep the credit link.</strong> The small
            “Malaysia facts by NegaraKu.md” line below the widget is a normal link in your page — it’s
            how the project stays discoverable, and it’s the only thing we ask in return for the free widget.</p>
        </div>
      </div>
    </div>

    <h2 class="eb-h">Why embed it?</h2>
    <ul class="eb-feat">
      <li><strong>Always fresh</strong> — a new fact each day, pulled from a 1,000+ article knowledge base.</li>
      <li><strong>Sourced</strong> — every fact links to a cited article on negaraku.md.</li>
      <li><strong>13 languages</strong>, automatic light/dark, and it adapts to your container width.</li>
      <li><strong>Open &amp; free</strong> — CC BY-SA 4.0 content; no scripts run on your page except the iframe.</li>
    </ul>

    <h2 class="eb-h">Tips</h2>
    <ul class="eb-feat">
      <li>Adjust <code>height</code> (default 200) if your language wraps to more lines.</li>
      <li>The widget sends its height to the parent via <code>postMessage</code> (<code>type: "negaraku-embed-height"</code>) if you want to auto-resize.</li>
      <li>Prefer a fixed language? Set <code>?lang=</code>. Prefer a fixed look? Set <code>?theme=light</code> or <code>dark</code>.</li>
    </ul>
  </div>
</section>

<script is:inline>
  (function () {
    var ORIGIN = 'https://negaraku.md';
    var langSel = document.getElementById('lang');
    var themeSel = document.getElementById('theme');
    var pv = document.getElementById('pv');
    var snippet = document.getElementById('snippet');
    var copyBtn = document.getElementById('copy');
    if (!langSel || !themeSel || !pv || !snippet || !copyBtn) return;

    function srcUrl() { return ORIGIN + '/embed/fact-of-the-day/?lang=' + langSel.value + '&theme=' + themeSel.value; }
    function homeUrl() { return langSel.value === 'ms' ? ORIGIN + '/' : ORIGIN + '/' + langSel.value + '/'; }
    function code() {
      return (
        '<iframe src="' + srcUrl() + '"\n' +
        '  title="A fact about Malaysia" width="100%" height="200"\n' +
        '  style="border:0;max-width:440px" loading="lazy"></iframe>\n' +
        '<p style="font:13px/1.4 sans-serif;max-width:440px">\n' +
        '  <a href="' + homeUrl() + '">Malaysia facts by NegaraKu.md</a>\n' +
        '</p>'
      );
    }
    function refresh() { pv.src = srcUrl(); snippet.textContent = code(); }
    langSel.addEventListener('change', refresh);
    themeSel.addEventListener('change', refresh);
    copyBtn.addEventListener('click', function () {
      navigator.clipboard.writeText(code()).then(function () {
        copyBtn.textContent = 'Copied ✓';
        setTimeout(function () { copyBtn.textContent = 'Copy code'; }, 1800);
      });
    });
    refresh();

    window.addEventListener('message', function (e) {
      if (e.data && e.data.type === 'negaraku-embed-height' && e.data.height) {
        pv.style.height = Math.max(150, e.data.height) + 'px';
      }
    });
  })();
</script>

<style>
  .embed { max-width: 72rem; }
  .eb-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; align-items: start; }
  @media (max-width: 760px) { .eb-grid { grid-template-columns: 1fr; } }
  .eb-h { font-size: 1.05rem; margin: 2rem 0 0.8rem; font-family: var(--font-title); color: var(--ink); }
  .eb-grid > div > .eb-h { margin-top: 0; }
  .eb-panel { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 1.2rem; }
  .eb-label { display: block; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin: 0 0 0.3rem; }
  .eb-row { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .eb-row > div { flex: 1 1 8rem; }
  .eb-select { width: 100%; padding: 0.5rem 0.6rem; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); font: inherit; }
  .eb-preview { border: 1px dashed var(--line); border-radius: 12px; padding: 1rem; background: var(--surface-2); }
  .eb-pv { width: 100%; max-width: 440px; height: 200px; border: 0; display: block; margin: 0 auto; }
  .eb-code {
    background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px;
    padding: 1rem; overflow: auto; font-size: 0.8rem; line-height: 1.5; margin: 0 0 0.8rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: pre-wrap; word-break: break-word; color: var(--ink-soft);
  }
  .eb-credit { margin-top: 1rem; }
  .eb-feat { padding-inline-start: 1.1rem; margin: 0.4rem 0 0; color: var(--ink-soft); line-height: 1.7; }
  .eb-feat li { margin: 0.3rem 0; }
  .eb-feat strong { color: var(--ink); }
  .eb-feat code { background: var(--surface-2); border: 1px solid var(--line); border-radius: 5px; padding: 0.05rem 0.35rem; font-size: 0.85em; }
  .note { color: var(--muted); font-size: 0.9rem; line-height: 1.6; }
  .note strong { color: var(--ink); }
  /* Copy button — matches the LlmsView action-button look. */
  .la-btn {
    display: inline-flex; align-items: center; gap: 0.3rem; font: inherit; font-size: 0.85rem; font-weight: 700;
    text-decoration: none; color: var(--ink-soft); background: var(--surface-2);
    border: 1px solid var(--line); border-radius: 8px; padding: 0.45rem 1rem; cursor: pointer;
  }
  .la-btn:hover { border-color: var(--gold); color: var(--gold); }
</style>
