---
import { type Article, readingTime } from '@/lib/content';
import type { Locale } from '@/lib/categories';
import { getCategory, getCategoryColor } from '@/lib/categories';
import { localePath, t } from '@/lib/i18n';

interface Props {
  article: Article;
  locale: Locale;
  /** Horizontal layout (thumbnail left) — used for featured/popular lists. */
  row?: boolean;
}
const { article, locale, row = false } = Astro.props;
const { category, slug, title, summary, status, hero } = article.data;
const cat = getCategory(category);
const href = localePath(`/${category}/${slug}`, locale);
const color = getCategoryColor(category);
// No per-article photos exist, but every article has an auto-generated OG card
// (scripts/build-og.mjs) — reuse it as the thumbnail. Falls back to the category
// glyph if the PNG is missing (e.g. a brand-new article on the dev server, where
// build-og hasn't run). Generated at build for production, so it's always there.
const ogSrc = `/og/${locale}/${category}/${slug}.png`;
const mins = readingTime(article);
const nSrc = article.data.sources.length;
const citeLabel = locale === 'zh' ? '引用' : locale === 'en' ? 'cites' : 'rujukan';
const minLabel = locale === 'zh' ? '分钟' : 'min';
---

<a class:list={['card article-card', { row }]} href={href} style={`--c:${color}`}>
  <div class="thumb">
    {
      hero ? (
        <img src={hero} alt="" loading="lazy" />
      ) : (
        <>
          <span class="glyph" aria-hidden="true">{cat?.icon}</span>
          <img class="og" src={ogSrc} alt="" loading="lazy" data-og />
        </>
      )
    }
  </div>
  <div class="cbody">
    <div class="top">
      <span class="cat">{cat?.icon} {cat?.name[locale]}</span>
      {status !== 'draft' && <span class="badge" data-status={status}>{t(`status.${status}`, locale)}</span>}
    </div>
    <h3>{title}</h3>
    <p>{summary}</p>
    <div class="cmeta">
      {nSrc > 0 && <span>📚 {nSrc} {citeLabel}</span>}
      <span>⏱️ {mins} {minLabel}</span>
    </div>
  </div>
</a>

<script>
  // If an OG thumbnail 404s (a new article the build hasn't rendered yet), hide
  // it so the category glyph beneath shows instead of a broken-image icon. Also
  // catches images that already errored before this script ran.
  for (const img of document.querySelectorAll<HTMLImageElement>('img.og[data-og]')) {
    const hide = () => (img.style.display = 'none');
    if (img.complete && img.naturalWidth === 0) hide();
    else img.addEventListener('error', hide, { once: true });
  }
</script>

<style>
  .article-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* Change A: the top border carries the article's category colour (overriding
       the global gold), so the coloured upper edge matches the strip cards to
       the category/section cards elsewhere. */
    border-top-color: var(--c);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  /* Change B: on hover the whole border follows that same upper-border colour. */
  .article-card:hover { border-color: var(--c); }
  .thumb {
    position: relative;
    aspect-ratio: 16 / 8;
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 120% at 30% 20%, color-mix(in srgb, var(--c) 30%, transparent), transparent),
      linear-gradient(135deg, color-mix(in srgb, var(--c) 22%, var(--surface-2)), var(--surface-2));
    border-bottom: 1px solid var(--line);
  }
  .thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .glyph {
    font-size: 2.4rem;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.4));
  }
  .cbody {
    padding: 0.9rem 1.1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .cat {
    font-size: 0.75rem;
    color: var(--muted);
    font-weight: 600;
  }
  .article-card h3 {
    margin: 0.1rem 0 0.1rem;
    font-size: 1.1rem;
  }
  .article-card p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .cmeta {
    display: flex;
    gap: 0.9rem;
    color: var(--muted);
    font-size: 0.78rem;
    margin-top: 0.15rem;
  }

  /* Horizontal row variant */
  .article-card.row {
    flex-direction: row;
  }
  .article-card.row .thumb {
    aspect-ratio: auto;
    width: 120px;
    flex-shrink: 0;
    border-bottom: 0;
    border-right: 1px solid var(--line);
  }
  .article-card.row .glyph {
    font-size: 2rem;
  }
  @media (max-width: 500px) {
    .article-card.row .thumb {
      width: 90px;
    }
  }
</style>
