---
import type { Locale } from '@/lib/categories';
import type { Article } from '@/lib/content';
import { getCategory, getPillar, PILLARS, loc } from '@/lib/categories';
import { allArticles, effectiveStatus, readingTime } from '@/lib/content';
import { subcatLabel } from '@/lib/subcategories';
import { ogAsset } from '@/lib/og';
import { t } from '@/lib/i18n';
import { readFileSync } from 'node:fs';

// Optional visitor analytics, keyed by "category/slug". The reader count feeds
// the "Most read" sort and the rank badge on /most-read. Absent until analytics
// is wired up (see docs) — the row then shows no reader count rather than a 0.
type Bucket = number | { total: number; byBot?: Record<string, number> };
let analytics: Record<string, { readers?: number; search?: Bucket; ai?: Bucket }> = {};
try {
  analytics = JSON.parse(readFileSync('public/api/analytics.json', 'utf8'));
} catch {
  analytics = {};
}
const bReads = (v: unknown): number => {
  if (typeof v === 'number') return v;
  if (v && typeof v === 'object' && 'total' in v) return (v as { total?: number }).total ?? 0;
  return 0;
};

// Reusable article list, editorial "blog" layout: each item is a horizontal
// row-card — OG thumbnail · section/category/topic tags · title · one-line
// summary · quiet meta (cites · read time · updated · languages). Same card DNA
// as the homepage "Latest" strip (ArticleCard), reflowed into rows so a list
// page is scannable. Sort / search / filter / pagination are client-side over an
// embedded manifest; used on the All Articles page and, pre-scoped, on
// section / category / topic pages.

type FilterKey = 'sec' | 'cat' | 'top' | 'status';
interface Props {
  locale: Locale;
  articles: Article[]; // already scoped by the caller (all, or one section/category/topic)
  filters?: FilterKey[];
  /** Hide the Sort row and lock the order to newest-first (used by /latest). */
  hideSort?: boolean;
  /** Insert a date header before each new day's run of cards (newest-first). */
  groupByDate?: boolean;
  /** Preserve the caller's order instead of client-sorting (used by /most-read,
      where the caller pre-ranks by reads with a recency fallback). */
  fixedOrder?: boolean;
  /** Show a rank number + reader count on each card (used by /most-read). */
  showRank?: boolean;
  /** The category id this list is scoped to. When set, any card whose primary
      category differs is an `alsoIn` cross-listed GUEST, flagged with a pill so
      readers see it's homed elsewhere (see content.config alsoIn). */
  homeCat?: string;
}
const {
  locale,
  articles,
  filters = ['sec', 'cat', 'top', 'status'],
  hideSort = false,
  groupByDate = false,
  fixedOrder = false,
  showRank = false,
  homeCat,
} = Astro.props;
const has = (f: FilterKey) => filters.includes(f);
const dateLocale = locale === 'zh' ? 'zh-Hans' : locale === 'ms' ? 'ms-MY' : locale;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string, ar?: string, hi?: string, es?: string, fr?: string) => (locale === 'fr' ? (fr ?? ms) : locale === 'es' ? (es ?? ms) : locale === 'hi' ? (hi ?? ms) : locale === 'ar' ? (ar ?? ms) : locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

// How many languages each topic exists in (publishable files only) — surfaced as
// a single "N languages" meta item instead of a wall of per-language chips.
const langsByKey = new Map<string, Set<string>>();
for (const a of await allArticles()) {
  const key = `${a.data.category}/${a.data.slug}`;
  (langsByKey.get(key) ?? langsByKey.set(key, new Set()).get(key)!).add(a.data.lang);
}

const SENS_LABEL: Record<string, string> = {
  race: L('Kaum', 'Race', '种族', 'இனம்', '人種', '인종', 'เชื้อชาติ', 'Chủng tộc', 'Ras', 'العرق', 'नस्ल', 'Raza', 'Origine ethnique'),
  religion: L('Agama', 'Religion', '宗教', 'மதம்', '宗教', '종교', 'ศาสนา', 'Tôn giáo', 'Agama', 'الدين', 'धर्म', 'Religión', 'Religion'),
  royalty: L('Institusi diraja', 'Royalty', '王室', 'அரச நிறுவனம்', '王室', '왕실', 'สถาบันพระมหากษัตริย์', 'Hoàng gia', 'Institusi kerajaan', 'المؤسسة الملكية', 'राजसत्ता', 'Realeza', 'Royauté'),
  constitution: L('Perlembagaan', 'Constitution', '宪法', 'அரசியலமைப்பு', '憲法', '헌법', 'รัฐธรรมนูญ', 'Hiến pháp', 'Konstitusi', 'الدستور', 'संविधान', 'Constitución', 'Constitution'),
  elections: L('Pilihan raya', 'Elections', '选举', 'தேர்தல்', '選挙', '선거', 'การเลือกตั้ง', 'Bầu cử', 'Pemilihan umum', 'الانتخابات', 'चुनाव', 'Elecciones', 'Élections'),
  security: L('Keselamatan', 'Security', '安全', 'பாதுகாப்பு', '安全保障', '안보', 'ความมั่นคง', 'An ninh', 'Keamanan', 'الأمن', 'सुरक्षा', 'Seguridad', 'Sécurité'),
  health: L('Kesihatan', 'Health', '健康', 'சுகாதாரம்', '健康', '보건', 'สุขภาพ', 'Sức khỏe', 'Kesehatan', 'الصحة', 'स्वास्थ्य', 'Salud', 'Santé'),
  'legal-proceedings': L('Perundangan', 'Legal', '法律程序', 'சட்டம்', '法律', '법률', 'กฎหมาย', 'Pháp lý', 'Hukum', 'الشؤون القانونية', 'कानूनी', 'Jurídico', 'Juridique'),
};

const rows = articles.map((a, i) => {
  const d = a.data;
  const key = `${d.category}/${d.slug}`;
  const conn = (d.related?.length ?? 0) + (d.relations?.length ?? 0);
  const pillar = getPillar(d.category);
  const topic = d.subcategory?.[0];
  const sens = d.sensitivity && d.sensitivity !== 'none' ? d.sensitivity : null;
  const st = effectiveStatus(a);
  return {
    t: d.title,
    sum: d.summary ?? '',
    // `h` (the localized href) is derived client-side from `p` — saves bytes.
    p: `/${d.category}/${d.slug}`,
    // Reuse the auto-generated OG card's small WebP thumbnail (~10 KB) as the
    // row image; the client hides it on 404 so the gradient shows instead.
    og: ogAsset(`/og/${locale}/${d.category}/${d.slug}.thumb.webp`),
    hero: d.hero ?? null, // a real cover photo (food / restaurant) wins over the OG card
    secId: pillar ?? '',
    catId: d.category,
    topId: topic ?? '',
    st,
    sens: !!sens,
    cls: sens ? SENS_LABEL[sens] ?? L('Sensitif', 'Sensitive', '敏感', 'கூருணர்வான', '要配慮', '민감', 'ละเอียดอ่อน', 'Nhạy cảm', 'Sensitif', 'حساس', 'संवेदनशील', 'Sensible', 'Sensible') : '',
    src: d.sources?.length ?? 0,
    min: readingTime(a),
    conn,
    upd: d.updated ? new Date(d.updated).toISOString().slice(0, 10) : '',
    nl: (langsByKey.get(key) ?? new Set()).size || 1,
    reads: bReads(analytics[key]?.readers),
    rank: i + 1,
    // Cross-listed guest: primary category differs from the list's home category
    // (only set when `homeCat` is passed, i.e. category/topic-scoped lists).
    guest: homeCat ? d.category !== homeCat : false,
  };
});

// Label dictionaries emitted once (rows carry only ids). The section / category /
// topic names repeat across many rows; hoisting them into id→label maps and
// resolving client-side trims KB from the inline JSON.
const secById: Record<string, string> = Object.fromEntries(PILLARS.map((p) => [p.id, loc(p.name, locale)]));
const catById: Record<string, string> = {};
const topById: Record<string, string> = {};
for (const a of articles) {
  const c = a.data.category;
  if (!(c in catById)) { const gc = getCategory(c); catById[c] = gc ? loc(gc.name, locale) : c; }
  const tp = a.data.subcategory?.[0];
  if (tp && !(tp in topById)) topById[tp] = subcatLabel(tp, locale);
}

const secs = PILLARS.filter((p) => rows.some((r) => r.secId === p.id)).map((p) => [p.id, loc(p.name, locale)]);
const cats = [...new Map(rows.map((r) => [r.catId, catById[r.catId] ?? r.catId])).entries()].sort((a, b) =>
  a[1] < b[1] ? -1 : 1,
);
const tops = [...new Map(rows.filter((r) => r.topId).map((r) => [r.topId, topById[r.topId] ?? r.topId])).entries()].sort(
  (a, b) => (a[1] < b[1] ? -1 : 1),
);
const LIFECYCLE = ['draft', 'in-review', 'reviewed', 'published', 'needs-update', 'in-update', 'archived'];
const statusCounts: Record<string, number> = {};
for (const r of rows) statusCounts[r.st] = (statusCounts[r.st] ?? 0) + 1;
const presentStatuses = LIFECYCLE.filter((s) => statusCounts[s]);
---

<section class="container block art-list">
  <div class="art-toolbar" data-pagefind-ignore>
    <button class="tb-more" type="button" data-tb-toggle aria-expanded="false">
      {L('Tapis & isih', 'Filters & sort', '筛选与排序', 'வடிகட்டி & வரிசை', 'フィルターと並び替え', '필터 및 정렬', 'ตัวกรองและการจัดเรียง', 'Bộ lọc & sắp xếp', 'Filter & urutkan', 'التصفية والترتيب', 'फ़िल्टर और क्रमबद्ध करें', 'Filtros y orden', 'Filtres et tri')} <span class="tbm-caret" aria-hidden="true">▾</span>
    </button>
    <div class="tb-adv">
    {
      (secs.length > 1 || cats.length > 1 || tops.length > 1 || presentStatuses.length > 1) && (
        <div class="tb-line">
          <span class="tb-label">{L('Tapis', 'Filter', '筛选', 'வடிகட்டு', 'フィルター', '필터', 'กรอง', 'Lọc', 'Filter', 'التصفية', 'फ़िल्टर', 'Filtrar', 'Filtrer')}</span>
          <div class="controls">
            {has('sec') && secs.length > 1 && (
              <select id="f-sec">
                <option value="">{L('Semua tonggak', 'All pillars', '所有支柱', 'அனைத்து தூண்கள்', 'すべての柱', '모든 핵심축', 'เสาหลักทั้งหมด', 'Tất cả trụ cột', 'Semua pilar', 'جميع الركائز', 'सभी स्तंभ', 'Todos los pilares', 'Tous les piliers')}</option>
                {secs.map(([id, name]) => <option value={id}>{name}</option>)}
              </select>
            )}
            {has('cat') && cats.length > 1 && (
              <select id="f-cat">
                <option value="">{L('Semua kategori', 'All categories', '所有分类', 'அனைத்து வகைகள்', 'すべてのカテゴリー', '모든 카테고리', 'หมวดหมู่ทั้งหมด', 'Tất cả danh mục', 'Semua kategori', 'جميع الفئات', 'सभी श्रेणियाँ', 'Todas las categorías', 'Toutes les catégories')}</option>
                {cats.map(([id, name]) => <option value={id}>{name}</option>)}
              </select>
            )}
            {has('top') && tops.length > 1 && (
              <select id="f-top">
                <option value="">{L('Semua topik', 'All topics', '所有主题', 'அனைத்து தலைப்புகள்', 'すべてのトピック', '모든 주제', 'หัวข้อทั้งหมด', 'Tất cả chủ đề', 'Semua topik', 'جميع المواضيع', 'सभी विषय', 'Todos los temas', 'Tous les sujets')}</option>
                {tops.map(([id, name]) => <option value={id}>{name}</option>)}
              </select>
            )}
            {has('status') && presentStatuses.length > 1 && (
              <select id="f-status">
                <option value="">{L('Semua status', 'All statuses', '所有状态', 'அனைத்து நிலைகள்', 'すべてのステータス', '모든 상태', 'สถานะทั้งหมด', 'Tất cả trạng thái', 'Semua status', 'جميع الحالات', 'सभी स्थितियाँ', 'Todos los estados', 'Tous les statuts')}</option>
                {presentStatuses.map((s) => (
                  <option value={s}>{t(`status.${s}`, locale)} ({statusCounts[s]})</option>
                ))}
              </select>
            )}
            <button id="f-reset" type="button" hidden>{L('Set semula', 'Reset', '重置', 'மீட்டமை', 'リセット', '초기화', 'รีเซ็ต', 'Đặt lại', 'Atur ulang', 'إعادة تعيين', 'रीसेट करें', 'Restablecer', 'Réinitialiser')}</button>
          </div>
        </div>
      )
    }
    {!hideSort && (
      <div class="tb-line">
        <span class="tb-label">{L('Isih', 'Sort', '排序', 'வரிசை', '並び替え', '정렬', 'จัดเรียง', 'Sắp xếp', 'Urutkan', 'الترتيب', 'क्रमबद्ध करें', 'Ordenar', 'Trier')}</span>
        <div class="tabs" role="tablist">
          <button class="tab on" data-sort="upd" data-dir="desc">{L('Terkini', 'Latest', '最新', 'புதியவை', '最新', '최신', 'ล่าสุด', 'Mới nhất', 'Terbaru', 'الأحدث', 'नवीनतम', 'Más recientes', 'Plus récents')}</button>
          <button class="tab" data-sort="reads" data-dir="desc">{L('Paling banyak dibaca', 'Most read', '最多阅读', 'அதிகம் படிக்கப்பட்டவை', '最も読まれた', '가장 많이 읽은', 'อ่านมากที่สุด', 'Được đọc nhiều nhất', 'Paling banyak dibaca', 'الأكثر قراءة', 'सर्वाधिक पढ़े गए', 'Más leídos', 'Les plus lus')}</button>
          <button class="tab" data-sort="t" data-dir="asc">{L('A–Z', 'A–Z', 'A–Z', 'A–Z', 'A–Z', 'A–Z', 'A–Z', 'A–Z', 'A–Z')}</button>
          <button class="tab" data-sort="src" data-dir="desc">{L('Paling banyak sumber', 'Most sourced', '来源最多', 'அதிக ஆதாரம் கொண்டவை', '出典が多い順', '출처 많은 순', 'มีแหล่งข้อมูลมากที่สุด', 'Nhiều nguồn nhất', 'Paling banyak sumber', 'الأكثر مصادر', 'सर्वाधिक स्रोत वाले', 'Con más fuentes', 'Les plus sourcés')}</button>
          <button class="tab" data-sort="conn" data-dir="desc">{L('Paling terhubung', 'Most linked', '关联最多', 'அதிகம் இணைக்கப்பட்டவை', 'リンクが多い順', '링크 많은 순', 'มีการเชื่อมโยงมากที่สุด', 'Được liên kết nhiều nhất', 'Paling terhubung', 'الأكثر ترابطًا', 'सर्वाधिक जुड़े हुए', 'Más enlazados', 'Les plus liés')}</button>
        </div>
      </div>
    )}
    </div>
    <div class="tb-line search-line">
      <span class="tb-label">{L('Cari', 'Search', '搜索', 'தேடு', '検索', '검색', 'ค้นหา', 'Tìm kiếm', 'Cari', 'البحث', 'खोजें', 'Buscar', 'Rechercher')}</span>
      <input id="f-q" type="search" placeholder={L('Cari tajuk…', 'Search titles…', '搜索标题…', 'தலைப்புகளைத் தேடு…', 'タイトルを検索…', '제목 검색…', 'ค้นหาชื่อเรื่อง…', 'Tìm kiếm tiêu đề…', 'Cari judul…', 'ابحث في العناوين…', 'शीर्षक खोजें…', 'Buscar títulos…', 'Rechercher des titres…')} />
    </div>
  </div>

  <div class="pager pager-top" data-pagefind-ignore>
    <div class="pg-size">
      <label>{L('Baris', 'Rows', '每页', 'வரிசைகள்', '行', '행', 'แถว', 'Hàng', 'Baris', 'الصفوف', 'पंक्तियाँ', 'Filas', 'Lignes')}
        <select class="pg-size-sel">
          <option>25</option>
          <option>50</option>
          <option>100</option>
        </select>
      </label>
      <span class="pg-count"></span>
    </div>
    <div class="pg-nav">
      <button class="pg-first" title={L('Pertama', 'First', '首页', 'முதல்', '最初', '처음', 'หน้าแรก', 'Đầu tiên', 'Pertama', 'الأول', 'पहला', 'Primera', 'Première')}>«</button>
      <button class="pg-prev" title={L('Sebelum', 'Prev', '上一页', 'முந்தைய', '前へ', '이전', 'ก่อนหน้า', 'Trước', 'Sebelumnya', 'السابق', 'पिछला', 'Anterior', 'Précédente')}>‹</button>
      <span class="pg-of">
        {L('Halaman', 'Page', '第', 'பக்கம்', 'ページ', '페이지', 'หน้า', 'Trang', 'Halaman', 'الصفحة', 'पृष्ठ', 'Página', 'Page')}
        <input class="pg-no" type="number" min="1" value="1" />
        / <span class="pg-total">1</span>
      </span>
      <button class="pg-next" title={L('Seterusnya', 'Next', '下一页', 'அடுத்து', '次へ', '다음', 'ถัดไป', 'Tiếp', 'Berikutnya', 'التالي', 'अगला', 'Siguiente', 'Suivante')}>›</button>
      <button class="pg-last" title={L('Akhir', 'Last', '末页', 'கடைசி', '最後', '마지막', 'หน้าสุดท้าย', 'Cuối cùng', 'Terakhir', 'الأخير', 'अंतिम', 'Última', 'Dernière')}>»</button>
    </div>
  </div>

  <div class="acards" id="alist-body"></div>

  <div class="pager" data-pagefind-ignore>
    <div class="pg-size">
      <label>{L('Baris', 'Rows', '每页', 'வரிசைகள்', '行', '행', 'แถว', 'Hàng', 'Baris', 'الصفوف', 'पंक्तियाँ', 'Filas', 'Lignes')}
        <select class="pg-size-sel">
          <option>25</option>
          <option>50</option>
          <option>100</option>
        </select>
      </label>
      <span class="pg-count"></span>
    </div>
    <div class="pg-nav">
      <button class="pg-first" title={L('Pertama', 'First', '首页', 'முதல்', '最初', '처음', 'หน้าแรก', 'Đầu tiên', 'Pertama', 'الأول', 'पहला', 'Primera', 'Première')}>«</button>
      <button class="pg-prev" title={L('Sebelum', 'Prev', '上一页', 'முந்தைய', '前へ', '이전', 'ก่อนหน้า', 'Trước', 'Sebelumnya', 'السابق', 'पिछला', 'Anterior', 'Précédente')}>‹</button>
      <span class="pg-of">
        {L('Halaman', 'Page', '第', 'பக்கம்', 'ページ', '페이지', 'หน้า', 'Trang', 'Halaman', 'الصفحة', 'पृष्ठ', 'Página', 'Page')}
        <input class="pg-no" type="number" min="1" value="1" />
        / <span class="pg-total">1</span>
      </span>
      <button class="pg-next" title={L('Seterusnya', 'Next', '下一页', 'அடுத்து', '次へ', '다음', 'ถัดไป', 'Tiếp', 'Berikutnya', 'التالي', 'अगला', 'Siguiente', 'Suivante')}>›</button>
      <button class="pg-last" title={L('Akhir', 'Last', '末页', 'கடைசி', '最後', '마지막', 'หน้าสุดท้าย', 'Cuối cùng', 'Terakhir', 'الأخير', 'अंतिम', 'Última', 'Dernière')}>»</button>
    </div>
  </div>
</section>

<script type="application/json" id="articles-data" set:html={JSON.stringify(rows)}></script>
<script
  type="application/json"
  id="articles-i18n"
  set:html={JSON.stringify({
    status: Object.fromEntries(LIFECYCLE.map((s) => [s, t(`status.${s}`, locale)])),
    showing: L('{a}–{b} drpd {n}', '{a}–{b} of {n}', '第 {a}–{b} 项，共 {n}', 'மொத்தம் {n} இல் {a}–{b}', '{n} 件中 {a}–{b}', '{n}개 중 {a}–{b}', '{a}–{b} จาก {n}', '{a}–{b} trong số {n}', '{a}–{b} dari {n}', '{a}–{b} من {n}', '{n} में से {a}–{b}', '{a}–{b} de {n}', '{a}–{b} sur {n}'),
    empty: L('Tiada artikel sepadan.', 'No matching articles.', '没有匹配的文章。', 'பொருந்தும் கட்டுரைகள் எதுவும் இல்லை.', '該当する記事はありません。', '일치하는 기사가 없습니다.', 'ไม่มีบทความที่ตรงกัน.', 'Không có bài viết phù hợp.', 'Tidak ada artikel yang cocok.', 'لا توجد مقالات مطابقة.', 'कोई मेल खाने वाला लेख नहीं।', 'No hay artículos coincidentes.', 'Aucun article correspondant.'),
    min: L('min baca', 'min read', '分钟', 'நிமிட வாசிப்பு', '分', '분', 'นาทีในการอ่าน', 'phút đọc', 'mnt baca', 'دقيقة قراءة', 'मिनट का पठन', 'min de lectura', 'min de lecture'),
    cites: L('rujukan', 'cites', '引用', 'மேற்கோள்கள்', '出典', '출처', 'อ้างอิง', 'trích dẫn', 'kutipan', 'مراجع', 'संदर्भ', 'citas', 'citations'),
    langsWord: L('bahasa', 'languages', '种语言', 'மொழிகள்', '言語', '개 언어', 'ภาษา', 'ngôn ngữ', 'bahasa', 'لغات', 'भाषाएँ', 'idiomas', 'langues'),
    updated: L('Dikemas kini', 'Updated', '更新', 'புதுப்பிக்கப்பட்டது', '更新日', '업데이트', 'อัปเดตแล้ว', 'Đã cập nhật', 'Diperbarui', 'محدّث', 'अद्यतन', 'Actualizado', 'Mis à jour'),
    readers: L('pembaca', 'readers', '读者', 'வாசகர்கள்', '読者', '독자', 'ผู้อ่าน', 'độc giả', 'pembaca', 'قرّاء', 'पाठक', 'lectores', 'lecteurs'),
    noDate: L('Tiada tarikh', 'No date', '无日期', 'தேதி இல்லை', '日付なし', '날짜 없음', 'ไม่มีวันที่', 'Không có ngày', 'Tidak ada tanggal', 'لا يوجد تاريخ', 'कोई तिथि नहीं', 'Sin fecha', 'Sans date'),
    crossListed: L('Juga di sini', 'Also here', '也在此', 'இங்கும்', 'ここにも', '여기에도', 'อยู่ที่นี่ด้วย', 'Cũng ở đây', 'Juga di sini', 'هنا أيضًا', 'यहाँ भी', 'También aquí', 'Aussi ici'),
    primarilyIn: L('Utamanya dalam', 'Primarily in', '主要归于', 'முதன்மையாக', '主に', '주로', 'หลักอยู่ใน', 'Chủ yếu ở', 'Terutama di', 'بشكل أساسي في', 'मुख्यतः', 'Principalmente en', 'Principalement dans'),
  })}
></script>
<script type="application/json" id="articles-config" set:html={JSON.stringify({ groupByDate, dateLocale, fixedOrder, showRank })}></script>
<script type="application/json" id="articles-dict" set:html={JSON.stringify({ sec: secById, cat: catById, top: topById })}></script>

<script>
  const rows = JSON.parse(document.getElementById('articles-data')?.textContent || '[]');
  const I18N = JSON.parse(document.getElementById('articles-i18n')?.textContent || '{}');
  const CFG = JSON.parse(document.getElementById('articles-config')?.textContent || '{}');
  // Label dictionaries (rows carry only ids to keep the inline JSON small).
  const DICT = JSON.parse(document.getElementById('articles-dict')?.textContent || '{}');
  const SEC = DICT.sec || {}, CAT = DICT.cat || {}, TOP = DICT.top || {};
  const secLbl = (r) => SEC[r.secId] || '';
  const catLbl = (r) => CAT[r.catId] || r.catId || '';
  const topLbl = (r) => (r.topId ? (TOP[r.topId] || r.topId) : '');
  const $ = (id) => document.getElementById(id);
  const on = (id, ev, fn) => { const el = $(id); if (el) el.addEventListener(ev, fn); };
  const $$ = (cls) => Array.from(document.querySelectorAll('.' + cls));
  const onAll = (cls, ev, fn) => $$(cls).forEach((el) => el.addEventListener(ev, fn));

  const state = { sort: 'upd', dir: 'desc', q: '', sec: '', cat: '', top: '', st: '', page: 1, size: 25 };

  const cmp = (a, b) => {
    const k = state.sort;
    let av = a[k], bv = b[k];
    if (k === 'src' || k === 'conn' || k === 'min' || k === 'reads') { av = +av; bv = +bv; }
    else { av = String(av).toLowerCase(); bv = String(bv).toLowerCase(); }
    let r = av < bv ? -1 : av > bv ? 1 : 0;
    // Most-read ties fall back to newest-first (matches the Most Read page).
    if (k === 'reads' && r === 0) r = String(a.upd) < String(b.upd) ? -1 : String(a.upd) > String(b.upd) ? 1 : 0;
    return state.dir === 'asc' ? r : -r;
  };

  function filtered() {
    return rows.filter((r) =>
      (!state.q || r.t.toLowerCase().includes(state.q)) &&
      (!state.sec || r.secId === state.sec) &&
      (!state.cat || r.catId === state.cat) &&
      (!state.top || r.topId === state.top) &&
      (!state.st || r.st === state.st),
    );
  }

  const esc = (s) => String(s).replace(/[<>&]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' }[c]));
  // Derive the localized href from the bare `/category/slug` path.
  const _lang = (document.documentElement.lang || 'en').slice(0, 2);
  const href = (p) => (_lang === 'ms' ? p : `/${_lang}${p}`);
  const fmtN = (n) => Number(n).toLocaleString();

  // Section › category › topic tags above the title (category highlighted).
  function tagsHtml(r) {
    const sec = secLbl(r), cat = catLbl(r), top = topLbl(r);
    let out = '';
    if (sec) out += `<span class="tg">${esc(sec)}</span>`;
    if (cat) out += `${out ? '<span class="sep">›</span>' : ''}<span class="tg cat">${esc(cat)}</span>`;
    if (top) out += `<span class="sep">›</span><span class="tg">${esc(top)}</span>`;
    return `<span class="rc-tags">${out}</span>`;
  }

  // Quiet meta line: cites · read time · updated · languages (· readers on rank).
  function metaHtml(r) {
    const bits = [];
    if (r.src > 0) bits.push(`<span>📚 ${r.src} ${I18N.cites}</span>`);
    bits.push(`<span>⏱️ ${r.min} ${I18N.min}</span>`);
    if (r.upd) bits.push(`<span>${I18N.updated} ${r.upd}</span>`);
    if (r.nl > 1) bits.push(`<span>${r.nl} ${I18N.langsWord}</span>`);
    let html = bits.join('<span class="dot" aria-hidden="true">·</span>');
    if (r.sens) html += `<span class="dot" aria-hidden="true">·</span><span class="rc-sens" title="${esc(r.cls)}">🔒</span>`;
    return `<div class="rc-meta">${html}</div>`;
  }

  // A status tag only when the article is NOT the default "published" state —
  // published is implied, badging it is noise.
  function statusHtml(r) {
    if (!r.st || r.st === 'published') return '';
    return `<span class="rc-status s-${r.st}">${esc(I18N.status[r.st] || r.st)}</span>`;
  }

  // Cross-listed guest pill — shown when the card's primary category differs from
  // the list's home category (an `alsoIn` guest). Tooltip names its home category.
  function guestHtml(r) {
    if (!r.guest) return '';
    const home = catLbl(r);
    return `<span class="rc-guest" title="${esc(I18N.primarilyIn)} ${esc(home)}">↗ ${esc(I18N.crossListed)}</span>`;
  }

  function cardHtml(r) {
    const img = r.hero || r.og;
    const rank = CFG.showRank
      ? `<div class="rc-rankline"><span class="rc-rank">#${r.rank}</span>${r.reads ? `<span class="rc-reads">👁 ${fmtN(r.reads)} ${I18N.readers}</span>` : ''}</div>`
      : '';
    return `
      <article class="rcard">
        <a class="rc-thumb" href="${href(r.p)}" tabindex="-1" aria-hidden="true">
          <img class="rc-img" src="${esc(img)}" alt="" loading="lazy" decoding="async" />
        </a>
        <div class="rc-body">
          <div class="rc-top">${tagsHtml(r)}${guestHtml(r)}${statusHtml(r)}</div>
          ${rank}
          <a class="rc-title" href="${href(r.p)}">${esc(r.t)}</a>
          ${r.sum ? `<p class="rc-sum">${esc(r.sum)}</p>` : ''}
          ${metaHtml(r)}
        </div>
      </article>`;
  }

  function render() {
    const data = CFG.fixedOrder ? filtered() : filtered().sort(cmp);
    const total = data.length;
    const pages = Math.max(1, Math.ceil(total / state.size));
    if (state.page > pages) state.page = pages;
    const start = (state.page - 1) * state.size;
    const slice = data.slice(start, start + state.size);

    const body = $('alist-body');
    if (!slice.length) {
      body.innerHTML = `<p class="empty">${I18N.empty}</p>`;
    } else if (CFG.groupByDate) {
      const fmt = new Intl.DateTimeFormat(CFG.dateLocale || 'en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
      let out = '', last = null;
      for (const r of slice) {
        const d = r.upd || '';
        if (d !== last) {
          last = d;
          const label = d ? fmt.format(new Date(d + 'T00:00:00')) : (I18N.noDate || '');
          out += `<div class="date-head"><time class="dh-label">${label}</time><span class="dh-line"></span></div>`;
        }
        out += cardHtml(r);
      }
      body.innerHTML = out;
    } else {
      body.innerHTML = slice.map(cardHtml).join('');
    }

    // Hide an OG thumbnail that 404s (a brand-new article the build hasn't
    // rendered yet) so the gradient shows instead of a broken-image icon.
    body.querySelectorAll('img.rc-img').forEach((img) => {
      const hide = () => img.closest('.rc-thumb')?.classList.add('noimg');
      if (img.complete && img.naturalWidth === 0) hide();
      else img.addEventListener('error', hide, { once: true });
    });

    const a = total ? start + 1 : 0;
    const b = Math.min(start + state.size, total);
    const countTxt = I18N.showing.replace('{a}', a).replace('{b}', b).replace('{n}', total);
    $$('pg-count').forEach((el) => (el.textContent = countTxt));
    $$('pg-total').forEach((el) => (el.textContent = pages));
    $$('pg-no').forEach((el) => { el.value = state.page; el.max = pages; });
    $$('pg-size-sel').forEach((el) => (el.value = String(state.size)));
    [...$$('pg-first'), ...$$('pg-prev')].forEach((el) => (el.disabled = state.page <= 1));
    [...$$('pg-next'), ...$$('pg-last')].forEach((el) => (el.disabled = state.page >= pages));
    // Hide the pager entirely when everything fits on one page — a lone
    // "1–22 of 22 · Page 1/1" with dead arrows is pure control noise.
    document.querySelectorAll('.pager').forEach((p) => p.classList.toggle('pg-hidden', pages <= 1));
    const reset = $('f-reset');
    if (reset) reset.hidden = !(state.sec || state.cat || state.top || state.st || state.q);
  }

  function go(page) { state.page = page; render(); }

  // Cascading filters: Categories are constrained by the chosen Section, and
  // Topics by the chosen Section + Category. Option lists are derived from the
  // rows themselves so they always match what's actually available.
  const F_CAT = $('f-cat'), F_TOP = $('f-top');
  const PH_CAT = F_CAT ? F_CAT.options[0].textContent : '';
  const PH_TOP = F_TOP ? F_TOP.options[0].textContent : '';

  function uniqueBy(pred, idKey, labelFn) {
    const seen = new Map();
    for (const r of rows) {
      if (!pred(r)) continue;
      if (r[idKey] && !seen.has(r[idKey])) seen.set(r[idKey], labelFn(r));
    }
    return [...seen.entries()].sort((a, b) => (String(a[1]).toLowerCase() < String(b[1]).toLowerCase() ? -1 : 1));
  }

  function fillSelect(el, opts, placeholder, current) {
    if (!el) return current;
    const valid = opts.some(([id]) => id === current);
    el.innerHTML = `<option value="">${placeholder}</option>` +
      opts.map(([id, label]) => `<option value="${id}">${label}</option>`).join('');
    el.value = valid ? current : '';
    return valid ? current : '';
  }

  function syncFilters() {
    const cats = uniqueBy((r) => !state.sec || r.secId === state.sec, 'catId', catLbl);
    state.cat = fillSelect(F_CAT, cats, PH_CAT, state.cat);
    const tops = uniqueBy((r) => (!state.sec || r.secId === state.sec) && (!state.cat || r.catId === state.cat), 'topId', topLbl);
    state.top = fillSelect(F_TOP, tops, PH_TOP, state.top);
  }

  document.querySelectorAll('.tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach((x) => x.classList.remove('on'));
      btn.classList.add('on');
      state.sort = btn.dataset.sort; state.dir = btn.dataset.dir; state.page = 1; render();
    });
  });

  // Mobile: collapse the advanced controls behind the "Filters & sort" toggle.
  const tbMore = document.querySelector('[data-tb-toggle]');
  const tbAdv = document.querySelector('.tb-adv');
  if (tbMore && tbAdv) {
    tbMore.addEventListener('click', () => {
      const open = tbAdv.classList.toggle('open');
      tbMore.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }

  on('f-q', 'input', (e) => { state.q = e.target.value.trim().toLowerCase(); state.page = 1; render(); });
  on('f-sec', 'change', (e) => { state.sec = e.target.value; state.page = 1; syncFilters(); render(); });
  on('f-cat', 'change', (e) => { state.cat = e.target.value; state.page = 1; syncFilters(); render(); });
  on('f-top', 'change', (e) => { state.top = e.target.value; state.page = 1; render(); });
  on('f-status', 'change', (e) => { state.st = e.target.value; state.page = 1; render(); });
  on('f-reset', 'click', () => {
    state.sec = state.cat = state.top = state.st = state.q = '';
    state.sort = 'upd'; state.dir = 'desc'; state.page = 1;
    const secEl = $('f-sec'); if (secEl) secEl.value = '';
    const stEl = $('f-status'); if (stEl) stEl.value = '';
    const qEl = $('f-q'); if (qEl) qEl.value = '';
    document.querySelectorAll('.tab').forEach((x) => x.classList.remove('on'));
    const def = document.querySelector('.tab[data-sort="upd"]'); if (def) def.classList.add('on');
    syncFilters();
    render();
  });
  onAll('pg-size-sel', 'change', (e) => { state.size = +e.target.value; state.page = 1; render(); });
  onAll('pg-first', 'click', () => go(1));
  onAll('pg-prev', 'click', () => go(state.page - 1));
  onAll('pg-next', 'click', () => go(state.page + 1));
  onAll('pg-last', 'click', () => go(Math.ceil(filtered().length / state.size)));
  onAll('pg-no', 'change', (e) => {
    const n = Math.max(1, Math.min(+e.target.value || 1, Math.ceil(filtered().length / state.size)));
    go(n);
  });

  // Deep-link: pre-apply filters/sort from URL query params so a hub "See all →"
  // can land on a pre-filtered list (e.g. /latest?cat=taxation, /most-read?sec=…).
  if (location.search) {
    try {
      const sp = new URLSearchParams(location.search);
      const setSel = (id, key, val) => {
        if (!val) return;
        const el = $(id);
        if (el && [...el.options].some((o) => o.value === val)) { state[key] = val; el.value = val; }
      };
      setSel('f-sec', 'sec', sp.get('sec'));
      setSel('f-cat', 'cat', sp.get('cat'));
      setSel('f-status', 'st', sp.get('status'));
      syncFilters(); // cascade the topic options for the chosen section/category
      setSel('f-top', 'top', sp.get('top'));
      const SORTS = { latest: ['upd', 'desc'], 'most-read': ['reads', 'desc'], reads: ['reads', 'desc'], az: ['t', 'asc'], sourced: ['src', 'desc'], linked: ['conn', 'desc'] };
      const s = sp.get('sort');
      if (s && SORTS[s]) {
        [state.sort, state.dir] = SORTS[s];
        document.querySelectorAll('.tab').forEach((x) => x.classList.remove('on'));
        const btn = document.querySelector(`.tab[data-sort="${state.sort}"]`);
        if (btn) btn.classList.add('on');
      }
    } catch (e) { /* malformed query — fall back to the unfiltered list */ }
  }

  render();
</script>

<style>
  /* Three stacked lines: Filter, Sort, Search — each labelled, with breathing room. */
  /* Top spacing comes from the global .block rhythm — don't add margin here. */
  .art-toolbar {
    display: flex; flex-direction: column; gap: 1.1rem;
    margin-bottom: 1.6rem; padding-bottom: 1.3rem; border-bottom: 1px solid var(--line);
  }
  /* Advanced controls (Filter/Sort) show inline on desktop; on phones they
     collapse behind a "Filters & sort" toggle so only Search stays visible. */
  .tb-more { display: none; }
  .tb-adv { display: flex; flex-direction: column; gap: 1.1rem; }
  @media (max-width: 760px) {
    .tb-more {
      display: inline-flex; align-items: center; gap: 0.4rem; align-self: flex-start;
      font: inherit; font-size: 0.82rem; font-weight: 600;
      padding: 0.5rem 0.95rem; border-radius: 999px;
      border: 1px solid color-mix(in srgb, var(--gold) 55%, var(--line));
      background: var(--surface); color: var(--ink); cursor: pointer;
    }
    .tb-more .tbm-caret { font-size: 0.7em; opacity: 0.7; transition: transform 0.15s; }
    .tb-more[aria-expanded='true'] .tbm-caret { transform: rotate(180deg); }
    .tb-adv { display: none; }
    .tb-adv.open { display: flex; }
  }
  .tb-line { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .tb-label {
    flex: none; min-width: 3.5rem; font-size: 0.68rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink);
  }
  .controls { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .tab {
    font-size: 0.82rem; font-weight: 500; padding: 0.4rem 0.8rem; border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--gold) 55%, var(--line));
    background: var(--surface); color: var(--ink-soft); cursor: pointer;
  }
  .tab:hover { border-color: var(--gold); background: color-mix(in srgb, var(--gold) 10%, var(--surface)); }
  .tab.on { color: var(--accent-contrast); background: var(--gold); border-color: var(--gold); }
  .controls select, .tb-line input[type='search'] {
    font: inherit; font-size: 0.85rem; padding: 0.45rem 0.7rem; border-radius: 8px;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink);
  }
  .tb-line input[type='search'] { min-width: min(26rem, 100%); flex: 1; max-width: 30rem; }
  .controls select:focus, .tb-line input[type='search']:focus { outline: none; border-color: var(--gold); }
  #f-reset {
    font: inherit; font-size: 0.8rem; font-weight: 500; padding: 0.45rem 0.85rem; border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--gold) 40%, var(--line)); background: transparent;
    color: var(--gold); cursor: pointer;
  }
  #f-reset:hover { background: color-mix(in srgb, var(--gold) 12%, transparent); border-color: var(--gold); }
  #f-reset[hidden] { display: none; }

  /* ---- Editorial row-card list ---- */
  .acards { display: flex; flex-direction: column; gap: 0.7rem; }
  /* Date group header (grouped view only): gold label + a rule filling the row. */
  .acards :global(.date-head) { display: flex; align-items: center; gap: 0.9rem; margin: 0.9rem 0 0.1rem; }
  .acards :global(.date-head:first-child) { margin-top: 0; }
  .acards :global(.dh-label) {
    flex: none; font-family: var(--font-title); font-weight: 700; font-size: 0.95rem;
    color: var(--gold); font-variant-numeric: tabular-nums;
  }
  .acards :global(.dh-line) { flex: 1; height: 1px; background: var(--line); }

  .acards :global(.rcard) {
    display: flex; gap: 1.1rem; align-items: stretch;
    border: 1px solid var(--line);
    border-inline-start: 3px solid color-mix(in srgb, var(--gold) 55%, var(--line));
    border-radius: 12px; background: var(--surface);
    padding: 0.9rem 1.05rem; overflow: hidden;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .acards :global(.rcard:hover) {
    border-color: color-mix(in srgb, var(--gold) 50%, var(--line));
    border-inline-start-color: var(--gold); background: var(--surface-2);
  }
  /* Thumbnail — OG card (or a real cover photo) on a brand gradient fallback. */
  .acards :global(.rc-thumb) {
    flex: 0 0 clamp(128px, 24%, 184px); align-self: flex-start;
    aspect-ratio: 16 / 9; border-radius: 9px; overflow: hidden; position: relative;
    text-decoration: none; border: 1px solid var(--line);
    background:
      radial-gradient(120% 120% at 30% 20%, color-mix(in srgb, var(--gold) 22%, transparent), transparent),
      linear-gradient(135deg, color-mix(in srgb, var(--gold) 14%, var(--surface-2)), var(--surface-2));
  }
  .acards :global(.rc-thumb .rc-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .acards :global(.rc-thumb.noimg .rc-img) { display: none; }

  .acards :global(.rc-body) { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.38rem; }
  .acards :global(.rc-top) { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .acards :global(.rc-tags) {
    display: inline-flex; flex-wrap: wrap; align-items: center; min-width: 0;
    font-size: 0.72rem; color: var(--muted); line-height: 1.3;
  }
  .acards :global(.rc-tags .tg) { color: var(--ink-soft); }
  .acards :global(.rc-tags .cat) { color: var(--gold); font-weight: 700; }
  .acards :global(.rc-tags .sep) { margin: 0 0.4rem; color: var(--muted); opacity: 0.55; }
  .acards :global(.rc-status) {
    flex: none; font-size: 0.64rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;
