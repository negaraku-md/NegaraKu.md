---
import type { Locale } from '@/lib/categories';
import type { Article } from '@/lib/content';
import { getCategory, getPillar, getPillarDef, PILLARS } from '@/lib/categories';
import { allArticles, effectiveStatus, readingTime } from '@/lib/content';
import { subcatLabel } from '@/lib/subcategories';
import { localePath, t } from '@/lib/i18n';
import { readFileSync } from 'node:fs';

// Optional visitor analytics, keyed by "category/slug". Three buckets — human
// readers, search-engine crawlers, and AI crawlers — each tracked in detail by
// named agent but summarised on the card. `search`/`ai` may be a plain number
// or { total, byBot: { Googlebot: n, … } }. Absent until analytics is wired up
// (see docs) — the row then shows "not tracked yet" rather than inventing data.
type Bucket = number | { total: number; byBot?: Record<string, number> };
let analytics: Record<string, { readers?: number; search?: Bucket; ai?: Bucket }> = {};
try {
  analytics = JSON.parse(readFileSync('public/api/analytics.json', 'utf8'));
} catch {
  analytics = {};
}

// Reusable article card-list: sort tabs, filters, paginated cards. Used on the
// All Articles page and, pre-scoped, on section / category / topic pages — one
// list design everywhere; only which filters show differs. Interaction is
// client-side over an embedded manifest, so no build-time pagination.

type FilterKey = 'sec' | 'cat' | 'top' | 'status';
interface Props {
  locale: Locale;
  articles: Article[]; // already scoped by the caller (all, or one section/category/topic)
  filters?: FilterKey[];
  /** Hide the Sort row and lock the order to newest-first (used by /latest). */
  hideSort?: boolean;
  /** Insert a date header before each new day's run of cards (newest-first). */
  groupByDate?: boolean;
  /** Preserve the caller's order instead of client-sorting (used by /trending,
      where the caller pre-ranks by reads with a recency fallback). */
  fixedOrder?: boolean;
  /** Show a rank number + reader count on each card (used by /trending). */
  showRank?: boolean;
}
const {
  locale,
  articles,
  filters = ['sec', 'cat', 'top', 'status'],
  hideSort = false,
  groupByDate = false,
  fixedOrder = false,
  showRank = false,
} = Astro.props;
const has = (f: FilterKey) => filters.includes(f);
const dateLocale = locale === 'zh' ? 'zh-Hans' : locale === 'ms' ? 'ms-MY' : 'en-GB';
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

// Which languages each topic exists in (publishable files only).
const langsByKey = new Map<string, Set<string>>();
for (const a of await allArticles()) {
  const key = `${a.data.category}/${a.data.slug}`;
  (langsByKey.get(key) ?? langsByKey.set(key, new Set()).get(key)!).add(a.data.lang);
}

const SENS_LABEL: Record<string, string> = {
  race: L('Kaum', 'Race', '种族'),
  religion: L('Agama', 'Religion', '宗教'),
  royalty: L('Institusi diraja', 'Royalty', '王室'),
  constitution: L('Perlembagaan', 'Constitution', '宪法'),
  elections: L('Pilihan raya', 'Elections', '选举'),
  security: L('Keselamatan', 'Security', '安全'),
  health: L('Kesihatan', 'Health', '健康'),
  'legal-proceedings': L('Perundangan', 'Legal', '法律程序'),
};

const iso = (v: unknown) => (v ? new Date(v as string).toISOString().slice(0, 10) : '');

const rows = articles.map((a, i) => {
  const d = a.data;
  const key = `${d.category}/${d.slug}`;
  const conn = (d.related?.length ?? 0) + (d.relations?.length ?? 0);
  const pillar = getPillar(d.category);
  const topic = d.subcategory?.[0];
  const sens = d.sensitivity && d.sensitivity !== 'none' ? d.sensitivity : null;
  const st = effectiveStatus(a);
  const revs = [...(d.revisions ?? [])].sort((x, y) => +new Date(x.date) - +new Date(y.date));
  const first = revs[0];
  // Chain of custody — SAME derivation as ArticleView so the two never diverge:
  // reviewed/published fall back to the review record we actually keep. Unknown
  // human actor → "AI draft" (draft step); a step not yet reached is "pending".
  const isReviewed = d.status === 'reviewed' || d.status === 'published';
  const isPublished = d.status === 'published';
  const custody = [
    { key: 'draft', who: d.aiAssisted ? null : first?.contributor ?? d.author ?? null, date: iso(d.created ?? first?.date ?? d.updated), reached: true },
    { key: 'reviewed', who: isReviewed ? d.reviewer ?? null : null, date: isReviewed ? iso(d.reviewed) : '', reached: isReviewed },
    { key: 'published', who: isPublished ? d.publishedBy ?? d.reviewer ?? null : null, date: isPublished ? iso(d.published ?? d.reviewed) : '', reached: isPublished },
  ];
  return {
    t: d.title,
    h: localePath(`/${d.category}/${d.slug}`, locale),
    p: `/${d.category}/${d.slug}`,
    sec: pillar ? getPillarDef(pillar)?.name[locale] ?? pillar : '—',
    secId: pillar ?? '',
    cat: getCategory(d.category)?.name[locale] ?? d.category,
    catId: d.category,
    top: topic ? subcatLabel(topic, locale) : '—',
    topId: topic ?? '',
    ml: (d.masterLanguage ?? d.lang ?? 'ms').toUpperCase(),
    st,
    cls: sens ? SENS_LABEL[sens] ?? L('Sensitif', 'Sensitive', '敏感') : L('Umum', 'General', '一般'),
    sens: !!sens,
    rev: d.reviewDue ? new Date(d.reviewDue).toISOString().slice(0, 10) : '',
    revOverdue: !!d.reviewDue && new Date(d.reviewDue).getTime() < Date.now(),
    langs: [...(langsByKey.get(key) ?? [])].sort(),
    src: d.sources?.length ?? 0,
    min: readingTime(a),
    conn,
    upd: d.updated ? new Date(d.updated).toISOString().slice(0, 10) : '',
    custody,
    views: analytics[key] ?? null,
    rank: i + 1,
  };
});

const secs = PILLARS.filter((p) => rows.some((r) => r.secId === p.id)).map((p) => [p.id, p.name[locale]]);
const cats = [...new Map(rows.map((r) => [r.catId, r.cat])).entries()].sort((a, b) => (a[1] < b[1] ? -1 : 1));
const tops = [...new Map(rows.filter((r) => r.topId).map((r) => [r.topId, r.top])).entries()].sort((a, b) =>
  a[1] < b[1] ? -1 : 1,
);
const LIFECYCLE = ['draft', 'in-review', 'reviewed', 'published', 'needs-update', 'in-update', 'archived'];
const statusCounts: Record<string, number> = {};
for (const r of rows) statusCounts[r.st] = (statusCounts[r.st] ?? 0) + 1;
const presentStatuses = LIFECYCLE.filter((s) => statusCounts[s]);
---

<section class="container block art-list">
  <div class="art-toolbar" data-pagefind-ignore>
    {
      (secs.length > 1 || cats.length > 1 || tops.length > 1 || presentStatuses.length > 1) && (
        <div class="tb-line">
          <span class="tb-label">{L('Tapis', 'Filter', '筛选')}</span>
          <div class="controls">
            {has('sec') && secs.length > 1 && (
              <select id="f-sec">
                <option value="">{L('Semua seksyen', 'All sections', '所有版块')}</option>
                {secs.map(([id, name]) => <option value={id}>{name}</option>)}
              </select>
            )}
            {has('cat') && cats.length > 1 && (
              <select id="f-cat">
                <option value="">{L('Semua kategori', 'All categories', '所有分类')}</option>
                {cats.map(([id, name]) => <option value={id}>{name}</option>)}
              </select>
            )}
            {has('top') && tops.length > 1 && (
              <select id="f-top">
                <option value="">{L('Semua topik', 'All topics', '所有主题')}</option>
                {tops.map(([id, name]) => <option value={id}>{name}</option>)}
              </select>
            )}
            {has('status') && presentStatuses.length > 1 && (
              <select id="f-status">
                <option value="">{L('Semua status', 'All statuses', '所有状态')}</option>
                {presentStatuses.map((s) => (
                  <option value={s}>{t(`status.${s}`, locale)} ({statusCounts[s]})</option>
                ))}
              </select>
            )}
            <button id="f-reset" type="button" hidden>{L('Set semula', 'Reset', '重置')}</button>
          </div>
        </div>
      )
    }
    {!hideSort && (
      <div class="tb-line">
        <span class="tb-label">{L('Isih', 'Sort', '排序')}</span>
        <div class="tabs" role="tablist">
          <button class="tab on" data-sort="upd" data-dir="desc">{L('Terkini', 'Latest', '最新')}</button>
          <button class="tab" data-sort="t" data-dir="asc">{L('A–Z', 'A–Z', 'A–Z')}</button>
          <button class="tab" data-sort="src" data-dir="desc">{L('Paling banyak sumber', 'Most sourced', '来源最多')}</button>
          <button class="tab" data-sort="conn" data-dir="desc">{L('Paling terhubung', 'Most linked', '关联最多')}</button>
        </div>
      </div>
    )}
    <div class="tb-line">
      <span class="tb-label">{L('Papar', 'Display', '显示')}</span>
      <div class="tabs">
        <button class="tgl" type="button" data-row="path">{L('Laluan', 'Path', '路径')}</button>
        <button class="tgl" type="button" data-row="details">{L('Butiran', 'Details', '详情')}</button>
        <button class="tgl" type="button" data-row="custody">{L('Status', 'Status', '状态')}</button>
        <button class="tgl" type="button" data-row="visitors">{L('Pelawat', 'Visitors', '访客')}</button>
        <span class="tgl-sep" aria-hidden="true"></span>
        <button class="tgl-all" type="button" data-rows="on">{L('Semua buka', 'All on', '全部开')}</button>
        <button class="tgl-all" type="button" data-rows="off">{L('Semua tutup', 'All off', '全部关')}</button>
      </div>
    </div>
    <div class="tb-line">
      <span class="tb-label">{L('Cari', 'Search', '搜索')}</span>
      <input id="f-q" type="search" placeholder={L('Cari tajuk…', 'Search titles…', '搜索标题…')} />
    </div>
  </div>

  <div class="pager pager-top" data-pagefind-ignore>
    <div class="pg-size">
      <label>{L('Baris', 'Rows', '每页')}
        <select class="pg-size-sel">
          <option>25</option>
          <option>50</option>
          <option>100</option>
        </select>
      </label>
      <span class="pg-count"></span>
    </div>
    <div class="pg-nav">
      <button class="pg-first" title={L('Pertama', 'First', '首页')}>«</button>
      <button class="pg-prev" title={L('Sebelum', 'Prev', '上一页')}>‹</button>
      <span class="pg-of">
        {L('Halaman', 'Page', '第')}
        <input class="pg-no" type="number" min="1" value="1" />
        / <span class="pg-total">1</span>
      </span>
      <button class="pg-next" title={L('Seterusnya', 'Next', '下一页')}>›</button>
      <button class="pg-last" title={L('Akhir', 'Last', '末页')}>»</button>
    </div>
  </div>

  <div class="acards" id="alist-body"></div>

  <div class="pager" data-pagefind-ignore>
    <div class="pg-size">
      <label>{L('Baris', 'Rows', '每页')}
        <select class="pg-size-sel">
          <option>25</option>
          <option>50</option>
          <option>100</option>
        </select>
      </label>
      <span class="pg-count"></span>
    </div>
    <div class="pg-nav">
      <button class="pg-first" title={L('Pertama', 'First', '首页')}>«</button>
      <button class="pg-prev" title={L('Sebelum', 'Prev', '上一页')}>‹</button>
      <span class="pg-of">
        {L('Halaman', 'Page', '第')}
        <input class="pg-no" type="number" min="1" value="1" />
        / <span class="pg-total">1</span>
      </span>
      <button class="pg-next" title={L('Seterusnya', 'Next', '下一页')}>›</button>
      <button class="pg-last" title={L('Akhir', 'Last', '末页')}>»</button>
    </div>
  </div>
</section>

<script type="application/json" id="articles-data" set:html={JSON.stringify(rows)}></script>
<script
  type="application/json"
  id="articles-i18n"
  set:html={JSON.stringify({
    status: Object.fromEntries(LIFECYCLE.map((s) => [s, t(`status.${s}`, locale)])),
    showing: L('{a}–{b} drpd {n}', '{a}–{b} of {n}', '第 {a}–{b} 项，共 {n}'),
    empty: L('Tiada artikel sepadan.', 'No matching articles.', '没有匹配的文章。'),
    min: L('min baca', 'min read', '分钟'),
    master: L('Induk', 'Master', '主语言'),
    sources: L('sumber', 'sources', '来源'),
    linked: L('pautan', 'links', '关联'),
    updated: L('Dikemas kini', 'Updated', '更新'),
    pathLabel: L('Laluan', 'Path', '路径'),
    detailsLabel: L('Butiran', 'Details', '详情'),
    custodyLabel: L('Status', 'Status', '状态'),
    visitorsLabel: L('Pelawat', 'Visitors', '访客'),
    vReaders: L('Pembaca', 'Readers', '读者'),
    vSearch: L('Enjin carian', 'Search', '搜索引擎'),
    vAI: L('AI', 'AI', 'AI'),
    notTracked: L('belum dijejak', 'not tracked yet', '尚未追踪'),
    aiDraft: L('Dibantu AI', 'AI-assisted', 'AI 辅助'),
    pending: L('belum', 'pending', '待处理'),
    stageDrafted: L('Dirangka', 'Drafted', '起草'),
    stageReviewed: L('Disemak', 'Reviewed', '审阅'),
    stagePublished: L('Diterbitkan', 'Published', '发布'),
    nextReview: L('Semakan seterusnya', 'Next review', '下次审阅'),
    overdue: L('Semakan tertunggak', 'Review overdue', '审阅逾期'),
    contributor: L('Penyumbang', 'Contributor', '贡献者'),
    classification: L('Klasifikasi', 'Classification', '分类'),
    noDate: L('Tiada tarikh', 'No date', '无日期'),
  })}
></script>
<script type="application/json" id="articles-config" set:html={JSON.stringify({ groupByDate, dateLocale, fixedOrder, showRank })}></script>

<script>
  const rows = JSON.parse(document.getElementById('articles-data')?.textContent || '[]');
  const I18N = JSON.parse(document.getElementById('articles-i18n')?.textContent || '{}');
  const CFG = JSON.parse(document.getElementById('articles-config')?.textContent || '{}');
  const $ = (id) => document.getElementById(id);
  const on = (id, ev, fn) => { const el = $(id); if (el) el.addEventListener(ev, fn); };
  const $$ = (cls) => Array.from(document.querySelectorAll('.' + cls));
  const onAll = (cls, ev, fn) => $$(cls).forEach((el) => el.addEventListener(ev, fn));

  const state = { sort: 'upd', dir: 'desc', q: '', sec: '', cat: '', top: '', st: '', page: 1, size: 25 };

  // Which card meta-rows the reader has switched off. Rows are omitted from the
  // markup (not just hidden) so the dividers between rows stay correct.
  // Default is ALL OFF — a clean title-only list until the reader opts in.
  const ROWS_KEY = 'nk-card-rows-hidden';
  const ALL_ROWS = ['path', 'details', 'custody', 'visitors'];
  let hiddenRows = new Set(ALL_ROWS);
  try {
    const saved = localStorage.getItem(ROWS_KEY);
    if (saved) hiddenRows = new Set(JSON.parse(saved));
  } catch { /* ignore */ }
  const showRow = (r) => !hiddenRows.has(r);
  const saveRows = () => {
    try { localStorage.setItem(ROWS_KEY, JSON.stringify([...hiddenRows])); } catch { /* ignore */ }
  };

  const cmp = (a, b) => {
    const k = state.sort;
    let av = a[k], bv = b[k];
    if (k === 'src' || k === 'conn' || k === 'min') { av = +av; bv = +bv; }
    else { av = String(av).toLowerCase(); bv = String(bv).toLowerCase(); }
    const r = av < bv ? -1 : av > bv ? 1 : 0;
    return state.dir === 'asc' ? r : -r;
  };

  function filtered() {
    return rows.filter((r) =>
      (!state.q || r.t.toLowerCase().includes(state.q)) &&
      (!state.sec || r.secId === state.sec) &&
      (!state.cat || r.catId === state.cat) &&
      (!state.top || r.topId === state.top) &&
      (!state.st || r.st === state.st),
    );
  }

  const STATUS_CLASS = {
    published: 'ok', reviewed: 'ok', 'in-review': 'info', 'in-update': 'info',
    draft: 'warn', 'needs-update': 'warn', archived: 'muted',
  };

  const esc = (s) => String(s).replace(/[<>&]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' }[c]));
  const STAGE = { draft: I18N.stageDrafted, reviewed: I18N.stageReviewed, published: I18N.stagePublished };

  // Chain of custody as a progress track: a dot per lifecycle step (filled when
  // reached, hollow when pending) with the accountable actor + date. Unknown
  // human actor → "AI draft" (draft) or nothing (later steps); unreached → pending.
  function custodyHtml(cust) {
    if (!cust || !cust.length) return '';
    const items = cust.map((c) => {
      let actor = '';
      if (!c.reached) actor = `<span class="pend">${I18N.pending}</span>`;
      else if (c.who) actor = `<span class="who">${esc(c.who)}</span>`;
      else if (c.key === 'draft') actor = `<span class="ai">${I18N.aiDraft}</span>`;
      const date = c.reached && c.date ? `<time>${c.date}</time>` : '';
      return `<li class="${c.reached ? 'done' : 'todo'}"><span class="dot"></span><span class="stg">${STAGE[c.key]}</span>${actor}${date}</li>`;
    }).join('');
    return `<div class="meta-row custody"><span class="hlabel">${I18N.custodyLabel}</span><ol class="steps">${items}</ol></div>`;
  }

  // Visitor analytics summarised into Readers / Search / AI. Each bucket may be a
  // number or {total, byBot}; the per-bot detail is surfaced as a hover title.
  // No data source yet → "—" and "not tracked yet" (never invented numbers).
  const bTotal = (x) => (x == null ? null : typeof x === 'object' ? x.total : x);
  const bBreak = (x) => (x && typeof x === 'object' && x.byBot
    ? Object.entries(x.byBot).map(([k, n]) => `${k}: ${Number(n).toLocaleString()}`).join(' · ') : '');
  function visitorsHtml(v) {
    const num = (n) => (n == null ? '<b class="vn dash">—</b>' : `<b class="vn">${Number(n).toLocaleString()}</b>`);
    const metric = (label, x) => {
      const tip = bBreak(x);
      return `<span class="vm"${tip ? ` title="${esc(tip)}"` : ''}><span class="vlbl">${label}</span>${num(bTotal(x))}</span>`;
    };
    const note = v ? '' : `<span class="pend">${I18N.notTracked}</span>`;
    return `<div class="meta-row visitors"><span class="hlabel">${I18N.visitorsLabel}</span>` +
      `<div class="vwrap">${metric(I18N.vReaders, v?.readers)}${metric(I18N.vSearch, v?.search)}${metric(I18N.vAI, v?.ai)}${note}</div></div>`;
  }

  // Trending rank badge: the leaderboard position plus the reader count (or
  // "not tracked yet" when analytics haven't reached this article).
  function trendReads(r) {
    const n = bTotal(r.views?.readers);
    if (n == null) return `<span class="areads pend">${I18N.notTracked}</span>`;
    return `<span class="areads">👁 ${Number(n).toLocaleString()} ${I18N.vReaders}</span>`;
  }

  // Compact one-line summary shown when every display row is OFF, so a collapsed
  // card still carries the essentials: master language · contributor · published
  // date · next review.
  function compactHtml(r) {
    const pub = (r.custody || []).find((c) => c.key === 'published' && c.reached)
      || (r.custody || []).find((c) => c.reached && c.who);
    const bits = [`<span class="chip${r.sens ? ' sens' : ''}">${I18N.classification}: ${r.sens ? '🔒 ' : ''}${esc(r.cls)}</span>`];
    bits.push(`<span class="chip">${I18N.master}: ${r.ml}</span>`);
    if (pub && pub.who) bits.push(`<span class="chip">${I18N.contributor}: ${esc(pub.who)}</span>`);
    if (pub && pub.date) bits.push(`<span class="chip dim">${I18N.stagePublished}: ${pub.date}</span>`);
    if (r.rev) bits.push(`<span class="chip ${r.revOverdue ? 'overdue' : 'dim'}"${r.revOverdue ? ` title="${I18N.overdue}"` : ''}>${r.revOverdue ? '⚠ ' : ''}${I18N.nextReview}: ${r.rev}</span>`);
    return `<div class="meta-row compact"><div class="achips">${bits.join('')}</div></div>`;
  }

  function render() {
    const data = CFG.fixedOrder ? filtered() : filtered().sort(cmp);
    const total = data.length;
    const pages = Math.max(1, Math.ceil(total / state.size));
    if (state.page > pages) state.page = pages;
    const start = (state.page - 1) * state.size;
    const slice = data.slice(start, start + state.size);

    const body = $('alist-body');
    if (!slice.length) {
      body.innerHTML = `<p class="empty">${I18N.empty}</p>`;
    } else {
      const langHref = (l, p) => (l === 'ms' ? p : `/${l}${p}`);
      const allRowsOff = ALL_ROWS.every((x) => !showRow(x));
      const cardHtml = (r) => `
        <article class="acard${CFG.showRank ? ' ranked' : ''}">
          ${CFG.showRank ? `<div class="atrend"><span class="arank">#${r.rank}</span>${trendReads(r)}</div>` : ''}
          <a class="atitle" href="${r.h}">${r.t}</a>
          <div class="acard-meta">
            ${!showRow('path') ? '' : `
            <div class="meta-row">
              <span class="hlabel">${I18N.pathLabel}</span>
              <p class="apath"><span>${r.sec}</span><span class="sep">›</span><span>${r.cat}</span><span class="sep">›</span><span>${r.top}</span></p>
            </div>`}
            ${!showRow('details') ? '' : `
            <div class="meta-row">
              <span class="hlabel">${I18N.detailsLabel}</span>
              <div class="achips">
                <span class="st ${STATUS_CLASS[r.st] || 'muted'}">${I18N.status[r.st] || r.st}</span>
                <span class="chip ${r.sens ? 'sens' : ''}">${r.sens ? '🔒 ' : ''}${r.cls}</span>
                ${r.rev ? `<span class="chip ${r.revOverdue ? 'overdue' : 'dim'}"${r.revOverdue ? ` title="${I18N.overdue}"` : ''}>${r.revOverdue ? '⚠ ' : ''}${I18N.nextReview}: ${r.rev}</span>` : ''}
                <span class="chip">${I18N.master}: <a class="mlink" href="${langHref(r.ml.toLowerCase(), r.p)}" title="${r.t} — ${r.ml}">${r.ml}</a></span>
                <span class="chip langs">${['ms','en','zh'].map((l) => r.langs.includes(l)
                  ? `<a class="on" href="${langHref(l, r.p)}" title="${r.t} — ${l.toUpperCase()}">${l.toUpperCase()}</a>`
                  : `<span class="off">${l.toUpperCase()}</span>`).join('')}</span>
                <span class="chip">${r.src} ${I18N.sources}</span>
                <span class="chip">${r.conn} ${I18N.linked}</span>
                <span class="chip">${r.min} ${I18N.min}</span>
              </div>
            </div>`}
            ${showRow('custody') ? custodyHtml(r.custody) : ''}
            ${showRow('visitors') ? visitorsHtml(r.views) : ''}
            ${allRowsOff ? compactHtml(r) : ''}
          </div>
        </article>`;
      if (CFG.groupByDate) {
        const fmt = new Intl.DateTimeFormat(CFG.dateLocale || 'en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
        let out = '', last = null;
        for (const r of slice) {
          const d = r.upd || '';
          if (d !== last) {
            last = d;
            const label = d ? fmt.format(new Date(d + 'T00:00:00')) : (I18N.noDate || '');
            out += `<div class="date-head"><time class="dh-label">${label}</time><span class="dh-line"></span></div>`;
          }
          out += cardHtml(r);
        }
        body.innerHTML = out;
      } else {
        body.innerHTML = slice.map(cardHtml).join('');
      }
    }

    const a = total ? start + 1 : 0;
    const b = Math.min(start + state.size, total);
    const countTxt = I18N.showing.replace('{a}', a).replace('{b}', b).replace('{n}', total);
    $$('pg-count').forEach((el) => (el.textContent = countTxt));
    $$('pg-total').forEach((el) => (el.textContent = pages));
    $$('pg-no').forEach((el) => { el.value = state.page; el.max = pages; });
    $$('pg-size-sel').forEach((el) => (el.value = String(state.size)));
    [...$$('pg-first'), ...$$('pg-prev')].forEach((el) => (el.disabled = state.page <= 1));
    [...$$('pg-next'), ...$$('pg-last')].forEach((el) => (el.disabled = state.page >= pages));
    const reset = $('f-reset');
    if (reset) reset.hidden = !(state.sec || state.cat || state.top || state.st || state.q);
  }

  function go(page) { state.page = page; render(); }

  // Cascading filters: Categories are constrained by the chosen Section, and
  // Topics by the chosen Section + Category. Option lists are derived from the
  // rows themselves so they always match what's actually available.
  const F_CAT = $('f-cat'), F_TOP = $('f-top');
  const PH_CAT = F_CAT ? F_CAT.options[0].textContent : '';
  const PH_TOP = F_TOP ? F_TOP.options[0].textContent : '';

  function uniqueBy(pred, idKey, labelKey) {
    const seen = new Map();
    for (const r of rows) {
      if (!pred(r)) continue;
      if (r[idKey] && !seen.has(r[idKey])) seen.set(r[idKey], r[labelKey]);
    }
    return [...seen.entries()].sort((a, b) => (String(a[1]).toLowerCase() < String(b[1]).toLowerCase() ? -1 : 1));
  }

  function fillSelect(el, opts, placeholder, current) {
    if (!el) return current;
    const valid = opts.some(([id]) => id === current);
    el.innerHTML = `<option value="">${placeholder}</option>` +
      opts.map(([id, label]) => `<option value="${id}">${label}</option>`).join('');
    el.value = valid ? current : '';
    return valid ? current : '';
  }

  function syncFilters() {
    const cats = uniqueBy((r) => !state.sec || r.secId === state.sec, 'catId', 'cat');
    state.cat = fillSelect(F_CAT, cats, PH_CAT, state.cat);
    const tops = uniqueBy((r) => (!state.sec || r.secId === state.sec) && (!state.cat || r.catId === state.cat), 'topId', 'top');
    state.top = fillSelect(F_TOP, tops, PH_TOP, state.top);
  }

  document.querySelectorAll('.tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach((x) => x.classList.remove('on'));
      btn.classList.add('on');
      state.sort = btn.dataset.sort; state.dir = btn.dataset.dir; state.page = 1; render();
    });
  });
  // Display toggles: switch a card meta-row on/off and remember the choice.
  function syncRowToggles() {
    document.querySelectorAll('[data-row]').forEach((b) => b.classList.toggle('on', showRow(b.dataset.row)));
  }
  document.querySelectorAll('[data-row]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const r = btn.dataset.row;
      if (hiddenRows.has(r)) hiddenRows.delete(r); else hiddenRows.add(r);
      saveRows();
      syncRowToggles();
      render();
    });
  });
  document.querySelectorAll('[data-rows]').forEach((btn) => {
    btn.addEventListener('click', () => {
      hiddenRows = btn.dataset.rows === 'on' ? new Set() : new Set(ALL_ROWS);
      saveRows();
      syncRowToggles();
      render();
    });
  });
  syncRowToggles();

  on('f-q', 'input', (e) => { state.q = e.target.value.trim().toLowerCase(); state.page = 1; render(); });
  on('f-sec', 'change', (e) => { state.sec = e.target.value; state.page = 1; syncFilters(); render(); });
  on('f-cat', 'change', (e) => { state.cat = e.target.value; state.page = 1; syncFilters(); render(); });
  on('f-top', 'change', (e) => { state.top = e.target.value; state.page = 1; render(); });
  on('f-status', 'change', (e) => { state.st = e.target.value; state.page = 1; render(); });
  on('f-reset', 'click', () => {
    state.sec = state.cat = state.top = state.st = state.q = '';
    state.sort = 'upd'; state.dir = 'desc'; state.page = 1;
    const secEl = $('f-sec'); if (secEl) secEl.value = '';
    const stEl = $('f-status'); if (stEl) stEl.value = '';
    const qEl = $('f-q'); if (qEl) qEl.value = '';
    document.querySelectorAll('.tab').forEach((x) => x.classList.remove('on'));
    const def = document.querySelector('.tab[data-sort="upd"]'); if (def) def.classList.add('on');
    syncFilters();
    render();
  });
  onAll('pg-size-sel', 'change', (e) => { state.size = +e.target.value; state.page = 1; render(); });
  onAll('pg-first', 'click', () => go(1));
  onAll('pg-prev', 'click', () => go(state.page - 1));
  onAll('pg-next', 'click', () => go(state.page + 1));
  onAll('pg-last', 'click', () => go(Math.ceil(filtered().length / state.size)));
  onAll('pg-no', 'change', (e) => {
    const n = Math.max(1, Math.min(+e.target.value || 1, Math.ceil(filtered().length / state.size)));
    go(n);
  });

  render();
</script>

<style>
