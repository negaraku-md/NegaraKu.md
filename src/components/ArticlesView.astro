---
import type { Locale } from '@/lib/categories';
import { getPillar } from '@/lib/categories';
import { articlesForLocale } from '@/lib/content';
import { localePath } from '@/lib/i18n';
import PageHero from './PageHero.astro';
import ArticleList from './ArticleList.astro';

// All Articles — the whole corpus in the shared ArticleList, with every filter
// (section, category, topic, status).

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

// Show only articles that ACTUALLY EXIST in this locale, not master fallbacks.
// articlesForLocale() returns one entry per topic and falls back to the master
// when a translation is missing, so its length is identical on every locale
// (386). Filtering to lang === locale makes the hero count and the list reflect
// this language's real coverage (EN 359 / MS 331 / ZH 304).
const canonical = (await articlesForLocale(locale)).filter((a) => a.data.lang === locale);
const secCount = new Set(canonical.map((a) => getPillar(a.data.category)).filter(Boolean)).size;
const catCount = new Set(canonical.map((a) => a.data.category)).size;
const topCount = new Set(canonical.flatMap((a) => (a.data.subcategory ?? []).map((s) => `${a.data.category}/${s}`))).size;
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页'), href: localePath('/', locale) },
    { label: L('Semua artikel', 'All articles', '所有文章') },
  ]}
  title={L('Semua artikel', 'All articles', '所有文章')}
  desc={L(
    'Semak imbas keseluruhan pangkalan pengetahuan — isih, tapis dan cari.',
    'Browse the whole knowledge base — sort, filter and search.',
    '浏览整个知识库——排序、筛选与搜索。',
  )}
  stats={[
    { value: secCount, label: L('tonggak', 'pillars', '支柱') },
    { value: catCount, label: L('kategori', 'categories', '分类') },
    { value: topCount, label: L('subkategori', 'subcategories', '子分类') },
    { value: canonical.length, label: L('topik', 'topics', '主题') },
  ]}
/>

<ArticleList locale={locale} articles={canonical} filters={['sec', 'cat', 'top', 'status']} />
