// --- Live query (Stage 4) — contributor-only real-time AE group-by. The panel
// is hidden unless <html data-contributor="true"> (set by Header's /api/auth/me
// check); it POSTs to the worker's /_a/q endpoint (query.js). ---
const liveL = {
  dims: {
