<script type="application/json" id="tl-data" set:html={liveJSON}></script>
<script>
  (() => {
    const el = document.getElementById('tl-data');
    if (!el) return;
    let L; try { L = JSON.parse(el.textContent || '{}'); } catch { return; }
    const dimsEl = document.getElementById('tl-dims');
    const bucketEl = document.getElementById('tl-bucket');
    const daysEl = document.getElementById('tl-days');
    const runEl = document.getElementById('tl-run');
    const metaEl = document.getElementById('tl-meta');
    const outEl = document.getElementById('tl-results');
    if (!dimsEl || !bucketEl || !daysEl || !runEl || !outEl) return;
    const DIM_ORDER = ['country', 'region', 'city', 'device', 'browser', 'os', 'locale', 'channel', 'source', 'bot', 'path'];
    let selected = ['country'];
    const paint = () => dimsEl.querySelectorAll('.tl-chip').forEach((c) => c.classList.toggle('is-on', selected.includes(c.getAttribute('data-d'))));
    dimsEl.innerHTML = DIM_ORDER.map((d) => `<button type="button" class="tl-chip" data-d="${d}">${(L.dims && L.dims[d]) || d}</button>`).join('');
    paint();
    dimsEl.addEventListener('click', (e) => {
      const b = e.target.closest('[data-d]'); if (!b) return;
      const d = b.getAttribute('data-d'); const i = selected.indexOf(d);
      if (i >= 0) { if (selected.length > 1) selected.splice(i, 1); }
      else { if (selected.length >= 3) return; selected.push(d); }
      paint();
    });
    bucketEl.innerHTML = Object.entries(L.buckets || {}).map(([k, v]) => `<option value="${k}">${v}</option>`).join('');
    daysEl.innerHTML = [['7', L.ui.days7], ['30', L.ui.days30], ['90', L.ui.days90]].map(([k, v]) => `<option value="${k}"${k === '30' ? ' selected' : ''}>${v}</option>`).join('');

    let regionNames = null;
    try { regionNames = new Intl.DisplayNames([document.documentElement.lang || 'en'], { type: 'region' }); } catch { regionNames = null; }
    const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
    const lab = (dim, v) => {
      if (v === '' || v == null) return '(none)';
      if (dim === 'country') { try { return regionNames ? (regionNames.of(v) || v) : v; } catch { return v; } }
      if (dim === 'device') return v.charAt(0).toUpperCase() + v.slice(1);
      return v;
    };

    runEl.addEventListener('click', async () => {
      runEl.disabled = true; metaEl.textContent = L.ui.running; outEl.innerHTML = '';
      try {
        const spec = { dims: selected.slice(), bucket: bucketEl.value, days: parseInt(daysEl.value, 10), limit: 50 };
        const res = await fetch('/_a/q', { method: 'POST', headers: { 'content-type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify(spec) });
        if (!res.ok) throw new Error('http ' + res.status);
        const data = await res.json();
        const rows = data.rows || [];
        if (!rows.length) { outEl.innerHTML = `<p class="hint" style="margin:0">${L.ui.empty}</p>`; metaEl.textContent = ''; runEl.disabled = false; return; }
        const dims = data.dims || selected;
        const mx = Math.max(1, ...rows.map((r) => Number(r.n) || 0));
        outEl.innerHTML = rows.map((r) => {
          const label = dims.map((d) => lab(d, r[d])).join(' · ');
          const n = Number(r.n) || 0;
          return `<div class="cov-row ai-row"><span class="cov-name" title="${esc(label)}">${esc(label)}</span><span class="track"><span class="fill" style="width:${Math.max(3, Math.round((n / mx) * 100))}%"></span></span><span class="cov-num">${n.toLocaleString()}</span></div>`;
        }).join('');
        metaEl.textContent = `${L.ui.generated} ${new Date(data.generatedAt).toLocaleString()} · ${data.days}d · ${rows.length} ${rows.length === 1 ? 'row' : 'rows'}`;
      } catch (e) {
        outEl.innerHTML = `<p class="hint" style="margin:0">${L.ui.err}</p>`; metaEl.textContent = '';
      }
      runEl.disabled = false;
    });
  })();
</script>

