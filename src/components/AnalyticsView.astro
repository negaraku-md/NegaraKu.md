    'Cloudflare ஸ்னாப்ஷாட் இணைக்கப்படவில்லை — CF_ZONE_ID + token "Zone Analytics: Read" அமைக்கவும்.',
    'Cloudflare スナップショット未接続 — CF_ZONE_ID とトークン権限 "Zone Analytics: Read" を設定してください。',
  ),
  updated: L('Dikemas kini', 'Updated', '更新于', 'புதுப்பிக்கப்பட்டது', '更新'),
  seedNote: L('(data contoh — segar apabila CI berjalan)', '(sample data — refreshes when CI runs)', '（示例数据——CI 运行后刷新）', '(மாதிரி தரவு — CI இயங்கும்போது புதுப்பிக்கும்)', '(サンプルデータ — CI 実行時に更新)'),
};
const explorerJSON = JSON.stringify({
