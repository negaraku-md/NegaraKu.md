              return (
                <div class="sx-view cov-cats" data-sx-view data-d={dmn.k} data-m={m.k} hidden={!(dmn.k === 'bot')}>
                  {rows.map((r) => (
                    r.href ? (
                      <a class="cov-row" href={r.href}>
