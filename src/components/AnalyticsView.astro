---
import type { Locale } from '@/lib/categories';
import { getPillar, PILLARS, loc } from '@/lib/categories';
import { getDashboard, getAnalytics, getFacebook, getSearchConsole, getBing, getAnalyticsSeries } from '@/lib/apidata';
import { t, localePath } from '@/lib/i18n';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = getDashboard();
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string) => (locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

const titleByKey = new Map<string, string>();
for (const r of d.registry) titleByKey.set(`${r.category}/${r.slug}`, r.title[locale] ?? r.title.ms);

// AI-crawler activity. The edge Worker tags every hit's bucket (readers/search/
// ai) + the crawler's canonical name; this rolls the per-page `ai` buckets up
// across the whole corpus — by crawler, by pillar, and the most-crawled
// articles. All-time (snapshot + live tail).
const analytics = getAnalytics();
const aiTotalFor = (b: typeof analytics[string]['ai']) =>
  b == null ? 0 : typeof b === 'number' ? b : (b.total ?? 0);
let aiTotal = 0;
let aiPages = 0;
const aiByBot = new Map<string, number>();
const aiByPillar = new Map<string, number>();
const aiTopRaw: { key: string; total: number }[] = [];
for (const [key, row] of Object.entries(analytics)) {
  const total = aiTotalFor(row.ai);
  if (total <= 0) continue;
  aiTotal += total;
  aiPages++;
  aiTopRaw.push({ key, total });
  const byBot = row.ai && typeof row.ai !== 'number' ? (row.ai.byBot ?? {}) : {};
  for (const [bot, n] of Object.entries(byBot)) aiByBot.set(bot, (aiByBot.get(bot) ?? 0) + n);
  const pillar = getPillar(key.split('/')[0]) ?? 'understand';
  aiByPillar.set(pillar, (aiByPillar.get(pillar) ?? 0) + total);
}
const aiBots = [...aiByBot.entries()].sort((a, b) => b[1] - a[1]).map(([bot, n]) => ({ bot, n }));
const aiBotMax = Math.max(1, ...aiBots.map((b) => b.n));
const aiPillars = PILLARS.map((pd) => ({ id: pd.id, name: loc(pd.name, locale), icon: pd.icon, n: aiByPillar.get(pd.id) ?? 0 }))
  .filter((p) => p.n > 0)
  .sort((a, b) => b.n - a.n);
const aiPillarMax = Math.max(1, ...aiPillars.map((p) => p.n));
const aiTop = aiTopRaw.sort((a, b) => b.total - a.total).slice(0, 8)
  .map((x) => ({ ...x, title: titleByKey.get(x.key) ?? x.key }));
const aiTopMax = Math.max(1, ...aiTop.map((x) => x.total));

// Traffic by channel — where human readers arrive from (search / AI / social /
// messaging / other / direct), classified from the referrer + UTM at the edge
// and folded per page. Same all-time snapshot machinery as the buckets above.
const CHANNEL_META: Record<string, { label: string; icon: string }> = {
  search: { label: L('Carian', 'Search', '搜索', 'தேடல்', '検索'), icon: '🔍' },
  ai: { label: L('Pembantu AI', 'AI assistants', 'AI 助手', 'AI உதவியாளர்கள்', 'AI アシスタント'), icon: '✨' },
  social: { label: L('Media sosial', 'Social', '社交媒体', 'சமூக ஊடகம்', 'ソーシャル'), icon: '💬' },
  messaging: { label: L('Pemesejan', 'Messaging', '即时通讯', 'செய்தியிடல்', 'メッセージング'), icon: '📨' },
  other: { label: L('Laman lain', 'Other sites', '其他网站', 'பிற தளங்கள்', 'その他のサイト'), icon: '🌐' },
  direct: { label: L('Terus', 'Direct', '直接访问', 'நேரடி', '直接'), icon: '⤵' },
};
const CH_ORDER = ['search', 'ai', 'social', 'messaging', 'other', 'direct'];
const refByChannel = new Map<string, number>();
const refBySource = new Map<string, number>();
let refTotal = 0;
for (const row of Object.values(analytics)) {
  const ref = row.ref;
  if (!ref) continue;
  for (const [ch, n] of Object.entries(ref.byChannel ?? {})) { refByChannel.set(ch, (refByChannel.get(ch) ?? 0) + n); refTotal += n; }
  for (const [src, n] of Object.entries(ref.bySource ?? {})) refBySource.set(src, (refBySource.get(src) ?? 0) + n);
}
const refChannels = [...refByChannel.keys()]
  .sort((a, b) => CH_ORDER.indexOf(a) - CH_ORDER.indexOf(b))
  .map((id) => ({ id, label: CHANNEL_META[id]?.label ?? id, icon: CHANNEL_META[id]?.icon ?? '•', n: refByChannel.get(id) ?? 0 }));
const refChMax = Math.max(1, ...refChannels.map((c) => c.n));
const refSources = [...refBySource.entries()].filter(([s]) => s !== 'direct')
  .sort((a, b) => b[1] - a[1]).slice(0, 10).map(([source, n]) => ({ source, n }));
const refSourceMax = Math.max(1, ...refSources.map((s) => s.n));

// Google Search performance (archive: analytics/gsc.json) — trailing-90-day
// totals, impressions grouped to pillars from the per-category split, and top
// queries. Empty until the Search Console archive workflow has run.
const gsc = getSearchConsole();
const gscTotals = gsc.latest?.totals;
const gscHas = !!(gscTotals && (gscTotals.impressions || gscTotals.clicks));
const gscByPillar = new Map<string, { clicks: number; impressions: number }>();
for (const [cat, v] of Object.entries(gsc.latest?.byCategory ?? {})) {
  const pid = getPillar(cat) ?? 'understand';
  const e = gscByPillar.get(pid) ?? { clicks: 0, impressions: 0 };
  e.clicks += v.clicks; e.impressions += v.impressions;
  gscByPillar.set(pid, e);
}
const gscPillars = PILLARS.map((pd) => ({ id: pd.id, name: loc(pd.name, locale), icon: pd.icon, ...(gscByPillar.get(pd.id) ?? { clicks: 0, impressions: 0 }) }))
  .filter((p) => p.impressions > 0).sort((a, b) => b.impressions - a.impressions);
const gscPillarMax = Math.max(1, ...gscPillars.map((p) => p.impressions));
const gscQueries = (gsc.latest?.topQueries ?? []).slice(0, 8);
const gscQueryMax = Math.max(1, ...gscQueries.map((q) => q.impressions));
const gscMonths = Object.keys(gsc.byMonth ?? {}).length;

// Facebook engagement (archive: analytics/facebook.json) — per-language Page numbers.
const fb = getFacebook();
const FB_LANG: Record<string, string> = { ms: 'Bahasa Malaysia', en: 'English', zh: '中文', ta: 'தமிழ்', ja: '日本語' };
const fbRows = (['ms', 'en', 'zh', 'ta', 'ja'] as const)
  .map((l) => {
    const p = fb.pages?.[l] ?? {};
    return { lang: l, label: p.name || `NegaraKu.md · ${FB_LANG[l]}`, pageId: p.pageId, followers: p.followers, posts: p.posts, reactions: p.reactions, comments: p.comments, shares: p.shares };
  })
  .filter((r) => r.pageId);
const fbTotals = fb.totals;
const fbHas = !!(fbTotals && (fbTotals.followers || fbTotals.posts || fbTotals.reactions || fbTotals.comments || fbTotals.shares));

// On-site engagement (beacon → analytics.json.engage per article): avg dwell +
// scroll, sample-weighted overall and by pillar; most-engaging articles by dwell.
const fmtDur = (sec: number) => (sec >= 60 ? `${Math.floor(sec / 60)}m ${sec % 60}s` : `${sec}s`);
let engSecsW = 0, engScrollW = 0, engSamples = 0;
const engByPillar = new Map<string, { secsW: number; n: number }>();
const engPagesRaw: { key: string; avgSeconds: number; avgScroll: number; samples: number }[] = [];
for (const [key, row] of Object.entries(analytics)) {
  const e = row.engage;
  if (!e || !e.samples) continue;
  engSamples += e.samples;
  engSecsW += e.avgSeconds * e.samples;
  engScrollW += e.avgScroll * e.samples;
  engPagesRaw.push({ key, ...e });
  const pid = getPillar(key.split('/')[0]) ?? 'understand';
  const pp = engByPillar.get(pid) ?? { secsW: 0, n: 0 };
  pp.secsW += e.avgSeconds * e.samples; pp.n += e.samples;
  engByPillar.set(pid, pp);
}
const engHas = engSamples > 0;
const engAvgSecs = engHas ? Math.round(engSecsW / engSamples) : 0;
const engAvgScroll = engHas ? Math.round(engScrollW / engSamples) : 0;
const engPillars = PILLARS.map((pd) => {
  const p = engByPillar.get(pd.id);
  return { id: pd.id, name: loc(pd.name, locale), icon: pd.icon, avg: p && p.n ? Math.round(p.secsW / p.n) : 0 };
}).filter((p) => p.avg > 0).sort((a, b) => b.avg - a.avg);
const engPillarMax = Math.max(1, ...engPillars.map((p) => p.avg));
const engTop = engPagesRaw.sort((a, b) => b.avgSeconds - a.avgSeconds).slice(0, 8)
  .map((x) => ({ ...x, title: titleByKey.get(x.key) ?? x.key }));
const engTopMax = Math.max(1, ...engTop.map((x) => x.avgSeconds));

// Bing Webmaster (archive: analytics/bing.json) — also backs Copilot & ChatGPT-search.
const bing = getBing();
const bingT = bing.latest?.totals;
const bingHas = !!(bingT && (bingT.impressions || bingT.clicks));
const bingQueries = (bing.latest?.topQueries ?? []).slice(0, 8);
const bingQueryMax = Math.max(1, ...bingQueries.map((q) => q.impressions));
const bingMonths = Object.keys(bing.byMonth ?? {}).length;

// --- Trend series (daily) for the interactive charts. Baked as JSON below and
// filtered/drawn client-side (SVG). Accumulates permanently, so it grows well
// beyond AE's 90-day retention. ---
const series = getAnalyticsSeries();
const CHANNEL_COLORS: Record<string, string> = { search: '#FFC000', ai: '#c084fc', social: '#60a5fa', messaging: '#4ade80', other: '#94a3b8', direct: '#38bdf8' };
const trendDays = Object.entries(series.days ?? {})
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([day, dd]) => ({ day, readers: dd.readers ?? 0, ai: dd.ai ?? 0, search: dd.search ?? 0, byChannel: dd.byChannel ?? {}, byLang: dd.byLang ?? {}, aiByBot: dd.aiByBot ?? {} }));
const LANG_COLORS: Record<string, string> = { ms: '#FFC000', en: '#60a5fa', zh: '#f472b6', ta: '#4ade80', ja: '#c084fc' };
const LANG_ORDER = ['ms', 'en', 'zh', 'ta', 'ja'];
const langLabels: Record<string, string> = { ms: 'Bahasa Malaysia', en: 'English', zh: '中文', ta: 'தமிழ்', ja: '日本語' };
const chLabels: Record<string, string> = Object.fromEntries(CH_ORDER.map((id) => [id, CHANNEL_META[id]?.label ?? id]));
const seoMonths = Object.entries(gsc.byMonth ?? {})
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([month, m]) => ({ month, impressions: m.impressions ?? 0, clicks: m.clicks ?? 0 }));
const hasTrend = trendDays.length >= 2;
const metricLabels = {
  visitors: L('Pelawat', 'Visitors', '访客', 'பார்வையாளர்கள்', '訪問者'),
  ai: L('Perayap AI', 'AI crawlers', 'AI 爬虫', 'AI கிராலர்கள்', 'AI クローラー'),
  search: L('Perayap carian', 'Search crawlers', '搜索爬虫', 'தேடல் கிராலர்கள்', '検索クローラー'),
};
const seoLabels = { impressions: L('Tera', 'Impressions', '展示', 'காட்சிகள்', '表示'), clicks: L('Klik', 'Clicks', '点击', 'கிளிக்குகள்', 'クリック') };
const aiBotAccruing = L(
  'Data setiap bot mula terkumpul — carta muncul apabila cukup hari direkodkan.',
  'Per-bot data is accumulating — the chart appears once enough days are recorded.',
  '各爬虫数据正在积累——记录到足够天数后图表即会显示。',
  'ஒவ்வொரு bot தரவும் சேர்ந்து வருகிறது — போதிய நாட்கள் பதிவானதும் விளக்கப்படம் தோன்றும்.',
  'ボット別データを蓄積中です — 十分な日数が記録されるとグラフが表示されます。',
);
const trendJSON = JSON.stringify({ days: trendDays, chColors: CHANNEL_COLORS, chLabels, chOrder: CH_ORDER, langColors: LANG_COLORS, langLabels, langOrder: LANG_ORDER, seo: seoMonths, metricLabels, seoLabels, aiBotAccruing });

// Most-read articles (human readers, all-time from analytics.json). Fills the
// content-performance gap alongside most-crawled + most-engaging.
const readTop = Object.entries(analytics)
  .map(([key, row]) => ({ key, n: typeof row.readers === 'number' ? row.readers : (row.readers?.total ?? 0) }))
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n)
  .slice(0, 8)
  .map((x) => ({ ...x, title: titleByKey.get(x.key) ?? x.key }));
const readMax = Math.max(1, ...readTop.map((x) => x.n));

// Anything measured yet? Drives the "trends are accruing" lead note.
const anyTraffic = aiTotal > 0 || refTotal > 0 || gscHas || bingHas || fbHas || engHas;
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム'), href: localePath('/', locale) },
    { label: t('nav.analytics', locale) },
  ]}
  title={t('nav.analytics', locale)}
  desc={L(
    'Bagaimana dunia menemui NegaraKu.md — saluran, carian, AI, media sosial dan penglibatan pembaca.',
    'How the world finds NegaraKu.md — channels, search, AI, social and reader engagement.',
    '世界如何发现 NegaraKu.md——渠道、搜索、AI、社交媒体与读者参与。',
    'உலகம் NegaraKu.md-ஐ எப்படிக் கண்டறிகிறது — சேனல்கள், தேடல், AI, சமூக ஊடகம் மற்றும் வாசக ஈடுபாடு.',
    '世界が NegaraKu.md をどう見つけているか — チャネル、検索、AI、ソーシャル、読者エンゲージメント。',
  )}
/>

{!anyTraffic && (
  <section class="container block">
    <p class="acc-note">{L(
      'Pengumpulan trend baru bermula — carta akan terisi apabila lawatan, carian dan rujukan terkumpul dari semasa ke semasa.',
      'Trend collection has just begun — charts fill in as visits, searches and referrals accumulate over time.',
      '趋势数据刚开始采集——随着访问、搜索与来源随时间积累，图表将逐步填充。',
      'போக்கு சேகரிப்பு இப்போது தொடங்கியது — வருகைகள், தேடல்கள் மற்றும் பரிந்துரைகள் காலப்போக்கில் சேரும்போது விளக்கப்படங்கள் நிரம்பும்.',
      'トレンドの収集が始まったばかりです — 訪問・検索・参照が時間とともに蓄積されるにつれ、グラフが埋まります。',
    )}</p>
  </section>
)}

<section class="container block">
  <div class="psec">
    <header><span>{L('Trend dari masa ke masa', 'Trends over time', '随时间变化的趋势', 'காலப்போக்கில் போக்குகள்', '時系列トレンド')}</span></header>
    <div class="psec-body">
      {!hasTrend ? (
        <p class="hint">{L(
          'Trend harian mula terkumpul — carta muncul sebaik sekurang-kurangnya dua hari data direkodkan.',
          'Daily trends are accumulating — the chart appears once at least two days of data are recorded.',
          '每日趋势正在积累——记录到至少两天数据后图表即会显示。',
          'தினசரி போக்குகள் சேர்ந்து வருகின்றன — குறைந்தது இரண்டு நாட்கள் தரவு பதிவானதும் விளக்கப்படம் தோன்றும்.',
          '日次トレンドを蓄積中です — 2日分以上のデータが記録されるとグラフが表示されます。',
        )}</p>
      ) : (
        <>
          <div class="tr-ranges" role="group" aria-label="range">
            <button type="button" class="tr-btn is-on" data-range="30">30{L('h', 'd', '天', 'நா', '日')}</button>
            <button type="button" class="tr-btn" data-range="90">90{L('h', 'd', '天', 'நா', '日')}</button>
            <button type="button" class="tr-btn" data-range="all">{L('Semua', 'All', '全部', 'அனைத்தும்', 'すべて')}</button>
          </div>
          <p class="ai-h">{L('Pelawat, perayap AI & carian setiap hari', 'Visitors, AI & search crawlers per day', '每日访客、AI 与搜索爬虫', 'தினசரி பார்வையாளர்கள், AI & தேடல்', '日次の訪問者・AI・検索クローラー')}</p>
          <div id="chart-daily" class="chart"></div>
          <div id="legend-daily" class="chart-legend"></div>
          <p class="ai-h chan-h">{L('Trafik mengikut saluran — julat dipilih', 'Traffic by channel — selected range', '各渠道流量——所选范围', 'சேனல் வாரியான போக்குவரத்து — தேர்ந்த வரம்பு', 'チャネル別トラフィック — 選択範囲')}</p>
          <div id="chan-bars" class="cov-cats"><p class="hint" style="margin:0">—</p></div>
          <p class="ai-h chan-h">{L('Pelawat mengikut bahasa', 'Visitors by language', '各语言访客', 'மொழி வாரியான பார்வையாளர்கள்', '言語別の訪問者')}</p>
          <div id="chart-lang" class="chart"></div>
          <div id="legend-lang" class="chart-legend"></div>
          <p class="ai-h chan-h">{L('Perayap AI mengikut bot — dari masa ke masa', 'AI crawlers by bot — over time', '各 AI 爬虫随时间变化', 'AI கிராலர்கள் bot வாரியாக — காலப்போக்கில்', 'AIクローラー別（時系列）')}</p>
          <div id="chart-aibot" class="chart"></div>
          <div id="legend-aibot" class="chart-legend"></div>
        </>
      )}
      <p class="ai-h chan-h">{L('Prestasi carian mengikut bulan', 'Search performance by month', '按月搜索表现', 'மாதவாரி தேடல் செயல்திறன்', '月別の検索パフォーマンス')}</p>
      {seoMonths.length < 2 ? (
        <p class="hint" style="margin:0">{L(
          `Sekurang-kurangnya dua bulan diperlukan untuk lengkung — kini ${seoMonths.length} bulan diarkibkan.`,
          `At least two months are needed for a curve — currently ${seoMonths.length} archived.`,
          `绘制曲线至少需要两个月——目前已归档 ${seoMonths.length} 个月。`,
          `வளைவுக்கு குறைந்தது இரண்டு மாதங்கள் தேவை — தற்போது ${seoMonths.length} மாதம் காப்பகம்.`,
          `曲線には最低2か月必要です — 現在 ${seoMonths.length} か月分をアーカイブ。`,
        )}</p>
      ) : (
        <><div id="chart-seo" class="chart"></div><div id="legend-seo" class="chart-legend"></div></>
      )}
    </div>
  </div>
</section>

<script type="application/json" id="trend-data" set:html={trendJSON}></script>
<script>
  (() => {
    const el = document.getElementById('trend-data');
    if (!el) return;
    let data;
    try { data = JSON.parse(el.textContent || '{}'); } catch { return; }
    const days = data.days || [];
    const NS = 'http://www.w3.org/2000/svg';
    const cssVar = (n, f) => (getComputedStyle(document.documentElement).getPropertyValue(n).trim() || f);
    const muted = cssVar('--muted', '#8a8a8a');
    const line = cssVar('--line', '#333');

    // Multi-line SVG chart. rows: [{label, values:{key:num}}]; series: [{key,label,color}].
    function lineChart(container, rows, series) {
      container.innerHTML = '';
      if (!rows || rows.length < 2) { container.innerHTML = '<p class="hint" style="margin:0">—</p>'; return []; }
      const W = 720, H = 220, padL = 44, padR = 12, padT = 12, padB = 26;
      const max = Math.max(1, ...rows.flatMap((r) => series.map((s) => r.values[s.key] || 0)));
      const x = (i) => padL + (i * (W - padL - padR)) / (rows.length - 1);
      const y = (v) => padT + (1 - v / max) * (H - padT - padB);
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.setAttribute('class', 'chart-svg');
      const mk = (tag, attrs, text) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); if (text != null) e.textContent = text; return e; };
      for (const gv of [0, max]) {
        const gy = y(gv);
        svg.appendChild(mk('line', { x1: padL, x2: W - padR, y1: gy, y2: gy, stroke: line, 'stroke-width': 1 }));
        svg.appendChild(mk('text', { x: padL - 6, y: gy + 3, 'text-anchor': 'end', fill: muted, 'font-size': 10 }, gv.toLocaleString()));
      }
      [0, Math.floor((rows.length - 1) / 2), rows.length - 1].forEach((i) => {
        svg.appendChild(mk('text', { x: x(i), y: H - 8, 'text-anchor': i === 0 ? 'start' : i === rows.length - 1 ? 'end' : 'middle', fill: muted, 'font-size': 10 }, rows[i].label));
      });
      for (const s of series) {
        const pts = rows.map((r, i) => `${x(i).toFixed(1)},${y(r.values[s.key] || 0).toFixed(1)}`).join(' ');
        svg.appendChild(mk('polyline', { points: pts, fill: 'none', stroke: s.color, 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' }));
      }
      container.appendChild(svg);
      return series.map((s) => ({ ...s, total: rows.reduce((a, r) => a + (r.values[s.key] || 0), 0) }));
    }

    function legend(container, items) {
      if (!container) return;
      container.innerHTML = items.map((it) => `<span class="lg"><i style="background:${it.color}"></i>${it.label} <b>${it.total.toLocaleString()}</b></span>`).join('');
    }

    function renderDaily(range) {
      const rows0 = range === 'all' ? days : days.slice(-parseInt(range, 10));
      const rows = rows0.map((d) => ({ label: (d.day || '').slice(5), values: { readers: d.readers, ai: d.ai, search: d.search } }));
      const ml = data.metricLabels || {};
      const totals = lineChart(document.getElementById('chart-daily'), rows, [
        { key: 'readers', label: ml.visitors || 'Visitors', color: '#FFC000' },
        { key: 'ai', label: ml.ai || 'AI', color: '#c084fc' },
        { key: 'search', label: ml.search || 'Search', color: '#60a5fa' },
      ]);
      legend(document.getElementById('legend-daily'), totals);
      const sums = {};
      for (const d of rows0) for (const [c, n] of Object.entries(d.byChannel || {})) sums[c] = (sums[c] || 0) + n;
      const order = data.chOrder || Object.keys(sums);
      const entries = order.filter((c) => sums[c] > 0).map((c) => ({ n: sums[c], label: (data.chLabels || {})[c] || c, color: (data.chColors || {})[c] || muted }));
      const cb = document.getElementById('chan-bars');
      if (!cb) return;
      if (!entries.length) { cb.innerHTML = '<p class="hint" style="margin:0">—</p>'; return; }
      const mx = Math.max(...entries.map((e) => e.n));
      cb.innerHTML = entries.map((e) => `<div class="cov-row ai-row"><span class="cov-name">${e.label}</span><span class="track"><span class="fill" style="width:${Math.max(3, Math.round((e.n / mx) * 100))}%;background:${e.color}"></span></span><span class="cov-num">${e.n.toLocaleString()}</span></div>`).join('');
    }

    function renderLang(range) {
      const rows0 = range === 'all' ? days : days.slice(-parseInt(range, 10));
      const order = data.langOrder || [];
      const present = order.filter((l) => rows0.some((d) => ((d.byLang || {})[l] || 0) > 0));
      const el = document.getElementById('chart-lang');
      const lg = document.getElementById('legend-lang');
      if (!el) return;
      if (!present.length) { el.innerHTML = '<p class="hint" style="margin:0">—</p>'; if (lg) lg.innerHTML = ''; return; }
      const series = present.map((l) => ({ key: l, label: (data.langLabels || {})[l] || l, color: (data.langColors || {})[l] || muted }));
      const rows = rows0.map((d) => ({ label: (d.day || '').slice(5), values: Object.fromEntries(present.map((l) => [l, (d.byLang || {})[l] || 0])) }));
      legend(lg, lineChart(el, rows, series));
    }

    function renderAiBot(range) {
      const rows0 = range === 'all' ? days : days.slice(-parseInt(range, 10));
      const el = document.getElementById('chart-aibot');
      const lg = document.getElementById('legend-aibot');
      if (!el) return;
      const tot = {};
      for (const d of rows0) for (const [b, n] of Object.entries(d.aiByBot || {})) tot[b] = (tot[b] || 0) + n;
      const bots = Object.entries(tot).sort((a, b) => b[1] - a[1]).slice(0, 5).map(([b]) => b);
      const daysWith = rows0.filter((d) => Object.keys(d.aiByBot || {}).length).length;
      if (!bots.length || daysWith < 2) {
        el.innerHTML = `<p class="hint" style="margin:0">${data.aiBotAccruing || '—'}</p>`;
        if (lg) lg.innerHTML = '';
        return;
      }
      const palette = ['#c084fc', '#FFC000', '#60a5fa', '#4ade80', '#f472b6'];
      const series = bots.map((b, i) => ({ key: b, label: b, color: palette[i % palette.length] }));
      const rows = rows0.map((d) => ({ label: (d.day || '').slice(5), values: Object.fromEntries(bots.map((b) => [b, (d.aiByBot || {})[b] || 0])) }));
      legend(lg, lineChart(el, rows, series));
    }

    function renderAll(range) { renderDaily(range); renderLang(range); renderAiBot(range); }
    document.querySelectorAll('.tr-btn').forEach((btn) => btn.addEventListener('click', () => {
      document.querySelectorAll('.tr-btn').forEach((b) => b.classList.remove('is-on'));
      btn.classList.add('is-on');
      renderAll(btn.getAttribute('data-range'));
    }));
    if (document.getElementById('chart-daily')) renderAll('30');

    const seo = data.seo || [];
    const seoEl = document.getElementById('chart-seo');
    if (seoEl && seo.length >= 2) {
      const sl = data.seoLabels || {};
      const totals = lineChart(seoEl, seo.map((m) => ({ label: m.month, values: { impressions: m.impressions, clicks: m.clicks } })), [
        { key: 'impressions', label: sl.impressions || 'Impressions', color: '#FFC000' },
        { key: 'clicks', label: sl.clicks || 'Clicks', color: '#4ade80' },
      ]);
      legend(document.getElementById('legend-seo'), totals);
    }
  })();
</script>

