<script>
  // Metric × dimension explorers (Search, …): toggle which pre-rendered view shows.
  document.querySelectorAll<HTMLElement>('[data-sx]').forEach((sx) => {
    // Defaults = whichever view the server rendered visible (so each explorer can
    // bring its own metrics/dimensions — Search, AI, Readers, …).
    const def = sx.querySelector<HTMLElement>('[data-sx-view]:not([hidden])') || sx.querySelector<HTMLElement>('[data-sx-view]');
    let m = def?.dataset.m || '', d = def?.dataset.d || '';
    const apply = () => {
      sx.querySelectorAll<HTMLElement>('[data-sx-m]').forEach((b) => b.classList.toggle('on', b.dataset.sxM === m));
      sx.querySelectorAll<HTMLElement>('[data-sx-d]').forEach((b) => b.classList.toggle('on', b.dataset.sxD === d));
      sx.querySelectorAll<HTMLElement>('[data-sx-view]').forEach((v) => { v.hidden = !(v.dataset.d === d && v.dataset.m === m); });
    };
    sx.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-sx-m],[data-sx-d]');
      if (!t) return;
      if (t.dataset.sxM) m = t.dataset.sxM;
      if (t.dataset.sxD) d = t.dataset.sxD;
      apply();
    });
    apply();
  });
</script>

<script>
  // Scroll-spy: highlight the zone pill for the section currently in view.
  const pills = [...document.querySelectorAll<HTMLAnchorElement>('.a-zpill')];
  const zones = pills.map((p) => document.getElementById(p.dataset.zone || '')).filter((z): z is HTMLElement => !!z);
  if (zones.length && 'IntersectionObserver' in window) {
    let active = '';
    const setCur = (id: string) => {
      if (id === active) return;
      active = id;
      pills.forEach((p) => p.classList.toggle('current', p.dataset.zone === id));
    };
    const io = new IntersectionObserver((entries) => {
      const vis = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (vis[0]) setCur((vis[0].target as HTMLElement).id);
    }, { rootMargin: '-82px 0px -68% 0px', threshold: 0 });
    zones.forEach((z) => io.observe(z));
    setCur(zones[0].id);
  }
</script>

