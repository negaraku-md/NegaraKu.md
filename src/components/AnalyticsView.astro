<script type="application/json" id="trend-data" set:html={trendJSON}></script>
<script>
  (() => {
    const el = document.getElementById('trend-data');
    if (!el) return;
    let data;
    try { data = JSON.parse(el.textContent || '{}'); } catch { return; }
    const days = data.days || [];
    const NS = 'http://www.w3.org/2000/svg';
    const cssVar = (n, f) => (getComputedStyle(document.documentElement).getPropertyValue(n).trim() || f);
    const muted = cssVar('--muted', '#8a8a8a');
    const line = cssVar('--line', '#333');

    // Multi-line SVG chart. rows: [{label, values:{key:num}}]; series: [{key,label,color}].
    function lineChart(container, rows, series) {
      container.innerHTML = '';
      if (!rows || rows.length < 2) { container.innerHTML = '<p class="hint" style="margin:0">—</p>'; return []; }
      const W = 720, H = 220, padL = 44, padR = 12, padT = 12, padB = 26;
      const max = Math.max(1, ...rows.flatMap((r) => series.map((s) => r.values[s.key] || 0)));
      const x = (i) => padL + (i * (W - padL - padR)) / (rows.length - 1);
      const y = (v) => padT + (1 - v / max) * (H - padT - padB);
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.setAttribute('class', 'chart-svg');
      const mk = (tag, attrs, text) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); if (text != null) e.textContent = text; return e; };
      for (const gv of [0, max]) {
        const gy = y(gv);
        svg.appendChild(mk('line', { x1: padL, x2: W - padR, y1: gy, y2: gy, stroke: line, 'stroke-width': 1 }));
        svg.appendChild(mk('text', { x: padL - 6, y: gy + 3, 'text-anchor': 'end', fill: muted, 'font-size': 10 }, gv.toLocaleString()));
      }
      [0, Math.floor((rows.length - 1) / 2), rows.length - 1].forEach((i) => {
        svg.appendChild(mk('text', { x: x(i), y: H - 8, 'text-anchor': i === 0 ? 'start' : i === rows.length - 1 ? 'end' : 'middle', fill: muted, 'font-size': 10 }, rows[i].label));
      });
      for (const s of series) {
        const pts = rows.map((r, i) => `${x(i).toFixed(1)},${y(r.values[s.key] || 0).toFixed(1)}`).join(' ');
        svg.appendChild(mk('polyline', { points: pts, fill: 'none', stroke: s.color, 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' }));
      }
      container.appendChild(svg);
      return series.map((s) => ({ ...s, total: rows.reduce((a, r) => a + (r.values[s.key] || 0), 0) }));
    }

    function legend(container, items) {
      if (!container) return;
      container.innerHTML = items.map((it) => `<span class="lg"><i style="background:${it.color}"></i>${it.label} <b>${it.total.toLocaleString()}</b></span>`).join('');
    }

    function renderDaily(range) {
      const rows0 = range === 'all' ? days : days.slice(-parseInt(range, 10));
      const rows = rows0.map((d) => ({ label: (d.day || '').slice(5), values: { readers: d.readers, ai: d.ai, search: d.search } }));
      const ml = data.metricLabels || {};
      const totals = lineChart(document.getElementById('chart-daily'), rows, [
        { key: 'readers', label: ml.visitors || 'Readers', color: '#FFC000' },
        { key: 'ai', label: ml.ai || 'AI', color: '#c084fc' },
        { key: 'search', label: ml.search || 'Search', color: '#60a5fa' },
      ]);
      legend(document.getElementById('legend-daily'), totals);
      const sums = {};
      for (const d of rows0) for (const [c, n] of Object.entries(d.byChannel || {})) sums[c] = (sums[c] || 0) + n;
      const order = data.chOrder || Object.keys(sums);
      const entries = order.filter((c) => sums[c] > 0).map((c) => ({ n: sums[c], label: (data.chLabels || {})[c] || c, color: (data.chColors || {})[c] || muted }));
      const cb = document.getElementById('chan-bars');
      if (!cb) return;
      if (!entries.length) { cb.innerHTML = '<p class="hint" style="margin:0">—</p>'; return; }
      const mx = Math.max(...entries.map((e) => e.n));
      cb.innerHTML = entries.map((e) => `<div class="cov-row ai-row"><span class="cov-name">${e.label}</span><span class="track"><span class="fill" style="width:${Math.max(3, Math.round((e.n / mx) * 100))}%;background:${e.color}"></span></span><span class="cov-num">${e.n.toLocaleString()}</span></div>`).join('');
    }

    function renderLang(range) {
      const rows0 = range === 'all' ? days : days.slice(-parseInt(range, 10));
      const order = data.langOrder || [];
      const present = order.filter((l) => rows0.some((d) => ((d.byLang || {})[l] || 0) > 0));
      const el = document.getElementById('chart-lang');
      const lg = document.getElementById('legend-lang');
      if (!el) return;
      if (!present.length) { el.innerHTML = '<p class="hint" style="margin:0">—</p>'; if (lg) lg.innerHTML = ''; return; }
      const series = present.map((l) => ({ key: l, label: (data.langLabels || {})[l] || l, color: (data.langColors || {})[l] || muted }));
      const rows = rows0.map((d) => ({ label: (d.day || '').slice(5), values: Object.fromEntries(present.map((l) => [l, (d.byLang || {})[l] || 0])) }));
      legend(lg, lineChart(el, rows, series));
    }

    function renderAiBot(range) {
      const rows0 = range === 'all' ? days : days.slice(-parseInt(range, 10));
      const el = document.getElementById('chart-aibot');
      const lg = document.getElementById('legend-aibot');
      if (!el) return;
      const tot = {};
      for (const d of rows0) for (const [b, n] of Object.entries(d.aiByBot || {})) tot[b] = (tot[b] || 0) + n;
      const bots = Object.entries(tot).sort((a, b) => b[1] - a[1]).slice(0, 5).map(([b]) => b);
      const daysWith = rows0.filter((d) => Object.keys(d.aiByBot || {}).length).length;
      if (!bots.length || daysWith < 2) {
        el.innerHTML = `<p class="hint" style="margin:0">${data.aiBotAccruing || '—'}</p>`;
        if (lg) lg.innerHTML = '';
        return;
      }
      const palette = ['#c084fc', '#FFC000', '#60a5fa', '#4ade80', '#f472b6'];
      const series = bots.map((b, i) => ({ key: b, label: b, color: palette[i % palette.length] }));
      const rows = rows0.map((d) => ({ label: (d.day || '').slice(5), values: Object.fromEntries(bots.map((b) => [b, (d.aiByBot || {})[b] || 0])) }));
      legend(lg, lineChart(el, rows, series));
    }

    function renderAll(range) { renderDaily(range); renderLang(range); renderAiBot(range); }
    document.querySelectorAll('.tr-btn').forEach((btn) => btn.addEventListener('click', () => {
      document.querySelectorAll('.tr-btn').forEach((b) => b.classList.remove('is-on'));
      btn.classList.add('is-on');
      renderAll(btn.getAttribute('data-range'));
    }));
    if (document.getElementById('chart-daily')) renderAll('30');

    const seo = data.seo || [];
    const seoEl = document.getElementById('chart-seo');
    if (seoEl && seo.length >= 2) {
      const sl = data.seoLabels || {};
      const totals = lineChart(seoEl, seo.map((m) => ({ label: m.month, values: { impressions: m.impressions, clicks: m.clicks } })), [
        { key: 'impressions', label: sl.impressions || 'Impressions', color: '#FFC000' },
        { key: 'clicks', label: sl.clicks || 'Clicks', color: '#4ade80' },
      ]);
      legend(document.getElementById('legend-seo'), totals);
    }
  })();
</script>

