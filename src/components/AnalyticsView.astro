    audience: L('Khalayak', 'Audience', '受众', 'பார்வையாளர்', '対象'),
    range: L('Julat', 'Range', '范围', 'வரம்பு', '範囲'),
    run: L('Jalankan', 'Run', '运行', 'இயக்கு', '実行'),
    running: L('Menjalankan…', 'Running…', '运行中…', 'இயங்குகிறது…', '実行中…'),
    empty: L('Tiada baris.', 'No rows.', '无数据行。', 'வரிசைகள் இல்லை.', '行がありません。'),
    err: L(
      'Kueri gagal — tersedia untuk kontributor di laman langsung.',
