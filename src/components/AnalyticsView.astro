<script type="application/json" id="pivot-data" set:html={pivotJSON}></script>
<script>
  (() => {
    const el = document.getElementById('pivot-data');
    if (!el) return;
    let data;
    try { data = JSON.parse(el.textContent || '{}'); } catch { return; }
    const rows = data.rows || [];
    const dimSel = document.getElementById('pv-dim');
    const mSel = document.getElementById('pv-measure');
    const chSel = document.getElementById('pv-channel');
    const chWrap = document.getElementById('pv-ch-wrap');
    const note = document.getElementById('pv-note');
    const out = document.getElementById('pv-results');
    if (!dimSel || !mSel || !chSel || !out) return;
    const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
    const fmtDur = (s) => (s >= 60 ? `${Math.floor(s / 60)}m ${Math.round(s % 60)}s` : `${Math.round(s)}s`);

    function render() {
      const dim = dimSel.value, measure = mSel.value, ch = chSel.value;
      const chActive = measure === 'readers';
      chWrap.style.opacity = chActive ? '1' : '0.4';
      chSel.disabled = !chActive;
      note.textContent = chActive ? '' : (data.chOnlyNote || '');
      const agg = new Map();
      for (const r of rows) {
        const g = dim === 'title' ? r.title : dim === 'cat' ? r.cat : r.pillar;
        let v = 0, w = 0;
        if (measure === 'readers') v = chActive && ch !== 'all' ? (r.ch[ch] || 0) : r.readers;
        else if (measure === 'ai') v = r.ai;
        else if (measure === 'search') v = r.search;
        else { v = r.dwellW; w = r.samples; }
        const e = agg.get(g) || { val: 0, w: 0 };
        e.val += v; e.w += w; agg.set(g, e);
      }
      let entries = [...agg.entries()].map(([g, e]) => ({ g, val: measure === 'dwell' ? (e.w ? e.val / e.w : 0) : e.val, w: e.w }));
      entries = entries.filter((e) => (measure === 'dwell' ? e.w > 0 : e.val > 0)).sort((a, b) => b.val - a.val);
      if (dim === 'title') entries = entries.slice(0, 20);
      if (!entries.length) { out.innerHTML = '<p class="hint" style="margin:0">—</p>'; return; }
      const mx = Math.max(...entries.map((e) => e.val));
      out.innerHTML = entries.map((e) => {
        const disp = measure === 'dwell' ? fmtDur(e.val) : Math.round(e.val).toLocaleString();
        return `<div class="cov-row ai-row"><span class="cov-name" title="${esc(e.g)}">${esc(e.g)}</span><span class="track"><span class="fill" style="width:${Math.max(3, Math.round((e.val / mx) * 100))}%"></span></span><span class="cov-num">${disp}</span></div>`;
      }).join('');
    }
    [dimSel, mSel, chSel].forEach((s) => s.addEventListener('change', render));
    render();
  })();
</script>

