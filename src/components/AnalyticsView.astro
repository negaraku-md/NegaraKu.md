---
import type { Locale } from '@/lib/categories';
import { getPillar, getCategory, PILLARS, loc } from '@/lib/categories';
import { getDashboard, getAnalytics, getFacebook, getSearchConsole, getBing, getAnalyticsSeries, getCfTraffic, getReaderCube, getClicks } from '@/lib/apidata';
import { t, localePath } from '@/lib/i18n';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = getDashboard();
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string) => (locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

const titleByKey = new Map<string, string>();
for (const r of d.registry) titleByKey.set(`${r.category}/${r.slug}`, r.title[locale] ?? r.title.ms);

// AI-crawler activity. The edge Worker tags every hit's bucket (readers/search/
// ai) + the crawler's canonical name; this rolls the per-page `ai` buckets up
// across the whole corpus — by crawler, by pillar, and the most-crawled
// articles. All-time (snapshot + live tail).
const analytics = getAnalytics();
const aiTotalFor = (b: typeof analytics[string]['ai']) =>
  b == null ? 0 : typeof b === 'number' ? b : (b.total ?? 0);
let aiTotal = 0;
let aiPages = 0;
const aiByBot = new Map<string, number>();
const aiByPillar = new Map<string, number>();
const aiTopRaw: { key: string; total: number }[] = [];
for (const [key, row] of Object.entries(analytics)) {
  const total = aiTotalFor(row.ai);
  if (total <= 0) continue;
  aiTotal += total;
  aiPages++;
  aiTopRaw.push({ key, total });
  const byBot = row.ai && typeof row.ai !== 'number' ? (row.ai.byBot ?? {}) : {};
  for (const [bot, n] of Object.entries(byBot)) aiByBot.set(bot, (aiByBot.get(bot) ?? 0) + n);
  const pillar = getPillar(key.split('/')[0]) ?? 'understand';
  aiByPillar.set(pillar, (aiByPillar.get(pillar) ?? 0) + total);
}
const aiBots = [...aiByBot.entries()].sort((a, b) => b[1] - a[1]).map(([bot, n]) => ({ bot, n }));
const aiBotMax = Math.max(1, ...aiBots.map((b) => b.n));
const aiPillars = PILLARS.map((pd) => ({ id: pd.id, name: loc(pd.name, locale), icon: pd.icon, n: aiByPillar.get(pd.id) ?? 0 }))
  .filter((p) => p.n > 0)
  .sort((a, b) => b.n - a.n);
const aiPillarMax = Math.max(1, ...aiPillars.map((p) => p.n));
const aiTop = aiTopRaw.sort((a, b) => b.total - a.total).slice(0, 8)
  .map((x) => ({ ...x, title: titleByKey.get(x.key) ?? x.key }));
const aiTopMax = Math.max(1, ...aiTop.map((x) => x.total));
// AI explorer — one metric (fetches) × crawler / pillar / article.
const axMetrics = [{ k: 'fetches', label: L('Lawatan', 'Fetches', '抓取', 'பெறுதல்கள்', '取得', '가져오기', 'การดึง', 'Lượt lấy', 'Pengambilan') }];
const axDims = [
  { k: 'bot', label: L('Perayap', 'Crawler', '爬虫', 'கிராலர்', 'クローラー', '크롤러', 'บอต', 'Trình thu thập', 'Perayap'), rows: aiBots.map((b) => ({ label: b.bot, fetches: b.n })) },
  { k: 'pillar', label: L('Tunjang', 'Pillar', '支柱', 'தூண்', '柱', '기둥', 'เสาหลัก', 'Trụ cột', 'Pilar'), rows: aiPillars.map((p) => ({ label: `${p.icon} ${p.name}`, fetches: p.n })) },
  { k: 'article', label: L('Artikel', 'Article', '文章', 'கட்டுரை', '記事', '기사', 'บทความ', 'Bài viết', 'Artikel'), rows: aiTop.map((a) => ({ label: a.title, fetches: a.total, href: localePath(`/${a.key}`, locale) })) },
];

// Traffic by channel — where human readers arrive from (search / AI / social /
// messaging / other / direct), classified from the referrer + UTM at the edge
// and folded per page. Same all-time snapshot machinery as the buckets above.
const CHANNEL_META: Record<string, { label: string; icon: string }> = {
  search: { label: L('Carian', 'Search', '搜索', 'தேடல்', '検索', '검색', 'การค้นหา', 'Tìm kiếm', 'Pencarian'), icon: '🔍' },
  ai: { label: L('Pembantu AI', 'AI assistants', 'AI 助手', 'AI உதவியாளர்கள்', 'AI アシスタント', 'AI 어시스턴트', 'ผู้ช่วย AI', 'Trợ lý AI', 'Asisten AI'), icon: '✨' },
  social: { label: L('Media sosial', 'Social', '社交媒体', 'சமூக ஊடகம்', 'ソーシャル', '소셜 미디어', 'โซเชียลมีเดีย', 'Mạng xã hội', 'Media sosial'), icon: '💬' },
  messaging: { label: L('Pemesejan', 'Messaging', '即时通讯', 'செய்தியிடல்', 'メッセージング', '메시징', 'การส่งข้อความ', 'Nhắn tin', 'Perpesanan'), icon: '📨' },
  other: { label: L('Laman lain', 'Other sites', '其他网站', 'பிற தளங்கள்', 'その他のサイト', '기타 사이트', 'เว็บไซต์อื่น', 'Trang khác', 'Situs lain'), icon: '🌐' },
  direct: { label: L('Terus', 'Direct', '直接访问', 'நேரடி', '直接', '직접', 'โดยตรง', 'Trực tiếp', 'Langsung'), icon: '⤵' },
};
const CH_ORDER = ['search', 'ai', 'social', 'messaging', 'other', 'direct'];
const refByChannel = new Map<string, number>();
const refBySource = new Map<string, number>();
let refTotal = 0;
for (const row of Object.values(analytics)) {
  const ref = row.ref;
  if (!ref) continue;
  for (const [ch, n] of Object.entries(ref.byChannel ?? {})) { refByChannel.set(ch, (refByChannel.get(ch) ?? 0) + n); refTotal += n; }
  for (const [src, n] of Object.entries(ref.bySource ?? {})) refBySource.set(src, (refBySource.get(src) ?? 0) + n);
}
const refChannels = [...refByChannel.keys()]
  .sort((a, b) => CH_ORDER.indexOf(a) - CH_ORDER.indexOf(b))
  .map((id) => ({ id, label: CHANNEL_META[id]?.label ?? id, icon: CHANNEL_META[id]?.icon ?? '•', n: refByChannel.get(id) ?? 0 }));
const refChMax = Math.max(1, ...refChannels.map((c) => c.n));
const refSources = [...refBySource.entries()].filter(([s]) => s !== 'direct')
  .sort((a, b) => b[1] - a[1]).slice(0, 10).map(([source, n]) => ({ source, n }));
const refSourceMax = Math.max(1, ...refSources.map((s) => s.n));
// Readers channel explorer — visits × channel / source.
const rxMetrics = [{ k: 'visits', label: L('Lawatan', 'Visits', '访问', 'வருகைகள்', '訪問', '방문', 'การเข้าชม', 'Lượt truy cập', 'Kunjungan') }];
const rxDims = [
  { k: 'channel', label: L('Saluran', 'Channel', '渠道', 'சேனல்', 'チャネル', '채널', 'ช่องทาง', 'Kênh', 'Saluran'), rows: refChannels.map((c) => ({ label: `${c.icon} ${c.label}`, visits: c.n })) },
  { k: 'source', label: L('Sumber', 'Source', '来源', 'மூலம்', '流入元', '소스', 'แหล่งที่มา', 'Nguồn', 'Sumber'), rows: refSources.map((s) => ({ label: s.source, visits: s.n })) },
];

// Google Search performance (archive: analytics/gsc.json) — trailing-90-day
// totals, impressions grouped to pillars from the per-category split, and top
// queries. Empty until the Search Console archive workflow has run.
const gsc = getSearchConsole();
const gscTotals = gsc.latest?.totals;
const gscHas = !!(gscTotals && (gscTotals.impressions || gscTotals.clicks));
const gscByPillar = new Map<string, { clicks: number; impressions: number }>();
for (const [cat, v] of Object.entries(gsc.latest?.byCategory ?? {})) {
  const pid = getPillar(cat) ?? 'understand';
  const e = gscByPillar.get(pid) ?? { clicks: 0, impressions: 0 };
  e.clicks += v.clicks; e.impressions += v.impressions;
  gscByPillar.set(pid, e);
}
const gscPillars = PILLARS.map((pd) => ({ id: pd.id, name: loc(pd.name, locale), icon: pd.icon, ...(gscByPillar.get(pd.id) ?? { clicks: 0, impressions: 0 }) }))
  .filter((p) => p.impressions > 0).sort((a, b) => b.impressions - a.impressions);
const gscPillarMax = Math.max(1, ...gscPillars.map((p) => p.impressions));
const gscQueries = (gsc.latest?.topQueries ?? []).slice(0, 8);
const gscQueryMax = Math.max(1, ...gscQueries.map((q) => q.impressions));
const gscMonths = Object.keys(gsc.byMonth ?? {}).length;

// Facebook engagement (archive: analytics/facebook.json) — per-language Page numbers.
const fb = getFacebook();
const FB_LANG: Record<string, string> = { ms: 'Bahasa Malaysia', en: 'English', zh: '中文', ta: 'தமிழ்', ja: '日本語', ko: '한국어', th: 'ไทย', vi: 'Tiếng Việt', id: 'Bahasa Indonesia' };
const fbRows = (['ms', 'en', 'zh', 'ta', 'ja', 'ko', 'th', 'vi', 'id'] as const)
  .map((l) => {
    const p = fb.pages?.[l] ?? {};
    return { lang: l, label: p.name || `NegaraKu.md · ${FB_LANG[l]}`, pageId: p.pageId, followers: p.followers, posts: p.posts, reactions: p.reactions, comments: p.comments, shares: p.shares };
  })
  .filter((r) => r.pageId);
const fbTotals = fb.totals;
const fbHas = !!(fbTotals && (fbTotals.followers || fbTotals.posts || fbTotals.reactions || fbTotals.comments || fbTotals.shares));

// On-site engagement (beacon → analytics.json.engage per article): avg dwell +
// scroll, sample-weighted overall and by pillar; most-engaging articles by dwell.
const fmtDur = (sec: number) => (sec >= 60 ? `${Math.floor(sec / 60)}m ${sec % 60}s` : `${sec}s`);
let engSecsW = 0, engScrollW = 0, engSamples = 0;
const engByPillar = new Map<string, { secsW: number; n: number }>();
const engPagesRaw: { key: string; avgSeconds: number; avgScroll: number; samples: number }[] = [];
for (const [key, row] of Object.entries(analytics)) {
  const e = row.engage;
  if (!e || !e.samples) continue;
  engSamples += e.samples;
  engSecsW += e.avgSeconds * e.samples;
  engScrollW += e.avgScroll * e.samples;
  engPagesRaw.push({ key, ...e });
  const pid = getPillar(key.split('/')[0]) ?? 'understand';
  const pp = engByPillar.get(pid) ?? { secsW: 0, n: 0 };
  pp.secsW += e.avgSeconds * e.samples; pp.n += e.samples;
  engByPillar.set(pid, pp);
}
const engHas = engSamples > 0;
const engAvgSecs = engHas ? Math.round(engSecsW / engSamples) : 0;
const engAvgScroll = engHas ? Math.round(engScrollW / engSamples) : 0;
const engPillars = PILLARS.map((pd) => {
  const p = engByPillar.get(pd.id);
  return { id: pd.id, name: loc(pd.name, locale), icon: pd.icon, avg: p && p.n ? Math.round(p.secsW / p.n) : 0 };
}).filter((p) => p.avg > 0).sort((a, b) => b.avg - a.avg);
const engPillarMax = Math.max(1, ...engPillars.map((p) => p.avg));
const engTop = engPagesRaw.sort((a, b) => b.avgSeconds - a.avgSeconds).slice(0, 8)
  .map((x) => ({ ...x, title: titleByKey.get(x.key) ?? x.key }));
const engTopMax = Math.max(1, ...engTop.map((x) => x.avgSeconds));

// What readers open next (beacon → clicks.json): top internal cross-links followed
// + top outbound sources clicked (hostnames only). 90-day live window.
const clicks = getClicks();
const clickInternal = (clicks.internal ?? []).slice(0, 8)
  .map(([key, n]) => ({ key, n, title: titleByKey.get(key) ?? key }));
const clickOutbound = (clicks.outbound ?? []).slice(0, 8).map(([host, n]) => ({ host, n }));
const clickIntMax = Math.max(1, ...clickInternal.map((x) => x.n));
const clickOutMax = Math.max(1, ...clickOutbound.map((x) => x.n));
const clicksHas = clickInternal.length > 0 || clickOutbound.length > 0;

// Bing Webmaster (archive: analytics/bing.json) — also backs Copilot & ChatGPT-search.
const bing = getBing();
const bingT = bing.latest?.totals;
const bingHas = !!(bingT && (bingT.impressions || bingT.clicks));
const bingQueries = (bing.latest?.topQueries ?? []).slice(0, 8);
const bingQueryMax = Math.max(1, ...bingQueries.map((q) => q.impressions));
const bingMonths = Object.keys(bing.byMonth ?? {}).length;

// --- Trend series (daily) for the interactive charts. Baked as JSON below and
// filtered/drawn client-side (SVG). Accumulates permanently, so it grows well
// beyond AE's 90-day retention. ---
const series = getAnalyticsSeries();
const CHANNEL_COLORS: Record<string, string> = { search: '#FFC000', ai: '#c084fc', social: '#60a5fa', messaging: '#4ade80', other: '#94a3b8', direct: '#38bdf8' };
const trendDays = Object.entries(series.days ?? {})
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([day, dd]) => ({ day, readers: dd.readers ?? 0, ai: dd.ai ?? 0, search: dd.search ?? 0, byChannel: dd.byChannel ?? {}, byLang: dd.byLang ?? {}, aiByBot: dd.aiByBot ?? {} }));
const LANG_COLORS: Record<string, string> = { ms: '#FFC000', en: '#60a5fa', zh: '#f472b6', ta: '#4ade80', ja: '#c084fc', ko: '#fb923c', th: '#38bdf8', vi: '#f87171', id: '#2dd4bf' };
const LANG_ORDER = ['ms', 'en', 'zh', 'ta', 'ja', 'ko', 'th', 'vi', 'id'];
const langLabels: Record<string, string> = { ms: 'Bahasa Malaysia', en: 'English', zh: '中文', ta: 'தமிழ்', ja: '日本語', ko: '한국어', th: 'ไทย', vi: 'Tiếng Việt', id: 'Bahasa Indonesia' };
const chLabels: Record<string, string> = Object.fromEntries(CH_ORDER.map((id) => [id, CHANNEL_META[id]?.label ?? id]));
const seoMonths = Object.entries(gsc.byMonth ?? {})
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([month, m]) => ({ month, impressions: m.impressions ?? 0, clicks: m.clicks ?? 0 }));
const hasTrend = trendDays.length >= 2;
const metricLabels = {
  visitors: L('Pembaca', 'Readers', '读者', 'வாசகர்கள்', '読者', '독자', 'ผู้อ่าน', 'Độc giả', 'Pembaca'),
  ai: L('Perayap AI', 'AI crawlers', 'AI 爬虫', 'AI கிராலர்கள்', 'AI クローラー', 'AI 크롤러', 'โปรแกรมรวบรวมข้อมูล AI', 'Trình thu thập dữ liệu AI', 'Perayap AI'),
  search: L('Perayap carian', 'Search crawlers', '搜索爬虫', 'தேடல் கிராலர்கள்', '検索クローラー', '검색 크롤러', 'โปรแกรมรวบรวมข้อมูลการค้นหา', 'Trình thu thập dữ liệu tìm kiếm', 'Perayap pencarian'),
};
const seoLabels = { impressions: L('Tera', 'Impressions', '展示', 'காட்சிகள்', '表示', '노출', 'การแสดงผล', 'Lượt hiển thị', 'Tayangan'), clicks: L('Klik', 'Clicks', '点击', 'கிளிக்குகள்', 'クリック', '클릭', 'การคลิก', 'Lượt nhấp', 'Klik') };
// Search explorer — metric × dimension (impressions first-class). Impressions /
// Clicks / CTR, broken down by query or by pillar. All combos baked server-side;
// a tiny toggle picks one (bars are %-width, so nothing breaks when hidden).
const val = (r: Record<string, number>, k: string) => (r[k] ?? 0);
const sxFmt = (m: string, v: number) => (m === 'ctr' ? `${(v * 100).toFixed(1)}%` : Math.round(v).toLocaleString());
const gscQ = (gsc.latest?.topQueries ?? []).slice(0, 12).map((q) => ({ label: q.query, impressions: q.impressions || 0, clicks: q.clicks || 0, ctr: q.impressions ? q.clicks / q.impressions : 0 }));
const gscP = gscPillars.map((p) => ({ label: `${p.icon} ${p.name}`, impressions: p.impressions, clicks: p.clicks, ctr: p.impressions ? p.clicks / p.impressions : 0 }));
const sxDims = [
  { k: 'query', label: L('Kata carian', 'Query', '搜索词', 'வினவல்', 'クエリ', '검색어', 'คำค้นหา', 'Truy vấn', 'Kueri'), rows: gscQ },
  { k: 'pillar', label: L('Tunjang', 'Pillar', '支柱', 'தூண்', '柱', '기둥', 'เสาหลัก', 'Trụ cột', 'Pilar'), rows: gscP },
];
const sxMetrics = [
  { k: 'impressions', label: seoLabels.impressions },
  { k: 'clicks', label: seoLabels.clicks },
  { k: 'ctr', label: 'CTR' },
];
const aiBotAccruing = L(
  'Data setiap bot mula terkumpul — carta muncul apabila cukup hari direkodkan.',
  'Per-bot data is accumulating — the chart appears once enough days are recorded.',
  '各爬虫数据正在积累——记录到足够天数后图表即会显示。',
  'ஒவ்வொரு bot தரவும் சேர்ந்து வருகிறது — போதிய நாட்கள் பதிவானதும் விளக்கப்படம் தோன்றும்.',
  'ボット別データを蓄積中です — 十分な日数が記録されるとグラフが表示されます。',
  '봇별 데이터가 누적되고 있습니다 — 충분한 일수가 기록되면 차트가 표시됩니다.', 'ข้อมูลแยกตามบอตกำลังสะสม — กราฟจะปรากฏเมื่อมีการบันทึกจำนวนวันเพียงพอ', 'Dữ liệu theo từng bot đang được tích lũy — biểu đồ sẽ xuất hiện khi đủ số ngày được ghi nhận.', 'Data setiap bot mulai terkumpul — grafik muncul saat cukup hari tercatat.',
);
const trendJSON = JSON.stringify({ days: trendDays, chColors: CHANNEL_COLORS, chLabels, chOrder: CH_ORDER, langColors: LANG_COLORS, langLabels, langOrder: LANG_ORDER, seo: seoMonths, metricLabels, seoLabels, aiBotAccruing });

// Most-read articles (human readers, all-time from analytics.json). Fills the
// content-performance gap alongside most-crawled + most-engaging.
const readTop = Object.entries(analytics)
  .map(([key, row]) => ({ key, n: typeof row.readers === 'number' ? row.readers : (row.readers?.total ?? 0) }))
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n)
  .slice(0, 8)
  .map((x) => ({ ...x, title: titleByKey.get(x.key) ?? x.key }));
const readMax = Math.max(1, ...readTop.map((x) => x.n));

// --- Pivot ("Explore") — a per-page fact table baked for a client-side pivot:
// group by pillar/category/article × measure (visitors/AI/search/dwell), with an
// optional channel filter on the visitors measure. Country/region/device/browser
// join once the edge capture (worker) accrues them. ---
const bTotal = (b: typeof analytics[string]['ai']) => (b == null ? 0 : typeof b === 'number' ? b : (b.total ?? 0));
const catNameOf = (cid: string) => { const c = getCategory(cid); return c ? loc(c.name, locale) : cid; };
const pillarNameOf = (pid: string) => { const pd = PILLARS.find((p) => p.id === pid); return pd ? loc(pd.name, locale) : pid; };
const pivotRows = Object.entries(analytics).map(([key, row]) => {
  const cat = key.split('/')[0];
  const pillar = getPillar(cat) ?? 'understand';
  return {
    key,
    title: titleByKey.get(key) ?? key,
    cat: catNameOf(cat),
    pillar: pillarNameOf(pillar),
    readers: typeof row.readers === 'number' ? row.readers : (row.readers?.total ?? 0),
    ai: bTotal(row.ai),
    search: bTotal(row.search),
    dwellW: (row.engage?.avgSeconds ?? 0) * (row.engage?.samples ?? 0),
    scrollW: (row.engage?.avgScroll ?? 0) * (row.engage?.samples ?? 0),
    samples: row.engage?.samples ?? 0,
    ch: row.ref?.byChannel ?? {},
  };
}).filter((r) => r.readers > 0 || r.ai > 0 || r.search > 0 || r.samples > 0);

// Readers content explorer — Visits / Dwell / Scroll × Pillar / Category / Article.
// Aggregated from the per-article pivot rows (dwell & scroll are sample-weighted).
function cxAgg(keyer: (r: typeof pivotRows[number]) => { k: string; label: string; href?: string } | null) {
  const m = new Map<string, { label: string; href?: string; visits: number; dwellW: number; scrollW: number; samples: number }>();
  for (const r of pivotRows) {
    const g = keyer(r);
    if (!g) continue;
    const e = m.get(g.k) ?? { label: g.label, href: g.href, visits: 0, dwellW: 0, scrollW: 0, samples: 0 };
    e.visits += r.readers; e.dwellW += r.dwellW; e.scrollW += r.scrollW; e.samples += r.samples;
    m.set(g.k, e);
  }
  return [...m.values()].map((e) => ({ label: e.label, href: e.href, visits: e.visits, dwell: e.samples ? e.dwellW / e.samples : 0, scroll: e.samples ? e.scrollW / e.samples : 0 }));
}
const cxDims = [
  { k: 'pillar', label: L('Tunjang', 'Pillar', '支柱', 'தூண்', '柱', '기둥', 'เสาหลัก', 'Trụ cột', 'Pilar'), rows: cxAgg((r) => ({ k: r.pillar, label: r.pillar })) },
  { k: 'category', label: L('Kategori', 'Category', '分类', 'வகை', 'カテゴリー', '카테고리', 'หมวดหมู่', 'Danh mục', 'Kategori'), rows: cxAgg((r) => ({ k: r.cat, label: r.cat })) },
  { k: 'article', label: L('Artikel', 'Article', '文章', 'கட்டுரை', '記事', '기사', 'บทความ', 'Bài viết', 'Artikel'), rows: cxAgg((r) => ({ k: r.key, label: r.title, href: localePath(`/${r.key}`, locale) })) },
];
const cxMetrics = [
