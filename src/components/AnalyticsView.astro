    : { totals: cf.totals ?? { count: 0, visits: 0 }, cube: cf.cube ?? [], paths: cf.paths ?? [], status: cf.status ?? [], cache: cf.cache ?? [], proto: cf.proto ?? [], hours: cf.hours ?? 24, updatedAt: cf.updatedAt, seed: !!cf.seed },
