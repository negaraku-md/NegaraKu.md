<script type="application/json" id="tx-data" set:html={explorerJSON}></script>
<script>
  (() => {
    const el = document.getElementById('tx-data');
    const app = document.getElementById('tx-app');
    if (!el || !app) return;
    let D; try { D = JSON.parse(el.textContent || '{}'); } catch { return; }
    const LB = D.labels || {};
    const DIMS = LB.dims || {};
    const locale = D.locale || 'en';
    const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    // --- source model --------------------------------------------------------
    const cfOk = !!(D.cf && !D.cf.empty && (D.cf.cube || []).length);
    const aeOk = !!(D.ae && (D.ae.cube || []).length);
    let SRC = cfOk ? 'cf' : (aeOk ? 'ae' : 'cf');
    // dims each source can group by
    const DIM_KEYS = { cf: ['country', 'device', 'browser', 'os', 'page', 'status', 'cache', 'proto'], ae: ['country', 'device', 'browser', 'os', 'page'] };
    const FILTERABLE = ['country', 'device', 'browser', 'os']; // cube dims
    const cubeIdx = { country: 0, device: 1, browser: 2, os: 3 };

    // country code → localized name
    let regionNames = null;
    try { regionNames = new Intl.DisplayNames([locale], { type: 'region' }); } catch { regionNames = null; }
    const cap = (s) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);
    function labelFor(dim, v) {
      if (v === '' || v == null) return LB.none || '(none)';
      if (dim === 'country') { try { return regionNames ? (regionNames.of(v) || v) : v; } catch { return v; } }
      if (dim === 'device') return cap(v);
      if (dim === 'page') return (SRC === 'ae' ? (D.aeTitles?.[v] || v) : v);
      return v;
    }

    // --- state (persisted per viewer) ---------------------------------------
    const DEFAULT_PANELS = [
      { dim: 'country', measure: 'requests', view: 'bars' },
      { dim: 'device', measure: 'requests', view: 'donut' },
      { dim: 'browser', measure: 'requests', view: 'bars' },
      { dim: 'os', measure: 'requests', view: 'bars' },
      { dim: 'page', measure: 'requests', view: 'bars' },
      { dim: 'status', measure: 'requests', view: 'donut' },
    ];
    let state = { src: SRC, filters: {}, hideNone: true, panels: DEFAULT_PANELS.map((p) => ({ ...p })) };
    try { const s = JSON.parse(localStorage.getItem('tx.v1') || 'null'); if (s && s.panels) state = { hideNone: true, ...s }; } catch { /* ignore */ }
    // Saved-view presets (named snapshots of the whole config).
    const VKEY = 'tx.views.v1';
    const loadViews = () => { try { return JSON.parse(localStorage.getItem(VKEY) || '{}') || {}; } catch { return {}; } };
    const saveViews = (v) => { try { localStorage.setItem(VKEY, JSON.stringify(v)); } catch { /* ignore */ } };
    SRC = (state.src === 'ae' && aeOk) || (state.src === 'cf' && cfOk) ? state.src : SRC;
    state.src = SRC;
    const save = () => { try { localStorage.setItem('tx.v1', JSON.stringify(state)); } catch { /* ignore */ } };

    // normalise a panel's dim/measure for the active source
    function fixPanel(p) {
      if (!DIM_KEYS[SRC].includes(p.dim)) p.dim = 'country';
      if (SRC === 'ae') p.measure = 'requests'; // ae has one measure
      if (p.measure === 'visits' && SRC !== 'cf') p.measure = 'requests';
      return p;
    }

    // --- aggregation ---------------------------------------------------------
    // returns { rows:[{key,label,value}], total }
    function aggregate(dim, measure) {
      const s = D[SRC] || {};
      let table, dimIdx, measIdx, filterCols;
      if (['country', 'device', 'browser', 'os'].includes(dim)) {
        table = s.cube || []; dimIdx = cubeIdx[dim];
        measIdx = SRC === 'cf' ? (measure === 'visits' ? 5 : 4) : 4;
        filterCols = cubeIdx; // supports all four
      } else if (dim === 'page') {
        table = s.paths || []; dimIdx = 1;
        measIdx = SRC === 'cf' ? (measure === 'visits' ? 3 : 2) : 2;
        filterCols = { country: 0 };
      } else { // status | cache | proto (cf only)
        table = s[dim] || []; dimIdx = 1; measIdx = 2; filterCols = { country: 0 };
      }
      const f = state.filters || {};
      const agg = new Map();
      let total = 0;
      for (const row of table) {
        let skip = false;
        for (const fk in f) { const ci = filterCols[fk]; if (ci != null && row[ci] !== f[fk]) { skip = true; break; } }
        if (skip) continue;
        const key = row[dimIdx] ?? '';
        if (state.hideNone && (key === '' || key == null)) continue;
        const val = Number(row[measIdx]) || 0;
        if (val <= 0) continue;
        // hide asset/utility paths on the page panel
        if (dim === 'page') { const p = String(key); if (/\.(png|jpe?g|gif|svg|webp|ico|css|js|mjs|json|xml|txt|map|woff2?|md)$/i.test(p) || p.includes('/cdn-cgi/') || p.includes('/_astro/') || p.includes('/.well-known/') || p === '/_a/e') continue; }
        agg.set(key, (agg.get(key) || 0) + val);
        total += val;
      }
      let rows = [...agg.entries()].map(([key, value]) => ({ key, value, label: labelFor(dim, key) })).sort((a, b) => b.value - a.value);
      return { rows, total };
    }

    // --- renderers -----------------------------------------------------------
    const PAL = ['#FFC000', '#60a5fa', '#c084fc', '#4ade80', '#f472b6', '#38bdf8', '#fb923c', '#a3e635'];
    function barsHTML(dim, rows, total) {
      const top = rows.slice(0, 12);
      const mx = Math.max(1, ...top.map((r) => r.value));
      const clickable = FILTERABLE.includes(dim);
      return top.map((r) => {
        const pct = total ? Math.round((r.value / total) * 100) : 0;
        const cls = 'cov-row ai-row' + (clickable ? ' tx-click' : '');
        const attr = clickable ? ` data-dim="${dim}" data-val="${esc(r.key)}" role="button" tabindex="0"` : '';
        return `<div class="${cls}"${attr}><span class="cov-name" title="${esc(r.label)}">${esc(r.label)}</span><span class="track"><span class="fill" style="width:${Math.max(3, Math.round((r.value / mx) * 100))}%"></span></span><span class="cov-num">${r.value.toLocaleString()}<i class="tx-pct">${pct}%</i></span></div>`;
      }).join('') || `<p class="hint" style="margin:0">—</p>`;
    }
    function donutHTML(dim, rows, total, measureLbl) {
      if (!rows.length || !total) return `<p class="hint" style="margin:0">—</p>`;
      const top = rows.slice(0, 6);
      const rest = rows.slice(6).reduce((a, r) => a + r.value, 0);
      const segs = top.map((r, i) => ({ label: r.label, key: r.key, value: r.value, color: PAL[i % PAL.length] }));
      if (rest > 0) segs.push({ label: LB.others || 'Others', key: '__others', value: rest, color: '#64748b' });
      const R = 52, C = 2 * Math.PI * R; let off = 0;
      const arcs = segs.map((s) => { const len = (s.value / total) * C; const a = `<circle cx="70" cy="70" r="${R}" fill="none" stroke="${s.color}" stroke-width="22" stroke-dasharray="${len.toFixed(2)} ${(C - len).toFixed(2)}" stroke-dashoffset="${(-off).toFixed(2)}" transform="rotate(-90 70 70)"/>`; off += len; return a; }).join('');
      const clickable = FILTERABLE.includes(dim);
      const legend = segs.map((s) => { const pct = Math.round((s.value / total) * 100); const attr = clickable && s.key !== '__others' ? ` data-dim="${dim}" data-val="${esc(s.key)}" role="button" tabindex="0" class="tx-lg tx-click"` : ' class="tx-lg"'; return `<span${attr}><i style="background:${s.color}"></i>${esc(s.label)} <b>${s.value.toLocaleString()}</b> <em>${pct}%</em></span>`; }).join('');
      return `<div class="tx-donut"><svg viewBox="0 0 140 140" class="chart-svg tx-dsvg">${arcs}<text x="70" y="67" text-anchor="middle" class="tx-dc">${total.toLocaleString()}</text><text x="70" y="83" text-anchor="middle" class="tx-dcl">${esc(measureLbl || '')}</text></svg><div class="tx-legend">${legend}</div></div>`;
    }

    // --- panel + chrome ------------------------------------------------------
    function measureLabel(m) { return m === 'visits' ? (LB.visits || 'Visits') : (SRC === 'ae' ? (LB.visitors || 'Readers') : (LB.requests || 'Requests')); }
    // Export a panel's full breakdown (all rows, not just the top 12) as CSV.
    function exportCSV(i) {
      const p = state.panels[i]; if (!p) return; fixPanel(p);
      const { rows, total } = aggregate(p.dim, p.measure);
      const q = (s) => '"' + String(s).replace(/"/g, '""') + '"';
      const lines = [[q(DIMS[p.dim] || p.dim), q(measureLabel(p.measure)), q('%')].join(',')];
      for (const r of rows) lines.push([q(r.label), r.value, (total ? (r.value / total) * 100 : 0).toFixed(1)].join(','));
      const blob = new Blob(['﻿' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `negaraku-${SRC}-${p.dim}-${p.measure}.csv`;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    }
    function panelHTML(p, i) {
      fixPanel(p);
      const { rows, total } = aggregate(p.dim, p.measure);
      const body = p.view === 'donut' ? donutHTML(p.dim, rows, total, measureLabel(p.measure)) : barsHTML(p.dim, rows, total);
      const dimOpts = DIM_KEYS[SRC].map((k) => `<option value="${k}"${k === p.dim ? ' selected' : ''}>${esc(DIMS[k] || k)}</option>`).join('');
      const measOpts = (SRC === 'cf' ? ['requests', 'visits'] : ['requests']).map((m) => `<option value="${m}"${m === p.measure ? ' selected' : ''}>${esc(measureLabel(m))}</option>`).join('');
      const viewOpts = ['bars', 'donut'].map((v) => `<option value="${v}"${v === p.view ? ' selected' : ''}>${v === 'donut' ? (LB.donut || 'Donut') : (LB.bars || 'Bars')}</option>`).join('');
      return `<div class="tx-panel" data-i="${i}">
        <div class="tx-phead"><span class="tx-ptitle">${esc(DIMS[p.dim] || p.dim)} <em>· ${esc(measureLabel(p.measure))}</em></span>
          <button class="tx-menu-btn" data-act="menu" aria-label="menu">⋯</button></div>
        <div class="tx-cfg" hidden>
          <label>${esc(LB.configure || 'Configure')}<select data-act="dim">${dimOpts}</select></label>
          <label>${esc(LB.measure || 'Measure')}<select data-act="measure"${SRC !== 'cf' ? ' disabled' : ''}>${measOpts}</select></label>
          <label>${esc(LB.viewAs || 'View as')}<select data-act="view">${viewOpts}</select></label>
          <div class="tx-cfg-btns"><button data-act="csv">⬇ ${esc(LB.csv || 'CSV')}</button><button data-act="dup">${esc(LB.duplicate || 'Duplicate')}</button><button data-act="del" class="tx-del">${esc(LB.remove || 'Remove')}</button></div>
        </div>
        <div class="tx-pbody">${body}</div></div>`;
    }
    function chipsHTML() {
      const f = state.filters || {}; const keys = Object.keys(f);
      const chips = keys.map((k) => `<span class="tx-chip">${esc(DIMS[k] || k)}: <b>${esc(labelFor(k, f[k]))}</b><button data-act="unchip" data-k="${k}">×</button></span>`).join('');
      const clear = keys.length ? `<button class="tx-clear" data-act="clearf">${esc(LB.clear || 'Clear')}</button>` : '';
      // add-filter control
      const addSel = `<span class="tx-addf"><select data-act="addf-dim"><option value="">+ ${esc(LB.addFilter || 'Add filter')}</option>${FILTERABLE.filter((d) => !(d in f)).map((d) => `<option value="${d}">${esc(DIMS[d] || d)}</option>`).join('')}</select><select data-act="addf-val" hidden></select></span>`;
      return `<div class="tx-chips">${chips}${addSel}${clear}</div>`;
    }
    function metaHTML() {
      const s = D[SRC] || {};
      let note = SRC === 'cf' ? (LB.cfNote || '') : (LB.aeNote || '');
      let when = '';
      if (SRC === 'cf' && !cfOk) note = LB.emptyCf || note;
      if (SRC === 'cf' && s.updatedAt) when = `${LB.updated || 'Updated'} ${new Date(s.updatedAt).toLocaleString(locale)} · ${s.hours || 24}h${s.seed ? ' ' + (LB.seedNote || '') : ''}`;
      return `<p class="hint tx-meta">${esc(note)}${when ? ' — ' + esc(when) : ''}</p>`;
    }
    function toolbarHTML() {
      const srcBtn = (id, on, label, ok) => `<button class="tx-src${on ? ' is-on' : ''}" data-act="src" data-src="${id}"${ok ? '' : ' disabled'}>${esc(label)}</button>`;
      const vn = Object.keys(loadViews());
      const vsel = `<select class="tx-vsel" data-act="loadview" aria-label="${esc(LB.savedViews || 'Views')}"><option value="">${esc(LB.savedViews || 'Views…')}</option>${vn.map((n) => `<option value="${esc(n)}">${esc(n)}</option>`).join('')}</select>`;
      return `<div class="tx-toolbar">
        <div class="tx-srcs">${srcBtn('cf', SRC === 'cf', LB.srcCf || 'Cloudflare', cfOk || !aeOk)}${srcBtn('ae', SRC === 'ae', LB.srcAe || 'Readers', aeOk)}</div>
        <label class="tx-hn"><input type="checkbox" data-act="hidenone"${state.hideNone ? ' checked' : ''}> ${esc(LB.hideNone || 'Hide blanks')}</label>
        <span class="tx-sp"></span>
        ${vn.length ? vsel : ''}
        <button class="tx-vbtn" data-act="saveview">${esc(LB.saveView || 'Save view')}</button>
        <button class="tx-vbtn" data-act="resetview">${esc(LB.resetView || 'Reset')}</button>
        <button class="tx-addp" data-act="addp">+ ${esc(LB.addPanel || 'Add panel')}</button>
      </div>`;
    }

    function render() {
      state.src = SRC; save();
      const panelsHTML = state.panels.map((p, i) => panelHTML(p, i)).join('');
      app.innerHTML = toolbarHTML() + chipsHTML() + metaHTML() + `<div class="tx-grid">${panelsHTML}</div>`;
    }

    // --- interactions (event delegation) ------------------------------------
    function addFilter(dim, val) { state.filters[dim] = val; render(); }
    app.addEventListener('click', (e) => {
      const t = e.target.closest('[data-act], .tx-click');
      if (!t) return;
      const act = t.getAttribute('data-act');
      if (t.classList.contains('tx-click') && !act) { addFilter(t.getAttribute('data-dim'), t.getAttribute('data-val')); return; }
      if (act === 'src') { const ns = t.getAttribute('data-src'); if ((ns === 'cf' && !cfOk && aeOk)) return; SRC = ns; render(); return; }
      if (act === 'addp') {
        state.panels.push({ dim: 'browser', measure: 'requests', view: 'bars' });
        render();
        // A new panel lands at the end of a (possibly long) grid — scroll it into
        // view + briefly highlight it so the click has visible feedback.
        const panels = app.querySelectorAll('.tx-panel');
        const last = panels[panels.length - 1];
        if (last) { last.scrollIntoView({ behavior: 'smooth', block: 'center' }); last.classList.add('tx-flash'); setTimeout(() => last.classList.remove('tx-flash'), 900); }
        return;
      }
      if (act === 'menu') { const cfg = t.closest('.tx-panel').querySelector('.tx-cfg'); cfg.hidden = !cfg.hidden; return; }
      if (act === 'dup') { const i = +t.closest('.tx-panel').getAttribute('data-i'); state.panels.splice(i + 1, 0, { ...state.panels[i] }); render(); return; }
      if (act === 'del') { const i = +t.closest('.tx-panel').getAttribute('data-i'); state.panels.splice(i, 1); render(); return; }
      if (act === 'unchip') { delete state.filters[t.getAttribute('data-k')]; render(); return; }
      if (act === 'clearf') { state.filters = {}; render(); return; }
      if (act === 'csv') { const i = +t.closest('.tx-panel').getAttribute('data-i'); exportCSV(i); return; }
      if (act === 'saveview') { const name = (prompt(LB.namePrompt || 'View name:') || '').trim(); if (!name) return; const v = loadViews(); v[name] = JSON.parse(JSON.stringify(state)); saveViews(v); render(); return; }
      if (act === 'resetview') { state = { src: SRC, filters: {}, hideNone: true, panels: DEFAULT_PANELS.map((p) => ({ ...p })) }; render(); return; }
    });
    app.addEventListener('keydown', (e) => { if ((e.key === 'Enter' || e.key === ' ') && e.target.classList && e.target.classList.contains('tx-click')) { e.preventDefault(); addFilter(e.target.getAttribute('data-dim'), e.target.getAttribute('data-val')); } });
    app.addEventListener('change', (e) => {
      const t = e.target; const act = t.getAttribute('data-act');
      if (act === 'hidenone') { state.hideNone = t.checked; render(); return; }
      if (act === 'loadview') {
        const v = loadViews()[t.value];
        if (v) { state = { hideNone: true, ...v }; SRC = (state.src === 'ae' && aeOk) || (state.src === 'cf' && cfOk) ? state.src : SRC; render(); }
        return;
      }
      if (act === 'dim' || act === 'measure' || act === 'view') {
        const i = +t.closest('.tx-panel').getAttribute('data-i');
        state.panels[i][act] = t.value; render(); return;
      }
      if (act === 'addf-dim') {
        const dim = t.value; const valSel = t.parentElement.querySelector('[data-act="addf-val"]');
        if (!dim) { valSel.hidden = true; return; }
        const { rows } = aggregate(dim, state.panels[0]?.measure || 'requests');
        valSel.innerHTML = `<option value="">${esc(labelFor(dim, ''))}…</option>` + rows.slice(0, 30).map((r) => `<option value="${esc(r.key)}">${esc(r.label)}</option>`).join('');
        valSel.hidden = false; return;
      }
      if (act === 'addf-val') { if (t.value) addFilter(t.closest('.tx-addf').querySelector('[data-act="addf-dim"]').value, t.value); return; }
    });

    render();
  })();
</script>

