---
import type { Locale } from '@/lib/categories';
import { localePath } from '@/lib/i18n';
import { REPO } from '@/lib/site';
import PageHero from './PageHero.astro';

// Shared renderer for the three policy pages (Terms / Privacy / Cookies).
// Content is grounded in what the site ACTUALLY does: a static knowledge base on
// GitHub Pages behind Cloudflare, no accounts, no on-site personal-data forms,
// no tracking cookies — only client-side localStorage preferences and cookieless
// edge analytics. These are honest, plain-language drafts; the operator should
// have them reviewed by a lawyer and add their legal-entity + contact details.

interface Props {
  locale: Locale;
  doc: 'terms' | 'privacy' | 'cookies';
}
const { locale, doc } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string) => (locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

const UPDATED = '2026-08-20';
type Section = { h: string; p?: string[]; list?: string[] };

const contactP = L(
  `Soalan tentang dasar ini? Buka isu atau perbincangan di repositori GitHub kami (${REPO}). Operator projek patut menambah entiti sah dan e-mel hubungan rasmi di sini.`,
  `Questions about this policy? Open an issue or discussion in our GitHub repository (${REPO}). The project operator should add a legal entity and an official contact email here.`,
  `对本政策有疑问？请在我们的 GitHub 仓库（${REPO}）中提交 issue 或讨论。项目运营方应在此补充法律主体与官方联系邮箱。`,
  `இந்தக் கொள்கை பற்றிய கேள்விகளா? எங்கள் GitHub களஞ்சியத்தில் (${REPO}) ஒரு issue அல்லது கலந்துரையாடலைத் தொடங்குங்கள். திட்ட இயக்குநர் இங்கே ஒரு சட்டப்பூர்வ நிறுவனத்தையும் அதிகாரப்பூர்வ தொடர்பு மின்னஞ்சலையும் சேர்க்க வேண்டும்.`,
  `本ポリシーに関するご質問は、GitHub リポジトリ（${REPO}）で issue またはディスカッションを開いてください。プロジェクト運営者は、ここに法人名と公式連絡先メールを追記してください。`,
  `이 정책에 관해 궁금한 점이 있으신가요? 저희 GitHub 저장소(${REPO})에서 이슈나 토론을 여세요. 프로젝트 운영자는 여기에 법인명과 공식 연락처 이메일을 추가해야 합니다.`,
);

const changesP = L(
  'Kami boleh mengemas kini dasar ini dari semasa ke semasa. Perubahan penting akan dicatat dalam sejarah GitHub projek dan tarikh "Dikemas kini" di atas akan berubah. Penggunaan berterusan selepas perubahan bermakna anda menerimanya.',
  'We may update this policy from time to time. Material changes are recorded in the project’s GitHub history and the "Updated" date above will change. Continued use after a change means you accept it.',
  '我们可能会不时更新本政策。重大变更会记录在项目的 GitHub 历史中，上方的"更新"日期也会随之变化。变更后继续使用即表示您接受该变更。',
  'இந்தக் கொள்கையை நாங்கள் அவ்வப்போது புதுப்பிக்கலாம். முக்கியமான மாற்றங்கள் திட்டத்தின் GitHub வரலாற்றில் பதிவு செய்யப்படும், மேலே உள்ள "புதுப்பிக்கப்பட்டது" தேதியும் மாறும். மாற்றத்திற்குப் பிறகு தொடர்ந்து பயன்படுத்துவது நீங்கள் அதை ஏற்றுக்கொள்வதைக் குறிக்கிறது.',
  '本ポリシーは随時更新されることがあります。重要な変更はプロジェクトの GitHub 履歴に記録され、上記の「更新日」も変わります。変更後も利用を続ける場合、その変更に同意したものとみなされます。',
  '저희는 이 정책을 수시로 업데이트할 수 있습니다. 중요한 변경 사항은 프로젝트의 GitHub 이력에 기록되며, 위의 "업데이트" 날짜도 변경됩니다. 변경 후에도 계속 이용하시면 변경 사항에 동의하시는 것으로 간주됩니다.',
);

const DOCS: Record<Props['doc'], { title: string; tagline: string; sections: Section[] }> = {
