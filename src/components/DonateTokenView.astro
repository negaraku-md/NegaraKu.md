  { href: `${REPO}/blob/main/docs/plans/GLOSSARY-MS.md`, label: L('Glosari Melayu', 'Malay glossary', '马来文词汇表', 'மலாய் சொற்களஞ்சியம்', 'マレー語の用語集', '말레이어 용어집', 'อภิธานศัพท์ภาษามลายู', 'Bảng thuật ngữ tiếng Mã Lai', 'Glosarium Melayu', 'مسرد المصطلحات الملايوي', 'मलय शब्दावली', 'Glosario malayo', "Glossaire malais") },
