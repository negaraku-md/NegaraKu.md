    code: null,
    link: { href: 'https://console.anthropic.com/', label: L('Buka Anthropic Console', 'Open the Anthropic Console', '打开 Anthropic Console', 'Anthropic Console-ஐத் திறக்கவும்', 'Anthropic Console を開く', 'Anthropic Console 열기', 'เปิด Anthropic Console', 'Mở Anthropic Console', 'Buka Anthropic Console', 'افتح Anthropic Console', 'Anthropic Console खोलें', 'Abre la Anthropic Console', "Ouvrir la Anthropic Console") },
