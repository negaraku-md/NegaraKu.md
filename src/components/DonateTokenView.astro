---
import type { Locale } from '@/lib/categories';
import { localePath } from '@/lib/i18n';
import { REPO } from '@/lib/site';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string, ar?: string, hi?: string, es?: string, fr?: string) => (locale === 'fr' ? (fr ?? ms) : locale === 'es' ? (es ?? ms) : locale === 'hi' ? (hi ?? ms) : locale === 'ar' ? (ar ?? ms) : locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

const steps = [
  {
    n: 1,
    title: L('Dapatkan kunci API Claude anda', 'Get your Claude API key', '获取你的 Claude API 密钥', 'உங்கள் Claude API சாவியைப் பெறுங்கள்', 'Claude の API キーを取得する', 'Claude API 키 발급받기', 'รับคีย์ API ของ Claude', 'Nhận khóa API Claude của bạn', 'Dapatkan kunci API Claude Anda', 'احصل على مفتاح API الخاص بـ Claude', 'अपनी Claude API कुंजी प्राप्त करें', 'Obtén tu clave API de Claude', "Obtenez votre clé API Claude"),
    body: L(
      'Buat kunci di Anthropic Console. Anda membayar penggunaan token anda sendiri — projek tidak menanggung kos API.',
