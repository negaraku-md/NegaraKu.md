---
import type { Locale, Pillar } from '@/lib/categories';
import { getPillarDef, categoriesInPillar, getPillar, PILLARS } from '@/lib/categories';
import { articlesForLocale } from '@/lib/content';
import { localePath } from '@/lib/i18n';
import PageHero from './PageHero.astro';

// SECTION (pillar) hub. Same system as every other page: hero with breadcrumb +
// scoped search, then section boxes. Adds two things a lone category grid lacked
// — a "start here" set of flagship guides, and sideways links to the other
// sections so the hierarchy is walkable across, not only down.

interface Props {
  locale: Locale;
  pillar: Pillar;
}
const { locale, pillar } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

const def = getPillarDef(pillar)!;
const cats = categoriesInPillar(pillar);
const items = await articlesForLocale(locale);
const inPillar = items.filter((a) => getPillar(a.data.category) === pillar);
const counts: Record<string, number> = {};
for (const a of inPillar) counts[a.data.category] = (counts[a.data.category] ?? 0) + 1;
const topicCount = new Set(
  inPillar.flatMap((a) => (a.data.subcategory ?? []).map((s) => `${a.data.category}/${s}`)),
).size;
const catHref = (id: string) => localePath(`/${id}`, locale);
---

<PageHero
  locale={locale}
  crumb={[{ label: L('Laman Utama', 'Home', '首页'), href: localePath('/', locale) }, { label: def.name[locale] }]}
  title={def.name[locale]}
  desc={def.tagline[locale]}
  stats={[
    { value: cats.length, label: L('kategori', 'categories', '分类') },
    { value: PILLARS.length, label: L('seksyen', 'sections', '版块') },
    { value: topicCount, label: L('topik', 'topics', '主题') },
    { value: inPillar.length, label: L('artikel', 'articles', '文章') },
  ]}
/>

<div class="container pillar-body">
  <section class="psec">
    <header>
      <span>{L('Kategori', 'Categories', '分类')}</span>
      <span>{cats.length}</span>
    </header>
    <div class="psec-body">
      <div class="cat-grid">
        {
          cats.map((c) => (
            <a class="cat-card" href={catHref(c.id)}>
              <span class="ci" aria-hidden="true">{c.icon}</span>
              <span class="cb">
                <b>
                  {c.name[locale]}
                  {counts[c.id] ? <span class="cc">{counts[c.id]}</span> : null}
                </b>
                <span class="cd">{c.blurb[locale]}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

</div>

<style>
  .pillar-body { padding-block: 2rem 4rem; display: flex; flex-direction: column; gap: 1.2rem; }
  .psec {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px; overflow: hidden;
  }
  .psec > header {
    display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    padding: 0.45rem 0.95rem; font-size: 0.67rem; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--muted); background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .psec-body { padding: 1.1rem; }

  .cat-grid { display: grid; gap: 0.8rem; }
  .cat-grid { grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .cat-card {
    background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px;
    text-decoration: none; color: inherit; transition: border-color 0.15s, transform 0.15s;
    display: flex; gap: 0.7rem; align-items: flex-start; padding: 0.95rem 1rem;
  }
  .cat-card:hover { border-color: color-mix(in srgb, var(--gold) 55%, var(--line)); transform: translateY(-2px); }
  .cat-card .ci { font-size: 1.4rem; line-height: 1; }
  .cat-card .cb { display: flex; flex-direction: column; gap: 0.2rem; }
  .cat-card b { font-family: var(--font-title); font-size: 1rem; display: flex; align-items: center; gap: 0.4rem; }
  .cat-card .cc { font-size: 0.7rem; font-weight: 800; color: var(--gold); }
  .cat-card .cd { color: var(--ink-soft); font-size: 0.85rem; line-height: 1.5; }
</style>
