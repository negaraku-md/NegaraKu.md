---
import type { Locale, Pillar } from '@/lib/categories';
import { getPillarDef, categoriesInPillar, PILLARS, getPillar } from '@/lib/categories';
import { articlesForLocale } from '@/lib/content';
import { localePath } from '@/lib/i18n';

// SECTION (pillar) hub. Same system as every other page: hero with breadcrumb +
// scoped search, then section boxes. Adds two things a lone category grid lacked
// — a "start here" set of flagship guides, and sideways links to the other
// sections so the hierarchy is walkable across, not only down.

interface Props {
  locale: Locale;
  pillar: Pillar;
}
const { locale, pillar } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

const def = getPillarDef(pillar)!;
const cats = categoriesInPillar(pillar);
const items = await articlesForLocale(locale);
const inPillar = items.filter((a) => getPillar(a.data.category) === pillar);
const counts: Record<string, number> = {};
for (const a of inPillar) counts[a.data.category] = (counts[a.data.category] ?? 0) + 1;
const featured = inPillar.filter((a) => a.data.tier === '1').slice(0, 6);
const siblings = PILLARS.filter((p) => p.id !== pillar);
const catHref = (id: string) => localePath(`/${id}`, locale);
const artHref = (a: (typeof items)[number]) => localePath(`/${a.data.category}/${a.data.slug}`, locale);
---

<header class="art-hero">
  <div class="container">
    <p class="crumb">
      <a href={localePath('/', locale)}>{L('Laman Utama', 'Home', '首页')}</a> / <span>{def.name[locale]}</span>
    </p>
    <div class="badges">
      <span class="pill tier">{def.icon} {def.name[locale]}</span>
      <span class="pill">{inPillar.length} {L('artikel', 'articles', '篇')}</span>
      <span class="pill">{cats.length} {L('kategori', 'categories', '分类')}</span>
    </div>
    <h1>{def.name[locale]}</h1>
    <p class="lede">{def.tagline[locale]}</p>

    <nav class="sib" aria-label={L('Seksyen lain', 'Other sections', '其他板块')}>
      {
        siblings.map((p) => (
          <a class="sib-chip" href={localePath(`/${p.id}`, locale)}>
            {p.icon} {p.name[locale]} →
          </a>
        ))
      }
    </nav>
  </div>
</header>

<div class="container pillar-body">
  <section class="psec">
    <header>
      <span>{L('Kategori', 'Categories', '分类')}</span>
      <span>{cats.length}</span>
    </header>
    <div class="psec-body">
      <div class="cat-grid">
        {
          cats.map((c) => (
            <a class="cat-card" href={catHref(c.id)}>
              <span class="ci" aria-hidden="true">{c.icon}</span>
              <span class="cb">
                <b>
                  {c.name[locale]}
                  {counts[c.id] ? <span class="cc">{counts[c.id]}</span> : null}
                </b>
                <span class="cd">{c.blurb[locale]}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="psec">
        <header>
          <span>{L('Mula di sini', 'Start here', '从这里开始')}</span>
          <span>{L('Panduan utama', 'Flagship guides', '核心指南')}</span>
        </header>
        <div class="psec-body">
          <div class="feat-grid">
            {featured.map((a) => (
              <a class="feat" href={artHref(a)}>
                <b>{a.data.title}</b>
                <span>{a.data.summary}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</div>

<style>
  .art-hero {
    background:
      radial-gradient(680px 320px at 15% -30%, color-mix(in srgb, var(--gold) 11%, transparent), transparent),
      radial-gradient(900px 360px at 55% -20%, var(--surface-2), transparent);
    border-bottom: 1px solid var(--line);
    padding: 2.4rem 0 2rem;
  }
  .crumb { font-size: 0.84rem; color: var(--muted); margin: 0 0 1rem; }
  .crumb a { color: var(--muted); text-decoration: none; }
  .crumb a:hover { color: var(--gold); }
  .crumb span { color: var(--ink-soft); }
  .badges { display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center; margin-bottom: 1rem; }
  .pill {
    font-size: 0.68rem; font-weight: 700; border-radius: 999px; padding: 0.1rem 0.5rem;
    border: 1px solid var(--line); background: var(--surface-2); color: var(--ink-soft);
  }
  .pill.tier { color: var(--gold); border-color: color-mix(in srgb, var(--gold) 45%, var(--line)); background: color-mix(in srgb, var(--gold) 9%, transparent); }
  .art-hero h1 { margin: 0 0 0.55rem; font-family: var(--font-title); font-weight: 800; font-size: clamp(1.9rem, 4vw, 2.8rem); line-height: 1.1; }
  .lede { color: var(--ink-soft); font-size: 1.1rem; max-width: 60ch; margin: 0 0 1.3rem; }
  .sib { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1.1rem; }
  .sib-chip {
    font-size: 0.82rem; color: var(--ink-soft); text-decoration: none;
    border: 1px solid var(--line); border-radius: 999px; padding: 0.3rem 0.8rem; background: var(--surface);
    transition: border-color 0.15s;
  }
  .sib-chip:hover { border-color: color-mix(in srgb, var(--gold) 55%, var(--line)); color: var(--ink); }

  .pillar-body { padding-block: 2rem 4rem; display: flex; flex-direction: column; gap: 1.2rem; }
  .psec {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px; overflow: hidden;
  }
  .psec > header {
    display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    padding: 0.45rem 0.95rem; font-size: 0.67rem; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--muted); background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .psec-body { padding: 1.1rem; }

  .cat-grid, .feat-grid { display: grid; gap: 0.8rem; }
  .cat-grid { grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .feat-grid { grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .cat-card, .feat {
    background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px;
    text-decoration: none; color: inherit; transition: border-color 0.15s, transform 0.15s;
  }
  .cat-card:hover, .feat:hover { border-color: color-mix(in srgb, var(--gold) 55%, var(--line)); transform: translateY(-2px); }
  .cat-card { display: flex; gap: 0.7rem; align-items: flex-start; padding: 0.95rem 1rem; }
  .cat-card .ci { font-size: 1.4rem; line-height: 1; }
  .cat-card .cb { display: flex; flex-direction: column; gap: 0.2rem; }
  .cat-card b { font-family: var(--font-title); font-size: 1rem; display: flex; align-items: center; gap: 0.4rem; }
  .cat-card .cc { font-size: 0.7rem; font-weight: 800; color: var(--gold); }
  .cat-card .cd { color: var(--ink-soft); font-size: 0.85rem; line-height: 1.5; }
  .feat { display: flex; flex-direction: column; gap: 0.3rem; padding: 0.95rem 1rem; border-left: 3px solid var(--gold); border-radius: 0 10px 10px 0; }
  .feat b { font-family: var(--font-title); font-size: 0.98rem; }
  .feat span { color: var(--ink-soft); font-size: 0.85rem; line-height: 1.5; }
</style>
