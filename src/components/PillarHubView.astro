---
import type { Locale, Pillar } from '@/lib/categories';
import { getPillarDef, categoriesInPillar, getPillar, PILLARS } from '@/lib/categories';
import { articlesForLocale } from '@/lib/content';
import { localePath } from '@/lib/i18n';
import PageHero from './PageHero.astro';

// SECTION (pillar) hub. Same system as every other page: hero with breadcrumb +
// scoped search, then section boxes. Adds two things a lone category grid lacked
// — a "start here" set of flagship guides, and sideways links to the other
// sections so the hierarchy is walkable across, not only down.

interface Props {
  locale: Locale;
  pillar: Pillar;
}
const { locale, pillar } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

const def = getPillarDef(pillar)!;
const cats = categoriesInPillar(pillar);
const items = await articlesForLocale(locale);
const inPillar = items.filter((a) => getPillar(a.data.category) === pillar);
const counts: Record<string, number> = {};
for (const a of inPillar) counts[a.data.category] = (counts[a.data.category] ?? 0) + 1;
const topicCount = new Set(
  inPillar.flatMap((a) => (a.data.subcategory ?? []).map((s) => `${a.data.category}/${s}`)),
).size;
const catHref = (id: string) => localePath(`/${id}`, locale);
// Article count per section (site-wide) for the Sections group.
const sectionCounts: Record<string, number> = {};
for (const a of items) {
  const p = getPillar(a.data.category);
  if (p) sectionCounts[p] = (sectionCounts[p] ?? 0) + 1;
}
---

<PageHero
  locale={locale}
  crumb={[{ label: L('Laman Utama', 'Home', '首页'), href: localePath('/', locale) }, { label: def.name[locale] }]}
  title={def.name[locale]}
  desc={def.tagline[locale]}
  stats={[
    { value: PILLARS.length, label: L('seksyen', 'sections', '版块') },
    { value: cats.length, label: L('kategori', 'categories', '分类') },
    { value: topicCount, label: L('topik', 'topics', '主题') },
    { value: inPillar.length, label: L('artikel', 'articles', '文章') },
  ]}
/>

<div class="container pillar-body">
  <section class="psec">
    <header>
      <span>{L('Kategori', 'Categories', '分类')}</span>
      <span>{cats.length}</span>
    </header>
    <div class="psec-body">
      <div class="cat-grid">
        {
          cats.map((c) => (
            <a class="cat-card" href={catHref(c.id)}>
              <span class="ci-row">
                <span class="ci" aria-hidden="true">{c.icon}</span>
                {counts[c.id] ? <span class="cc">{counts[c.id]}</span> : null}
              </span>
              <b>{c.name[locale]}</b>
              <span class="cd">{c.blurb[locale]}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="psec">
    <header>
      <span>{L('Seksyen', 'Sections', '版块')}</span>
      <span>{PILLARS.length}</span>
    </header>
    <div class="psec-body">
      <div class="cat-grid">
        {
          PILLARS.map((s) => (
            <a
              class={`cat-card${s.id === pillar ? ' current' : ''}`}
              href={localePath(`/${s.id}`, locale)}
              aria-current={s.id === pillar ? 'page' : undefined}
            >
              <span class="ci-row">
                <span class="ci" aria-hidden="true">{s.icon}</span>
                {sectionCounts[s.id] ? <span class="cc">{sectionCounts[s.id]}</span> : null}
              </span>
              <b>{s.name[locale]}</b>
              <span class="cd">{s.tagline[locale]}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</div>

<style>
  .pillar-body { padding-block: 2rem 1rem; display: flex; flex-direction: column; gap: 1.2rem; }
  .psec {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px; overflow: hidden;
  }
  .psec > header {
    display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    padding: 0.45rem 0.95rem; font-size: 0.67rem; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--muted); background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  /* Group title: all-caps header label at a readable size, title font, bright ink. */
  .psec > header span:first-child {
    font-family: var(--font-title); font-size: 1.05rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.03em; line-height: 1.2; color: var(--ink);
  }
  /* Group count follows the title exactly — font, size and colour (bright ink). */
  .psec > header span:last-child {
    font-family: var(--font-title); font-size: 1.05rem; font-weight: 700; line-height: 1.2;
    letter-spacing: 0; color: var(--ink); font-variant-numeric: tabular-nums;
  }
  .psec-body { padding: 1.1rem; }

  .cat-grid { display: grid; gap: 0.8rem; }
  .cat-grid { grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  /* Vertical card: icon (line 1), title + count (line 2), description (line 3). */
  .cat-card {
    background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px;
    text-decoration: none; color: inherit; transition: border-color 0.15s, transform 0.15s;
    display: flex; flex-direction: column; gap: 0.55rem; align-items: flex-start; padding: 1rem 1.05rem;
  }
  .cat-card:hover { border-color: color-mix(in srgb, var(--gold) 55%, var(--line)); transform: translateY(-2px); }
  .cat-card.current { border-color: var(--gold); background: color-mix(in srgb, var(--gold) 8%, var(--surface-2)); }
  .cat-card .ci-row { width: 100%; display: flex; justify-content: space-between; align-items: center; }
  .cat-card .ci { font-size: 1.6rem; line-height: 1; }
  .cat-card b { font-family: var(--font-title); font-size: 1rem; }
  /* Card count follows the card title — same font, size and colour. */
  .cat-card .cc { font-family: var(--font-title); font-size: 1rem; font-weight: 700; line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; }
  .cat-card .cd { color: var(--ink-soft); font-size: 0.85rem; line-height: 1.5; }
</style>
