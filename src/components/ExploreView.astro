---
import type { Locale } from '@/lib/categories';
import { getPillar, PILLARS, getPillarColor, loc } from '@/lib/categories';
import { articlesForLocale, siteStats } from '@/lib/content';
import { mostReadKeys } from '@/lib/apidata';
import { localePath, t } from '@/lib/i18n';
import { exploreFeatures } from '@/lib/exploreFeatures';
import PageHero from './PageHero.astro';
import { stat } from '@/lib/pageStats';
import ArticleStrip from './ArticleStrip.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string) => (locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);
const stats = await siteStats(locale);

const items = await articlesForLocale(locale);
const nonAbout = items.filter((a) => a.data.category !== 'about');
// Shared ranking so the Latest strip excludes what Most read already shows.
const mrKeys = mostReadKeys(nonAbout, 4);

// Per-section rollup — the site's spine (Understand / Living / Business).
const pillarStats = PILLARS.map((p) => {
  const arts = nonAbout.filter((a) => getPillar(a.data.category) === p.id).length;
  // Sections describe themselves with `tagline` (pillars have no `blurb`); the
  // hub's SECTIONS group uses the same field, so the cards match everywhere.
  return { id: p.id, name: loc(p.name, locale), icon: p.icon, blurb: loc(p.tagline, locale), arts };
});

// "More ways to explore" — the full set of discovery surfaces, shared with /start
// (single source of truth in lib/exploreFeatures.ts). We drop the ones /explore
// already shows as full strips above (Latest, Most-read) and its own self-link;
// everything else — incl. Dashboard, Analytics, For AI — now appears here too.
const STRIP_HREFS = new Set(['/explore', '/latest', '/most-read']);
const ways = exploreFeatures(locale).filter((f) => !STRIP_HREFS.has(f.href));
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム', '홈', 'หน้าแรก', 'Trang chủ', 'Beranda'), href: localePath('/', locale) },
    { label: L('Terokai', 'Explore', '探索', 'ஆராயுங்கள்', '探す', '탐색', 'สำรวจ', 'Khám phá', 'Jelajahi') },
  ]}
  title={L('Terokai NegaraKu.md', 'Explore NegaraKu.md', '探索 NegaraKu.md', 'NegaraKu.md ஐ ஆராயுங்கள்', 'NegaraKu.md を探す', 'NegaraKu.md 탐색', 'สำรวจ NegaraKu.md', 'Khám phá NegaraKu.md', 'Jelajahi NegaraKu.md')}
  desc={L(
    'Mula di sini — cari, terokai mengikut tonggak, atau lompat terus ke yang popular.',
    'Start here — search, browse by pillar, or jump straight to what’s popular.',
    '从这里开始——搜索、按支柱浏览，或直达热门内容。',
    'இங்கே தொடங்குங்கள் — தேடுங்கள், தூண்வாரியாக உலாவுங்கள், அல்லது பிரபலமானவற்றுக்கு நேரடியாகச் செல்லுங்கள்.',
    'ここから始めましょう — 検索する、柱ごとに閲覧する、または人気の記事へ直接進めます。',
    '여기서 시작하세요 — 검색하거나, 기둥별로 둘러보거나, 인기 항목으로 바로 이동하세요.',
    'เริ่มต้นที่นี่ — ค้นหา เรียกดูตามเสาหลัก หรือข้ามไปยังเนื้อหายอดนิยมได้ทันที',
    'Bắt đầu tại đây — tìm kiếm, duyệt theo trụ cột, hoặc chuyển thẳng đến nội dung phổ biến.',
    'Mulai di sini — cari, jelajahi berdasarkan pilar, atau langsung menuju yang populer.',
  )}
  stats={[stat.pillars(stats.sections, locale), stat.categories(stats.categories, locale), stat.subcategories(stats.topics, locale), stat.topics(stats.articles, locale)]}
/>

<section class="container block">
  <form class="ex-search" role="search" action={localePath('/search', locale)} method="get">
    <span class="ex-sico" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
    </span>
    <input
      type="search"
      name="q"
      autocomplete="off"
      placeholder={t('search.placeholder', locale)}
      aria-label={t('nav.search', locale)}
    />
    <button type="submit">{t('nav.search', locale)}</button>
  </form>
</section>

<ArticleStrip locale={locale} articles={nonAbout} moreHref="/latest" sort="recent" exclude={mrKeys} />

<ArticleStrip locale={locale} articles={nonAbout} moreHref="/most-read" />

<section class="container block">
  <div class="psec">
    <header>
      <span>
        <span class="pi" aria-hidden="true">🗺️</span>
        {L('Tonggak', 'Pillars', '支柱', 'தூண்கள்', '柱', '기둥', 'เสาหลัก', 'Trụ cột', 'Pilar')}
      </span>
      <span>{PILLARS.length}</span>
    </header>
    <div class="psec-body">
      <div class="cat-grid">
        {pillarStats.map((p) => (
          <a class="cat-card" href={localePath(`/${p.id}`, locale)} style={`--cat:${getPillarColor(p.id)}`}>
            <span class="bar" aria-hidden="true" />
            <span class="ci-row">
              <span class="ci" aria-hidden="true">{p.icon}</span>
              <span class="cc">{p.arts}</span>
            </span>
            <b>{p.name}</b>
            {p.blurb && <span class="cd">{p.blurb}</span>}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="container block">
  <div class="psec">
    <header>
      <span>
        <span class="pi" aria-hidden="true">✨</span>
        {L('Cara lain untuk meneroka', 'More ways to explore', '更多探索方式', 'ஆராய மேலும் வழிகள்', 'ほかの探し方', '더 많은 탐색 방법', 'วิธีสำรวจเพิ่มเติม', 'Thêm cách khám phá', 'Cara lain untuk menjelajah')}
      </span>
    </header>
    <div class="psec-body">
      <div class="cat-grid">
        {ways.map((w) => (
          <a class="cat-card" href={localePath(w.href, locale)} style={`--cat:${w.color}`}>
            <span class="bar" aria-hidden="true" />
            <span class="ci-row"><span class="ci" aria-hidden="true">{w.icon}</span></span>
            <b>{t(w.key, locale)}</b>
            <span class="cd">{w.blurb}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .block { margin-top: 1.6rem; }

  /* Gateway search — a prominent GET form that hands off to /search (?q=). */
  .ex-search { position: relative; display: flex; align-items: center; gap: 0.6rem; }
  .ex-sico {
    position: absolute; left: 1rem; color: var(--muted);
    display: grid; place-items: center; pointer-events: none;
  }
  .ex-search input {
    flex: 1; min-width: 0; font: inherit; font-size: 1.05rem;
    padding: 0.85rem 1rem 0.85rem 2.9rem;
    border-radius: 12px; border: 1px solid var(--line);
    background: var(--surface); color: var(--ink);
  }
  .ex-search input:focus { outline: none; border-color: var(--gold); }
  .ex-search button {
    flex: none; font: inherit; font-weight: 700; cursor: pointer;
    padding: 0.85rem 1.3rem; border-radius: 12px;
    border: 1px solid var(--gold); background: var(--gold); color: var(--accent-contrast);
  }
  .ex-search button:hover { background: var(--gold-600); border-color: var(--gold-600); }
  @media (max-width: 520px) {
    .ex-search button { padding: 0.85rem 1rem; }
  }

  /* Section box + category cards — identical to the standard used on the section
     and category pages (HubGroups), so Explore reads as one system. */
  .psec { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .psec > header {
    display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    padding: 0.45rem 0.95rem; background: var(--surface-2); border-bottom: 1px solid var(--line);
  }
  .psec > header span:first-child {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-title); font-size: 1.05rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.03em; line-height: 1.2; color: var(--muted);
  }
  .psec > header .pi { font-size: 1.2rem; }
  .psec > header span:last-child {
    font-family: var(--font-title); font-size: 1.05rem; font-weight: 700; line-height: 1.2;
    color: var(--muted); font-variant-numeric: tabular-nums;
  }
  .psec-gold > header span:first-child, .psec-gold > header span:last-child { color: var(--gold); }
  .psec-body { padding: 1.1rem; }

  .cat-grid { display: grid; gap: 0.8rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .cat-card {
    position: relative; overflow: hidden;
    background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px;
    text-decoration: none; color: inherit; transition: border-color 0.15s, transform 0.15s;
    display: flex; flex-direction: column; gap: 0.55rem; align-items: flex-start; padding: 1rem 1.05rem;
  }
  .cat-card .bar {
    position: absolute; top: 0; left: 0; right: 0; height: 4px;
    background: var(--cat, var(--gold));
  }
  .cat-card:hover { border-color: var(--cat, var(--gold)); transform: translateY(-2px); }
  .cat-card .ci-row { width: 100%; display: flex; justify-content: space-between; align-items: center; }
  .cat-card .ci { font-size: 1.6rem; line-height: 1; }
  .cat-card b { font-family: var(--font-title); font-size: 1rem; }
  .cat-card .cc { font-family: var(--font-title); font-size: 1rem; font-weight: 700; line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; }
  .cat-card .cd { color: var(--ink-soft); font-size: 0.85rem; line-height: 1.5; }

  .rows { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr)); gap: 1rem; }
</style>
