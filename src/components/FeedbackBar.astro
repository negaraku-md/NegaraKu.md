---
import type { Locale } from '@/lib/categories';
import { REPO } from '@/lib/site';

// Feedback is load-bearing here. Because most articles publish before human
// review, the correction loop IS the quality mechanism — so reporting must be
// as easy as reading. Report and Suggest are deliberately SEPARATE flows:
// "this is wrong" and "this could be better" need different handling.
//
// Static-site friendly: prefilled GitHub issues capture article id, version and
// URL automatically. Swap `issueUrl` for a form endpoint when one exists.

interface Props {
  locale: Locale;
  topicId: string;
  title: string;
  version: string;
  path: string;
}
const { locale, topicId, title, version, path } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

const meta = `\n\n---\nArticle: ${title}\nTopic ID: ${topicId}\nVersion: ${version}\nLanguage: ${locale}\nPath: ${path}\n`;

const issueUrl = (kind: 'error' | 'improve' | 'topic') => {
  const cfg = {
    error: {
      labels: 'correction',
      title: `Correction: ${title}`,
      body: `**What is incorrect?**\n\n\n**What should it say instead?**\n\n\n**Source supporting the correction (link):**\n${meta}`,
    },
    improve: {
      labels: 'improvement',
      title: `Improvement: ${title}`,
      body: `**What could be clearer or more complete?**\n${meta}`,
    },
    topic: {
      labels: 'topic-request',
      title: `Topic request`,
      body: `**What topic should we cover?**\n\n\n**Why is it useful, and who needs it?**\n${meta}`,
    },
  }[kind];
  const q = new URLSearchParams({ title: cfg.title, body: cfg.body, labels: cfg.labels });
  return `${REPO}/issues/new?${q.toString()}`;
};

const shareText = encodeURIComponent(title);
---

<div class="fb">
  <section class="fb-sec" aria-labelledby="fb-h">
    <header><span id="fb-h">{L('Adakah ini membantu?', 'Was this helpful?', '这篇内容有帮助吗？')}</span></header>
    <div class="fb-body">
      <div class="acts">
        <button class="btn vote" data-vote="up" aria-label={L('Ya, membantu', 'Yes, helpful', '有帮助')}>
          👍 {L('Ya', 'Yes', '有用')}
        </button>
        <button class="btn vote" data-vote="down" aria-label={L('Tidak membantu', 'Not helpful', '没有帮助')}>
          👎 {L('Tidak', 'No', '没用')}
        </button>
        <a class="btn" href={issueUrl('error')} rel="noopener">
          ⚑ {L('Laporkan kesilapan', 'Report an error', '报告错误')}
        </a>
        <a class="btn" href={issueUrl('improve')} rel="noopener">
          ✎ {L('Cadangkan penambahbaikan', 'Suggest an improvement', '建议改进')}
        </a>
      </div>
      <p class="thanks" hidden data-thanks>
        {L(
          'Terima kasih — maklum balas anda direkodkan.',
          'Thank you — your feedback has been recorded.',
          '谢谢——您的反馈已记录。',
        )}
      </p>
    </div>
  </section>

  <section class="fb-sec">
    <header><span>{L('Kongsi', 'Share', '分享')}</span></header>
    <div class="fb-body">
      <div class="acts">
        <a class="btn" href={`https://wa.me/?text=${shareText}`} rel="noopener">WhatsApp</a>
        <a
          class="btn"
          href={`https://www.facebook.com/sharer/sharer.php?u=`}
          data-share="facebook"
          rel="noopener">Facebook</a
        >
        <a class="btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=`} data-share="linkedin" rel="noopener"
          >LinkedIn</a
        >
        <button class="btn" data-copy>{L('Salin pautan', 'Copy link', '复制链接')}</button>
      </div>
    </div>
  </section>
</div>

<script>
  // Vote is recorded locally for now; wire to an endpoint when one exists.
  document.querySelectorAll<HTMLButtonElement>('.fb [data-vote]').forEach((b) => {
    b.addEventListener('click', () => {
      const bar = b.closest('.fb');
      bar?.querySelectorAll('[data-vote]').forEach((x) => x.classList.remove('on'));
      b.classList.add('on');
      const t = bar?.querySelector<HTMLElement>('[data-thanks]');
      if (t) t.hidden = false;
      try {
        localStorage.setItem(`fb:${location.pathname}`, b.dataset.vote ?? '');
      } catch {}
    });
  });

  // Share links need the runtime URL.
  const url = encodeURIComponent(location.href);
  document.querySelectorAll<HTMLAnchorElement>('.fb [data-share]').forEach((a) => {
    a.href = a.href.endsWith('=') ? a.href + url : a.href;
    a.target = '_blank';
  });
  document.querySelector<HTMLButtonElement>('.fb [data-copy]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(location.href);
      const old = btn.textContent;
      btn.textContent = '✓';
      setTimeout(() => (btn.textContent = old), 1400);
    } catch {}
  });
</script>

<style>
  .fb { margin-top: 2.4rem; }
  .fb-sec {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 1.2rem;
  }
  .fb-sec > header {
    padding: 0.45rem 0.95rem;
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .fb-body { padding: 1.1rem 0.95rem; }
  .acts {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .btn {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.32rem 0.8rem;
    color: var(--ink-soft);
    background: var(--surface-2);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .btn:hover {
    border-color: var(--gold);
    color: var(--ink);
  }
  .btn.on {
    background: var(--gold);
    color: #000;
    border-color: var(--gold);
  }
  .thanks {
    margin: 0.6rem 0 0;
    color: #4ade80;
    font-size: 0.84rem;
  }
  @media (max-width: 760px) {
    .fb {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
