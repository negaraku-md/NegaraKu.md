---
import type { Locale } from '@/lib/categories';
import { REPO } from '@/lib/site';

// Feedback is load-bearing here. Because most articles publish before human
// review, the correction loop IS the quality mechanism — so reporting must be
// as easy as reading. Report and Suggest are deliberately SEPARATE flows:
// "this is wrong" and "this could be better" need different handling.
//
// Static-site friendly: prefilled GitHub issues capture article id, version and
// URL automatically. Swap `issueUrl` for a form endpoint when one exists.

interface Props {
  locale: Locale;
  topicId: string;
  title: string;
  version: string;
  path: string;
}
const { locale, topicId, title, version, path } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

const meta = `\n\n---\nArticle: ${title}\nTopic ID: ${topicId}\nVersion: ${version}\nLanguage: ${locale}\nPath: ${path}\n`;

const issueUrl = (kind: 'error' | 'improve' | 'topic') => {
  const cfg = {
    error: {
      labels: 'correction',
      title: `Correction: ${title}`,
      body: `**What is incorrect?**\n\n\n**What should it say instead?**\n\n\n**Source supporting the correction (link):**\n${meta}`,
    },
    improve: {
      labels: 'improvement',
      title: `Improvement: ${title}`,
      body: `**What could be clearer or more complete?**\n${meta}`,
    },
    topic: {
      labels: 'topic-request',
      title: `Topic request`,
      body: `**What topic should we cover?**\n\n\n**Why is it useful, and who needs it?**\n${meta}`,
    },
  }[kind];
  const q = new URLSearchParams({ title: cfg.title, body: cfg.body, labels: cfg.labels });
  return `${REPO}/issues/new?${q.toString()}`;
};

const shareText = encodeURIComponent(title);

// Brand SVGs (simple-icons, single-path fill). The page URL is appended at runtime.
const SVG: Record<string, string> = {
  whatsapp: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884M20.463 3.488A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"/></svg>',
  telegram: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>',
  x: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>',
  facebook: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>',
  linkedin: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
  email: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0zM22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0z"/></svg>',
  copy: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/></svg>',
  check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>',
  native: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>',
};
const BRAND: Record<string, string> = {
  whatsapp: '#25D366', telegram: '#26A5E4', x: '#e8e8e8', facebook: '#1877F2', linkedin: '#0A66C2', email: '#f59e0b',
};
// Each href ends where the runtime page URL is appended (see the client script).
const shares = [
  { key: 'whatsapp', label: 'WhatsApp', href: `https://wa.me/?text=${shareText}%20` },
  { key: 'telegram', label: 'Telegram', href: `https://t.me/share/url?text=${shareText}&url=` },
  { key: 'x', label: 'X', href: `https://twitter.com/intent/tweet?text=${shareText}&url=` },
  { key: 'facebook', label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=` },
  { key: 'linkedin', label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=` },
  { key: 'email', label: 'Email', href: `mailto:?subject=${shareText}&body=` },
];
---

<div class="fb" data-pagefind-ignore>
  <section class="fb-sec" aria-labelledby="fb-h">
    <header><span id="fb-h">{L('Adakah ini membantu?', 'Was this helpful?', '这篇内容有帮助吗？')}</span></header>
    <div class="fb-body">
      <div class="acts">
        <button class="btn vote" data-vote="up" aria-label={L('Ya, membantu', 'Yes, helpful', '有帮助')}>
          👍 {L('Ya', 'Yes', '有用')}
        </button>
        <button class="btn vote" data-vote="down" aria-label={L('Tidak membantu', 'Not helpful', '没有帮助')}>
          👎 {L('Tidak', 'No', '没用')}
        </button>
        <a class="btn" href={issueUrl('error')} rel="noopener">
          ⚑ {L('Laporkan kesilapan', 'Report an error', '报告错误')}
        </a>
        <a class="btn" href={issueUrl('improve')} rel="noopener">
          ✎ {L('Cadangkan penambahbaikan', 'Suggest an improvement', '建议改进')}
        </a>
      </div>
      <p class="thanks" hidden data-thanks>
        {L(
          'Terima kasih — maklum balas anda direkodkan.',
          'Thank you — your feedback has been recorded.',
          '谢谢——您的反馈已记录。',
        )}
      </p>
    </div>
  </section>

  <section class="fb-sec">
    <header><span>{L('Kongsi', 'Share', '分享')}</span></header>
    <div class="fb-body">
      <div class="share-row">
        <button type="button" class="share-native" data-native hidden>
          <span class="sv" set:html={SVG.native} />
          {L('Kongsi', 'Share', '分享')}
        </button>
        {shares.map((s) => (
          <a
            class="share-ico"
            data-share
            style={`--brand:${BRAND[s.key]}`}
            href={s.href}
            aria-label={s.label}
            title={s.label}
            rel="noopener"
          >
            <span class="sv" set:html={SVG[s.key]} />
          </a>
        ))}
        <button type="button" class="share-ico copy" data-copy aria-label={L('Salin pautan', 'Copy link', '复制链接')} title={L('Salin pautan', 'Copy link', '复制链接')}>
          <span class="sv sv-copy" set:html={SVG.copy} />
          <span class="sv sv-check" set:html={SVG.check} />
        </button>
      </div>
    </div>
  </section>
</div>

<script>
  // Vote is recorded locally for now; wire to an endpoint when one exists.
  document.querySelectorAll<HTMLButtonElement>('.fb [data-vote]').forEach((b) => {
    b.addEventListener('click', () => {
      const bar = b.closest('.fb');
      bar?.querySelectorAll('[data-vote]').forEach((x) => x.classList.remove('on'));
      b.classList.add('on');
      const t = bar?.querySelector<HTMLElement>('[data-thanks]');
      if (t) t.hidden = false;
      try {
        localStorage.setItem(`fb:${location.pathname}`, b.dataset.vote ?? '');
      } catch {}
    });
  });

  // Share links get the runtime page URL appended (static build has no URL yet).
  const url = encodeURIComponent(location.href);
  document.querySelectorAll<HTMLAnchorElement>('.fb [data-share]').forEach((a) => {
    a.href = a.href + url;
    if (!a.href.startsWith('mailto:')) a.target = '_blank';
    a.rel = 'noopener';
  });

  // Native share sheet (mobile + supported desktop) — surfaced only when available.
  const nativeBtn = document.querySelector<HTMLButtonElement>('.fb [data-native]');
  if (nativeBtn && typeof navigator.share === 'function') {
    nativeBtn.hidden = false;
    nativeBtn.addEventListener('click', () => {
      navigator.share({ title: document.title, url: location.href }).catch(() => {});
    });
  }

  // Copy link → swap to a check icon briefly (CSS toggles on .copied).
  const copyBtn = document.querySelector<HTMLButtonElement>('.fb [data-copy]');
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.href);
      copyBtn.classList.add('copied');
      setTimeout(() => copyBtn.classList.remove('copied'), 1400);
    } catch {}
  });
</script>

<style>
  .fb { margin-top: 2.4rem; }
  .fb-sec {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 1.2rem;
  }
  .fb-sec > header {
    padding: 0.45rem 0.95rem;
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .fb-body { padding: 1.1rem 0.95rem; }
  .acts {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .btn {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.32rem 0.8rem;
    color: var(--ink-soft);
    background: var(--surface-2);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .btn:hover {
    border-color: var(--gold);
    color: var(--ink);
  }
  .btn.on {
    background: var(--gold);
    color: var(--accent-contrast);
    border-color: var(--gold);
  }
  .thanks {
    margin: 0.6rem 0 0;
    color: #4ade80;
    font-size: 0.84rem;
  }

  /* Share — a native share button (when supported) + branded icon buttons. */
  .share-row { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
  .share-native {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600;
    border: 0; border-radius: 999px; background: var(--gold); color: var(--accent-contrast);
    padding: 0 0.95rem; height: 40px; cursor: pointer;
  }
  .share-native[hidden] { display: none; }
  .share-native .sv { display: inline-flex; }
  .share-native .sv :global(svg) { width: 16px; height: 16px; }
  .share-ico {
    width: 40px; height: 40px; display: grid; place-items: center;
    border: 1px solid var(--line); border-radius: 50%; background: var(--surface-2);
    color: var(--ink-soft); cursor: pointer; text-decoration: none;
    transition: border-color 0.15s, color 0.15s, transform 0.15s;
  }
  .share-ico:hover { border-color: var(--brand, var(--gold)); color: var(--brand, var(--gold)); transform: translateY(-2px); }
  .share-ico .sv { display: inline-flex; }
  .share-ico .sv :global(svg) { width: 20px; height: 20px; }
  .share-ico.copy .sv-check { display: none; }
  .share-ico.copy.copied { border-color: #4ade80; color: #4ade80; }
  .share-ico.copy.copied .sv-copy { display: none; }
  .share-ico.copy.copied .sv-check { display: inline-flex; }
  @media (max-width: 760px) {
    .fb {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
