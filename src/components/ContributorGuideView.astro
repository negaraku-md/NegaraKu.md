---
import type { Locale } from '@/lib/categories';
import { localePath } from '@/lib/i18n';
import { REPO } from '@/lib/site';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string) => (locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

// The Contributor View launchpad, explained tool by tool.
const tools = [
  {
    icon: '🔀',
    title: L('Barisan semakan', 'Review queue', '审核队列', 'மறுஆய்வு வரிசை', 'レビュー待ち一覧'),
    body: L('Pull request terbuka menunggu semakan — bantu semak dan luluskan.', 'Open pull requests awaiting review — help review and approve.', '等待审核的开放 PR——帮忙审阅与批准。', 'மறுஆய்வுக்காகக் காத்திருக்கும் திறந்த pull request-கள் — மறுஆய்வு செய்து ஒப்புதல் அளிக்க உதவுங்கள்.', 'レビュー待ちのオープン PR — レビューと承認にご協力ください。'),
  },
  {
    icon: '📝',
    title: L('Artikel draf', 'Draft articles', '草稿文章', 'வரைவுக் கட்டுரைகள்', '下書き記事'),
    body: L('Draf yang belum terbit — sesuai untuk disiapkan atau disemak.', 'Drafts not yet published — good candidates to finish or review.', '尚未发布的草稿——适合完善或审阅。', 'இன்னும் வெளியிடப்படாத வரைவுகள் — முடிக்கவோ மறுஆய்வு செய்யவோ ஏற்ற தேர்வுகள்.', 'まだ公開されていない下書き — 仕上げやレビューに最適です。'),
  },
  {
    icon: '🐛',
    title: L('Isu artikel & terjemahan', 'Article & translation issues', '文章与翻译问题', 'கட்டுரை & மொழிபெயர்ப்பு சிக்கல்கள்', '記事・翻訳の課題'),
    body: L('Isu berlabel di GitHub — pembetulan, permintaan, masalah terjemahan.', 'Labelled issues on GitHub — fixes, requests, translation problems.', 'GitHub 上带标签的问题——更正、请求、翻译问题。', 'GitHub-இல் லேபிளிடப்பட்ட சிக்கல்கள் — திருத்தங்கள், கோரிக்கைகள், மொழிபெயர்ப்புச் சிக்கல்கள்.', 'GitHub のラベル付き課題 — 修正、要望、翻訳の問題。'),
  },
  {
    icon: '🗂️',
    title: L('Senarai kerja', 'Worklist', '工作清单', 'பணிப் பட்டியல்', '作業リスト'),
    body: L('Pandangan di laman tentang apa yang perlu perhatian seterusnya.', 'An on-site view of what needs attention next.', '站内视图，显示接下来需要关注的内容。', 'அடுத்ததாக என்ன கவனம் தேவை என்பதை தளத்திலேயே காட்டும் பார்வை.', '次に対応が必要なものをサイト上で表示します。'),
  },
  {
    icon: '📊',
    title: L('Papan pemuka', 'Dashboard', '仪表板', 'கட்டுப்பாட்டுப் பலகை', 'ダッシュボード'),
    body: L('Kesihatan korpus — liputan, keterkinian terjemahan, semakan tertunggak.', 'Corpus health — coverage, translation freshness, overdue reviews.', '语料库健康度——覆盖率、翻译新鲜度、逾期审阅。', 'தொகுப்பின் ஆரோக்கியம் — உள்ளடக்கம், மொழிபெயர்ப்பின் புத்தம்புதுமை, தாமதமான மறுஆய்வுகள்.', 'コーパスの健全性 — 網羅率、翻訳の鮮度、期限切れのレビュー。'),
  },
  {
    icon: '🚀',
    title: L('Tindakan & deploy', 'Actions & deploy', '操作与部署', 'செயல்கள் & வெளியீடு', 'アクション & デプロイ'),
    body: L('Sejarah larian dan suis penyelenggaraan — terus ke GitHub Actions.', 'Run history and the maintenance switch — straight to GitHub Actions.', '运行历史与维护开关——直达 GitHub Actions。', 'இயக்க வரலாறு மற்றும் பராமரிப்பு நிலைமாற்றி — நேரடியாக GitHub Actions-க்கு.', '実行履歴とメンテナンススイッチ — GitHub Actions へ直接。'),
  },
];

const guides = [
  {
    icon: '✏️',
    title: L('Perbaiki artikel', 'Fix or improve an article', '修改或改进文章', 'ஒரு கட்டுரையைத் திருத்தவும் அல்லது மேம்படுத்தவும்', '記事を修正・改善する'),
    steps: [
      L('Buka artikel dan klik “Sunting di GitHub” di kotak sisi.', 'Open the article and click “Edit on GitHub” in the side box.', '打开文章，点击侧栏的“在 GitHub 编辑”。', 'கட்டுரையைத் திறந்து பக்கப்பெட்டியில் உள்ள “Edit on GitHub” என்பதைக் கிளிக் செய்யவும்.', '記事を開き、サイドボックスの「Edit on GitHub」をクリックします。'),
      L('Sunting Markdown — setiap dakwaan patut membawa sumbernya.', 'Edit the Markdown — every claim should carry its source.', '编辑 Markdown——每条陈述都应附有来源。', 'Markdown-ஐத் திருத்தவும் — ஒவ்வொரு கூற்றும் அதன் ஆதாரத்தைத் தாங்கியிருக்க வேண்டும்.', 'Markdown を編集します — すべての記述には出典を付けてください。'),
      L('Buka pull request; ia disemak secara terbuka sebelum digabung.', 'Open a pull request; it’s reviewed in the open before merging.', '提交 PR；合并前会公开审阅。', 'ஒரு pull request திறக்கவும்; ஒன்றிணைக்கும் முன் அது வெளிப்படையாக மறுஆய்வு செய்யப்படுகிறது.', 'pull request を作成します。マージ前に公開でレビューされます。'),
    ],
  },
  {
    icon: '➕',
    title: L('Tambah artikel baharu', 'Add a new article', '新增文章', 'புதிய கட்டுரையைச் சேர்க்கவும்', '新しい記事を追加する'),
    steps: [
      L('Fork repo, dan tambah knowledge/<kategori>/<slug>.md.', 'Fork the repo, and add knowledge/<category>/<slug>.md.', 'Fork 仓库，新增 knowledge/<分类>/<slug>.md。', 'repo-ஐ fork செய்து, knowledge/<category>/<slug>.md-ஐச் சேர்க்கவும்.', 'repo を fork し、knowledge/<category>/<slug>.md を追加します。'),
      L('Isi frontmatter (tajuk, kategori, sumber) dan tulis dalam Markdown.', 'Fill the frontmatter (title, category, sources) and write in Markdown.', '填写 frontmatter（标题、分类、来源），并用 Markdown 撰写。', 'frontmatter-ஐ (தலைப்பு, வகை, ஆதாரங்கள்) நிரப்பி Markdown-இல் எழுதவும்.', 'frontmatter（タイトル、カテゴリー、出典）を記入し、Markdown で執筆します。'),
      L('Buka PR; artikel mula sebagai draf sehingga disemak dan diterbitkan.', 'Open a PR; the article starts as a draft until reviewed and published.', '提交 PR；文章先为草稿，经审阅后发布。', 'PR திறக்கவும்; மறுஆய்வு செய்து வெளியிடப்படும் வரை கட்டுரை வரைவாகவே இருக்கும்.', 'PR を作成します。記事はレビューと公開まで下書きのままです。'),
    ],
  },
  {
    icon: '💬',
    title: L('Balas semakan', 'Respond to review', '回应审阅', 'மறுஆய்வுக்குப் பதிலளிக்கவும்', 'レビューに応答する'),
    steps: [
      L('Penyemak mengulas pada PR anda — jawab atau tolak dengan sebab.', 'Reviewers comment on your PR — answer, or push back with reason.', '审阅者在你的 PR 上评论——回应，或有理由地反驳。', 'மறுஆய்வாளர்கள் உங்கள் PR-இல் கருத்திடுவார்கள் — பதிலளிக்கவும், அல்லது காரணத்துடன் மறுக்கவும்.', 'レビュアーがあなたの PR にコメントします — 回答するか、理由を添えて反論します。'),
      L('Tolak kemas kini ke cawangan yang sama; PR mengemas kini automatik.', 'Push updates to the same branch; the PR updates automatically.', '推送更新到同一分支；PR 会自动更新。', 'அதே branch-க்கு புதுப்பிப்புகளைத் தள்ளவும்; PR தானாகவே புதுப்பிக்கப்படும்.', '同じブランチに更新をプッシュします。PR は自動的に更新されます。'),
      L('Setelah diluluskan ia digabung dan laman deploy semula.', 'Once approved it merges and the site redeploys.', '获批准后即合并，网站重新部署。', 'ஒப்புதல் பெற்றவுடன் அது ஒன்றிணைக்கப்பட்டு தளம் மீண்டும் பயன்படுத்தப்படும்.', '承認されるとマージされ、サイトが再デプロイされます。'),
    ],
  },
  {
    icon: '⇄',
    title: L('Tukar antara paparan', 'Switch between views', '在视图间切换', 'பார்வைகளுக்கிடையே மாறவும்', 'ビューを切り替える'),
    steps: [
      L('Log masuk sekali setiap pelayar melalui “Log masuk penyumbang”.', 'Sign in once per browser via “Contributor sign-in”.', '通过“贡献者登录”在每个浏览器登录一次。', '“Contributor sign-in” வழியாக ஒவ்வொரு உலாவியிலும் ஒருமுறை உள்நுழையவும்.', '「Contributor sign-in」からブラウザーごとに一度サインインします。'),
      L('Guna suis Pembaca / Penyumbang di bar atas.', 'Use the Reader / Contributor switch in the top bar.', '使用顶栏的读者 / 贡献者切换。', 'மேல் பட்டியில் உள்ள வாசகர் / பங்களிப்பாளர் நிலைமாற்றியைப் பயன்படுத்தவும்.', '上部バーの「読者 / 貢献者」切り替えを使います。'),
      L('Paparan Penyumbang ialah pelancar anda ke semua alat di atas.', 'Contributor View is your launchpad to all the tools above.', '贡献者视图是通往上述所有工具的启动台。', 'பங்களிப்பாளர் பார்வை மேலே உள்ள அனைத்து கருவிகளுக்குமான உங்கள் தொடக்க மேடை.', '貢献者ビューは上記すべてのツールへの入り口です。'),
    ],
  },
];
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム'), href: localePath('/', locale) },
    { label: L('Panduan penyumbang', 'Contributor guide', '贡献者指南', 'பங்களிப்பாளர் வழிகாட்டி', '貢献者ガイド') },
  ]}
  title={L('Panduan penyumbang', 'Contributor guide', '贡献者指南', 'பங்களிப்பாளர் வழிகாட்டி', '貢献者ガイド')}
  desc={L(
    'Cara sebenar untuk menyumbang — alat anda, kitaran hayat artikel, dan langkah demi langkah.',
    'How contributing actually works — your tools, the article lifecycle, and step by step.',
    '贡献的实际运作方式——你的工具、文章生命周期，以及分步指引。',
    'பங்களிப்பு உண்மையில் எப்படி வேலை செய்கிறது — உங்கள் கருவிகள், கட்டுரையின் வாழ்க்கைச் சுழற்சி, மற்றும் படிப்படியாக.',
    '貢献の実際の流れ — あなたのツール、記事のライフサイクル、そしてステップごとの手順。',
  )}
/>

<section class="container block">
  <div class="psec">
    <header><span>{L('Cara ia berfungsi', 'How it works', '运作方式', 'இது எப்படி வேலை செய்கிறது', '仕組み')}</span></header>
    <div class="psec-body prose">
      <p>{L(
        'NegaraKu.md ialah pangkalan pengetahuan terbuka — setiap topik ialah fail Markdown di GitHub. Anda menyumbang dengan fork dan pull request; setiap perubahan disemak secara terbuka, dipetik sumbernya, dan hanya yang diterbitkan muncul di laman awam. Topik sensitif disemak manusia dahulu.',
        'NegaraKu.md is an open knowledge base — every topic is a Markdown file on GitHub. You contribute by fork and pull request; every change is reviewed in the open, sourced, and only published ones appear on the public site. Sensitive topics are human-reviewed first.',
        'NegaraKu.md 是一个开放知识库——每个主题都是 GitHub 上的 Markdown 文件。你通过 fork 和 PR 贡献；每处改动都公开审阅、注明来源，只有已发布的才出现在公开网站上。敏感主题会先经人工审阅。',
        'NegaraKu.md ஒரு திறந்த அறிவுத் தளம் — ஒவ்வொரு தலைப்பும் GitHub-இல் உள்ள ஒரு Markdown கோப்பு. நீங்கள் fork மற்றும் pull request மூலம் பங்களிக்கிறீர்கள்; ஒவ்வொரு மாற்றமும் வெளிப்படையாக மறுஆய்வு செய்யப்பட்டு, ஆதாரம் காட்டப்பட்டு, வெளியிடப்பட்டவை மட்டுமே பொது தளத்தில் தோன்றும். உணர்திறன் மிக்க தலைப்புகள் முதலில் மனிதரால் மறுஆய்வு செய்யப்படுகின்றன.',
        'NegaraKu.md はオープンな知識ベースです — 各トピックは GitHub 上の Markdown ファイルです。fork と pull request で貢献します。すべての変更は公開でレビューされ、出典が示され、公開されたものだけが公開サイトに表示されます。センシティブなトピックは先に人間がレビューします。',
      )}</p>
      <p class="more-about"><a href={localePath('/contribute', locale)}>{L('Kenapa menyumbang & cara mula', 'Why contribute & how to start', '为何贡献及如何开始', 'ஏன் பங்களிக்க வேண்டும் & எப்படித் தொடங்குவது', 'なぜ貢献するのか & 始め方')} →</a></p>
    </div>
  </div>
</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Pelancar anda', 'Your launchpad', '你的启动台', 'உங்கள் தொடக்க மேடை', 'あなたの入り口')}</span></header>
    <div class="psec-body">
      <p class="lead">{L(
        'Tukar ke Paparan Penyumbang dan navigasi bar berubah menjadi pelancar ini — kebanyakannya pautan terus ke alat sebenar di GitHub.',
        'Switch to Contributor View and the nav becomes this launchpad — mostly direct links into the real tools on GitHub.',
        '切换到贡献者视图，导航栏会变成这个启动台——多数是直达 GitHub 上真实工具的链接。',
        'பங்களிப்பாளர் பார்வைக்கு மாறினால் வழிசெலுத்தல் பட்டி இந்தத் தொடக்க மேடையாக மாறுகிறது — பெரும்பாலும் GitHub-இல் உள்ள உண்மையான கருவிகளுக்கான நேரடி இணைப்புகள்.',
        '貢献者ビューに切り替えると、ナビゲーションがこの入り口になります — その多くは GitHub 上の実際のツールへの直接リンクです。',
      )}</p>
      <div class="tcards">
        {tools.map((tval) => (
          <div class="tcard">
            <span class="tico" aria-hidden="true">{tval.icon}</span>
            <div>
              <b>{tval.title}</b>
              <p>{tval.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="container block">
  <div class="psec">
    <header><span>{L('Kitaran hayat artikel', 'The article lifecycle', '文章生命周期', 'கட்டுரையின் வாழ்க்கைச் சுழற்சி', '記事のライフサイクル')}</span></header>
    <div class="psec-body">
      <div class="lifecycle">
        <span class="lc">{L('Draf', 'Draft', '草稿', 'வரைவு', '下書き')}</span>
        <span class="lc-arrow" aria-hidden="true">→</span>
        <span class="lc">{L('Dalam semakan', 'In review', '审阅中', 'மறுஆய்வில்', 'レビュー中')}</span>
        <span class="lc-arrow" aria-hidden="true">→</span>
        <span class="lc lc-live">{L('Diterbitkan', 'Published', '已发布', 'வெளியிடப்பட்டது', '公開済み')}</span>
        <span class="lc-arrow" aria-hidden="true">→</span>
        <span class="lc">{L('Semakan', 'Revision', '修订', 'திருத்தம்', '改訂')}</span>
      </div>
      <p class="lc-note">{L(
        'Hanya artikel yang diterbitkan muncul di laman awam. Draf dan artikel dalam semakan kekal di repo sehingga diluluskan. Setiap penerbitan semula direkod sebagai semakan bernombor.',
        'Only published articles appear on the public site. Drafts and in-review articles stay in the repo until approved. Each re-publish is recorded as a numbered revision.',
        '只有已发布的文章才出现在公开网站上。草稿与审阅中的文章保留在仓库，直到获批。每次重新发布都记录为带编号的修订。',
        'வெளியிடப்பட்ட கட்டுரைகள் மட்டுமே பொது தளத்தில் தோன்றும். வரைவுகளும் மறுஆய்வில் உள்ள கட்டுரைகளும் ஒப்புதல் பெறும் வரை repo-இல் இருக்கும். ஒவ்வொரு மீள்வெளியீடும் எண்ணிடப்பட்ட திருத்தமாகப் பதிவு செய்யப்படுகிறது.',
        '公開された記事だけが公開サイトに表示されます。下書きとレビュー中の記事は、承認されるまで repo に残ります。再公開はそれぞれ番号付きの改訂として記録されます。',
      )}</p>
    </div>
  </div>
