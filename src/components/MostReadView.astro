---
import type { Locale } from '@/lib/categories';
import { articlesForLocale, siteStats } from '@/lib/content';
import { getAnalytics } from '@/lib/apidata';
import { localePath, t } from '@/lib/i18n';
import PageHero from './PageHero.astro';
import ArticleList from './ArticleList.astro';

// Most Read — the corpus ranked by reader popularity (visitor analytics), with a
// recency fallback so the list is never empty while analytics are still young:
// articles with reads sort first (most-read → least), then everything else by
// most-recently-updated. Capped at the top 50; the order is fixed (no sort row).

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string) => (locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

const analytics = getAnalytics();
const readsOf = (cat: string, slug: string): number => {
  const r = analytics[`${cat}/${slug}`]?.readers;
  return r == null ? 0 : typeof r === 'object' ? r.total ?? 0 : r;
};

const MAX_ITEMS = 50;
const canonical = (await articlesForLocale(locale))
  .filter((a) => a.data.lang === locale)
  .sort((a, b) => {
    const ra = readsOf(a.data.category, a.data.slug);
    const rb = readsOf(b.data.category, b.data.slug);
    if (rb !== ra) return rb - ra; // most-read first
    return +new Date(b.data.updated) - +new Date(a.data.updated); // then freshest
  })
  .slice(0, MAX_ITEMS);

const tracked = canonical.filter((a) => readsOf(a.data.category, a.data.slug) > 0).length;

// Hero shows the whole-corpus figures (same rule as every other page) so counts
// reconcile site-wide; the ranked list below is the top slice.
const stats = await siteStats(locale);
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム', '홈'), href: localePath('/', locale) },
    { label: t('nav.trending', locale) },
  ]}
  title={t('nav.trending', locale)}
  desc={L(
    'Artikel paling banyak dibaca — disusun mengikut lawatan pembaca, dengan yang terbaharu diutamakan sementara data masih terkumpul.',
    'The most-read articles — ranked by reader visits, with the freshest first while analytics are still building.',
    '阅读量最高的文章——按读者访问量排序；在数据仍在积累时，优先展示最新文章。',
    'அதிகம் படிக்கப்பட்ட கட்டுரைகள் — வாசகர் வருகைகளின் அடிப்படையில் தரவரிசைப்படுத்தப்பட்டவை; பகுப்பாய்வுத் தரவு இன்னும் திரண்டு வரும் நிலையில் புதியவை முதலில் காட்டப்படும்.',
    '最もよく読まれている記事 — 読者の訪問数で順位付けし、分析データが蓄積されるまでは新しいものを優先表示します。',
    '가장 많이 읽힌 기사 — 독자 방문 수에 따라 순위를 매기며, 분석 데이터가 아직 축적되는 동안에는 최신 기사를 우선 표시합니다.',
  )}
  stats={[
    { value: stats.sections, label: L('tonggak', 'pillars', '支柱', 'தூண்கள்', '柱', '기둥') },
    { value: stats.categories, label: L('kategori', 'categories', '分类', 'வகைகள்', 'カテゴリ', '카테고리') },
    { value: stats.topics, label: L('subkategori', 'subcategories', '子分类', 'துணை வகைகள்', 'サブカテゴリ', '하위 카테고리') },
    { value: stats.articles, label: L('topik', 'topics', '主题', 'தலைப்புகள்', 'トピック', '주제') },
  ]}
/>

<section class="container">
  <p class="tr-note">
    <span aria-hidden="true">ℹ️</span>
    {tracked === 0
      ? L(
          'Analitik pembaca masih terkumpul, jadi buat masa ini senarai ini menunjukkan artikel yang paling baru dikemas kini — bukan kedudukan populariti.',
          'Reader analytics are still building, so for now this shows the most recently updated articles — not a popularity ranking yet.',
          '读者分析仍在积累中，因此目前显示的是最近更新的文章——尚非人气排名。',
          'வாசகர் பகுப்பாய்வுத் தரவு இன்னும் திரண்டு வருகிறது; எனவே தற்போது இது சமீபத்தில் புதுப்பிக்கப்பட்ட கட்டுரைகளையே காட்டுகிறது — இன்னும் மக்கள் விருப்ப தரவரிசை அல்ல.',
          '読者の分析データはまだ蓄積中のため、現時点では最近更新された記事を表示しています — まだ人気順位ではありません。',
          '독자 분석 데이터가 아직 축적되는 중이므로, 현재는 인기 순위가 아니라 가장 최근에 업데이트된 기사를 표시합니다.',
        )
      : L(
          'Disusun mengikut lawatan pembaca dan dikemas kini setiap hari. Artikel yang belum dijejak disusun mengikut kemas kini terbaharu, jadi senarai ini terus terisi apabila data bertambah.',
          'Ranked by reader visits and refreshed daily. Articles not tracked yet are ordered by most recent update, so the list fills out as analytics grow.',
          '按读者访问量排序，每日更新。尚未被追踪的文章按最近更新排序，随着数据积累，列表会逐渐充实。',
          'வாசகர் வருகைகளின் அடிப்படையில் தரவரிசைப்படுத்தப்பட்டு தினமும் புதுப்பிக்கப்படுகிறது. இன்னும் கண்காணிக்கப்படாத கட்டுரைகள் சமீபத்திய புதுப்பிப்பின்படி வரிசைப்படுத்தப்படுகின்றன; எனவே பகுப்பாய்வுத் தரவு வளர வளர இப்பட்டியல் நிறைவடையும்.',
          '読者の訪問数で順位付けし、毎日更新されます。まだ計測されていない記事は最新の更新順に並ぶため、分析データが増えるにつれて一覧が充実していきます。',
          '독자 방문 수에 따라 순위를 매기며 매일 갱신됩니다. 아직 추적되지 않은 기사는 최근 업데이트 순으로 정렬되므로, 분석 데이터가 늘어남에 따라 목록이 채워집니다.',
        )}
  </p>
</section>

<ArticleList locale={locale} articles={canonical} filters={['sec', 'cat', 'top', 'status']} hideSort fixedOrder showRank={tracked > 0} />

<style>
  .tr-note {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin: 0.2rem 0 0;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.5;
  }
</style>
