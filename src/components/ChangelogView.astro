---
import type { Locale } from '@/lib/categories';
import { getCategory } from '@/lib/categories';
import { getChangelog } from '@/lib/apidata';
import { localePath } from '@/lib/i18n';
import { REPO } from '@/lib/site';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = getChangelog();
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

const typeLabel: Record<string, string> = {
  feature: L('Ciri', 'Features', '功能'),
  fix: L('Pembetulan', 'Fixes', '修复'),
  content: L('Kandungan', 'Content', '内容'),
  translate: L('Terjemahan', 'Translation', '翻译'),
  chore: L('Penyelenggaraan', 'Maintenance', '维护'),
};

// Flatten day-grouped commits into one row list (newest first), the same shape
// the All-Articles list consumes: each row carries its own meta.
const rows = c.days.flatMap((day) =>
  day.items.map((it: any) => ({
    icon: it.icon ?? '•',
    title: it.titleI18n ? it.titleI18n[locale] : it.subject,
    cat: it.category ? getCategory(it.category)?.name[locale] ?? it.category : '',
    type: it.type ?? 'chore',
    typeLabel: typeLabel[it.type] ?? it.type ?? '',
    author: it.author ?? '',
    date: it.date ?? day.date,
    hash: it.hash ?? '',
    url: it.hash ? `${REPO}/commit/${it.hash}` : '',
  })),
);

const present = Object.keys(typeLabel).filter((k) => rows.some((r) => r.type === k));
const filters = [
  { key: '', label: L('Semua', 'All', '全部'), count: rows.length },
  ...present.map((k) => ({ key: k, label: typeLabel[k], count: rows.filter((r) => r.type === k).length })),
];

const I18N = {
  type: L('Jenis', 'Type', '类型'),
  category: L('Kategori', 'Category', '分类'),
  contributor: L('Penyumbang', 'Contributor', '贡献者'),
  date: L('Tarikh', 'Date', '日期'),
  commit: L('Komit', 'Commit', '提交'),
  none: L('Tiada rekod.', 'No entries.', '没有记录。'),
  contributorsUrl: localePath('/contributors', locale),
};

// The change descriptions come from the git history, which is kept in English
// (the project's working language); only the interface around them is localised.
const enNote = L(
  'Penerangan perubahan dalam bahasa Inggeris — bahasa kerja projek; antara mukanya diterjemah.',
  'Change descriptions are in English — the project’s working language; the interface around them is translated.',
  '变更说明为英文——项目的工作语言；其外围界面已翻译。',
);
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页'), href: localePath('/', locale) },
    { label: L('Log Perubahan', 'Changelog', '更新日志') },
  ]}
  title={L('Log Perubahan', 'Changelog', '更新日志')}
  desc={L(
    'Setiap perubahan pada NegaraKu.md — kandungan, terjemahan dan penambahbaikan — mengikut tarikh dan penyumbang.',
    'Every change to NegaraKu.md — content, translations and improvements — by date and contributor.',
    'NegaraKu.md 的每一次变更——内容、翻译与改进——按日期和贡献者列出。',
  )}
  stats={[
    { value: c.total, label: L('kemas kini', 'updates', '次更新') },
    { value: filters.length - 1, label: L('jenis', 'types', '类型') },
    { value: (c.tally.content ?? 0) + (c.tally.translate ?? 0), label: L('kandungan', 'content', '内容') },
  ]}
/>

<section class="container clwrap" id="clwrap">
  <p class="cl-note">{enNote}</p>
  <div class="art-toolbar">
    <div class="tb-line">
      <span class="tb-label">{L('Isih', 'Sort', '排序')}</span>
      <div class="tabs" role="tablist">
        <button class="tab on" data-dir="desc">{L('Terkini', 'Latest', '最新')}</button>
        <button class="tab" data-dir="asc">{L('Terlama', 'Oldest', '最早')}</button>
      </div>
    </div>
    <div class="tb-line">
      <span class="tb-label">{L('Jenis', 'Type', '类型')}</span>
      <div class="tabs">
        {filters.map((f) => (
          <button class={`tab${f.key === '' ? ' on' : ''}`} data-type={f.key}>
            {f.label} <span class="tc">{f.count}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="tb-line">
      <span class="tb-label">{L('Cari', 'Search', '搜索')}</span>
      <input id="cl-q" type="search" placeholder={L('Cari perubahan…', 'Search changes…', '搜索变更…')} />
    </div>
  </div>

  <div class="pager pager-top">
    <div class="pg-size">
      <label>{L('Baris', 'Rows', '每页')}
        <select class="pg-size-sel">
          <option>25</option>
          <option>50</option>
          <option>100</option>
        </select>
      </label>
      <span class="pg-count"></span>
    </div>
    <div class="pg-nav">
      <button class="pg-first" title={L('Pertama', 'First', '首页')}>«</button>
      <button class="pg-prev" title={L('Sebelum', 'Prev', '上一页')}>‹</button>
      <span class="pg-of">
        {L('Halaman', 'Page', '第')}
        <input class="pg-no" type="number" min="1" value="1" />
        / <span class="pg-total">1</span>
      </span>
      <button class="pg-next" title={L('Seterusnya', 'Next', '下一页')}>›</button>
      <button class="pg-last" title={L('Akhir', 'Last', '末页')}>»</button>
    </div>
  </div>

  <div class="cl-list" data-role="list"></div>

  <div class="pager">
    <div class="pg-size">
      <label>{L('Baris', 'Rows', '每页')}
        <select class="pg-size-sel">
          <option>25</option>
          <option>50</option>
          <option>100</option>
        </select>
      </label>
      <span class="pg-count"></span>
    </div>
    <div class="pg-nav">
      <button class="pg-first" title={L('Pertama', 'First', '首页')}>«</button>
      <button class="pg-prev" title={L('Sebelum', 'Prev', '上一页')}>‹</button>
      <span class="pg-of">
        {L('Halaman', 'Page', '第')}
        <input class="pg-no" type="number" min="1" value="1" />
        / <span class="pg-total">1</span>
      </span>
      <button class="pg-next" title={L('Seterusnya', 'Next', '下一页')}>›</button>
      <button class="pg-last" title={L('Akhir', 'Last', '末页')}>»</button>
    </div>
  </div>

  <script type="application/json" data-role="rows" set:html={JSON.stringify(rows)}></script>
  <script type="application/json" data-role="i18n" set:html={JSON.stringify(I18N)}></script>
</section>

<script>
  const wrap = document.getElementById('clwrap');
  if (wrap) {
    const ROWS = JSON.parse(wrap.querySelector('[data-role="rows"]')?.textContent || '[]');
    const I = JSON.parse(wrap.querySelector('[data-role="i18n"]')?.textContent || '{}');
    const listEl = wrap.querySelector('[data-role="list"]');
    const $$ = (cls) => wrap.querySelectorAll('.' + cls);
    const onAll = (cls, ev, fn) => $$(cls).forEach((el) => el.addEventListener(ev, fn));
    const state = { type: '', q: '', dir: 'desc', page: 1, size: 25 };
    const esc = (s) =>
      String(s).replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[m]);

    const filtered = () => {
      const q = state.q.trim().toLowerCase();
      let out = ROWS.filter(
        (r) =>
          (!state.type || r.type === state.type) &&
          (!q || (r.title + ' ' + r.author + ' ' + r.cat).toLowerCase().includes(q)),
      );
      // ROWS arrive newest-first; reverse for oldest.
      if (state.dir === 'asc') out = [...out].reverse();
      return out;
    };

    const rowHtml = (r) => {
      const bits = [];
      if (r.typeLabel) bits.push(`<span class="chip type" data-t="${esc(r.type)}">${esc(I.type)}: ${esc(r.typeLabel)}</span>`);
      if (r.cat) bits.push(`<span class="chip">${esc(I.category)}: ${esc(r.cat)}</span>`);
      if (r.author) bits.push(`<a class="chip contrib" href="${esc(I.contributorsUrl)}">${esc(I.contributor)}: ${esc(r.author)}</a>`);
      if (r.date) bits.push(`<span class="chip dim">${esc(I.date)}: ${esc(r.date)}</span>`);
      if (r.hash)
        bits.push(`<a class="chip sha" href="${esc(r.url)}" target="_blank" rel="noopener">${esc(I.commit)}: ${esc(r.hash)}</a>`);
      return `<div class="cl-row">
          <span class="cl-ico" aria-hidden="true">${esc(r.icon)}</span>
          <div class="cl-main">
            <p class="cl-title">${esc(r.title)}</p>
            <div class="cl-meta">${bits.join('')}</div>
          </div>
        </div>`;
    };

    const render = () => {
      const data = filtered();
      const total = data.length;
      const pages = Math.max(1, Math.ceil(total / state.size));
      if (state.page > pages) state.page = pages;
      const start = (state.page - 1) * state.size;
      const slice = data.slice(start, start + state.size);
      listEl.innerHTML = slice.length ? slice.map(rowHtml).join('') : `<p class="cl-empty">${esc(I.none)}</p>`;

      const a = total ? start + 1 : 0;
      const b = Math.min(start + state.size, total);
      $$('pg-count').forEach((el) => (el.textContent = `${a}–${b} / ${total}`));
      $$('pg-total').forEach((el) => (el.textContent = pages));
      $$('pg-no').forEach((el) => { el.value = state.page; el.max = pages; });
      $$('pg-size-sel').forEach((el) => (el.value = String(state.size)));
      [...$$('pg-first'), ...$$('pg-prev')].forEach((el) => (el.disabled = state.page <= 1));
      [...$$('pg-next'), ...$$('pg-last')].forEach((el) => (el.disabled = state.page >= pages));
    };

    const go = (p) => { state.page = Math.max(1, Math.min(p, Math.ceil(filtered().length / state.size) || 1)); render(); };

    // Sort tabs
    wrap.querySelectorAll('[data-dir]').forEach((btn) =>
      btn.addEventListener('click', () => {
        state.dir = btn.dataset.dir;
        state.page = 1;
        wrap.querySelectorAll('[data-dir]').forEach((x) => x.classList.toggle('on', x === btn));
        render();
      }),
    );
    // Type tabs
    wrap.querySelectorAll('[data-type]').forEach((btn) =>
      btn.addEventListener('click', () => {
        state.type = btn.dataset.type;
        state.page = 1;
        wrap.querySelectorAll('[data-type]').forEach((x) => x.classList.toggle('on', x === btn));
        render();
      }),
    );
    // Search
    const qEl = document.getElementById('cl-q');
    qEl?.addEventListener('input', () => { state.q = qEl.value; state.page = 1; render(); });
    // Pager
    onAll('pg-size-sel', 'change', (e) => { state.size = +e.target.value; state.page = 1; render(); });
    onAll('pg-first', 'click', () => go(1));
    onAll('pg-prev', 'click', () => go(state.page - 1));
    onAll('pg-next', 'click', () => go(state.page + 1));
    onAll('pg-last', 'click', () => go(Math.ceil(filtered().length / state.size)));
    onAll('pg-no', 'change', (e) => go(+e.target.value || 1));

    render();
  }
</script>

<style>
  .clwrap { padding-block: 1.6rem 3rem; }
  .cl-note { margin: 0 0 1.2rem; color: var(--muted); font-size: 0.82rem; line-height: 1.5; }

  /* Toolbar — identical to the All-Articles page. */
  .art-toolbar { display: flex; flex-direction: column; gap: 1.1rem; margin-bottom: 1.6rem; padding-bottom: 1.3rem; border-bottom: 1px solid var(--line); }
  .tb-line { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .tb-label { flex: none; min-width: 3.5rem; font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink); }
  .tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .tab { font-size: 0.82rem; font-weight: 500; padding: 0.4rem 0.8rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--gold) 55%, var(--line)); background: var(--surface); color: var(--ink-soft); cursor: pointer; }
  .tab:hover { border-color: var(--gold); background: color-mix(in srgb, var(--gold) 10%, var(--surface)); }
  .tab.on { color: var(--accent-contrast); background: var(--gold); border-color: var(--gold); }
  .tab .tc { color: var(--muted); font-variant-numeric: tabular-nums; }
  .tab.on .tc { color: rgba(0, 0, 0, 0.6); }
  .tb-line input[type='search'] { font: inherit; font-size: 0.85rem; padding: 0.45rem 0.7rem; border-radius: 8px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); min-width: min(26rem, 100%); flex: 1; max-width: 30rem; }
  .tb-line input[type='search']:focus { outline: none; border-color: var(--gold); }

  /* Pager — identical to the All-Articles page. */
  .pager { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: space-between; align-items: center; margin-top: 1rem; font-size: 0.85rem; }
  .pager-top { margin-top: 0; margin-bottom: 1.1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .pager:not(.pager-top) { padding-top: 1rem; border-top: 1px solid var(--line); }
  .pg-size { display: flex; align-items: center; gap: 0.8rem; color: var(--muted); }
  .pg-size select { font: inherit; margin-left: 0.3rem; padding: 0.2rem 0.4rem; border-radius: 6px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); }
  .pg-nav { display: flex; align-items: center; gap: 0.3rem; }
  .pg-nav button { min-width: 2rem; padding: 0.3rem 0.5rem; border-radius: 8px; border: 1px solid color-mix(in srgb, var(--gold) 55%, var(--line)); background: var(--surface); color: var(--ink); cursor: pointer; font-size: 1rem; line-height: 1; }
  .pg-nav button:hover:not(:disabled) { border-color: var(--gold); background: color-mix(in srgb, var(--gold) 10%, var(--surface)); color: var(--gold); }
  .pg-nav button:disabled { opacity: 0.4; cursor: default; }
  .pg-of { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--muted); }
  .pg-of input { width: 3.2rem; font: inherit; text-align: center; padding: 0.25rem; border-radius: 6px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); }

  /* Rows are injected client-side, so anchor every rule on the server-rendered
     .cl-list container and mark the injected descendants :global — otherwise the
     scoped selectors never match and the chips render as unstyled text. */
  .cl-list { display: flex; flex-direction: column; gap: 0.55rem; }
  .cl-list :global(.cl-row) {
    display: grid; grid-template-columns: auto 1fr; gap: 0.8rem; align-items: start;
    border: 1px solid var(--line); border-left: 3px solid color-mix(in srgb, var(--gold) 55%, var(--line));
    border-radius: 12px; background: var(--surface); padding: 0.9rem 1.1rem;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .cl-list :global(.cl-row:hover) { border-left-color: var(--gold); background: var(--surface-2); }
  .cl-list :global(.cl-ico) { font-size: 1.1rem; line-height: 1.4; }
  .cl-list :global(.cl-title) { margin: 0 0 0.5rem; font-family: var(--font-title); font-weight: 700; font-size: 1rem; color: var(--ink); line-height: 1.4; }
  .cl-list :global(.cl-meta) { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .cl-list :global(.chip) { font-size: 0.74rem; border: 1px solid var(--line); border-radius: 999px; padding: 0.1rem 0.55rem; color: var(--ink-soft); white-space: nowrap; }
  .cl-list :global(.chip.dim) { color: var(--muted); }
  .cl-list :global(.chip.sha) { font-family: monospace; color: var(--gold); text-decoration: none; }
  .cl-list :global(.chip.sha:hover) { border-color: var(--gold); }
  .cl-list :global(a.chip.contrib) { text-decoration: none; }
  .cl-list :global(a.chip.contrib:hover) { border-color: var(--gold); color: var(--gold); }
  .cl-list :global(.chip.type) { font-weight: 700; }
  .cl-list :global(.chip.type[data-t='content']) { color: #4ade80; border-color: color-mix(in srgb, #4ade80 40%, var(--line)); }
  .cl-list :global(.chip.type[data-t='translate']) { color: #60a5fa; border-color: color-mix(in srgb, #60a5fa 40%, var(--line)); }
  .cl-list :global(.chip.type[data-t='feature']) { color: var(--gold); border-color: color-mix(in srgb, var(--gold) 40%, var(--line)); }
  .cl-list :global(.chip.type[data-t='fix']) { color: #fb7185; border-color: color-mix(in srgb, #fb7185 40%, var(--line)); }
  .cl-list :global(.cl-empty) { color: var(--muted); padding: 2rem 0; text-align: center; }
</style>
