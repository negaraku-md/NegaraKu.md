---
import type { Locale } from '@/lib/categories';
import { localePath, LOCALES, LOCALE_NAMES } from '@/lib/i18n';
import PageHero from './PageHero.astro';

// Visitor preferences, persisted to localStorage. No account needed; everything
// is client-side. Deliberately NOT in the main nav — reached from the footer.
// Extensible: add a <section class="set-card"> block and wire a key below.
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string, ar?: string, hi?: string, es?: string) => (locale === 'es' ? (es ?? ms) : locale === 'hi' ? (hi ?? ms) : locale === 'ar' ? (ar ?? ms) : locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム', '홈', 'หน้าแรก', 'Trang chủ', 'Beranda', 'الصفحة الرئيسية', 'मुख्य पृष्ठ', 'Inicio'), href: localePath('/', locale) },
    { label: L('Tetapan', 'Settings', '设置', 'அமைப்புகள்', '設定', '설정', 'การตั้งค่า', 'Cài đặt', 'Pengaturan', 'الإعدادات', 'सेटिंग्स', 'Configuración') },
  ]}
  title={L('Tetapan', 'Settings', '设置', 'அமைப்புகள்', '設定', '설정', 'การตั้งค่า', 'Cài đặt', 'Pengaturan', 'الإعدادات', 'सेटिंग्स', 'Configuración')}
  desc={L(
    'Sesuaikan cara anda membaca NegaraKu.md. Tetapan disimpan dalam pelayar anda sahaja.',
    'Tune how you read NegaraKu.md. Preferences are saved in your browser only.',
    '自定义你阅读 NegaraKu.md 的方式。设置仅保存在你的浏览器中。',
    'நீங்கள் NegaraKu.md-ஐ எப்படிப் படிக்கிறீர்கள் என்பதைச் சரிசெய்யுங்கள். விருப்பங்கள் உங்கள் உலாவியில் மட்டுமே சேமிக்கப்படுகின்றன.',
    'NegaraKu.md の読み方をお好みに調整できます。設定はお使いのブラウザにのみ保存されます。',
    'NegaraKu.md를 읽는 방식을 조정하세요. 설정은 귀하의 브라우저에만 저장됩니다.',
    'ปรับแต่งวิธีที่คุณอ่าน NegaraKu.md การตั้งค่าจะถูกบันทึกไว้ในเบราว์เซอร์ของคุณเท่านั้น',
    'Tùy chỉnh cách bạn đọc NegaraKu.md. Các tùy chọn chỉ được lưu trong trình duyệt của bạn.',
    'Sesuaikan cara Anda membaca NegaraKu.md. Pengaturan hanya disimpan di peramban Anda.',
    'اضبط طريقة قراءتك لـ NegaraKu.md. تُحفظ التفضيلات في متصفحك فقط.',
    'NegaraKu.md पढ़ने का तरीका अपने अनुसार समायोजित करें। प्राथमिकताएँ केवल आपके ब्राउज़र में सहेजी जाती हैं।',
    'Ajusta cómo lees NegaraKu.md. Las preferencias se guardan únicamente en tu navegador.',
  )}
/>

<div class="settings" id="settings">
  <!-- Default language -->
  <section class="set-card">
    <h2>{L('Bahasa lalai', 'Default language', '默认语言', 'இயல்பு மொழி', '既定の言語', '기본 언어', 'ภาษาเริ่มต้น', 'Ngôn ngữ mặc định', 'Bahasa bawaan', 'اللغة الافتراضية', 'डिफ़ॉल्ट भाषा', 'Idioma predeterminado')}</h2>
    <p class="note">
      {L(
        'Bahasa pilihan anda apabila melawat laman utama. Anda sentiasa boleh menukar bahasa menggunakan penukar bahasa.',
        'Your preferred language when landing on the home page. You can always switch using the language switcher.',
        '你访问首页时的首选语言。你随时可以用语言切换器切换。',
        'முகப்புப் பக்கத்திற்கு வரும்போது உங்கள் விருப்ப மொழி. மொழி மாற்றி மூலம் நீங்கள் எப்போதும் மொழியை மாற்றலாம்.',
        'ホームページを開いたときの優先言語です。言語スイッチャーでいつでも変更できます。',
        '홈페이지에 처음 방문할 때 사용할 선호 언어입니다. 언어 전환기로 언제든지 바꿀 수 있습니다.',
        'ภาษาที่คุณต้องการเมื่อเข้าสู่หน้าแรก คุณสามารถสลับภาษาได้เสมอด้วยตัวสลับภาษา',
        'Ngôn ngữ ưu tiên của bạn khi truy cập trang chủ. Bạn luôn có thể chuyển đổi bằng bộ chuyển ngôn ngữ.',
        'Bahasa pilihan Anda saat mengunjungi beranda. Anda selalu dapat beralih menggunakan pengalih bahasa.',
        'لغتك المفضّلة عند الوصول إلى الصفحة الرئيسية. يمكنك دائمًا التبديل باستخدام مُبدِّل اللغة.',
        'मुख्य पृष्ठ पर आने पर आपकी पसंदीदा भाषा। आप भाषा स्विचर का उपयोग करके हमेशा बदल सकते हैं।',
        'Tu idioma preferido al entrar en la página principal. Siempre puedes cambiarlo con el selector de idioma.',
      )}
    </p>
    <div class="opts" data-group="lang">
      <label class="opt"><input type="radio" name="deflang" value="auto" /><span>{L('Automatik', 'Auto', '自动', 'தானியங்கி', '自動', '자동', 'อัตโนมัติ', 'Tự động', 'Otomatis', 'تلقائي', 'स्वचालित', 'Automático')}</span></label>
      {LOCALES.map((l) => (
        <label class="opt"><input type="radio" name="deflang" value={l} /><span>{LOCALE_NAMES[l]} ({l.toUpperCase()})</span></label>
      ))}
    </div>
  </section>

  <!-- 3. Reading -->
  <section class="set-card">
    <h2>{L('Bacaan', 'Reading', '阅读', 'வாசிப்பு', '表示', '읽기', 'การอ่าน', 'Đọc', 'Bacaan', 'القراءة', 'पठन', 'Lectura')}</h2>
    <div class="row">
      <span class="row-label">{L('Saiz teks', 'Text size', '字号', 'எழுத்து அளவு', '文字サイズ', '글자 크기', 'ขนาดตัวอักษร', 'Cỡ chữ', 'Ukuran teks', 'حجم النص', 'टेक्स्ट आकार', 'Tamaño del texto')}</span>
      <div class="seg" data-group="size">
        <button type="button" data-value="standard">{L('Biasa', 'Standard', '标准', 'சாதாரண', '標準', '표준', 'มาตรฐาน', 'Tiêu chuẩn', 'Biasa', 'قياسي', 'मानक', 'Estándar')}</button>
        <button type="button" data-value="large">{L('Besar', 'Large', '大', 'பெரிய', '大', '크게', 'ใหญ่', 'Lớn', 'Besar', 'كبير', 'बड़ा', 'Grande')}</button>
        <button type="button" data-value="xlarge">{L('Sangat besar', 'X-Large', '特大', 'மிகப் பெரிய', '特大', '아주 크게', 'ใหญ่พิเศษ', 'Rất lớn', 'Sangat besar', 'كبير جدًا', 'अति बड़ा', 'Extra grande')}</button>
      </div>
    </div>
  </section>

  <!-- 4. Card display -->
  <section class="set-card">
    <h2>{L('Paparan kad', 'Card display', '卡片显示', 'அட்டை காட்சி', 'カード表示', '카드 표시', 'การแสดงการ์ด', 'Hiển thị thẻ', 'Tampilan kartu', 'عرض البطاقات', 'कार्ड प्रदर्शन', 'Visualización de tarjetas')}</h2>
    <p class="note">
      {L(
        'Baris maklumat untuk dipaparkan pada kad artikel dalam senarai.',
        'Which information rows show on article cards in listings.',
        '文章卡片在列表中显示哪些信息行。',
        'பட்டியல்களில் கட்டுரை அட்டைகளில் எந்தத் தகவல் வரிசைகள் காண்பிக்கப்படுகின்றன.',
        '一覧の記事カードに表示する情報行を選びます。',
        '목록의 기사 카드에 표시할 정보 행을 선택합니다.',
        'แถวข้อมูลที่จะแสดงบนการ์ดบทความในรายการ',
        'Các hàng thông tin hiển thị trên thẻ bài viết trong danh sách.',
        'Baris informasi yang ditampilkan pada kartu artikel dalam daftar.',
        'صفوف المعلومات التي تظهر على بطاقات المقالات في القوائم.',
        'सूचियों में लेख कार्ड पर कौन-सी सूचना पंक्तियाँ दिखाई देती हैं।',
        'Qué filas de información se muestran en las tarjetas de artículos en los listados.',
      )}
    </p>
    <div class="opts" data-group="rows">
      <label class="opt"><input type="checkbox" value="path" /><span>{L('Laluan', 'Path', '路径', 'பாதை', 'パス', '경로', 'เส้นทาง', 'Đường dẫn', 'Jalur', 'المسار', 'पथ', 'Ruta')}</span></label>
      <label class="opt"><input type="checkbox" value="details" /><span>{L('Butiran', 'Details', '详情', 'விவரங்கள்', '詳細', '세부 정보', 'รายละเอียด', 'Chi tiết', 'Rincian', 'التفاصيل', 'विवरण', 'Detalles')}</span></label>
      <label class="opt"><input type="checkbox" value="custody" /><span>{L('Status', 'Status', '状态', 'நிலை', 'ステータス', '상태', 'สถานะ', 'Trạng thái', 'Status', 'الحالة', 'स्थिति', 'Estado')}</span></label>
      <label class="opt"><input type="checkbox" value="visitors" /><span>{L('Pelawat', 'Visitors', '访客', 'பார்வையாளர்கள்', '訪問者', '방문자', 'ผู้เยี่ยมชม', 'Khách truy cập', 'Pengunjung', 'الزوّار', 'आगंतुक', 'Visitantes')}</span></label>
    </div>
  </section>

  <!-- 5. Welcome tour -->
  <section class="set-card">
    <h2>{L('Panduan aluan', 'Welcome tour', '欢迎导览', 'வரவேற்பு சுற்றுலா', 'ようこそツアー', '환영 둘러보기', 'ทัวร์ต้อนรับ', 'Hướng dẫn chào mừng', 'Tur selamat datang', 'جولة الترحيب', 'स्वागत भ्रमण', 'Recorrido de bienvenida')}</h2>
    <div class="opts" data-group="welcome">
      <label class="opt"><input type="checkbox" id="set-welcome-cb" /><span>{L(
        'Tunjukkan kad aluan "Mula di sini" di laman utama',
        'Show the "Start here" welcome card on the home page',
        '在首页显示“从这里开始”欢迎卡片',
        'முகப்புப் பக்கத்தில் "இங்கே தொடங்குங்கள்" வரவேற்பு அட்டையைக் காட்டு',
        'ホームページに「ここから始める」ウェルカムカードを表示',
        '홈페이지에 "여기서 시작하기" 환영 카드 표시',
        'แสดงการ์ดต้อนรับ "เริ่มต้นที่นี่" บนหน้าแรก',
        'Hiển thị thẻ chào mừng "Bắt đầu tại đây" trên trang chủ',
        'Tampilkan kartu sambutan "Mulai di sini" di beranda',
        'أظهِر بطاقة الترحيب "ابدأ من هنا" على الصفحة الرئيسية',
        'मुख्य पृष्ठ पर "यहाँ से शुरू करें" स्वागत कार्ड दिखाएँ',
        'Mostrar la tarjeta de bienvenida "Empieza aquí" en la página principal',
      )}</span></label>
    </div>
  </section>

  <div class="actions">
    <button type="button" id="set-done" class="btn btn-primary" data-home={localePath('/', locale)}>{L('Simpan', 'Save', '保存', 'சேமி', '保存', '저장', 'บันทึก', 'Lưu', 'Simpan', 'حفظ', 'सहेजें', 'Guardar')}</button>
    <button type="button" id="set-reset" class="reset">{L('Set semula semua', 'Reset all', '全部重置', 'அனைத்தையும் மீட்டமை', 'すべてリセット', '모두 초기화', 'รีเซ็ตทั้งหมด', 'Đặt lại tất cả', 'Setel ulang semua', 'إعادة ضبط الكل', 'सभी रीसेट करें', 'Restablecer todo')}</button>
    <span id="set-saved" class="saved" hidden>{L('Disimpan', 'Saved', '已保存', 'சேமிக்கப்பட்டது', '保存しました', '저장됨', 'บันทึกแล้ว', 'Đã lưu', 'Tersimpan', 'تم الحفظ', 'सहेजा गया', 'Guardado')}</span>
  </div>
</div>

<script>
  const root = document.documentElement;
  const el = document.getElementById('settings');
  const savedFlag = document.getElementById('set-saved');
  const get = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const set = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} flash(); };
  const del = (k: string) => { try { localStorage.removeItem(k); } catch {} };
  let flashT: any;
  const flash = () => { if (!savedFlag) return; savedFlag.hidden = false; clearTimeout(flashT); flashT = setTimeout(() => (savedFlag.hidden = true), 1200); };

  if (el) {
    const setRaw = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
    const NONDEFAULT = ['en', 'zh', 'ta', 'ja', 'ko', 'th', 'vi', 'id'];

    // Remember where the visitor came FROM, captured on load (not at Save time,
    // since changing language navigates and loses the referrer). Only an in-site
    // (same-origin) page is stored; an off-site referrer clears it → Save goes home.
    const RETURN_KEY = 'nk:settings-return';
    try {
      const ref = document.referrer;
      const here = location.pathname.replace(/\/+$/, '');
      if (ref) {
        const u = new URL(ref);
        if (u.origin !== location.origin) sessionStorage.removeItem(RETURN_KEY);
        else if (u.pathname.replace(/\/+$/, '') !== here) sessionStorage.setItem(RETURN_KEY, u.pathname);
        // else: reloaded Settings itself → keep whatever was stored
      }
    } catch {}

    // Strip a leading locale prefix → bare path; then re-add the chosen locale.
    const delocalize = (path: string) => {
      const segs = path.split('/').filter(Boolean);
      if (segs.length && NONDEFAULT.includes(segs[0])) return '/' + segs.slice(1).join('/');
      return path.startsWith('/') ? path : '/' + path;
    };
    const relocalize = (bare: string, loc: string) => {
      const clean = !bare || bare === '/' ? '/' : bare.startsWith('/') ? bare : '/' + bare;
      if (loc === 'ms') return clean;
      return clean === '/' ? '/' + loc : '/' + loc + clean;
    };

    // --- Default language (nk-default-lang) — BUFFERED, applied on Save ---
    const dl = get('nk-default-lang') || 'auto';
    el.querySelectorAll<HTMLInputElement>('[data-group="lang"] input').forEach((r) => {
      r.checked = r.value === dl;
    });

    // --- Reading: text size — LIVE (instant preview, the one exception) ---
    const seg = (group: string, key: string, dataAttr: string, dflt: string) => {
      const cur = root.getAttribute(dataAttr) || dflt;
      const btns = el.querySelectorAll<HTMLElement>(`[data-group="${group}"] button`);
      btns.forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.value === cur));
        b.addEventListener('click', () => {
          const v = b.dataset.value!;
          if (v === dflt) root.removeAttribute(dataAttr); else root.setAttribute(dataAttr, v);
          set(key, v);
          btns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.value === v)));
        });
      });
    };
    seg('size', 'nk-text-size', 'data-text-size', 'standard');

    // --- Card rows (nk-card-rows-hidden = HIDDEN keys) — BUFFERED, applied on Save ---
    const ALL_ROWS = ['path', 'details', 'custody', 'visitors'];
    const readHidden = () => { try { const v = JSON.parse(get('nk-card-rows-hidden') || '[]'); return Array.isArray(v) ? v : []; } catch { return []; } };
    // Default (no key yet) matches ArticleList: all rows hidden by default.
    const rowsInit = get('nk-card-rows-hidden') === null ? ALL_ROWS.slice() : readHidden();
    el.querySelectorAll<HTMLInputElement>('[data-group="rows"] input').forEach((b) => {
      b.checked = !rowsInit.includes(b.value); // checked = shown
    });

    // --- Welcome card toggle (nk:welcomed = '1' means dismissed) — BUFFERED ---
    const welcomeCb = document.getElementById('set-welcome-cb') as HTMLInputElement | null;
    if (welcomeCb) welcomeCb.checked = get('nk:welcomed') !== '1';

    // --- Reset all (clears everything + reloads) ---
    document.getElementById('set-reset')?.addEventListener('click', () => {
      ['nk-visible-status', 'nk-default-lang', 'nk-theme', 'nk-text-size', 'nk-card-rows-hidden', 'nk:welcomed'].forEach(del);
      try { sessionStorage.removeItem('nk-lang-redirected'); } catch {}
      root.removeAttribute('data-text-size');
      root.removeAttribute('data-welcomed');
      flash();
      setTimeout(() => location.reload(), 300);
    });

    // --- Save: commit the buffered choices, then return to the previous page
    // (re-localized to the chosen language when one was picked). ---
    const doneBtn = document.getElementById('set-done');
    doneBtn?.addEventListener('click', () => {
      // 1. default language
      const sel = (el.querySelector('[data-group="lang"] input:checked') as HTMLInputElement | null)?.value || 'auto';
      if (sel === 'auto') del('nk-default-lang'); else setRaw('nk-default-lang', sel);
      // 2. card rows
      const h = ALL_ROWS.filter((r) => !(el.querySelector(`[data-group="rows"] input[value="${r}"]`) as HTMLInputElement | null)?.checked);
      setRaw('nk-card-rows-hidden', JSON.stringify(h));
      // 3. welcome card
      if (welcomeCb && !welcomeCb.checked) setRaw('nk:welcomed', '1'); else del('nk:welcomed');
      // A fresh default-language choice should take effect even in this session.
      try { sessionStorage.removeItem('nk-lang-redirected'); } catch {}

      // 4. return to the previous in-site page, re-localized if a language was chosen
      let ret: string | null = null;
      try { ret = sessionStorage.getItem(RETURN_KEY); } catch {}
      let target: string;
      if (sel === 'auto') {
        target = ret || (doneBtn.getAttribute('data-home') || '/');
      } else {
        target = relocalize(ret ? delocalize(ret) : '/', sel);
      }
      try { sessionStorage.removeItem(RETURN_KEY); } catch {}
      location.href = target;
    });
  }
</script>

<style>
  .settings { max-width: var(--container-page, 68rem); margin: 0 auto; padding: 2rem 1.25rem 4rem; display: grid; gap: 1.25rem; }
  .set-card { border: 1px solid var(--line); border-radius: 14px; background: var(--surface); padding: 1.25rem 1.4rem; }
  .set-card h2 { font-size: 1.05rem; margin: 0 0 0.5rem; }
  .note { color: var(--muted); font-size: 0.85rem; line-height: 1.6; margin: 0 0 0.9rem; }
  .opts { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  .opt { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; cursor: pointer; }
  .opt.locked { opacity: 0.75; cursor: default; }
  .opt input { width: 1rem; height: 1rem; accent-color: var(--gold); }
  .row { display: flex; align-items: center; gap: 1rem; padding: 0.5rem 0; flex-wrap: wrap; }
  .row-label { min-width: 7rem; font-size: 0.85rem; color: var(--ink-soft); }
  .seg { display: inline-flex; gap: 0.3rem; }
  .seg button { padding: 0.4rem 0.75rem; font-size: 0.85rem; font-weight: 600; border: 1px solid color-mix(in srgb, var(--gold) 55%, var(--line)); border-radius: 8px; background: var(--bg); color: var(--ink-soft); cursor: pointer; }
  .seg button:not([aria-pressed='true']):hover { border-color: var(--gold); background: color-mix(in srgb, var(--gold) 10%, var(--surface)); }
