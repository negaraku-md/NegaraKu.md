---
import type { Locale } from '@/lib/categories';
import { localePath } from '@/lib/i18n';
import { TIMELINE } from '@/lib/timeline';
import PageHero from './PageHero.astro';

// Timeline of Malaysia — a dedicated, non-list view: an era-grouped vertical
// spine with a marker per milestone. Content lives in src/lib/timeline.ts.

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

const eraCount = TIMELINE.length;
const eventCount = TIMELINE.reduce((n, e) => n + e.events.length, 0);
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页'), href: localePath('/', locale) },
    { label: L('Garis Masa', 'Timeline', '时间线') },
  ]}
  title={L('Garis Masa Malaysia', 'Timeline of Malaysia', '马来西亚时间线')}
  desc={L(
    'Kisah Malaysia dalam satu garis masa — daripada Kesultanan Melaka hingga hari ini.',
    "Malaysia's story on a single timeline — from the Melaka Sultanate to today.",
    '一条时间线看马来西亚——从马六甲苏丹国到今天。',
  )}
  stats={[
    { value: eraCount, label: L('era', 'eras', '时代') },
    { value: eventCount, label: L('peristiwa', 'milestones', '里程碑') },
    { value: '600+', label: L('tahun', 'years', '年') },
  ]}
/>

<section class="container block">
  <div class="tl">
    {
      TIMELINE.map((era) => (
        <section class="era" aria-label={era.name[locale]}>
          <header class="era-head">
            <h2>{era.name[locale]}</h2>
            <span class="era-range">{era.range}</span>
          </header>
          <ol class="events">
            {era.events.map((ev) => (
              <li class:list={['ev', { sensitive: ev.sensitive }]}>
                <div class="ev-card">
                  <div class="ev-year">{ev.year}</div>
                  <h3 class="ev-title">{ev.title[locale]}</h3>
                  <p class="ev-blurb">{ev.blurb[locale]}</p>
                  {ev.sensitive && (
                    <p class="ev-flag">
                      {L('Topik sensitif — dikendalikan dengan berhati-hati.', 'Sensitive topic — handled with care.', '敏感议题——谨慎处理。')}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>

  <p class="tl-note">
    {L(
      'Garis masa ringkas ini menandakan peristiwa penting yang didokumentasikan secara meluas. Untuk perincian dan sumber, rujuk artikel berkaitan dalam pangkalan pengetahuan.',
      'This concise timeline marks widely-documented milestones. For detail and sources, see the related articles in the knowledge base.',
      '此简明时间线标示广受记载的重要事件。欲了解细节与出处，请参阅知识库中的相关文章。',
    )}
  </p>
</section>

<style>
  .tl {
    max-width: 760px;
    margin: 0 auto;
  }
  .era {
    margin: 0 0 2.2rem;
  }
  .era-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 1rem;
  }
  .era-head h2 {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: var(--title-subsection-size);
    margin: 0;
  }
  .era-range {
    font-family: var(--font-interface);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  /* Vertical spine + markers */
  .events {
    list-style: none;
    margin: 0;
    padding: 0 0 0 28px;
    position: relative;
  }
  .events::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: linear-gradient(180deg, var(--gold), color-mix(in srgb, var(--gold) 15%, transparent));
  }
  .ev {
    position: relative;
    margin: 0 0 0.9rem;
  }
  .ev::before {
    content: '';
    position: absolute;
    left: -27px;
    top: 1.1rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--gold);
    border: 3px solid var(--bg);
  }
  .ev-card {
    background: var(--surface);
    border: 1px solid color-mix(in srgb, var(--ink) 22%, var(--line));
    border-radius: 12px;
    padding: 0.85rem 1.05rem;
  }
  .ev-year {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--gold);
    letter-spacing: 0.01em;
    margin-bottom: 0.15rem;
  }
  .ev-title {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 1.02rem;
    line-height: 1.25;
    margin: 0 0 0.3rem;
    color: var(--ink);
  }
  .ev-blurb {
    font-family: var(--font-reading);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0;
  }
  .ev-flag {
    margin: 0.5rem 0 0;
    font-family: var(--font-interface);
    font-size: 0.76rem;
    color: var(--amber);
  }
  .ev.sensitive .ev-card {
    border-color: color-mix(in srgb, var(--amber) 45%, var(--line));
  }

  .tl-note {
    max-width: 760px;
    margin: 1.5rem auto 0;
    font-family: var(--font-interface);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 520px) {
    .ev-title {
      font-size: 0.98rem;
    }
    .ev-blurb {
      font-size: 0.9rem;
    }
  }
</style>
