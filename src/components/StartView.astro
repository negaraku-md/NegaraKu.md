---
import type { Locale } from '@/lib/categories';
import { PILLARS, getPillarColor, loc } from '@/lib/categories';
import { localePath, LOCALES } from '@/lib/i18n';
import PageHero from './PageHero.astro';
import BecomeContributor from './BecomeContributor.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string) => (locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

// Live language count — never hard-code "three"/"nine" in prose again.
const nLang = LOCALES.length;

// Concrete, high-intent starting points (real published articles, one per pillar
// + a daily-life glossary term) so a newcomer immediately sees something relevant.
const starts = [
  { icon: '🏢', href: '/business/business-structures-malaysia', label: L('Mulakan perniagaan', 'Starting a business', '创业', 'வணிகம் தொடங்குதல்', 'ビジネスを始める', '사업 시작하기', 'เริ่มต้นธุรกิจ', 'Khởi nghiệp', 'Memulai bisnis') },
  { icon: '🏛️', href: '/government/parliament', label: L('Cara Malaysia ditadbir', 'How Malaysia is governed', '马来西亚如何治理', 'மலேசியா எப்படி ஆளப்படுகிறது', 'マレーシアの統治', '말레이시아의 통치 방식', 'มาเลเซียปกครองอย่างไร', 'Malaysia được quản trị thế nào', 'Bagaimana Malaysia diperintah') },
  { icon: '🪪', href: '/glossary/mykad', label: L('MyKad & identiti', 'MyKad & identity', 'MyKad 与身份', 'MyKad & அடையாளம்', 'MyKad と身分証', 'MyKad와 신분', 'MyKad และตัวตน', 'MyKad & danh tính', 'MyKad & identitas') },
  { icon: '🚓', href: '/public-safety/how-to-report-a-crime-malaysia', label: L('Buat laporan polis', 'Make a police report', '报案', 'காவல் புகார் செய்தல்', '警察への届け出', '경찰 신고하기', 'แจ้งความตำรวจ', 'Trình báo công an', 'Membuat laporan polisi') },
];

// Step-by-step mini-guides — the practical "How to use it" section.
const guides = [
  {
    icon: '🔍',
    title: L('Cari sesuatu', 'Find something', '查找内容', 'ஏதேனும் தேடுங்கள்', '何かを探す', '무언가 찾기', 'ค้นหาบางสิ่ง', 'Tìm một điều gì đó', 'Cari sesuatu'),
    steps: [
      L('Tekan “/” pada papan kekunci, atau ketik ikon carian di bar atas.', 'Press “/” on your keyboard, or tap the search icon in the top bar.', '按键盘上的“/”，或点击顶栏的搜索图标。', 'உங்கள் விசைப்பலகையில் “/” அழுத்துங்கள், அல்லது மேல் பட்டியில் உள்ள தேடல் சின்னத்தைத் தட்டுங்கள்.', 'キーボードで「/」を押すか、上部バーの検索アイコンをタップします。', '키보드에서 “/”를 누르거나, 상단 바의 검색 아이콘을 탭하세요.', 'กด “/” บนแป้นพิมพ์ หรือแตะไอคอนค้นหาในแถบด้านบน', 'Nhấn “/” trên bàn phím, hoặc chạm vào biểu tượng tìm kiếm ở thanh trên cùng.', 'Tekan “/” pada papan ketik, atau ketuk ikon pencarian di bilah atas.'),
      L('Taip nama orang, tempat atau peristiwa — carian sepadan semasa anda menaip.', 'Type a person, place, or event — it matches as you type.', '输入人物、地点或事件——边输入边匹配。', 'ஒரு நபர், இடம் அல்லது நிகழ்வைத் தட்டச்சு செய்யுங்கள் — நீங்கள் தட்டச்சு செய்யும்போதே அது பொருந்தும்.', '人物、場所、または出来事を入力すると、入力に応じて一致します。', '인물, 장소 또는 사건을 입력하세요 — 입력하는 동안 바로 일치 결과가 나타납니다.', 'พิมพ์ชื่อบุคคล สถานที่ หรือเหตุการณ์ — ระบบจะจับคู่ผลลัพธ์ขณะที่คุณพิมพ์', 'Nhập tên một người, địa điểm hoặc sự kiện — kết quả khớp ngay khi bạn gõ.', 'Ketik nama orang, tempat atau peristiwa — hasilnya cocok saat Anda mengetik.'),
      L('Buka mana-mana hasil untuk membaca artikel penuh.', 'Open any result to read the full article.', '打开任意结果即可阅读全文。', 'முழு கட்டுரையையும் படிக்க எந்த முடிவையும் திறங்கள்.', 'いずれかの結果を開いて記事全文を読みます。', '전체 기사를 읽으려면 아무 결과나 여세요.', 'เปิดผลลัพธ์ใดก็ได้เพื่ออ่านบทความฉบับเต็ม', 'Mở bất kỳ kết quả nào để đọc toàn văn bài viết.', 'Buka hasil mana pun untuk membaca artikel lengkap.'),
    ],
  },
  {
    icon: '📖',
    title: L('Baca dan petik', 'Read and cite', '阅读与引用', 'படித்து மேற்கோள் காட்டுங்கள்', '読んで引用する', '읽고 인용하기', 'อ่านและอ้างอิง', 'Đọc và trích dẫn', 'Baca dan kutip'),
    steps: [
      L('Buka artikel daripada tonggak, kategori atau carian.', 'Open an article from a pillar, category, or search.', '从支柱、分类或搜索打开文章。', 'ஒரு தூண், வகை அல்லது தேடலில் இருந்து ஒரு கட்டுரையைத் திறங்கள்.', '柱、カテゴリ、または検索から記事を開きます。', '기둥, 카테고리 또는 검색에서 기사를 여세요.', 'เปิดบทความจากเสาหลัก หมวดหมู่ หรือการค้นหา', 'Mở một bài viết từ trụ cột, danh mục hoặc tìm kiếm.', 'Buka artikel dari pilar, kategori atau pencarian.'),
      L('Tatal ke bahagian “Sumber” di hujung — setiap fakta membawa rujukannya.', 'Scroll to the “Sources” at the foot — every fact carries its reference.', '滚动到末尾的“来源”——每条事实都附有引用。', 'அடிப்பகுதியில் உள்ள “ஆதாரங்கள்” வரை உருட்டுங்கள் — ஒவ்வொரு உண்மையும் அதன் குறிப்பைக் கொண்டுள்ளது.', '末尾の「出典」までスクロールします — すべての事実に参照元があります。', '하단의 “출처”까지 스크롤하세요 — 모든 사실에는 참고 자료가 있습니다.', 'เลื่อนไปที่ส่วน “แหล่งที่มา” ท้ายบทความ — ทุกข้อเท็จจริงจะมีการอ้างอิงกำกับ', 'Cuộn xuống phần “Nguồn” ở cuối bài — mỗi dữ kiện đều kèm theo tài liệu tham khảo của nó.', 'Gulir ke bagian “Sumber” di bawah — setiap fakta menyertakan rujukannya.'),
      L('Ikuti pautan sumber untuk mengesahkan sendiri.', 'Follow a source link to verify it yourself.', '点击来源链接自行查证。', 'நீங்களே சரிபார்க்க ஒரு ஆதாரச் சுட்டியைப் பின்தொடருங்கள்.', '出典リンクをたどって自分で確認します。', '직접 확인하려면 출처 링크를 따라가세요.', 'ตามลิงก์แหล่งที่มาเพื่อตรวจสอบด้วยตนเอง', 'Theo liên kết nguồn để tự mình xác minh.', 'Ikuti tautan sumber untuk memverifikasinya sendiri.'),
    ],
  },
  {
    icon: '🤖',
    title: L('Guna dengan AI anda', 'Use with your AI', '配合你的 AI 使用', 'உங்கள் AI உடன் பயன்படுத்துங்கள்', 'お使いの AI で使う', '당신의 AI와 함께 사용', 'ใช้กับ AI ของคุณ', 'Dùng với AI của bạn', 'Gunakan dengan AI Anda'),
    steps: [
      L('Buka mana-mana artikel, kemudian “Salin Markdown” — atau tambah .md pada URLnya.', 'Open any article, then “Copy Markdown” — or append .md to its URL.', '打开任意文章，点击“复制 Markdown”——或在其网址后追加 .md。', 'எந்த கட்டுரையையும் திறந்து “Markdown நகலெடு” — அல்லது அதன் URL-ல் .md சேர்க்கவும்.', '任意の記事を開き「Markdown をコピー」— または URL に .md を付けます。', '아무 기사나 열고 “Markdown 복사” — 또는 URL에 .md를 붙이세요.', 'เปิดบทความใดก็ได้ แล้ว “คัดลอก Markdown” — หรือเพิ่ม .md ต่อท้าย URL', 'Mở bất kỳ bài viết nào, rồi “Sao chép Markdown” — hoặc thêm .md vào URL.', 'Buka artikel mana pun, lalu “Salin Markdown” — atau tambahkan .md ke URL-nya.'),
      L('Tampalnya ke dalam alat AI anda — ia Markdown bersih yang berpetikan sumber.', 'Paste it into your AI tool — it is clean, sourced Markdown.', '粘贴到你的 AI 工具中——它是干净、注明来源的 Markdown。', 'அதை உங்கள் AI கருவியில் ஒட்டுங்கள் — இது சுத்தமான, ஆதாரம் காட்டப்பட்ட Markdown.', 'お使いの AI ツールに貼り付けます — 出典付きのクリーンな Markdown です。', '당신의 AI 도구에 붙여넣으세요 — 출처가 있는 깔끔한 Markdown입니다.', 'วางลงในเครื่องมือ AI ของคุณ — เป็น Markdown ที่สะอาดและมีแหล่งอ้างอิง', 'Dán vào công cụ AI của bạn — đó là Markdown sạch, có dẫn nguồn.', 'Tempel ke alat AI Anda — Markdown bersih yang bersumber.'),
      L('Untuk korpus penuh, lihat halaman Untuk AI (llms.txt).', 'For the whole corpus, see the For AI page (llms.txt).', '若需完整语料，请查看“面向 AI”页面（llms.txt）。', 'முழு கார்பஸுக்கு, “AI-க்கு” பக்கத்தைப் (llms.txt) பார்க்கவும்.', '全コーパスは「AI 向け」ページ（llms.txt）をご覧ください。', '전체 코퍼스는 “AI를 위해” 페이지(llms.txt)를 참고하세요.', 'สำหรับคลังข้อความทั้งหมด ดูหน้า “สำหรับ AI” (llms.txt)', 'Để xem toàn bộ kho văn bản, hãy xem trang “Dành cho AI” (llms.txt).', 'Untuk korpus lengkap, lihat halaman Untuk AI (llms.txt).'),
    ],
  },
  {
    icon: '✍️',
    title: L('Cadangkan perubahan', 'Suggest a change', '建议修改', 'மாற்றத்தைப் பரிந்துரையுங்கள்', '変更を提案する', '변경 제안하기', 'เสนอการเปลี่ยนแปลง', 'Đề xuất một thay đổi', 'Sarankan perubahan'),
    steps: [
      L('Di hujung mana-mana artikel, cari pautan “Sunting / Lapor”.', 'At the foot of any article, find the “Edit / Report” link.', '在任意文章末尾，找到“编辑 / 报告”链接。', 'எந்த கட்டுரையின் அடிப்பகுதியிலும், “திருத்து / புகாரளி” சுட்டியைக் கண்டறியுங்கள்.', 'いずれかの記事の末尾で「編集 / 報告」リンクを見つけます。', '아무 기사 하단에서 “편집 / 신고” 링크를 찾으세요.', 'ที่ท้ายบทความใดก็ตาม ให้มองหาลิงก์ “แก้ไข / รายงาน”', 'Ở cuối bất kỳ bài viết nào, hãy tìm liên kết “Chỉnh sửa / Báo cáo”.', 'Di bagian bawah artikel mana pun, temukan tautan “Sunting / Laporkan”.'),
      L('Ia membuka GitHub, tempat setiap perubahan disemak secara terbuka.', 'It opens GitHub, where every change is reviewed in the open.', '它会打开 GitHub，每处改动都在此公开审阅。', 'இது GitHub-ஐத் திறக்கிறது, அங்கு ஒவ்வொரு மாற்றமும் வெளிப்படையாக மறுஆய்வு செய்யப்படுகிறது.', 'GitHub が開き、そこですべての変更が公開の場で審査されます。', 'GitHub가 열리며, 그곳에서 모든 변경 사항이 공개적으로 검토됩니다.', 'ลิงก์นี้จะเปิด GitHub ซึ่งเป็นที่ที่ทุกการเปลี่ยนแปลงได้รับการตรวจทานอย่างเปิดเผย', 'Nó sẽ mở GitHub, nơi mọi thay đổi được rà soát một cách công khai.', 'Ini membuka GitHub, tempat setiap perubahan ditinjau secara terbuka.'),
      L('Tiada akaun GitHub? Anda masih boleh membaca segalanya — ini pilihan sahaja.', 'No GitHub account? You can still read everything — this is optional.', '没有 GitHub 账户？你仍可阅读一切——这是可选的。', 'GitHub கணக்கு இல்லையா? நீங்கள் இன்னும் எல்லாவற்றையும் படிக்கலாம் — இது விருப்பத்தேர்வு மட்டுமே.', 'GitHub アカウントがなくても、すべて読めます — これは任意です。', 'GitHub 계정이 없으신가요? 그래도 모든 것을 읽을 수 있습니다 — 이것은 선택 사항입니다.', 'ไม่มีบัญชี GitHub? คุณยังคงอ่านทุกอย่างได้ — สิ่งนี้เป็นทางเลือกเท่านั้น', 'Không có tài khoản GitHub? Bạn vẫn có thể đọc mọi thứ — đây chỉ là tùy chọn.', 'Tidak punya akun GitHub? Anda tetap bisa membaca semuanya — ini bersifat opsional.'),
    ],
  },
];
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム', '홈', 'หน้าแรก', 'Trang chủ', 'Beranda'), href: localePath('/', locale) },
    { label: L('Mula di sini', 'Start here', '从这里开始', 'இங்கே தொடங்குங்கள்', 'ここから始める', '여기서 시작', 'เริ่มต้นที่นี่', 'Bắt đầu tại đây', 'Mulai di sini') },
  ]}
  title={L('Mula di sini', 'Start here', '从这里开始', 'இங்கே தொடங்குங்கள்', 'ここから始める', '여기서 시작', 'เริ่มต้นที่นี่', 'Bắt đầu tại đây', 'Mulai di sini')}
  desc={L(
    'Titik permulaan anda untuk memahami Malaysia — panduan bersumber dan mudah difahami tentang rakyat, institusi, kehidupan harian dan perniagaannya, dibina untuk manusia dan AI. Inilah cara mencari jalan anda.',
    'Your starting point for understanding Malaysia — sourced, plain-language guides to its people, institutions, daily life and business, built for people and AI. Here is how to find your way around.',
    '你认识马来西亚的起点——关于其人民、制度、日常生活与商业的注明来源、通俗易懂的指南，为人类与 AI 而建。下面教你如何上手。',
    'மலேசியாவைப் புரிந்துகொள்ள உங்கள் தொடக்கப் புள்ளி — அதன் மக்கள், நிறுவனங்கள், அன்றாட வாழ்க்கை மற்றும் வணிகம் குறித்த ஆதாரம் காட்டப்பட்ட, எளிய மொழி வழிகாட்டிகள், மனிதர்களுக்கும் AI-க்கும் கட்டமைக்கப்பட்டவை. வழியைக் கண்டறிவது இப்படி.',
    'マレーシアを理解するための出発点 — その人々、制度、日常生活、ビジネスに関する、出典付きでわかりやすいガイド。人にも AI にも使えるように作られています。使い方は以下のとおりです。',
    '말레이시아를 이해하기 위한 출발점 — 사람, 제도, 일상, 비즈니스에 대한 출처 기반의 쉬운 안내서로, 사람과 AI 모두를 위해 만들어졌습니다. 이용 방법은 아래와 같습니다.',
    'จุดเริ่มต้นของคุณในการทำความเข้าใจมาเลเซีย — คู่มือที่อ้างอิงแหล่งที่มาและเข้าใจง่ายเกี่ยวกับผู้คน สถาบัน ชีวิตประจำวัน และธุรกิจ สร้างขึ้นสำหรับทั้งคนและ AI นี่คือวิธีเริ่มต้นใช้งาน',
    'Điểm khởi đầu của bạn để hiểu Malaysia — những hướng dẫn có dẫn nguồn, dễ hiểu về con người, thể chế, đời sống hằng ngày và kinh doanh, được xây dựng cho cả con người lẫn AI. Đây là cách để bắt đầu.',
    'Titik awal Anda untuk memahami Malaysia — panduan bersumber dan mudah dipahami tentang rakyat, institusi, kehidupan sehari-hari, dan bisnisnya, dibangun untuk manusia dan AI. Berikut cara menjelajahinya.',
  )}
/>

<nav class="start-cta container" aria-label={L('Mula pantas', 'Quick start', '快速开始', 'விரைவுத் தொடக்கம்', 'クイックスタート', '빠른 시작', 'เริ่มอย่างรวดเร็ว', 'Bắt đầu nhanh', 'Mulai cepat')}>
  <a class="cta-btn cta-primary" href={localePath('/search', locale)}><span aria-hidden="true">🔍</span> {L('Cari Malaysia', 'Search Malaysia', '搜索马来西亚', 'மலேசியாவைத் தேடு', 'マレーシアを検索', '말레이시아 검색', 'ค้นหามาเลเซีย', 'Tìm kiếm Malaysia', 'Cari Malaysia')}</a>
