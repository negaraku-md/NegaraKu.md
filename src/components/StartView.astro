<!-- 1. The two-way choice -->
<section class="container block">
  <div class="twopath">
    <a class="tpcard tp-explore" href="#explore">
      <span class="tpico" aria-hidden="true">🧭</span>
      <span class="tptag">{L('Untuk pembaca', 'For readers', '面向读者', 'வாசகர்களுக்கு', '読者向け', '독자용', 'สำหรับผู้อ่าน', 'Dành cho người đọc', 'Untuk pembaca')}</span>
      <b>{L('Terokai Malaysia', 'Explore Malaysia', '探索马来西亚', 'மலேசியாவை ஆராயுங்கள்', 'マレーシアを探索', '말레이시아 탐색', 'สำรวจมาเลเซีย', 'Khám phá Malaysia', 'Jelajahi Malaysia')}</b>
      <p>{L('Baca panduan bersumber tentang cara negara ini berfungsi — untuk manusia dan AI.', 'Read sourced guides on how the country works — for people and AI.', '阅读关于这个国家如何运作的注明来源指南——为人类与 AI 打造。', 'நாடு எப்படி இயங்குகிறது என்பதைப் பற்றிய ஆதாரம் காட்டப்பட்ட வழிகாட்டிகளைப் படியுங்கள் — மனிதர்களுக்கும் AI-க்கும்.', 'この国の仕組みを出典付きガイドで読む — 人にも AI にも。', '이 나라가 어떻게 돌아가는지 출처 기반 안내서로 읽으세요 — 사람과 AI를 위해.', 'อ่านคู่มือที่มีแหล่งอ้างอิงว่าประเทศนี้ทำงานอย่างไร — สำหรับคนและ AI', 'Đọc các hướng dẫn có nguồn về cách đất nước vận hành — cho con người và AI.', 'Baca panduan bersumber tentang cara negara ini bekerja — untuk manusia dan AI.')}</p>
      <span class="tpgo">{L('Terokai', 'Explore', '探索', 'ஆராயுங்கள்', '探索', '탐색', 'สำรวจ', 'Khám phá', 'Jelajahi')} →</span>
    </a>
    <a class="tpcard tp-contribute" href="#contribute">
      <span class="tpico" aria-hidden="true">✍️</span>
      <span class="tptag">{L('Untuk penyumbang', 'For contributors', '面向贡献者', 'பங்களிப்பாளர்களுக்கு', '貢献者向け', '기여자용', 'สำหรับผู้มีส่วนร่วม', 'Dành cho người đóng góp', 'Untuk kontributor')}</span>
      <b>{L('Sumbang kepada Malaysia', 'Contribute to Malaysia', '为马来西亚做贡献', 'மலேசியாவுக்குப் பங்களியுங்கள்', 'マレーシアに貢献', '말레이시아에 기여', 'มีส่วนร่วมกับมาเลเซีย', 'Đóng góp cho Malaysia', 'Berkontribusi untuk Malaysia')}</b>
      <p>{L('Lapor, cadang, atau tulis artikel — terbuka untuk semua melalui GitHub.', 'Report, suggest, or write articles — open to everyone via GitHub.', '报告、建议或撰写文章——通过 GitHub 向所有人开放。', 'புகாரளியுங்கள், பரிந்துரையுங்கள், அல்லது கட்டுரைகளை எழுதுங்கள் — GitHub மூலம் அனைவருக்கும் திறந்தது.', '報告・提案・記事の執筆 — GitHub で誰でも参加可能。', '신고, 제안, 기사 작성 — GitHub로 누구나 참여 가능.', 'รายงาน เสนอแนะ หรือเขียนบทความ — เปิดสำหรับทุกคนผ่าน GitHub', 'Báo cáo, đề xuất, hoặc viết bài — mở cho tất cả qua GitHub.', 'Laporkan, sarankan, atau tulis artikel — terbuka untuk semua melalui GitHub.')}</p>
      <span class="tpgo">{L('Sumbang', 'Contribute', '贡献', 'பங்களியுங்கள்', '貢献', '기여', 'มีส่วนร่วม', 'Đóng góp', 'Berkontribusi')} →</span>
    </a>
  </div>
</section>

<!-- 2. EXPLORE — every way to read & discover -->
<section class="container block anchor" id="explore">
  <div class="psec">
    <header><span>🧭 {L('Terokai Malaysia', 'Explore Malaysia', '探索马来西亚', 'மலேசியாவை ஆராயுங்கள்', 'マレーシアを探索', '말레이시아 탐색', 'สำรวจมาเลเซีย', 'Khám phá Malaysia', 'Jelajahi Malaysia')}</span></header>
    <div class="psec-body">
      <p class="lead">{L('Cari sesuatu yang khusus, semak imbas mengikut tonggak, atau gunakan mana-mana alat di bawah.', 'Search for something specific, browse by pillar, or use any of the tools below.', '搜索具体内容、按支柱浏览，或使用下方任意工具。', 'குறிப்பிட்ட ஒன்றைத் தேடுங்கள், தூண்வாரியாக உலாவுங்கள், அல்லது கீழே உள்ள எந்தக் கருவியையும் பயன்படுத்துங்கள்.', '具体的に検索する、柱ごとに閲覧する、または下のツールを使う。', '구체적으로 검색하거나, 기둥별로 둘러보거나, 아래 도구를 사용하세요.', 'ค้นหาสิ่งที่เฉพาะเจาะจง เรียกดูตามเสาหลัก หรือใช้เครื่องมือด้านล่าง', 'Tìm điều gì đó cụ thể, duyệt theo trụ cột, hoặc dùng bất kỳ công cụ nào bên dưới.', 'Cari sesuatu yang spesifik, jelajahi berdasarkan pilar, atau gunakan alat di bawah.')}</p>

      <div class="search-row">
        <a class="cta-btn cta-primary" href={localePath('/search', locale)}><span aria-hidden="true">🔍</span> {t('nav.search', locale)} →</a>
      </div>
      <div class="chips">
        {chips.map((c) => (
          <a class="chip" href={`${localePath('/search', locale)}?q=${encodeURIComponent(c.q)}`}><span aria-hidden="true">🔍</span> {c.label}</a>
        ))}
      </div>

      <h3 class="subhead">{L('Semak imbas mengikut tonggak', 'Browse by pillar', '按支柱浏览', 'தூண்வாரியாக உலாவுங்கள்', '柱ごとに閲覧', '기둥별로 둘러보기', 'เรียกดูตามเสาหลัก', 'Duyệt theo trụ cột', 'Jelajahi berdasarkan pilar')}</h3>
      <div class="pillars">
        {PILLARS.map((p) => (
          <a class="pillar" href={localePath(`/${p.id}`, locale)} style={`--c:${getPillarColor(p.id)}`}>
            <span class="picon" aria-hidden="true">{p.icon}</span>
            <b>{loc(p.name, locale)}</b>
            <span class="pdesc">{loc(p.tagline, locale)}</span>
            <span class="pgo">{L('Terokai', 'Explore', '探索', 'ஆராயுங்கள்', '探索', '탐색', 'สำรวจ', 'Khám phá', 'Jelajahi')} →</span>
          </a>
        ))}
      </div>

      <h3 class="subhead">{L('Lebih banyak cara meneroka', 'More ways to explore', '更多探索方式', 'ஆராய மேலும் வழிகள்', 'さらに探索する方法', '더 둘러보는 방법', 'วิธีสำรวจเพิ่มเติม', 'Thêm cách khám phá', 'Cara lain menjelajah')}</h3>
      <div class="feat-grid">
        {exploreFeatures.map((f) => (
          <a class="feat" href={localePath(f.href, locale)} style={`--c:${f.color}`}>
