---
import type { Locale } from '@/lib/categories';
import { PILLARS, getPillarColor, loc } from '@/lib/categories';
import { localePath, t } from '@/lib/i18n';
import { REPO } from '@/lib/site';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string) => (locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

// Search example chips — each opens REAL results at /search?q=…
const chips = [
  { q: 'start a business', label: L('mulakan perniagaan', 'start a business', '创业', 'வணிகம் தொடங்கு', 'ビジネスを始める', '사업 시작', 'เริ่มธุรกิจ', 'khởi nghiệp', 'memulai bisnis') },
  { q: 'public transport', label: L('pengangkutan awam', 'public transport', '公共交通', 'பொதுப் போக்குவரத்து', '公共交通', '대중교통', 'ขนส่งสาธารณะ', 'giao thông công cộng', 'transportasi umum') },
  { q: 'government', label: L('kerajaan', 'government', '政府', 'அரசாங்கம்', '政府', '정부', 'รัฐบาล', 'chính phủ', 'pemerintahan') },
  { q: 'income tax', label: L('cukai pendapatan', 'income tax', '所得税', 'வருமான வரி', '所得税', '소득세', 'ภาษีเงินได้', 'thuế thu nhập', 'pajak penghasilan') },
];

// Every way to EXPLORE — the full set of discovery surfaces, mirroring the Explore
// & About menus so the launchpad and the dropdowns stay in step. Titles reuse the
// already-localized nav.* strings; only the one-line blurb is written here.
const exploreFeatures = [
  { key: 'nav.exploreMalaysia', href: '/explore', icon: '🧭', color: '#FFC000', blurb: L('Terbaharu, popular, dan setiap tonggak di satu tempat.', 'Latest, popular, and every pillar in one place.', '最新、热门与各支柱，尽在一处。', 'சமீபத்தியவை, பிரபலமானவை, ஒவ்வொரு தூணும் ஒரே இடத்தில்.', '最新・人気・すべての柱を一か所に。', '최신, 인기, 모든 기둥을 한곳에.', 'ล่าสุด ยอดนิยม และทุกเสาหลักในที่เดียว', 'Mới nhất, phổ biến, và mọi trụ cột ở một nơi.', 'Terbaru, populer, dan setiap pilar di satu tempat.') },
  { key: 'nav.categories', href: '/categories', icon: '🗂️', color: '#38BDF8', blurb: L('Indeks kategori penuh, A hingga Z.', 'The full category index, A to Z.', '完整分类索引，A 到 Z。', 'முழு வகை அட்டவணை, A முதல் Z வரை.', 'カテゴリー一覧を A〜Z で。', '전체 카테고리 색인, A부터 Z까지.', 'ดัชนีหมวดหมู่ทั้งหมด A ถึง Z', 'Toàn bộ mục lục danh mục, A đến Z.', 'Indeks kategori lengkap, A sampai Z.') },
  { key: 'nav.latest', href: '/latest', icon: '🆕', color: '#4ADE80', blurb: L('Artikel yang baharu ditambah dan dikemas kini.', 'Recently added and updated articles.', '最近新增与更新的文章。', 'சமீபத்தில் சேர்க்கப்பட்டு புதுப்பிக்கப்பட்ட கட்டுரைகள்.', '最近追加・更新された記事。', '최근 추가·업데이트된 기사.', 'บทความที่เพิ่มและอัปเดตล่าสุด', 'Các bài viết mới thêm và cập nhật.', 'Artikel yang baru ditambah dan diperbarui.') },
  { key: 'nav.trending', href: '/most-read', icon: '🔥', color: '#F97316', blurb: L('Apa yang paling kerap dibaca.', 'What readers open most.', '读者最常打开的内容。', 'வாசகர்கள் அதிகம் திறப்பவை.', '読者が最もよく開く記事。', '독자가 가장 많이 여는 글.', 'สิ่งที่ผู้อ่านเปิดมากที่สุด', 'Nội dung được đọc nhiều nhất.', 'Yang paling sering dibaca.') },
  { key: 'nav.timeline', href: '/malaysia/timeline-of-malaysia', icon: '📜', color: '#FBBF24', blurb: L('Sejarah Malaysia dalam satu garis masa.', "Malaysia's history on one timeline.", '一条时间线看马来西亚历史。', 'மலேசியாவின் வரலாறு ஒரே காலவரிசையில்.', 'マレーシアの歴史を一つの年表で。', '하나의 연표로 보는 말레이시아 역사.', 'ประวัติศาสตร์มาเลเซียบนเส้นเวลาเดียว', 'Lịch sử Malaysia trên một dòng thời gian.', 'Sejarah Malaysia dalam satu garis waktu.') },
  { key: 'nav.graph', href: '/graph', icon: '🕸️', color: '#A78BFA', blurb: L('Setiap topik dan cara ia berhubung.', 'Every topic and how it connects.', '每个主题及其关联。', 'ஒவ்வொரு தலைப்பும் அது எவ்வாறு தொடர்பு கொள்கிறது என்பதும்.', 'すべてのトピックとそのつながり。', '모든 주제와 그 연결 관계.', 'ทุกหัวข้อและวิธีที่เชื่อมโยงกัน', 'Mọi chủ đề và cách chúng kết nối.', 'Setiap topik dan bagaimana kaitannya.') },
  { key: 'nav.dashboard', href: '/dashboard', icon: '📊', color: '#22D3EE', blurb: L('Pangkalan pengetahuan dalam angka.', 'The knowledge base by the numbers.', '用数据看这个知识库。', 'அறிவுத் தளம் எண்களில்.', '数字で見る知識ベース。', '숫자로 보는 지식 베이스.', 'ฐานความรู้ในรูปตัวเลข', 'Cơ sở tri thức qua các con số.', 'Basis pengetahuan dalam angka.') },
  { key: 'nav.analytics', href: '/analytics', icon: '📈', color: '#34D399', blurb: L('Trafik dan bacaan secara langsung.', 'Live traffic and readership.', '实时流量与阅读量。', 'நேரடி போக்குவரத்து மற்றும் வாசிப்பு.', 'リアルタイムのトラフィックと読者数。', '실시간 트래픽과 독자 수.', 'ปริมาณการเข้าชมและผู้อ่านแบบสด', 'Lưu lượng và lượng đọc trực tiếp.', 'Lalu lintas dan pembaca secara langsung.') },
  { key: 'nav.forAI', href: '/llms', icon: '🤖', color: '#E879F9', blurb: L('Guna seluruh laman dengan AI anda.', 'Use the whole site with your AI.', '用你的 AI 使用整个网站。', 'முழு தளத்தையும் உங்கள் AI உடன் பயன்படுத்துங்கள்.', 'サイト全体を AI で使う。', '전체 사이트를 당신의 AI와 함께.', 'ใช้ทั้งเว็บไซต์กับ AI ของคุณ', 'Dùng toàn bộ trang với AI của bạn.', 'Gunakan seluruh situs dengan AI Anda.') },
];

// Every way to CONTRIBUTE — the full set from the Contribute menu + /contribute
// anchors. Titles reuse nav.* strings; blurbs written here.
const contributeFeatures = [
  { key: 'nav.reportIssue', href: '/contribute#report', icon: '🚩', color: '#F87171', blurb: L('Laporkan fakta silap, pautan rosak, atau salah taip.', 'Flag a factual error, broken link, or typo.', '报告事实错误、失效链接或错别字。', 'தகவல் பிழை, உடைந்த இணைப்பு, அல்லது எழுத்துப் பிழையைப் புகாரளியுங்கள்.', '事実の誤り・リンク切れ・誤字を報告。', '사실 오류, 깨진 링크, 오타를 신고하세요.', 'แจ้งข้อผิดพลาด ลิงก์เสีย หรือคำผิด', 'Báo lỗi thông tin, liên kết hỏng, hoặc lỗi chính tả.', 'Laporkan kesalahan fakta, tautan rusak, atau salah ketik.') },
  { key: 'nav.suggest', href: '/contribute#suggest', icon: '💡', color: '#FBBF24', blurb: L('Cadangkan topik yang patut kami liputi.', 'Propose a topic we should cover.', '建议我们应涵盖的主题。', 'நாங்கள் உள்ளடக்க வேண்டிய தலைப்பைப் பரிந்துரையுங்கள்.', '扱うべきトピックを提案。', '다뤄야 할 주제를 제안하세요.', 'เสนอหัวข้อที่เราควรครอบคลุม', 'Đề xuất một chủ đề chúng tôi nên viết.', 'Usulkan topik yang sebaiknya kami bahas.') },
  { key: 'nav.submitArticle', href: '/contribute#contribute', icon: '✍️', color: '#4ADE80', blurb: L('Tulis artikel baharu melalui pull request — dengan bantuan gesaan AI.', 'Write a new article via a pull request — with an AI prompt to help.', '通过 pull request 撰写新文章——附 AI 提示词助力。', 'pull request மூலம் புதிய கட்டுரையை எழுதுங்கள் — AI கட்டளையின் உதவியுடன்.', 'pull request で新しい記事を執筆 — AI プロンプト付き。', 'pull request로 새 기사를 작성하세요 — AI 프롬프트 지원.', 'เขียนบทความใหม่ผ่าน pull request — มีพรอมป์ต AI ช่วย', 'Viết bài mới qua pull request — có sẵn câu lệnh AI hỗ trợ.', 'Tulis artikel baru melalui pull request — dengan bantuan prompt AI.') },
  { key: 'nav.roles', href: '/roles', icon: '🧩', color: '#A78BFA', blurb: L('Siapa buat apa, dan cara akses diberikan.', 'Who does what, and how access works.', '谁负责什么，以及权限如何运作。', 'யார் என்ன செய்கிறார்கள், அணுகல் எப்படி வழங்கப்படுகிறது.', '誰が何をするか、アクセスの仕組み。', '누가 무엇을 하고, 접근 권한은 어떻게 작동하는지.', 'ใครทำอะไร และการเข้าถึงทำงานอย่างไร', 'Ai làm gì, và quyền truy cập hoạt động ra sao.', 'Siapa melakukan apa, dan cara akses diberikan.') },
  { key: 'nav.worklist', href: '/worklist', icon: '📋', color: '#38BDF8', blurb: L('Pilih satu tugas terbuka untuk dikerjakan.', 'Pick an open task to work on.', '认领一个开放任务。', 'வேலை செய்ய ஒரு திறந்த பணியைத் தேர்ந்தெடுங்கள்.', '着手できる未完了タスクを選ぶ。', '작업할 열린 과제를 고르세요.', 'เลือกงานที่เปิดอยู่เพื่อลงมือทำ', 'Chọn một việc đang mở để làm.', 'Pilih satu tugas terbuka untuk dikerjakan.') },
  { key: 'nav.donate', href: '/donate', icon: '💛', color: '#FFC000', blurb: L('Sumbang token AI atau dana.', 'Chip in AI tokens or funds.', '捐助 AI 代币或资金。', 'AI டோக்கன்கள் அல்லது நிதி வழங்குங்கள்.', 'AI トークンや資金を寄付。', 'AI 토큰이나 자금을 보태주세요.', 'ร่วมสมทบโทเค็น AI หรือทุน', 'Góp token AI hoặc kinh phí.', 'Sumbangkan token AI atau dana.') },
  { key: 'nav.support', href: '/support', icon: '🤝', color: '#22D3EE', blurb: L('Cara lain untuk menyokong projek ini.', 'Other ways to support the project.', '支持本项目的其他方式。', 'இந்தத் திட்டத்தை ஆதரிக்க மற்ற வழிகள்.', 'プロジェクトを支える他の方法。', '프로젝트를 지원하는 다른 방법.', 'วิธีอื่นในการสนับสนุนโครงการ', 'Những cách khác để ủng hộ dự án.', 'Cara lain untuk mendukung proyek ini.') },
  { key: 'nav.siteBug', href: '/contribute#site', icon: '🛠️', color: '#94A3B8', blurb: L('Ada masalah dengan laman web itu sendiri.', 'Something wrong with the website itself.', '网站本身出了问题。', 'வலைத்தளத்திலேயே ஏதோ தவறு.', 'ウェブサイト自体の不具合。', '웹사이트 자체의 문제.', 'มีบางอย่างผิดปกติกับเว็บไซต์เอง', 'Có vấn đề với chính trang web.', 'Ada masalah dengan situs web itu sendiri.') },
  { key: 'nav.github', href: REPO, external: true, icon: '🐙', color: '#E2E8F0', blurb: L('Sumber kod, isu, dan pull request.', 'The source, issues, and pull requests.', '源代码、issue 与 pull request。', 'மூலக் குறியீடு, சிக்கல்கள், மற்றும் pull request-கள்.', 'ソースコード・issue・pull request。', '소스 코드, 이슈, 풀 리퀘스트.', 'ซอร์สโค้ด issue และ pull request', 'Mã nguồn, issue, và pull request.', 'Kode sumber, issue, dan pull request.') },
];

// How to read & verify — two primary step cards.
const guides = [
  {
    icon: '🔍',
    title: L('Cari sesuatu', 'Find something', '查找内容', 'ஏதேனும் தேடுங்கள்', '何かを探す', '무언가 찾기', 'ค้นหาบางสิ่ง', 'Tìm một điều gì đó', 'Cari sesuatu'),
    steps: [
      L('Tekan “/” pada papan kekunci, atau ketik ikon carian di bar atas.', 'Press “/” on your keyboard, or tap the search icon in the top bar.', '按键盘上的“/”，或点击顶栏的搜索图标。', 'உங்கள் விசைப்பலகையில் “/” அழுத்துங்கள், அல்லது மேல் பட்டியில் உள்ள தேடல் சின்னத்தைத் தட்டுங்கள்.', 'キーボードで「/」を押すか、上部バーの検索アイコンをタップします。', '키보드에서 “/”를 누르거나, 상단 바의 검색 아이콘을 탭하세요.', 'กด “/” บนแป้นพิมพ์ หรือแตะไอคอนค้นหาในแถบด้านบน', 'Nhấn “/” trên bàn phím, hoặc chạm vào biểu tượng tìm kiếm ở thanh trên cùng.', 'Tekan “/” pada papan ketik, atau ketuk ikon pencarian di bilah atas.'),
      L('Taip nama orang, tempat atau peristiwa — carian sepadan semasa anda menaip.', 'Type a person, place, or event — it matches as you type.', '输入人物、地点或事件——边输入边匹配。', 'ஒரு நபர், இடம் அல்லது நிகழ்வைத் தட்டச்சு செய்யுங்கள் — நீங்கள் தட்டச்சு செய்யும்போதே அது பொருந்தும்.', '人物、場所、または出来事を入力すると、入力に応じて一致します。', '인물, 장소 또는 사건을 입력하세요 — 입력하는 동안 바로 일치 결과가 나타납니다.', 'พิมพ์ชื่อบุคคล สถานที่ หรือเหตุการณ์ — ระบบจะจับคู่ผลลัพธ์ขณะที่คุณพิมพ์', 'Nhập tên một người, địa điểm hoặc sự kiện — kết quả khớp ngay khi bạn gõ.', 'Ketik nama orang, tempat atau peristiwa — hasilnya cocok saat Anda mengetik.'),
      L('Buka mana-mana hasil untuk membaca artikel penuh.', 'Open any result to read the full article.', '打开任意结果即可阅读全文。', 'முழு கட்டுரையையும் படிக்க எந்த முடிவையும் திறங்கள்.', 'いずれかの結果を開いて記事全文を読みます。', '전체 기사를 읽으려면 아무 결과나 여세요.', 'เปิดผลลัพธ์ใดก็ได้เพื่ออ่านบทความฉบับเต็ม', 'Mở bất kỳ kết quả nào để đọc toàn văn bài viết.', 'Buka hasil mana pun untuk membaca artikel lengkap.'),
    ],
  },
  {
    icon: '📖',
    title: L('Baca & sahkan', 'Read & verify', '阅读与核实', 'படித்து சரிபார்', '読んで検証', '읽고 검증', 'อ่านและตรวจสอบ', 'Đọc & kiểm chứng', 'Baca & verifikasi'),
    steps: [
      L('Buka artikel daripada laluan, kategori atau carian.', 'Open an article from a path, category, or search.', '从路径、分类或搜索打开文章。', 'ஒரு பாதை, வகை அல்லது தேடலில் இருந்து ஒரு கட்டுரையைத் திறங்கள்.', 'パス、カテゴリ、または検索から記事を開きます。', '경로, 카테고리 또는 검색에서 기사를 여세요.', 'เปิดบทความจากเส้นทาง หมวดหมู่ หรือการค้นหา', 'Mở một bài viết từ một hướng, danh mục hoặc tìm kiếm.', 'Buka artikel dari jalur, kategori atau pencarian.'),
      L('Tatal ke bahagian “Sumber” di hujung — rujukannya disenaraikan di sana.', 'Scroll to the “Sources” at the foot — its references are listed there.', '滚动到末尾的“来源”——参考资料都列在那里。', 'அடிப்பகுதியில் உள்ள “ஆதாரங்கள்” வரை உருட்டுங்கள் — அதன் குறிப்புகள் அங்கே பட்டியலிடப்பட்டுள்ளன.', '末尾の「出典」までスクロールします — 参照元はそこに一覧化されています。', '하단의 “출처”까지 스크롤하세요 — 참고 자료가 거기에 나열되어 있습니다.', 'เลื่อนไปที่ส่วน “แหล่งที่มา” ท้ายบทความ — รายการอ้างอิงอยู่ที่นั่น', 'Cuộn xuống phần “Nguồn” ở cuối bài — các tài liệu tham khảo được liệt kê ở đó.', 'Gulir ke bagian “Sumber” di bawah — rujukannya tercantum di sana.'),
