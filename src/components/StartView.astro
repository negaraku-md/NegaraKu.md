---
import type { Locale } from '@/lib/categories';
import { PILLARS, getPillarColor, loc } from '@/lib/categories';
import { localePath, t, LOCALES } from '@/lib/i18n';
import { REPO } from '@/lib/site';
import { exploreFeatures } from '@/lib/exploreFeatures';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string) => (locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

// Search example chips — each opens REAL results at /search?q=…
const chips = [
  { q: 'start a business', label: L('mulakan perniagaan', 'start a business', '创业', 'வணிகம் தொடங்கு', 'ビジネスを始める', '사업 시작', 'เริ่มธุรกิจ', 'khởi nghiệp', 'memulai bisnis') },
  { q: 'public transport', label: L('pengangkutan awam', 'public transport', '公共交通', 'பொதுப் போக்குவரத்து', '公共交通', '대중교통', 'ขนส่งสาธารณะ', 'giao thông công cộng', 'transportasi umum') },
  { q: 'government', label: L('kerajaan', 'government', '政府', 'அரசாங்கம்', '政府', '정부', 'รัฐบาล', 'chính phủ', 'pemerintahan') },
  { q: 'income tax', label: L('cukai pendapatan', 'income tax', '所得税', 'வருமான வரி', '所得税', '소득세', 'ภาษีเงินได้', 'thuế thu nhập', 'pajak penghasilan') },
];

// Every way to EXPLORE — the full set of discovery surfaces (shared source of
// truth with /explore so the two never drift). Titles reuse nav.* strings.
const exploreFeats = exploreFeatures(locale);

// Every way to CONTRIBUTE — the full set from the Contribute menu + /contribute
// anchors. Titles reuse nav.* strings; blurbs written here.
const contributeFeatures = [
  { key: 'nav.reportIssue', href: '/contribute#report', icon: '🚩', color: '#F87171', blurb: L('Laporkan fakta silap, pautan rosak, atau salah taip.', 'Flag a factual error, broken link, or typo.', '报告事实错误、失效链接或错别字。', 'தகவல் பிழை, உடைந்த இணைப்பு, அல்லது எழுத்துப் பிழையைப் புகாரளியுங்கள்.', '事実の誤り・リンク切れ・誤字を報告。', '사실 오류, 깨진 링크, 오타를 신고하세요.', 'แจ้งข้อผิดพลาด ลิงก์เสีย หรือคำผิด', 'Báo lỗi thông tin, liên kết hỏng, hoặc lỗi chính tả.', 'Laporkan kesalahan fakta, tautan rusak, atau salah ketik.') },
  { key: 'nav.suggest', href: '/contribute#suggest', icon: '💡', color: '#FBBF24', blurb: L('Cadangkan topik yang patut kami liputi.', 'Propose a topic we should cover.', '建议我们应涵盖的主题。', 'நாங்கள் உள்ளடக்க வேண்டிய தலைப்பைப் பரிந்துரையுங்கள்.', '扱うべきトピックを提案。', '다뤄야 할 주제를 제안하세요.', 'เสนอหัวข้อที่เราควรครอบคลุม', 'Đề xuất một chủ đề chúng tôi nên viết.', 'Usulkan topik yang sebaiknya kami bahas.') },
  { key: 'nav.submitArticle', href: '/contribute#contribute', icon: '✍️', color: '#4ADE80', blurb: L('Tulis artikel baharu melalui pull request — dengan bantuan gesaan AI.', 'Write a new article via a pull request — with an AI prompt to help.', '通过 pull request 撰写新文章——附 AI 提示词助力。', 'pull request மூலம் புதிய கட்டுரையை எழுதுங்கள் — AI கட்டளையின் உதவியுடன்.', 'pull request で新しい記事を執筆 — AI プロンプト付き。', 'pull request로 새 기사를 작성하세요 — AI 프롬프트 지원.', 'เขียนบทความใหม่ผ่าน pull request — มีพรอมป์ต AI ช่วย', 'Viết bài mới qua pull request — có sẵn câu lệnh AI hỗ trợ.', 'Tulis artikel baru melalui pull request — dengan bantuan prompt AI.') },
  { key: 'nav.roles', href: '/roles', icon: '🧩', color: '#A78BFA', blurb: L('Siapa buat apa, dan cara akses diberikan.', 'Who does what, and how access works.', '谁负责什么，以及权限如何运作。', 'யார் என்ன செய்கிறார்கள், அணுகல் எப்படி வழங்கப்படுகிறது.', '誰が何をするか、アクセスの仕組み。', '누가 무엇을 하고, 접근 권한은 어떻게 작동하는지.', 'ใครทำอะไร และการเข้าถึงทำงานอย่างไร', 'Ai làm gì, và quyền truy cập hoạt động ra sao.', 'Siapa melakukan apa, dan cara akses diberikan.') },
  { key: 'nav.worklist', href: '/worklist', icon: '📋', color: '#38BDF8', blurb: L('Pilih satu tugas terbuka untuk dikerjakan.', 'Pick an open task to work on.', '认领一个开放任务。', 'வேலை செய்ய ஒரு திறந்த பணியைத் தேர்ந்தெடுங்கள்.', '着手できる未完了タスクを選ぶ。', '작업할 열린 과제를 고르세요.', 'เลือกงานที่เปิดอยู่เพื่อลงมือทำ', 'Chọn một việc đang mở để làm.', 'Pilih satu tugas terbuka untuk dikerjakan.') },
  { key: 'nav.donate', href: '/donate', icon: '💛', color: '#FFC000', blurb: L('Sumbang token AI atau dana.', 'Chip in AI tokens or funds.', '捐助 AI 代币或资金。', 'AI டோக்கன்கள் அல்லது நிதி வழங்குங்கள்.', 'AI トークンや資金を寄付。', 'AI 토큰이나 자금을 보태주세요.', 'ร่วมสมทบโทเค็น AI หรือทุน', 'Góp token AI hoặc kinh phí.', 'Sumbangkan token AI atau dana.') },
  { key: 'nav.support', href: '/support', icon: '🤝', color: '#22D3EE', blurb: L('Cara lain untuk menyokong projek ini.', 'Other ways to support the project.', '支持本项目的其他方式。', 'இந்தத் திட்டத்தை ஆதரிக்க மற்ற வழிகள்.', 'プロジェクトを支える他の方法。', '프로젝트를 지원하는 다른 방법.', 'วิธีอื่นในการสนับสนุนโครงการ', 'Những cách khác để ủng hộ dự án.', 'Cara lain untuk mendukung proyek ini.') },
  { key: 'nav.siteBug', href: '/contribute#site', icon: '🛠️', color: '#94A3B8', blurb: L('Ada masalah dengan laman web itu sendiri.', 'Something wrong with the website itself.', '网站本身出了问题。', 'வலைத்தளத்திலேயே ஏதோ தவறு.', 'ウェブサイト自体の不具合。', '웹사이트 자체의 문제.', 'มีบางอย่างผิดปกติกับเว็บไซต์เอง', 'Có vấn đề với chính trang web.', 'Ada masalah dengan situs web itu sendiri.') },
  { key: 'nav.github', href: REPO, external: true, icon: '🐙', color: '#E2E8F0', blurb: L('Sumber kod, isu, dan pull request.', 'The source, issues, and pull requests.', '源代码、issue 与 pull request。', 'மூலக் குறியீடு, சிக்கல்கள், மற்றும் pull request-கள்.', 'ソースコード・issue・pull request。', '소스 코드, 이슈, 풀 리퀘스트.', 'ซอร์สโค้ด issue และ pull request', 'Mã nguồn, issue, và pull request.', 'Kode sumber, issue, dan pull request.') },
];

const nLang = LOCALES.length;

// What's in an article — the real anatomy of every article page, so a first-time
// reader knows what they'll find and how to use it. Titles mirror ArticleView's
// own section headings; these are informational cards (not links).
const articleFeatures = [
  { icon: '⚡', title: L('Jawapan pantas', '30-second answer', '30 秒速答', '30 வினாடி பதில்', '30秒でわかる答え', '30초 답변', 'คำตอบใน 30 วินาที', 'Câu trả lời 30 giây', 'Jawaban 30 detik'), blurb: L('Ringkasan pantas di bahagian atas — intinya sekali pandang.', 'A quick summary at the top — the gist in one glance.', '页面顶部的快速摘要——一眼看懂要点。', 'மேலே ஒரு விரைவு சுருக்கம் — ஒரே பார்வையில் சாராம்சம்.', 'ページ上部の要約 — ひと目で要点がわかる。', '맨 위의 빠른 요약 — 한눈에 핵심 파악.', 'สรุปสั้น ๆ ที่ด้านบน — เข้าใจใจความในพริบตา', 'Tóm tắt nhanh ở đầu trang — nắm ý chính trong một cái nhìn.', 'Ringkasan cepat di bagian atas — intinya dalam sekejap.') },
  { icon: '📄', title: L('Penjelasan penuh', 'Full explanation', '完整说明', 'முழு விளக்கம்', '詳しい説明', '전체 설명', 'คำอธิบายฉบับเต็ม', 'Giải thích đầy đủ', 'Penjelasan lengkap'), blurb: L('Huraian penuh bersumber di bawah ringkasan.', 'The complete, sourced write-up beneath the summary.', '摘要下方是注明来源的完整内容。', 'சுருக்கத்திற்குக் கீழே ஆதாரம் காட்டப்பட்ட முழு விவரம்.', '要約の下に、出典付きの詳しい本文。', '요약 아래의 출처가 명시된 전체 본문.', 'เนื้อหาฉบับเต็มพร้อมแหล่งอ้างอิงใต้บทสรุป', 'Bài viết đầy đủ, có nguồn, bên dưới phần tóm tắt.', 'Uraian lengkap bersumber di bawah ringkasan.') },
  { icon: '🧭', title: L('Dalam halaman ini', 'On this page', '本页目录', 'இந்தப் பக்கத்தில்', 'このページの目次', '이 페이지에서', 'ในหน้านี้', 'Trong trang này', 'Dalam halaman ini'), blurb: L('Senarai kandungan untuk terus ke mana-mana bahagian.', 'A contents list to jump straight to any section.', '目录，可直接跳转到任意章节。', 'எந்தப் பகுதிக்கும் நேரடியாகச் செல்ல உள்ளடக்கப் பட்டியல்.', '任意のセクションへ飛べる目次。', '원하는 섹션으로 바로 이동하는 목차.', 'สารบัญสำหรับข้ามไปยังหัวข้อใดก็ได้', 'Mục lục để nhảy thẳng đến bất kỳ phần nào.', 'Daftar isi untuk langsung ke bagian mana pun.') },
  { icon: '🔗', title: L('Sumber', 'Sources', '来源', 'ஆதாரங்கள்', '出典', '출처', 'แหล่งที่มา', 'Nguồn', 'Sumber'), blurb: L('Rujukan bagi setiap dakwaan, disenaraikan dan boleh disemak.', "Every claim's references, listed and checkable.", '每项陈述的参考资料，可查证。', 'ஒவ்வொரு கூற்றின் குறிப்புகளும், பட்டியலிடப்பட்டு சரிபார்க்கக்கூடியவை.', 'すべての記述の参照元を一覧化、確認可能。', '모든 주장의 참고 자료, 확인 가능하게 나열.', 'รายการอ้างอิงของทุกข้อความ ตรวจสอบได้', 'Tài liệu tham khảo cho mọi nhận định, có thể kiểm chứng.', 'Rujukan untuk setiap klaim, tercantum dan bisa diperiksa.') },
  { icon: '🪢', title: L('Pengetahuan berkaitan', 'Related knowledge', '相关知识', 'தொடர்புடைய அறிவு', '関連する知識', '관련 지식', 'ความรู้ที่เกี่ยวข้อง', 'Kiến thức liên quan', 'Pengetahuan terkait'), blurb: L('Pautan ke topik berkaitan untuk diterokai seterusnya.', 'Links to connected topics to explore next.', '通往相关主题的链接，继续探索。', 'அடுத்து ஆராய தொடர்புடைய தலைப்புகளுக்கான இணைப்புகள்.', '次に読む関連トピックへのリンク。', '다음에 둘러볼 연결된 주제 링크.', 'ลิงก์ไปยังหัวข้อที่เกี่ยวข้องเพื่อสำรวจต่อ', 'Liên kết đến các chủ đề liên quan để khám phá tiếp.', 'Tautan ke topik terkait untuk dijelajahi berikutnya.') },
  { icon: '🕓', title: L('Semakan & kesegaran', 'Revision & freshness', '修订与时效', 'திருத்தம் & புத்தநிலை', '改訂と鮮度', '개정 및 최신성', 'การแก้ไขและความใหม่', 'Phiên bản & độ mới', 'Revisi & kesegaran'), blurb: L('Siapa menerbitkannya, bila, dan sejarah perubahan penuhnya.', 'Who published it, when, and its full change history.', '谁发布、何时发布，以及完整修改历史。', 'யார் வெளியிட்டார், எப்போது, மற்றும் அதன் முழு மாற்ற வரலாறு.', '誰がいつ公開したか、変更履歴のすべて。', '누가 언제 발행했는지와 전체 변경 이력.', 'ใครเผยแพร่ เมื่อใด และประวัติการแก้ไขทั้งหมด', 'Ai đã đăng, khi nào, và toàn bộ lịch sử thay đổi.', 'Siapa yang menerbitkan, kapan, dan riwayat perubahan lengkapnya.') },
  { icon: '🌐', title: L('Dalam bahasa anda', 'In your language', '以你的语言', 'உங்கள் மொழியில்', 'あなたの言語で', '당신의 언어로', 'ในภาษาของคุณ', 'Bằng ngôn ngữ của bạn', 'Dalam bahasa Anda'), blurb: L(`Baca artikel yang sama dalam ${nLang} bahasa.`, `Read the same article in ${nLang} languages.`, `以 ${nLang} 种语言阅读同一篇文章。`, `அதே கட்டுரையை ${nLang} மொழிகளில் படியுங்கள்.`, `同じ記事を ${nLang} 言語で読めます。`, `같은 기사를 ${nLang}개 언어로.`, `อ่านบทความเดียวกันใน ${nLang} ภาษา`, `Đọc cùng bài viết bằng ${nLang} ngôn ngữ.`, `Baca artikel yang sama dalam ${nLang} bahasa.`) },
  { icon: '🤖', title: L('Salin Markdown · Untuk AI', 'Copy Markdown · For AI', '复制 Markdown · 面向 AI', 'Markdown நகல் · AI-க்கு', 'Markdown をコピー · AI 向け', 'Markdown 복사 · AI용', 'คัดลอก Markdown · สำหรับ AI', 'Sao chép Markdown · Cho AI', 'Salin Markdown · Untuk AI'), blurb: L('Ambil Markdown mentah untuk alat AI anda.', 'Grab the raw Markdown for your AI tool.', '获取原始 Markdown，用于你的 AI 工具。', 'உங்கள் AI கருவிக்கு மூல Markdown-ஐப் பெறுங்கள்.', '生の Markdown を取得して AI ツールへ。', 'AI 도구용 원본 Markdown 가져오기.', 'ดึง Markdown ดิบไปใช้กับเครื่องมือ AI ของคุณ', 'Lấy Markdown thô cho công cụ AI của bạn.', 'Ambil Markdown mentah untuk alat AI Anda.') },
];

// How we keep it accurate — the verification / trust story. Moved from Explore to
// Contribute: it's the project's quality promise and the reason to take part.
const accuracy = [
  { icon: '✅', text: L('Setiap dakwaan dipetik; sumber disenaraikan dan boleh disemak.', 'Every claim is cited; sources are listed and checkable.', '每项陈述均注明出处；来源可查证。', 'ஒவ்வொரு கூற்றும் மேற்கோள் காட்டப்படுகிறது; ஆதாரங்கள் பட்டியலிடப்பட்டு சரிபார்க்கக்கூடியவை.', 'すべての記述に出典があり、ソースは一覧化され確認できます。', '모든 주장에 출처가 있고, 소스는 나열되어 확인 가능합니다.', 'ทุกข้อความมีการอ้างอิง แหล่งที่มาระบุไว้และตรวจสอบได้', 'Mọi nhận định đều được dẫn nguồn; nguồn được liệt kê và kiểm chứng được.', 'Setiap klaim dikutip; sumber tercantum dan bisa diperiksa.') },
  { icon: '🔗', text: L('Ikuti mana-mana pautan sumber untuk mengesahkannya sendiri.', 'Follow any source link to verify it for yourself.', '点击任意来源链接，自行查证。', 'எந்த ஆதாரச் சுட்டியையும் பின்தொடர்ந்து நீங்களே சரிபார்க்கலாம்.', 'どの出典リンクからも、自分で確認できます。', '아무 출처 링크나 따라가 직접 확인하세요.', 'คลิกลิงก์แหล่งที่มาใดก็ได้เพื่อตรวจสอบด้วยตนเอง', 'Theo bất kỳ liên kết nguồn nào để tự mình kiểm chứng.', 'Ikuti tautan sumber mana pun untuk memverifikasinya sendiri.') },
  { icon: '👤', text: L('Topik sensitif disemak oleh penyelenggara bernama sebelum terbit.', 'Sensitive topics get a named-maintainer review before publishing.', '敏感主题在发布前由具名维护者审阅。', 'உணர்திறன் மிக்க தலைப்புகள் வெளியிடுவதற்கு முன் பெயரிடப்பட்ட பராமரிப்பாளரால் மதிப்பாய்வு செய்யப்படுகின்றன.', '扱いに注意が必要なトピックは公開前に名前のある管理者がレビューします。', '민감한 주제는 발행 전에 이름이 공개된 관리자가 검토합니다.', 'หัวข้อที่ละเอียดอ่อนได้รับการตรวจทานโดยผู้ดูแลที่ระบุชื่อก่อนเผยแพร่', 'Chủ đề nhạy cảm được người bảo trì có tên duyệt trước khi đăng.', 'Topik sensitif ditinjau oleh pengelola bernama sebelum terbit.') },
  { icon: '🕓', text: L('Kesegaran dijejaki dan sejarah perubahan penuh adalah terbuka.', 'Freshness is tracked and the full change history is public.', '时效性受到跟踪，完整修改历史公开。', 'புத்தநிலை கண்காணிக்கப்படுகிறது, முழு மாற்ற வரலாறும் பொதுவானது.', '鮮度は追跡され、変更履歴はすべて公開されています。', '최신성은 추적되고 전체 변경 이력은 공개됩니다.', 'มีการติดตามความใหม่ และประวัติการเปลี่ยนแปลงทั้งหมดเปิดเผยต่อสาธารณะ', 'Độ mới được theo dõi và toàn bộ lịch sử thay đổi được công khai.', 'Kesegaran dilacak dan riwayat perubahan lengkap bersifat publik.') },
];

const guideHref = `${REPO}/blob/main/CONTRIBUTING.md`;

// Contribute links, grouped for the two-column layout: the active ways to take
// part vs. the ways to support the project.
const takeKeys = new Set(['nav.reportIssue', 'nav.suggest', 'nav.submitArticle', 'nav.worklist', 'nav.roles', 'nav.github']);
const takePart = contributeFeatures.filter((f) => takeKeys.has(f.key));
const support = contributeFeatures.filter((f) => !takeKeys.has(f.key));
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム', '홈', 'หน้าแรก', 'Trang chủ', 'Beranda'), href: localePath('/', locale) },
    { label: L('Mula di sini', 'Start here', '从这里开始', 'இங்கே தொடங்குங்கள்', 'ここから始める', '여기서 시작', 'เริ่มต้นที่นี่', 'Bắt đầu tại đây', 'Mulai di sini') },
  ]}
  title={L('Mula di sini', 'Start here', '从这里开始', 'இங்கே தொடங்குங்கள்', 'ここから始める', '여기서 시작', 'เริ่มต้นที่นี่', 'Bắt đầu tại đây', 'Mulai di sini')}
  desc={L(
    'Dua cara untuk bermula — terokai Malaysia, atau bantu bina pangkalan pengetahuannya. Semuanya bersumber, untuk manusia dan AI.',
    "Two ways to begin — explore Malaysia, or help build its knowledge base. All sourced, for people and AI.",
    '两种开始方式——探索马来西亚，或帮助建设它的知识库。全部注明来源，为人类与 AI 打造。',
    'தொடங்க இரண்டு வழிகள் — மலேசியாவை ஆராயுங்கள், அல்லது அதன் அறிவுத் தளத்தைக் கட்டியெழுப்ப உதவுங்கள். அனைத்தும் ஆதாரம் காட்டப்பட்டவை, மனிதர்களுக்கும் AI-க்கும்.',
    '始める方法は2つ — マレーシアを探索するか、その知識ベースづくりを手伝うか。すべて出典付きで、人にも AI にも。',
    '시작하는 두 가지 방법 — 말레이시아를 탐색하거나, 그 지식 베이스를 함께 만들어가세요. 모두 출처 기반, 사람과 AI를 위해.',
    'สองวิธีในการเริ่มต้น — สำรวจมาเลเซีย หรือช่วยสร้างฐานความรู้ของมาเลเซีย ทั้งหมดมีแหล่งอ้างอิง สำหรับคนและ AI',
    'Hai cách để bắt đầu — khám phá Malaysia, hoặc giúp xây dựng cơ sở tri thức của nó. Tất cả đều có nguồn, cho con người và AI.',
    'Dua cara untuk memulai — jelajahi Malaysia, atau bantu bangun basis pengetahuannya. Semua bersumber, untuk manusia dan AI.',
  )}
/>

<!-- Two paths, side by side -->
<section class="container block">
  <div class="paths">

    <div class="pcol pc-explore anchor" id="explore">
      <div class="phead">
        <span class="phico" aria-hidden="true">🧭</span>
        <span class="phtag">{L('Untuk pembaca', 'For readers', '面向读者', 'வாசகர்களுக்கு', '読者向け', '독자용', 'สำหรับผู้อ่าน', 'Dành cho người đọc', 'Untuk pembaca')}</span>
        <b>{L('Terokai Malaysia', 'Explore Malaysia', '探索马来西亚', 'மலேசியாவை ஆராயுங்கள்', 'マレーシアを探索', '말레이시아 탐색', 'สำรวจมาเลเซีย', 'Khám phá Malaysia', 'Jelajahi Malaysia')}</b>
        <p>{L('Baca panduan bersumber — untuk manusia dan AI.', 'Read sourced guides — for people and AI.', '阅读注明来源的指南——为人类与 AI。', 'ஆதாரம் காட்டப்பட்ட வழிகாட்டிகளைப் படியுங்கள் — மனிதர்களுக்கும் AI-க்கும்.', '出典付きガイドを読む — 人にも AI にも。', '출처 기반 안내서를 읽으세요 — 사람과 AI를 위해.', 'อ่านคู่มือที่มีแหล่งอ้างอิง — สำหรับคนและ AI', 'Đọc hướng dẫn có nguồn — cho con người và AI.', 'Baca panduan bersumber — untuk manusia dan AI.')}</p>
      </div>
      <div class="pbody">
        <h3 class="subhead">{t('nav.search', locale)}</h3>
        <div class="search-row">
          <a class="cta-btn cta-primary" href={localePath('/search', locale)}><span aria-hidden="true">🔍</span> {t('nav.search', locale)} →</a>
        </div>
        <div class="chips">
          {chips.map((c) => (
            <a class="chip" href={`${localePath('/search', locale)}?q=${encodeURIComponent(c.q)}`}><span aria-hidden="true">🔍</span> {c.label}</a>
          ))}
        </div>

        <h3 class="subhead">{L('Semak imbas mengikut tonggak', 'Browse by pillar', '按支柱浏览', 'தூண்வாரியாக உலாவுங்கள்', '柱ごとに閲覧', '기둥별로 둘러보기', 'เรียกดูตามเสาหลัก', 'Duyệt theo trụ cột', 'Jelajahi berdasarkan pilar')}</h3>
        <div class="prows">
          {PILLARS.map((p) => (
            <a class="prow" href={localePath(`/${p.id}`, locale)} style={`--c:${getPillarColor(p.id)}`}>
              <span class="pico" aria-hidden="true">{p.icon}</span>
              <span class="ptext">
                <b>{loc(p.name, locale)}</b>
                <span class="pdesc">{loc(p.tagline, locale)}</span>
              </span>
            </a>
          ))}
        </div>

        <h3 class="subhead">{L('Alat & paparan', 'Tools & views', '工具与视图', 'கருவிகள் & காட்சிகள்', 'ツールとビュー', '도구 및 보기', 'เครื่องมือและมุมมอง', 'Công cụ & chế độ xem', 'Alat & tampilan')}</h3>
        <div class="dense">
          {exploreFeats.map((f) => (
            <a class="drow" href={localePath(f.href, locale)}>
              <span class="dico" aria-hidden="true">{f.icon}</span>
              <span class="dlabel">{t(f.key as any, locale)}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="pcol pc-contribute anchor" id="contribute">
      <div class="phead">
        <span class="phico" aria-hidden="true">✍️</span>
        <span class="phtag">{L('Untuk penyumbang', 'For contributors', '面向贡献者', 'பங்களிப்பாளர்களுக்கு', '貢献者向け', '기여자용', 'สำหรับผู้มีส่วนร่วม', 'Dành cho người đóng góp', 'Untuk kontributor')}</span>
        <b>{L('Bantu bina pangkalan pengetahuan Malaysia', "Help build Malaysia's knowledge base", '帮助建设马来西亚知识库', 'மலேசியாவின் அறிவுத் தளத்தை கட்டியெழுப்ப உதவுங்கள்', 'マレーシアの知識ベースづくりを手伝う', '말레이시아 지식 베이스 구축 돕기', 'ช่วยสร้างฐานความรู้มาเลเซีย', 'Giúp xây dựng cơ sở tri thức Malaysia', 'Bantu bangun basis pengetahuan Malaysia')}</b>
        <p>{L('Semuanya terbuka — tiada jemputan diperlukan. Melalui GitHub.', 'All open — no invitation needed. Via GitHub.', '全部开放——无需邀请。通过 GitHub。', 'அனைத்தும் திறந்தவை — அழைப்பு தேவையில்லை. GitHub மூலம்.', 'すべて開放 — 招待不要。GitHub で。', '모두 열려 있음 — 초대 불필요. GitHub로.', 'เปิดทั้งหมด — ไม่ต้องมีคำเชิญ ผ่าน GitHub', 'Tất cả đều mở — không cần lời mời. Qua GitHub.', 'Semua terbuka — tanpa undangan. Melalui GitHub.')}</p>
      </div>
      <div class="pbody">
        <h3 class="subhead">{L('Ambil bahagian', 'Take part', '参与方式', 'பங்கேற்பு', '参加する', '참여하기', 'เข้าร่วม', 'Tham gia', 'Ikut serta')}</h3>
        <div class="dense">
          {takePart.map((f) => (
            <a class="drow" href={f.external ? f.href : localePath(f.href, locale)} {...(f.external ? { rel: 'noopener', target: '_blank' } : {})}>
              <span class="dico" aria-hidden="true">{f.icon}</span>
              <span class="dlabel">{t(f.key as any, locale)}{f.external ? ' ↗' : ''}</span>
            </a>
          ))}
        </div>

        <h3 class="subhead">{L('Sokongan & lain-lain', 'Support & more', '支持与其他', 'ஆதரவு & பிற', '支援とその他', '지원 및 기타', 'สนับสนุนและอื่น ๆ', 'Hỗ trợ & khác', 'Dukungan & lainnya')}</h3>
        <div class="dense">
          {support.map((f) => (
            <a class="drow" href={f.external ? f.href : localePath(f.href, locale)} {...(f.external ? { rel: 'noopener', target: '_blank' } : {})}>
              <span class="dico" aria-hidden="true">{f.icon}</span>
              <span class="dlabel">{t(f.key as any, locale)}{f.external ? ' ↗' : ''}</span>
            </a>
          ))}
        </div>

        <div class="cbtns">
          <a class="cta-btn cta-primary" href={localePath('/contribute', locale)}>{t('nav.whyContribute', locale)} →</a>
          <a class="cta-btn" href={guideHref} rel="noopener" target="_blank">{L('Panduan sumbangan penuh', 'Full contribution guide', '完整贡献指南', 'முழுப் பங்களிப்பு வழிகாட்டி', '貢献ガイド全文', '전체 기여 가이드', 'คู่มือการมีส่วนร่วมฉบับเต็ม', 'Hướng dẫn đóng góp đầy đủ', 'Panduan kontribusi lengkap')} ↗</a>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Explainers — collapsible, so the page stays short -->
<section class="container block">
  <div class="explainers">
    <details class="xpl">
      <summary>
        <span class="xico" aria-hidden="true">👁️</span>
        <b>{L('Apa yang ada dalam artikel', "What's in an article", '一篇文章里有什么', 'ஒரு கட்டுரையில் என்ன இருக்கிறது', '記事の構成', '기사의 구성', 'ในบทความมีอะไรบ้าง', 'Một bài viết có gì', 'Apa yang ada dalam artikel')}</b>
        <span class="xchev" aria-hidden="true">▾</span>
      </summary>
      <div class="xbody">
        <p class="lead">{L(
          'Setiap artikel dibina dengan cara yang sama — ini yang akan anda temui dan cara membacanya.',
          'Every article is built the same way — here is what you will find and how to read it.',
          '每篇文章结构一致——以下是你会看到的内容及阅读方式。',
          'ஒவ்வொரு கட்டுரையும் ஒரே விதத்தில் கட்டப்படுகிறது — நீங்கள் காண்பது மற்றும் படிக்கும் முறை இதோ.',
          'どの記事も同じ構成です — 何があり、どう読むかを紹介します。',
          '모든 기사는 같은 방식으로 구성됩니다 — 무엇이 있고 어떻게 읽는지 안내합니다.',
          'ทุกบทความสร้างในรูปแบบเดียวกัน — นี่คือสิ่งที่คุณจะพบและวิธีอ่าน',
          'Mọi bài viết đều có cùng cấu trúc — đây là những gì bạn sẽ thấy và cách đọc.',
          'Setiap artikel dibangun dengan cara yang sama — inilah yang akan Anda temukan dan cara membacanya.',
        )}</p>
        <div class="afeat-grid">
          {articleFeatures.map((f) => (
            <div class="afeat">
              <span class="afico" aria-hidden="true">{f.icon}</span>
              <div>
                <b>{f.title}</b>
                <span class="afdesc">{f.blurb}</span>
              </div>
            </div>
          ))}
        </div>
        <p class="um">
          <b><span aria-hidden="true">🤖</span> {L('Guna dengan AI anda', 'Use with your AI', '配合你的 AI 使用', 'உங்கள் AI உடன் பயன்படுத்து', 'お使いの AI で使う', '당신의 AI와 함께 사용', 'ใช้กับ AI ของคุณ', 'Dùng với AI của bạn', 'Gunakan dengan AI Anda')}</b>
          {' — '}
          {L('salin Markdown artikel (atau tambah .md pada URL) ke dalam alat AI anda.', 'copy an article’s Markdown (or append .md to the URL) into your AI tool.', '将文章的 Markdown（或在网址后加 .md）复制到你的 AI 工具中。', 'கட்டுரையின் Markdown-ஐ (அல்லது URL-ல் .md சேர்த்து) உங்கள் AI கருவியில் நகலெடுங்கள்.', '記事の Markdown（または URL に .md）を AI ツールにコピーします。', '기사의 Markdown(또는 URL에 .md 추가)을 AI 도구에 복사하세요.', 'คัดลอก Markdown ของบทความ (หรือเพิ่ม .md ต่อท้าย URL) ลงในเครื่องมือ AI ของคุณ', 'sao chép Markdown của bài viết (hoặc thêm .md vào URL) vào công cụ AI của bạn.', 'salin Markdown artikel (atau tambahkan .md ke URL) ke alat AI Anda.')}
          {' '}
          <a href={localePath('/llms', locale)}>{t('nav.forAI', locale)} →</a>
        </p>
      </div>
    </details>

    <details class="xpl">
      <summary>
        <span class="xico" aria-hidden="true">🛡️</span>
        <b>{L('Bagaimana kami memastikan ketepatan', 'How we keep it accurate', '我们如何确保准确', 'துல்லியத்தை நாங்கள் எப்படிப் பேணுகிறோம்', '正確さを保つ方法', '정확성을 유지하는 방법', 'เรารักษาความถูกต้องอย่างไร', 'Cách chúng tôi giữ cho nội dung chính xác', 'Bagaimana kami menjaga keakuratan')}</b>
        <span class="xchev" aria-hidden="true">▾</span>
      </summary>
      <div class="xbody">
        <p class="lead">{L('Kepercayaan datang daripada cara setiap artikel dibina:', 'Trust comes from how every article is made:', '信任源于每篇文章的制作方式：', 'ஒவ்வொரு கட்டுரையும் உருவாக்கப்படும் விதத்திலிருந்து நம்பிக்கை வருகிறது:', '信頼は、記事の作られ方から生まれます：', '신뢰는 모든 기사가 만들어지는 방식에서 나옵니다:', 'ความน่าเชื่อถือมาจากวิธีที่ทุกบทความถูกสร้างขึ้น:', 'Niềm tin đến từ cách mỗi bài viết được tạo ra:', 'Kepercayaan datang dari cara setiap artikel dibuat:')}</p>
        <ul class="acc-list">
          {accuracy.map((a) => (
            <li><span class="accico" aria-hidden="true">{a.icon}</span>{a.text}</li>
          ))}
        </ul>
      </div>
    </details>
  </div>
</section>

<style>
  /* Start — two-path launchpad (explore / help build), side by side. */
  .block { margin-top: 1.6rem; }
  .anchor { scroll-margin-top: calc(var(--nav-height, 56px) + 1rem); }
  .lead { margin: 0 0 1.1rem; color: var(--ink-soft); line-height: 1.7; }
  .subhead {
    margin: 1.6rem 0 0.8rem; font-family: var(--font-title); font-size: 0.82rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted);
  }
  .pbody > .subhead:first-child, .pbody > .search-row:first-child { margin-top: 0; }

  /* Two columns = the two paths. */
  .paths { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; align-items: start; }
  @media (max-width: 820px) { .paths { grid-template-columns: 1fr; } }
  .pcol {
    background: var(--surface); border: 1px solid var(--line);
    border-top: 3px solid var(--pc, var(--gold)); border-radius: 12px; overflow: hidden;
  }
  .pc-explore { --pc: #38BDF8; }
  .pc-contribute { --pc: #4ADE80; }
  .phead { padding: 1.1rem 1.2rem 0.95rem; background: var(--surface-2); border-bottom: 1px solid var(--line); }
  .phico { font-size: 1.9rem; line-height: 1; display: block; }
  .phtag {
