---
// Runs before first paint to apply the reader's saved theme + text size,
// preventing a flash. Must stay inline (not bundled/deferred).
---

<script is:inline>
  (function () {
    try {
      var d = document.documentElement;
      // Accent theme: default is Black · Gold (no attribute). Black · Red is
      // selectable. The White · Black (light) theme stays defined but is not
      // offered in the UI, so a stale 'light' preference is intentionally ignored.
      var theme = localStorage.getItem('nk-theme');
      if (theme === 'black-red') d.setAttribute('data-theme', theme);
      var size = localStorage.getItem('nk-text-size');
      if (size === 'large' || size === 'xlarge') d.setAttribute('data-text-size', size);
      // Reader / Contributor view mode (see Header.astro). Set before paint so the
      // right nav shows with no flash. In P1, contributor recognition is a manual
      // preview flag (Ctrl+Alt+Shift+C); P2 gates it on /api/auth/me org membership.
      d.dataset.view = localStorage.getItem('nk:view') === 'contributor' ? 'contributor' : 'reader';
      if (localStorage.getItem('nk:contributor') === '1') d.dataset.contributor = 'true';
      // Default-language preference (Settings): only redirect from the home
      // roots, only once per session, never mid-browse. Manual MS/EN/ZH always wins.
      var pref = localStorage.getItem('nk-default-lang');
      if ((pref === 'ms' || pref === 'en' || pref === 'zh') && !sessionStorage.getItem('nk-lang-redirected')) {
        var p = location.pathname.replace(/\/+$/, '') || '/';
        var isHome = p === '' || p === '/' || p === '/en' || p === '/zh';
        if (isHome) {
          var cur = p === '/en' ? 'en' : p === '/zh' ? 'zh' : 'ms';
          if (cur !== pref) {
            sessionStorage.setItem('nk-lang-redirected', '1');
            location.replace(pref === 'ms' ? '/' : '/' + pref);
          }
        }
      }
    } catch (e) {}
  })();
</script>
