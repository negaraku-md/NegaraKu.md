---
import type { Locale } from '@/lib/categories';
import { localePath } from '@/lib/i18n';
import { REPO } from '@/lib/site';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string) => (locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

// Prefilled "request org access" issue (spec §12, step 2).
const requestAccessUrl =
  `${REPO}/issues/new?` +
  new URLSearchParams({
    labels: 'scope:community',
    title: 'Request access: contributor',
    body:
      "I'd like org membership so I can claim Worklist items and push branches.\n\n" +
      '**GitHub username:**\n\n**What I want to work on:**\n\n**Accepted PRs so far (links, if any):**\n',
  }).toString();

// The four cumulative roles (spec §9). Each can do everything above it, plus its
// own row. `become` explains how you get there (ties to §12).
const roles = [
  {
    key: 'reader',
    icon: '📖',
    name: L('Pembaca', 'Reader', '读者', 'வாசகர்', '読者'),
    tag: L('Terbuka untuk semua', 'Open to all', '人人可参与', 'அனைவருக்கும் திறந்தது', '誰でも参加可能'),
    open: true,
    can: [
      L('Baca setiap artikel dalam empat bahasa', 'Read every article in four languages', '以四种语言阅读所有文章', 'ஒவ்வொரு கட்டுரையையும் நான்கு மொழிகளில் படியுங்கள்', 'すべての記事を4言語で読む'),
      L('Laporkan isu atau masalah terjemahan pada mana-mana halaman', 'Report an issue or translation problem on any page', '在任意页面报告问题或翻译问题', 'எந்தப் பக்கத்திலும் ஒரு சிக்கலையோ மொழிபெயர்ப்புப் பிழையையோ புகாரளியுங்கள்', 'どのページでも問題や翻訳の不備を報告する'),
      L('Cadangkan topik baharu atau penambahbaikan laman', 'Suggest a new topic or a site improvement', '建议新主题或网站改进', 'புதிய தலைப்பையோ தளத்தின் மேம்பாட்டையோ பரிந்துரையுங்கள்', '新しいトピックやサイトの改善を提案する'),
    ],
    become: L(
      'Tiada apa-apa diperlukan untuk membaca. Untuk memfailkan maklum balas, anda hanya perlukan akaun GitHub percuma — setiap butang “Laporkan” membuka isu yang telah diisi.',
      'Nothing is needed to read. To file feedback you only need a free GitHub account — every “Report” button opens a pre-filled issue.',
      '阅读无需任何条件。提交反馈只需一个免费的 GitHub 账户——每个"报告"按钮都会打开预填的 issue。',
      'படிக்க எதுவும் தேவையில்லை. கருத்தை பதிவு செய்ய உங்களுக்கு ஒரு இலவச GitHub கணக்கு மட்டுமே தேவை — ஒவ்வொரு “புகாரளி” பொத்தானும் முன்பே நிரப்பப்பட்ட ஒரு issue-ஐ திறக்கிறது.',
      '読むのに必要なものはありません。フィードバックを送るには無料の GitHub アカウントさえあれば十分です — どの「報告」ボタンも入力済みの issue を開きます。',
    ),
  },
  {
    key: 'contributor',
    icon: '✍️',
    name: L('Penyumbang', 'Contributor', '贡献者', 'பங்களிப்பாளர்', '貢献者'),
    tag: L('Akses org', 'Org access', '组织权限', 'நிறுவன அணுகல்', '組織アクセス'),
    open: false,
    can: [
      L('Menulis dan menterjemah artikel (dipandu AI, mengikut piawai)', 'Write and translate articles (AI-guided, to standard)', '撰写和翻译文章（AI 引导，符合标准）', 'கட்டுரைகளை எழுதுங்கள், மொழிபெயருங்கள் (AI வழிகாட்டலுடன், தரத்திற்கு ஏற்ப)', '記事を執筆・翻訳する（AI 支援で基準に沿って）'),
      L('Tuntut item dalam Senarai Kerja dan kerjakannya', 'Claim an item in the Worklist and work it', '认领工作清单中的条目并处理', 'வேலைப்பட்டியலில் ஒரு உருப்படியை உரிமை கொள்ளுங்கள், அதைச் செய்யுங்கள்', '作業リストの項目を担当して取り組む'),
      L('Buka pull request; ditambah ke sejarah perubahan artikel', 'Open pull requests; added to an article’s change history', '发起 pull request；记入文章的修改历史', 'pull request-களைத் திறங்கள்; கட்டுரையின் மாற்ற வரலாற்றில் சேர்க்கப்படும்', 'pull request を開く。記事の変更履歴に加えられる'),
    ],
    become: L(
      'Sesiapa boleh menyumbang buat kali pertama melalui fork + pull request — tiada keahlian org diperlukan. Keahlian org (yang membuka penuntutan item Senarai Kerja) diberikan atas permintaan — seorang penyelenggara menjemput anda.',
      'Anyone can make a first contribution via fork + pull request — no org membership needed. Org membership (which unlocks claiming Worklist items) is granted on request — a maintainer invites you.',
      '任何人都可以通过 fork + pull request 进行首次贡献——无需组织成员资格。组织成员资格（可认领工作清单条目）经申请后由维护者邀请授予。',
      'எவரும் fork + pull request மூலம் தங்கள் முதல் பங்களிப்பைச் செய்யலாம் — நிறுவன உறுப்புரிமை தேவையில்லை. நிறுவன உறுப்புரிமை (வேலைப்பட்டியல் உருப்படிகளை உரிமை கொள்வதைத் திறக்கிறது) கோரிக்கையின் பேரில் வழங்கப்படுகிறது — ஒரு பராமரிப்பாளர் உங்களை அழைப்பார்.',
      'fork + pull request で誰でも初めての貢献ができます — 組織メンバーシップは不要です。組織メンバーシップ（作業リストの項目を担当できるようになる）は申請に応じて付与され、メンテナーが招待します。',
    ),
    cta: { label: L('Mohon akses org', 'Request org access', '申请组织权限', 'நிறுவன அணுகலைக் கோருங்கள்', '組織アクセスを申請'), href: requestAccessUrl, external: true },
  },
  {
    key: 'reviewer',
    icon: '✓',
    name: L('Penyemak', 'Reviewer', '审阅者', 'மதிப்பாய்வாளர்', 'レビュアー'),
    tag: L('Dijemput', 'Nominated', '提名', 'பரிந்துரைக்கப்பட்டவர்', '推薦制'),
    open: false,
    can: [
      L('Luluskan artikel yang telah disemak — di mana pelulus ≠ pelaksana (empat mata)', 'Approve reviewed articles — where approver ≠ the person who did the work (four-eyes)', '批准已审阅的文章——批准者 ≠ 执行者（四眼原则）', 'மதிப்பாய்வு செய்யப்பட்ட கட்டுரைகளை அங்கீகரியுங்கள் — அங்கீகரிப்பவர் ≠ வேலையைச் செய்தவர் (இரு-கண் விதி)', 'レビュー済みの記事を承認する — 承認者 ≠ 作業者（四つの目の原則）'),
      L('Tandatangani kandungan sensitif (3R+1) untuk penerbitan', 'Sign off sensitive (3R+1) content for publication', '为敏感（3R+1）内容签署发布', 'உணர்திறன்மிக்க (3R+1) உள்ளடக்கத்தை வெளியீட்டிற்காக ஒப்புதலளியுங்கள்', '扱いに注意が必要な（3R+1）内容の公開を承認する'),
      L('Beri lencana “Disemak manusia” yang menjadi asas kepercayaan laman', 'Grant the “Human-reviewed” badge that underpins the site’s trust', '授予支撑网站信任的"人工审阅"徽章', 'தளத்தின் நம்பகத்தன்மைக்கு அடிப்படையாக இருக்கும் “மனிதரால் மதிப்பாய்வு செய்யப்பட்டது” பதக்கத்தை வழங்குங்கள்', 'サイトの信頼を支える「人によるレビュー済み」バッジを付与する'),
      L('Ajukan permintaan arkib untuk topik yang usang (penyelenggara mengesahkan)', 'Raise a request to archive an outdated topic (a maintainer confirms)', '发起归档过时主题的请求（由维护者确认）', 'காலாவதியான தலைப்பை காப்பகப்படுத்த ஒரு கோரிக்கையை எழுப்புங்கள் (ஒரு பராமரிப்பாளர் உறுதிப்படுத்துகிறார்)', '古くなったトピックのアーカイブを申請する（メンテナーが確認）'),
    ],
    become: L(
      'Status Penyemak diperoleh, bukan diminta: rekod sumbangan yang bermakna, tabiat memetik sumber utama, kepakaran domain sebenar, dan neutraliti. Seorang penyelenggara mencalonkan anda melalui PR yang menambah nama anda ke scripts/health/reviewers.txt.',
      'Reviewer status is earned, not requested: a real track record, a habit of citing primary sources, genuine domain footing, and neutrality. A maintainer nominates you via a PR adding your name to scripts/health/reviewers.txt.',
      '审阅者身份是赢得的，而非申请的：真实的贡献记录、引用一手来源的习惯、真正的领域功底以及中立性。由维护者通过 PR 将你的名字加入 scripts/health/reviewers.txt 来提名。',
      'மதிப்பாய்வாளர் அந்தஸ்து கோரப்படுவதன்று, ஈட்டப்படுவது: உண்மையான பங்களிப்புப் பதிவு, முதன்மை ஆதாரங்களை மேற்கோள் காட்டும் பழக்கம், உண்மையான துறை வல்லமை, மற்றும் நடுநிலைமை. ஒரு பராமரிப்பாளர் உங்கள் பெயரை scripts/health/reviewers.txt-இல் சேர்க்கும் PR மூலம் உங்களைப் பரிந்துரைக்கிறார்.',
      'レビュアーの地位は申請するものではなく、獲得するものです。確かな実績、一次資料を引用する習慣、真の専門知識、そして中立性が求められます。メンテナーが scripts/health/reviewers.txt にあなたの名前を追加する PR であなたを推薦します。',
    ),
    cta: { label: L('Kriteria penuh penyemak', 'Full reviewer criteria', '完整审阅者标准', 'முழு மதிப்பாய்வாளர் நிபந்தனைகள்', 'レビュアーの全基準'), href: `${REPO}/blob/main/scripts/health/reviewers.txt`, external: true },
  },
  {
    key: 'maintainer',
    icon: '🛡️',
    name: L('Penyelenggara', 'Maintainer', '维护者', 'பராமரிப்பாளர்', 'メンテナー'),
    tag: L('Akses tulis repo', 'Repo write', '仓库写入', 'களஞ்சிய எழுது அணுகல்', 'リポジトリ書き込み'),
    open: false,
    can: [
      L('Triaj maklum balas pembaca ke dalam barisan kerja', 'Triage reader feedback into the work queues', '将读者反馈分流到工作队列', 'வாசகர் கருத்துகளை வேலை வரிசைகளுக்குள் வகைப்படுத்துங்கள்', '読者のフィードバックを作業キューに振り分ける'),
      L('Sahkan pengarkiban dan kendalikan lata ke semua terjemahan', 'Confirm archival and handle the cascade to all translations', '确认归档并处理向所有翻译的级联', 'காப்பகப்படுத்தலை உறுதிப்படுத்தி, அனைத்து மொழிபெயர்ப்புகளுக்கும் ஏற்படும் அடுக்கு விளைவைக் கையாளுங்கள்', 'アーカイブを確認し、すべての翻訳への波及を処理する'),
      L('Jemput penyumbang baharu; gabungkan pull request', 'Invite new contributors; merge pull requests', '邀请新贡献者；合并 pull request', 'புதிய பங்களிப்பாளர்களை அழையுங்கள்; pull request-களை ஒன்றிணையுங்கள்', '新しい貢献者を招待する。pull request をマージする'),
    ],
    become: L(
      'Penyelenggara ialah penyumbang dan penyemak yang dipercayai yang mengambil tanggungjawab operasi. Diberikan oleh penyelenggara sedia ada apabila keperluan dan kepercayaan wujud.',
      'Maintainers are trusted contributors and reviewers who take on operational responsibility. Granted by existing maintainers when the need and the trust are there.',
      '维护者是承担运营职责的受信任贡献者和审阅者。在需要与信任具备时，由现有维护者授予。',
      'பராமரிப்பாளர்கள் என்பவர்கள் செயல்பாட்டுப் பொறுப்பை ஏற்கும் நம்பகமான பங்களிப்பாளர்களும் மதிப்பாய்வாளர்களும் ஆவர். தேவையும் நம்பிக்கையும் இருக்கும்போது தற்போதுள்ள பராமரிப்பாளர்களால் வழங்கப்படுகிறது.',
      'メンテナーは、運用上の責任を担う信頼された貢献者およびレビュアーです。必要性と信頼がそろったとき、既存のメンテナーによって付与されます。',
    ),
  },
];
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム'), href: localePath('/', locale) },
    { label: L('Peranan', 'Roles', '角色', 'பங்குகள்', '役割') },
  ]}
  title={L('Peranan & cara ia berfungsi', 'Roles & how it works', '角色与运作方式', 'பங்குகளும் அவை எவ்வாறு இயங்குகின்றன என்பதும்', '役割と仕組み')}
  desc={L(
    'Empat peranan terkumpul. Setiap satu boleh melakukan segala di atasnya, ditambah keupayaannya sendiri — daripada membaca hingga menyelenggara.',
    'Four cumulative roles. Each can do everything above it, plus its own — from reading all the way to maintaining.',
    '四个累进的角色。每个角色都能做其上方的一切，外加自身的能力——从阅读一直到维护。',
    'நான்கு படிப்படியான பங்குகள். ஒவ்வொன்றும் தனக்கு மேலுள்ள அனைத்தையும் செய்ய முடியும், அத்துடன் தன் சொந்த திறனையும் — படிப்பதிலிருந்து பராமரிப்பது வரை.',
    '4つの累積的な役割。各役割はその上位のすべてに加えて自身の権限も持ちます — 読むことから保守まで。',
  )}
/>

<!-- Cumulative ladder -->
<section class="container block">
  <div class="ladder" aria-hidden="true">
    {roles.map((r, i) => (
      <>
        <span class="rung">{r.icon} {r.name}</span>
        {i < roles.length - 1 && <span class="rung-join">⊂</span>}
      </>
    ))}
  </div>
  <p class="ladder-note">{L('“⊂” bermaksud “termasuk dalam” — keupayaan terkumpul ke kanan.', '“⊂” means “is included in” — capabilities accumulate to the right.', '"⊂" 表示"包含于"——能力向右累积。', '“⊂” என்பது “உள்ளடங்குகிறது” எனப் பொருள்படும் — திறன்கள் வலப்பக்கம் சேர்கின்றன.', '「⊂」は「に含まれる」を意味します — 権限は右へ累積します。')}</p>
</section>

<!-- Role cards -->
<section class="container block roles">
  {roles.map((r) => (
    <div class={`psec role-${r.key}`}>
      <header>
        <span class="rh"><span class="ri" aria-hidden="true">{r.icon}</span>{r.name}</span>
        <span class={`rtag ${r.open ? 'open' : 'gated'}`}>{r.tag}</span>
      </header>
      <div class="psec-body">
        <b class="sub">{L('Apa anda boleh buat', 'What you can do', '你能做什么', 'நீங்கள் என்ன செய்யலாம்', 'できること')}</b>
        <ul class="can">
          {r.can.map((c) => <li>{c}</li>)}
        </ul>
        <b class="sub">{L('Cara menjadi satu', 'How to become one', '如何成为', 'எப்படி ஒருவராவது', 'なり方')}</b>
        <p class="become">{r.become}</p>
        {r.cta && (
          <a class="btn btn-ghost" href={r.cta.href} {...(r.cta.external ? { rel: 'noopener' } : {})}>
            {r.cta.label} ↗
          </a>
        )}
      </div>
    </div>
  ))}
</section>

<!-- Get access ladder (§12) -->
<section class="container block">
  <div class="psec">
    <header><span>{L('Mendapat akses', 'Getting access', '获取权限', 'அணுகல் பெறுதல்', 'アクセスの取得')}</span></header>
    <div class="psec-body">
      <ol class="access">
        <li>
          <b>{L('Sumbang dengan akaun GitHub sendiri', 'Contribute with your own GitHub account', '用你自己的 GitHub 账户贡献', 'உங்கள் சொந்த GitHub கணக்குடன் பங்களியுங்கள்', '自分の GitHub アカウントで貢献する')}</b>
          <span>{L('Fork + pull request. Tiada keahlian org diperlukan untuk sumbangan pertama.', 'Fork + pull request. No org membership needed for a first contribution.', 'Fork + pull request。首次贡献无需组织成员资格。', 'Fork + pull request. முதல் பங்களிப்பிற்கு நிறுவன உறுப்புரிமை தேவையில்லை.', 'Fork + pull request。初めての貢献に組織メンバーシップは不要です。')}</span>
        </li>
        <li>
