---
import type { Locale } from '@/lib/categories';
import { loc } from '@/lib/categories';
import { MILESTONES } from '@/lib/milestones';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string) =>
  (locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

// Newest first.
const items = [...MILESTONES].sort((a, b) => (a.date < b.date ? 1 : -1));
const dateFmt = (d: string) =>
  new Date(d).toLocaleDateString(locale === 'zh' ? 'zh-Hans' : locale === 'ms' ? 'ms-MY' : locale === 'ta' ? 'ta-MY' : locale === 'ja' ? 'ja-JP' : locale === 'ko' ? 'ko-KR' : locale === 'th' ? 'th-TH' : 'en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
---

<section class="container block">
  <p class="eyebrow">{L('Projek', 'Project', '项目', 'திட்டம்', 'プロジェクト', '프로젝트', 'โครงการ')}</p>
  <h1>{L('Pencapaian Penting', 'Milestones', '里程碑', 'மைல்கற்கள்', 'マイルストーン', '주요 이정표', 'เหตุการณ์สำคัญ')}</h1>
  <p class="lede">
    {L(
      'Perjalanan NegaraKu.md setakat ini — detik-detik penting yang menandakan sejauh mana pangkalan pengetahuan ini telah berkembang.',
      'The journey of NegaraKu.md so far — the moments that mark how far this knowledge base has come.',
      'NegaraKu.md 至今的历程——标记这个知识库走了多远的重要时刻。',
      'NegaraKu.md-இன் இதுவரையிலான பயணம் — இந்த அறிவுத் தளம் எவ்வளவு தூரம் வளர்ந்துள்ளது என்பதைக் குறிக்கும் தருணங்கள்.',
      'NegaraKu.md のこれまでの歩み — この知識ベースがどこまで来たかを刻む節目の数々。',
      'NegaraKu.md의 지금까지의 여정 — 이 지식 베이스가 얼마나 발전해 왔는지를 보여주는 순간들.',
      'เส้นทางของ NegaraKu.md จนถึงปัจจุบัน — ช่วงเวลาสำคัญที่บ่งบอกว่าฐานความรู้นี้ได้ก้าวหน้ามาไกลเพียงใด',
    )}
  </p>

  <ol class="timeline">
    {
      items.map((m) => (
        <li class="ms-item">
          <span class="dot" aria-hidden="true">{m.icon}</span>
          <div class="ms-body">
            <time datetime={m.date} class="ms-date">{dateFmt(m.date)}</time>
            <h2 class="ms-title">{loc(m.title, locale)}</h2>
            <p class="ms-text">{loc(m.body, locale)}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <p class="note">
    {L(
      'Untuk sejarah penuh setiap perubahan, lihat Log Perubahan.',
      'For the full history of every change, see the Changelog.',
      '如需查看每一次变更的完整历史，请参阅更新日志。',
      'ஒவ்வொரு மாற்றத்தின் முழு வரலாற்றுக்கும், மாற்ற பதிவைப் பார்க்கவும்.',
      'すべての変更の完全な履歴は、変更ログをご覧ください。',
      '모든 변경 사항의 전체 기록은 변경 로그를 참조하세요.',
      'สำหรับประวัติทั้งหมดของทุกการเปลี่ยนแปลง โปรดดูที่บันทึกการเปลี่ยนแปลง',
    )}
  </p>
</section>

<style>
  .eyebrow { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); font-weight: 700; margin: 0 0 0.4rem; }
  h1 { margin: 0 0 0.5rem; }
  .lede { color: var(--ink-soft); max-width: 64ch; margin: 0 0 2.4rem; }

  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  /* The vertical spine. */
  .timeline::before {
    content: ''; position: absolute; left: 1.15rem; top: 0.6rem; bottom: 0.6rem;
    width: 2px; background: linear-gradient(var(--gold), color-mix(in srgb, var(--gold) 20%, transparent));
  }
  .ms-item { position: relative; display: flex; gap: 1.1rem; padding: 0 0 1.9rem 0; }
  .ms-item:last-child { padding-bottom: 0; }
  .dot {
    flex: 0 0 auto; width: 2.35rem; height: 2.35rem; border-radius: 50%;
    display: grid; place-items: center; font-size: 1.15rem;
    background: var(--surface); border: 1px solid var(--line);
    box-shadow: 0 0 0 4px var(--bg); z-index: 1;
  }
  .ms-body { padding-top: 0.15rem; }
  .ms-date { display: block; font-size: 0.76rem; letter-spacing: 0.04em; color: var(--gold); font-weight: 700; text-transform: uppercase; }
  .ms-title { font-size: 1.15rem; margin: 0.15rem 0 0.35rem; }
  .ms-text { color: var(--ink-soft); margin: 0; max-width: 64ch; }
  .note { color: var(--muted); font-size: 0.83rem; margin-top: 2.2rem; }
</style>
