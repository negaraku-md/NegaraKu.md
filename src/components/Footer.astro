---
import type { Locale } from '@/lib/categories';
import { t, localePath } from '@/lib/i18n';
import { REPO, GA_MEASUREMENT_ID } from '@/lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string, ar?: string, hi?: string, es?: string, fr?: string) => (locale === 'fr' ? (fr ?? ms) : locale === 'es' ? (es ?? ms) : locale === 'hi' ? (hi ?? ms) : locale === 'ar' ? (ar ?? ms) : locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);
const year = 2026;

const cols = [
  {
    title: L('Terokai', 'Explore', '探索', 'ஆராயுங்கள்', '探索', '탐색', 'สำรวจ', 'Khám phá', 'Jelajahi', 'استكشف', 'अन्वेषण करें', 'Explorar', 'Explorer'),
    links: [
      { label: t('nav.understand', locale), href: localePath('/understand', locale) },
      { label: t('nav.living', locale), href: localePath('/living', locale) },
      { label: t('nav.business', locale), href: localePath('/doing-business', locale) },
      { label: t('nav.articles', locale), href: localePath('/articles', locale) },
    ],
  },
  {
    title: L('Projek', 'Project', '项目', 'திட்டம்', 'プロジェクト', '프로젝트', 'โครงการ', 'Dự án', 'Proyek', 'المشروع', 'परियोजना', 'Proyecto', 'Projet'),
    links: [
      { label: t('nav.aboutPage', locale), href: localePath('/about', locale) },
      { label: t('nav.dashboard', locale), href: localePath('/dashboard', locale) },
      { label: t('nav.changelog', locale), href: localePath('/changelog', locale) },
      { label: t('nav.contribute', locale), href: localePath('/contribute', locale) },
      { label: L('Tetapan', 'Settings', '设置', 'அமைப்புகள்', '設定', '설정', 'การตั้งค่า', 'Cài đặt', 'Pengaturan', 'الإعدادات', 'सेटिंग्स', 'Configuración', 'Paramètres'), href: localePath('/settings', locale) },
    ],
  },
  {
    title: L('Untuk AI', 'For AI', '面向 AI', 'AI-க்கு', 'AI 向け', 'AI를 위해', 'สำหรับ AI', 'Dành cho AI', 'Untuk AI', 'لـ AI', 'AI के लिए', 'Para IA', "Pour l'IA"),
    links: [
      { label: 'llms.txt', href: localePath('/llms', locale) },
      { label: 'GitHub', href: REPO, ext: true },
    ],
  },
];
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <p class="name">NegaraKu<span class="dot">.md</span></p>
        <p class="tagline">{t('site.tagline', locale)}</p>
        <p class="sponsor">
          {t('footer.sponsoredBy', locale)}{' '}
          <a href="https://www.1company.com" rel="noopener"><span class="oneco">1company.com</span></a>
        </p>
      </div>
      {
        cols.map((col) => (
          <nav class="foot-col" aria-label={col.title}>
            <p class="col-title">{col.title}</p>
            {col.links.map((l) => (
              <a href={l.href} rel={l.ext ? 'noopener' : undefined}>{l.label}{l.ext ? ' ↗' : ''}</a>
            ))}
          </nav>
        ))
      }
    </div>
  </div>

  <div class="container legal">
    <p>© {year} <span class="wm">NegaraKu<span class="dot">.md</span></span> · {t('footer.license', locale)}</p>
    <nav class="legal-links" aria-label={L('Undang-undang', 'Legal', '法律', 'சட்டம்', '法務', '법률', 'กฎหมาย', 'Pháp lý', 'Hukum', 'قانوني', 'कानूनी', 'Legal', 'Informations juridiques')}>
      <a href={localePath('/terms', locale)}>{L('Terma Penggunaan', 'Terms of Use', '使用条款', 'பயன்பாட்டு விதிமுறைகள்', '利用規約', '이용약관', 'ข้อกำหนดการใช้งาน', 'Điều khoản Sử dụng', 'Ketentuan Penggunaan', 'شروط الاستخدام', 'उपयोग की शर्तें', 'Términos de uso', "Conditions d'utilisation")}</a>
      <a href={localePath('/privacy', locale)}>{L('Dasar Privasi', 'Privacy Policy', '隐私政策', 'தனியுரிமைக் கொள்கை', 'プライバシーポリシー', '개인정보 처리방침', 'นโยบายความเป็นส่วนตัว', 'Chính sách Bảo mật', 'Kebijakan Privasi', 'سياسة الخصوصية', 'गोपनीयता नीति', 'Política de privacidad', 'Politique de confidentialité')}</a>
      <a href={localePath('/cookies', locale)}>{L('Dasar Kuki', 'Cookie Policy', 'Cookie 政策', 'குக்கீக் கொள்கை', 'クッキーポリシー', '쿠키 정책', 'นโยบายคุกกี้', 'Chính sách Cookie', 'Kebijakan Cookie', 'سياسة ملفات تعريف الارتباط', 'कुकी नीति', 'Política de cookies', 'Politique relative aux cookies')}</a>
      {GA_MEASUREMENT_ID && (
        <button type="button" class="legal-link-btn" onclick="window.__nkConsentOpen && window.__nkConsentOpen()">{L('Tetapan kuki', 'Cookie settings', 'Cookie 设置', 'குக்கீ அமைப்புகள்', 'Cookie 設定', '쿠키 설정', 'การตั้งค่าคุกกี้', 'Cài đặt cookie', 'Pengaturan cookie', 'إعدادات ملفات تعريف الارتباط', 'कुकी सेटिंग्स', 'Configuración de cookies', 'Paramètres des cookies')}</button>
      )}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--line);
    background: var(--bg-soft);
    padding-top: 2.5rem;
  }
  .foot-grid {
    display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 1.5rem 2rem;
    padding-bottom: 2rem;
  }
  /* Match the header/title wordmark exactly: same font, weight, size and colour. */
  .name { font-family: var(--font-title); font-weight: 700; font-size: 1.2rem; margin: 0; color: var(--ink); }
  .name .dot { color: var(--gold); }
  /* Copyright wordmark follows the brand standard: NegaraKu in ink, .md in gold. */
  .legal .wm { color: var(--ink); font-weight: 700; }
  .legal .dot { color: var(--gold); }
  .tagline { color: var(--muted); margin: 0.4rem 0 0; font-size: 0.9rem; max-width: 34ch; }
  .sponsor { margin: 0.7rem 0 0; font-size: 0.9rem; color: var(--ink-soft); }
  .sponsor a { color: var(--gold); font-weight: 700; text-decoration: none; }

  .foot-col { display: flex; flex-direction: column; gap: 0.55rem; }
  .col-title {
    margin: 0 0 0.3rem; font-family: var(--font-title); font-size: 0.72rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink);
  }
  .foot-col a { color: var(--ink-soft); text-decoration: none; font-size: 0.92rem; }
  .foot-col a:hover { color: var(--gold); }

  .legal {
    border-top: 1px solid var(--line);
    padding-block: 1.1rem 1.4rem;
    color: var(--muted); font-size: 0.82rem;
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; align-items: center; justify-content: space-between;
  }
  .legal p { margin: 0; }
  .legal-links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; }
  .legal-links a { color: var(--muted); text-decoration: none; }
  .legal-links a:hover { color: var(--gold); }
  /* Cookie-settings reopen: a button that reads as one of the legal links. */
  .legal-link-btn {
    font: inherit;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .legal-link-btn:hover { color: var(--gold); }

  @media (max-width: 720px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
    .foot-brand { grid-column: 1 / -1; }
  }
</style>
