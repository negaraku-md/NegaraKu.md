---
import type { Locale } from '@/lib/categories';
import { t, localePath } from '@/lib/i18n';
import { REPO } from '@/lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);
const year = 2026;

const cols = [
  {
    title: L('Terokai', 'Explore', '探索'),
    links: [
      { label: t('nav.understand', locale), href: localePath('/understand', locale) },
      { label: t('nav.living', locale), href: localePath('/living', locale) },
      { label: t('nav.business', locale), href: localePath('/doing-business', locale) },
      { label: t('nav.articles', locale), href: localePath('/articles', locale) },
    ],
  },
  {
    title: L('Projek', 'Project', '项目'),
    links: [
      { label: t('nav.aboutPage', locale), href: localePath('/about', locale) },
      { label: t('nav.contribute', locale), href: localePath('/contribute', locale) },
      { label: t('nav.dashboard', locale), href: localePath('/dashboard', locale) },
      { label: t('nav.changelog', locale), href: localePath('/changelog', locale) },
      { label: L('Tetapan', 'Settings', '设置'), href: localePath('/settings', locale) },
    ],
  },
  {
    title: L('Untuk AI', 'For AI', '面向 AI'),
    links: [
      { label: 'llms.txt', href: '/llms.txt' },
      { label: 'GitHub', href: REPO, ext: true },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <p class="name">NegaraKu<span class="dot">.md</span></p>
        <p class="tagline">{t('site.tagline', locale)}</p>
        <p class="sponsor">
          {t('footer.sponsoredBy', locale)}{' '}
          <a href="https://www.1company.com" rel="noopener"><span class="oneco">1company.com</span></a>
        </p>
      </div>
      {
        cols.map((col) => (
          <nav class="foot-col" aria-label={col.title}>
            <p class="col-title">{col.title}</p>
            {col.links.map((l) => (
              <a href={l.href} rel={l.ext ? 'noopener' : undefined}>{l.label}{l.ext ? ' ↗' : ''}</a>
            ))}
          </nav>
        ))
      }
    </div>
  </div>

  <div class="container legal">
    <p>© {year} <span class="wm">NegaraKu<span class="dot">.md</span></span> · {t('footer.license', locale)}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--line);
    background: var(--bg-soft);
    padding-top: 2.5rem;
  }
  .foot-grid {
    display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 1.5rem 2rem;
    padding-bottom: 2rem;
  }
  /* Match the header/title wordmark exactly: same font, weight, size and colour. */
  .name { font-family: var(--font-title); font-weight: 700; font-size: 1.2rem; margin: 0; color: var(--ink); }
  .name .dot { color: var(--gold); }
  /* Copyright wordmark follows the brand standard: NegaraKu in ink, .md in gold. */
  .legal .wm { color: var(--ink); font-weight: 700; }
  .legal .dot { color: var(--gold); }
  .tagline { color: var(--muted); margin: 0.4rem 0 0; font-size: 0.9rem; max-width: 34ch; }
  .sponsor { margin: 0.7rem 0 0; font-size: 0.9rem; color: var(--ink-soft); }
  .sponsor a { color: var(--gold); font-weight: 700; text-decoration: none; }

  .foot-col { display: flex; flex-direction: column; gap: 0.55rem; }
  .col-title {
    margin: 0 0 0.3rem; font-family: var(--font-title); font-size: 0.72rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted);
  }
  .foot-col a { color: var(--ink-soft); text-decoration: none; font-size: 0.92rem; }
  .foot-col a:hover { color: var(--gold); }

  .legal {
    border-top: 1px solid var(--line);
    padding-block: 1.1rem 1.4rem;
    color: var(--muted); font-size: 0.82rem;
  }
  .legal p { margin: 0; }

  @media (max-width: 720px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
    .foot-brand { grid-column: 1 / -1; }
    .nl-row input { min-width: 0; flex: 1; }
  }
</style>
