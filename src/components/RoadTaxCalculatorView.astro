---
// Malaysia Road Tax (LKM) calculator — SCOPED to private saloon cars registered
// in Peninsular Malaysia (the only fully-published JPJ band formula). Other
// classes send the reader to the official MyJPJ calculator. Engine: roadTax.ts.
import type { Locale } from '@/lib/categories';
import { localePath } from '@/lib/i18n';
import { resolveSponsor, sponsorUrl } from '@/lib/sponsors';
import SponsorCTA from './SponsorCTA.astro';
import PageHero from './PageHero.astro';
import { computeRoadTax, ROAD_TAX } from '@/lib/tax/roadTax';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

const sponsor = resolveSponsor(undefined, undefined, false, 'finance', 'road-tax-calculator');
const sponsorHref = sponsor ? sponsorUrl(sponsor, 'tools', 'road-tax-calculator') : '';

const ui = {
  cc: L('Kapasiti enjin (cc)', 'Engine capacity (cc)', '引擎容量 (cc)'),
  annual: L('Cukai jalan setahun', 'Annual road tax', '每年路税'),
  band: L('Jalur', 'Band', '级距'),
  myjpj: L('Buka kalkulator rasmi MyJPJ', 'Open the official MyJPJ calculator', '打开官方 MyJPJ 计算器'),
};

const faqs = [
  {
    q: L('Bagaimana cukai jalan dikira?', 'How is road tax calculated?', '路税如何计算？'),
    a: L('Bagi kereta saloon persendirian di Semenanjung, kadarnya rata sehingga 1,600cc (RM20/55/70/90), kemudian kadar asas campur caj setiap cc di atas 1,600cc. Contoh: 1,500cc = RM90; 2,000cc = RM380; 3,000cc = RM2,130.',
         'For a private saloon in Peninsular Malaysia the rate is flat up to 1,600cc (RM20/55/70/90), then a base rate plus a per-cc charge above 1,600cc. Example: 1,500cc = RM90; 2,000cc = RM380; 3,000cc = RM2,130.',
         '对半岛的私人轿车，1,600cc 以下为统一费率（RM20/55/70/90），1,600cc 以上则为基本费率加每 cc 附加费。例如：1,500cc = RM90；2,000cc = RM380；3,000cc = RM2,130。'),
  },
  {
    q: L('Mengapa alat ini hanya untuk saloon di Semenanjung?', 'Why is this tool only for Peninsular saloons?', '为何此工具仅适用于半岛轿车？'),
    a: L('Kadar bukan-saloon (SUV/MPV/pikap), Sabah/Sarawak, kenderaan syarikat, motosikal dan EV (jadual kW baharu 2026) menggunakan jadual berbeza yang tidak diterbitkan sepenuhnya. Untuk kes ini, gunakan kalkulator rasmi MyJPJ.',
         'Non-saloon (SUV/MPV/pick-up), Sabah/Sarawak, company-registered, motorcycle and EV (the new 2026 kW schedule) rates follow different, not-fully-published schedules. For those, use the official MyJPJ calculator.',
         '非轿车（SUV/MPV/皮卡）、沙巴/砂拉越、公司注册、摩托车及电动车（2026 年新 kW 表）采用未完全公布的不同费率表。这些情况请使用官方 MyJPJ 计算器。'),
  },
  {
    q: L('Apa berlaku jika cukai jalan tamat tempoh?', 'What happens if road tax lapses?', '路税过期会怎样？'),
    a: L('Memandu dengan LKM tamat tempoh ialah kesalahan di bawah Akta Pengangkutan Jalan 1987 (kompaun sehingga RM3,000), dan yang lebih teruk, insurans motor anda terbatal secara automatik sebaik sahaja cukai jalan tamat. Lebih 12 bulan tamat memerlukan pemeriksaan Puspakom.',
         'Driving on an expired LKM is an offence under the Road Transport Act 1987 (compound up to RM3,000), and worse, your motor insurance is automatically voided the moment road tax expires. More than 12 months lapsed needs a Puspakom inspection.',
         '驾驶路税过期车辆属《1987 年陆路交通法令》下的罪行（罚款高达 RM3,000），更严重的是路税一过期，车险即自动失效。过期逾 12 个月需经 Puspakom 检验。'),
  },
];

const title = L('Kalkulator Cukai Jalan Malaysia', 'Malaysia Road Tax Calculator', '马来西亚路税计算器');
const heroDesc = L(
  'Kira cukai jalan (LKM) tahunan untuk kereta saloon persendirian di Semenanjung mengikut kapasiti enjin. Semua dalam pelayar.',
  'Work out the annual road tax (LKM) for a private saloon car in Peninsular Malaysia by engine capacity. All in your browser.',
  '按引擎容量计算半岛私人轿车的每年路税（LKM）。全部在浏览器中运行。',
);

const demo = computeRoadTax(1500);
const scopeNote = L(
  'Saloon persendirian, Semenanjung Malaysia sahaja. Untuk SUV/MPV/pikap, Sabah/Sarawak, kenderaan syarikat, motosikal atau EV, gunakan kalkulator rasmi MyJPJ.',
  'Private saloon cars, Peninsular Malaysia only. For SUV/MPV/pick-up, Sabah/Sarawak, company-registered, motorcycles or EVs, use the official MyJPJ calculator.',
  '仅限半岛私人轿车。SUV/MPV/皮卡、沙巴/砂拉越、公司注册、摩托车或电动车，请使用官方 MyJPJ 计算器。',
);
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页'), href: localePath('/', locale) },
    { label: L('Alat', 'Tools', '工具'), href: localePath('/tools', locale) },
    { label: title },
  ]}
  title={title}
  desc={heroDesc}
/>

<section class="container block">
  <div class="itc" id="rtx">
    <div class="itc-form">
      <label class="itc-field">
        <span>{ui.cc}</span>
        <input type="number" id="rtx-cc" min="0" step="50" value="1500" inputmode="numeric" />
      </label>
      <p class="itc-scope">{scopeNote} <a href="https://mysikap.jpj.gov.my/" target="_blank" rel="noopener noreferrer">{ui.myjpj} ↗</a></p>
    </div>

    <div class="itc-out">
      <p class="itc-asof">{L('Kadar setakat', 'Rates as of', '费率截至')} {ROAD_TAX.asOf} · {L('Akta Pengangkutan Jalan 1987', 'Road Transport Act 1987', '《1987年陆路交通法令》')}</p>
      <div class="itc-headline">
        <span class="itc-label">{ui.annual}</span>
        <span class="itc-amount" id="rtx-annual">RM{demo.annual.toLocaleString('en-MY')}</span>
        <span class="itc-sub"><span id="rtx-band">{demo.bandLabel}</span></span>
      </div>
    </div>
  </div>

  {sponsor && <SponsorCTA locale={locale} sponsor={sponsor} href={sponsorHref} placement="inline" />}

  <div class="itc-prose">
    <h2>{L('Soalan lazim', 'Frequently asked', '常见问题')}</h2>
    <dl class="itc-faq">{faqs.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}</dl>

    <h3>{L('Bacaan berkaitan', 'Related reading', '相关阅读')}</h3>
    <ul class="itc-links">
      <li><a href={localePath('/transport/road-tax-renewal', locale)}>{L('Pembaharuan cukai jalan (LKM)', 'Road tax (LKM) renewal', '路税（LKM）更新')}</a></li>
      <li><a href={localePath('/tools/car-loan-calculator', locale)}>{L('Kalkulator pinjaman kereta', 'Car loan calculator', '车贷计算器')}</a></li>
      <li><a href={localePath('/transport/puspakom-vehicle-inspections', locale)}>{L('Pemeriksaan Puspakom', 'Puspakom inspections', 'Puspakom 检验')}</a></li>
    </ul>

    <h3>{L('Sumber', 'Sources', '来源')}</h3>
    <ul class="itc-src">{ROAD_TAX.sources.map((s) => (<li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a></li>))}</ul>

    <p class="itc-disclaimer">{L(
      'Alat ini menganggarkan cukai jalan saloon persendirian Semenanjung sahaja dan bukan angka rasmi. Sahkan jumlah tepat kenderaan anda dalam aplikasi MyJPJ.',
      'This tool estimates Peninsular private-saloon road tax only and is not an official figure. Confirm your vehicle’s exact amount in the MyJPJ app.',
      '本工具仅估算半岛私人轿车路税，非官方数字。请在 MyJPJ 应用中核实您车辆的确切金额。',
    )}</p>
  </div>
</section>

<script>
  import { computeRoadTax } from '@/lib/tax/roadTax';
  const root = document.getElementById('rtx');
  if (root) {
    const $ = (id) => document.getElementById(id);
    function recompute() {
      const cc = parseInt(($('rtx-cc') as HTMLInputElement).value, 10);
      const r = computeRoadTax(Number.isFinite(cc) ? cc : 0);
      ($('rtx-annual') as HTMLElement).textContent = 'RM' + r.annual.toLocaleString('en-MY');
      ($('rtx-band') as HTMLElement).textContent = r.bandLabel;
    }
    root.addEventListener('input', recompute);
    recompute();
  }
</script>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'SoftwareApplication', name: title, applicationCategory: 'FinanceApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'MYR' }, description: heroDesc },
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
})} />

<style>
  .itc { display: grid; grid-template-columns: 1.3fr 1fr; gap: 1.5rem; align-items: start; }
  @media (max-width: 860px) { .itc { grid-template-columns: 1fr; } }
  .itc-form { display: grid; gap: 1.1rem; }
  .itc-field { display: grid; gap: 0.35rem; font-size: 0.9rem; }
  .itc-field > span { font-weight: 600; color: var(--ink-soft); }
  .itc-field input { font: inherit; padding: 0.55rem 0.7rem; border-radius: 8px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); }
  .itc-field input:focus { outline: 2px solid var(--gold); outline-offset: 1px; }
  .itc-scope { font-size: 0.82rem; line-height: 1.6; color: var(--ink-soft); padding: 0.8rem 1rem; background: color-mix(in srgb, var(--gold) 6%, var(--surface, transparent)); border: 1px solid color-mix(in srgb, var(--gold) 30%, transparent); border-radius: 10px; }
  .itc-scope a { color: var(--gold); white-space: nowrap; }
  .itc-out { position: sticky; top: 1rem; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 1.2rem 1.3rem; }
  .itc-asof { margin: 0 0 0.8rem; font-size: 0.72rem; color: var(--muted); }
  .itc-headline { display: grid; gap: 0.15rem; }
  .itc-label { font-size: 0.8rem; color: var(--ink-soft); font-weight: 600; }
  .itc-amount { font-size: 2.1rem; font-weight: 800; color: var(--gold); line-height: 1.1; }
  .itc-sub { font-size: 0.85rem; color: var(--muted); }
  .itc-prose { max-width: 58rem; margin-top: 2.5rem; }
  .itc-prose h2 { font-size: 1.15rem; margin: 2rem 0 0.7rem; }
  .itc-prose h3 { font-size: 1rem; margin: 1.6rem 0 0.5rem; }
  .itc-faq dt { font-weight: 700; margin-top: 1rem; }
  .itc-faq dd { margin: 0.3rem 0 0; color: var(--ink-soft); line-height: 1.7; }
  .itc-links, .itc-src { padding-left: 1.1rem; line-height: 1.9; }
  .itc-src { font-size: 0.85rem; }
  .itc-src a, .itc-links a { color: var(--gold); }
  .itc-disclaimer { margin: 1.4rem 0 0; padding: 0.8rem 1rem; font-size: 0.82rem; line-height: 1.6; color: var(--ink-soft); background: color-mix(in srgb, var(--gold) 6%, var(--surface, transparent)); border: 1px solid color-mix(in srgb, var(--gold) 30%, transparent); border-radius: 10px; }
</style>
