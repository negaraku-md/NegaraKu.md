---
import type { Locale } from '@/lib/categories';
import { t } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="container graph-head">
  <h1>{t('graph.title', locale)}</h1>
  <p class="hint">{t('graph.hint', locale)}</p>
</section>

<div class="graph-wrap">
  <svg id="graph" role="img" aria-label={t('graph.title', locale)} data-locale={locale}></svg>
  <div id="graph-tooltip" class="tooltip" hidden></div>
</div>

<script>
  import * as d3 from 'd3';

  async function draw() {
    const svgEl = document.getElementById('graph');
    if (!svgEl) return;
    const locale = svgEl.dataset.locale || 'ms';
    const localePrefix = locale === 'ms' ? '' : `/${locale}`;
    let data;
    try {
      const res = await fetch('/api/graph.json');
      data = await res.json();
    } catch {
      return;
    }
    if (!data?.nodes?.length) {
      svgEl.innerHTML = '';
      return;
    }

    const width = svgEl.clientWidth || 900;
    const height = 620;
    const svg = d3.select(svgEl).attr('viewBox', `0 0 ${width} ${height}`);
    svg.selectAll('*').remove();
    const root = svg.append('g');

    const categories = [...new Set(data.nodes.map((n) => n.category))];
    // 1company data-viz accents on dark.
    const palette = [
      '#FFC000', '#F5A623', '#10B981', '#6366F1', '#A78BFA',
      '#F43F5E', '#38BDF8', '#FB923C', '#34D399', '#E879F9',
      '#FBBF24', '#22D3EE', '#F87171', '#818CF8', '#4ADE80', '#C084FC',
    ];
    const color = d3.scaleOrdinal(categories, palette);

    const links = data.links.map((d) => ({ ...d }));
    const nodes = data.nodes.map((d) => ({ ...d }));

    const sim = d3
      .forceSimulation(nodes)
      .force('link', d3.forceLink(links).id((d) => d.id).distance(70).strength(0.4))
      .force('charge', d3.forceManyBody().strength(-160))
      .force('center', d3.forceCenter(width / 2, height / 2))
      .force('collide', d3.forceCollide().radius((d) => 6 + d.weight * 2));

    const link = root
      .append('g')
      .attr('stroke', '#3a3a48')
      .attr('stroke-opacity', 0.7)
      .selectAll('line')
      .data(links)
      .join('line')
      .attr('stroke-width', (d) => (d.kind === 'related' ? 1.6 : 0.7));

    const node = root
      .append('g')
      .selectAll('a')
      .data(nodes)
      .join('a')
      .attr('href', (d) => `${localePrefix}/${d.category}/${d.slug}`)
      .attr('cursor', 'pointer')
      .call(
        d3
          .drag()
          .on('start', (event, d) => {
            if (!event.active) sim.alphaTarget(0.3).restart();
            d.fx = d.x;
            d.fy = d.y;
          })
          .on('drag', (event, d) => {
            d.fx = event.x;
            d.fy = event.y;
          })
          .on('end', (event, d) => {
            if (!event.active) sim.alphaTarget(0);
            d.fx = null;
            d.fy = null;
          }),
      );

    node
      .append('circle')
      .attr('r', (d) => 5 + d.weight * 1.6)
      .attr('fill', (d) => color(d.category))
      .attr('stroke', '#07070a')
      .attr('stroke-width', 1.5);

    node
      .append('text')
      .text((d) => d.title)
      .attr('x', (d) => 8 + d.weight * 1.6)
      .attr('y', 4)
      .attr('font-size', 11)
      .attr('fill', '#c0c0d0')
      .attr('paint-order', 'stroke')
      .attr('stroke', '#07070a')
      .attr('stroke-width', 3);

    const tooltip = document.getElementById('graph-tooltip');
    node
      .on('mouseenter', (event, d) => {
        if (!tooltip) return;
        tooltip.hidden = false;
        tooltip.textContent = `${d.title} · ${d.category}`;
        tooltip.style.left = event.offsetX + 12 + 'px';
        tooltip.style.top = event.offsetY + 12 + 'px';
      })
      .on('mouseleave', () => tooltip && (tooltip.hidden = true));

    sim.on('tick', () => {
      link
        .attr('x1', (d) => d.source.x)
        .attr('y1', (d) => d.source.y)
        .attr('x2', (d) => d.target.x)
        .attr('y2', (d) => d.target.y);
      node.attr('transform', (d) => `translate(${d.x},${d.y})`);
    });

    svg.call(
      d3
        .zoom()
        .scaleExtent([0.3, 4])
        .on('zoom', (event) => root.attr('transform', event.transform)),
    );
  }

  draw();
</script>

<style>
  .graph-head {
    padding-block: 2rem 0.5rem;
  }
  .hint {
    color: var(--muted);
    margin-top: 0.25rem;
  }
  .graph-wrap {
    position: relative;
    max-width: var(--maxw);
    margin: 1rem auto 3rem;
    padding-inline: 1.25rem;
  }
  #graph {
    width: 100%;
    height: 620px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      radial-gradient(600px 300px at 20% 0%, var(--bg-navy-tint), transparent),
      var(--bg);
  }
  .tooltip {
    position: absolute;
    pointer-events: none;
    background: var(--ink);
    color: #fff;
    font-size: 0.78rem;
    padding: 0.3rem 0.55rem;
    border-radius: 6px;
    z-index: 5;
  }
</style>
