---
import type { Locale } from '@/lib/categories';
import { localePath } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string) => (locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);
---

<section class="cv-welcome container" data-pagefind-ignore aria-label={L('Orientasi penyumbang', 'Contributor orientation', '贡献者引导', 'பங்களிப்பாளர் அறிமுகம்', '貢献者オリエンテーション', '기여자 오리엔테이션', 'การแนะนำผู้มีส่วนร่วม', 'Định hướng người đóng góp', 'Orientasi kontributor')}>
  <div class="cv-card">
    <span class="cv-ico" aria-hidden="true">🚀</span>
    <div class="cv-text">
      <b>{L('Selamat datang ke Paparan Penyumbang', 'Welcome to Contributor View', '欢迎来到贡献者视图', 'பங்களிப்பாளர் காட்சிக்கு வரவேற்கிறோம்', '貢献者ビューへようこそ', '기여자 뷰에 오신 것을 환영합니다', 'ยินดีต้อนรับสู่มุมมองผู้มีส่วนร่วม', 'Chào mừng đến với Chế độ xem Người đóng góp', 'Selamat datang di Tampilan Kontributor')}</b>
      <p>{L(
        'Ini pelancar anda — barisan semakan, draf, senarai kerja, papan pemuka dan deploy, kebanyakannya terus ke GitHub.',
        'This is your launchpad — review queue, drafts, worklist, dashboard and deploy, mostly straight into GitHub.',
        '这是你的启动台——审核队列、草稿、工作清单、仪表板与部署，多数直达 GitHub。',
        'இது உங்கள் தொடக்கத் தளம் — மதிப்பாய்வு வரிசை, வரைவுகள், பணிப்பட்டியல், டாஷ்போர்டு மற்றும் deploy, பெரும்பாலும் நேரடியாக GitHub-க்கு.',
        'ここはあなたの発射台です — レビュー待ち、下書き、作業リスト、ダッシュボード、デプロイ。多くは GitHub へ直接つながっています。',
        '이곳은 여러분의 시작점입니다 — 검토 대기열, 초안, 작업 목록, 대시보드, 배포까지 대부분 GitHub로 바로 연결됩니다.',
        'นี่คือจุดเริ่มต้นของคุณ — คิวการตรวจทาน ฉบับร่าง รายการงาน แดชบอร์ด และการดีพลอย ส่วนใหญ่เชื่อมตรงไปยัง GitHub',
        'Đây là bệ phóng của bạn — hàng đợi đánh giá, bản nháp, danh sách công việc, bảng điều khiển và triển khai, chủ yếu đi thẳng đến GitHub.',
        'Ini landasan peluncur Anda — antrean tinjauan, draf, daftar kerja, dasbor, dan deploy, sebagian besar langsung ke GitHub.',
      )}</p>
    </div>
    <a class="btn btn-primary cv-go" href={localePath('/contributor-guide', locale)}>{L('Panduan penyumbang', 'Contributor guide', '贡献者指南', 'பங்களிப்பாளர் வழிகாட்டி', '貢献者ガイド', '기여자 가이드', 'คู่มือผู้มีส่วนร่วม', 'Hướng dẫn người đóng góp', 'Panduan kontributor')} →</a>
    <button type="button" class="cv-x" data-cv-dismiss aria-label={L('Tutup', 'Dismiss', '关闭', 'மூடு', '閉じる', '닫기', 'ปิด', 'Đóng', 'Tutup')}>✕</button>
  </div>
</section>

<script>
  document.querySelectorAll('[data-cv-dismiss]').forEach((b) =>
    b.addEventListener('click', () => {
      try {
        localStorage.setItem('nk:cv-oriented', '1');
      } catch (e) {}
      document.documentElement.dataset.cvOriented = '1';
    }),
  );
</script>

<style>
  /* A card below the Contributor hero, matching the reader home's WelcomeCard.
     Shown only the FIRST time a recognised contributor is in Contributor View
     (until dismissed → data-cv-oriented, set pre-paint by HeadInlineScripts). */
  .cv-welcome { margin-top: 1.5rem; display: none; }
  :global(html[data-contributor='true'][data-view='contributor']:not([data-cv-oriented])) .cv-welcome { display: block; }
  .cv-card {
    position: relative; display: flex; align-items: center; gap: 1rem;
    background: var(--surface);
    border: 1px solid color-mix(in srgb, var(--gold) 35%, var(--line));
    border-radius: 12px; padding: 0.9rem 2.4rem 0.9rem 1.1rem;
  }
  .cv-ico { font-size: 1.6rem; flex: none; }
  .cv-text { flex: 1; min-width: 0; }
  .cv-text b { font-family: var(--font-title); color: var(--ink); font-size: 1.02rem; }
  .cv-text p { margin: 0.15rem 0 0; color: var(--ink-soft); font-size: 0.92rem; line-height: 1.5; }
  .cv-go { white-space: nowrap; flex: none; }
  .cv-x {
    position: absolute; top: 0.5rem; right: 0.55rem;
    background: none; border: 0; color: var(--muted); font-size: 0.95rem; line-height: 1;
    cursor: pointer; padding: 0.3rem 0.4rem; border-radius: 6px;
  }
  .cv-x:hover { color: var(--ink); background: var(--surface-2); }
  @media (max-width: 620px) {
    .cv-card { flex-wrap: wrap; }
    .cv-text { flex-basis: 100%; }
    .cv-go { width: 100%; text-align: center; }
  }
</style>
