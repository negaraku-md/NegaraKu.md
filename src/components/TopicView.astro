---
import type { Locale } from '@/lib/categories';
import { getCategory, getPillar, getPillarDef, categoriesInPillar, PILLARS, loc } from '@/lib/categories';
import { type Article, articlesForLocale } from '@/lib/content';
import { subcatLabel, orderedSubcats } from '@/lib/subcategories';
import { localePath } from '@/lib/i18n';
import PageHero from './PageHero.astro';
import ArticleList from './ArticleList.astro';
import HubGroups from './HubGroups.astro';

// TOPIC (subcategory) page — the level between a category and an article.
// A reader has narrowed to one task area (e.g. Corporate Tax) and wants every
// article in it, nothing else. Follows the same hero + section-box standard as
// the article page.

interface Props {
  locale: Locale;
  categoryId: string;
  topic: string;
  articles: Article[];
}
const { locale, categoryId, topic, articles } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string) => (locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

const cat = getCategory(categoryId)!;
const pillar = getPillar(categoryId);
const pillarDef = pillar ? getPillarDef(pillar) : undefined;
const label = subcatLabel(topic, locale);

// Sibling topics in this category — used for the hero's Topics stat.
const catArticles = (await articlesForLocale(locale)).filter((a) => a.data.category === categoryId);
const topics = orderedSubcats(categoryId, catArticles.flatMap((a) => a.data.subcategory));
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム', '홈', 'หน้าแรก'), href: localePath('/', locale) },
    ...(pillarDef ? [{ label: loc(pillarDef.name, locale), href: localePath(`/${pillar}`, locale) }] : []),
    { label: loc(cat.name, locale), href: localePath(`/${categoryId}`, locale) },
    { label },
  ]}
  title={label}
  desc={L(`Setiap artikel dalam ${label}.`, `Every article in ${label}.`, `${label}的全部文章。`, `${label} பிரிவில் உள்ள ஒவ்வொரு கட்டுரையும்.`, `${label}のすべての記事。`, `${label}의 모든 기사.`, `บทความทั้งหมดใน${label}`)}
  stats={[
    { value: PILLARS.length, label: L('tonggak', 'pillars', '支柱', 'தூண்கள்', '柱', '기둥', 'เสาหลัก') },
    { value: pillar ? categoriesInPillar(pillar).length : 0, label: L('kategori', 'categories', '分类', 'வகைகள்', 'カテゴリ', '카테고리', 'หมวดหมู่') },
    { value: topics.length, label: L('subkategori', 'subcategories', '子分类', 'துணை வகைகள்', 'サブカテゴリ', '하위 카테고리', 'หมวดหมู่ย่อย') },
    { value: articles.length, label: L('topik', 'topics', '主题', 'தலைப்புகள்', 'トピック', '주제', 'หัวข้อ') },
  ]}
/>

<ArticleList locale={locale} articles={articles} filters={[]} />

{
  pillar && (
    <HubGroups
      locale={locale}
      pillar={pillar}
      activeCategory={categoryId}
      categoryId={categoryId}
      activeTopic={topic}
      topSeparator
    />
  )
}
