---
import type { Locale } from '@/lib/categories';
import { getCategory, getPillar, getPillarDef, categoriesInPillar, PILLARS, loc } from '@/lib/categories';
import { type Article, articlesForLocale } from '@/lib/content';
import { subcatLabel, orderedSubcats } from '@/lib/subcategories';
import { localePath } from '@/lib/i18n';
import PageHero from './PageHero.astro';
import { stat } from '@/lib/pageStats';
import ArticleList from './ArticleList.astro';
import HubGroups from './HubGroups.astro';
import { michelinListProps, michelinIntro } from '@/lib/michelin';

// TOPIC (subcategory) page — the level between a category and an article.
// A reader has narrowed to one task area (e.g. Corporate Tax) and wants every
// article in it, nothing else. Follows the same hero + section-box standard as
// the article page.

interface Props {
  locale: Locale;
  categoryId: string;
  topic: string;
  articles: Article[];
}
const { locale, categoryId, topic, articles } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string, ja?: string, ko?: string, th?: string, vi?: string, id?: string, ar?: string, hi?: string, es?: string, fr?: string) => (locale === 'fr' ? (fr ?? ms) : locale === 'es' ? (es ?? ms) : locale === 'hi' ? (hi ?? ms) : locale === 'ar' ? (ar ?? ms) : locale === 'id' ? (id ?? ms) : locale === 'vi' ? (vi ?? ms) : locale === 'th' ? (th ?? ms) : locale === 'ko' ? (ko ?? ms) : locale === 'ja' ? (ja ?? ms) : locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

const cat = getCategory(categoryId)!;
const pillar = getPillar(categoryId);
const pillarDef = pillar ? getPillarDef(pillar) : undefined;
const label = subcatLabel(topic, locale);

// The MICHELIN Guide is an ordinary subcategory, but its restaurants carry extra
// collection facts — so this one topic renders the filterable card grid (Award /
// State / Price / Edition) plus the annual-revision caveat, while every other
// topic uses the standard list.
const isMichelin = categoryId === 'food-lifestyle' && topic === 'michelin-guide';
const mich = isMichelin ? michelinListProps(locale) : null;
const michIntro = isMichelin ? michelinIntro(locale) : null;
const michExplainerHref = localePath('/food-lifestyle/michelin-guide-malaysia', locale);

// Sibling topics in this category — used for the hero's Topics stat.
const catArticles = (await articlesForLocale(locale)).filter((a) => a.data.category === categoryId);
const topics = orderedSubcats(categoryId, catArticles.flatMap((a) => a.data.subcategory), locale);
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு', 'ホーム', '홈', 'หน้าแรก', 'Trang chủ', 'Beranda', 'الصفحة الرئيسية', 'होम', 'Inicio', 'Accueil'), href: localePath('/', locale) },
    ...(pillarDef ? [{ label: loc(pillarDef.name, locale), href: localePath(`/${pillar}`, locale) }] : []),
    { label: loc(cat.name, locale), href: localePath(`/${categoryId}`, locale) },
    { label },
  ]}
  title={label}
  desc={L(`Setiap artikel dalam ${label}.`, `Every article in ${label}.`, `${label}的全部文章。`, `${label} பிரிவில் உள்ள ஒவ்வொரு கட்டுரையும்.`, `${label}のすべての記事。`, `${label}의 모든 기사.`, `บทความทั้งหมดใน${label}`, `Mọi bài viết trong ${label}.`, `Setiap artikel dalam ${label}.`, `كل مقال في ${label}.`, `${label} में हर लेख।`, `Todos los artículos en ${label}.`, `Tous les articles de ${label}.`)}
  stats={[stat.pillars(PILLARS.length, locale), stat.categories(pillar ? categoriesInPillar(pillar).length : 0, locale), stat.subcategories(topics.length, locale), stat.topics(articles.length, locale)]}
/>

{
  michIntro && (
    <section class="container block mich-intro">
      <a class="mich-explainer" href={michExplainerHref}>{michIntro.explainerLabel} →</a>
      <p class="mich-note">{michIntro.note}</p>
    </section>
  )
}

{
  mich ? (
    <ArticleList locale={locale} articles={articles} filters={[]} homeCat={categoryId} facets={mich.facets} enrich={mich.enrich} layout="grid" />
  ) : (
    <ArticleList locale={locale} articles={articles} filters={[]} homeCat={categoryId} />
  )
}

{
  pillar && (
    <HubGroups
      locale={locale}
      pillar={pillar}
      activeCategory={categoryId}
      categoryId={categoryId}
      activeTopic={topic}
      topSeparator
    />
  )
}

<style>
  /* MICHELIN topic: explainer link + annual-revision caveat above the grid. */
  .mich-intro { padding-top: 0; }
  .mich-explainer { font-weight: 700; color: var(--gold); text-decoration: none; font-size: 0.95rem; }
  .mich-explainer:hover { text-decoration: underline; }
  .mich-note { margin: 0.4rem 0 0; color: var(--muted); font-size: 0.82rem; max-width: 70ch; line-height: 1.5; }
</style>
