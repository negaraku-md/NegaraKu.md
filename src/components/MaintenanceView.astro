---
import type { Locale } from '@/lib/categories';
import { MAINTENANCE_UNTIL } from '@/lib/maintenance';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string) => (locale === 'zh' ? zh : locale === 'en' ? en : ms);

// "Expected back by" — only when the operator set MAINTENANCE_UNTIL. Format it
// readably for the locale; if it isn't a valid date, show the raw value.
let untilText = '';
if (MAINTENANCE_UNTIL) {
  const d = new Date(MAINTENANCE_UNTIL);
  const bcp = locale === 'zh' ? 'zh-Hans' : locale === 'ms' ? 'ms-MY' : 'en-GB';
  untilText = Number.isNaN(d.getTime())
    ? MAINTENANCE_UNTIL
    : d.toLocaleString(bcp, { dateStyle: 'medium', timeStyle: 'short' });
}
---

<section class="maint">
  <div class="mrow">
    <!-- The NegaraKu.md brand icon (the Facebook-profile hexagon lockup). -->
    <img class="micon" src="/brand/negaraku-icon.svg" width="512" height="512" alt="NegaraKu.md" />

    <div class="mtext">
      <p class="mmark">NegaraKu<span class="dot">.md</span></p>
      <h1>{L('Kami akan kembali sebentar lagi', 'We’ll be right back', '我们很快就回来')}</h1>
      <p class="mlead">
        {L(
          'NegaraKu.md sedang menjalani penyelenggaraan ringkas untuk menjadi lebih baik. Terima kasih atas kesabaran anda.',
          'NegaraKu.md is undergoing brief maintenance to make things better. Thanks for your patience.',
          'NegaraKu.md 正在进行简短维护以提升体验。感谢您的耐心等待。',
        )}
      </p>
      {untilText && (
        <p class="muntil">
          <span class="mlabel">{L('Dijangka kembali menjelang', 'Expected back by', '预计恢复时间')}</span>
          <b>{untilText}</b>
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .maint {
    min-height: 100dvh; min-height: 100vh;
    display: grid; place-items: center;
    padding: 2rem 1.5rem;
    background:
      radial-gradient(760px 460px at 50% -8%, color-mix(in srgb, var(--gold) 12%, transparent), transparent),
      var(--bg, #07070a);
  }

  /* Icon on the left, text on the right. */
  .mrow {
    display: flex; align-items: center; gap: clamp(1.5rem, 4vw, 3.25rem);
    max-width: 56rem;
  }
  .micon {
    flex: none; width: clamp(120px, 20vw, 200px); height: auto;
    animation: mfloat 6s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) { .micon { animation: none; } }
  @keyframes mfloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

  .mtext { text-align: left; min-width: 0; }
  .mmark {
    font-family: var(--font-title, system-ui); font-weight: 800; font-size: 1.3rem;
    letter-spacing: 0.01em; color: var(--ink, #f4f4f8); margin: 0 0 0.6rem;
  }
  .mmark .dot { color: var(--gold); }
  .maint h1 {
    font-family: var(--font-title, system-ui); font-weight: 900;
    font-size: clamp(1.9rem, 5vw, 3rem); line-height: 1.08; letter-spacing: -0.02em;
    color: var(--ink, #f4f4f8); margin: 0 0 0.9rem;
  }
  .mlead {
    color: var(--ink-soft, #c6c6d4); font-size: clamp(1rem, 2.2vw, 1.15rem);
    line-height: 1.6; margin: 0 0 1.5rem; max-width: 38rem;
  }
  .muntil {
    display: inline-flex; flex-direction: column; gap: 0.15rem;
    background: var(--surface, #101018);
    border: 1px solid color-mix(in srgb, var(--gold) 35%, var(--line, #26263a));
    border-radius: 12px; padding: 0.75rem 1.35rem; margin: 0;
  }
  .muntil .mlabel { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted, #9a9ab8); }
  .muntil b { font-family: var(--font-title, system-ui); font-size: 1.1rem; color: var(--gold); font-variant-numeric: tabular-nums; }

  /* Stack on narrow screens: icon on top, centered text below. */
  @media (max-width: 640px) {
    .mrow { flex-direction: column; text-align: center; gap: 1.6rem; }
    .mtext { text-align: center; }
    .muntil { align-items: center; }
    .mlead { margin-inline: auto; }
  }
</style>
