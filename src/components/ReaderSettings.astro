---
import type { Locale } from '@/lib/categories';
import { t } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<details class="reader" id="reader-settings">
  <summary aria-label={t('reader.title', locale)} title={t('reader.title', locale)}>
    <span aria-hidden="true">Aa</span>
  </summary>
  <div class="panel" role="group" aria-label={t('reader.title', locale)}>
    <p class="grp-label">{t('reader.theme', locale)}</p>
    <div class="seg" data-group="theme">
      <button type="button" data-value="dark">{t('reader.dark', locale)}</button>
      <button type="button" data-value="light">{t('reader.light', locale)}</button>
    </div>
    <p class="grp-label">{t('reader.textSize', locale)}</p>
    <div class="seg" data-group="size">
      <button type="button" data-value="standard">{t('reader.sizeStandard', locale)}</button>
      <button type="button" data-value="large">{t('reader.sizeLarge', locale)}</button>
      <button type="button" data-value="xlarge">{t('reader.sizeXlarge', locale)}</button>
    </div>
  </div>
</details>

<script>
  const root = document.documentElement;
  const panel = document.getElementById('reader-settings');
  if (panel) {
    const sync = () => {
      const theme = root.getAttribute('data-theme') || 'dark';
      const size = root.getAttribute('data-text-size') || 'standard';
      panel.querySelectorAll('[data-group="theme"] button').forEach((b) =>
        b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.value === theme)),
      );
      panel.querySelectorAll('[data-group="size"] button').forEach((b) =>
        b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.value === size)),
      );
    };
    panel.querySelectorAll('[data-group="theme"] button').forEach((b) =>
      b.addEventListener('click', () => {
        const v = (b as HTMLElement).dataset.value!;
        if (v === 'dark') root.removeAttribute('data-theme');
        else root.setAttribute('data-theme', v);
        try {
          localStorage.setItem('nk-theme', v);
        } catch {}
        sync();
      }),
    );
    panel.querySelectorAll('[data-group="size"] button').forEach((b) =>
      b.addEventListener('click', () => {
        const v = (b as HTMLElement).dataset.value!;
        if (v === 'standard') root.removeAttribute('data-text-size');
        else root.setAttribute('data-text-size', v);
        try {
          localStorage.setItem('nk-text-size', v);
        } catch {}
        sync();
      }),
    );
    sync();
  }
</script>

<style>
  .reader {
    position: relative;
  }
  .reader > summary {
    list-style: none;
    cursor: pointer;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-family: var(--font-title);
    font-weight: 700;
    color: var(--ink-soft);
    user-select: none;
  }
  .reader > summary::-webkit-details-marker {
    display: none;
  }
  .reader[open] > summary,
  .reader > summary:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  .panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 40;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.85rem;
    width: 220px;
    box-shadow: var(--shadow-card);
  }
  .grp-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 0 0 0.4rem;
  }
  .grp-label:not(:first-child) {
    margin-top: 0.9rem;
  }
  .seg {
    display: flex;
    gap: 0.25rem;
  }
  .seg button {
    flex: 1;
    padding: 0.35rem 0.4rem;
    font-size: 0.8rem;
    font-family: var(--font-interface);
    font-weight: 600;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--bg);
    color: var(--ink-soft);
    cursor: pointer;
  }
  .seg button[aria-pressed='true'] {
    background: var(--gold);
    color: #000;
    border-color: var(--gold);
  }
</style>
