---
import type { Locale } from '@/lib/categories';
import { t } from '@/lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<details class="reader" id="reader-settings">
  <summary aria-label={t('reader.title', locale)} title={t('reader.title', locale)}>
    <span aria-hidden="true">Aa</span>
  </summary>
  <div class="panel" role="group" aria-label={t('reader.title', locale)}>
    <p class="grp-label">{t('reader.theme', locale)}</p>
    <div class="seg" data-group="theme">
      <button type="button" data-value="black-gold"><span class="sw sw-gold" aria-hidden="true"></span>{t('reader.themeGold', locale)}</button>
      <button type="button" data-value="black-red"><span class="sw sw-red" aria-hidden="true"></span>{t('reader.themeRed', locale)}</button>
    </div>
    <p class="grp-label">{t('reader.textSize', locale)}</p>
    <div class="seg" data-group="size">
      <button type="button" data-value="standard">{t('reader.sizeStandard', locale)}</button>
      <button type="button" data-value="large">{t('reader.sizeLarge', locale)}</button>
      <button type="button" data-value="xlarge">{t('reader.sizeXlarge', locale)}</button>
    </div>
  </div>
</details>

<script>
  const root = document.documentElement;
  const panel = document.getElementById('reader-settings');
  if (panel) {
    const save = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };

    // A segmented control: `attr` on <html> reflects the choice; `dflt` clears it.
    const wire = (group: string, attr: string, key: string, dflt: string) => {
      const btns = panel.querySelectorAll<HTMLElement>(`[data-group="${group}"] button`);
      const cur = () => root.getAttribute(attr) || dflt;
      const sync = () => btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.value === cur())));
      btns.forEach((b) =>
        b.addEventListener('click', () => {
          const v = b.dataset.value!;
          if (v === dflt) root.removeAttribute(attr);
          else root.setAttribute(attr, v);
          save(key, v);
          sync();
        }),
      );
      sync();
    };

    wire('theme', 'data-theme', 'nk-theme', 'black-gold');
    wire('size', 'data-text-size', 'nk-text-size', 'standard');
  }
</script>

<style>
  .reader {
    position: relative;
  }
  .reader > summary {
    list-style: none;
    cursor: pointer;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-family: var(--font-title);
    font-weight: 700;
    color: var(--ink-soft);
    user-select: none;
  }
  .reader > summary::-webkit-details-marker {
    display: none;
  }
  .reader[open] > summary,
  .reader > summary:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  .panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 40;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.85rem;
    width: 248px;
    box-shadow: var(--shadow-card);
  }
  .grp-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 0 0 0.4rem;
  }
  .grp-label:not(:first-child) {
    margin-top: 0.9rem;
  }
  .seg {
    display: flex;
    gap: 0.25rem;
  }
  .seg button {
    flex: 1;
    min-width: 0;
    padding: 0.4rem 0.3rem;
    font-size: 0.78rem;
    line-height: 1.1;
    text-align: center;
    white-space: nowrap;
    font-family: var(--font-interface);
    font-weight: 600;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--bg);
    color: var(--ink-soft);
    cursor: pointer;
  }
  .seg button[aria-pressed='true'] {
    background: var(--gold);
    color: var(--accent-contrast);
    border-color: var(--gold);
  }
  .sw {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 5px;
    vertical-align: middle;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .sw-gold { background: #ffc000; }
  .sw-red { background: #ff2020; }

  /* Theme buttons: always black bg + white border, with the accent as the
     content colour (gold or red). Selection = a full-strength white border. */
  .seg[data-group='theme'] button {
    background: #000;
    border-color: rgba(255, 255, 255, 0.4);
    font-weight: 700;
  }
  .seg[data-group='theme'] button[data-value='black-gold'] { color: #ffc000; }
  .seg[data-group='theme'] button[data-value='black-red'] { color: #ff2020; }
  .seg[data-group='theme'] button[aria-pressed='true'] {
    background: #000;
    border-color: #fff;
    box-shadow: inset 0 0 0 1px #fff;
  }
</style>
