---
import type { Locale } from '@/lib/categories';
import { localePath } from '@/lib/i18n';
import { REPO } from '@/lib/site';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string) => (locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

// Grouped project FAQ. Each item: question + plain-text answer (used for the
// FAQPage JSON-LD too) + optional links rendered under the answer.
type Item = { q: string; a: string; links?: { href: string; label: string }[] };
type Group = { title: string; items: Item[] };

const groups: Group[] = [
  {
    title: L('Tentang projek', 'About the project', '关于项目', 'திட்டம் பற்றி'),
    items: [
      {
        q: L('Apakah NegaraKu.md?', 'What is NegaraKu.md?', 'NegaraKu.md 是什么？', 'NegaraKu.md என்றால் என்ன?'),
        a: L(
          'Pangkalan pengetahuan sumber terbuka tentang Malaysia, ditulis dalam Markdown dan direka untuk dibaca oleh manusia dan AI. Namanya diambil daripada lagu kebangsaan Malaysia. Setiap topik hidup sebagai fail di GitHub.',
          'An open-source knowledge base about Malaysia, written in Markdown and designed to be read by people and AI alike. Its name comes from Malaysia’s national anthem. Every topic lives as a file on GitHub.',
          '一个关于马来西亚的开源知识库，以 Markdown 撰写，面向人类与 AI 阅读。名字取自马来西亚国歌。每个主题都以 GitHub 上的文件形式存在。',
          'மலேசியா பற்றிய திறந்த மூல அறிவுத் தளம், Markdown இல் எழுதப்பட்டு, மனிதர்களும் AI-யும் ஒருங்கே படிக்கும் வகையில் வடிவமைக்கப்பட்டது. இதன் பெயர் மலேசியாவின் தேசிய கீதத்திலிருந்து வந்தது. ஒவ்வொரு தலைப்பும் GitHub இல் ஒரு கோப்பாக இருக்கிறது.',
        ),
      },
      {
        q: L('Apa bezanya dengan Wikipedia?', 'How is it different from Wikipedia?', '与维基百科有何不同？', 'விக்கிபீடியாவிலிருந்து இது எப்படி வேறுபடுகிறது?'),
        a: L(
          'Ia naratif yang dikurasi dengan satu sumber kebenaran di GitHub — bukan ensiklopedia yang boleh disunting sesiapa secara langsung. Perubahan melalui semakan sebelum ia disiarkan.',
          'It’s curated narrative with a single source of truth on GitHub — not an encyclopedia anyone edits live. Changes pass through review before they go live.',
          '它是有单一事实来源（存于 GitHub）的策展叙事——并非任何人都能实时编辑的百科。改动须经审阅才会上线。',
          'இது GitHub இல் ஒரே உண்மை மூலத்துடன் தொகுக்கப்பட்ட விவரணை — யார் வேண்டுமானாலும் நேரடியாகத் திருத்தும் கலைக்களஞ்சியம் அல்ல. மாற்றங்கள் நேரலைக்கு வருமுன் மறுஆய்வு வழியாகச் செல்கின்றன.',
        ),
      },
      {
        q: L('Siapa yang menjalankannya?', 'Who runs it?', '谁在运营它？', 'இதை யார் நடத்துகிறார்கள்?'),
        a: L(
          'Projek sumber terbuka, ditaja oleh 1company, dibina oleh penyumbang dan penyemak. Kredit dijana automatik daripada sejarah perubahan setiap artikel.',
          'An open-source project, sponsored by 1company, built by contributors and reviewers. Credit is auto-generated from every article’s change history.',
          '一个由 1company 赞助的开源项目，由贡献者和审阅者共同建设。署名根据每篇文章的修改历史自动生成。',
          '1company ஆல் நிதியுதவி பெறும் ஒரு திறந்த மூலத் திட்டம், பங்களிப்பாளர்களாலும் மறுஆய்வாளர்களாலும் கட்டமைக்கப்பட்டது. பங்களிப்பு அங்கீகாரம் ஒவ்வொரு கட்டுரையின் மாற்ற வரலாற்றிலிருந்து தானாக உருவாக்கப்படுகிறது.',
        ),
        links: [
          { href: localePath('/contributors', locale), label: L('Lihat penyumbang', 'See contributors', '查看贡献者', 'பங்களிப்பாளர்களைப் பார்க்க') },
          { href: localePath('/roles', locale), label: L('Peranan', 'Roles', '角色', 'பங்குகள்') },
        ],
      },
      {
        q: L('Apakah lesennya?', 'What’s the license?', '采用什么许可？', 'உரிமம் என்ன?'),
        a: L('Kandungan di bawah CC BY-SA 4.0; kod di bawah lesen MIT.', 'Content is under CC BY-SA 4.0; code is under the MIT license.', '内容采用 CC BY-SA 4.0；代码采用 MIT 许可。', 'உள்ளடக்கம் CC BY-SA 4.0 இன் கீழ்; குறியீடு MIT உரிமத்தின் கீழ்.'),
      },
    ],
  },
  {
    title: L('Membaca & bahasa', 'Reading & languages', '阅读与语言', 'வாசிப்பு & மொழிகள்'),
    items: [
      {
        q: L('Bahasa apa yang tersedia?', 'What languages are available?', '有哪些语言？', 'எந்த மொழிகள் கிடைக்கின்றன?'),
        a: L(
          'Empat: Bahasa Malaysia (lalai, di /), Inggeris (di /en), Cina (di /zh) dan Tamil (di /ta). Setiap topik disasarkan untuk hadir penuh dalam kesemua empat.',
          'Four: Bahasa Malaysia (default, at /), English (at /en), Chinese (at /zh) and Tamil (at /ta). Every topic aims to be present fully in all four.',
          '四种：马来文（默认，位于 /）、英文（位于 /en）、中文（位于 /zh）和泰米尔文（位于 /ta）。每个主题都力求以四种语言完整呈现。',
          'நான்கு: பஹாசா மலேசியா (இயல்பு, / இல்), ஆங்கிலம் (/en இல்), சீனம் (/zh இல்) மற்றும் தமிழ் (/ta இல்). ஒவ்வொரு தலைப்பும் நான்கிலும் முழுமையாக இருக்க இலக்கு வைக்கிறது.',
        ),
      },
      {
        q: L('Bagaimana jika terjemahan tiada?', 'What if a translation is missing?', '如果缺少翻译怎么办？', 'மொழிபெயர்ப்பு இல்லாவிட்டால் என்ன?'),
        a: L(
          'Halaman berpatah balik kepada bahasa induk topik itu, jadi anda tidak pernah menemui halaman kosong. Terjemahan yang lapuk ditanda supaya ia tidak menyesatkan.',
          'The page falls back to the topic’s master language, so you never hit a blank page. Stale translations are flagged so they don’t mislead.',
          '页面会回退到该主题的母版语言，因此你不会遇到空白页。过时的翻译会被标记，以免误导。',
          'பக்கம் அந்தத் தலைப்பின் மூல மொழிக்குப் பின்வாங்குகிறது, எனவே நீங்கள் ஒருபோதும் காலியான பக்கத்தைக் காண்பதில்லை. வழிதவறச் செய்யாதவாறு காலாவதியான மொழிபெயர்ப்புகள் குறிக்கப்படுகின்றன.',
        ),
      },
      {
        q: L('Bagaimana saya tahu halaman itu terkini?', 'How do I know a page is current?', '我如何知道页面是否最新？', 'ஒரு பக்கம் தற்போதையது என்பதை நான் எப்படி அறிவது?'),
        a: L(
          'Artikel memaparkan lencana amanah — sama ada ia disemak manusia, dan bila ia perlu disemak semula — dan setiap halaman memautkan sejarah perubahannya di GitHub.',
          'Articles show trust badges — whether they’re human-reviewed, and when they’re due for re-review — and every page links its change history on GitHub.',
          '文章会显示信任徽章——是否经人工审阅、何时应重新审阅——每个页面都链接其在 GitHub 上的修改历史。',
          'கட்டுரைகள் நம்பிக்கைச் சின்னங்களைக் காட்டுகின்றன — அவை மனிதரால் மறுஆய்வு செய்யப்பட்டவையா, எப்போது மீள்-மறுஆய்வுக்கு உரியவை என்பதை — மேலும் ஒவ்வொரு பக்கமும் GitHub இல் அதன் மாற்ற வரலாற்றை இணைக்கிறது.',
        ),
      },
    ],
  },
  {
    title: L('Kualiti & sumber', 'Quality & sourcing', '质量与来源', 'தரம் & மூலம்'),
    items: [
      {
        q: L('Bagaimana kualiti dijamin?', 'How is quality ensured?', '如何保证质量？', 'தரம் எப்படி உறுதி செய்யப்படுகிறது?'),
        a: L(
          'Setiap dakwaan yang boleh disemak dipetik sumbernya. Artikel bergerak melalui tangga draf → disemak → diterbitkan, dan pengimbas kesihatan automatik berjalan pada setiap binaan.',
          'Every checkable claim is cited. Articles move through a draft → reviewed → published ladder, and an automated health scanner runs on every build.',
          '每个可核查的说法都注明来源。文章经过草稿→审阅→发布的流程，每次构建都会运行自动健康扫描。',
          'சரிபார்க்கக்கூடிய ஒவ்வொரு கூற்றுக்கும் மூலம் மேற்கோள் காட்டப்படுகிறது. கட்டுரைகள் வரைவு → மறுஆய்வு → வெளியீடு என்ற படிநிலை வழியாக நகர்கின்றன, மேலும் ஒவ்வொரு கட்டமைப்பிலும் தானியங்கி ஆரோக்கிய ஸ்கேனர் இயங்குகிறது.',
        ),
      },
      {
        q: L('Adakah artikel dijana AI?', 'Are the articles AI-generated?', '文章是 AI 生成的吗？', 'கட்டுரைகள் AI ஆல் உருவாக்கப்பட்டவையா?'),
        a: L(
          'Kebanyakan bermula sebagai draf berpandukan AI, kemudian disunting dan disemak oleh manusia. Kami mendedahkannya secara jujur pada setiap artikel dan pada halaman penyumbang.',
          'Most begin as AI-guided drafts, then are edited and reviewed by humans. We disclose this honestly on each article and on the contributors page.',
          '大多数最初是 AI 引导的草稿，随后由人编辑和审阅。我们在每篇文章和贡献者页面上如实披露这一点。',
          'பெரும்பாலானவை AI-வழிகாட்டப்பட்ட வரைவுகளாகத் தொடங்கி, பின்னர் மனிதர்களால் திருத்தப்பட்டு மறுஆய்வு செய்யப்படுகின்றன. இதை ஒவ்வொரு கட்டுரையிலும் பங்களிப்பாளர்கள் பக்கத்திலும் நாங்கள் நேர்மையாக வெளிப்படுத்துகிறோம்.',
        ),
      },
      {
        q: L('Bagaimana saya melaporkan kesilapan?', 'How do I report an error?', '我如何报告错误？', 'ஒரு பிழையை நான் எப்படிப் புகாரளிப்பது?'),
        a: L(
          'Guna pautan “Laporkan isu” di bahagian bawah mana-mana artikel — ia membuka isu GitHub yang telah diisi. Laporan yang sah menandakan artikel itu “perlu kemas kini” secara automatik.',
          'Use the “Report an issue” link at the bottom of any article — it opens a pre-filled GitHub issue. A valid report automatically flags the article as “needs update”.',
          '使用任意文章底部的"报告问题"链接——它会打开一个预填的 GitHub issue。有效的报告会自动将该文章标记为"需更新"。',
          'எந்த கட்டுரையின் கீழேயும் உள்ள “சிக்கலைப் புகாரளி” இணைப்பைப் பயன்படுத்துங்கள் — அது முன்-நிரப்பப்பட்ட GitHub issue ஐத் திறக்கிறது. செல்லுபடியாகும் புகார் தானாகவே கட்டுரையை “புதுப்பிப்பு தேவை” எனக் குறிக்கிறது.',
        ),
        links: [{ href: localePath('/contribute', locale), label: L('Cara melapor & mencadang', 'How to report & suggest', '如何报告与建议', 'எப்படிப் புகாரளிப்பது & பரிந்துரைப்பது') }],
      },
    ],
  },
  {
    title: L('Topik sensitif', 'Sensitive topics', '敏感话题', 'உணர்வுபூர்வமான தலைப்புகள்'),
    items: [
      {
        q: L('Bagaimana isu sensitif dikendalikan?', 'How are sensitive topics handled?', '如何处理敏感话题？', 'உணர்வுபூர்வமான தலைப்புகள் எப்படிக் கையாளப்படுகின்றன?'),
        a: L(
          'Topik yang menyentuh kaum, agama, institusi diraja atau perlembagaan dilabel mengikut satu piawai klasifikasi. Ia mesti bersumber dan neutral, dan tidak boleh diterbitkan tanpa semakan manusia bernama.',
          'Topics touching race, religion, royalty or the constitution are labelled by a single classification standard. They must be sourced and neutral, and cannot be published without a named human review.',
          '涉及种族、宗教、王室或宪法的主题依统一的分类标准标注。它们必须注明来源、保持中立，且未经具名的人工审阅不得发布。',
          'இனம், மதம், அரச குடும்பம் அல்லது அரசியலமைப்பைத் தொடும் தலைப்புகள் ஒரே வகைப்பாட்டுத் தரநிலையின்படி பெயரிடப்படுகின்றன. அவை மூலம் காட்டப்பட்டதாகவும் நடுநிலையாகவும் இருக்க வேண்டும், மேலும் பெயரிடப்பட்ட மனித மறுஆய்வு இன்றி வெளியிட முடியாது.',
        ),
      },
      {
        q: L('Kenapa nadanya neutral?', 'Why is the tone neutral?', '为什么语气保持中立？', 'ஏன் தொனி நடுநிலையாக உள்ளது?'),
        a: L(
          'Matlamatnya menerangkan, bukan menetapkan. Pada isu yang dipertikaikan, kami menyampaikan fakta dan kedudukan yang bersumber tanpa mengambil pihak.',
          'The goal is to describe, not prescribe. On contested subjects we present sourced facts and positions without taking a side.',
          '目标是描述而非主张。在有争议的议题上，我们呈现有据可查的事实与立场，而不选边站。',
          'இலக்கு விவரிப்பது, விதிப்பது அல்ல. சர்ச்சைக்குரிய தலைப்புகளில் நாங்கள் ஒரு பக்கம் சாராமல் மூலம் காட்டப்பட்ட உண்மைகளையும் நிலைப்பாடுகளையும் முன்வைக்கிறோம்.',
        ),
      },
    ],
  },
  {
    title: L('Menyumbang', 'Contributing', '参与贡献', 'பங்களித்தல்'),
    items: [
      {
        q: L('Bolehkah saya menyumbang?', 'Can I contribute?', '我可以贡献吗？', 'நான் பங்களிக்கலாமா?'),
        a: L(
          'Ya. Sesiapa boleh melapor atau mencadang tanpa jemputan. Menulis dan menterjemah adalah melalui fork + pull request, dengan keahlian org diberikan atas permintaan — seorang penyelenggara menjemput anda.',
          'Yes. Anyone can report or suggest without an invitation. Authoring and translating are via fork + pull request, with org membership granted on request — a maintainer invites you.',
          '可以。任何人无需邀请即可报告或建议。撰写和翻译通过 fork + pull request 进行，组织成员资格经申请后由维护者邀请授予。',
          'ஆம். யார் வேண்டுமானாலும் அழைப்பின்றிப் புகாரளிக்கலாம் அல்லது பரிந்துரைக்கலாம். எழுதுதலும் மொழிபெயர்த்தலும் fork + pull request வழியாக நடக்கின்றன, org உறுப்பினர் தகுதி கோரிக்கையின் பேரில் வழங்கப்படுகிறது — ஒரு பராமரிப்பாளர் உங்களை அழைக்கிறார்.',
        ),
        links: [{ href: localePath('/roles', locale), label: L('Peranan & cara menyertai', 'Roles & how to join', '角色与加入方式', 'பங்குகள் & எப்படிச் சேருவது') }],
      },
      {
        q: L('Saya tidak biasa dengan GitHub.', 'I’m not familiar with GitHub.', '我不熟悉 GitHub。', 'எனக்கு GitHub பரிச்சயம் இல்லை.'),
        a: L(
          'Itu tidak mengapa. Borang berpandu di laman membuka isu yang telah diisi untuk anda — tiada pengetahuan Git diperlukan untuk melapor atau mencadang.',
          'That’s fine. The guided forms on the site open a pre-filled issue for you — no Git knowledge is needed to report or suggest.',
          '没关系。网站上的引导表单会为你打开一个预填的 issue——报告或建议无需任何 Git 知识。',
          'அது பரவாயில்லை. தளத்தில் உள்ள வழிகாட்டப்பட்ட படிவங்கள் உங்களுக்காக முன்-நிரப்பப்பட்ட issue ஐத் திறக்கின்றன — புகாரளிக்கவோ பரிந்துரைக்கவோ எந்த Git அறிவும் தேவையில்லை.',
        ),
      },
      {
        q: L('Bagaimana saya membantu menterjemah?', 'How do I help translate?', '我如何帮助翻译？', 'மொழிபெயர்க்க நான் எப்படி உதவுவது?'),
        a: L(
          '“Derma Token AI Anda” — gunakan kunci Claude anda sendiri untuk mendraf terjemahan, semaknya, kemudian buka PR. Anda membelanjakan token anda; projek membelanjakan sifar.',
          '“Donate your AI Token” — use your own Claude key to draft a translation, review it, then open a PR. You spend your tokens; the project spends none.',
          '"捐赠你的 AI Token"——用你自己的 Claude 密钥起草翻译、审阅，然后发起 PR。你花费自己的 token；项目分文不花。',
          '“உங்கள் AI டோக்கனை நன்கொடையளியுங்கள்” — ஒரு மொழிபெயர்ப்பை வரைவு செய்ய உங்கள் சொந்த Claude கீயைப் பயன்படுத்துங்கள், அதை மறுஆய்வு செய்யுங்கள், பின்னர் ஒரு PR ஐத் திறங்கள். நீங்கள் உங்கள் டோக்கன்களைச் செலவழிக்கிறீர்கள்; திட்டம் எதையும் செலவழிக்காது.',
        ),
        links: [{ href: localePath('/donate', locale), label: L('Derma Token AI Anda', 'Donate Your AI Token', '捐赠你的 AI Token', 'உங்கள் AI டோக்கனை நன்கொடையளியுங்கள்') }],
      },
    ],
  },
  {
    title: L('Untuk AI & pembangun', 'For AI & developers', '面向 AI 与开发者', 'AI & டெவலப்பர்களுக்கு'),
    items: [
      {
        q: L('Bolehkah AI menggunakan kandungan ini?', 'Can AI use this content?', 'AI 可以使用这些内容吗？', 'AI இந்த உள்ளடக்கத்தைப் பயன்படுத்தலாமா?'),
        a: L(
          'Ya. Setiap halaman menawarkan Markdown mentahnya, dan laman ini menerbitkan llms.txt untuk model bahasa besar. Kandungan di bawah CC BY-SA 4.0.',
          'Yes. Every page offers its raw Markdown, and the site publishes an llms.txt for large language models. Content is under CC BY-SA 4.0.',
          '可以。每个页面都提供原始 Markdown，网站也发布 llms.txt 供大型语言模型使用。内容采用 CC BY-SA 4.0。',
          'ஆம். ஒவ்வொரு பக்கமும் அதன் மூல Markdown ஐ வழங்குகிறது, மேலும் தளம் பெரிய மொழி மாதிரிகளுக்காக ஒரு llms.txt ஐ வெளியிடுகிறது. உள்ளடக்கம் CC BY-SA 4.0 இன் கீழ்.',
        ),
        links: [{ href: '/llms.txt', label: 'llms.txt' }],
      },
      {
        q: L('Bolehkah saya fork atau hos sendiri?', 'Can I fork or self-host it?', '我可以 fork 或自建吗？', 'நான் இதை fork செய்யலாமா அல்லது சொந்தமாக ஹோஸ்ட் செய்யலாமா?'),
        a: L(
          'Boleh. Kod di bawah lesen MIT dan keseluruhan repositori adalah awam. Fork ia, bina secara statik, dan hos di mana-mana.',
          'You can. The code is under the MIT license and the whole repository is public. Fork it, build it statically, and host it anywhere.',
          '可以。代码采用 MIT 许可，整个仓库都是公开的。fork 它、静态构建，然后托管在任何地方。',
          'செய்யலாம். குறியீடு MIT உரிமத்தின் கீழ் உள்ளது, முழு களஞ்சியமும் பொதுவானது. அதை fork செய்யுங்கள், நிலையான முறையில் கட்டமைக்கவும், எங்கும் ஹோஸ்ட் செய்யவும்.',
        ),
        links: [{ href: REPO, label: L('Repositori GitHub', 'GitHub repository', 'GitHub 仓库', 'GitHub களஞ்சியம்') }],
      },
    ],
  },
];

// FAQPage structured data (localized) — the site is built to be machine-legible.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: groups.flatMap((g) =>
    g.items.map((it) => ({
      '@type': 'Question',
      name: it.q,
      acceptedAnswer: { '@type': 'Answer', text: it.a },
    })),
  ),
};

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<PageHero
  locale={locale}
  crumb={[
    { label: L('Laman Utama', 'Home', '首页', 'முகப்பு'), href: localePath('/', locale) },
    { label: L('Soalan Lazim', 'FAQ', '常见问题', 'அடிக்கடி கேட்கப்படும் கேள்விகள்') },
  ]}
  title={L('Soalan Lazim', 'Frequently asked questions', '常见问题', 'அடிக்கடி கேட்கப்படும் கேள்விகள்')}
  desc={L(
    'Perkara yang paling kerap ditanya tentang NegaraKu.md — apa itu, bagaimana kualitinya dijaga, dan cara mengambil bahagian.',
    'The things most often asked about NegaraKu.md — what it is, how its quality is kept, and how to take part.',
    '关于 NegaraKu.md 最常被问到的问题——它是什么、如何保证质量，以及如何参与。',
    'NegaraKu.md பற்றி அடிக்கடி கேட்கப்படும் விஷயங்கள் — அது என்ன, அதன் தரம் எப்படிப் பேணப்படுகிறது, மேலும் எப்படிப் பங்கேற்பது.',
  )}
/>

<section class="container block faq">
  {groups.map((g) => (
    <div class="fgroup">
      <h2 class="ftitle">{g.title}</h2>
      <div class="fitems">
        {g.items.map((it) => (
          <details class="fitem">
            <summary>
              <span class="fq">{it.q}</span>
              <span class="fchev" aria-hidden="true">＋</span>
            </summary>
            <div class="fa">
              <p>{it.a}</p>
              {it.links && (
                <p class="flinks">
                  {it.links.map((l) => (
                    <a href={l.href} {...(isExternal(l.href) ? { rel: 'noopener' } : {})}>{l.label} {isExternal(l.href) ? '↗' : '→'}</a>
                  ))}
                </p>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  ))}

  <div class="more">
    <p>{L('Tidak menemui jawapannya?', 'Didn’t find your answer?', '没找到答案？', 'உங்கள் பதிலைக் கண்டுபிடிக்கவில்லையா?')}</p>
    <div class="more-acts">
      <a class="btn btn-primary" href={localePath('/contribute', locale)}>{L('Tanya atau laporkan', 'Ask or report', '提问或报告', 'கேளுங்கள் அல்லது புகாரளியுங்கள்')} →</a>
      <a class="btn btn-ghost" href={localePath('/about', locale)}>{L('Tentang NegaraKu.md', 'About NegaraKu.md', '关于 NegaraKu.md', 'NegaraKu.md பற்றி')} →</a>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .block { margin-top: 1.6rem; }
  .faq { display: grid; gap: 1.8rem; padding-bottom: 1rem; }
  .ftitle {
    font-family: var(--font-title); font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--gold); margin: 0 0 0.7rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--line);
  }
  .fitems { display: grid; gap: 0.6rem; }
  .fitem {
    background: var(--surface); border: 1px solid var(--line); border-radius: 10px; overflow: hidden;
  }
  .fitem[open] { border-color: color-mix(in srgb, var(--gold) 45%, var(--line)); }
  .fitem > summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.9rem 1.05rem; font-family: var(--font-title); font-weight: 600; font-size: 1rem; color: var(--ink);
  }
  .fitem > summary::-webkit-details-marker { display: none; }
  .fitem > summary:hover { color: var(--gold); }
  .fchev { flex: none; color: var(--gold); font-weight: 700; font-size: 1.1rem; transition: transform 0.18s; }
  .fitem[open] .fchev { transform: rotate(45deg); }
  .fa { padding: 0 1.05rem 1.05rem; }
  .fa p { margin: 0; color: var(--ink-soft); line-height: 1.65; font-size: 0.94rem; }
  .flinks { margin-top: 0.7rem !important; display: flex; flex-wrap: wrap; gap: 0.2rem 1.1rem; }
  .flinks a { color: var(--gold); text-decoration: none; font-weight: 600; font-size: 0.88rem; }
  .flinks a:hover { text-decoration: underline; }

  .more { text-align: center; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 1.4rem; }
  .more p { margin: 0 0 0.8rem; font-family: var(--font-title); font-size: 1.05rem; color: var(--ink); }
  .more-acts { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; }
</style>
