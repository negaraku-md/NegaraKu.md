---
import type { Locale } from '@/lib/categories';
import { t, localePath, LOCALES, LOCALE_NAMES } from '@/lib/i18n';
import { NAV } from '@/lib/nav';
import { REPO } from '@/lib/site';
import ReaderSettings from './ReaderSettings.astro';

interface Props {
  locale: Locale;
  /** Current path WITHOUT locale prefix, e.g. "/graph" or "/history/kesultanan-melaka". */
  path: string;
}
const { locale, path } = Astro.props;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localePath('/', locale)} aria-label="NegaraKu.md">
      <svg class="brand-mark" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24">
        <g fill="currentColor">
          <ellipse cx="12" cy="6.6" rx="2.9" ry="4.4" />
          <ellipse cx="12" cy="6.6" rx="2.9" ry="4.4" transform="rotate(72 12 11)" />
          <ellipse cx="12" cy="6.6" rx="2.9" ry="4.4" transform="rotate(144 12 11)" />
          <ellipse cx="12" cy="6.6" rx="2.9" ry="4.4" transform="rotate(216 12 11)" />
          <ellipse cx="12" cy="6.6" rx="2.9" ry="4.4" transform="rotate(288 12 11)" />
        </g>
        <circle cx="12" cy="11" r="2" fill="var(--bg)" />
        <path d="M12 11 C 12 15, 12.4 18, 13 20.6" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round" />
        <circle cx="13" cy="20.8" r="1" fill="currentColor" />
        <circle cx="11.3" cy="18.9" r="0.75" fill="currentColor" />
        <circle cx="14.2" cy="19.2" r="0.75" fill="currentColor" />
        <circle cx="12" cy="11" r="0.95" fill="currentColor" />
      </svg>
      <span class="brand-name">NegaraKu<span class="dot">.md</span></span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label={t('nav.menu', locale)} />
    <label for="nav-toggle" class="hamburger" aria-hidden="true"><span></span><span></span><span></span></label>

    <nav class="nav" aria-label="Primary">
      {
        NAV.map((menu) =>
          menu.items ? (
            <div class="menu">
              <button type="button" class="menu-btn" aria-haspopup="true">
                {t(menu.label, locale)}
                <span class="caret" aria-hidden="true">▾</span>
              </button>
              <div class="dropdown">
                {menu.items.map((it) => (
                  <a href={it.external ? it.href : localePath(it.href, locale)}>{t(it.label, locale)}</a>
                ))}
              </div>
            </div>
          ) : (
            <a class="menu-link" href={localePath(menu.href ?? '/', locale)}>
              {t(menu.label, locale)}
            </a>
          ),
        )
      }
    </nav>

    <div class="tools">
      <a class="search-btn" data-search-link href={localePath('/search', locale)} aria-label={t('nav.search', locale)} title={`${t('nav.search', locale)} (/)`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
        <kbd aria-hidden="true">/</kbd>
      </a>
      <a class="icon-btn" href={REPO} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
      </a>
      <ReaderSettings locale={locale} />
      <div class="lang" role="group" aria-label="Language">
        {
          LOCALES.map((l) => (
            <a
              class:list={['lang-link', { active: l === locale }]}
              href={localePath(path || '/', l)}
              hreflang={l}
              aria-current={l === locale ? 'true' : undefined}
              title={LOCALE_NAMES[l]}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>

<script>
  // Press "/" anywhere to jump to search (GitHub-style). If already on the
  // search page, focus the input instead of navigating.
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    const el = e.target as HTMLElement;
    const tag = (el?.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'textarea' || tag === 'select' || el?.isContentEditable) return;
    const link = document.querySelector<HTMLAnchorElement>('a[data-search-link]');
    if (!link) return;
    e.preventDefault();
    const dest = new URL(link.href).pathname.replace(/\/$/, '');
    if (location.pathname.replace(/\/$/, '') === dest) {
      document.getElementById('search-input')?.focus();
    } else {
      location.href = link.href;
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--nav-height);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ink);
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand-mark {
    color: var(--gold);
    flex-shrink: 0;
  }
  .brand .dot {
    color: var(--gold);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline-start: auto;
    font-family: var(--font-interface);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .menu {
    position: relative;
  }
  .menu-btn,
  .menu-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--ink-soft);
    font: inherit;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    text-decoration: none;
  }
  .menu-btn:hover,
  .menu-link:hover,
  .menu:hover .menu-btn,
  .menu:focus-within .menu-btn {
    color: var(--gold);
    background: var(--surface);
  }
  .caret {
    font-size: 0.7em;
    opacity: 0.7;
  }
  .dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: 200px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.4rem;
    box-shadow: var(--shadow-card);
    display: none;
    flex-direction: column;
  }
  .menu:hover .dropdown,
  .menu:focus-within .dropdown {
    display: flex;
  }
  .dropdown a {
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .dropdown a:hover {
    background: var(--surface-2);
    color: var(--gold);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink-soft);
  }
  .icon-btn:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  /* Search control: magnifier + a "/" key hint (GitHub-style). */
  .search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 34px;
    padding: 0 0.5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .search-btn:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  .search-btn kbd {
    font-family: var(--font-interface);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    color: var(--muted);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 0.15rem 0.35rem;
  }
  .search-btn:hover kbd {
    color: var(--ink-soft);
  }
  .lang {
    display: inline-flex;
    gap: 0.15rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.15rem;
  }
  .lang-link {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
  }
  .lang-link.active {
    background: var(--gold);
    color: #000;
  }

  /* Mobile */
  .nav-toggle,
  .hamburger {
    display: none;
  }
  @media (max-width: 900px) {
    .hamburger {
      display: inline-flex;
      flex-direction: column;
      gap: 4px;
      margin-inline-start: auto;
      cursor: pointer;
      padding: 0.4rem;
    }
    .hamburger span {
      width: 22px;
      height: 2px;
      background: var(--ink);
    }
    .nav {
      display: none;
      position: absolute;
      top: var(--nav-height);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      padding: 0.5rem 1.25rem 1rem;
      margin: 0;
    }
    .nav-toggle:checked ~ .nav {
      display: flex;
    }
    .menu,
    .menu-link {
      width: 100%;
    }
    .dropdown {
      position: static;
      display: flex;
      border: 0;
      box-shadow: none;
      padding: 0 0 0.5rem 0.8rem;
      min-width: 0;
    }
    .menu-btn {
      width: 100%;
      justify-content: space-between;
    }
    .tools {
      order: -1;
    }
  }

  /* At phone widths the bar's contents (tools + wordmark + hamburger) measured
     441px against a 375px viewport, pushing every page 66px horizontally. The
     wordmark must not shrink or truncate, so the space is taken back from the
     gaps, the language pills and the icon buttons. */
  @media (max-width: 520px) {
    .bar {
      gap: 0.5rem;
    }
    .brand {
      font-size: 1.05rem;
      gap: 0.35rem;
    }
    .tools {
      gap: 0.35rem;
      min-width: 0;
    }
    .icon-btn {
      width: 30px;
      height: 30px;
    }
    .lang {
      gap: 0;
    }
    .lang-link {
      padding: 0.2rem 0.32rem;
      letter-spacing: 0;
    }
    .hamburger {
      padding: 0.4rem 0.1rem;
    }
  }

  /* 320px (iPhone SE) is the narrowest viewport we support; the 520px tier
     alone still left 38px of overflow there. */
  @media (max-width: 380px) {
    .bar {
      padding-inline: 0.75rem;
      gap: 0.35rem;
    }
    .tools {
      gap: 0.25rem;
    }
    .brand {
      font-size: 0.95rem;
    }
    .icon-btn {
      width: 28px;
      height: 28px;
    }
    .lang-link {
      padding: 0.2rem 0.24rem;
      font-size: 0.68rem;
    }
  }
</style>
