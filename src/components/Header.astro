---
import type { Locale } from '@/lib/categories';
import { t, localePath, LOCALES, LOCALE_NAMES } from '@/lib/i18n';
import { NAV, CONTRIBUTOR_NAV } from '@/lib/nav';
import { FLOWER_D, FLOWER_VB, FLOWER_CX, FLOWER_CY } from '@/lib/logo';
// Centre the traced Bunga Raya on its CENTROID in the 512 badge at ~300 units.
const LOGO_S = 300 / FLOWER_VB;
const LOGO_TX = 256 - FLOWER_CX * LOGO_S;
const LOGO_TY = 256 - FLOWER_CY * LOGO_S;
import { REPO } from '@/lib/site';

interface Props {
  locale: Locale;
  /** Current path WITHOUT locale prefix, e.g. "/graph" or "/history/kesultanan-melaka". */
  path: string;
}
const { locale, path } = Astro.props;

// Reader + Contributor navs both ship in every page; the browser shows one based
// on <html data-view> (set client-side, no flash). Same template renders both.
const NAV_GROUPS = [
  { view: 'reader', menus: NAV },
  { view: 'contributor', menus: CONTRIBUTOR_NAV },
] as const;
---

<header class="site-header" data-pagefind-ignore>
  <div class="container bar">
    <a class="brand" href={localePath('/', locale)} aria-label="NegaraKu.md">
      <svg class="brand-mark" aria-hidden="true" width="52" height="52" viewBox="0 0 512 512">
        <polygon points="256.00,23.50 54.65,139.75 54.65,372.25 256.00,488.50 457.35,372.25 457.35,139.75" fill="#0A0A0A" stroke="#0A0A0A" stroke-width="34" stroke-linejoin="round" />
        <polygon points="256.00,6.50 39.93,131.25 39.93,380.75 256.00,505.50 472.07,380.75 472.07,131.25" fill="none" stroke="#FFFFFF" stroke-width="11" stroke-linejoin="round" stroke-linecap="round" />
        <g transform={`translate(${LOGO_TX} ${LOGO_TY}) scale(${LOGO_S})`}>
          <path fill="var(--gold)" fill-rule="evenodd" d={FLOWER_D} />
        </g>
      </svg>
      <span class="brand-text">
        <span class="brand-name">NegaraKu<span class="dot">.md</span></span>
        <span class="brand-tag">{t('brand.tagline', locale)}</span>
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label={t('nav.menu', locale)} />
    <label for="nav-toggle" class="hamburger" aria-hidden="true"><span></span><span></span><span></span></label>

    <nav class="nav" aria-label="Primary">
      {
        NAV_GROUPS.map((grp) => (
          <div class="nav-group" data-view-nav={grp.view}>
            {grp.menus.map((menu) =>
              menu.items ? (
                <div class="menu" data-nav-key={menu.label}>
                  <button type="button" class="menu-btn" aria-haspopup="true">
                    {t(menu.label, locale)}
                    <span class="caret" aria-hidden="true">▾</span>
                  </button>
                  <div class="dropdown">
                    {menu.items.map((it) =>
                      it.heading ? (
                        <div class="dd-head">{t(it.label, locale)}</div>
                      ) : (
                        <a
                          href={it.external ? it.href : localePath(it.href, locale)}
                          target={it.newTab || (it.external && /^https?:/i.test(it.href)) ? '_blank' : undefined}
                          rel={it.newTab || (it.external && /^https?:/i.test(it.href)) ? 'noopener' : undefined}
                          data-secret-nav={it.secret ? '' : undefined}
                          data-pre-contributor={it.preContributor ? '' : undefined}
                          data-contributor-only={it.contributorOnly ? '' : undefined}
                          hidden={it.secret}
                        >
                          {t(it.label, locale)}
                        </a>
                      ),
                    )}
                  </div>
                </div>
              ) : (
                <a
                  class="menu-link"
                  href={localePath(menu.href ?? '/', locale)}
                  data-secret-nav={menu.secret ? '' : undefined}
                  hidden={menu.secret}
                >
                  {t(menu.label, locale)}
                </a>
              ),
            )}
          </div>
        ))
      }
    </nav>

    <div class="tools">
      {/* Reader/Contributor view switch — a segmented toggle that SHOWS the current
          view (highlighted) and the one you can switch to, instead of a single
          flip-label button that was ambiguous. Hidden unless a verified contributor
          is recognised (html[data-contributor]). */}
      <div class="view-switch" data-view-toggle data-home={localePath('/', locale)} role="group" aria-label={t('cnav.viewSwitch', locale)}>
        <button type="button" class="vs-seg" data-view-seg="reader">
          <span class="vs-ico" aria-hidden="true">📖</span><span class="vs-label">{t('cnav.reader', locale)}</span>
        </button>
        <button type="button" class="vs-seg" data-view-seg="contributor">
          <span class="vs-ico" aria-hidden="true">✍️</span><span class="vs-label">{t('cnav.contributor', locale)}</span>
        </button>
      </div>
      <a class="search-btn" data-search-link href={localePath('/search', locale)} aria-label={t('nav.search', locale)} title={`${t('nav.search', locale)} (/)`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
        <kbd aria-hidden="true">/</kbd>
      </a>
      <a class="icon-btn gh-link" href={REPO} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
      </a>
      {/* ONE language switcher at every width — a native <details> dropdown (no JS)
          that lists every language by its OWN name, so it scales cleanly as more
          languages ship (was a flat 2-letter pill row that would overflow at 13).
          Each option is a real <a href> with hreflang, so it works without JS and
          keeps the SEO alternate-language signal. Summary shows the current
          language's native name (wide) or its code (narrow). */}
      <details class="lang-menu">
        <summary aria-label={LOCALE_NAMES[locale]} title={LOCALE_NAMES[locale]}>
          <svg class="lang-globe" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18" />
          </svg>
          <span class="lang-cur">{LOCALE_NAMES[locale]}</span>
          <span class="lang-cur-code">{locale.toUpperCase()}</span>
          <span class="caret" aria-hidden="true">▾</span>
        </summary>
        <div class="lang-menu-list" role="group" aria-label="Language">
          {
            LOCALES.map((l) => (
              <a
                class:list={['lang-opt', { active: l === locale }]}
                href={localePath(path || '/', l)}
                hreflang={l}
                aria-current={l === locale ? 'true' : undefined}
              >
                <span class="lang-opt-code">{l.toUpperCase()}</span>
                <span class="lang-opt-name">{LOCALE_NAMES[l]}</span>
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Press "/" anywhere to jump to search (GitHub-style). If already on the
  // search page, focus the input instead of navigating.
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    const el = e.target as HTMLElement;
    const tag = (el?.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'textarea' || tag === 'select' || el?.isContentEditable) return;
    const link = document.querySelector<HTMLAnchorElement>('a[data-search-link]');
    if (!link) return;
    e.preventDefault();
    const dest = new URL(link.href).pathname.replace(/\/$/, '');
    if (location.pathname.replace(/\/$/, '') === dest) {
      document.getElementById('search-input')?.focus();
    } else {
      location.href = link.href;
    }
  });

  // Secret nav item(s) (e.g. "All Articles"): hidden by default, toggled with
  // Ctrl+Alt+Shift+A. The choice persists in localStorage so it survives page
  // navigation on this static, multi-page site. Uses e.code (layout-independent).
  const SECRET_KEY = 'nav:secret-visible';
  const secretItems = document.querySelectorAll<HTMLElement>('[data-secret-nav]');
  if (secretItems.length) {
    const apply = (on: boolean) => secretItems.forEach((el) => (el.hidden = !on));
    apply(localStorage.getItem(SECRET_KEY) === '1');
    document.addEventListener('keydown', (e) => {
      if (!(e.ctrlKey && e.altKey && e.shiftKey) || e.code !== 'KeyA') return;
      e.preventDefault();
      const next = localStorage.getItem(SECRET_KEY) !== '1';
      localStorage.setItem(SECRET_KEY, next ? '1' : '0');
      apply(next);
    });
  }

  // Desktop hover-menus: a MOUSE click on a menu button would focus it, and the
  // CSS keeps a focused menu open (:focus-within) even after the pointer moves to
  // another menu — so two dropdowns showed at once. Suppress focus for mouse
  // pointers only; keyboard (Tab → :focus-within) and touch (tap → focus) are
  // untouched, and hover still opens/closes normally.
  document.querySelectorAll('.menu-btn').forEach((btn) =>
    btn.addEventListener('pointerdown', (e) => {
      if (e instanceof PointerEvent && e.pointerType === 'mouse') e.preventDefault();
    }),
  );

  // Reader / Contributor view mode. Both navs ship in the page; <html data-view>
  // decides which shows (set pre-paint by the inline script in BaseLayout). The
  // choice persists in localStorage (multi-page static site). P1: contributor
  // recognition is a MANUAL preview flag toggled with Ctrl+Alt+Shift+C — P2 will
  // replace it with the /api/auth/me org-membership check.
  const VIEW_KEY = 'nk:view';
  const CONTRIB_KEY = 'nk:contributor';
  const root = document.documentElement;
  const applyView = (v: string) => {
    root.dataset.view = v === 'contributor' ? 'contributor' : 'reader';
  };
  const setContributor = (on: boolean) => {
    if (on) root.dataset.contributor = 'true';
    else delete root.dataset.contributor;
  };

  // Each view (Reader / Contributor) remembers its OWN last-visited URL, so the
  // two behave like separate workspaces: switching restores where you last were
  // in the target view (falling back to that view's home). Recorded on every load
  // for the active view, and again at the moment of switching.
  const URL_KEYS: Record<string, string> = { reader: 'nk:reader-url', contributor: 'nk:contributor-url' };
  const here = () => location.pathname + location.search + location.hash;
  const recordUrl = () => {
    const v = root.dataset.view === 'contributor' ? 'contributor' : 'reader';
    try { localStorage.setItem(URL_KEYS[v], here()); } catch {}
  };
  recordUrl();
  window.addEventListener('pageshow', recordUrl); // covers bfcache restores

  document.querySelectorAll('[data-view-toggle]').forEach((group) =>
    group.addEventListener('click', (e) => {
      const seg = (e.target instanceof Element) ? e.target.closest('[data-view-seg]') : null;
      if (!seg) return;
      const next = seg.getAttribute('data-view-seg') === 'contributor' ? 'contributor' : 'reader';
      const cur = root.dataset.view === 'contributor' ? 'contributor' : 'reader';
      if (next === cur) return; // already in this view — the highlighted segment
      // Save where we are in the current view, then restore the target view's page.
      try { localStorage.setItem(URL_KEYS[cur], here()); } catch {}
      localStorage.setItem(VIEW_KEY, next);
      let dest = '';
      try { dest = localStorage.getItem(URL_KEYS[next]) || ''; } catch {}
      if (!dest) dest = group.getAttribute('data-home') || '/';
      // Navigate to the saved page if it's elsewhere; otherwise flip in place.
      if (dest !== here()) { location.assign(dest); return; }
      applyView(next);
      // On phones the nav is collapsed in the hamburger, so a bare tap has no
      // visible effect. Open the menu to reveal the view you just switched to.
      if (window.matchMedia('(max-width: 900px)').matches) {
        const cb = document.getElementById('nav-toggle');
        if (cb instanceof HTMLInputElement) cb.checked = true;
      }
    }),
  );

  // Manual recognition for LOCAL DEV (mirrors the secret-nav shortcut): the auth
  // Worker isn't reachable on localhost, so Ctrl+Alt+Shift+C fakes recognition so
  // the switch can be tested. On production the /api/auth/me check below is
  // authoritative and overrides this.
  document.addEventListener('keydown', (e) => {
    if (!(e.ctrlKey && e.altKey && e.shiftKey) || e.code !== 'KeyC') return;
    // DEV ONLY. On production the /api/auth/me org-membership check below is the
    // sole, authoritative gate, so this manual preview is disabled off localhost —
    // a non-contributor must never be able to reveal the switch on the live site.
    if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') return;
    e.preventDefault();
    const on = localStorage.getItem(CONTRIB_KEY) !== '1';
    localStorage.setItem(CONTRIB_KEY, on ? '1' : '0');
    setContributor(on);
    if (!on) {
      localStorage.setItem(VIEW_KEY, 'reader');
      applyView('reader');
    }
  });

  // P2 recognition: ask the auth Worker whether this visitor is an approved
  // contributor (a negaraku-md org member). Same-origin; the signed cookie is
  // sent automatically. A 404/error (e.g. localhost, or the Worker not deployed
  // yet) leaves any manual dev preview untouched. A 200 is authoritative: it
  // reveals the switch for members and, for everyone else — including expired
  // sessions — clears recognition and drops back to Reader.
  //
  // Skip the probe entirely for the anonymous majority: the auth Worker sets a
  // readable `nk_auth=1` hint cookie beside the (HttpOnly) session, so we only
  // ask when that hint is present — or when this browser was recognised before
  // (localStorage), which migrates pre-hint sessions and self-heals expired ones
  // (that /api/auth/me call clears both the flag and the stale hint).
  const hasAuthHint = /(?:^|;\s*)nk_auth=1(?:;|$)/.test(document.cookie);
  const wasContributor = localStorage.getItem(CONTRIB_KEY) === '1';
  if (hasAuthHint || wasContributor) {
    fetch('/api/auth/me', { credentials: 'same-origin', headers: { accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (!d) return;
        if (d.isContributor) {
          setContributor(true);
          localStorage.setItem(CONTRIB_KEY, '1');
        } else {
          setContributor(false);
          localStorage.removeItem(CONTRIB_KEY);
          if (root.dataset.view === 'contributor') {
            localStorage.setItem(VIEW_KEY, 'reader');
            applyView('reader');
          }
        }
      })
      .catch(() => {});
  }

  // Sign-in / sign-out return you to the page you're on, in the SAME tab. The
  // hrefs are the raw worker endpoints; we append ?return=<current path> at click
  // time so the OAuth callback brings you back here instead of '/' (which the
  // default-language script would then bounce to another locale, e.g. /zh/).
  var authReturn = function () {
    return '?return=' + encodeURIComponent(location.pathname + location.search);
  };
  document.querySelectorAll('a[href="/api/auth/login"]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      location.href = '/api/auth/login' + authReturn();
    }),
  );
  // Clean sign-out: clear the client view flags before following the link to
  // /api/auth/logout (clears the cookie server-side), so we land back on a fresh
  // Reader state with no stale toggle or view.
  document.querySelectorAll('a[href="/api/auth/logout"]').forEach((a) =>
    a.addEventListener('click', (e) => {
      localStorage.removeItem(CONTRIB_KEY);
      localStorage.removeItem(VIEW_KEY);
      e.preventDefault();
      location.href = '/api/auth/logout' + authReturn();
    }),
  );
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--nav-height);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ink);
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand-mark {
    color: var(--gold);
    flex-shrink: 0;
  }
  .brand-text {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1.1;
  }
  .brand-name {
    font-size: 1.42rem;
  }
  .brand-tag {
    font-family: var(--font-interface);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.005em;
    color: var(--ink-soft);
    margin-top: 0.12rem;
  }
  .brand .dot {
    color: var(--gold);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline-start: auto;
    font-family: var(--font-interface);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .menu {
    position: relative;
  }
  .menu-btn,
  .menu-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--ink-soft);
    font: inherit;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    text-decoration: none;
  }
  /* The HTML `hidden` attribute must actually hide a secret nav link — the
     `.menu-link { display: inline-flex }` above would otherwise override the
     UA `[hidden] { display: none }`. Higher specificity, no !important. */
  .nav .menu-link[hidden] { display: none; }
  /* Same guard for a secret item living inside a dropdown (e.g. "All Articles"). */
  .dropdown a[hidden] { display: none; }
  .menu-btn:hover,
  .menu-link:hover,
  .menu:hover .menu-btn,
  .menu:focus-within .menu-btn {
    color: var(--gold);
    background: var(--surface);
  }
  .caret {
    font-size: 0.7em;
    opacity: 0.7;
  }
  .dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: 240px;
    background: var(--surface);
    /* Light, clearly-visible edge: mostly the bright ink so it reads near-white
       on dark and stays crisp on light. */
    border: 1px solid color-mix(in srgb, var(--ink) 60%, var(--line));
    border-radius: 12px;
    padding: 0.4rem;
    box-shadow: var(--shadow-card);
    display: none;
    flex-direction: column;
  }
  .menu:hover .dropdown,
  .menu:focus-within .dropdown {
    display: flex;
  }
  .dropdown a {
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap; /* keep long labels on one line; the panel widens to fit */
  }
  .dropdown a:hover {
    background: var(--surface-2);
    color: var(--gold);
  }
  /* Non-interactive section labels grouping the dropdown items (Explore menu). */
  .dropdown .dd-head {
    padding: 0.5rem 0.7rem 0.2rem;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
    pointer-events: none;
    user-select: none;
  }
  .dropdown .dd-head:not(:first-child) {
    margin-top: 0.25rem;
    padding-top: 0.55rem;
    border-top: 1px solid var(--line);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid color-mix(in srgb, var(--gold) 55%, var(--line));
    border-radius: 8px;
    color: var(--ink-soft);
  }
  .icon-btn:hover {
    border-color: var(--gold);
    background: color-mix(in srgb, var(--gold) 10%, var(--surface));
    color: var(--gold);
  }
  /* Search control: magnifier + a "/" key hint (GitHub-style). */
  .search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 34px;
    padding: 0 0.5rem;
    border: 1px solid color-mix(in srgb, var(--gold) 55%, var(--line));
    border-radius: 8px;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .search-btn:hover {
    border-color: var(--gold);
    background: color-mix(in srgb, var(--gold) 10%, var(--surface));
    color: var(--gold);
  }
  .search-btn kbd {
    font-family: var(--font-interface);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    color: var(--muted);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 0.15rem 0.35rem;
  }
  .search-btn:hover kbd {
    color: var(--ink-soft);
  }
  /* Language dropdown — the single switcher at every width. Native <details> so it
     needs no JavaScript (summary = trigger, list = popover). Scales to any number
     of languages, unlike the old flat pill row. */
  .lang-menu {
    display: inline-block;
    position: relative;
  }
  .lang-globe { flex: none; opacity: 0.85; }
  /* Summary shows the current language's native NAME on wide screens and its CODE
     on narrow ones (only one of the two is ever displayed). */
  .lang-cur {
    max-width: 11ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lang-cur-code { display: none; }
  .lang-menu > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    list-style: none;
    cursor: pointer;
    height: 30px;
    padding: 0 0.45rem;
    border: 1px solid color-mix(in srgb, var(--gold) 55%, var(--line));
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
  }
  .lang-menu > summary::-webkit-details-marker { display: none; }
  .lang-menu > summary:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  .lang-menu > summary .caret {
    font-size: 0.7em;
    opacity: 0.7;
  }
  .lang-menu[open] > summary .caret { transform: rotate(180deg); }
  .lang-menu-list {
    position: absolute;
    top: calc(100% + 6px);
    /* `.tools` sits at the bar's right edge on mobile, so open the menu leftward
       (anchor its right edge) to stay on-screen rather than off the right edge. */
    right: 0;
    min-width: 180px;
    display: flex;
    flex-direction: column;
    /* Cap height so a long language list scrolls inside the popover rather than
