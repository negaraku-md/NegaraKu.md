---
import type { Locale } from '@/lib/categories';
import { articlesForLocale } from '@/lib/content';
import { localePath } from '@/lib/i18n';

// THE COMPLIANCE CALENDAR.
//
// The visitor problem this solves: statutory duties start the day a company is
// incorporated, nobody sends a reminder, and the deadlines are scattered across
// dozens of articles. No reader can assemble their own calendar from prose.
//
// Every obligation here is pulled from the `obligations` block of a real
// article, so the calendar can never drift from the knowledge base — and every
// row links back to the article that explains it.

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (ms: string, en: string, zh: string, ta?: string) => (locale === 'ta' ? (ta ?? ms) : locale === 'zh' ? zh : locale === 'en' ? en : ms);

const articles = await articlesForLocale(locale);

type Row = {
  what: string;
  trigger: string;
  withinDays?: number;
  dueDay?: number;
  direction?: 'before' | 'after';
  event?: string;
  due: string;
  authority: string;
  statute?: string;
  consequence?: string;
  source: string;
  href: string;
};

const rows: Row[] = [];
for (const a of articles) {
  for (const o of a.data.obligations) {
    rows.push({
      ...o,
      source: a.data.title,
      href: localePath(`/${a.data.category}/${a.data.slug}`, locale),
    });
  }
}

// De-duplicate. The same duty is described by more than one article and the
// wording differs each time ("Lodge your annual return" vs "Lodge the annual
// return with SSM"), so text matching is not enough. Two obligations sharing a
// trigger, window and authority ARE the same duty — keep the richest version,
// preferring one that cites a statute and names the consequence.
const STOP = new Set([
  'a', 'an', 'the', 'your', 'of', 'to', 'with', 'for', 'and', 'or', 'any',
  'from', 'on', 'in', 'at', 'as', 'by', 'ssm', 'lhdn', 'rmcd',
]);
/** Significant words of an obligation, so wording differences don't matter but
 *  genuinely different duties stay distinct. */
const fingerprint = (s: string) =>
  [
    ...new Set(
      s
        .toLowerCase()
        .replace(/[^a-z\s]/g, ' ')
        .split(/\s+/)
        .filter((w) => w.length > 2 && !STOP.has(w)),
    ),
  ]
    .sort()
    .join('-');

// The statute IS the duty's identity. Two articles describing "appoint the first
// company secretary" and "appoint a licensed company secretary" both cite s.236(2)
// and are one obligation — but their wording differs enough that a word-fingerprint
// keeps them apart. Key on the citation where we have one; fall back to the
// fingerprint only for the handful of duties with no statute recorded.
// Articles cite the same provision at different precision — "s.236" and "s.236(2)",
// or "s.46", "s.46(1) and (2)" and "s.46(3)". Strip subsection parentheses so those
// collapse. Genuinely different subsections almost always differ in trigger or
// deadline too, which stay in the key, so this does not over-merge in practice.
const citation = (s?: string) =>
  (s ?? '')
    .toLowerCase()
    .replace(/\((?:\d+[a-z]?|[a-z])\)/g, '')   // drop (2), (1), (a), (3C) …
    .replace(/\band\b|\s+/g, '');

const byDuty = new Map<string, Row>();
for (const r of rows) {
  const id = r.statute ? `s:${citation(r.statute)}` : `w:${fingerprint(r.what)}`;
  const key = `${r.trigger}|${r.withinDays ?? 'na'}|${id}`;
  const existing = byDuty.get(key);
  // Keep the richest description: one that cites a statute, names the consequence,
  // and — between two equals — explains the duty in more words.
  const richness = (x: Row) =>
    (x.statute ? 4 : 0) + (x.consequence ? 2 : 0) + (x.what.length > 60 ? 1 : 0);
  if (!existing || richness(r) > richness(existing)) byDuty.set(key, r);
}
const unique = [...byDuty.values()];

// Order by urgency: soonest deadline first, ongoing duties last.
const order = { incorporation: 0, monthly: 1, event: 2, anniversary: 3, change: 4, 'financial-year-end': 5, ongoing: 6 };
unique.sort((a, b) => {
  const t = (order[a.trigger as keyof typeof order] ?? 9) - (order[b.trigger as keyof typeof order] ?? 9);
  return t !== 0 ? t : (a.withinDays ?? 999) - (b.withinDays ?? 999);
});

const triggerLabel: Record<string, string> = {
  incorporation: L('Selepas penubuhan', 'After incorporation', '公司成立后', 'நிறுவனப் பதிவுக்குப் பிறகு'),
  monthly: L('Setiap bulan', 'Every month', '每月', 'ஒவ்வொரு மாதமும்'),
  event: L('Selepas sesuatu peristiwa', 'After an event', '事件发生后', 'ஒரு நிகழ்வுக்குப் பிறகு'),
  anniversary: L('Setiap ulang tahun', 'Every anniversary', '每年周年', 'ஒவ்வொரு ஆண்டு நிறைவிலும்'),
  change: L('Apabila berlaku perubahan', 'When something changes', '发生变动时', 'ஏதேனும் மாறும்போது'),
  'financial-year-end': L('Akhir tahun kewangan', 'Financial year end', '财政年结', 'நிதியாண்டு இறுதி'),
  ongoing: L('Berterusan', 'Ongoing', '持续义务', 'தொடர்ச்சியான'),
};

// Localized strings the client script needs for threshold applicability results
// (the script is plain JS, so it can't call L() — it reads this serialized dict).
const ccMsg = {
  applies: L('Berkenaan dengan anda', 'Applies to you', '对你适用', 'உங்களுக்குப் பொருந்தும்'),
  below: L('Bawah ambang — tidak berkenaan', 'Below threshold — does not apply', '未达门槛 — 不适用', 'வரம்புக்குக் கீழ் — பொருந்தாது'),
  exempt: L('Dikecualikan — anda layak', 'Exempt — you qualify', '可豁免 — 你符合资格', 'விலக்கு — நீங்கள் தகுதி'),
  notExempt: L('Tidak dikecualikan — diperlukan', 'Not exempt — required', '不豁免 — 需履行', 'விலக்கு இல்லை — தேவை'),
  needSize: L('Isi saiz syarikat di atas', 'Enter your company size above', '请在上方填写公司规模', 'மேலே நிறுவன அளவை உள்ளிடுங்கள்'),
};

const groups = [...new Set(unique.map((r) => r.trigger))];
---

<section class="container block">
  <p class="eyebrow">{L('Alat', 'Tool', '工具', 'கருவி')}</p>
  <h1>{L('Kalendar Pematuhan', 'Compliance Calendar', '合规日历', 'இணக்க நாட்காட்டி')}</h1>
  <p class="lede">
    {L(
      'Kewajipan berkanun bermula pada hari syarikat anda ditubuhkan — dan tiada siapa akan mengingatkan anda. Isi tarikh penubuhan, akhir tahun kewangan atau tarikh peristiwa untuk melihat tarikh akhir sebenar anda. Kewajipan bulanan (cth. KWSP) sentiasa menunjukkan tarikh seterusnya.',
      'Statutory duties start the day your company is incorporated — and nobody sends a reminder. Fill in your incorporation date, financial year end or an event date to see your actual deadlines. Monthly duties (e.g. EPF) always show the next date.',
      '法定义务从公司成立当天开始——而且没有人会提醒你。填写成立日期、财政年结日或事件日期，即可查看你的实际截止日期。每月义务（如公积金）始终显示下一个日期。',
      'சட்டப்பூர்வக் கடமைகள் உங்கள் நிறுவனம் பதிவு செய்யப்படும் நாளிலேயே தொடங்குகின்றன — யாரும் நினைவூட்டல் அனுப்ப மாட்டார்கள். உங்கள் உண்மையான இறுதி தேதிகளைக் காண, நிறுவனப் பதிவு தேதி, நிதியாண்டு இறுதி அல்லது நிகழ்வு தேதியை உள்ளிடுங்கள். மாதாந்திரக் கடமைகள் (எ.கா. KWSP) எப்போதும் அடுத்த தேதியைக் காட்டும்.',
    )}
  </p>

  <div class="datebar">
    <div class="field">
      <label for="inc">{L('Tarikh penubuhan', 'Incorporation date', '公司成立日期', 'நிறுவனப் பதிவு தேதி')}</label>
      <input type="date" id="inc" />
    </div>
    <div class="field">
      <label for="fye">{L('Akhir tahun kewangan', 'Financial year end', '财政年结日', 'நிதியாண்டு இறுதி')}</label>
      <input type="date" id="fye" />
    </div>
    <div class="field">
      <label for="evt">{L('Tarikh peristiwa', 'Event date', '事件日期', 'நிகழ்வு தேதி')}</label>
      <input type="date" id="evt" />
      <small class="hint">{L('cth. tarikh bayaran / AGM', 'e.g. payment / AGM date', '如付款 / 股东大会日期', 'எ.கா. கட்டணம் / AGM தேதி')}</small>
    </div>
    <button id="clear" type="button">{L('Kosongkan', 'Clear', '清除', 'அழி')}</button>
  </div>

  <div class="datebar sizebar">
    <div class="field">
      <label for="turnover">{L('Pusing ganti / hasil tahunan (RM)', 'Annual turnover / revenue (RM)', '年营业额 / 收入 (RM)', 'ஆண்டு விற்றுமுதல் / வருவாய் (RM)')}</label>
      <input type="number" id="turnover" min="0" step="1000" inputmode="numeric" />
    </div>
    <div class="field">
      <label for="assets">{L('Jumlah aset (RM)', 'Total assets (RM)', '总资产 (RM)', 'மொத்த சொத்துகள் (RM)')}</label>
      <input type="number" id="assets" min="0" step="1000" inputmode="numeric" />
    </div>
    <div class="field">
      <label for="employees">{L('Bilangan pekerja', 'Employees', '员工人数', 'பணியாளர்கள்')}</label>
      <input type="number" id="employees" min="0" step="1" inputmode="numeric" />
    </div>
    <small class="hint">{L('Untuk ambang cukai/audit (SST, e-Invois, pengecualian audit)', 'For tax/audit thresholds (SST, e-Invoice, audit exemption)', '用于税务/审计门槛（SST、电子发票、审计豁免）', 'வரி/தணிக்கை வரம்புகளுக்கு (SST, மின்-விலைப்பட்டியல், தணிக்கை விலக்கு)')}</small>
  </div>

  {
    groups.map((g) => (
      <div class="group">
        <h2>{triggerLabel[g] ?? g}</h2>
        <div class="tblwrap">
          <table>
            <colgroup>
              <col class="c-duty" /><col class="c-due" /><col class="c-your" /><col class="c-auth" />
            </colgroup>
            <thead>
              <tr>
                <th>{L('Kewajipan', 'Obligation', '义务', 'கடமை')}</th>
                <th>{L('Tarikh akhir', 'Deadline', '截止', 'இறுதி தேதி')}</th>
                <th class="due-col">{L('Untuk anda', 'For you', '对你而言', 'உங்களுக்கு')}</th>
                <th>{L('Kepada', 'Owed to', '主管机构', 'யாருக்கு')}</th>
              </tr>
            </thead>
            <tbody>
              {unique
                .filter((r) => r.trigger === g)
                .map((r) => (
                  <tr
                    data-within={r.withinDays ?? ''}
                    data-trigger={r.trigger}
                    data-dueday={r.dueDay ?? ''}
                    data-direction={r.direction ?? ''}
                    data-criteria={r.criteria ? JSON.stringify(r.criteria) : ''}
                    data-exemption={r.exemption ? '1' : ''}
                  >
                    <td>
                      <a href={r.href}>{r.what}</a>
                      {r.statute && <span class="stat">{r.statute}</span>}
                      {r.consequence && <span class="cons">⚠ {r.consequence}</span>}
                    </td>
                    <td class="deadline">{r.due}</td>
                    <td class="due-col computed">—</td>
                    <td class="auth">{r.authority}</td>
                  </tr>
                ))}
            </tbody>
          </table>
        </div>
      </div>
    ))
  }

  <p class="note">
    {L(
      'Setiap kewajipan di sini diambil terus daripada artikel yang menerangkannya — klik untuk butiran penuh. Ini panduan umum, bukan nasihat profesional.',
      'Every obligation here is pulled directly from the article that explains it — click through for the full detail. This is general guidance, not professional advice.',
      '此处每项义务均直接取自解释它的文章——点击查看完整说明。本内容为一般指引，非专业意见。',
      'இங்குள்ள ஒவ்வொரு கடமையும் அதை விளக்கும் கட்டுரையிலிருந்து நேரடியாக எடுக்கப்பட்டது — முழு விவரங்களுக்குக் கிளிக் செய்யுங்கள். இது ஒரு பொது வழிகாட்டி, தொழில்முறை ஆலோசனை அல்ல.',
    )}
  </p>
</section>

<script type="application/json" id="cc-i18n" set:html={JSON.stringify(ccMsg)}></script>

<script>
  // Three independent inputs feed the calculator, each computing a different
  // BASIS (see the schema in content.config.ts): incorporation date drives
  // incorporation/anniversary duties; financial year end drives FYE duties;
  // an event date drives event (before/after) duties. Monthly duties (day-of-
  // month, e.g. EPF on the 15th) need no input — they always show the next date.
  const incEl = document.getElementById('inc') as HTMLInputElement | null;
  const fyeEl = document.getElementById('fye') as HTMLInputElement | null;
  const evtEl = document.getElementById('evt') as HTMLInputElement | null;
  // Company-size inputs drive threshold duties (SST, e-invoice, audit exemption).
  const turnoverEl = document.getElementById('turnover') as HTMLInputElement | null;
  const assetsEl = document.getElementById('assets') as HTMLInputElement | null;
  const employeesEl = document.getElementById('employees') as HTMLInputElement | null;
  const clear = document.getElementById('clear');
  const KEYS = {
    inc: 'negaraku:incorporation-date', fye: 'negaraku:fye-date', evt: 'negaraku:event-date',
    turnover: 'negaraku:cc-turnover', assets: 'negaraku:cc-assets', employees: 'negaraku:cc-employees',
  };
  const MSG = (() => { try { return JSON.parse(document.getElementById('cc-i18n')?.textContent || '{}'); } catch { return {}; } })();

  const fmt = (d: Date) =>
    d.toLocaleDateString(document.documentElement.lang || 'en', { day: 'numeric', month: 'short', year: 'numeric' });

  // Parse a yyyy-mm-dd <input type=date> value in LOCAL time (new Date(str) is
  // UTC, which can shift the day across the date line). Returns null if empty/bad.
  function parseLocal(v: string | undefined): Date | null {
    if (!v) return null;
    const [y, m, d] = v.split('-').map(Number);
    if (!y || !m || !d) return null;
    const dt = new Date(y, m - 1, d);
    return Number.isNaN(dt.getTime()) ? null : dt;
  }
  const daysInMonth = (y: number, m: number) => new Date(y, m + 1, 0).getDate();
  const addDays = (d: Date, n: number) => { const x = new Date(d); x.setDate(x.getDate() + n); return x; };
  function today0() { const t = new Date(); t.setHours(0, 0, 0, 0); return t; }

  // Next occurrence of a recurring month/day pair, on or after `from` (clamped for
  // short months, e.g. day 31 → 28/29/30). Used by monthly + FYE bases.
  function nextByMonthDay(month: number, day: number, from: Date): Date {
    for (let y = from.getFullYear(); y <= from.getFullYear() + 2; y++) {
      const cand = new Date(y, month, Math.min(day, daysInMonth(y, month)));
      if (cand >= from) return cand;
    }
    return new Date(from.getFullYear() + 1, month, day);
  }

  // Compute the next relevant due Date for one row, or null if it needs an input
  // the visitor hasn't given (or isn't date-computable). Recurring bases roll
  // forward to the next occurrence that hasn't already passed.
  function dueFor(tr: HTMLTableRowElement): Date | null {
    const trigger = tr.dataset.trigger || '';
    const within = tr.dataset.within ? Number(tr.dataset.within) : null;
    const dueDay = tr.dataset.dueday ? Number(tr.dataset.dueday) : null;
    const dir = tr.dataset.direction || 'after';
    const now = today0();
    const inc = parseLocal(incEl?.value), fye = parseLocal(fyeEl?.value), evt = parseLocal(evtEl?.value);

    if (trigger === 'monthly' && dueDay) return nextByMonthDay(now.getMonth(), dueDay, now);

    if (trigger === 'incorporation' && inc && within !== null) return addDays(inc, within);

    if (trigger === 'anniversary' && inc && within !== null) {
      const ann = nextByMonthDay(inc.getMonth(), inc.getDate(), now);
      return addDays(ann, within);
    }

    if (trigger === 'financial-year-end' && fye && within !== null) {
      // Roll to whichever FYE occurrence gives the next deadline still ahead.
      for (let y = now.getFullYear() - 1; y <= now.getFullYear() + 2; y++) {
        const occ = new Date(y, fye.getMonth(), Math.min(fye.getDate(), daysInMonth(y, fye.getMonth())));
        const due = addDays(occ, within);
        if (due >= now) return due;
      }
      return null;
    }

    if (trigger === 'event' && evt && within !== null) return addDays(evt, dir === 'before' ? -within : within);

    return null; // change / ongoing / missing input
  }

  const numOrNull = (el: HTMLInputElement | null) => {
    const v = el && el.value !== '' ? Number(el.value) : NaN;
    return Number.isFinite(v) ? v : null;
  };
  // Evaluate a threshold row against the size inputs. Returns the localized result
  // text + a status colour, or null-status when the needed figures aren't filled.
  function thresholdResult(tr: HTMLTableRowElement): { text: string; soon: string | null } {
    let criteria: { metric: string; op: string; value: number }[] = [];
    try { criteria = JSON.parse(tr.dataset.criteria || '[]'); } catch { criteria = []; }
    const isExemption = tr.dataset.exemption === '1';
    const size: Record<string, number | null> = {
      turnover: numOrNull(turnoverEl), revenue: numOrNull(turnoverEl), // one field feeds both
      assets: numOrNull(assetsEl), employees: numOrNull(employeesEl),
    };
    // Need every metric the row tests; if any is blank, prompt for size.
    if (!criteria.length || criteria.some((c) => size[c.metric] == null)) return { text: MSG.needSize || '—', soon: null };
    const pass = (c: { metric: string; op: string; value: number }) => {
      const x = size[c.metric] as number;
      return c.op === 'gte' ? x >= c.value : c.op === 'gt' ? x > c.value : c.op === 'lte' ? x <= c.value : x < c.value;
    };
    const allMet = criteria.every(pass);
    if (isExemption) return allMet ? { text: MSG.exempt, soon: 'ok' } : { text: MSG.notExempt, soon: 'soon' };
    return allMet ? { text: MSG.applies, soon: 'soon' } : { text: MSG.below, soon: 'ok' };
  }

  function paint() {
    document.querySelectorAll<HTMLTableRowElement>('tr[data-trigger]').forEach((tr) => {
      const cell = tr.querySelector<HTMLElement>('.computed');
      if (!cell) return;
      if (tr.dataset.trigger === 'threshold') {
        const r = thresholdResult(tr);
        cell.textContent = r.text;
        if (r.soon) cell.dataset.soon = r.soon; else cell.removeAttribute('data-soon');
        return;
      }
      const due = dueFor(tr);
      if (!due) { cell.textContent = '—'; cell.removeAttribute('data-soon'); return; }
      cell.textContent = fmt(due);
      const days = Math.ceil((due.getTime() - Date.now()) / 86400000);
      cell.dataset.soon = days < 0 ? 'past' : days <= 30 ? 'soon' : 'ok';
    });
  }

  function wire(el: HTMLInputElement | null, key: string) {
    if (!el) return;
    el.addEventListener('change', () => { try { localStorage.setItem(key, el.value); } catch {} paint(); });
    try { const saved = localStorage.getItem(key); if (saved) el.value = saved; } catch {}
  }
  const ALL = [
    [incEl, KEYS.inc], [fyeEl, KEYS.fye], [evtEl, KEYS.evt],
    [turnoverEl, KEYS.turnover], [assetsEl, KEYS.assets], [employeesEl, KEYS.employees],
  ] as const;
  for (const [el, key] of ALL) wire(el, key);

  clear?.addEventListener('click', () => {
    for (const [el, key] of ALL) {
      if (el) el.value = '';
      try { localStorage.removeItem(key); } catch {}
    }
    paint();
  });

  paint(); // initial render — monthly rows compute immediately, others show — until filled
</script>

<style>
  .eyebrow { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); font-weight: 700; margin: 0 0 0.4rem; }
  h1 { margin: 0 0 0.5rem; }
  .lede { color: var(--ink-soft); max-width: 62ch; margin: 0 0 1.6rem; }

  .datebar {
    display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap;
    background: var(--surface); border: 1px solid var(--line);
    border-left: 3px solid var(--gold); border-radius: 12px;
    padding: 0.9rem 1.1rem; margin-bottom: 2rem;
  }
  .datebar label { font-family: var(--font-title); font-weight: 700; font-size: 0.92rem; }
  .datebar input {
    background: var(--surface-2); border: 1px solid var(--line); border-radius: 8px;
    color: var(--ink); font: inherit; padding: 0.35rem 0.6rem;
  }
  .datebar input:focus { outline: none; border-color: var(--gold); }
  .datebar button {
    background: transparent; border: 1px solid var(--line); border-radius: 999px;
    color: var(--ink-soft); font: inherit; font-size: 0.82rem; padding: 0.3rem 0.75rem; cursor: pointer;
  }
  .datebar button:hover { border-color: var(--gold); color: var(--ink); }
  .datebar .field { display: flex; flex-direction: column; gap: 0.3rem; }
  .datebar .field input { width: 100%; }
  .datebar .hint { font-size: 0.72rem; color: var(--muted); }
  .sizebar { align-items: flex-end; }
  .sizebar > .hint { flex: 1 1 100%; margin-top: -0.2rem; }
