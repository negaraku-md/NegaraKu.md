---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PillarHubView from '@/components/PillarHubView.astro';
import { getPillarDef, loc } from '@/lib/categories';
const locale = 'ta';
const def = getPillarDef('understand')!;
---

<BaseLayout locale={locale} title={loc(def.name, locale)} description={loc(def.tagline, locale)} path="/understand">
  <PillarHubView locale={locale} pillar="understand" />
</BaseLayout>
