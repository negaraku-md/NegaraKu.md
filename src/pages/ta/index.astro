---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeView from '@/components/HomeView.astro';
import { websiteJsonLd, organizationJsonLd } from '@/lib/seo';
import { t } from '@/lib/i18n';

const locale = 'ta';
---

<BaseLayout locale={locale} title="திறந்த மூல மலேசியா அறிவுத் தளம் | NegaraKu.md" description={t('site.homeDescription', locale)} path="/" jsonLd={[websiteJsonLd(locale), organizationJsonLd(locale)]}>
  <HomeView locale={locale} />
</BaseLayout>
