---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CostOfLivingView from '@/components/CostOfLivingView.astro';
import { TOOLS } from '@/lib/tools';
const locale = 'ar' as const;
const tool = TOOLS.find((t) => t.id === 'cost-of-living-by-state')!;
---

<BaseLayout locale={locale} title={tool.title[locale]} description={tool.blurb[locale]} path="/tools/cost-of-living-by-state">
  <CostOfLivingView locale={locale} />
</BaseLayout>
