---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopicView from '@/components/TopicView.astro';
import { getCategory, loc } from '@/lib/categories';
import { subcatLabel } from '@/lib/subcategories';
import { topicPaths } from '@/lib/paths';
import type { Article } from '@/lib/content';

export async function getStaticPaths() {
  return topicPaths('ko');
}

const locale = 'ko';
const { categoryId, topic, articles } = Astro.props as { categoryId: string; topic: string; articles: Article[] };
const cat = getCategory(categoryId)!;
const label = subcatLabel(topic, locale);
---

<BaseLayout
  locale={locale}
  title={`${label} — ${loc(cat.name, locale)}`}
  description={loc(cat.blurb, locale)}
  path={`/${categoryId}/topic/${topic}`}
>
  <TopicView locale={locale} categoryId={categoryId} topic={topic} articles={articles} />
</BaseLayout>
