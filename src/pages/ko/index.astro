---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeView from '@/components/HomeView.astro';
import { websiteJsonLd, organizationJsonLd } from '@/lib/seo';
import { t } from '@/lib/i18n';

const locale = 'ko';
---

<BaseLayout locale={locale} title="오픈소스 말레이시아 지식 베이스 | NegaraKu.md" description={t('site.homeDescription', locale)} path="/" jsonLd={[websiteJsonLd(locale), organizationJsonLd(locale)]}>
  <HomeView locale={locale} />
</BaseLayout>
