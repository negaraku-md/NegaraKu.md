---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeView from '@/components/HomeView.astro';
import { homeData } from '@/lib/homedata';
import { websiteJsonLd, organizationJsonLd } from '@/lib/seo';
import { t } from '@/lib/i18n';

const locale = 'zh';
const { essentials, all, counts, total } = await homeData(locale);
---

<BaseLayout locale={locale} title="开源马来西亚知识库 | NegaraKu.md" description={t('site.tagline', locale)} path="/" jsonLd={[websiteJsonLd(), organizationJsonLd()]}>
  <HomeView locale={locale} essentials={essentials} all={all} counts={counts} total={total} />
</BaseLayout>
