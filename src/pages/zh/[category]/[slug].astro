---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleView from '@/components/ArticleView.astro';
import { articlePaths } from '@/lib/paths';
import { articleJsonLd, breadcrumbJsonLd, keywordsFor, faqJsonLd, seoTitleFor } from '@/lib/seo';
import { localePath } from '@/lib/i18n';
import type { Article } from '@/lib/content';

export async function getStaticPaths() {
  return articlePaths('zh');
}

const locale = 'zh';
const { article } = Astro.props as { article: Article };
const path = `/${article.data.category}/${article.data.slug}`;
const mdHref = localePath(path, locale) + '.md';
---

<BaseLayout
  locale={locale}
  title={seoTitleFor(article)}
  description={article.data.summary}
  path={path}
  ogType="article"
  image={`/og/${locale}/${article.data.category}/${article.data.slug}.png`}
  mdHref={mdHref}
  keywords={keywordsFor(article, locale).join(', ')}
  socialTitle={article.data.socialTitle}
  jsonLd={[articleJsonLd(article, locale), breadcrumbJsonLd(article, locale), faqJsonLd(article)].filter(Boolean) as Record<string, unknown>[]}
>
  <ArticleView locale={locale} article={article} />
</BaseLayout>
