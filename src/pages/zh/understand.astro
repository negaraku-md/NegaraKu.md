---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PillarHubView from '@/components/PillarHubView.astro';
import { getPillarDef } from '@/lib/categories';
const locale = 'zh';
const def = getPillarDef('understand')!;
---

<BaseLayout locale={locale} title={def.name[locale]} description={def.tagline[locale]} path="/understand">
  <PillarHubView locale={locale} pillar="understand" />
</BaseLayout>
