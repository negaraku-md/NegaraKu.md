---
// /embed — builder-facing landing for the embeddable "fact about Malaysia"
// widget. Now rendered inside the full site chrome (BaseLayout + hero) to match
// /llms, instead of the old standalone shell. English-first docs; a bare route,
// so it uses the default locale for a correct canonical (/embed/), and
// `soloLocale` hides the language switcher + hreflang (there is no /<lang>/embed).
// The actual iframe widget stays chrome-less at /embed/fact-of-the-day.
// English chrome (locale='en') but served at the bare /embed, so canonicalPath
// keeps the canonical at /embed/ rather than /en/embed/.
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmbedView from '@/components/EmbedView.astro';
export const prerender = true;
const locale = 'en';
---
<BaseLayout
  locale={locale}
  title="Embed a fact"
  description="Add a free, auto-updating 'fact about Malaysia' widget to your site in one line. Open-source, 13 languages, light & dark."
  path="/embed"
  canonicalPath="/embed"
  soloLocale
>
  <EmbedView locale={locale} />
</BaseLayout>
