---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PillarHubView from '@/components/PillarHubView.astro';
import { getPillarDef } from '@/lib/categories';
const locale = 'en';
const def = getPillarDef('living')!;
---

<BaseLayout locale={locale} title={def.name[locale]} description={def.tagline[locale]} path="/living">
  <PillarHubView locale={locale} pillar="living" />
</BaseLayout>
