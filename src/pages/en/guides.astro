---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GuidesIndexView from '@/components/GuidesIndexView.astro';
import { t } from '@/lib/i18n';

const locale = 'en';
---

<BaseLayout
  locale={locale}
  title={t('nav.guides', locale)}
  description={t('guides.metaDesc', locale)}
  path="/guides"
>
  <GuidesIndexView locale={locale} />
</BaseLayout>
