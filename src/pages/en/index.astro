---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeView from '@/components/HomeView.astro';
import { homeData } from '@/lib/homedata';
import { websiteJsonLd } from '@/lib/seo';
import { t } from '@/lib/i18n';

const locale = 'en';
const { essentials, all, counts, total } = await homeData(locale);
---

<BaseLayout locale={locale} title="NegaraKu.md" description={t('site.tagline', locale)} path="/" jsonLd={websiteJsonLd()}>
  <HomeView locale={locale} essentials={essentials} all={all} counts={counts} total={total} />
</BaseLayout>
