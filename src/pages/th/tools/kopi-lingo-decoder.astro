---
import BaseLayout from '@/layouts/BaseLayout.astro';
import KopiLingoDecoderView from '@/components/KopiLingoDecoderView.astro';
import { liveTools } from '@/lib/tools';
const locale = 'th';
const tool = liveTools(locale).find((x) => x.id === 'kopi-lingo-decoder');
---

<BaseLayout
  locale={locale}
  title={tool?.label ?? 'Kopi Lingo Decoder'}
  description={tool?.desc ?? ''}
  path="/tools/kopi-lingo-decoder"
>
  <KopiLingoDecoderView locale={locale} />
</BaseLayout>
