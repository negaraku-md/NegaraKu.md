---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import HeadInlineScripts from '@/components/HeadInlineScripts.astro';
import type { Locale } from '@/lib/categories';
import { t, LOCALES, localePath } from '@/lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Path without locale prefix, for canonical + language alternates. */
  path?: string;
  /** Optional JSON-LD injected into the head (object or array of objects). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
  /** When set, advertises a raw-Markdown alternate of this page for AI agents. */
  mdHref?: string;
  /** Localized search keywords for this page (meta keywords). */
  keywords?: string;
  /** Curiosity-led title for social shares. Falls back to the page title. */
  socialTitle?: string;
  /** Per-page Open Graph image (site-root path, e.g. /og/en/law/x.png). */
  image?: string;
}

const {
  locale,
  title,
  description = t('site.tagline', locale),
  path = '/',
  jsonLd,
  ogType = 'website',
  mdHref,
  keywords,
  socialTitle,
  image,
} = Astro.props;

// Point AI agents at the machine index for THIS language.
const llmsHref = localePath('/llms.txt', locale);

const site = Astro.site ?? new URL('https://negaraku.md');
// Append the brand only when it fits inside Google's ~60-char display budget.
// Otherwise the suffix truncates the part that actually earns the click.
const BRAND = ' — NegaraKu.md';
const fullTitle =
  title === 'NegaraKu.md'
    ? title
    : (title + BRAND).length <= 60
      ? title + BRAND
      : title;
const canonical = new URL(localePath(path, locale), site).toString();
const htmlLang = locale === 'zh' ? 'zh-Hans' : locale === 'ms' ? 'ms-MY' : 'en';
// Per-page OG image (e.g. the article's own card), else the branded default.
const ogImage = new URL(image ?? '/og/default.png', site).toString();
const ogImageAlt = image ? title : 'NegaraKu.md — knowledge base about Malaysia';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07070a" />
    <HeadInlineScripts />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={canonical} />

    {/* AI-agent discovery: machine index (this language) + optional raw-Markdown. */}
    <link rel="alternate" type="text/plain" title="llms.txt (AI index)" href={llmsHref} />
    {mdHref && <link rel="alternate" type="text/markdown" title="Raw Markdown" href={mdHref} />}

    {/* hreflang alternates */}
    {
      LOCALES.map((l) => (
        <link
          rel="alternate"
          hreflang={l === 'zh' ? 'zh-Hans' : l === 'ms' ? 'ms-MY' : 'en'}
          href={new URL(localePath(path, l), site).toString()}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(path, 'ms'), site).toString()} />

    {/* Open Graph / Twitter (drives Facebook + social link previews) */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="NegaraKu.md" />
    <meta property="og:title" content={socialTitle ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={htmlLang.replace('-', '_')} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="negaraku.md" href="/rss.xml" />

    {/* Fonts — loaded non-render-blocking so the page shows immediately with the
        system-font fallback and upgrades when the web fonts arrive. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Lato:wght@400;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Lato:wght@400;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      />
    </noscript>

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main" data-pagefind-ignore>{t('a11y.skip', locale)}</a>
    <Header locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      // Open every external link in a new tab (with safe rel). Internal
      // links (same host, relative paths, #anchors) keep their default behaviour.
      for (const a of document.querySelectorAll('a[href]')) {
        const href = a.getAttribute('href');
        if (!href) continue;
        try {
          const url = new URL(href, location.href);
          const isHttp = url.protocol === 'http:' || url.protocol === 'https:';
          if (isHttp && url.host !== location.host) {
            a.setAttribute('target', '_blank');
            const rel = new Set((a.getAttribute('rel') || '').split(/\s+/).filter(Boolean));
            rel.add('noopener');
            rel.add('noreferrer');
            a.setAttribute('rel', [...rel].join(' '));
          }
        } catch {}
      }

      // Brand the wordmark everywhere, automatically. Any literal "NegaraKu.md"
      // in running text is wrapped so "NegaraKu" stays bright and ".md" gold —
      // no need to hand-mark every string. The header/footer/hero already split
      // the wordmark into separate nodes, so this contiguous-string match only
      // ever hits plain prose. Skips code, inputs and already-branded nodes.
      (() => {
        const SKIP = new Set(['SCRIPT', 'STYLE', 'CODE', 'PRE', 'TEXTAREA', 'KBD', 'INPUT']);
        const esc = (s) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
        const brand = (s) => s.replace(/NegaraKu\.md/g, '<span class="wm">NegaraKu<span class="wm-dot">.md</span></span>');
        // The wordmark treatment (bright ink + gold dot) is for dark surfaces
        // only — on a light/gold background (e.g. a gold button) the gold ".md"
        // would vanish. Find the nearest opaque background and skip if it's light.
        const isDarkBg = (el) => {
          for (let n = el; n && n.nodeType === 1; n = n.parentElement) {
            const c = getComputedStyle(n).backgroundColor;
            const m = c && c.match(/rgba?\(([^)]+)\)/);
            if (!m) continue;
            const [r, g, b, a = '1'] = m[1].split(',').map((x) => parseFloat(x));
            if (a === 0) continue; // transparent — keep climbing
            // Brand only on genuinely dark surfaces; skip accent fills (gold OR
            // red buttons) where the accent-coloured ".md" would clash.
            return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255 < 0.3;
          }
          return true; // default: assume the dark canvas
        };
        const walk = (node) => {
          for (const child of [...node.childNodes]) {
            if (child.nodeType === 3) {
              if (child.nodeValue.includes('NegaraKu.md') && isDarkBg(node)) {
                const span = document.createElement('span');
                span.innerHTML = brand(esc(child.nodeValue));
                child.replaceWith(span);
              }
            } else if (
              child.nodeType === 1 &&
              !SKIP.has(child.tagName) &&
              !child.classList.contains('wm') &&
              !child.classList.contains('brand-name')
            ) {
              walk(child);
            }
          }
        };
        walk(document.body);
      })();
    </script>
  </body>
</html>
